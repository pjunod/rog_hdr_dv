+// SPDX-License-Identifier: MPL-2.0
+// Shared C core owns native buffers and metadata; no decoder pointers are borrowed.
+use gtk::glib::{self, translate::*};
+use std::{ffi::c_void, ptr::NonNull};
+
+unsafe extern "C" {
+    fn gst_gtk_dovi_core_abi() -> u32;
+    fn gst_gtk_dovi_mapper_new() -> *mut c_void;
+    fn gst_gtk_dovi_mapper_free(mapper: *mut c_void);
+    fn gst_gtk_dovi_native_frame_from_buffer(
+        buffer: *mut gst::ffi::GstBuffer,
+        generation: *mut u64,
+    ) -> *mut c_void;
+    fn gst_gtk_dovi_native_frame_ref(frame: *mut c_void) -> *mut c_void;
+    fn gst_gtk_dovi_native_frame_unref(frame: *mut c_void);
+    fn gst_gtk_dovi_native_frame_render(
+        frame: *mut c_void,
+        mapper: *mut c_void,
+        context: *const gst::ffi::GstContext,
+        output: *mut *mut gst::ffi::GstBuffer,
+        info: *mut gst_video::ffi::GstVideoInfo,
+        error: *mut *mut glib::ffi::GError,
+    ) -> i32;
+}
+#[derive(Debug)]
+pub(crate) struct NativeFrame(NonNull<c_void>);
+// The immutable C snapshot holds atomic GstBuffer/GBytes/picture references.
+unsafe impl Send for NativeFrame {}
+unsafe impl Sync for NativeFrame {}
+impl Clone for NativeFrame {
+    fn clone(&self) -> Self {
+        unsafe {
+            Self(NonNull::new_unchecked(gst_gtk_dovi_native_frame_ref(
+                self.0.as_ptr(),
+            )))
+        }
+    }
+}
+impl Drop for NativeFrame {
+    fn drop(&mut self) {
+        unsafe { gst_gtk_dovi_native_frame_unref(self.0.as_ptr()) }
+    }
+}
+impl NativeFrame {
+    pub(crate) fn from_buffer(buffer: &gst::Buffer) -> (Option<Self>, u64) {
+        let mut generation = 0;
+        let frame = unsafe {
+            gst_gtk_dovi_native_frame_from_buffer(buffer.to_glib_none().0, &mut generation)
+        };
+        (NonNull::new(frame).map(Self), generation)
+    }
+}
+pub(crate) struct Mapper(NonNull<c_void>);
+// Vulkan renderer access is serialized by the sink's mapper mutex.
+unsafe impl Send for Mapper {}
+impl Drop for Mapper {
+    fn drop(&mut self) {
+        unsafe { gst_gtk_dovi_mapper_free(self.0.as_ptr()) }
+    }
+}
+impl Mapper {
+    pub(crate) fn new() -> Result<Self, String> {
+        if unsafe { gst_gtk_dovi_core_abi() } != 1 {
+            return Err("Incompatible native Dolby renderer ABI".into());
+        }
+        NonNull::new(unsafe { gst_gtk_dovi_mapper_new() })
+            .map(Self)
+            .ok_or_else(|| "Native renderer allocation failed".into())
+    }
+    pub(crate) fn render(
+        &mut self,
+        source: &NativeFrame,
+        context: &gst::Context,
+    ) -> Result<Option<(gst::Buffer, gst_video::VideoInfo, bool)>, String> {
+        let mut output = std::ptr::null_mut();
+        let mut info = std::mem::MaybeUninit::<gst_video::ffi::GstVideoInfo>::uninit();
+        let mut error = std::ptr::null_mut();
+        let status = unsafe {
+            gst_gtk_dovi_native_frame_render(
+                source.0.as_ptr(),
+                self.0.as_ptr(),
+                context.to_glib_none().0,
+                &mut output,
+                info.as_mut_ptr(),
+                &mut error,
+            )
+        };
+        if status < 0 {
+            let message = if error.is_null() {
+                "Native picture redraw failed".into()
+            } else {
+                unsafe { from_glib_full::<_, glib::Error>(error) }.to_string()
+            };
+            if !output.is_null() {
+                drop(unsafe { from_glib_full::<_, gst::Buffer>(output) });
+            }
+            return Err(message);
+        }
+        if status == 0 {
+            return Ok(None);
+        }
+        if output.is_null() {
+            return Err("Native redraw returned no frame".into());
+        }
+        Ok(Some(unsafe {
+            (
+                from_glib_full(output),
+                from_glib_none(info.as_ptr()),
+                status == 1,
+            )
+        }))
+    }
+}
