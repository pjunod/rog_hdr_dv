+
+// Public destination ABI1: only a complete current view witness selects PQ.
+fn destination_kind(valid: bool, ready: bool, composed: bool) -> i32 {
+    if valid && ready && composed { 0 } else { 1 }
+}
+
+// Completion belongs to this exact visible source and context, not the
+// producer baseline's physical target generation or a returned buffer tag.
+pub(crate) fn redraw_needed(completed: Option<(u64, u64)>, frame: u64, context: u64) -> bool {
+    completed != Some((frame, context))
+}
+
+#[cfg(test)]
+mod tests {
+    #[test]
+    fn destination_requires_all_witnesses() {
+        for flags in 0..8 {
+            let actual = super::destination_kind(flags & 1 != 0, flags & 2 != 0, flags & 4 != 0);
+            assert_eq!(actual, if flags == 7 { 0 } else { 1 });
+        }
+    }
+
+    #[test]
+    fn streaming_and_paused_redraws_complete_once_per_picture_and_context() {
+        let mut completed = None;
+        let mut renders = 0;
+        // HDR streaming A, same paused A, streaming B on the same target,
+        // paused B on SDR, duplicate SDR notification, restored HDR.
+        for (frame, context) in [(1, 1), (1, 1), (2, 1), (2, 2), (2, 2), (2, 3)] {
+            if super::redraw_needed(completed, frame, context) {
+                renders += 1;
+                completed = Some((frame, context));
+            }
+        }
+        assert_eq!(renders, 4);
+    }
+}
