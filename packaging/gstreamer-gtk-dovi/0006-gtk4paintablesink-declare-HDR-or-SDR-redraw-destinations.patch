+// Public destination ABI1. Every missing physical witness selects real SDR.
+fn destination_kind(valid: bool, ready: bool, composed: bool) -> i32 {
+    if valid && ready && composed { 0 } else { 1 }
+}
+pub(crate) fn requested_destination(context: &gst::Context) -> i32 {
+    let s = context.structure();
+    destination_kind(s.get::<bool>("valid").unwrap_or(false),
+        s.get::<bool>("hdr-ready").unwrap_or(false),
+        s.get::<bool>("composed").unwrap_or(false))
+}
+pub(crate) fn pixel_destination(info: &gst_video::VideoInfo) -> Option<i32> {
+    use gst_video::{VideoColorMatrix as M, VideoColorPrimaries as P, VideoColorRange as R, VideoTransferFunction as T};
+    let c = info.colorimetry();
+    if c.matrix() != M::Rgb || c.range() != R::Range0_255 { return None; }
+    match (c.primaries(), c.transfer(), info.format()) {
+        (P::Bt709, T::Srgb, gst_video::VideoFormat::Rgba) => Some(1),
+        (P::Bt2020, T::Smpte2084, gst_video::VideoFormat::Rgba64Le) => Some(0),
+        _ => None,
+    }
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct PictureKey { pub epoch: u64, pub frame: u64, pub context: u64 }
+#[derive(Default)]
+pub(crate) struct PublicationState {
+    completed: Option<PictureKey>,
+    published: Option<PictureKey>,
+    ordinary_barrier: u64,
+}
+impl PublicationState {
+    pub(crate) fn has_current_pixels(&self, epoch: u64, context: u64) -> bool {
+        self.published.is_some_and(|p| p.epoch == epoch && p.context == context)
+    }
+    pub(crate) fn needs_redraw(&self, key: PictureKey) -> bool { self.completed != Some(key) }
+    pub(crate) fn complete_without_pixels(&mut self, key: PictureKey) { self.completed = Some(key); }
+    pub(crate) fn record_published(&mut self, key: PictureKey, ordinary: bool) {
+        if ordinary { self.ordinary_barrier = self.ordinary_barrier.max(key.frame); }
+        self.completed = Some(key); self.published = Some(key);
+    }
+    pub(crate) fn can_publish(&self, key: PictureKey, epoch: u64, context: u64, source_live: bool) -> bool {
+        source_live && key.epoch == epoch && key.context == context && key.frame >= self.ordinary_barrier &&
+            self.published.is_none_or(|old| old.epoch != key.epoch || key.frame > old.frame ||
+                (key.frame == old.frame && key.context != old.context))
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::{PictureKey as K, PublicationState as S};
+    #[test]
+    fn destination_requires_all_witnesses() {
+        for f in 0..8 { assert_eq!(super::destination_kind(f & 1 != 0, f & 2 != 0, f & 4 != 0), if f == 7 { 0 } else { 1 }); }
+    }
+    #[test]
+    fn delayed_publications_keep_hdr_streaming_and_reject_old_context_or_source() {
+        let mut state = S::default(); let mut painted = Vec::new();
+        let a = K { epoch: 1, frame: 1, context: 1 };
+        let c = K { frame: 3, ..a };
+        // A is in flight while B and C replace the bounded latest eligible
+        // source. None of their SDR baselines is published on the HDR route.
+        for key in [a, c] {
+            assert!(state.can_publish(key, 1, 1, true));
+            state.record_published(key, false); painted.push((key.frame, "PQ"));
+        }
+        assert_eq!(painted, [(1, "PQ"), (3, "PQ")]);
+        assert!(!state.can_publish(a, 1, 1, true));
+        // Target changes after render but before its main-context callback.
+        assert!(!state.can_publish(c, 1, 2, true));
+        let d = K { frame: 4, context: 2, ..a };
+        state.record_published(d, true); painted.push((4, "SDR"));
+        assert!(!state.can_publish(c, 1, 2, true));
+        let restored = K { context: 3, ..d };
+        assert!(state.can_publish(restored, 1, 3, true));
+        state.record_published(restored, false); painted.push((4, "PQ"));
+        assert!(!state.needs_redraw(restored));
+        // A newer ordinary/non-native picture is a publication barrier even
+        // within one epoch; a late PQ completion cannot overwrite it.
+        let ordinary = K { frame: 5, ..restored };
+        state.record_published(ordinary, true); painted.push((5, "SDR"));
+        assert!(!state.can_publish(restored, 1, 3, true));
+        assert!(!state.can_publish(ordinary, 2, 3, true));
+        assert!(!state.can_publish(K { frame: 6, ..ordinary }, 1, 3, false));
+        assert_eq!(painted, [(1, "PQ"), (3, "PQ"), (4, "SDR"), (4, "PQ"), (5, "SDR")]);
+    }
+}
