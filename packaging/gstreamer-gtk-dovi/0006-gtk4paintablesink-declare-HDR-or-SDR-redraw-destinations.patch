+// SPDX-License-Identifier: MPL-2.0
+// Shared production publication boundary. No GTK/GStreamer dependency: tests
+// drive the same offer/completion/paint callbacks used by the live sink.
+use std::sync::Mutex;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct PictureKey { pub epoch: u64, pub frame: u64, pub context: u64 }
+#[derive(Clone, Copy)]
+pub(crate) struct Offer {
+    pub key: PictureKey,
+    pub pixels: Option<i32>,
+    pub native: bool,
+    pub generation_matches: bool,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Outcome { Held, Published, Dropped, Retracted, Superseded, Failed }
+struct State {
+    epoch: u64, context: u64, wanted: i32,
+    completed: Option<PictureKey>, published: Option<PictureKey>,
+    ordinary_barrier: u64, next_paint: u64, image_token: u64,
+}
+impl Default for State {
+    fn default() -> Self {
+        Self { epoch: 0, context: 0, wanted: 1, completed: None,
+            published: None, ordinary_barrier: 0, next_paint: 0, image_token: 0 }
+    }
+}
+impl State {
+    fn current(&self, key: PictureKey) -> bool { key.epoch == self.epoch && key.context == self.context }
+    fn accepts(&self, key: PictureKey) -> bool {
+        self.current(key) && key.frame >= self.ordinary_barrier &&
+            self.published.is_none_or(|old| old.epoch != key.epoch || key.frame > old.frame ||
+                (key.frame == old.frame && key.context != old.context))
+    }
+}
+#[derive(Default)]
+pub(crate) struct Coordinator { state: Mutex<State> }
+impl Coordinator {
+    pub(crate) fn set_view(&self, epoch: u64, context: u64, wanted: i32) {
+        let mut s = self.state.lock().unwrap();
+        if epoch != s.epoch { s.ordinary_barrier = 0; s.completed = None; }
+        s.epoch = epoch; s.context = context; s.wanted = wanted;
+        // Keep the actual image token. An in-progress paint must still retract
+        // itself after source/context revocation, even with an older published
+        // key in bookkeeping. Only another actual paint may replace its token.
+    }
+    pub(crate) fn needs_redraw(&self, key: PictureKey) -> bool {
+        let s = self.state.lock().unwrap(); s.accepts(key) && s.completed != Some(key)
+    }
+    pub(crate) fn accepts(&self, key: PictureKey, live: bool) -> bool {
+        live && self.state.lock().unwrap().accepts(key)
+    }
+    pub(crate) fn complete_without_pixels(&self, key: PictureKey) {
+        let mut s = self.state.lock().unwrap(); if s.current(key) { s.completed = Some(key); }
+    }
+    pub(crate) fn offer(
+        &self, offer: Offer, live: impl Fn() -> bool,
+        paint: impl FnOnce() -> bool, retract: impl FnOnce(),
+    ) -> Outcome {
+        let immediate = {
+            let mut s = self.state.lock().unwrap();
+            if !s.current(offer.key) { return Outcome::Dropped; }
+            if !offer.native { s.ordinary_barrier = s.ordinary_barrier.max(offer.key.frame); }
+            !offer.native || (offer.pixels == Some(s.wanted) &&
+                (s.wanted == 1 || offer.generation_matches))
+        };
+        if !live() { return Outcome::Dropped; }
+        if !immediate { return Outcome::Held; }
+        self.publish(offer.key, live, paint, retract)
+    }
+    pub(crate) fn complete(
+        &self, key: PictureKey, pixels: i32, live: impl Fn() -> bool,
+        paint: impl FnOnce() -> bool, retract: impl FnOnce(),
+    ) -> Outcome {
+        if self.state.lock().unwrap().wanted != pixels { return Outcome::Dropped; }
+        self.publish(key, live, paint, retract)
+    }
+    fn publish(
+        &self, key: PictureKey, live: impl Fn() -> bool,
+        paint: impl FnOnce() -> bool, retract: impl FnOnce(),
+    ) -> Outcome {
+        if !live() { return Outcome::Dropped; }
+        let (token, previous) = {
+            let mut s = self.state.lock().unwrap();
+            if !s.accepts(key) { return Outcome::Dropped; }
+            s.next_paint = s.next_paint.checked_add(1).expect("native paint token exhausted");
+            let token = s.next_paint; let previous = s.image_token;
+            s.image_token = token; (token, previous)
+        };
+        if !live() {
+            let mut s = self.state.lock().unwrap();
+            if s.image_token == token { s.image_token = previous; }
+            return Outcome::Dropped;
+        }
+        // No coordinator mutex is held through GTK or user callbacks. Nested
+        // publication gets its own token and cannot be retracted by this paint.
+        let painted = paint();
+        let live_after = live();
+        let mut s = self.state.lock().unwrap();
+        if s.image_token != token { return Outcome::Superseded; }
+        if painted && live_after && s.accepts(key) {
+            s.published = Some(key); s.completed = Some(key);
+            return Outcome::Published;
+        }
+        s.image_token = 0;
+        if !painted && s.current(key) { s.completed = Some(key); }
+        drop(s); retract();
+        if painted { Outcome::Retracted } else { Outcome::Failed }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::cell::RefCell;
+    use std::sync::atomic::{AtomicBool, Ordering};
+    fn key(frame: u64, context: u64) -> PictureKey { PictureKey { epoch: 1, frame, context } }
+    #[test]
+    fn delayed_streaming_completion_paints_pq_without_sdr_pulses() {
+        let c = Coordinator::default(); c.set_view(1, 1, 0);
+        let painted = RefCell::new(Vec::new());
+        // A begins work, then B/C arrive before A completes. These calls are
+        // exactly the production offer boundary, with actual paint callbacks.
+        for frame in 1..=3 {
+            assert_eq!(c.offer(Offer { key: key(frame, 1), pixels: Some(1), native: true,
+                generation_matches: true }, || true,
+                || { painted.borrow_mut().push((frame, 1)); true }, || panic!("no paint to retract")), Outcome::Held);
+        }
+        assert!(painted.borrow().is_empty());
+        for frame in [1, 3] {
+            assert_eq!(c.complete(key(frame, 1), 0, || true,
+                || { painted.borrow_mut().push((frame, 0)); true }, || panic!("valid current PQ")), Outcome::Published);
+        }
+        assert_eq!(*painted.borrow(), [(1, 0), (3, 0)]);
+        assert!(!c.needs_redraw(key(3, 1)));
+        assert_eq!(c.complete(key(2, 1), 0, || true, || panic!("older completion"), || {}), Outcome::Dropped);
+        // A newer ordinary/non-native frame, even within the same source epoch,
+        // publishes immediately and prevents an older PQ job overwriting it.
+        assert_eq!(c.offer(Offer { key: key(4, 1), pixels: Some(1), native: false,
+            generation_matches: false }, || true,
+            || { painted.borrow_mut().push((4, 1)); true }, || {}), Outcome::Published);
+        assert_eq!(c.complete(key(3, 1), 0, || true, || panic!("ordinary barrier"), || {}), Outcome::Dropped);
+    }
+    #[test]
+    fn target_source_and_pause_changes_drive_real_publication_callbacks() {
+        let c = Coordinator::default(); let painted = RefCell::new(Vec::new());
+        c.set_view(1, 1, 0);
+        // Rendered for old HDR, then target changes before main publication.
+        c.set_view(1, 2, 1);
+        assert_eq!(c.complete(key(1, 1), 0, || true, || panic!("stale target"), || {}), Outcome::Dropped);
+        assert_eq!(c.offer(Offer { key: key(2, 2), pixels: Some(1), native: true,
+            generation_matches: false }, || true,
+            || { painted.borrow_mut().push((2, 1)); true }, || {}), Outcome::Published);
+        c.set_view(1, 3, 0);
+        assert!(c.needs_redraw(key(2, 3)));
+        assert_eq!(c.complete(key(2, 3), 0, || true,
+            || { painted.borrow_mut().push((2, 0)); true }, || {}), Outcome::Published);
+        assert!(!c.needs_redraw(key(2, 3)));
+        c.set_view(2, 4, 0);
+        assert_eq!(c.complete(key(3, 3), 0, || true, || panic!("old source"), || {}), Outcome::Dropped);
+        assert_eq!(*painted.borrow(), [(2, 1), (2, 0)]);
+    }
+    #[test]
+    fn revoked_before_first_observation_never_paints_direct_sdr_or_pq() {
+        for destination in [0, 1] {
+            let c = Coordinator::default(); c.set_view(1, 1, destination);
+            assert_eq!(c.offer(Offer { key: key(1, 1), pixels: Some(destination), native: true,
+                generation_matches: true }, || false, || panic!("revoked initial image"), || {}), Outcome::Dropped);
+        }
+        let c = Coordinator::default(); c.set_view(1, 1, 1);
+        assert_eq!(c.offer(Offer { key: key(1, 1), pixels: Some(1), native: false,
+            generation_matches: false }, || true, || true, || {}), Outcome::Published);
+    }
+    #[test]
+    fn revoke_during_paint_retracts_new_image_despite_older_pq_bookkeeping() {
+        let c = Coordinator::default(); c.set_view(1, 1, 0);
+        let current = RefCell::new(None); let live = AtomicBool::new(true);
+        assert_eq!(c.complete(key(1, 1), 0, || true,
+            || { *current.borrow_mut() = Some(1); true }, || {}), Outcome::Published);
+        assert_eq!(c.complete(key(2, 1), 0, || live.load(Ordering::Acquire),
+            || { *current.borrow_mut() = Some(2); live.store(false, Ordering::Release); true },
+            || { *current.borrow_mut() = None; }), Outcome::Retracted);
+        assert_eq!(*current.borrow(), None);
+    }
+    #[test]
+    fn context_change_during_paint_retracts_only_its_own_image() {
+        let c = Coordinator::default(); c.set_view(1, 1, 0);
+        let current = RefCell::new(None);
+        assert_eq!(c.complete(key(1, 1), 0, || true,
+            || { *current.borrow_mut() = Some(1); c.set_view(1, 2, 1); true },
+            || { *current.borrow_mut() = None; }), Outcome::Retracted);
+        assert_eq!(*current.borrow(), None);
+        c.set_view(1, 3, 0);
+        assert_eq!(c.complete(key(2, 3), 0, || true,
+            || {
+                *current.borrow_mut() = Some(2); c.set_view(2, 4, 1);
+                let new = PictureKey { epoch: 2, frame: 1, context: 4 };
+                assert_eq!(c.offer(Offer { key: new, pixels: Some(1), native: false,
+                    generation_matches: false }, || true,
+                    || { *current.borrow_mut() = Some(99); true }, || {}), Outcome::Published);
+                true
+            }, || { *current.borrow_mut() = None; }), Outcome::Superseded);
+        assert_eq!(*current.borrow(), Some(99));
+    }
+}
