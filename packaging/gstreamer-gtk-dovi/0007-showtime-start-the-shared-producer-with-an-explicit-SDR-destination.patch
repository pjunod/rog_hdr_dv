+def standard_destination_mapper(mapper):
+    # Optional old/absent mappers retain the existing ordinary playback route.
+    if mapper is None or not mapper.find_property("destination-abi") or not mapper.find_property("destination-kind"):
+        return None
+    if mapper.get_property("destination-abi") != 1:
+        return None
+    # Baseline/preroll is graded SDR; the retained view selects its own grade.
+    mapper.set_property("destination-kind", 1)
+    return mapper
