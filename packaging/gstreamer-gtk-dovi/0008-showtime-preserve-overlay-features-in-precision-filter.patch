From: Codex Agent <codex-agent@invalid>
Date: Fri, 13 Nov 2026 22:00:00 +0000
Subject: [PATCH] showtime: preserve overlays through the precision filter

Keep the existing plain RGBA preferences and admit the matching GL/system
memory variants carrying GstVideoOverlayComposition. The mapper preserves
that meta, so a downstream plain-only filter cannot represent its graded
overlay output. Accept both system-memory feature spellings.

No decoder, subtitle selection, destination or rendering policy changes.

--- a/showtime/play.py
+++ b/showtime/play.py
@@ -82,5 +82,11 @@
         if self.precision_filter is not None and self.precision_dolby != self.dolby_stream:
-            caps = Gst.Caps.from_string("video/x-raw(memory:GLMemory),format=RGBA;video/x-raw,format=RGBA") if self.dolby_stream else Gst.Caps.new_any()
+            caps = Gst.Caps.from_string(
+                "video/x-raw(memory:GLMemory),format=RGBA;"
+                "video/x-raw,format=RGBA;"
+                "video/x-raw(memory:GLMemory,meta:GstVideoOverlayComposition),format=RGBA;"
+                "video/x-raw(memory:SystemMemory,meta:GstVideoOverlayComposition),format=RGBA;"
+                "video/x-raw(meta:GstVideoOverlayComposition),format=RGBA"
+            ) if self.dolby_stream else Gst.Caps.new_any()
             self.precision_filter.set_property("caps", caps)
             self.precision_dolby = self.dolby_stream
         picture = self.picture()
