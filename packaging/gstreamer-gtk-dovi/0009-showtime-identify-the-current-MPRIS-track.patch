+    @staticmethod
+    def _current_media_info(play: GstPlay.Play | None) -> GstPlay.PlayMediaInfo | None:
+        if play and (media_info := play.get_media_info()):
+            uri = media_info.get_uri()
+            if uri and uri == play.get_uri():
