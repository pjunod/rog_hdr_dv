-	$(GTK4_BUILD) dh_auto_build -Bbuild-gtk4
+	$(GTK4_BUILD) dh_auto_build -B"$(ROG_WEBKIT_BUILD_DIR)"
 
 override_dh_auto_install:
+	python3 debian/rog-native-hdr/verify-build.py
+	$(MAKE) -f debian/rules rog-native-manifests
 	$(GTK3_BUILD) dh_auto_install -Bbuild-gtk3
-	$(GTK4_BUILD) dh_auto_install -Bbuild-gtk4
+	$(GTK4_BUILD) dh_auto_install -B"$(ROG_WEBKIT_BUILD_DIR)"
 
 override_dh_auto_clean: debian/control
+ifneq ($(ROG_WEBKIT_BUILD_DIR),build-gtk4)
+	$(error External warm cache clean is refused; unset ROG_WEBKIT_BUILD_DIR for source-owned clean)
+endif
 	$(GTK3_BUILD) dh_auto_clean -Bbuild-gtk3
-	$(GTK4_BUILD) dh_auto_clean -Bbuild-gtk4
+	$(GTK4_BUILD) dh_auto_clean -B"$(ROG_WEBKIT_BUILD_DIR)"
 	find Source Tools -type f -name "*.pyc" -exec rm {} \;
 	find Source Tools -depth -type d -name __pycache__ -exec rmdir {} \;
 
