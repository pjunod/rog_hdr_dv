 override_dh_auto_configure:
+	python3 debian/rog-native-hdr/verify-build.py --path-only
+ifneq ($(ROG_WEBKIT_BUILD_DIR),build-gtk4)
+	$(error Use dpkg-buildpackage -b -nc for a verified external cache; configure is refused)
