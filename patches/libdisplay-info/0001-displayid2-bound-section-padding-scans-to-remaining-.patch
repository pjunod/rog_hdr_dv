From da6168b6c046a11036c79d32df0c2c8e68e73f60 Mon Sep 17 00:00:00 2001
From: Paul Junod <donujp@gmail.com>
Date: Wed, 7 Oct 2026 22:31:52 -0400
Subject: [PATCH 1/4] displayid2: bound section padding scans to remaining
 payload

An oversized declared block advanced past the section payload, and a
stale remaining length made the final padding scan read beyond its end.
Clamp a truncated block to the available payload and recompute the
remaining size before scanning padding, excluding the checksum.

Add exact-sized public API regressions for empty payloads, short headers,
complete blocks and oversized lengths. The old tree fails under ASan;
the corrected scan also removes a spurious JDI padding diagnostic.
---
 displayid2.c                      |  5 ++--
 test/data/jdi-lpm135m467-edp.diff | 11 ++++----
 test/displayid2-bounds.c          | 45 +++++++++++++++++++++++++++++++
 test/meson.build                  |  3 +++
 4 files changed, 56 insertions(+), 8 deletions(-)
 create mode 100644 test/displayid2-bounds.c

diff --git a/displayid2.c b/displayid2.c
index 6ab9c7b..460ffeb 100644
--- a/displayid2.c
+++ b/displayid2.c
@@ -92,9 +92,9 @@ parse_data_block(struct di_displayid2 *displayid2, const uint8_t *data,
 	data_block_size = (size_t) data[0x02] + DISPLAYID2_DATA_BLOCK_HEADER_SIZE;
 	if (data_block_size > size) {
 		add_failure(displayid2,
-			    "The length of this DisplayID data block (%d) exceeds the number of bytes remaining (%zu)",
+			    "The length of this DisplayID data block (%zu) exceeds the number of bytes remaining (%zu)",
 			    data_block_size, size);
-		goto skip;
+		return (ssize_t) size;
 	}
 
 	data_block = calloc(1, sizeof(*data_block));
@@ -245,6 +245,7 @@ _di_displayid2_parse(struct di_displayid2 *displayid2, const uint8_t *data,
 		assert(data_block_size > 0);
 		i += (size_t) data_block_size;
 	}
+	max_data_block_size = section_size - 1 - i;
 	if (!is_all_zeroes(&data[i], max_data_block_size)) {
 		if (max_data_block_size < DISPLAYID2_DATA_BLOCK_HEADER_SIZE) {
 			add_failure(displayid2,
diff --git a/test/data/jdi-lpm135m467-edp.diff b/test/data/jdi-lpm135m467-edp.diff
index c5167a0..c6b3f3c 100644
--- a/test/data/jdi-lpm135m467-edp.diff
+++ b/test/data/jdi-lpm135m467-edp.diff
@@ -1,6 +1,6 @@
 --- ref
 +++ di
-@@ -36,32 +36,13 @@
+@@ -36,32 +36,9 @@
  
  Block 1, DisplayID Extension Block:
    Version: 2.0
@@ -22,8 +22,8 @@
 -Block 0, Base EDID:
 -  Missing Display Product Name.
 -
- Failures:
- 
+-Failures:
+-
 -Block 0, Base EDID:
 -  Alphanumeric Data String: No newline, but one or more trailing spaces.
 -  Alphanumeric Data String: No newline, but one or more trailing spaces.
@@ -33,6 +33,5 @@
 -  DisplayID: Missing DisplayID Type VII Detailed Timing Data Block.
 -  DisplayID: DisplayID expects at least one preferred timing.
 -
-+Block 1, DisplayID Extension Block:
-+  Padding: Contains non-zero bytes.
- EDID conformity: FAIL
+-EDID conformity: FAIL
++EDID conformity: PASS
diff --git a/test/displayid2-bounds.c b/test/displayid2-bounds.c
new file mode 100644
index 0000000..5a36282
--- /dev/null
+++ b/test/displayid2-bounds.c
@@ -0,0 +1,45 @@
+#include <assert.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <libdisplay-info/info.h>
+
+static void
+check(size_t payload, uint8_t declared)
+{
+	uint8_t *data = calloc(1, payload + 5);
+	struct di_info *info;
+	uint8_t sum = 0;
+	size_t i;
+
+	assert(data);
+	data[0] = 0x20;
+	data[1] = (uint8_t) payload;
+	data[2] = 2;
+	if (payload >= 3) {
+		data[4] = 0x20;
+		data[6] = declared;
+	} else if (payload) {
+		data[4] = 1;
+	}
+	for (i = 0; i < payload + 4; i++)
+		sum += data[i];
+	data[payload + 4] = (uint8_t) (0 - sum);
+	info = di_info_parse_displayid(data, payload + 5);
+	assert(info);
+	di_info_destroy(info);
+	free(data);
+}
+
+int
+main(void)
+{
+	check(0, 0);
+	check(1, 0);
+	check(2, 0);
+	check(3, 0);
+	check(3, 255);
+	check(12, 9);
+	check(3, 187); /* zero checksum, oversized block */
+	return 0;
+}
diff --git a/test/meson.build b/test/meson.build
index 34e150f..0a7035e 100644
--- a/test/meson.build
+++ b/test/meson.build
@@ -134,3 +134,6 @@ if ref_edid_decode.found()
 
 	alias_target('gen-test-data', edid_decode_gen, di_print_gen)
 endif
+
+section_bounds = executable('displayid2-bounds', 'displayid2-bounds.c', dependencies: di_dep)
+test('displayid2-bounds', section_bounds)
