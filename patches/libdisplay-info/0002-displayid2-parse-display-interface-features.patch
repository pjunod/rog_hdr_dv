+struct interface_flag {
+	uint8_t mask;
+	const char *name;
+};
+
+static void
+print_flags(const char *label, uint8_t mask, const struct interface_flag flags[])
+{
+	size_t i;
+	bool first = true;
+
+	if (!mask)
+		return;
+	printf("    %s: ", label);
+	for (i = 0; i < 8; i++) {
+		if (!(mask & flags[i].mask))
+			continue;
+		if (!first)
+			printf(", ");
+		if (flags[i].name)
+			printf("%s", flags[i].name);
+		else
+			printf("Undefined (%zu)", i);
+		first = false;
+	}
+	printf("\n");
+}
+
+static void
+print_interface_features(const struct di_displayid2_interface_features *f)
+{
+	static const struct interface_flag depths444[8] = {
+		{DI_DISPLAYID2_BIT_DEPTH_444_6, "6"},
+		{DI_DISPLAYID2_BIT_DEPTH_444_8, "8"},
+		{DI_DISPLAYID2_BIT_DEPTH_444_10, "10"},
+		{DI_DISPLAYID2_BIT_DEPTH_444_12, "12"},
+		{DI_DISPLAYID2_BIT_DEPTH_444_14, "14"},
+		{DI_DISPLAYID2_BIT_DEPTH_444_16, "16"},
+	};
+	static const struct interface_flag depths4xx[8] = {
+		{DI_DISPLAYID2_BIT_DEPTH_4XX_8, "8"},
+		{DI_DISPLAYID2_BIT_DEPTH_4XX_10, "10"},
+		{DI_DISPLAYID2_BIT_DEPTH_4XX_12, "12"},
+		{DI_DISPLAYID2_BIT_DEPTH_4XX_14, "14"},
+		{DI_DISPLAYID2_BIT_DEPTH_4XX_16, "16"},
+	};
+	static const struct interface_flag audio[8] = {
+		{DI_DISPLAYID2_AUDIO_32_KHZ, "32"},
+		{DI_DISPLAYID2_AUDIO_44_1_KHZ, "44.1"},
+		{DI_DISPLAYID2_AUDIO_48_KHZ, "48"},
+		{1 << 4, NULL}, {1 << 3, NULL}, {1 << 2, NULL},
+		{1 << 1, NULL}, {1 << 0, NULL},
+	};
+	static const struct interface_flag standard[8] = {
+		{DI_DISPLAYID2_COMBINATION_SRGB, "sRGB"},
+		{DI_DISPLAYID2_COMBINATION_BT601, "BT.601"},
+		{DI_DISPLAYID2_COMBINATION_BT709_BT1886, "BT.709/BT.1886"},
+		{DI_DISPLAYID2_COMBINATION_ADOBE_RGB, "Adobe RGB"},
+		{DI_DISPLAYID2_COMBINATION_DCI_P3, "DCI-P3"},
+		{DI_DISPLAYID2_COMBINATION_BT2020, "BT.2020"},
+		{DI_DISPLAYID2_COMBINATION_BT2020_ST2084, "BT.2020/SMPTE ST 2084"},
+	};
+	static const char *const colors[] = {
+		[DI_DISPLAYID2_COLOR_SPACE_UNDEFINED] = "Undefined",
+		[DI_DISPLAYID2_COLOR_SPACE_SRGB] = "sRGB",
+		[DI_DISPLAYID2_COLOR_SPACE_BT601] = "BT.601",
+		[DI_DISPLAYID2_COLOR_SPACE_BT709] = "BT.709",
+		[DI_DISPLAYID2_COLOR_SPACE_ADOBE_RGB] = "Adobe RGB",
+		[DI_DISPLAYID2_COLOR_SPACE_DCI_P3] = "DCI-P3",
+		[DI_DISPLAYID2_COLOR_SPACE_BT2020] = "BT.2020",
+		[DI_DISPLAYID2_COLOR_SPACE_CUSTOM] = "Custom",
+	};
+	static const char *const eotfs[] = {
+		[DI_DISPLAYID2_EOTF_UNDEFINED] = "Undefined",
+		[DI_DISPLAYID2_EOTF_SRGB] = "sRGB",
+		[DI_DISPLAYID2_EOTF_BT601] = "BT.601",
+		[DI_DISPLAYID2_EOTF_BT1886] = "BT.1886",
+		[DI_DISPLAYID2_EOTF_ADOBE_RGB] = "Adobe RGB",
+		[DI_DISPLAYID2_EOTF_DCI_P3] = "DCI-P3",
+		[DI_DISPLAYID2_EOTF_BT2020] = "BT.2020",
+		[DI_DISPLAYID2_EOTF_GAMMA] = "Gamma function",
+		[DI_DISPLAYID2_EOTF_ST2084] = "SMPTE ST 2084",
+		[DI_DISPLAYID2_EOTF_HYBRID_LOG] = "Hybrid Log",
+		[DI_DISPLAYID2_EOTF_CUSTOM] = "Custom",
+	};
+	const struct di_displayid2_color_eotf *pair;
+	const char *color, *eotf;
+	size_t i;
+
+	print_flags("Supported bpc for RGB encoding", f->rgb_bit_depths, depths444);
+	print_flags("Supported bpc for YCbCr 4:4:4 encoding", f->ycbcr444_bit_depths, depths444);
+	print_flags("Supported bpc for YCbCr 4:2:2 encoding", f->ycbcr422_bit_depths, depths4xx);
+	print_flags("Supported bpc for YCbCr 4:2:0 encoding", f->ycbcr420_bit_depths, depths4xx);
+	if (f->ycbcr420_min_pixel_rate > 0)
+		printf("    Minimum pixel rate at which YCbCr 4:2:0 encoding is supported: %.3f MHz\n",
+		       f->ycbcr420_min_pixel_rate);
+	print_flags("Supported audio capability and features (kHz)", f->audio_capabilities, audio);
+	print_flags("Supported color space and EOTF standard combination 1",
+		    f->standard_combinations, standard);
+	if (!f->additional_combinations_len)
+		return;
+	printf("    Supported color space and EOTF additional combinations:");
+	for (i = 0; i < f->additional_combinations_len; i++) {
+		pair = &f->additional_combinations[i];
+		color = pair->color_space <= DI_DISPLAYID2_COLOR_SPACE_CUSTOM ?
+			colors[pair->color_space] : "Out of range";
+		eotf = pair->eotf <= DI_DISPLAYID2_EOTF_CUSTOM ?
+			eotfs[pair->eotf] : "Out of range";
+		if (i)
+			printf(", ");
+		if (strcmp(color, eotf) == 0)
+			printf("%s", color);
+		else
+			printf("%s/%s", color, eotf);
+	}
+	printf("\n");
+}
