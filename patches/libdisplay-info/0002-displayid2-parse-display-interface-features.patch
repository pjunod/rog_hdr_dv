+		if (features)
+			print_interface_features(features);
+		break;
 	case DI_DISPLAYID2_DATA_BLOCK_CTA861:
 		cta_data_blocks = di_displayid2_data_block_get_cta_data_blocks(data_block);
 		for (i = 0; cta_data_blocks[i] != NULL; i++) {
diff --git a/displayid2.c b/displayid2.c
index 460ffeb..b3872ff 100644
--- a/displayid2.c
+++ b/displayid2.c
@@ -78,6 +78,54 @@ parse_cta861_block(struct di_displayid2 *displayid2, struct di_displayid2_data_b
 	return true;
 }
 
+static bool
+parse_interface_features(struct di_displayid2 *displayid2,
+			 struct di_displayid2_data_block *block,
+			 const uint8_t *data, size_t size)
+{
+	struct di_displayid2_interface_features *features = &block->interface_features;
+	uint8_t count, pair;
+	size_t i;
+
+	if (data[1] != 0) {
+		add_failure(displayid2, "Display Interface Features: unsupported revision or flags.");
+		return false;
+	}
+	if (size < 12) {
+		add_failure(displayid2, "Display Interface Features: fixed payload is too short.");
+		return false;
+	}
+	count = data[11];
+	if (count > 7 || size != (size_t) 12 + count) {
+		add_failure(displayid2,
+			    "Display Interface Features: invalid additional combination count or length.");
+		return false;
+	}
+	if ((data[3] & 0xC0) || (data[4] & 0xC0) ||
+	    (data[5] & 0xE0) || (data[6] & 0xE0) ||
+	    (data[9] & 0x80) || data[10]) {
+		add_failure(displayid2, "Display Interface Features: reserved mask bits are set.");
+	}
+	features->rgb_bit_depths = data[3] & 0x3F;
+	features->ycbcr444_bit_depths = data[4] & 0x3F;
+	features->ycbcr422_bit_depths = data[5] & 0x1F;
+	features->ycbcr420_bit_depths = data[6] & 0x1F;
+	features->ycbcr420_min_pixel_rate = 74.25f * data[7];
+	features->audio_capabilities = data[8];
+	features->standard_combinations = data[9] & 0x7F;
+	features->additional_combinations_len = count;
+	for (i = 0; i < count; i++) {
+		pair = data[12 + i];
+		features->additional_combinations[i].color_space = pair >> 4;
+		features->additional_combinations[i].eotf = pair & 0x0F;
+		if ((pair >> 4) > DI_DISPLAYID2_COLOR_SPACE_CUSTOM ||
+		    (pair & 0x0F) > DI_DISPLAYID2_EOTF_CUSTOM) {
+			add_failure(displayid2, "Display Interface Features: reserved additional combination.");
+		}
+	}
+	return true;
+}
+
 static ssize_t
 parse_data_block(struct di_displayid2 *displayid2, const uint8_t *data,
 		 size_t size)
@@ -107,13 +155,16 @@ parse_data_block(struct di_displayid2 *displayid2, const uint8_t *data,
 			goto error;
 		}
 		break;
+	case DI_DISPLAYID2_DATA_BLOCK_DISPLAY_INTERFACE_FEATURES:
+		if (!parse_interface_features(displayid2, data_block, data, data_block_size))
+			goto skip;
+		break;
 	case DI_DISPLAYID2_DATA_BLOCK_PRODUCT_ID:
 	case DI_DISPLAYID2_DATA_BLOCK_DISPLAY_PARAMS:
 	case DI_DISPLAYID2_DATA_BLOCK_TYPE_VII_TIMING:
 	case DI_DISPLAYID2_DATA_BLOCK_TYPE_VIII_TIMING:
 	case DI_DISPLAYID2_DATA_BLOCK_TYPE_IX_TIMING:
 	case DI_DISPLAYID2_DATA_BLOCK_DYN_TIMING_RANGE_LIMITS:
-	case DI_DISPLAYID2_DATA_BLOCK_DISPLAY_INTERFACE_FEATURES:
 	case DI_DISPLAYID2_DATA_BLOCK_STEREO_DISPLAY_INTERFACE:
 	case DI_DISPLAYID2_DATA_BLOCK_TILED_DISPLAY_TOPO:
 	case DI_DISPLAYID2_DATA_BLOCK_CONTAINERID:
@@ -312,3 +363,11 @@ di_displayid2_data_block_get_cta_data_blocks(const struct di_displayid2_data_blo
 	}
 	return (const struct di_cta_data_block *const *) data_block->cta861.data_blocks;
 }
+
+const struct di_displayid2_interface_features *
+di_displayid2_data_block_get_interface_features(const struct di_displayid2_data_block *data_block)
+{
+	if (data_block->tag != DI_DISPLAYID2_DATA_BLOCK_DISPLAY_INTERFACE_FEATURES)
+		return NULL;
+	return &data_block->interface_features;
+}
