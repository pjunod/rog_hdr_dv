+++ b/test/gen-displayid2-interface.py
@@ -0,0 +1,24 @@
+#!/usr/bin/env python3
+"""Generate a synthetic interface-feature EDID without hardware source data."""
+import pathlib
+import sys
+
+edid = bytearray(256)
+edid[:8] = bytes.fromhex("00ffffffffffff00")
+edid[8:10] = bytes.fromhex("5274")
+edid[10] = 1
+edid[16:25] = bytes([1, 36, 1, 4, 0xa5, 0, 0, 120, 2])
+edid[38:54] = bytes([1, 1]) * 8
+for i in range(4):
+    edid[54 + 18 * i + 3] = 0x10
+edid[126] = 1
+edid[127] = -sum(edid[:127]) % 256
+section = bytearray([
+    0x20, 16, 2, 0,
+    0x26, 0, 13, 4, 2, 3, 1, 2, 0xe0, 0x50, 0, 4, 0x68, 0x58, 0x66, 0x11, 0,
+])
+section[-1] = -sum(section[:-1]) % 256
+edid[128] = 0x70
+edid[129:129 + len(section)] = section
+edid[255] = -sum(edid[128:255]) % 256
+pathlib.Path(sys.argv[1]).write_bytes(edid)
