diff --git a/include/libdisplay-info/displayid2.h b/include/libdisplay-info/displayid2.h
index 27b147b..585189f 100644
--- a/include/libdisplay-info/displayid2.h
+++ b/include/libdisplay-info/displayid2.h
@@ -118,4 +118,124 @@ di_displayid2_get_product_primary_use_case(const struct di_displayid2 *displayid
 const struct di_cta_data_block *const *
 di_displayid2_data_block_get_cta_data_blocks(const struct di_displayid2_data_block *data_block);
 
+/** Supported RGB/YCbCr 4:4:4 bit-depth flags. */
+enum di_displayid2_bit_depth_444 {
+	DI_DISPLAYID2_BIT_DEPTH_444_6 = 1 << 0,
+	DI_DISPLAYID2_BIT_DEPTH_444_8 = 1 << 1,
+	DI_DISPLAYID2_BIT_DEPTH_444_10 = 1 << 2,
+	DI_DISPLAYID2_BIT_DEPTH_444_12 = 1 << 3,
+	DI_DISPLAYID2_BIT_DEPTH_444_14 = 1 << 4,
+	DI_DISPLAYID2_BIT_DEPTH_444_16 = 1 << 5,
+};
+
+/** Supported YCbCr 4:2:2/4:2:0 bit-depth flags. */
+enum di_displayid2_bit_depth_4xx {
+	DI_DISPLAYID2_BIT_DEPTH_4XX_8 = 1 << 0,
+	DI_DISPLAYID2_BIT_DEPTH_4XX_10 = 1 << 1,
+	DI_DISPLAYID2_BIT_DEPTH_4XX_12 = 1 << 2,
+	DI_DISPLAYID2_BIT_DEPTH_4XX_14 = 1 << 3,
+	DI_DISPLAYID2_BIT_DEPTH_4XX_16 = 1 << 4,
+};
+
+/** Supported audio sample-rate flags. */
+enum di_displayid2_audio_capability {
+	DI_DISPLAYID2_AUDIO_32_KHZ = 1 << 7,
+	DI_DISPLAYID2_AUDIO_44_1_KHZ = 1 << 6,
+	DI_DISPLAYID2_AUDIO_48_KHZ = 1 << 5,
+};
+
+/** Standard color space/EOTF combination flags. */
+enum di_displayid2_standard_combination {
+	DI_DISPLAYID2_COMBINATION_SRGB = 1 << 0,
+	DI_DISPLAYID2_COMBINATION_BT601 = 1 << 1,
+	DI_DISPLAYID2_COMBINATION_BT709_BT1886 = 1 << 2,
+	DI_DISPLAYID2_COMBINATION_ADOBE_RGB = 1 << 3,
+	DI_DISPLAYID2_COMBINATION_DCI_P3 = 1 << 4,
+	DI_DISPLAYID2_COMBINATION_BT2020 = 1 << 5,
+	DI_DISPLAYID2_COMBINATION_BT2020_ST2084 = 1 << 6,
+};
+
+/** Known additional-combination color-space encodings. */
+enum di_displayid2_color_space {
+	DI_DISPLAYID2_COLOR_SPACE_UNDEFINED = 0,
+	DI_DISPLAYID2_COLOR_SPACE_SRGB = 1,
+	DI_DISPLAYID2_COLOR_SPACE_BT601 = 2,
+	DI_DISPLAYID2_COLOR_SPACE_BT709 = 3,
+	DI_DISPLAYID2_COLOR_SPACE_ADOBE_RGB = 4,
+	DI_DISPLAYID2_COLOR_SPACE_DCI_P3 = 5,
+	DI_DISPLAYID2_COLOR_SPACE_BT2020 = 6,
+	DI_DISPLAYID2_COLOR_SPACE_CUSTOM = 7,
+};
+
+/** Known additional-combination EOTF encodings. */
+enum di_displayid2_eotf {
+	DI_DISPLAYID2_EOTF_UNDEFINED = 0,
+	DI_DISPLAYID2_EOTF_SRGB = 1,
+	DI_DISPLAYID2_EOTF_BT601 = 2,
+	DI_DISPLAYID2_EOTF_BT1886 = 3,
+	DI_DISPLAYID2_EOTF_ADOBE_RGB = 4,
+	DI_DISPLAYID2_EOTF_DCI_P3 = 5,
+	DI_DISPLAYID2_EOTF_BT2020 = 6,
+	DI_DISPLAYID2_EOTF_GAMMA = 7,
+	DI_DISPLAYID2_EOTF_ST2084 = 8,
+	DI_DISPLAYID2_EOTF_HYBRID_LOG = 9,
+	DI_DISPLAYID2_EOTF_CUSTOM = 10,
+};
+
+/**
+ * Additional color space/EOTF combination from a Display Interface Features
+ * data block. Values are the DisplayID v2 encodings: color space occupies the
+ * high nibble and EOTF the low nibble. Reserved values are retained verbatim;
+ * they do not describe a known capability.
+ */
+struct di_displayid2_color_eotf {
+	/* enum di_displayid2_color_space, or an uninterpreted reserved value */
+	uint8_t color_space;
+	/* enum di_displayid2_eotf, or an uninterpreted reserved value */
+	uint8_t eotf;
+};
+
+/**
+ * Display Interface Features, revision 0.
+ *
+ * Bit-depth masks use bits 0 through 5 for 6, 8, 10, 12, 14, 16 bpc in
+ * RGB/4:4:4, and bits 0 through 4 for 8, 10, 12, 14, 16 bpc in 4:2:2/4:2:0.
+ * Reserved mask bits are excluded. Audio flags retain the DisplayID encoding
+ * (bits 7 through 5: 32, 44.1, 48 kHz; remaining bits reserved).
+ *
+ * Standard combinations use bits 0 through 6: sRGB, BT.601, BT.709/BT.1886,
+ * Adobe RGB, DCI-P3, BT.2020, BT.2020/SMPTE ST 2084. Reserved standard bits
+ * are excluded. Additional combinations retain reserved enum values without
+ * interpreting them. Known values are named by di_displayid2_color_space
+ * and di_displayid2_eotf.
+ */
+struct di_displayid2_interface_features {
+	/* Bitmask of enum di_displayid2_bit_depth_444 */
+	uint8_t rgb_bit_depths;
+	/* Bitmask of enum di_displayid2_bit_depth_444 */
+	uint8_t ycbcr444_bit_depths;
+	/* Bitmask of enum di_displayid2_bit_depth_4xx */
+	uint8_t ycbcr422_bit_depths;
+	/* Bitmask of enum di_displayid2_bit_depth_4xx */
+	uint8_t ycbcr420_bit_depths;
+	/* MHz, zero if not specified */
+	float ycbcr420_min_pixel_rate;
+	/* Bitmask of enum di_displayid2_audio_capability; reserved bits retained */
+	uint8_t audio_capabilities;
+	/* Bitmask of enum di_displayid2_standard_combination */
+	uint8_t standard_combinations;
+	uint8_t additional_combinations_len;
+	struct di_displayid2_color_eotf additional_combinations[7];
+};
+
+/**
+ * Get Display Interface Features from a DisplayID v2 data block.
+ *
+ * Returns NULL for another tag or a structurally invalid/unsupported block.
+ * The returned pointer is owned by the DisplayID structure and remains valid
+ * until it is destroyed.
+ */
+const struct di_displayid2_interface_features *
+di_displayid2_data_block_get_interface_features(const struct di_displayid2_data_block *data_block);
+
 #endif
