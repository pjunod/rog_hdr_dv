diff --git a/test/displayid2-interface.c b/test/displayid2-interface.c
new file mode 100644
index 0000000..c5825a9
--- /dev/null
+++ b/test/displayid2-interface.c
@@ -0,0 +1,135 @@
+#include <assert.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <libdisplay-info/displayid2.h>
+#include <libdisplay-info/info.h>
+
+static void
+checksum(uint8_t *data, size_t size)
+{
+	uint8_t sum = 0;
+	size_t i;
+
+	data[size - 1] = 0;
+	for (i = 0; i < size - 1; i++)
+		sum += data[i];
+	data[size - 1] = (uint8_t) (0 - sum);
+}
+
+static struct di_info *
+parse(const uint8_t *blocks, size_t size)
+{
+	uint8_t *data = calloc(1, size + 5);
+	struct di_info *info;
+
+	if (!data)
+		abort();
+	assert(size <= 251);
+	data[0] = 0x20;
+	data[1] = (uint8_t) size;
+	data[2] = 2;
+	memcpy(data + 4, blocks, size);
+	checksum(data, size + 5);
+	info = di_info_parse_displayid(data, size + 5);
+	free(data);
+	assert(info);
+	return info;
+}
+
+static void
+check(const uint8_t *block, size_t size, bool valid)
+{
+	struct di_info *info = parse(block, size);
+	const struct di_displayid2_data_block *const *blocks;
+	const struct di_displayid2_interface_features *f;
+	size_t i;
+
+	blocks = di_displayid2_get_data_blocks(di_info_get_displayid2(info));
+	assert((blocks[0] != NULL) == valid);
+	if (!valid)
+		assert(strstr(di_info_get_failure_msg(info), "Display Interface Features"));
+	if (valid) {
+		f = di_displayid2_data_block_get_interface_features(blocks[0]);
+		assert(f);
+		assert(f->rgb_bit_depths == (block[3] & 0x3F));
+		assert(f->ycbcr444_bit_depths == (block[4] & 0x3F));
+		assert(f->ycbcr422_bit_depths == (block[5] & 0x1F));
+		assert(f->ycbcr420_bit_depths == (block[6] & 0x1F));
+		assert(f->ycbcr420_min_pixel_rate == 74.25f * block[7]);
+		assert(f->audio_capabilities == block[8]);
+		assert(f->standard_combinations == (block[9] & 0x7F));
+		assert(f->additional_combinations_len == block[11]);
+		for (i = 0; i < block[11]; i++) {
+			assert(f->additional_combinations[i].color_space == block[12 + i] >> 4);
+			assert(f->additional_combinations[i].eotf == (block[12 + i] & 15));
+		}
+	}
+	di_info_destroy(info);
+}
+
+int
+main(void)
+{
+	uint8_t block[20] = {0x26, 0, 9, 4, 0, 0, 0, 0, 0, 0x50, 0, 0};
+	uint8_t full[] = {
+		0x26, 0, 16, 0x3F, 0x12, 0x1F, 0x19, 2, 0xE0, 0x7F, 0, 7,
+		0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x68,
+	};
+	uint8_t other[] = {0x20, 0, 0};
+	uint8_t two[24];
+	struct di_info *info;
+	const struct di_displayid2_data_block *const *blocks;
+	size_t i;
+
+	check(full, sizeof(full), true);
+	info = parse(other, sizeof(other));
+	blocks = di_displayid2_get_data_blocks(di_info_get_displayid2(info));
+	assert(blocks[0] && !di_displayid2_data_block_get_interface_features(blocks[0]));
+	di_info_destroy(info);
+	check(block, 12, true);
+	block[1] = 1;
+	check(block, 12, false);
+	block[1] = 8;
+	check(block, 12, false);
+	block[1] = 0;
+	for (i = 0; i < 9; i++) {
+		block[2] = (uint8_t) i;
+		check(block, i + 3, false);
+	}
+	block[2] = 9;
+	block[9] = 0x80;
+	check(block, 12, true); /* reserved bit never becomes a standard tuple */
+	block[9] = 0xC0;
+	block[11] = 1;
+	block[2] = 10;
+	block[12] = 0xFF;
+	check(block, 13, true); /* known standard tuple survives unknown pair */
+	block[12] = 0x68;
+	check(block, 13, true);
+	block[12] = 0x86;
+	check(block, 13, true); /* nibble order is not coerced */
+	block[11] = 7;
+	block[2] = 16;
+	check(block, 19, true);
+	block[11] = 8;
+	block[2] = 17;
+	check(block, 20, false);
+	block[11] = 1;
+	block[2] = 9;
+	check(block, 12, false); /* truncated pair */
+	block[11] = 0;
+	block[2] = 10;
+	check(block, 13, false); /* trailing payload */
+	block[2] = 9;
+	memcpy(two, block, 12);
+	memcpy(two + 12, block, 12);
+	two[1] = 1;
+	info = parse(two, sizeof(two));
+	blocks = di_displayid2_get_data_blocks(di_info_get_displayid2(info));
+	assert(blocks[0] && !blocks[1]); /* malformed block doesn't shadow valid */
+	di_info_destroy(info);
+	for (i = 0; i < 1000; i++)
+		check(block, 12, true);
+	return 0;
+}
