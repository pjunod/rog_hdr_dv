diff --git a/test/edid-extension-failures.c b/test/edid-extension-failures.c
new file mode 100644
index 0000000..04004b2
--- /dev/null
+++ b/test/edid-extension-failures.c
@@ -0,0 +1,198 @@
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <libdisplay-info/info.h>
+#include <libdisplay-info/edid.h>
+
+static uint8_t base[128];
+static const uint8_t native[] = {0x26, 0, 9, 4, 0, 0, 0, 0, 0, 0x40, 0, 0};
+
+static void
+checksum(uint8_t *data, size_t size)
+{
+	uint8_t sum = 0;
+	size_t i;
+
+	data[size - 1] = 0;
+	for (i = 0; i < size - 1; i++)
+		sum += data[i];
+	data[size - 1] = (uint8_t) (0 - sum);
+}
+
+static void
+extension(uint8_t *data, const uint8_t *blocks, size_t size)
+{
+	assert(size <= 121);
+	memset(data, 0, 128);
+	data[0] = 0x70;
+	data[1] = 0x20;
+	data[2] = (uint8_t) size;
+	data[3] = 2;
+	memcpy(data + 5, blocks, size);
+	checksum(data + 1, size + 5);
+	checksum(data, 128);
+}
+
+static void
+check(const uint8_t *data, size_t size, bool failed, bool dropped, bool diagnosed)
+{
+	struct di_info *info = di_info_parse_edid(data, size);
+	const struct di_edid *edid;
+	const struct di_edid_ext *const *exts;
+	size_t count = 0;
+
+	assert(info);
+	edid = di_info_get_edid(info);
+	assert(di_edid_has_extension_failures(edid) == failed);
+	if (diagnosed)
+		assert(di_info_get_failure_msg(info));
+	exts = di_edid_get_extensions(edid);
+	while (exts[count])
+		count++;
+	assert(count == (dropped ? 1 : 2));
+	di_info_destroy(info);
+}
+
+int
+main(int argc, char **argv)
+{
+	uint8_t edid[384], blocks[32], *large;
+	const uint8_t empty[] = {0x81, 0, 0};
+	const uint8_t audio[] = {0x81, 0, 4, 0x23, 9, 7, 7};
+	const uint8_t malformed[] = {0x81, 0, 2, 0x43, 16};
+	FILE *f;
+	struct di_info *info;
+	size_t i, reverse;
+
+	assert(argc == 2);
+	f = fopen(argv[1], "rb");
+	assert(f && fread(base, sizeof(base), 1, f) == 1);
+	fclose(f);
+	memcpy(edid, base, 128);
+	edid[126] = 2;
+	checksum(edid, 128);
+	extension(edid + 128, native, sizeof(native));
+	extension(edid + 256, empty, sizeof(empty));
+	check(edid, sizeof(edid), false, false, false);
+	/* Descriptive base warnings do not imply extension ambiguity. */
+	memset(edid + 54, 0, 18);
+	edid[54 + 3] = 0xFD;
+	edid[54 + 5] = 40;
+	edid[54 + 6] = 60;
+	edid[54 + 7] = 30;
+	edid[54 + 8] = 90;
+	edid[54 + 9] = 100;
+	checksum(edid, 128);
+	check(edid, sizeof(edid), false, false, true);
+	memcpy(edid, base, 128);
+	edid[126] = 2;
+	checksum(edid, 128);
+
+	for (reverse = 0; reverse < 2; reverse++) {
+		uint8_t *other = edid + (reverse ? 128 : 256);
+
+		extension(edid + (reverse ? 256 : 128), native, sizeof(native));
+		for (i = 0; i < 3; i++) {
+			extension(other, i == 0 ? empty : i == 1 ? audio : malformed,
+				  i == 0 ? sizeof(empty) : i == 1 ? sizeof(audio) : sizeof(malformed));
+			check(edid, sizeof(edid), i == 2, false, i == 2);
+			other[6] = 1; /* Unsupported nested parent revision. */
+			checksum(other + 1, (size_t) other[2] + 5);
+			checksum(other, 128);
+			check(edid, sizeof(edid), true, false, true);
+		}
+		/* Unknown block in a retained DisplayID extension. */
+		memcpy(blocks, empty, sizeof(empty));
+		blocks[0] = 0x99;
+		extension(other, blocks, sizeof(empty));
+		check(edid, sizeof(edid), true, false, true);
+		/* Whole extension drop: unsupported major, bad use case, CTA offset. */
+		for (i = 0; i < 4; i++) {
+			extension(other, empty, sizeof(empty));
+			if (i == 0)
+				other[1] = 0x30;
+			else if (i == 1)
+				other[3] = 0xFF;
+			else if (i == 2) {
+				other[0] = 2;
+				other[1] = 3;
+				other[2] = 2;
+			}
+			if (i == 3)
+				other[other[2] + 5] ^= 1;
+			if (i < 2)
+				checksum(other + 1, (size_t) other[2] + 5);
+			checksum(other, 128);
+			check(edid, sizeof(edid), true, true, false);
+			other[127] ^= 1;
+			check(edid, sizeof(edid), true, true, true);
+		}
+		/* A retained ordinary CTA child diagnostic is also an extension failure. */
+		memset(other, 0, 128);
+		other[0] = 2;
+		other[1] = 3;
+		other[2] = 6;
+		other[4] = 0xE2;
+		other[5] = 6;
+		checksum(other, 128);
+		check(edid, sizeof(edid), true, false, true);
+		/* Known opaque extension kinds retain their prior interpretation. */
+		memset(other, 0, 128);
+		other[0] = 0xF0;
+		checksum(other, 128);
+		check(edid, sizeof(edid), false, false, false);
+		/* Unknown extension tags remain failures when revision suppresses text. */
+		for (i = 4; i < 6; i++) {
+			edid[19] = (uint8_t) i;
+			checksum(edid, 128);
+			extension(other, empty, sizeof(empty));
+			other[0] = 0xEE;
+			checksum(other, 128);
+			check(edid, sizeof(edid), true, true, false);
+		}
+		edid[19] = base[19];
+		checksum(edid, 128);
+		extension(other, empty, sizeof(empty));
+		other[127] ^= 1;
+		check(edid, sizeof(edid), true, false, true);
+	}
+	extension(edid + 128, native, sizeof(native));
+	extension(edid + 256, empty, sizeof(empty));
+	check(edid, sizeof(edid) - 1, true, true, true);
+	edid[126] = 1;
+	checksum(edid, 128);
+	check(edid, sizeof(edid), true, true, true);
+	edid[126] = 3;
+	checksum(edid, 128);
+	check(edid, sizeof(edid), true, false, true);
+	large = calloc(257, 128);
+	assert(large);
+	memcpy(large, edid, sizeof(edid));
+	large[126] = 255;
+	checksum(large, 128);
+	for (i = 3; i < 257; i++) {
+		large[128 * i] = 0xF0; /* Known opaque block-map extension. */
+		checksum(large + 128 * i, 128);
+	}
+	info = di_info_parse_edid(large, 257 * 128);
+	assert(info && di_edid_has_extension_failures(di_info_get_edid(info)));
+	di_info_destroy(info);
+	free(large);
+	/* Existing fatal base checks remain fatal. */
+	edid[126] = 2;
+	checksum(edid, 128);
+	for (i = 0; i < 3; i++) {
+		uint8_t saved = edid[i == 0 ? 0 : i == 1 ? 18 : 127];
+
+		edid[i == 0 ? 0 : i == 1 ? 18 : 127] ^= 1;
+		if (i != 2)
+			checksum(edid, 128);
+		assert(!di_info_parse_edid(edid, sizeof(edid)));
+		edid[i == 0 ? 0 : i == 1 ? 18 : 127] = saved;
+		checksum(edid, 128);
+	}
+	puts("structured extension failure, unrelated base warnings and framing matrix: PASS");
+	return 0;
+}
