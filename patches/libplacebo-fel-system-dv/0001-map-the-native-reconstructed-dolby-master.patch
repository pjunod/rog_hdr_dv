+    // Optional display-management provider. Input is reconstructed full-range
+    // RGB BT.2020/PQ before scaling. The provider owns its returned texture until
+    // the next call; output color describes the actual mapped signal. A failure
+    // fails the render rather than silently presenting unprocessed Dolby Vision.
+    // enhancement_layer_composed is true only after the native master was
+    // successfully materialized with a decoded and merged enhancement layer.
+    // Return 1 when mapped, 0 for inapplicable targets (ordinary rendering),
+    // or -1 on eligible-input processing failure.
+    int (*dovi_map)(void *priv, pl_gpu gpu, const uint8_t *rpu, size_t rpu_size,
+                     bool enhancement_layer_composed,
+                     const struct pl_color_space *target, pl_tex master,
+                     pl_tex *mapped, struct pl_color_space *mapped_color);
+    void (*dovi_reset)(void *priv);
+    void *dovi_priv;
+    // Change when provider configuration or output target policy changes.
+    uint64_t dovi_signature;
+
     // --- Deprecated/removed fields
     PL_DEPRECATED_IN(v6.254) bool allow_delayed_peak_detect; // moved to pl_peak_detect_params
     PL_DEPRECATED_IN(v6.327) const struct pl_icc_params *icc_params; // use pl_frame.icc
@@ -671,6 +688,14 @@ struct pl_frame {
     // un-applying grain makes little sense.
     struct pl_film_grain_data film_grain;
 
+    // Original per-frame Dolby Vision RPU, including all target trims. Caller
