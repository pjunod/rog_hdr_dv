+#ifdef PL_HAVE_LIBDOVI
+// True when the raw RPU enables a residual that is exactly zero for every
+// enhancement-layer code: linear dead-zone NLQ with zero slope and threshold in
+// all components, as in a Profile 7 MEL. The base-layer reshape is then the
+// complete base/enhancement reconstruction. Decided from the same RPU bytes the
+// display-management provider reads; any other or undecidable RPU is false.
+static bool dovi_rpu_residual_is_zero(const uint8_t *buf, size_t size)
+{
+    if (!buf || !size)
+        return false;
+
+    bool zero = false;
+    DoviRpuOpaque *rpu = dovi_parse_unspec62_nalu(buf, size);
+    const DoviRpuDataHeader *header = dovi_rpu_get_header(rpu);
+    if (header && !header->disable_residual_flag && !header->use_prev_vdr_rpu_flag) {
+        const DoviRpuDataMapping *mapping = dovi_rpu_get_data_mapping(rpu);
+        if (mapping && mapping->nlq && mapping->nlq_method_idc == 0) {
+            zero = true;
+            for (int c = 0; c < DoviNUM_COMPONENTS; c++) {
+                const DoviRpuDataNlq *nlq = mapping->nlq;
+                zero &= !nlq->linear_deadzone_slope_int[c] &&
+                        !nlq->linear_deadzone_slope[c] &&
+                        !nlq->linear_deadzone_threshold_int[c] &&
+                        !nlq->linear_deadzone_threshold[c];
+            }
+        }
+        dovi_rpu_free_data_mapping(mapping);
+    }
+    dovi_rpu_free_header(header);
+    dovi_rpu_free(rpu);
+    return zero;
+}
+#endif
+
 #ifdef PL_HAVE_DOVI
