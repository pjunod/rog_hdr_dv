From e459336a551ebb3a2ad534c5dedbb5274a14ebbb Mon Sep 17 00:00:00 2001
From: Codex <codex@invalid>
Date: Thu, 8 Oct 2026 01:17:39 -0400
Subject: [PATCH 3/4] drm/edid: validate native DisplayID physical luminance
 limits

Follow up Cristian La Spina's proposed DisplayID luminance support with
bounded physical-range validation. Accept exactly 29 payload bytes,
revision 0 or 1 with only the image-size unit flag, and minimum-
guaranteed
luminance information. Preserve independent device-technology parsing
and
existing CTA-derived ranges.

Decode finite nonnegative binary16 values using integers, keeping
validity
separate from a small valid minimum rounding to zero. Reject the do-not-
use
sentinel, signed values, infinities and NaNs. Require min below full-
frame
max both before and after whole-nit rounding. The 10-percent peak is not
a
physical full-frame maximum.

Clarify the Intel guard comment: historical Type 1 and forced paths
retain
their fallback; native limits add eligibility without losing the PWM-
only
XMG protection. No HDR static metadata is fabricated.

This extends missing native-range support atop an unmerged proposal; no
verified regression-introducing upstream commit exists, so no Fixes hash
is
assigned. KUnit exercises the production DRM EDID update path; exact
source
review and isolated candidate tests passed. Physical output is untested.

LLM assistance covered validation code, tests, changelog and analysis.
Original proposal authorship and genuine signoff are separate unchanged
commits. A human must review and provide any DCO attestation before
sending.

Assisted-by: LLM
---
 drivers/gpu/drm/drm_edid.c                    | 53 ++++++++++++-------
 .../drm/i915/display/intel_dp_aux_backlight.c | 11 ++--
 2 files changed, 38 insertions(+), 26 deletions(-)

diff --git a/drivers/gpu/drm/drm_edid.c b/drivers/gpu/drm/drm_edid.c
index f4845d7..5a1b00c 100644
--- a/drivers/gpu/drm/drm_edid.c
+++ b/drivers/gpu/drm/drm_edid.c
@@ -6733,29 +6733,32 @@ static void drm_displayid_process_base_section_header(struct drm_connector *conn
 		info->non_desktop = true;
 }
 
-/*
- * Convert an IEEE 754 binary16 value, the encoding DisplayID 2.0 uses for
- * luminance, to nits rounded to nearest. Negative, zero, subnormal, infinite
- * and NaN all report 0, meaning "no usable value".
- */
-static u32 displayid_binary16_to_nits(u16 val)
+/* Finite nonnegative binary16, rounded to whole nits (ties upward). */
+static bool displayid_binary16_to_nits(u16 val, u32 *nits)
 {
-	int exp = (val >> 10) & 0x1f;
-	u32 mant = (val & 0x3ff) | 0x400;
+	unsigned int exp = (val >> 10) & 0x1f;
+	u32 mant = val & 0x3ff;
 	int shift;
 
-	if (val & 0x8000 || exp == 0 || exp == 0x1f)
-		return 0;
+	/* The sign bit also rejects the DisplayID "do not use" sentinel. */
+	if (val & BIT(15) || exp == 0x1f)
+		return false;
 
-	shift = exp - 25;
-	if (shift >= 0)
-		return shift > 15 ? 0 : mant << shift;
+	if (!exp) {
+		*nits = 0;
+		return true;
+	}
 
-	shift = -shift;
-	if (shift > 11)
-		return 0;
+	mant |= BIT(10);
+	shift = (int)exp - 25;
+	if (shift >= 0)
+		*nits = mant << shift;
+	else if (shift < -11)
+		*nits = 0;
+	else
+		*nits = (mant + BIT(-shift - 1)) >> -shift;
 
-	return (mant + (1 << (shift - 1))) >> shift;
+	return true;
 }
 
 static void
@@ -6766,6 +6769,7 @@ drm_displayid_parse_display_params(struct drm_connector *connector,
 	const struct displayid_display_params_block *params =
 		(const struct displayid_display_params_block *)block;
 	u32 max_luminance, min_luminance;
+	u16 max, min;
 	u8 tech;
 
 	if (block->num_bytes < sizeof(*params) - sizeof(params->base)) {
@@ -6804,10 +6808,19 @@ drm_displayid_parse_display_params(struct drm_connector *connector,
 	if (info->luminance_range.max_luminance)
 		return;
 
-	max_luminance = displayid_binary16_to_nits(le16_to_cpu(params->max_luminance_full));
-	min_luminance = displayid_binary16_to_nits(le16_to_cpu(params->min_luminance));
+	/* Only known minimum-guaranteed physical limits are usable. */
+	if (block->num_bytes != sizeof(*params) - sizeof(params->base) ||
+	    (block->rev & ~BIT(7)) > 1 ||
+	    (params->features & GENMASK(4, 3)))
+		return;
+
+	max = le16_to_cpu(params->max_luminance_full);
+	min = le16_to_cpu(params->min_luminance);
 
-	if (!max_luminance || min_luminance >= max_luminance)
+	/* Nonnegative finite binary16 encodings have numerical sort order. */
+	if (!displayid_binary16_to_nits(max, &max_luminance) ||
+	    !displayid_binary16_to_nits(min, &min_luminance) ||
+	    min >= max || !max_luminance || min_luminance >= max_luminance)
 		return;
 
 	info->luminance_range.max_luminance = max_luminance;
diff --git a/drivers/gpu/drm/i915/display/intel_dp_aux_backlight.c b/drivers/gpu/drm/i915/display/intel_dp_aux_backlight.c
index c452800..cb18262 100644
--- a/drivers/gpu/drm/i915/display/intel_dp_aux_backlight.c
+++ b/drivers/gpu/drm/i915/display/intel_dp_aux_backlight.c
@@ -136,18 +136,17 @@ intel_dp_aux_supports_hdr_backlight(struct intel_connector *connector)
 		return false;
 
 	/*
-	 * Nits based control needs to know the panel's luminance range. The
-	 * DRM core fills it in from CTA HDR static metadata, or from the
-	 * DisplayID 2.0 Display Parameters block for the panels that publish
-	 * it only there. With neither there is no way to detect the range at
-	 * runtime, so do not use the Intel proprietary eDP backlight control.
+	 * A native DisplayID range also permits nits based control. Preserve
+	 * the existing Type 1 and forced paths, including their 512 nit
+	 * fallback when no range is available. Without any of these, keep
+	 * rejecting panels such as the PWM-only XMG Core 15 e21.
 	 */
 	if (display->params.enable_dpcd_backlight != INTEL_DP_AUX_BACKLIGHT_FORCE_INTEL &&
 	    !(connector->base.display_info.hdr_sink_metadata.hdmi_type1.metadata_type &
 	      BIT(HDMI_STATIC_METADATA_TYPE1)) &&
 	    !connector->base.display_info.luminance_range.max_luminance) {
 		drm_info(display->drm,
-			 "[CONNECTOR:%d:%s] Panel is missing its luminance range. Possible support for Intel HDR backlight interface is not used. If your backlight controls don't work try booting with i915.enable_dpcd_backlight=%d.\n",
+			 "[CONNECTOR:%d:%s] Panel is missing HDR static metadata and luminance range. Possible support for Intel HDR backlight interface is not used. If your backlight controls don't work try booting with i915.enable_dpcd_backlight=%d.\n",
 			 connector->base.base.id, connector->base.name,
 			 INTEL_DP_AUX_BACKLIGHT_FORCE_INTEL);
 		return false;
