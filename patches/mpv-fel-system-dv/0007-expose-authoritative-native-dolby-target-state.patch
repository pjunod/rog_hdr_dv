From 35c7040a7a16734cb5d8f60eacd3ea26d62cd2f1 Mon Sep 17 00:00:00 2001
From: ROG HDR contributors <rog-hdr@invalid>
Date: Mon, 9 Nov 2026 18:17:40 -0500
Subject: [PATCH] fix(mpv): expose authoritative native Dolby target state

---
 DOCS/man/input.rst      | 13 +++++++++++++
 player/command.c        | 24 ++++++++++++++++++++++--
 video/out/vo.h          |  7 +++++++
 video/out/vo_gpu_next.c | 16 ++++++++++++++--
 4 files changed, 56 insertions(+), 4 deletions(-)

diff --git a/DOCS/man/input.rst b/DOCS/man/input.rst
index 70c3418..20d87a4 100644
--- a/DOCS/man/input.rst
+++ b/DOCS/man/input.rst
@@ -3896,6 +3896,19 @@ Property list
     the video window is visible. If the ``--force-window`` option is used, this
     usually always returns ``yes``/true.
 
+``native-dovi-target-state``
+    Read-only native Dolby physical-target eligibility for the active
+    ``gpu-next`` output. Other outputs report this property unavailable.
+    The map contains ``active`` (boolean) and ``generation`` (integer).
+    Generation changes when physical-target eligibility or its display revision
+    changes. Notifications follow those transitions, including paused redraws.
+
+    Active eligibility alone does not prove that a picture was Dolby mapped.
+    A client reporting successful mapping must also match the generation in
+    the renderer's successful mapping record. Source changes require a fresh
+    success record. ``video-target-params`` continues to describe the encoded
+    video signal and can differ from the physical display target.
+
 ``vo-passes``
     Contains introspection about the VO's active render passes and their
     execution times. Not implemented by all VOs.
diff --git a/player/command.c b/player/command.c
index 981fe47..9c3bcab 100644
--- a/player/command.c
+++ b/player/command.c
@@ -3036,6 +3036,25 @@ static int mp_property_vo_configured(void *ctx, struct m_property *prop,
                         mpctx->video_out && mpctx->video_out->config_ok);
 }
 
+static int mp_property_native_dovi_target_state(void *ctx, struct m_property *prop,
+                                                 int action, void *arg)
+{
+    MPContext *mpctx = ctx;
+    struct voctrl_native_dovi_target_state state = {0};
+    if (!mpctx->video_out || !mpctx->video_out->config_ok ||
+        vo_control(mpctx->video_out, VOCTRL_NATIVE_DOVI_TARGET_STATE, &state) <= 0)
+        return M_PROPERTY_UNAVAILABLE;
+
+    // Eligibility is distinct from a successfully mapped Dolby picture. Clients
+    // pair this revision with the renderer's success record for the same generation.
+    struct m_sub_property props[] = {
+        {"active", SUB_PROP_BOOL(state.active)},
+        {"generation", SUB_PROP_INT64(state.generation)},
+        {0}
+    };
+    return m_property_read_sub(props, action, arg);
+}
+
 static void get_frame_perf(struct mpv_node *node, struct mp_frame_perf *perf)
 {
     for (int i = 0; i < perf->count; i++) {
@@ -4787,6 +4806,7 @@ static const struct m_property mp_properties_base[] = {
 
     // Video
     {"video-target-params", mp_property_tgt_imgparams},
+    {"native-dovi-target-state", mp_property_native_dovi_target_state},
     {"video-out-params", mp_property_vo_imgparams},
     {"video-dec-params", mp_property_dec_imgparams},
     {"video-params", mp_property_vd_imgparams},
@@ -4948,7 +4968,7 @@ static const char *const *const mp_event_property_change[] = {
       "video-format", "video-codec", "video-bitrate", "dwidth", "dheight",
       "width", "height", "container-fps", "aspect", "aspect-name", "vo-configured", "current-vo",
       "video-dec-params", "osd-dimensions", "hwdec", "hwdec-current", "hwdec-interop",
-      "window-id", "track-list", "current-tracks"),
+      "window-id", "track-list", "current-tracks", "native-dovi-target-state"),
     E(MPV_EVENT_AUDIO_RECONFIG, "audio-format", "audio-codec", "audio-bitrate",
       "samplerate", "channels", "audio", "volume", "volume-gain", "mute",
       "current-ao", "audio-codec-name", "audio-params", "track-list", "current-tracks",
@@ -4964,7 +4984,7 @@ static const char *const *const mp_event_property_change[] = {
     E(MP_EVENT_WIN_RESIZE, "current-window-scale", "osd-width", "osd-height",
       "osd-par", "osd-dimensions"),
     E(MP_EVENT_WIN_STATE, "display-names", "display-fps", "display-width",
-      "display-height"),
+      "display-height", "native-dovi-target-state"),
     E(MP_EVENT_WIN_STATE2, "display-hidpi-scale"),
     E(MP_EVENT_FOCUS, "focused"),
     E(MP_EVENT_AMBIENT_LIGHTING_CHANGED, "ambient-light"),
diff --git a/video/out/vo.h b/video/out/vo.h
index f24918d..ddfbc65 100644
--- a/video/out/vo.h
+++ b/video/out/vo.h
@@ -84,6 +84,7 @@ enum mp_voctrl {
     VOCTRL_UPDATE_PLAYBACK_STATE,       // struct voctrl_playback_state*
 
     VOCTRL_PERFORMANCE_DATA,            // struct voctrl_performance_data*
+    VOCTRL_NATIVE_DOVI_TARGET_STATE,    // struct voctrl_native_dovi_target_state*
 
     VOCTRL_SET_CURSOR_VISIBILITY,       // bool*
 
@@ -156,6 +157,12 @@ struct voctrl_playback_state {
     uint8_t position;
 };
 
+// VOCTRL_NATIVE_DOVI_TARGET_STATE
+struct voctrl_native_dovi_target_state {
+    bool active;
+    uint64_t generation;
+};
+
 // VOCTRL_PERFORMANCE_DATA
 #define VO_PERF_SAMPLE_COUNT 256
 
diff --git a/video/out/vo_gpu_next.c b/video/out/vo_gpu_next.c
index af64fb3..2ede6e4 100644
--- a/video/out/vo_gpu_next.c
+++ b/video/out/vo_gpu_next.c
@@ -1251,8 +1251,9 @@ static void update_dovi_physical_target(struct priv *p, struct vo *vo,
         p->dovi_encoding_max = raw.encoding_max;
     }
 #endif
-    if (active != p->dovi_physical_active ||
-        (active && generation != p->dovi_physical_generation)) {
+    bool changed = active != p->dovi_physical_active ||
+        (active && generation != p->dovi_physical_generation);
+    if (changed) {
         pl_renderer_flush_cache(p->rr);
         dv_provider387_reset(p->dovi_provider);
         p->dovi_render_generation++;
@@ -1260,6 +1261,8 @@ static void update_dovi_physical_target(struct priv *p, struct vo *vo,
     }
     p->dovi_physical_active = active;
     p->dovi_physical_generation = generation;
+    if (changed)
+        vo_event(vo, VO_EVENT_WIN_STATE);
 }
 
 static void dovi_reset(void *priv)
@@ -2450,6 +2453,15 @@ static int control(struct vo *vo, uint32_t request, void *data)
         p->want_seek_reset = true;
         return VO_TRUE;
 
+    case VOCTRL_NATIVE_DOVI_TARGET_STATE: {
+        struct voctrl_native_dovi_target_state *state = data;
+        *state = (struct voctrl_native_dovi_target_state) {
+            .active = p->dovi_physical_active,
+            .generation = p->dovi_render_generation,
+        };
+        return VO_TRUE;
+    }
+
     case VOCTRL_PERFORMANCE_DATA: {
         struct voctrl_performance_data *perf = data;
         copy_frame_info_to_mp(&p->perf_fresh, &perf->fresh, &p->hwdec.perf, &p->sw_upload_perf);
-- 
