From 8266518f963a47daf14ceb43bf365e0a279cd6bf Mon Sep 17 00:00:00 2001
From: ROG HDR contributors <rog-hdr@invalid>
Date: Wed, 11 Nov 2026 19:48:46 -0500
Subject: [PATCH] fix(mpv): describe an idle window's colour once colour hints
 are enabled

With --target-colorspace-hint and a window shown before any video
(--idle --force-window, then loadfile), no hint was set, so the Vulkan
swapchain stayed sRGB while the idle window presented. The NVIDIA
Vulkan WSI then created its own wp_color_management_surface_v1 for the
wl_surface. The first video frame's wp_color_manager_v1.get_surface
failed with "surface already requested", and the compositor closed the
connection before any picture was shown.

Describe the idle window as sRGB through mpv's own colour surface, so
the swapchain is pass-through from its first presented frame and the
driver never takes the surface's colour management.
---
 video/out/vo_gpu_next.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/video/out/vo_gpu_next.c b/video/out/vo_gpu_next.c
index 2ede6e4a3..afda871ad 100644
--- a/video/out/vo_gpu_next.c
+++ b/video/out/vo_gpu_next.c
@@ -1780,6 +1780,14 @@ static bool draw_frame(struct vo *vo, struct vo_frame *frame)
         if (!hint.hdr.min_luma)
             hint.hdr.min_luma = target_csp.hdr.min_luma;
         external_params = set_colorspace_hint(p, NULL);
+    } else if (!frame->current) {
+        // No video yet (an idle --force-window). Describe the window as sRGB
+        // ourselves, so the swapchain is pass-through from its first frame.
+        // A driver WSI that tags its own sRGB swapchain would otherwise own
+        // the surface's color management object, and the first video frame's
+        // get_surface would fail with a protocol error.
+        hint = pl_color_space_srgb;
+        external_params = set_colorspace_hint(p, &hint);
     }
 
     struct pl_swapchain_frame swframe;
