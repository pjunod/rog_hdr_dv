diff --git a/src/tests/native-hdr-tests.c b/src/tests/native-hdr-tests.c
new file mode 100644
index 0000000..5e9c5af
--- /dev/null
+++ b/src/tests/native-hdr-tests.c
@@ -0,0 +1,496 @@
+/* Synthetic EDIDs constructed from scratch, without hardware source data.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "config.h"
+
+#include <string.h>
+#include <glib.h>
+
+#include "backends/meta-output.h"
+#include "backends/native/meta-output-kms.h"
+
+static const uint8_t native[] = {
+  0x26, 0, 9, 4, 0, 0, 0, 0, 0, 0x40, 0, 0
+};
+
+static void
+checksum (uint8_t *data,
+          size_t   size)
+{
+  unsigned int sum = 0;
+  size_t i;
+
+  data[size - 1] = 0;
+  for (i = 0; i < size - 1; i++)
+    sum += data[i];
+  data[size - 1] = (uint8_t) -sum;
+}
+
+static void
+extension (uint8_t       *data,
+           const uint8_t *blocks,
+           size_t         size,
+           gboolean       cta)
+{
+  g_assert_cmpuint (size, <=, 121);
+  if (cta)
+    {
+      data[0] = 2;
+      data[1] = 3;
+      data[2] = 4 + size;
+      memcpy (data + 4, blocks, size);
+    }
+  else
+    {
+      data[0] = 0x70;
+      data[1] = 0x20;
+      data[2] = size;
+      data[3] = 2;
+      memcpy (data + 5, blocks, size);
+      checksum (data + 1, size + 5);
+    }
+  checksum (data, 128);
+}
+
+static size_t
+make_edid (uint8_t       *edid,
+           const uint8_t *first,
+           size_t         first_size,
+           const uint8_t *second,
+           size_t         second_size,
+           gboolean       first_cta,
+           gboolean       second_cta)
+{
+  const uint8_t header[] = { 0, 255, 255, 255, 255, 255, 255, 0 };
+  const uint8_t version[] = { 1, 36, 1, 4, 0xa5, 0, 0, 120, 2 };
+  unsigned int i;
+
+  memcpy (edid, header, sizeof (header));
+  edid[8] = 0x52;
+  edid[9] = 0x74;
+  edid[10] = 1;
+  memcpy (edid + 16, version, sizeof (version));
+  memset (edid + 38, 1, 16);
+  for (i = 0; i < 4; i++)
+    edid[54 + 18 * i + 3] = 0x10;
+  edid[126] = second ? 2 : 1;
+  checksum (edid, 128);
+  extension (edid + 128, first, first_size, first_cta);
+  if (second)
+    extension (edid + 256, second, second_size, second_cta);
+  return second ? 384 : 256;
+}
+
+static MetaOutputInfo *
+parse_bytes (const uint8_t *edid,
+             size_t         size)
+{
+  g_autoptr (GBytes) bytes = g_bytes_new (edid, size);
+  MetaOutputInfo *info = meta_output_info_new ();
+
+  meta_output_info_parse_edid (info, bytes);
+  g_assert_nonnull (info->edid_info);
+  return info;
+}
+
+static MetaOutputInfo *
+parse_extensions (const uint8_t *first,
+                  size_t         first_size,
+                  const uint8_t *second,
+                  size_t         second_size,
+                  gboolean       first_cta,
+                  gboolean       second_cta)
+{
+  uint8_t edid[384] = { 0 };
+  size_t size;
+
+  size = make_edid (edid, first, first_size, second, second_size,
+                    first_cta, second_cta);
+  return parse_bytes (edid, size);
+}
+
+static MetaOutputInfo *
+parse (const uint8_t *first,
+       size_t         first_size,
+       const uint8_t *second,
+       size_t         second_size,
+       gboolean       second_cta)
+{
+  return parse_extensions (first, first_size, second, second_size,
+                           FALSE, second_cta);
+}
+
+static void
+check_kms (MetaOutputInfo *info,
+           gboolean        native_pq,
+           gboolean        cta_pq,
+           gboolean        cta_bt2020)
+{
+  unsigned int connector, device, hdr, color;
+  const MetaConnectorType connectors[] = {
+    META_CONNECTOR_TYPE_eDP, META_CONNECTOR_TYPE_HDMIA,
+    META_CONNECTOR_TYPE_DisplayPort
+  };
+
+  for (connector = 0; connector < G_N_ELEMENTS (connectors); connector++)
+    for (device = 0; device < 2; device++)
+      for (hdr = 0; hdr < 2; hdr++)
+        for (color = 0; color < 2; color++)
+          {
+            gboolean eligible = native_pq && !connector && device && hdr && color;
+
+            info->connector_type = connectors[connector];
+            info->supported_color_spaces = 0;
+            info->supported_hdr_eotfs = 0;
+            meta_output_kms_update_color_capabilities (
+              info, device ? META_KMS_DEVICE_FLAG_SUPPORTS_COLOR_MODES : 0,
+              hdr, color ? (1 << META_OUTPUT_COLORSPACE_BT2020) : 0);
+            g_assert_cmpuint (info->supported_hdr_eotfs, ==,
+                              (eligible ? (1 << META_OUTPUT_HDR_METADATA_EOTF_PQ) : 0) |
+                              ((cta_pq && device && hdr) ?
+                               ((1 << META_OUTPUT_HDR_METADATA_EOTF_PQ) |
+                                (1 << META_OUTPUT_HDR_METADATA_EOTF_TRADITIONAL_GAMMA_SDR)) : 0));
+            g_assert_cmpuint (info->supported_color_spaces, ==,
+                              (eligible || (cta_bt2020 && device && color)) ?
+                              (1 << META_OUTPUT_COLORSPACE_BT2020) : 0);
+          }
+}
+
+static void
+check_native (const uint8_t *blocks,
+              size_t         size,
+              gboolean       expected)
+{
+  g_autoptr (MetaOutputInfo) info = parse (blocks, size, NULL, 0, FALSE);
+  g_assert_cmpint (info->edid_info->native_rgb_bt2020_pq, ==, expected);
+  g_assert_false (info->edid_info->hdr_static_metadata.type1);
+  g_assert_false (info->edid_info->hdr_static_metadata.pq);
+  g_assert_false (info->edid_info->colorimetry.bt2020_rgb);
+  g_assert_cmpfloat (info->edid_info->hdr_static_metadata.desired_content_max_luminance,
+                     ==, 0);
+
+  g_assert_cmpfloat (
+    info->edid_info->hdr_static_metadata.desired_content_max_frame_avg_luminance,
+    ==, 0);
+  g_assert_cmpfloat (info->edid_info->hdr_static_metadata.desired_content_min_luminance,
+                     ==, 0);
+  check_kms (info, expected, FALSE, FALSE);
+}
+
+static void
+test_native (void)
+{
+  uint8_t blocks[64] = { 0 }, additional[19] = { 0x26, 0, 16, 4 };
+  unsigned int i;
+
+  check_native (native, sizeof (native), TRUE);
+  memcpy (blocks, native, sizeof (native));
+  blocks[9] = 0;
+  check_native (blocks, sizeof (native), FALSE);
+  blocks[3] = 0;
+  blocks[9] = 0x40;
+  check_native (blocks, sizeof (native), FALSE);
+  /* A complete additional tuple, including the seventh slot, is sufficient. */
+  for (i = 0; i < 7; i++)
+    {
+      memset (additional + 12, 0, 7);
+      additional[11] = 7;
+      additional[12 + i] = 0x68;
+      check_native (additional, sizeof (additional), TRUE);
+    }
+  memset (additional + 12, 0, 7);
+  additional[12] = 0x67; /* BT.2020 with the wrong EOTF. */
+  check_native (additional, sizeof (additional), FALSE);
+  additional[12] = 0x58; /* ST 2084 with the wrong gamut. */
+  check_native (additional, sizeof (additional), FALSE);
+  additional[12] = 0x60;
+  additional[13] = 0x08; /* Separate gamut/EOTF entries cannot form a tuple. */
+  check_native (additional, sizeof (additional), FALSE);
+  /* RGB and the gamut/EOTF tuple may not be assembled across blocks. */
+  memcpy (blocks, native, sizeof (native));
+  blocks[9] = 0;
+  memcpy (blocks + sizeof (native), native, sizeof (native));
+  blocks[sizeof (native) + 3] = 0;
+  check_native (blocks, 2 * sizeof (native), FALSE);
+}
+
+static void
+test_cta_authority (void)
+{
+  const uint8_t children[][8] = {
+    { 0xe3, 6, 0, 0 },             /* Explicit negative HDR metadata. */
+    { 0xe3, 5, 0, 0 },             /* Explicit negative colorimetry. */
+    { 0xe3, 6, 5, 1 },             /* Positive SDR/PQ and Type 1. */
+    { 0xe3, 5, 0x80, 0 },          /* Positive BT.2020 RGB only. */
+    { 0xe6, 6, 5, 1, 100, 80, 2 }, /* Positive luminance remains CTA data. */
+    { 0xe3, 6, 5, 1, 0xe3, 5, 0x80, 0 } /* Complete CTA HDR/colorimetry. */
+  };
+  unsigned int i, separate, reverse, ordinary;
+
+  for (i = 0; i < G_N_ELEMENTS (children); i++)
+    for (separate = 0; separate < 2; separate++)
+      for (reverse = 0; reverse < 2; reverse++)
+        for (ordinary = 0; ordinary < 2; ordinary++)
+          {
+            uint8_t nested[11] = { 0x81, 0, 0 }, blocks[64] = { 0 };
+            size_t size = i == 4 ? 7 : i == 5 ? 8 : 4;
+            g_autoptr (MetaOutputInfo) info = NULL;
+
+            if (ordinary && !separate)
+              continue; /* Ordinary CTA requires a separate extension. */
+            nested[2] = size;
+            memcpy (nested + 3, children[i], size);
+            if (ordinary)
+              info = reverse ?
+                     parse_extensions (children[i], size, native, sizeof (native),
+                                       TRUE, FALSE) :
+                     parse (native, sizeof (native), children[i], size, TRUE);
+            else if (separate)
+              info = reverse ? parse (nested, size + 3, native, sizeof (native), FALSE) :
+                     parse (native, sizeof (native), nested, size + 3, FALSE);
+            else
+              {
+                memcpy (blocks + (reverse ? size + 3 : 0), native, sizeof (native));
+                memcpy (blocks + (reverse ? 0 : sizeof (native)), nested, size + 3);
+                info = parse (blocks, sizeof (native) + size + 3, NULL, 0, FALSE);
+              }
+            g_assert_false (info->edid_info->native_rgb_bt2020_pq);
+            g_assert_cmpint (info->edid_info->hdr_static_metadata.type1, ==,
+                             i == 2 || i == 4 || i == 5);
+            check_kms (info, FALSE, i == 2 || i == 4 || i == 5,
+                       i == 3 || i == 5);
+            if (i == 4)
+              g_assert_cmpfloat (
+                info->edid_info->hdr_static_metadata.desired_content_max_luminance,
+                >, 0);
+          }
+}
+
+static void
+test_diagnostics (void)
+{
+  const uint8_t empty[] = { 0x81, 0, 0 };
+  const uint8_t audio[] = { 0x81, 0, 4, 0x23, 9, 7, 7 };
+  const uint8_t tail[] = { 0x81, 0, 2, 0x43, 16 };
+  unsigned int separate, reverse, kind, invalid;
+
+  for (separate = 0; separate < 2; separate++)
+    for (reverse = 0; reverse < 2; reverse++)
+      for (kind = 0; kind < 5; kind++)
+        for (invalid = 0; invalid < 3; invalid++)
+          {
+            uint8_t other[7] = { 0x81, 0 }, blocks[64] = { 0 };
+            size_t size = kind == 0 ? sizeof (empty) : kind == 1 ? sizeof (audio) :
+                          kind == 2 ? sizeof (tail) : kind == 3 ? 1 : 2;
+            gboolean expected = kind < 2 && invalid == 0;
+            g_autoptr (MetaOutputInfo) info = NULL;
+
+            if (kind < 3)
+              memcpy (other, kind == 0 ? empty : kind == 1 ? audio : tail, size);
+            other[1] = invalid == 1 ? 1 : invalid == 2 ? 8 : 0;
+            if (separate)
+              info = reverse ? parse (other, size, native, sizeof (native), FALSE) :
+                     parse (native, sizeof (native), other, size, FALSE);
+            else
+              {
+                memcpy (blocks + (reverse ? size : 0), native, sizeof (native));
+                memcpy (blocks + (reverse ? 0 : sizeof (native)), other, size);
+                info = parse (blocks, sizeof (native) + size, NULL, 0, FALSE);
+              }
+            g_assert_cmpint (info->edid_info->native_rgb_bt2020_pq, ==, expected);
+            check_kms (info, expected, FALSE, FALSE);
+          }
+}
+
+static void
+test_extension_failures (void)
+{
+  const uint8_t empty[] = { 0x81, 0, 0 };
+  unsigned int reverse, failure;
+
+  for (reverse = 0; reverse < 2; reverse++)
+    for (failure = 0; failure < 15; failure++)
+      {
+        uint8_t edid[257 * 128 + 1] = { 0 };
+        uint8_t *other = edid + (reverse ? 128 : 256);
+        size_t size = make_edid (edid, reverse ? empty : native,
+                                 reverse ? sizeof (empty) : sizeof (native),
+                                 reverse ? native : empty,
+                                 reverse ? sizeof (native) : sizeof (empty),
+                                 FALSE, FALSE);
+        g_autoptr (MetaOutputInfo) info = NULL;
+
+        switch (failure)
+          {
+          case 0: /* Unrelated base range diagnostics remain visible and safe. */
+            memset (edid + 54, 0, 18);
+            edid[57] = 0xfd;
+            edid[59] = 40;
+            edid[60] = 60;
+            edid[61] = 30;
+            edid[62] = 90;
+            edid[63] = 100;
+            checksum (edid, 128);
+            break;
+          case 1: /* Unsupported DisplayID major, silently dropped previously. */
+            other[1] = 0x30;
+            checksum (other + 1, other[2] + 5);
+            checksum (other, 128);
+            break;
+          case 2: /* Unsupported ordinary CTA envelope, dropped without text. */
+            other[0] = 2;
+            other[1] = 3;
+            other[2] = 2;
+            checksum (other, 128);
+            break;
+          case 3:
+            other[0] = 0xee;
+            checksum (other, 128);
+            break;
+          case 4:
+            other[127] ^= 1;
+            break;
+          case 5:
+            size--;
+            break;
+          case 6:
+            size++;
+            break;
+          case 7:
+            edid[126] = 1;
+            checksum (edid, 128);
+            break;
+          case 8:
+            edid[126] = 3;
+            checksum (edid, 128);
+            break;
+          case 9:
+            {
+              unsigned int i;
+
+              edid[126] = 255;
+              checksum (edid, 128);
+              for (i = 3; i < 257; i++)
+                {
+                  edid[128 * i] = 0xf0;
+                  checksum (edid + 128 * i, 128);
+                }
+              size = 257 * 128;
+            }
+            break;
+          case 10:
+            memset (other, 0, 128);
+            other[0] = 2;
+            other[1] = 3;
+            other[2] = 6;
+            other[4] = 0xe2;
+            other[5] = 6;
+            checksum (other, 128);
+            break;
+          case 11:
+            other[3] = 0xff;
+            checksum (other + 1, other[2] + 5);
+            checksum (other, 128);
+            break;
+          case 12:
+            other[5] = 0x99;
+            checksum (other + 1, other[2] + 5);
+            checksum (other, 128);
+            break;
+          case 13:
+            other[other[2] + 5] ^= 1;
+            checksum (other, 128);
+            break;
+          case 14: /* An opaque known non-CTA extension keeps prior behavior. */
+            memset (other, 0, 128);
+            other[0] = 0xf0;
+            checksum (other, 128);
+            break;
+          }
+        info = parse_bytes (edid, size);
+        g_assert_cmpint (info->edid_info->native_rgb_bt2020_pq, ==, failure == 0 || failure == 14);
+        check_kms (info, failure == 0 || failure == 14, FALSE, FALSE);
+      }
+}
+
+static void
+test_cta_with_extension_failure (void)
+{
+  const uint8_t children[] = { 0xe6, 6, 5, 1, 100, 80, 2, 0xe3, 5, 0x80, 0 };
+  const uint8_t unsupported[] = { 0x81, 1, 0 };
+  uint8_t nested[sizeof (children) + 3] = { 0x81, 0, sizeof (children) };
+  unsigned int ordinary, reverse, dropped;
+
+  memcpy (nested + 3, children, sizeof (children));
+  for (ordinary = 0; ordinary < 2; ordinary++)
+    for (reverse = 0; reverse < 2; reverse++)
+      for (dropped = 0; dropped < 2; dropped++)
+        {
+          uint8_t edid[512] = { 0 };
+          const uint8_t *cta = ordinary ? children : nested;
+          size_t cta_size = ordinary ? sizeof (children) : sizeof (nested);
+          g_autoptr (MetaOutputInfo) info = NULL;
+
+          make_edid (edid, reverse ? cta : native,
+                     reverse ? cta_size : sizeof (native),
+                     reverse ? native : cta,
+                     reverse ? sizeof (native) : cta_size,
+                     ordinary && reverse, ordinary && !reverse);
+          extension (edid + 384, unsupported, sizeof (unsupported), FALSE);
+          if (dropped)
+            {
+              edid[385] = 0x30;
+              checksum (edid + 385, edid[386] + 5);
+              checksum (edid + 384, 128);
+            }
+          edid[126] = 3;
+          checksum (edid, 128);
+          info = parse_bytes (edid, sizeof (edid));
+          g_assert_false (info->edid_info->native_rgb_bt2020_pq);
+          g_assert_true (info->edid_info->hdr_static_metadata.type1);
+          g_assert_true (info->edid_info->hdr_static_metadata.pq);
+          g_assert_true (info->edid_info->colorimetry.bt2020_rgb);
+          g_assert_cmpfloat (
+            info->edid_info->hdr_static_metadata.desired_content_max_luminance,
+            >, 0);
+          check_kms (info, FALSE, TRUE, TRUE);
+        }
+}
+
+static void
+test_fatal_base (void)
+{
+  unsigned int failure;
+
+  for (failure = 0; failure < 3; failure++)
+    {
+      uint8_t edid[256] = { 0 };
+      size_t size = make_edid (edid, native, sizeof (native), NULL, 0,
+                               FALSE, FALSE);
+      g_autoptr (GBytes) bytes = NULL;
+      g_autoptr (MetaOutputInfo) info = meta_output_info_new ();
+
+      edid[failure == 0 ? 0 : failure == 1 ? 18 : 127] ^= 1;
+      if (failure != 2)
+        checksum (edid, 128);
+      bytes = g_bytes_new (edid, size);
+      meta_output_info_parse_edid (info, bytes);
+      g_assert_null (info->edid_info);
+      check_kms (info, FALSE, FALSE, FALSE);
+    }
+}
+
+int
+main (int    argc,
+      char **argv)
+{
+  g_test_init (&argc, &argv, NULL);
+  g_test_add_func ("/native-hdr/complete-tuple-and-kms-gates", test_native);
+  g_test_add_func ("/native-hdr/cta-authority", test_cta_authority);
+  g_test_add_func ("/native-hdr/diagnostics", test_diagnostics);
+  g_test_add_func ("/native-hdr/scoped-extension-failures", test_extension_failures);
+  g_test_add_func ("/native-hdr/fatal-base", test_fatal_base);
+  g_test_add_func ("/native-hdr/cta-preserved-with-extension-failure",
+                   test_cta_with_extension_failure);
+  return g_test_run ();
+}
