From ab7633fd411d159ca588ba52f01e07ecd940d390 Mon Sep 17 00:00:00 2001
From: Paul Junod <donujp@gmail.com>
Date: Thu, 8 Oct 2026 02:08:53 -0400
Subject: [PATCH] backends/native: support native DisplayID RGB BT.2020 PQ on
 eDP

DisplayID interface features can advertise a complete RGB BT.2020/ST 2084
tuple without CTA static metadata Type 1. Record that capability separately
from the legacy HDR and colorimetry fields. Require RGB and the gamut/EOTF
combination in one block, and keep ordinary or nested CTA declarations
explicitly authoritative, including negative or partial declarations.

Reject known extension parsing/framing failures through the structured
libdisplay-info query. Unrelated base descriptive warnings remain visible
without hiding valid native capability. Require all parsed APIs with an
actual configure compile/link probe.

Map native PQ only for eDP with device color-mode support, an HDR property
and BT.2020 connector support. Preserve the Type 1 path for external outputs
and CTA panels. Do not fabricate static metadata or luminance. Extract the
constructor's existing mapping into a helper shared by production and tests.

Synthetic production-path regressions cover complete/additional tuples,
split and wrong-pair negatives, CTA authority in both orders, diagnostics,
dropped extensions, framing, fatal base checks and every KMS eligibility
gate. Positive CTA metadata/luminance remains intact beside extension errors.

Validation on the Ubuntu 51.0 source adaptation: a normal warnings-as-errors
build and six focused EDID/KMS/monitor/color tests pass. The upstream source
passes the project style checker. A private real-panel
probe produces native PQ/BT.2020 on eligible eDP, clears both when PQ is
removed, and preserves external-output behavior and unknown static metadata.
---
 meson.build                           |  26 ++
 src/backends/edid-parse.c             |  81 ++++-
 src/backends/edid.h                   |   3 +
 src/backends/native/meta-output-kms.c | 110 +++---
 src/backends/native/meta-output-kms.h |   6 +
 src/tests/meson.build                 |   5 +
 src/tests/native-hdr-tests.c          | 496 ++++++++++++++++++++++++++
 7 files changed, 682 insertions(+), 45 deletions(-)
 create mode 100644 src/tests/native-hdr-tests.c

diff --git a/meson.build b/meson.build
index cdd13b6..80e42a8 100644
--- a/meson.build
+++ b/meson.build
@@ -137,6 +137,32 @@ libeis_dep = dependency('libeis-1.0', version: libei_req)
 libei_dep = dependency('libei-1.0', version: libei_req)
 gvdb_dep = dependency('gvdb')
 libdisplay_info_dep = dependency('libdisplay-info', version: libdisplay_info_req)
+if not cc.links('''
+  #include <libdisplay-info/edid.h>
+  #include <libdisplay-info/displayid2.h>
+  int main (void)
+  {
+    const struct di_displayid2 *displayid = di_edid_ext_get_displayid2 (0);
+    const struct di_displayid2_data_block *const *blocks =
+      di_displayid2_get_data_blocks (displayid);
+    const struct di_displayid2_interface_features *features =
+      di_displayid2_data_block_get_interface_features (*blocks);
+    const struct di_cta_data_block *const *children =
+      di_displayid2_data_block_get_cta_data_blocks (*blocks);
+    return di_edid_has_extension_failures (0) +
+      di_displayid2_data_block_get_tag (*blocks) +
+      features->rgb_bit_depths + features->standard_combinations +
+      features->additional_combinations_len +
+      features->additional_combinations[0].color_space +
+      features->additional_combinations[0].eotf + (children != 0) +
+      DI_DISPLAYID2_COMBINATION_BT2020_ST2084 +
+      DI_DISPLAYID2_COLOR_SPACE_BT2020 + DI_DISPLAYID2_EOTF_ST2084;
+  }
+''', dependencies: libdisplay_info_dep,
+  name: 'parsed DisplayID v2 interface and nested CTA API')
+  error('libdisplay-info needs the parsed DisplayID v2 interface and nested CTA API; install matching development and runtime packages')
+endif
+
 libdrm_dep = dependency('libdrm', version: libdrm_req)
 
 have_xwayland = get_option('xwayland')
diff --git a/src/backends/edid-parse.c b/src/backends/edid-parse.c
index 121bba7..6780412 100644
--- a/src/backends/edid-parse.c
+++ b/src/backends/edid-parse.c
@@ -31,10 +31,87 @@
 
 #include <libdisplay-info/cta.h>
 #include <libdisplay-info/edid.h>
+#include <libdisplay-info/displayid2.h>
 #include <libdisplay-info/info.h>
 
 #include "backends/edid.h"
 
+static gboolean
+has_cta_color_metadata (const struct di_cta_data_block *const *blocks)
+{
+  if (!blocks)
+    return FALSE;
+
+  for (; *blocks; blocks++)
+    {
+      enum di_cta_data_block_tag tag = di_cta_data_block_get_tag (*blocks);
+
+      if (tag == DI_CTA_DATA_BLOCK_HDR_STATIC_METADATA ||
+          tag == DI_CTA_DATA_BLOCK_COLORIMETRY)
+        return TRUE;
+    }
+
+  return FALSE;
+}
+
+static gboolean
+has_native_rgb_bt2020_pq (const struct di_info *info)
+{
+  const struct di_edid_ext *const *extensions;
+  gboolean supported = FALSE;
+
+  /* Failed extension parsing may hide authoritative CTA metadata. */
+  if (di_edid_has_extension_failures (di_info_get_edid (info)))
+    return FALSE;
+
+  extensions = di_edid_get_extensions (di_info_get_edid (info));
+  for (; *extensions; extensions++)
+    {
+      const struct di_edid_cta *cta = di_edid_ext_get_cta (*extensions);
+      const struct di_displayid2 *displayid;
+      const struct di_displayid2_data_block *const *blocks;
+
+      if (cta && has_cta_color_metadata (di_edid_cta_get_data_blocks (cta)))
+        return FALSE;
+
+      displayid = di_edid_ext_get_displayid2 (*extensions);
+      if (!displayid)
+        continue;
+
+      blocks = di_displayid2_get_data_blocks (displayid);
+      for (; *blocks; blocks++)
+        {
+          const struct di_displayid2_interface_features *features;
+          const struct di_cta_data_block *const *children;
+          unsigned int i;
+
+          children = di_displayid2_data_block_get_cta_data_blocks (*blocks);
+          if (has_cta_color_metadata (children))
+            return FALSE;
+
+          features = di_displayid2_data_block_get_interface_features (*blocks);
+          if (!features || !features->rgb_bit_depths)
+            continue;
+
+          if (features->standard_combinations &
+              DI_DISPLAYID2_COMBINATION_BT2020_ST2084)
+            supported = TRUE;
+
+          for (i = 0; i < features->additional_combinations_len; i++)
+            {
+              const struct di_displayid2_color_eotf *combination =
+                &features->additional_combinations[i];
+
+              if (combination->color_space == DI_DISPLAYID2_COLOR_SPACE_BT2020 &&
+                  combination->eotf == DI_DISPLAYID2_EOTF_ST2084)
+                supported = TRUE;
+            }
+        }
+    }
+
+  return supported;
+}
+
 MetaEdidInfo *
 meta_edid_info_new_parse (const uint8_t *edid,
                           size_t         size)
@@ -91,7 +168,7 @@ meta_edid_info_new_parse (const uint8_t *edid,
           info->min_vert_rate_hz = range_limits->min_vert_rate_hz;
           break;
         default:
-            break;
+          break;
         }
     }
 
@@ -116,6 +193,8 @@ meta_edid_info_new_parse (const uint8_t *edid,
           hdr_static_metadata,
           sizeof (*hdr_static_metadata));
 
+  info->native_rgb_bt2020_pq = has_native_rgb_bt2020_pq (di_info);
+
   di_info_destroy (di_info);
   return g_steal_pointer (&info);
 }
