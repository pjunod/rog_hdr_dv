   g_signal_emit_by_name (monitor_manager, "monitors-changing");
 }
 
+static void
+sdr_native_unusable_edid_primaries (void)
+{
+  MetaBackend *backend = meta_context_get_backend (test_context);
+  MetaColorManager *manager = meta_backend_get_color_manager (backend);
+  MetaOutput *output = meta_virtual_monitor_get_output (virtual_monitor);
+  MetaOutputInfo *info = (MetaOutputInfo *) meta_output_get_info (output);
+  MetaColorDevice *device =
+    meta_color_manager_get_color_device (manager, meta_output_get_monitor (output));
+  MetaEdidInfo *fixture_edid_info = info->edid_info;
+  ClutterColorState *color_state;
+  const ClutterColorimetry *colorimetry;
+  const ClutterEOTF *eotf;
+
+  /* Collinear default primaries: the native SDR mode has no usable gamut. */
+  info->edid_info = g_new0 (MetaEdidInfo, 1);
+  info->edid_info->default_gamma = 2.2;
+  info->edid_info->default_color_primaries = (struct di_color_primaries) {
+    .has_primaries = TRUE,
+    .has_default_white_point = TRUE,
+    .primary = { { 0.6f, 0.6f }, { 0.3f, 0.3f }, { 0.1f, 0.1f } },
+    .default_white = { 0.3127f, 0.3290f },
+  };
+  set_test_color_mode (output, META_COLOR_MODE_SDR_NATIVE);
+
+  g_test_expect_message ("libmutter", G_LOG_LEVEL_WARNING,
+                         "Ignoring unusable EDID color primaries of *");
+  meta_color_device_update (device);
+  g_test_assert_expected_messages ();
+
+  /* The colorimetry of the default mode is used instead; the EOTF still
+   * follows the EDID. */
+  color_state = meta_color_device_get_color_state (device);
+  g_assert_true (CLUTTER_IS_COLOR_STATE_PARAMS (color_state));
+  colorimetry =
+    clutter_color_state_params_get_colorimetry (CLUTTER_COLOR_STATE_PARAMS (color_state));
+  g_assert_cmpuint (colorimetry->type, ==, CLUTTER_COLORIMETRY_TYPE_COLORSPACE);
+  g_assert_cmpuint (colorimetry->colorspace, ==, CLUTTER_COLORSPACE_SRGB);
+  eotf = clutter_color_state_params_get_eotf (CLUTTER_COLOR_STATE_PARAMS (color_state));
+  g_assert_cmpuint (eotf->type, ==, CLUTTER_EOTF_TYPE_NAMED);
+  g_assert_cmpuint (eotf->tf_name, ==, CLUTTER_TRANSFER_FUNCTION_GAMMA22);
+
+  /* Logged once per device: a further update is silent. */
+  meta_color_device_update (device);
+
+  set_test_color_mode (output, META_COLOR_MODE_DEFAULT);
+  g_clear_pointer (&info->edid_info, meta_edid_info_free);
+  info->edid_info = fixture_edid_info;
+  meta_color_device_update (device);
+}
+
 static void
 on_before_tests (void)
 {
@@ -516,6 +567,8 @@ init_tests (void)
   g_test_add_data_func ("/wayland/target-luminance/v2", GINT_TO_POINTER (2), target_luminance);
   g_test_add_data_func ("/wayland/target-primaries/v1", GINT_TO_POINTER (1), target_primaries);
   g_test_add_data_func ("/wayland/target-primaries/v2", GINT_TO_POINTER (2), target_primaries);
+  g_test_add_func ("/wayland/sdr-native/unusable-edid-primaries",
+                   sdr_native_unusable_edid_primaries);
 }
 
 int
