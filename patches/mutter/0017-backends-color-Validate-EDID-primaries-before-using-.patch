diff --git a/src/tests/native-hdr-tests.c b/src/tests/native-hdr-tests.c
index 29e5a63..f5b6cf1 100644
--- a/src/tests/native-hdr-tests.c
+++ b/src/tests/native-hdr-tests.c
@@ -917,6 +917,85 @@ test_chromaticity_fixed_point (void)
     g_assert_cmpint (fallback.coordinates[j], ==, coordinates[j]);
 }
 
+static void
+test_sdr_native_edid_primaries (void)
+{
+  const struct di_color_primaries srgb_like = {
+    .has_primaries = TRUE,
+    .has_default_white_point = TRUE,
+    .primary = { { 0.640f, 0.330f }, { 0.300f, 0.600f }, { 0.150f, 0.060f } },
+    .default_white = { 0.3127f, 0.3290f },
+  };
+  MetaEdidInfo edid = { .default_color_primaries = srgb_like };
+  ClutterColorimetry untouched = {
+    .type = CLUTTER_COLORIMETRY_TYPE_COLORSPACE,
+    .colorspace = CLUTTER_COLORSPACE_P3,
+  };
+  ClutterColorimetry colorimetry;
+  g_autoptr (GError) error = NULL;
+
+  /* Usable primaries are taken as they are. */
+  colorimetry = untouched;
+  g_assert_true (meta_color_colorimetry_from_edid_primaries (&edid,
+                                                             &colorimetry,
+                                                             &error));
+  g_assert_no_error (error);
+  g_assert_cmpint (colorimetry.type, ==, CLUTTER_COLORIMETRY_TYPE_PRIMARIES);
+  g_assert_cmpfloat (colorimetry.primaries->g_y, ==, 0.600f);
+  g_assert_cmpfloat (colorimetry.primaries->w_x, ==, 0.3127f);
+  clutter_colorimetry_clear (&colorimetry);
+
+  /* Collinear primaries: there is no RGB to XYZ matrix. */
+  edid.default_color_primaries.primary[0] = (struct di_chromaticity_cie1931) { 0.6f, 0.6f };
+  edid.default_color_primaries.primary[1] = (struct di_chromaticity_cie1931) { 0.3f, 0.3f };
+  edid.default_color_primaries.primary[2] = (struct di_chromaticity_cie1931) { 0.1f, 0.1f };
+  colorimetry = untouched;
+  g_assert_false (meta_color_colorimetry_from_edid_primaries (&edid,
+                                                              &colorimetry,
+                                                              &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA);
+  g_assert_cmpint (colorimetry.type, ==, untouched.type);
+  g_assert_cmpint (colorimetry.colorspace, ==, untouched.colorspace);
+  g_clear_error (&error);
+
+  /* A white point with y = 0 has no XYZ. */
+  edid.default_color_primaries = srgb_like;
+  edid.default_color_primaries.default_white.y = 0.0f;
+  colorimetry = untouched;
+  g_assert_false (meta_color_colorimetry_from_edid_primaries (&edid,
+                                                              &colorimetry,
+                                                              &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA);
+  g_assert_cmpint (colorimetry.type, ==, untouched.type);
+  g_clear_error (&error);
+
+  /* A white point outside the primaries' triangle is not physical. */
+  edid.default_color_primaries = srgb_like;
+  edid.default_color_primaries.default_white =
+    (struct di_chromaticity_cie1931) { 0.7f, 0.25f };
+  colorimetry = untouched;
+  g_assert_false (meta_color_colorimetry_from_edid_primaries (&edid,
+                                                              &colorimetry,
+                                                              &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA);
+  g_assert_cmpint (colorimetry.type, ==, untouched.type);
+  g_clear_error (&error);
+
+  /* Undeclared primaries and a missing EDID are not usable either. */
+  edid.default_color_primaries = srgb_like;
+  edid.default_color_primaries.has_primaries = FALSE;
+  g_assert_false (meta_color_colorimetry_from_edid_primaries (&edid,
+                                                              &colorimetry,
+                                                              &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_NOT_FOUND);
+  g_clear_error (&error);
+  g_assert_false (meta_color_colorimetry_from_edid_primaries (NULL,
+                                                              &colorimetry,
+                                                              &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_NOT_FOUND);
+  g_assert_cmpint (colorimetry.type, ==, untouched.type);
+}
+
 int
 main (int    argc,
       char **argv)
@@ -934,5 +1013,6 @@ main (int    argc,
   g_test_add_func ("/native-hdr/physical-chromaticities", test_physical_chromaticities);
   g_test_add_func ("/native-hdr/target-primaries-policy", test_target_primaries_policy);
   g_test_add_func ("/native-hdr/chromaticity-fixed-point", test_chromaticity_fixed_point);
+  g_test_add_func ("/native-hdr/sdr-native-edid-primaries", test_sdr_native_edid_primaries);
   return g_test_run ();
 }
