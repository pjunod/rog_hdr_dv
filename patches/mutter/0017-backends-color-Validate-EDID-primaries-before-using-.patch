+/*
+ * The EDID's default color primaries describe the display's native SDR
+ * gamut, but nothing guarantees they form a usable color space. They are
+ * accepted only if they can be published exactly and the renderer can build
+ * both directions of its color transform from them, using the same function
+ * that the transform uses.
+ */
+gboolean
+meta_color_colorimetry_from_edid_primaries (const MetaEdidInfo  *edid_info,
+                                            ClutterColorimetry  *colorimetry,
+                                            GError             **error)
+{
+  const struct di_color_primaries *edid_primaries;
+  ClutterColorimetry candidate;
+  ClutterPrimaries primaries;
+  int32_t coordinates[8];
+
+  if (!edid_info)
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_NOT_FOUND,
+                           "No EDID");
+      return FALSE;
+    }
+
+  edid_primaries = &edid_info->default_color_primaries;
+  if (!edid_primaries->has_primaries ||
+      !edid_primaries->has_default_white_point)
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_NOT_FOUND,
+                           "The EDID does not declare color primaries and a "
+                           "default white point");
+      return FALSE;
+    }
+
+  primaries = (ClutterPrimaries) {
+    .r_x = edid_primaries->primary[0].x,
+    .r_y = edid_primaries->primary[0].y,
+    .g_x = edid_primaries->primary[1].x,
+    .g_y = edid_primaries->primary[1].y,
+    .b_x = edid_primaries->primary[2].x,
+    .b_y = edid_primaries->primary[2].y,
+    .w_x = edid_primaries->default_white.x,
+    .w_y = edid_primaries->default_white.y,
+  };
+
+  if (!meta_color_primaries_to_fixed (&primaries, coordinates))
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+                           "The EDID color primaries cannot be represented");
+      return FALSE;
+    }
+
+  candidate = (ClutterColorimetry) {
+    .type = CLUTTER_COLORIMETRY_TYPE_PRIMARIES,
+    .primaries = &primaries,
+  };
+  if (!clutter_colorimetry_get_linear_bt2020_matrices (&candidate,
+                                                       NULL, NULL,
+                                                       error))
+    return FALSE;
+
+  colorimetry->type = CLUTTER_COLORIMETRY_TYPE_PRIMARIES;
+  colorimetry->primaries = g_memdup2 (&primaries, sizeof (primaries));
+  return TRUE;
+}
+
 static void
-get_color_metadata_from_monitor (MetaMonitor        *monitor,
+get_color_metadata_from_monitor (MetaColorDevice    *color_device,
                                  ClutterColorimetry *colorimetry,
                                  ClutterEOTF        *eotf)
 {
+  MetaMonitor *monitor = color_device->monitor;
   MetaOutput *output;
   const MetaOutputInfo *output_info;
   MetaEdidInfo *edid_info;
-  const struct di_color_primaries *primaries;
+  g_autoptr (GError) error = NULL;
 
   switch (meta_monitor_get_color_mode (monitor))
     {
@@ -724,28 +794,41 @@ get_color_metadata_from_monitor (MetaMonitor        *monitor,
       output = meta_monitor_get_main_output (monitor);
       output_info = meta_output_get_info (output);
       edid_info = output_info->edid_info;
-      primaries = &edid_info->default_color_primaries;
-      colorimetry->type = CLUTTER_COLORIMETRY_TYPE_PRIMARIES;
-      colorimetry->primaries = g_new (ClutterPrimaries, 1);
-      colorimetry->primaries->r_x = primaries->primary[0].x;
-      colorimetry->primaries->r_y = primaries->primary[0].y;
-      colorimetry->primaries->g_x = primaries->primary[1].x;
-      colorimetry->primaries->g_y = primaries->primary[1].y;
-      colorimetry->primaries->b_x = primaries->primary[2].x;
-      colorimetry->primaries->b_y = primaries->primary[2].y;
-      colorimetry->primaries->w_x = primaries->default_white.x;
-      colorimetry->primaries->w_y = primaries->default_white.y;
-
-      if (G_APPROX_VALUE (edid_info->default_gamma, 2.2f, 0.0001f))
+
+      if (!meta_color_colorimetry_from_edid_primaries (edid_info,
+                                                       colorimetry,
+                                                       &error))
+        {
+          /* Without usable primaries, the native mode keeps the colorimetry
+           * of the default mode rather than rendering with a transform that
+           * does not exist. */
+          if (!color_device->warned_unusable_edid_primaries)
+            {
+              g_warning ("Ignoring unusable EDID color primaries of %s: %s",
+                         meta_monitor_get_connector (monitor),
+                         error->message);
+              color_device->warned_unusable_edid_primaries = TRUE;
+            }
+
+          colorimetry->type = CLUTTER_COLORIMETRY_TYPE_COLORSPACE;
+          colorimetry->colorspace = CLUTTER_COLORSPACE_SRGB;
+        }
+
+      if (edid_info && G_APPROX_VALUE (edid_info->default_gamma, 2.2f, 0.0001f))
         {
           eotf->type = CLUTTER_EOTF_TYPE_NAMED;
           eotf->tf_name = CLUTTER_TRANSFER_FUNCTION_GAMMA22;
         }
-      else
+      else if (edid_info)
         {
           eotf->type = CLUTTER_EOTF_TYPE_GAMMA;
           eotf->gamma_exp = (float) edid_info->default_gamma;
         }
+      else
+        {
+          eotf->type = CLUTTER_EOTF_TYPE_NAMED;
+          eotf->tf_name = CLUTTER_TRANSFER_FUNCTION_GAMMA22;
+        }
 
       return;
     }
@@ -1021,7 +1104,6 @@ update_target_volume (MetaColorDevice *color_device)
 static UpdateResult
 update_color_state (MetaColorDevice *color_device)
 {
-  MetaMonitor *monitor = color_device->monitor;
   MetaBackend *backend =
     meta_color_manager_get_backend (color_device->color_manager);
   MetaContext *context = meta_backend_get_context (backend);
@@ -1033,7 +1115,7 @@ update_color_state (MetaColorDevice *color_device)
   ClutterLuminance luminance;
   UpdateResult result = 0;
 
-  get_color_metadata_from_monitor (monitor, &colorimetry, &eotf);
+  get_color_metadata_from_monitor (color_device, &colorimetry, &eotf);
 
   if (meta_debug_control_is_hdr_forced (debug_control))
     {
