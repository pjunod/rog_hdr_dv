+static void
+primaries_unsupported_client (WaylandDisplay *display)
+{
+  /* All three primaries on the line x = y: the RGB columns are collinear. */
+  const int32_t collinear[8] = {
+    600000, 600000, 300000, 300000, 100000, 100000, 312700, 329000,
+  };
+  /* A white point with y = 0 has no XYZ. */
+  const int32_t white_y_zero[8] = {
+    640000, 330000, 300000, 600000, 150000, 60000, 312700, 0,
+  };
+  /* Nearly collinear primaries with the white point inside the sliver they
+   * span: invertible in single precision, but too ill-conditioned to convert
+   * accurately to and from linear BT.2020. */
+  const int32_t nearly_collinear[8] = {
+    600000, 600000, 300000, 300100, 100000, 100000, 333333, 333366,
+  };
+  /* Nearly collinear primaries around a white point outside their sliver. */
+  const int32_t nearly_collinear_d65[8] = {
+    600000, 600000, 300000, 300001, 100000, 100000, 312700, 329000,
+  };
+  /* A white point must have a positive y, even with imaginary primaries. */
+  const int32_t white_y_negative[8] = {
+    640000, 330000, 300000, 600000, 150000, 60000, 312700, -329000,
+  };
+  /* A white point outside the primaries' triangle needs a negative amount
+   * of a primary. */
+  const int32_t white_outside[8] = {
+    640000, 330000, 300000, 600000, 150000, 60000, 700000, 250000,
+  };
+  /* Coordinates are limited to [-16, 16]. */
+  const int32_t out_of_range[8] = {
+    16000001, -15000000, -15000000, 16000000, 100000, 100000, 312700, 329000,
+  };
+  /* A large imaginary gamut at that limit is a valid encoding gamut. */
+  const int32_t at_range_limit[8] = {
+    16000000, -15000000, -15000000, 16000000, 100000, 100000, 312700, 329000,
+  };
+  ImageDescriptionContext context;
+  struct wl_surface *surface;
+  struct wp_color_management_surface_v1 *color_surface;
+  struct wp_image_description_v1 *image_description;
+
+  create_test_toplevel (display, "color-management-unsupported",
+                        &surface, &color_surface);
+
+  assert_unsupported_coordinates (display, collinear);
+  assert_unsupported_coordinates (display, white_y_zero);
+  assert_unsupported_coordinates (display, nearly_collinear);
+  assert_unsupported_coordinates (display, nearly_collinear_d65);
+  assert_unsupported_coordinates (display, white_y_negative);
+  assert_unsupported_coordinates (display, white_outside);
+  assert_unsupported_coordinates (display, out_of_range);
+
+  image_description =
+    create_image_description_from_coordinates (display, at_range_limit,
+                                               &context);
+  g_assert_false (context.creation_failed);
+  g_assert_cmpuint (context.image_description_id, >, 0);
+  wp_image_description_v1_destroy (image_description);
+
+  /* The connection survives and keeps working after unsupported input. */
+  create_image_description_from_params (display,
+                                        &image_description,
+                                        WP_COLOR_MANAGER_V1_PRIMARIES_BT2020,
+                                        NULL,
+                                        WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_ST2084_PQ,
+                                        -1.0f,
+                                        -1.0f,
+                                        -1.0f,
+                                        -1.0f);
+  wp_color_management_surface_v1_set_image_description (
+    color_surface,
+    image_description,
+    WP_COLOR_MANAGER_V1_RENDER_INTENT_PERCEPTUAL);
+  wl_surface_commit (surface);
+  wp_image_description_v1_destroy (image_description);
+
+  test_driver_sync_point (display->test_driver, 0, NULL);
+  wait_for_sync_event (display, 0);
+
+  wp_color_management_surface_v1_destroy (color_surface);
+}
