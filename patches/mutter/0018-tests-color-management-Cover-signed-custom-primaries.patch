+static void
+info_round_trip_client (WaylandDisplay *display)
+{
+  TargetClient client = { .version = 1 };
+  struct wl_registry *registry = wl_display_get_registry (display->display);
+  const char *target_name = lookup_property_string (display, "target-output");
+  TargetOutput *target = NULL;
+  TargetSnapshot snapshot = { 0 };
+  TargetInfo info;
+  unsigned int i;
+
+  wl_registry_add_listener (registry, &target_registry_listener, &client);
+  wl_display_roundtrip (display->display);
+  wl_display_roundtrip (display->display);
+  g_assert_nonnull (client.manager);
+  for (i = 0; i < client.n_outputs; i++)
+    {
+      if (g_strcmp0 (client.outputs[i].name, target_name) == 0)
+        target = &client.outputs[i];
+    }
+  g_assert_nonnull (target);
+
+  target->color_output = wp_color_manager_v1_get_output (client.manager,
+                                                         target->output);
+  wp_color_management_output_v1_add_listener (target->color_output,
+                                              &target_color_output_listener,
+                                              target);
+  snapshot.description =
+    wp_color_management_output_v1_get_image_description (target->color_output);
+  wait_target_snapshot (display, &snapshot);
+
+  info = read_target_info (display, &snapshot);
+  /* Custom primaries carry no name, and signed values come back exactly. */
+  g_assert_cmpuint (info.primaries, ==, 0);
+  for (i = 0; i < G_N_ELEMENTS (ap0_coordinates); i++)
+    g_assert_cmpint (info.encoding_primaries[i], ==, ap0_coordinates[i]);
+
+  wp_image_description_v1_destroy (snapshot.description);
+  wp_color_management_output_v1_destroy (target->color_output);
+  for (i = 0; i < client.n_outputs; i++)
+    {
+      wl_output_release (client.outputs[i].output);
+      g_free (client.outputs[i].name);
+    }
+  wp_color_manager_v1_destroy (client.manager);
+  wl_registry_destroy (registry);
+  wl_display_roundtrip (display->display);
+}
