 static gboolean
 creator_params_check_supported (MetaWaylandCreatorParams  *creator_params,
                                 GError                   **error)
 {
+  const ClutterColorTargetVolume *target_volume = &creator_params->target_volume;
+
   if (creator_params->unsupported_reason)
     {
       g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED,
@@ -1535,9 +1576,113 @@ creator_params_check_supported (MetaWaylandCreatorParams  *creator_params,
         return FALSE;
     }
 
+  if (target_volume->has_primaries)
+    {
