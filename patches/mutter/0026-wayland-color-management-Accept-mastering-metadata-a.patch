@@ -1693,6 +1856,55 @@ creator_params_set_primaries_named (struct wl_client   *client,
   creator_params->is_colorimetry_set = TRUE;
 }
 
+/*
+ * Converts chromaticity coordinates in the protocol's signed units of
+ * 1/1000000 to @primaries. Returns %NULL if they are stored exactly, otherwise
+ * why they cannot be supported.
+ */
+static const char *
+primaries_from_protocol (const int32_t     requested[8],
+                         ClutterPrimaries *primaries)
+{
+  int32_t published[8];
+  unsigned int i;
+
+  primaries->r_x = meta_color_chromaticity_from_fixed (requested[0]);
+  primaries->r_y = meta_color_chromaticity_from_fixed (requested[1]);
+  primaries->g_x = meta_color_chromaticity_from_fixed (requested[2]);
+  primaries->g_y = meta_color_chromaticity_from_fixed (requested[3]);
+  primaries->b_x = meta_color_chromaticity_from_fixed (requested[4]);
+  primaries->b_y = meta_color_chromaticity_from_fixed (requested[5]);
+  primaries->w_x = meta_color_chromaticity_from_fixed (requested[6]);
+  primaries->w_y = meta_color_chromaticity_from_fixed (requested[7]);
+
+  /* Coordinates are not clamped: an encoding gamut may lie outside the
+   * spectral locus. They are limited to [-16, 16], the range in which every
+   * protocol value is stored exactly by the single precision representation,
+   * so an accepted coordinate always describes the requested space. Beyond
+   * that, exactness would depend on the bit pattern of each value. The exact
+   * round trip is still verified. (Custom primaries within the color state
+   * equality tolerance of sRGB are subsequently stored as named sRGB.) */
+  for (i = 0; i < 8; i++)
+    {
+      if (ABS ((int64_t) requested[i]) > MAX_CHROMATICITY_COORDINATE)
+        return "Chromaticity coordinates must lie within [-16, 16]";
+    }
+
+  if (!meta_color_primaries_to_fixed (primaries, published) ||
+      memcmp (published, requested, sizeof (published)) != 0)
+    return "A chromaticity coordinate cannot be represented exactly";
+
+  return NULL;
+}
+
+static void
+creator_params_set_unsupported (MetaWaylandCreatorParams *creator_params,
+                                const char               *reason)
+{
+  if (reason && !creator_params->unsupported_reason)
+    creator_params->unsupported_reason = reason;
+}
