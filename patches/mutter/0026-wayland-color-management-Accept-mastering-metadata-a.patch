+/*
+ * The luminance range of the target color volume: the mastering luminance if
+ * set, otherwise that of the primary color volume.
+ */
+static void
+creator_params_get_target_luminance (MetaWaylandCreatorParams *creator_params,
+                                     float                    *min_lum,
+                                     float                    *max_lum)
+{
+  const ClutterColorTargetVolume *target_volume = &creator_params->target_volume;
+  const ClutterLuminance *lum;
+  gboolean is_pq;
+
+  if (target_volume->has_luminance)
+    {
+      *min_lum = target_volume->min_lum;
+      *max_lum = target_volume->max_lum;
+      return;
+    }
+
+  is_pq = creator_params->eotf.type == CLUTTER_EOTF_TYPE_NAMED &&
+          creator_params->eotf.tf_name == CLUTTER_TRANSFER_FUNCTION_PQ;
+
+  if (creator_params->is_luminance_set)
+    {
+      lum = &creator_params->lum;
+      *min_lum = lum->min;
+      *max_lum = is_pq ? lum->min + 10000.0f : lum->max;
+    }
+  else
+    {
+      lum = clutter_eotf_get_default_luminance (creator_params->eotf);
+      *min_lum = lum->min;
+      *max_lum = lum->max;
+    }
+}
+
+/*
+ * Protocol errors of the create request for the content light levels. A
+ * level of 0 is unknown and takes part in no comparison.
+ */
+static gboolean
+creator_params_check_light_levels (MetaWaylandCreatorParams  *creator_params,
+                                   const char               **message)
+{
+  const ClutterColorTargetVolume *target_volume = &creator_params->target_volume;
+  float max_cll = target_volume->max_cll;
+  float max_fall = target_volume->max_fall;
+  float min_lum, max_lum;
+
+  if (max_cll > 0.0f && max_fall > max_cll)
+    {
+      *message = "max_fall must be less than or equal to max_cll";
+      return FALSE;
+    }
+
+  /* Version 1 also bounds them by the target luminance range. */
+  if (wl_resource_get_version (creator_params->resource) >= 2)
+    return TRUE;
+
+  creator_params_get_target_luminance (creator_params, &min_lum, &max_lum);
+
+  if (max_cll > 0.0f && (max_cll <= min_lum || max_cll > max_lum))
+    {
+      *message = "max_cll must lie within the mastering luminance range";
+      return FALSE;
+    }
+
+  if (max_fall > 0.0f && (max_fall <= min_lum || max_fall > max_lum))
+    {
+      *message = "max_fall must lie within the mastering luminance range";
+      return FALSE;
+    }
+
+  return TRUE;
+}
+
+static gboolean
+creator_params_has_target_volume (MetaWaylandCreatorParams *creator_params)
+{
+  const ClutterColorTargetVolume *target_volume = &creator_params->target_volume;
+
+  return target_volume->has_primaries ||
+         target_volume->has_luminance ||
+         target_volume->max_cll > 0.0f ||
+         target_volume->max_fall > 0.0f;
+}
