+/* SMPTE ST 2086 metadata as HDR10 content commonly declares it: DCI-P3
+ * primaries with a D65 white point. P3's red lies just outside BT.2020. */
+static const int32_t p3_d65_coordinates[8] = {
+  680000, 320000, 265000, 690000, 150000, 60000, 312700, 329000,
+};
+
+static const int32_t bt2020_coordinates[8] = {
+  708000, 292000, 170000, 797000, 131000, 46000, 312700, 329000,
+};
+
+static void
+assert_creator_params_error (WaylandDisplay *display,
+                             uint32_t        error_code)
+{
+  const struct wl_interface *interface = NULL;
+
+  g_assert_cmpint (wl_display_roundtrip (display->display), ==, -1);
+  g_assert_cmpint (wl_display_get_error (display->display), ==, EPROTO);
+  g_assert_cmpuint (wl_display_get_protocol_error (display->display,
+                                                   &interface, NULL),
+                    ==,
+                    error_code);
+  g_assert_true (interface == &wp_image_description_creator_params_v1_interface);
+}
+
+/* 'create' is a destructor request: the client has already destroyed its
+ * creator proxy when an error raised by 'create' arrives, so libwayland
+ * reports the error without an interface. */
+static void
+assert_create_error (WaylandDisplay *display,
+                     uint32_t        error_code)
+{
+  const struct wl_interface *interface = NULL;
+
+  g_assert_cmpint (wl_display_roundtrip (display->display), ==, -1);
+  g_assert_cmpint (wl_display_get_error (display->display), ==, EPROTO);
+  g_assert_cmpuint (wl_display_get_protocol_error (display->display,
+                                                   &interface, NULL),
+                    ==,
+                    error_code);
+  g_assert_null (interface);
+}
+
+static struct wp_image_description_creator_params_v1 *
+create_pq_creator (struct wp_color_manager_v1 *manager)
+{
+  struct wp_image_description_creator_params_v1 *creator_params;
+
+  creator_params = wp_color_manager_v1_create_parametric_creator (manager);
+  wp_image_description_creator_params_v1_set_primaries_named (creator_params,
+                                                              WP_COLOR_MANAGER_V1_PRIMARIES_BT2020);
+  wp_image_description_creator_params_v1_set_tf_named (creator_params,
+                                                       WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_ST2084_PQ);
+
+  return creator_params;
+}
+
+static void
+set_mastering_primaries (struct wp_image_description_creator_params_v1 *creator_params,
+                         const int32_t                                  coordinates[8])
+{
+  wp_image_description_creator_params_v1_set_mastering_display_primaries (creator_params,
+                                                                          coordinates[0],
+                                                                          coordinates[1],
+                                                                          coordinates[2],
+                                                                          coordinates[3],
+                                                                          coordinates[4],
+                                                                          coordinates[5],
+                                                                          coordinates[6],
+                                                                          coordinates[7]);
+}
+
+typedef enum
+{
+  MASTERING_ERROR_LUMINANCE_NOT_ABOVE_MINIMUM,
+  MASTERING_ERROR_PRIMARIES_TWICE,
+  MASTERING_ERROR_LUMINANCE_TWICE,
+  MASTERING_ERROR_MAX_CLL_TWICE,
+  MASTERING_ERROR_MAX_FALL_TWICE,
+  MASTERING_ERROR_MAX_FALL_ABOVE_MAX_CLL,
+  MASTERING_ERROR_V1_MAX_CLL_ABOVE_MASTERING,
+} MasteringError;
+
+static void
+mastering_error_client (WaylandDisplay *display,
+                        MasteringError  error)
+{
+  struct wp_image_description_creator_params_v1 *creator_params;
+
+  creator_params = create_pq_creator (display->color_management_mgr);
+
+  switch (error)
+    {
+    case MASTERING_ERROR_LUMINANCE_NOT_ABOVE_MINIMUM:
+      /* Maximum 1 cd/m² equal to the minimum, 10000 / 10000 cd/m². */
+      wp_image_description_creator_params_v1_set_mastering_luminance (creator_params,
+                                                                      10000, 1);
+      assert_creator_params_error (display,
+                                   WP_IMAGE_DESCRIPTION_CREATOR_PARAMS_V1_ERROR_INVALID_LUMINANCE);
+      return;
+    case MASTERING_ERROR_PRIMARIES_TWICE:
+      set_mastering_primaries (creator_params, p3_d65_coordinates);
+      set_mastering_primaries (creator_params, p3_d65_coordinates);
+      break;
+    case MASTERING_ERROR_LUMINANCE_TWICE:
+      wp_image_description_creator_params_v1_set_mastering_luminance (creator_params,
+                                                                      1, 1000);
+      wp_image_description_creator_params_v1_set_mastering_luminance (creator_params,
+                                                                      1, 1000);
+      break;
+    case MASTERING_ERROR_MAX_CLL_TWICE:
+      wp_image_description_creator_params_v1_set_max_cll (creator_params, 800);
+      wp_image_description_creator_params_v1_set_max_cll (creator_params, 800);
+      break;
+    case MASTERING_ERROR_MAX_FALL_TWICE:
+      wp_image_description_creator_params_v1_set_max_fall (creator_params, 300);
+      wp_image_description_creator_params_v1_set_max_fall (creator_params, 300);
+      break;
+    case MASTERING_ERROR_MAX_FALL_ABOVE_MAX_CLL:
+      wp_image_description_creator_params_v1_set_max_cll (creator_params, 400);
+      wp_image_description_creator_params_v1_set_max_fall (creator_params, 401);
+      wp_image_description_creator_params_v1_create (creator_params);
+      assert_create_error (display,
+                           WP_IMAGE_DESCRIPTION_CREATOR_PARAMS_V1_ERROR_INVALID_LUMINANCE);
+      return;
+    case MASTERING_ERROR_V1_MAX_CLL_ABOVE_MASTERING:
+      /* The test display binds version 1, which bounds MaxCLL by the
+       * mastering luminance range. */
+      g_assert_cmpuint (wp_color_manager_v1_get_version (display->color_management_mgr),
+                        ==, 1);
+      wp_image_description_creator_params_v1_set_mastering_luminance (creator_params,
+                                                                      1, 1000);
+      wp_image_description_creator_params_v1_set_max_cll (creator_params, 1001);
+      wp_image_description_creator_params_v1_create (creator_params);
+      assert_create_error (display,
+                           WP_IMAGE_DESCRIPTION_CREATOR_PARAMS_V1_ERROR_INVALID_LUMINANCE);
+      return;
+    }
+
+  assert_creator_params_error (display,
+                               WP_IMAGE_DESCRIPTION_CREATOR_PARAMS_V1_ERROR_ALREADY_SET);
+}
+
+static struct wp_image_description_v1 *
+create_from_creator (WaylandDisplay                                *display,
+                     struct wp_image_description_creator_params_v1 *creator_params,
+                     ImageDescriptionContext                       *context)
+{
+  struct wp_image_description_v1 *image_description;
+
+  *context = (ImageDescriptionContext) { 0 };
+  image_description =
+    wp_image_description_creator_params_v1_create (creator_params);
+  wp_image_description_v1_add_listener (image_description,
+                                        &image_description_listener,
+                                        context);
+  wait_for_image_description_ready (context, display);
+
+  return image_description;
+}
+
+static void
+assert_mastering_unsupported (WaylandDisplay *display,
+                              int             primaries_named,
+                              const int32_t   mastering[8])
+{
+  struct wp_image_description_creator_params_v1 *creator_params;
+  struct wp_image_description_v1 *image_description;
+  ImageDescriptionContext context;
+
+  creator_params =
+    wp_color_manager_v1_create_parametric_creator (display->color_management_mgr);
+  wp_image_description_creator_params_v1_set_primaries_named (creator_params,
+                                                              primaries_named);
+  wp_image_description_creator_params_v1_set_tf_named (creator_params,
+                                                       WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_ST2084_PQ);
+  set_mastering_primaries (creator_params, mastering);
+  image_description = create_from_creator (display, creator_params, &context);
+  g_assert_true (context.creation_failed);
+  g_assert_cmpuint (context.failure_cause, ==,
+                    WP_IMAGE_DESCRIPTION_V1_CAUSE_UNSUPPORTED);
+  wp_image_description_v1_destroy (image_description);
+
+  /* A failed image description is not a protocol error. */
+  g_assert_cmpint (wl_display_roundtrip (display->display), !=, -1);
+}
+
+static void
+assert_mastering_accepted (WaylandDisplay *display,
+                           int             primaries_named,
+                           const int32_t   mastering[8])
+{
+  struct wp_image_description_creator_params_v1 *creator_params;
+  struct wp_image_description_v1 *image_description;
+  ImageDescriptionContext context;
+
+  creator_params =
+    wp_color_manager_v1_create_parametric_creator (display->color_management_mgr);
+  wp_image_description_creator_params_v1_set_primaries_named (creator_params,
+                                                              primaries_named);
+  wp_image_description_creator_params_v1_set_tf_named (creator_params,
+                                                       WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_ST2084_PQ);
+  set_mastering_primaries (creator_params, mastering);
+  image_description = create_from_creator (display, creator_params, &context);
+  g_assert_false (context.creation_failed);
+  g_assert_cmpuint (context.image_description_id, >, 0);
+  wp_image_description_v1_destroy (image_description);
+}
+
+static void
+extended_target_client (WaylandDisplay *display)
+{
+  /* Collinear: they do not span a color space. */
+  const int32_t collinear[8] = {
+    600000, 600000, 300000, 300000, 100000, 100000, 312700, 329000,
+  };
+  /* Representable only approximately. */
+  const int32_t out_of_range[8] = {
+    16000001, 330000, 300000, 600000, 150000, 60000, 312700, 329000,
+  };
+  struct wp_image_description_v1 *image_description;
+
+  /* Mastering primaries are validated like encoding primaries: unusable or
+   * unrepresentable ones fail the image description. */
+  assert_mastering_unsupported (display, WP_COLOR_MANAGER_V1_PRIMARIES_BT2020,
+                                collinear);
+  assert_mastering_unsupported (display, WP_COLOR_MANAGER_V1_PRIMARIES_BT2020,
+                                out_of_range);
+
+  /* P3-D65 on BT.2020, the common HDR10 declaration, whose red primary lies
+   * just outside BT.2020, mastering primaries equal to the encoding's, and,
+   * with extended_target_volume, a target exceeding the primary volume. */
+  assert_mastering_accepted (display, WP_COLOR_MANAGER_V1_PRIMARIES_BT2020,
+                             p3_d65_coordinates);
+  assert_mastering_accepted (display, WP_COLOR_MANAGER_V1_PRIMARIES_BT2020,
+                             bt2020_coordinates);
+  assert_mastering_accepted (display, WP_COLOR_MANAGER_V1_PRIMARIES_SRGB,
+                             bt2020_coordinates);
+
+  /* With extended_target_volume, reference white may exceed the primary
+   * volume's maximum luminance. */
+  create_image_description_from_params (display,
+                                        &image_description,
+                                        WP_COLOR_MANAGER_V1_PRIMARIES_SRGB,
+                                        NULL,
+                                        WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_GAMMA22,
+                                        -1.0f,
+                                        0.2f,
+                                        80.0f,
+                                        100.0f);
+  wp_image_description_v1_destroy (image_description);
+  g_assert_cmpint (wl_display_roundtrip (display->display), !=, -1);
+}
+
+static void
+bind_registry_global (void               *data,
+                      struct wl_registry *registry,
+                      uint32_t            name,
+                      const char         *interface,
+                      uint32_t            version)
+{
+  struct wp_color_manager_v1 **manager = data;
+
+  if (strcmp (interface, wp_color_manager_v1_interface.name) == 0)
+    {
+      g_assert_cmpuint (version, >=, 2);
+      *manager = wl_registry_bind (registry, name,
+                                   &wp_color_manager_v1_interface, 2);
+    }
+}
+
+static void
+bind_registry_remove (void               *data,
+                      struct wl_registry *registry,
+                      uint32_t            name)
+{
+}
+
+static const struct wl_registry_listener bind_v2_registry_listener = {
+  .global = bind_registry_global,
+  .global_remove = bind_registry_remove,
+};
+
+/* Version 2 no longer bounds MaxCLL by the mastering luminance range. */
+static void
+mastering_v2_light_levels_client (WaylandDisplay *display)
+{
+  struct wl_registry *registry = wl_display_get_registry (display->display);
+  struct wp_color_manager_v1 *manager = NULL;
+  struct wp_image_description_creator_params_v1 *creator_params;
+  struct wp_image_description_v1 *image_description;
+  ImageDescriptionContext context;
+
+  wl_registry_add_listener (registry, &bind_v2_registry_listener, &manager);
+  wl_display_roundtrip (display->display);
+  g_assert_nonnull (manager);
+
+  creator_params = create_pq_creator (manager);
+  wp_image_description_creator_params_v1_set_mastering_luminance (creator_params,
+                                                                  1, 1000);
+  wp_image_description_creator_params_v1_set_max_cll (creator_params, 1001);
+  image_description = create_from_creator (display, creator_params, &context);
+  g_assert_false (context.creation_failed);
+  wp_image_description_v1_destroy (image_description);
+
+  wp_color_manager_v1_destroy (manager);
+  wl_registry_destroy (registry);
+  g_assert_cmpint (wl_display_roundtrip (display->display), !=, -1);
+}
+
+static void
+set_surface_description (struct wl_surface                     *surface,
+                         struct wp_color_management_surface_v1 *color_surface,
+                         struct wp_image_description_v1        *image_description)
+{
+  wp_color_management_surface_v1_set_image_description (
+    color_surface,
+    image_description,
+    WP_COLOR_MANAGER_V1_RENDER_INTENT_PERCEPTUAL);
+  wl_surface_commit (surface);
+  wp_image_description_v1_destroy (image_description);
+}
+
+static void
+mastering_round_trip_client (WaylandDisplay *display)
+{
+  struct wp_image_description_creator_params_v1 *creator_params;
+  struct wp_image_description_v1 *plain_description;
+  struct wp_image_description_v1 *image_description;
+  struct wl_surface *surface;
+  struct wp_color_management_surface_v1 *color_surface;
+  ImageDescriptionContext context;
+  ManagerSupport support;
+  uint32_t plain_identity;
+
+  read_manager_support (display, &support);
+  g_assert_true (support.features &
+                 (1u << WP_COLOR_MANAGER_V1_FEATURE_SET_MASTERING_DISPLAY_PRIMARIES));
+  g_assert_true (support.features &
+                 (1u << WP_COLOR_MANAGER_V1_FEATURE_EXTENDED_TARGET_VOLUME));
+
+  create_test_toplevel (display, "color-management-mastering",
+                        &surface, &color_surface);
+
+  /* PQ without a target volume. It stays alive while the next description
+   * is created: a version 1 identity may be reused once its description is
+   * gone. */
+  creator_params = create_pq_creator (display->color_management_mgr);
+  plain_description = create_from_creator (display, creator_params, &context);
+  g_assert_false (context.creation_failed);
+  plain_identity = context.image_description_id;
+
+  /* The same encoding with HDR10 static metadata. */
+  creator_params = create_pq_creator (display->color_management_mgr);
+  set_mastering_primaries (creator_params, p3_d65_coordinates);
+  wp_image_description_creator_params_v1_set_mastering_luminance (creator_params,
+                                                                  1, 1000);
+  wp_image_description_creator_params_v1_set_max_cll (creator_params, 800);
+  wp_image_description_creator_params_v1_set_max_fall (creator_params, 300);
+  image_description = create_from_creator (display, creator_params, &context);
+  g_assert_false (context.creation_failed);
+  g_assert_cmpuint (context.image_description_id, !=, plain_identity);
+
+  set_surface_description (surface, color_surface, plain_description);
+  test_driver_sync_point (display->test_driver, 0, NULL);
+  wait_for_sync_event (display, 0);
+
+  set_surface_description (surface, color_surface, image_description);
+  test_driver_sync_point (display->test_driver, 1, NULL);
+  wait_for_sync_event (display, 1);
+
+  /* MaxCLL and MaxFALL of 0 are unknown (CTA-861-H): no target volume. */
+  creator_params = create_pq_creator (display->color_management_mgr);
+  wp_image_description_creator_params_v1_set_max_cll (creator_params, 0);
+  wp_image_description_creator_params_v1_set_max_fall (creator_params, 0);
+  image_description = create_from_creator (display, creator_params, &context);
+  g_assert_false (context.creation_failed);
+  set_surface_description (surface, color_surface, image_description);
+  test_driver_sync_point (display->test_driver, 2, NULL);
+  wait_for_sync_event (display, 2);
+
+  /* MaxFALL above MaxCLL is an error only when both are known. */
+  creator_params = create_pq_creator (display->color_management_mgr);
+  wp_image_description_creator_params_v1_set_max_cll (creator_params, 0);
+  wp_image_description_creator_params_v1_set_max_fall (creator_params, 250);
+  image_description = create_from_creator (display, creator_params, &context);
+  g_assert_false (context.creation_failed);
+  set_surface_description (surface, color_surface, image_description);
+  test_driver_sync_point (display->test_driver, 3, NULL);
+  wait_for_sync_event (display, 3);
+
+  wp_color_management_surface_v1_destroy (color_surface);
+}
