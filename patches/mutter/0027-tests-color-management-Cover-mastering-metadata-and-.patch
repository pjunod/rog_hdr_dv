+static const ClutterColorTargetVolume *
+get_window_target_volume (MetaWindow *window)
+{
+  ClutterColorState *color_state = get_window_color_state (window);
+
+  g_assert_true (CLUTTER_IS_COLOR_STATE_PARAMS (color_state));
+
+  return clutter_color_state_params_get_target_volume (CLUTTER_COLOR_STATE_PARAMS (color_state));
+}
+
+/* The effective peak in the state's own luminance units. */
+static double
+get_peak_luminance (ClutterColorState *color_state)
+{
+  ClutterColorStateParams *params = CLUTTER_COLOR_STATE_PARAMS (color_state);
+  double peak_headroom;
+
+  g_assert_true (clutter_color_state_params_get_peak_headroom (params, NULL,
+                                                               &peak_headroom));
+
+  return peak_headroom * clutter_color_state_params_get_luminance (params)->ref;
+}
+
+static void
+mastering_round_trip (void)
+{
+  MetaWaylandTestClient *client;
+  MetaWindow *window;
+  g_autoptr (ClutterColorState) plain = NULL;
+  ClutterColorState *color_state;
+  const ClutterColorTargetVolume *target_volume;
+  double peak;
+
+  /* The client also checks the advertised features. */
+  client = meta_wayland_test_client_new_with_args (test_context,
+                                                   "color-management",
+                                                   "mastering-round-trip",
+                                                   NULL);
+  window = meta_wait_for_client_window (test_context,
+                                        "color-management-mastering");
+
+  wait_for_sync_point (0);
+  plain = g_object_ref (get_window_color_state (window));
+  target_volume = get_window_target_volume (window);
+  g_assert_false (target_volume->has_primaries);
+  g_assert_false (target_volume->has_luminance);
+  g_assert_cmpfloat (target_volume->max_cll, ==, 0.0f);
+  g_assert_cmpfloat (target_volume->max_fall, ==, 0.0f);
+  /* PQ's default range: 10000 cd/m², reference white 203 cd/m². */
+  peak = get_peak_luminance (plain);
+  g_assert_cmpfloat_with_epsilon (peak, 10000.0, 0.01);
+  emit_sync_event (0);
+
+  /* The declared values survive, and make a different color state, which
+   * still needs no conversion to or from the plain one. */
+  wait_for_sync_point (1);
+  color_state = get_window_color_state (window);
+  target_volume = get_window_target_volume (window);
+  g_assert_true (target_volume->has_primaries);
+  g_assert_cmpfloat (target_volume->primaries.r_x, ==, 0.68f);
+  g_assert_cmpfloat (target_volume->primaries.r_y, ==, 0.32f);
+  g_assert_cmpfloat (target_volume->primaries.g_x, ==, 0.265f);
+  g_assert_cmpfloat (target_volume->primaries.g_y, ==, 0.69f);
+  g_assert_cmpfloat (target_volume->primaries.b_x, ==, 0.15f);
+  g_assert_cmpfloat (target_volume->primaries.b_y, ==, 0.06f);
+  g_assert_cmpfloat (target_volume->primaries.w_x, ==, 0.3127f);
+  g_assert_cmpfloat (target_volume->primaries.w_y, ==, 0.329f);
+  g_assert_true (target_volume->has_luminance);
+  g_assert_cmpfloat_with_epsilon (target_volume->min_lum, 0.0001f, 1e-9f);
+  g_assert_cmpfloat (target_volume->max_lum, ==, 1000.0f);
+  g_assert_cmpfloat (target_volume->max_cll, ==, 800.0f);
+  g_assert_cmpfloat (target_volume->max_fall, ==, 300.0f);
+  peak = get_peak_luminance (color_state);
+  g_assert_cmpfloat_with_epsilon (peak, 800.0, 1e-3);
+  g_assert_false (clutter_color_state_equals (color_state, plain));
+  g_assert_false (clutter_color_pipeline_shader_needs_color_state (color_state, plain, 0));
+  g_assert_false (clutter_color_pipeline_shader_needs_color_state (plain, color_state, 0));
+  emit_sync_event (1);
+
+  /* Unknown light levels declare nothing. */
+  wait_for_sync_point (2);
+  color_state = get_window_color_state (window);
+  target_volume = get_window_target_volume (window);
+  g_assert_false (target_volume->has_primaries);
+  g_assert_false (target_volume->has_luminance);
+  g_assert_cmpfloat (target_volume->max_cll, ==, 0.0f);
+  g_assert_cmpfloat (target_volume->max_fall, ==, 0.0f);
+  g_assert_true (clutter_color_state_equals (color_state, plain));
+  g_assert_cmpuint (clutter_color_state_hash (color_state), ==,
+                    clutter_color_state_hash (plain));
+  emit_sync_event (2);
+
+  /* MaxFALL alone is kept but does not lower the peak. */
+  wait_for_sync_point (3);
+  color_state = get_window_color_state (window);
+  target_volume = get_window_target_volume (window);
+  g_assert_cmpfloat (target_volume->max_cll, ==, 0.0f);
+  g_assert_cmpfloat (target_volume->max_fall, ==, 250.0f);
+  peak = get_peak_luminance (color_state);
+  g_assert_cmpfloat_with_epsilon (peak, 10000.0, 0.01);
+  g_assert_false (clutter_color_state_equals (color_state, plain));
+  emit_sync_event (3);
+
+  meta_wayland_test_client_finish (client);
+}
