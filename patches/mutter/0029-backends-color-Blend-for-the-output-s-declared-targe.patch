 META_EXPORT_TEST
 void meta_color_target_luminance_init (MetaColorTargetLuminance *target,
                                        const MetaEdidInfo       *edid_info,
@@ -132,6 +135,7 @@ void meta_color_device_update (MetaColorDevice *color_device);
 
 float meta_color_device_get_reference_luminance_factor (MetaColorDevice *color_device);
 
+META_EXPORT_TEST
 void meta_color_device_set_reference_luminance_factor (MetaColorDevice *color_device,
                                                        float            factor);
 
diff --git a/src/backends/meta-renderer-view.c b/src/backends/meta-renderer-view.c
index b4b8e31..a0ac65c 100644
--- a/src/backends/meta-renderer-view.c
+++ b/src/backends/meta-renderer-view.c
@@ -80,6 +80,7 @@ set_color_states (MetaRendererView *view)
   MetaContext *context = meta_backend_get_context (priv->backend);
   MetaDebugControl *debug_control = meta_context_get_debug_control (context);
   ClutterColorState *output_color_state;
+  ClutterColorState *rendering_color_state;
   g_autoptr (ClutterColorState) view_color_state = NULL;
   gboolean force_linear;
 
@@ -87,8 +88,12 @@ set_color_states (MetaRendererView *view)
 
   output_color_state = meta_color_device_get_color_state (priv->color_device);
 
+  /* Content is blended for the output's target, when it is declared, so
+   * that converting it to the view's color state maps its highlights. */
+  rendering_color_state =
+    meta_color_device_get_rendering_color_state (priv->color_device);
   force_linear = meta_debug_control_is_linear_blending_forced (debug_control);
-  view_color_state = clutter_color_state_get_blending (output_color_state,
+  view_color_state = clutter_color_state_get_blending (rendering_color_state,
                                                        force_linear);
 
   if (meta_is_topic_enabled (META_DEBUG_RENDER))
@@ -200,7 +205,10 @@ meta_renderer_view_constructed (GObject *object)
     {
       set_color_states (view);
 
-      g_signal_connect_object (priv->color_device, "color-state-changed",
+      /* Emitted once per device update that changes the output color state,
+       * its target, or both. */
+      g_signal_connect_object (priv->color_device,
+                               "rendering-color-state-changed",
                                G_CALLBACK (on_color_state_changed),
                                view,
                                G_CONNECT_DEFAULT);
diff --git a/src/backends/meta-stream-source-monitor.c b/src/backends/meta-stream-source-monitor.c
index 63f4d82..d18f7ff 100644
--- a/src/backends/meta-stream-source-monitor.c
+++ b/src/backends/meta-stream-source-monitor.c
@@ -822,6 +822,9 @@ stage_paint:
 
       force_linear = meta_debug_control_is_linear_blending_forced (debug_control);
 
+      /* The stream's color state has no physical display target, so its
+       * blending state declares none and content is not highlight mapped
+       * for it, unlike on the monitor itself. */
       blending_color_state = clutter_color_state_get_blending (target_color_state,
                                                                force_linear);
 
