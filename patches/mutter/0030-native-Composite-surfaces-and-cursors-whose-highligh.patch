diff --git a/src/compositor/meta-compositor-view-native.c b/src/compositor/meta-compositor-view-native.c
index 340fcdd..05c96dd 100644
--- a/src/compositor/meta-compositor-view-native.c
+++ b/src/compositor/meta-compositor-view-native.c
@@ -29,6 +29,7 @@
 #include "backends/native/meta-crtc-kms.h"
 #include "backends/native/meta-onscreen-native.h"
 #include "clutter/clutter.h"
+#include "clutter/clutter-color-transform-private.h"
 #include "compositor/compositor-private.h"
 #include "compositor/meta-window-actor-private.h"
 #include "compositor/meta-surface-actor-wayland.h"
@@ -261,6 +262,27 @@ surface_actor_has_overlapping_cursor_overlays (MetaCompositor     *compositor,
   return data.has_overlap;
 }
 
+/*
+ * Whether a surface in @surface_color_state must be composited rather than
+ * scanned out to an output in @output_color_state, whose content is blended
+ * in @blending_color_state: if rendering it would either convert its encoding
+ * or map its highlights toward the output's target. The latter uses the same
+ * test as the color transform that would otherwise apply the mapping.
+ */
+gboolean
+meta_compositor_view_native_color_state_prevents_scanout (ClutterColorState *surface_color_state,
+                                                          ClutterColorState *blending_color_state,
+                                                          ClutterColorState *output_color_state)
+{
+  if (clutter_color_pipeline_shader_needs_color_state (surface_color_state,
+                                                       output_color_state, 0))
+    return TRUE;
+
+  return surface_color_state && blending_color_state &&
+         clutter_color_transform_requires_highlight_mapping (surface_color_state,
+                                                             blending_color_state);
+}
+
 static gboolean
 find_scanout_candidate (MetaCompositorView  *compositor_view,
                         MetaCompositor      *compositor,
@@ -335,14 +357,18 @@ find_scanout_candidate (MetaCompositorView  *compositor_view,
         META_DEBUG_PAINT_IGNORE_COLOR_STATE_FOR_DIRECT_SCANOUT))
     {
       ClutterColorState *output_color_state;
+      ClutterColorState *blending_color_state;
       ClutterColorState *surface_color_state;
 
       output_color_state =
         clutter_stage_view_get_output_color_state (CLUTTER_STAGE_VIEW (view));
+      blending_color_state =
+        clutter_stage_view_get_color_state (CLUTTER_STAGE_VIEW (view));
       surface_color_state =
         clutter_actor_get_color_state (CLUTTER_ACTOR (surface_actor));
-      if (clutter_color_pipeline_shader_needs_color_state (surface_color_state,
-                                                           output_color_state, 0))
+      if (meta_compositor_view_native_color_state_prevents_scanout (surface_color_state,
+                                                                    blending_color_state,
+                                                                    output_color_state))
         {
           meta_topic (META_DEBUG_RENDER,
                       "No direct scanout candidate: "
