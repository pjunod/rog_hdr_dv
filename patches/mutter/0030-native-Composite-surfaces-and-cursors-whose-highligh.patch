       g_signal_connect (G_OBJECT (view),
                         "notify::output-color-state",
-                        G_CALLBACK (on_output_color_state_changed),
+                        G_CALLBACK (on_view_color_state_changed),
+                        NULL);
+      /* The blending color state decides whether the cursor plane may be
