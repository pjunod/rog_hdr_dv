     {
@@ -401,11 +416,16 @@ meta_cursor_renderer_native_update_cursor (MetaCursorRenderer *cursor_renderer,
       MetaGpu *gpu = meta_crtc_get_gpu (crtc);
       ClutterColorState *target_color_state =
