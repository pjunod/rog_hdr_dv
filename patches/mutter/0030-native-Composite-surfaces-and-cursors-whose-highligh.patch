+      ClutterColorState *cursor_color_state =
+        cursor ? clutter_cursor_get_color_state (cursor) : NULL;
       CursorStageView *cursor_stage_view = NULL;
       gboolean has_hw_cursor = FALSE;
 
       cursor_stage_view = get_cursor_stage_view (view);
       g_assert (cursor_stage_view);
+      cursor_stage_view->needs_update = FALSE;
 
       if (!META_IS_CRTC_KMS (crtc) ||
           !is_hw_cursor_available_for_gpu (META_GPU_KMS (gpu)) ||
@@ -414,6 +434,16 @@ meta_cursor_renderer_native_update_cursor (MetaCursorRenderer *cursor_renderer,
           cursor_stage_view->is_hw_cursor_valid = TRUE;
           has_hw_cursor = FALSE;
         }
+      else if (cursor_color_state && blending_color_state &&
+               clutter_color_transform_requires_highlight_mapping (cursor_color_state,
+                                                                   blending_color_state))
+        {
+          /* Like direct scanout, the cursor plane bypasses the blending
+           * state, whose conversion would map the cursor's highlights
+           * toward the output's target: draw the cursor there instead. */
+          cursor_stage_view->is_hw_cursor_valid = FALSE;
+          has_hw_cursor = FALSE;
+        }
       else if (cursor && !meta_backend_is_hw_cursors_inhibited (backend))
         {
