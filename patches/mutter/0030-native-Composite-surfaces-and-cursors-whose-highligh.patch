+on_view_color_state_changed (MetaStageView *view,
+                             gpointer       user_data)
 {
   CursorStageView *cursor_stage_view;
 
@@ -149,6 +151,7 @@ on_output_color_state_changed (MetaStageView *view,
     return;
 
   cursor_stage_view->is_hw_cursor_valid = FALSE;
+  cursor_stage_view->needs_update = TRUE;
 }
 
