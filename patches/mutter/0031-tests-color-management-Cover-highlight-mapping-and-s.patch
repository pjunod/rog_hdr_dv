+static ClutterColorState *
+create_with_mastering (ClutterColorState *color_state,
+                       float              mastering_max,
+                       float              max_cll)
+{
+  ClutterColorTargetVolume target_volume = {
+    .has_luminance = mastering_max > 0.0f,
+    .min_lum = 0.0001f,
+    .max_lum = mastering_max,
+    .max_cll = max_cll,
+  };
+
+  return clutter_color_state_params_new_with_target_volume (CLUTTER_COLOR_STATE_PARAMS (color_state),
+                                                            &target_volume);
+}
+
+/* Whether the conversion to @blending changes bright content compared with
+ * the same conversion to @untargeted, the blending state without a target. */
+static gboolean
+renderer_maps_highlights (ClutterColorState *source,
+                          ClutterColorState *blending,
+                          ClutterColorState *untargeted)
+{
+  ClutterContext *context = clutter_color_state_get_context (source);
+  ClutterColorTransform *transform, *untargeted_transform;
+  float mapped[4] = { 1.0f, 1.0f, 1.0f, 1.0f };
+  float unmapped[4] = { 1.0f, 1.0f, 1.0f, 1.0f };
+
+  transform = clutter_color_transform_from_color_states (context, source,
+                                                         blending, 0);
+  untargeted_transform =
+    clutter_color_transform_from_color_states (context, source, untargeted, 0);
+  clutter_color_pipeline_do_transform (clutter_color_transform_get_pipeline (transform),
+                                       mapped, 1);
+  clutter_color_pipeline_do_transform (clutter_color_transform_get_pipeline (untargeted_transform),
+                                       unmapped, 1);
+
+  return mapped[0] != unmapped[0];
+}
+
+static void
+mapping_blending_target (void)
+{
+  MetaBackend *backend = meta_context_get_backend (test_context);
+  ClutterContext *context = meta_backend_get_clutter_context (backend);
+  MetaColorManager *manager = meta_backend_get_color_manager (backend);
+  MetaRenderer *renderer = meta_backend_get_renderer (backend);
+  MetaOutput *output = meta_virtual_monitor_get_output (virtual_monitor);
+  MetaOutputInfo *info = (MetaOutputInfo *) meta_output_get_info (output);
+  MetaColorDevice *device =
+    meta_color_manager_get_color_device (manager, meta_output_get_monitor (output));
+  ClutterStageView *view;
+  ClutterColorState *blending, *output_color_state;
+  g_autoptr (ClutterColorState) untargeted = NULL;
+  g_autoptr (ClutterColorState) pq = NULL;
+  g_autoptr (ClutterColorState) srgb = NULL;
+  ClutterColorState *sources[6];
+  const ClutterColorTargetVolume *target_volume;
+  const struct {
+    float factor;
+    float ref;
+  } factors[] = {
+    { 0.5f, 102.0f },
+    { 1.3f, 264.0f },
+  };
+  unsigned int i;
+
+  /* A synthetic native HDR panel declaring a 600 cd/m² peak. */
+  info->connector_type = META_CONNECTOR_TYPE_eDP;
+  info->supported_hdr_eotfs = 1 << META_OUTPUT_HDR_METADATA_EOTF_PQ;
+  info->supported_color_spaces = 1 << META_OUTPUT_COLORSPACE_BT2020;
+  g_clear_pointer (&info->edid_info, meta_edid_info_free);
+  info->edid_info = g_new0 (MetaEdidInfo, 1);
+  info->edid_info->native_rgb_bt2020_pq = TRUE;
+  info->edid_info->native_luminance_status = META_NATIVE_LUMINANCE_FIRMWARE_DECLARED;
+  info->edid_info->native_luminance = (struct di_displayid2_luminance) {
+    .has_min_luminance = TRUE,
+    .has_max_luminance_10pct = TRUE,
+    .min_luminance = 1049.0f / 2097152.0f,
+    .max_luminance_10pct = 600,
+  };
+  set_test_color_mode (output, META_COLOR_MODE_BT2100);
+  meta_color_device_update (device);
+  g_assert_cmpint (meta_color_device_get_target_luminance (device)->maximum_source,
+                   ==, META_COLOR_TARGET_FIRMWARE_DECLARED);
+
+  view = CLUTTER_STAGE_VIEW (meta_renderer_get_view_for_crtc (renderer,
+                                                              meta_output_get_assigned_crtc (output)));
+  g_assert_nonnull (view);
+
+  /* The output color state stays the encoding; the blending state carries
+   * the declared target, in the display's units. */
+  output_color_state = clutter_stage_view_get_output_color_state (view);
+  g_assert_true (output_color_state == meta_color_device_get_color_state (device));
+  target_volume =
+    clutter_color_state_params_get_target_volume (CLUTTER_COLOR_STATE_PARAMS (output_color_state));
+  g_assert_false (target_volume->has_luminance);
+
+  blending = clutter_stage_view_get_color_state (view);
+  target_volume =
+    clutter_color_state_params_get_target_volume (CLUTTER_COLOR_STATE_PARAMS (blending));
+  g_assert_true (target_volume->has_luminance);
+  g_assert_cmpfloat (target_volume->max_lum, ==, 600.0f);
+  g_assert_cmpfloat (target_volume->min_lum, ==, 1049.0f / 2097152.0f);
+
+  untargeted = clutter_color_state_get_blending (output_color_state, FALSE);
+  pq = clutter_color_state_params_new (context, CLUTTER_COLORSPACE_BT2020,
+                                       CLUTTER_TRANSFER_FUNCTION_PQ);
+  srgb = clutter_color_state_params_new (context, CLUTTER_COLORSPACE_SRGB,
+                                         CLUTTER_TRANSFER_FUNCTION_GAMMA22);
+
+  /* Content in the output's encoding: scanout is refused exactly when the
+   * renderer maps it. */
+  sources[0] = g_object_ref (pq);
+  sources[1] = create_with_mastering (pq, 4000.0f, 0.0f);
+  sources[2] = create_with_mastering (pq, 600.0f, 0.0f);
+  sources[3] = create_with_mastering (pq, 300.0f, 0.0f);
+  sources[4] = create_with_mastering (pq, 0.0f, 800.0f);
+  sources[5] = create_with_mastering (pq, 4000.0f, 500.0f);
+  for (i = 0; i < G_N_ELEMENTS (sources); i++)
+    {
+      gboolean mapped =
+        clutter_color_transform_requires_highlight_mapping (sources[i], blending);
+
+      g_assert_false (clutter_color_pipeline_shader_needs_color_state (sources[i],
+                                                                       output_color_state,
+                                                                       0));
+      g_assert_cmpint (meta_compositor_view_native_color_state_prevents_scanout (sources[i],
+                                                                                 blending,
+                                                                                 output_color_state),
+                       ==, mapped);
+      g_assert_cmpint (renderer_maps_highlights (sources[i], blending, untargeted),
+                       ==, mapped);
+      g_assert_cmpint (mapped, ==, i == 0 || i == 1 || i == 4);
+    }
+
+  /* A different encoding still prevents scanout without any mapping. */
+  g_assert_false (clutter_color_transform_requires_highlight_mapping (srgb, blending));
+  g_assert_true (meta_compositor_view_native_color_state_prevents_scanout (srgb,
+                                                                           blending,
+                                                                           output_color_state));
+
+  /* With a reference luminance factor, the output's reference white is in
+   * whole cd/m², as published, and the blending state's display reference is
+   * that same value: content declaring the published reference white and the
+   * declared peak is not mapped, and may be scanned out. */
+  for (i = 0; i < G_N_ELEMENTS (factors); i++)
+    {
+      g_autoptr (ClutterColorState) factor_untargeted = NULL;
+      g_autoptr (ClutterColorState) client_like = NULL;
+      g_autoptr (ClutterColorState) client_like_mastered = NULL;
+      g_autoptr (ClutterColorState) mastered = NULL;
+      const ClutterLuminance *output_lum;
+      gboolean mapped;
+
+      meta_color_device_set_reference_luminance_factor (device,
+                                                        factors[i].factor);
+      output_color_state = clutter_stage_view_get_output_color_state (view);
+      g_assert_true (output_color_state ==
+                     meta_color_device_get_color_state (device));
+      output_lum =
+        clutter_color_state_params_get_luminance (CLUTTER_COLOR_STATE_PARAMS (output_color_state));
+      g_assert_cmpfloat (output_lum->ref, ==,
+                         roundf (203.0f * factors[i].factor));
+      g_assert_cmpfloat (output_lum->ref, ==, factors[i].ref);
+      g_assert_cmpfloat (output_lum->ref, ==,
+                         (float) (uint32_t) output_lum->ref);
+
+      blending = clutter_stage_view_get_color_state (view);
+      target_volume =
+        clutter_color_state_params_get_target_volume (CLUTTER_COLOR_STATE_PARAMS (blending));
+      g_assert_true (target_volume->has_luminance);
+      g_assert_cmpfloat (target_volume->max_lum, ==, 600.0f);
+      factor_untargeted = clutter_color_state_get_blending (output_color_state,
+                                                            FALSE);
+
+      client_like =
+        clutter_color_state_params_new_full (context,
+                                             CLUTTER_COLORSPACE_BT2020,
+                                             CLUTTER_TRANSFER_FUNCTION_PQ,
+                                             NULL, -1.0f,
+                                             output_lum->min,
+                                             output_lum->max,
+                                             (float) (uint32_t) output_lum->ref,
+                                             0.0f);
+      client_like_mastered = create_with_mastering (client_like, 600.0f, 0.0f);
+      g_assert_false (clutter_color_transform_requires_highlight_mapping (client_like_mastered,
+                                                                          blending));
+      g_assert_false (meta_compositor_view_native_color_state_prevents_scanout (client_like_mastered,
+                                                                                blending,
+                                                                                output_color_state));
+      g_assert_false (renderer_maps_highlights (client_like_mastered, blending,
+                                                factor_untargeted));
+
+      /* Undeclared PQ content still reaches 10000 cd/m². */
+      g_assert_true (clutter_color_transform_requires_highlight_mapping (client_like,
+                                                                         blending));
+      g_assert_true (renderer_maps_highlights (client_like, blending,
+                                               factor_untargeted));
+      g_assert_true (clutter_color_transform_requires_highlight_mapping (pq,
+                                                                         blending));
+      g_assert_true (renderer_maps_highlights (pq, blending,
+                                               factor_untargeted));
+
+      /* Content mastered at the declared peak with the default reference
+       * white has more headroom than the panel only when the output's
+       * reference white is raised. */
+      mastered = create_with_mastering (pq, 600.0f, 0.0f);
+      mapped = clutter_color_transform_requires_highlight_mapping (mastered,
+                                                                   blending);
+      g_assert_cmpint (mapped, ==, factors[i].factor > 1.0f);
+      g_assert_cmpint (renderer_maps_highlights (mastered, blending,
+                                                 factor_untargeted),
+                       ==, mapped);
+      g_assert_true (meta_compositor_view_native_color_state_prevents_scanout (mastered,
+                                                                               blending,
+                                                                               output_color_state));
+    }
+
+  meta_color_device_set_reference_luminance_factor (device, 1.0f);
+  output_color_state = clutter_stage_view_get_output_color_state (view);
+  g_assert_cmpfloat (clutter_color_state_params_get_luminance (CLUTTER_COLOR_STATE_PARAMS (output_color_state))->ref,
+                     ==, 203.0f);
+
+  /* Without a declared peak there is no target and no mapping. */
+  info->edid_info->native_luminance_status = META_NATIVE_LUMINANCE_INVALID;
+  meta_color_device_update (device);
+  g_assert_cmpint (meta_color_device_get_target_luminance (device)->maximum_source,
+                   ==, META_COLOR_TARGET_ENCODING_FALLBACK);
+  blending = clutter_stage_view_get_color_state (view);
+  target_volume =
+    clutter_color_state_params_get_target_volume (CLUTTER_COLOR_STATE_PARAMS (blending));
+  g_assert_false (target_volume->has_luminance);
+  for (i = 0; i < G_N_ELEMENTS (sources); i++)
+    {
+      g_assert_false (clutter_color_transform_requires_highlight_mapping (sources[i],
+                                                                          blending));
+      g_assert_false (meta_compositor_view_native_color_state_prevents_scanout (sources[i],
+                                                                                blending,
+                                                                                output_color_state));
+      g_clear_object (&sources[i]);
+    }
+
+  set_test_color_mode (output, META_COLOR_MODE_DEFAULT);
+  meta_color_device_update (device);
+}
