+/* Whether the conversion of @color to @blending differs from the same
+ * conversion to @untargeted, the blending state without a target. */
+static gboolean
+renderer_changes_color (ClutterColorState *source,
+                        ClutterColorState *blending,
+                        ClutterColorState *untargeted,
+                        const float        color[3])
+{
+  ClutterContext *context = clutter_color_state_get_context (source);
+  ClutterColorTransform *transform, *untargeted_transform;
+  float mapped[4] = { color[0], color[1], color[2], 1.0f };
+  float unmapped[4] = { color[0], color[1], color[2], 1.0f };
+
+  transform = clutter_color_transform_from_color_states (context, source,
+                                                         blending, 0);
+  untargeted_transform =
+    clutter_color_transform_from_color_states (context, source, untargeted, 0);
+  clutter_color_pipeline_do_transform (clutter_color_transform_get_pipeline (transform),
+                                       mapped, 1);
+  clutter_color_pipeline_do_transform (clutter_color_transform_get_pipeline (untargeted_transform),
+                                       unmapped, 1);
+
+  return memcmp (mapped, unmapped, sizeof (mapped)) != 0;
+}
+
+static void
+mapping_target_gamut (void)
+{
+  MetaBackend *backend = meta_context_get_backend (test_context);
+  ClutterContext *context = meta_backend_get_clutter_context (backend);
+  MetaColorManager *manager = meta_backend_get_color_manager (backend);
+  MetaRenderer *renderer = meta_backend_get_renderer (backend);
+  MetaOutput *output = meta_virtual_monitor_get_output (virtual_monitor);
+  MetaOutputInfo *info = (MetaOutputInfo *) meta_output_get_info (output);
+  MetaColorDevice *device =
+    meta_color_manager_get_color_device (manager, meta_output_get_monitor (output));
+  const MetaColorTargetPrimaries *target_primaries;
+  const ClutterColorTargetVolume *target_volume;
+  ClutterStageView *view;
+  ClutterColorState *blending, *output_color_state;
+  g_autoptr (ClutterColorState) untargeted = NULL;
+  g_autoptr (ClutterColorState) pq = NULL;
+  g_autoptr (ClutterColorState) srgb = NULL;
+  g_autoptr (ClutterColorState) pq_mastered_srgb = NULL;
+  g_autoptr (ClutterColorState) pq_mastered_p3 = NULL;
+  g_autoptr (ClutterColorState) pq_mastered_beyond = NULL;
+  ClutterColorTargetVolume srgb_mastering = {
+    .has_primaries = TRUE,
+    .primaries = *clutter_colorspace_to_primaries (CLUTTER_COLORSPACE_SRGB),
+  };
+  /* DCI-P3 with a D65 white point, as content declares it. */
+  ClutterColorTargetVolume p3_mastering = {
+    .has_primaries = TRUE,
+    .primaries = {
+      .r_x = 0.680f, .r_y = 0.320f,
+      .g_x = 0.265f, .g_y = 0.690f,
+      .b_x = 0.150f, .b_y = 0.060f,
+      .w_x = 0.3127f, .w_y = 0.3290f,
+    },
+  };
+  ClutterColorTargetVolume beyond_mastering = p3_mastering;
+  /* Saturated BT.2020 green as a PQ signal: outside the panel gamut. */
+  const float bt2020_green[3] = { 0.1f, 0.75f, 0.1f };
+  const float neutral[3] = { 0.5f, 0.5f, 0.5f };
+  unsigned int i;
+
+  /*
+   * A synthetic native HDR panel declaring DCI-P3 with a D65 white point,
+   * rounded to DisplayID's 12-bit CIE 1931 coordinates, and no target peak,
+   * so that nothing is highlight mapped.
+   */
+  info->connector_type = META_CONNECTOR_TYPE_eDP;
+  info->supported_hdr_eotfs = 1 << META_OUTPUT_HDR_METADATA_EOTF_PQ;
+  info->supported_color_spaces = 1 << META_OUTPUT_COLORSPACE_BT2020;
+  g_clear_pointer (&info->edid_info, meta_edid_info_free);
+  info->edid_info = g_new0 (MetaEdidInfo, 1);
+  info->edid_info->native_rgb_bt2020_pq = TRUE;
+  info->edid_info->native_luminance_status = META_NATIVE_LUMINANCE_INVALID;
+  info->edid_info->native_chromaticities_status = META_NATIVE_CHROMATICITIES_FIRMWARE_DECLARED;
+  info->edid_info->native_chromaticities = (struct di_displayid2_native_chromaticities) {
+    .primaries = { { 2785, 1311, TRUE }, { 1085, 2826, TRUE }, { 614, 246, TRUE } },
+    .white_point = { 1281, 1348, TRUE },
+  };
+  set_test_color_mode (output, META_COLOR_MODE_BT2100);
+  meta_color_device_update (device);
+  target_primaries = meta_color_device_get_target_primaries (device);
+  g_assert_cmpint (target_primaries->source, ==, META_COLOR_TARGET_FIRMWARE_DECLARED);
+  g_assert_cmpint (meta_color_device_get_target_luminance (device)->maximum_source,
+                   ==, META_COLOR_TARGET_ENCODING_FALLBACK);
+
+  view = CLUTTER_STAGE_VIEW (meta_renderer_get_view_for_crtc (renderer,
+                                                              meta_output_get_assigned_crtc (output)));
+  g_assert_nonnull (view);
+
+  /* The blending state carries the published primaries, and no peak; the
+   * output color state stays the encoding. */
+  output_color_state = clutter_stage_view_get_output_color_state (view);
+  g_assert_true (output_color_state == meta_color_device_get_color_state (device));
+  blending = clutter_stage_view_get_color_state (view);
+  target_volume =
+    clutter_color_state_params_get_target_volume (CLUTTER_COLOR_STATE_PARAMS (blending));
+  g_assert_true (target_volume->has_primaries);
+  g_assert_false (target_volume->has_luminance);
+  g_assert_cmpfloat (target_volume->primaries.r_x, ==,
+                     (float) (target_primaries->coordinates[0] / 1000000.0));
+  g_assert_cmpfloat (target_volume->primaries.r_y, ==,
+                     (float) (target_primaries->coordinates[1] / 1000000.0));
+  g_assert_cmpfloat (target_volume->primaries.g_x, ==,
+                     (float) (target_primaries->coordinates[2] / 1000000.0));
+  g_assert_cmpfloat (target_volume->primaries.g_y, ==,
+                     (float) (target_primaries->coordinates[3] / 1000000.0));
+  g_assert_cmpfloat (target_volume->primaries.b_x, ==,
+                     (float) (target_primaries->coordinates[4] / 1000000.0));
+  g_assert_cmpfloat (target_volume->primaries.b_y, ==,
+                     (float) (target_primaries->coordinates[5] / 1000000.0));
+  g_assert_cmpfloat (target_volume->primaries.w_x, ==,
+                     (float) (target_primaries->coordinates[6] / 1000000.0));
+  g_assert_cmpfloat (target_volume->primaries.w_y, ==,
+                     (float) (target_primaries->coordinates[7] / 1000000.0));
+  /* With the resolution of the declaration. */
+  for (i = 0; i < 3; i++)
+    {
+      g_assert_cmpfloat (target_primaries->tolerance[i], >, 0.0f);
+      g_assert_cmpfloat (target_volume->primaries_tolerance[i], ==,
+                         target_primaries->tolerance[i]);
+    }
+
+  untargeted = clutter_color_state_get_blending (output_color_state, FALSE);
+  pq = clutter_color_state_params_new (context, CLUTTER_COLORSPACE_BT2020,
+                                       CLUTTER_TRANSFER_FUNCTION_PQ);
+  srgb = clutter_color_state_params_new (context, CLUTTER_COLORSPACE_SRGB,
+                                         CLUTTER_TRANSFER_FUNCTION_GAMMA22);
+  pq_mastered_srgb =
+    clutter_color_state_params_new_with_target_volume (CLUTTER_COLOR_STATE_PARAMS (pq),
+                                                       &srgb_mastering);
+  pq_mastered_p3 =
+    clutter_color_state_params_new_with_target_volume (CLUTTER_COLOR_STATE_PARAMS (pq),
+                                                       &p3_mastering);
+  /* P3 with its red primary 1% further from white: far more than one
+   * declaration step outside the declared gamut. */
+  beyond_mastering.primaries.r_x = 0.3127f + 1.01f * (0.680f - 0.3127f);
+  beyond_mastering.primaries.r_y = 0.3290f + 1.01f * (0.320f - 0.3290f);
+  pq_mastered_beyond =
+    clutter_color_state_params_new_with_target_volume (CLUTTER_COLOR_STATE_PARAMS (pq),
+                                                       &beyond_mastering);
+
+  /* BT.2020 PQ, the output's own encoding: its gamut exceeds the panel's, so
+   * it is compressed and scanout is refused, by the same predicate. */
+  g_assert_false (clutter_color_pipeline_shader_needs_color_state (pq,
+                                                                   output_color_state,
+                                                                   0));
+  g_assert_false (clutter_color_transform_requires_highlight_mapping (pq, blending));
+  g_assert_true (clutter_color_transform_requires_gamut_compression (pq, blending));
+  g_assert_true (clutter_color_transform_requires_mapping (pq, blending));
+  g_assert_true (meta_compositor_view_native_color_state_prevents_scanout (pq,
+                                                                           blending,
+                                                                           output_color_state));
+  g_assert_true (renderer_changes_color (pq, blending, untargeted, bt2020_green));
+
+  /* P3 content on the panel declaring P3: its primaries lie a fraction of a
+   * declaration step outside the quantized triangle, within the tolerance
+   * the device carries with the declaration, so it is not compressed and is
+   * scanned out. */
+  g_assert_false (clutter_color_transform_requires_mapping (pq_mastered_p3, blending));
+  g_assert_false (meta_compositor_view_native_color_state_prevents_scanout (pq_mastered_p3,
+                                                                            blending,
+                                                                            output_color_state));
+  g_assert_false (renderer_changes_color (pq_mastered_p3, blending, untargeted,
+                                          bt2020_green));
+
+  /* A mastering primary clearly outside still compresses. */
+  g_assert_true (clutter_color_transform_requires_gamut_compression (pq_mastered_beyond,
+                                                                     blending));
+  g_assert_true (meta_compositor_view_native_color_state_prevents_scanout (pq_mastered_beyond,
+                                                                           blending,
+                                                                           output_color_state));
+
+  /* The same encoding mastered in sRGB lies within the panel gamut: not
+   * compressed, and scanned out. */
+  g_assert_false (clutter_color_pipeline_shader_needs_color_state (pq_mastered_srgb,
+                                                                   output_color_state,
+                                                                   0));
+  g_assert_false (clutter_color_transform_requires_mapping (pq_mastered_srgb, blending));
+  g_assert_false (meta_compositor_view_native_color_state_prevents_scanout (pq_mastered_srgb,
+                                                                            blending,
+                                                                            output_color_state));
+  g_assert_false (renderer_changes_color (pq_mastered_srgb, blending, untargeted,
+                                          bt2020_green));
+
+  /* An sRGB surface is never compressed; it is composited only because its
+   * encoding differs. */
+  g_assert_false (clutter_color_transform_requires_mapping (srgb, blending));
+  g_assert_false (renderer_changes_color (srgb, blending, untargeted, neutral));
+  g_assert_false (renderer_changes_color (srgb, blending, untargeted,
+                                          (const float[3]) { 1.0f, 0.0f, 0.0f }));
+
+  /* Without declared primaries the target primaries are the encoding
+   * fallback, which is not a physical gamut: nothing is compressed. */
+  info->edid_info->native_chromaticities_status = META_NATIVE_CHROMATICITIES_INVALID;
+  meta_color_device_update (device);
+  g_assert_cmpint (meta_color_device_get_target_primaries (device)->source,
+                   ==, META_COLOR_TARGET_ENCODING_FALLBACK);
+  blending = clutter_stage_view_get_color_state (view);
+  target_volume =
+    clutter_color_state_params_get_target_volume (CLUTTER_COLOR_STATE_PARAMS (blending));
+  g_assert_false (target_volume->has_primaries);
+  g_assert_false (clutter_color_transform_requires_mapping (pq, blending));
+  g_assert_false (meta_compositor_view_native_color_state_prevents_scanout (pq,
+                                                                            blending,
+                                                                            output_color_state));
+  g_assert_false (renderer_changes_color (pq, blending, untargeted, bt2020_green));
+
+  set_test_color_mode (output, META_COLOR_MODE_DEFAULT);
+  meta_color_device_update (device);
+}
