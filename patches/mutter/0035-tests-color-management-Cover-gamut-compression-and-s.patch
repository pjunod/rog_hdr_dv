+/*
+ * The limits come from the mastering primaries when they are declared, and
+ * compression needs both the encoding and the mastering gamut to exceed the
+ * target.
+ */
+static void
+gamut_source_gamut (void)
+{
+  ClutterContext *context = clutter_test_get_context ();
+  const float step = 1.0f / 4096.0f;
+  const float step_tolerance[3] = { step, step, step };
+  g_autoptr (ClutterColorState) output = create_pq_output (203.0f);
+  g_autoptr (ClutterColorState) srgb_blending = NULL;
+  g_autoptr (ClutterColorState) blending = NULL;
+  g_autoptr (ClutterColorState) pq = NULL;
+  g_autoptr (ClutterColorState) srgb = NULL;
+  g_autoptr (ClutterColorState) pq_mastered_p3 = NULL;
+  g_autoptr (ClutterColorState) srgb_mastered_bt2020 = NULL;
+  const float samples[][3] = {
+    { 1.0f, -0.2f, 0.5f },
+    { 0.2f, 1.0f, -0.1f },
+    { -0.05f, 0.3f, 1.0f },
+    { 1.0f, 0.1f, 0.9f },
+  };
+  double p3_vertices[3][3], bt2020_vertices[3][3];
+  double p3_limits[3], bt2020_limits[3];
+  gboolean differs = FALSE;
+  ClutterColorOp *op;
+  int i, c;
+
+  /* A panel declaring sRGB, which excludes part of P3. */
+  srgb_blending = create_gamut_blending_full (output, &srgb_gamut, step,
+                                              FALSE, FALSE);
+  blending = create_gamut_blending (output, &target_gamut, FALSE, FALSE);
+  pq = clutter_color_state_params_new (context, CLUTTER_COLORSPACE_BT2020,
+                                       CLUTTER_TRANSFER_FUNCTION_PQ);
+  srgb = clutter_color_state_params_new (context, CLUTTER_COLORSPACE_SRGB,
+                                         CLUTTER_TRANSFER_FUNCTION_GAMMA22);
+  pq_mastered_p3 = create_with_mastering_primaries (pq, &p3_gamut);
+  srgb_mastered_bt2020 = create_with_mastering_primaries (srgb, &bt2020_gamut);
+
+  /* sRGB encoded content cannot leave sRGB, whatever it was mastered on. */
+  g_assert_false (clutter_color_transform_requires_gamut_compression (srgb_mastered_bt2020,
+                                                                      srgb_blending));
+  g_assert_false (clutter_color_transform_requires_gamut_compression (srgb_mastered_bt2020,
+                                                                      blending));
+
+  /* BT.2020 content mastered on P3, on the sRGB panel: compressed, with the
+   * limits of P3, not of BT.2020. */
+  g_assert_true (clutter_color_transform_requires_gamut_compression (pq_mastered_p3,
+                                                                     srgb_blending));
+  reference_mastering_vertices (&p3_gamut, &bt2020_gamut, p3_vertices);
+  reference_encoding_vertices (&bt2020_gamut, bt2020_vertices);
+  reference_limits (p3_vertices, &srgb_gamut, step_tolerance, p3_limits);
+  reference_limits (bt2020_vertices, &srgb_gamut, step_tolerance, bt2020_limits);
+  op = get_gamut_op (pq_mastered_p3, srgb_blending);
+
+  for (i = 0; i < G_N_ELEMENTS (samples); i++)
+    {
+      float data[4] = { samples[i][0], samples[i][1], samples[i][2], 1.0f };
+      double rgb[3] = { samples[i][0], samples[i][1], samples[i][2] };
+      double expected[3], bt2020_expected[3];
+
+      clutter_color_op_do_transform (op, data, 1);
+      reference_compress (rgb, p3_limits, expected);
+      reference_compress (rgb, bt2020_limits, bt2020_expected);
+
+      for (c = 0; c < 3; c++)
+        {
+          g_assert_cmpfloat_with_epsilon (data[c], expected[c], 1e-4);
+          if (fabs (data[c] - bt2020_expected[c]) > 1e-3)
+            differs = TRUE;
+        }
+    }
+  g_assert_true (differs);
+}
+
+/*
+ * A target declared through DisplayID's 12-bit chromaticities, with the
+ * declaration's step as its tolerance: content in the declared gamut is
+ * not compressed, though its primaries lie a fraction of a step outside the
+ * quantized triangle; a primary more than a step outside still is, and
+ * boundary points within the tolerance set no limit.
+ */
+static void
+gamut_tolerance (void)
+{
+  ClutterContext *context = clutter_test_get_context ();
+  g_autoptr (ClutterColorState) output = create_pq_output (203.0f);
+  g_autoptr (ClutterColorState) blending = NULL;
+  g_autoptr (ClutterColorState) exact_blending = NULL;
+  g_autoptr (ClutterColorState) pq = NULL;
+  g_autoptr (ClutterColorState) pq_mastered_p3 = NULL;
+  g_autoptr (ClutterColorState) pq_mastered_beyond = NULL;
+  const double step = 1.0 / 4096.0;
+  const float step_tolerance[3] = { (float) step, (float) step, (float) step };
+  const double declared[3][2] = {
+    { p3_gamut.r_x, p3_gamut.r_y },
+    { p3_gamut.g_x, p3_gamut.g_y },
+    { p3_gamut.b_x, p3_gamut.b_y },
+  };
+  ClutterPrimaries quantized = p3_gamut;
+  ClutterPrimaries beyond = p3_gamut;
+  float *quantized_xy[3][2] = {
+    { &quantized.r_x, &quantized.r_y },
+    { &quantized.g_x, &quantized.g_y },
+    { &quantized.b_x, &quantized.b_y },
+  };
+  double edge[2], normal[2], length, vertices[3][3], limits[3], all_limits[3];
+  ClutterColorOp *op;
+  int i, j;
+
+  /* 12-bit codes, published in units of 1/1000000 by truncation. */
+  for (i = 0; i < 3; i++)
+    {
+      for (j = 0; j < 2; j++)
+        {
+          int64_t code = (int64_t) round (declared[i][j] * 4096.0);
+
+          *quantized_xy[i][j] = (float) ((code * 1000000 / 4096) / 1000000.0);
+        }
+    }
+
+  for (i = 0; i < 3; i++)
+    {
+      double outside = reference_outside_distance (&quantized, declared[i][0],
+                                                   declared[i][1]);
+
+      g_assert_cmpfloat (outside, >, 0.0);
+      g_assert_cmpfloat (outside, <, step);
+    }
+
+  blending = create_gamut_blending_full (output, &quantized, (float) step,
+                                         FALSE, FALSE);
+  exact_blending = create_gamut_blending (output, &quantized, FALSE, FALSE);
+  pq = clutter_color_state_params_new (context, CLUTTER_COLORSPACE_BT2020,
+                                       CLUTTER_TRANSFER_FUNCTION_PQ);
+  pq_mastered_p3 = create_with_mastering_primaries (pq, &p3_gamut);
+
+  /* Within the tolerance: not compressed; an exact test would compress. */
+  g_assert_false (clutter_color_transform_requires_gamut_compression (pq_mastered_p3,
+                                                                      blending));
+  g_assert_true (clutter_color_transform_requires_gamut_compression (pq_mastered_p3,
+                                                                     exact_blending));
+  g_assert_true (clutter_color_transform_requires_gamut_compression (pq, blending));
+
+  /* P3 with its red primary moved five steps outside the quantized
+   * red-blue side only. */
+  edge[0] = quantized.r_x - quantized.b_x;
+  edge[1] = quantized.r_y - quantized.b_y;
+  length = hypot (edge[0], edge[1]);
+  normal[0] = edge[1] / length;
+  normal[1] = -edge[0] / length;
+  if (normal[0] * (quantized.g_x - quantized.b_x) +
+      normal[1] * (quantized.g_y - quantized.b_y) > 0.0)
+    {
+      normal[0] = -normal[0];
+      normal[1] = -normal[1];
+    }
+  beyond.r_x = (float) (p3_gamut.r_x + 5.0 * step * normal[0]);
+  beyond.r_y = (float) (p3_gamut.r_y + 5.0 * step * normal[1]);
+  g_assert_cmpfloat (reference_outside_distance (&quantized, beyond.r_x,
+                                                 beyond.r_y), >, 4.0 * step);
+  pq_mastered_beyond = create_with_mastering_primaries (pq, &beyond);
+  g_assert_true (clutter_color_transform_requires_gamut_compression (pq_mastered_beyond,
+                                                                     blending));
+
+  /* Only points outside the tolerance set limits. P3's green, a fraction of
+   * a step outside, reaches a blue distance above 1 that no point beyond the
+   * tolerance does: blue has no limit and is never rewritten. */
+  reference_mastering_vertices (&beyond, &bt2020_gamut, vertices);
+  reference_limits (vertices, &quantized, step_tolerance, limits);
+  reference_limits (vertices, &quantized, exact_tolerance, all_limits);
+  g_assert_cmpfloat (limits[1], >, 1.0);
+  g_assert_cmpfloat (limits[2], <=, 1.0);
+  g_assert_cmpfloat (all_limits[2], >, 1.0);
+
+  op = get_gamut_op (pq_mastered_beyond, blending);
+  {
+    const float samples[][4] = {
+      { 1.0f, 1.0f, 0.1f, 1.0f },
+      { 1.0f, 0.5f, -0.2f, 1.0f },
+      { 0.3f, 1.0f, 0.05f, 1.0f },
+      /* Green beyond the threshold: compressed. */
+      { 1.0f, 0.1f, 1.0f, 1.0f },
+    };
+
+    for (i = 0; i < G_N_ELEMENTS (samples); i++)
+      {
+        float data[4];
+        double rgb[3] = { samples[i][0], samples[i][1], samples[i][2] };
+        double expected[3];
+
+        memcpy (data, samples[i], sizeof (data));
+        clutter_color_op_do_transform (op, data, 1);
+        reference_compress (rgb, limits, expected);
+
+        g_assert_cmpmem (&data[2], sizeof (float), &samples[i][2],
+                         sizeof (float));
+        for (j = 0; j < 3; j++)
+          g_assert_cmpfloat_with_epsilon (data[j], expected[j], 1e-4);
+      }
+  }
+}
