+/* The CIE 1931 xy of DisplayID 2 CIE 1976 coordinates, in code units. */
+static void
+uv_code_to_xy (double  a,
+               double  b,
+               double *x,
+               double *y)
+{
+  double u = a / 4096.0, v = b / 4096.0, d = 6.0 * u - 16.0 * v + 12.0;
+
+  *x = 9.0 * u / d;
+  *y = 4.0 * v / d;
+}
+
+/*
+ * The declared target primaries carry the resolution of their declaration,
+ * per primary: one 12-bit step for CIE 1931 coordinates, and for CIE 1976
+ * coordinates a bound on how far half a code step in any direction moves
+ * that primary in xy, with the margin the derivation claims.
+ */
+static void
+test_target_primaries_tolerance (void)
+{
+  const uint16_t xy[4][2] = {
+    { 2816, 1280 }, { 1024, 2816 }, { 512, 256 }, { 1280, 1344 },
+  };
+  const uint16_t uv[4][2] = {
+    { 1024, 2304 }, { 512, 2304 }, { 719, 647 }, { 810, 1918 },
+  };
+  MetaEdidInfo edid = { .native_chromaticities_status = META_NATIVE_CHROMATICITIES_FIRMWARE_DECLARED };
+  const ClutterPrimaries *encoding = clutter_colorspace_to_primaries (CLUTTER_COLORSPACE_BT2020);
+  MetaColorTargetPrimaries target, fallback;
+  unsigned int i;
+  int du, dv;
+
+  set_raw_points (&edid, xy);
+  meta_color_target_primaries_init (&target, &edid, TRUE, encoding);
+  g_assert_cmpint (target.source, ==, META_COLOR_TARGET_FIRMWARE_DECLARED);
+  for (i = 0; i < 3; i++)
+    g_assert_cmpfloat (target.tolerance[i], ==, (float) (1.0 / 4096.0));
+
+  meta_color_target_primaries_init (&fallback, &edid, FALSE, encoding);
+  g_assert_cmpint (fallback.source, ==, META_COLOR_TARGET_ENCODING_FALLBACK);
+  for (i = 0; i < 3; i++)
+    g_assert_cmpfloat (fallback.tolerance[i], ==, 0.0f);
+
+  /* Per primary: here they differ. */
+  edid.native_chromaticities.coordinates = DI_DISPLAYID2_CHROMATICITY_CIE1976;
+  set_raw_points (&edid, uv);
+  meta_color_target_primaries_init (&target, &edid, TRUE, encoding);
+  g_assert_cmpint (target.source, ==, META_COLOR_TARGET_FIRMWARE_DECLARED);
+  g_assert_cmpfloat (target.tolerance[0], !=, target.tolerance[2]);
+
+  for (i = 0; i < 3; i++)
+    {
+      double x0, y0;
+
+      g_assert_cmpfloat (target.tolerance[i], <, 8.0 / 4096.0);
+
+      uv_code_to_xy (uv[i][0], uv[i][1], &x0, &y0);
+      for (du = -1; du <= 1; du++)
+        {
+          for (dv = -1; dv <= 1; dv++)
+            {
+              double x, y;
+
+              uv_code_to_xy (uv[i][0] + du * 0.5, uv[i][1] + dv * 0.5, &x, &y);
+              g_assert_cmpfloat (hypot (x - x0, y - y0) * G_SQRT2, <=,
+                                 target.tolerance[i]);
+            }
+        }
+    }
+}
+
