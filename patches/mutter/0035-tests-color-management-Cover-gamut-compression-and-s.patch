+/*
+ * Non-finite and huge input: a sample whose achromatic value is not finite
+ * is unchanged, finite channels never become NaN, and huge distances
+ * approach the curve's asymptote without overflowing.
+ */
+static void
+gamut_non_finite (void)
+{
+  ClutterContext *context = clutter_test_get_context ();
+  g_autoptr (ClutterColorState) output = create_pq_output (203.0f);
+  g_autoptr (ClutterColorState) blending = NULL;
+  g_autoptr (ClutterColorState) pq = NULL;
+  const float unchanged[][4] = {
+    { INFINITY, 1.0f, 1.0f, 1.0f },
+    { INFINITY, -INFINITY, 0.0f, 1.0f },
+    { -INFINITY, -INFINITY, -INFINITY, 1.0f },
+  };
+  const float finite[][4] = {
+    { 1.0f, -1e30f, 1.0f, 1.0f },
+    { 1.0f, -INFINITY, 1.0f, 1.0f },
+    { 1e30f, -1e30f, 0.0f, 1.0f },
+    { 1e-30f, -1e-30f, 1e-30f, 1.0f },
+    { 1.0f, 0.8f - FLT_EPSILON, 1.0f, 1.0f },
+  };
+  float data[G_N_ELEMENTS (unchanged)][4];
+  ClutterColorOp *op;
+  int i, c;
+
+  blending = create_gamut_blending (output, &target_gamut, FALSE, FALSE);
+  pq = clutter_color_state_params_new (context, CLUTTER_COLORSPACE_BT2020,
+                                       CLUTTER_TRANSFER_FUNCTION_PQ);
+  op = get_gamut_op (pq, blending);
+
+  memcpy (data, unchanged, sizeof (data));
+  clutter_color_op_do_transform (op, &data[0][0], G_N_ELEMENTS (unchanged));
+  g_assert_cmpmem (data, sizeof (data), unchanged, sizeof (unchanged));
+
+  for (i = 0; i < G_N_ELEMENTS (finite); i++)
+    {
+      float out[4];
+
+      memcpy (out, finite[i], sizeof (out));
+      clutter_color_op_do_transform (op, out, 1);
+      for (c = 0; c < 3; c++)
+        g_assert_false (isnan (out[c]));
+      /* The compressed distance stays below the asymptote t + s, which is
+       * finite: the channel stays finite and above -ach (t + s). */
+      g_assert_true (isfinite (out[1]) || finite[i][0] > 1e29f);
+    }
+}
