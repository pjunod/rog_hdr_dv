+/* The op against the ACES formula, with limits found independently. */
+static void
+gamut_reference (void)
+{
+  ClutterContext *context = clutter_test_get_context ();
+  g_autoptr (ClutterColorState) output = create_pq_output (203.0f);
+  g_autoptr (ClutterColorState) blending = NULL;
+  g_autoptr (ClutterColorState) pq = NULL;
+  const float samples[][3] = {
+    { 1.0f, -0.2f, 0.5f },
+    { 0.2f, 1.0f, -0.1f },
+    { -0.05f, 0.3f, 1.0f },
+    { 1.0f, 0.15f, 0.9f },
+    { 50.0f, -5.0f, 20.0f },
+    { 0.01f, 0.0005f, -0.004f },
+    { 1.0f, -3.0f, -3.0f },
+  };
+  double vertices[3][3], limits[3];
+  ClutterColorOp *op;
+  int i, c;
+
+  blending = create_gamut_blending (output, &target_gamut, FALSE, FALSE);
+  pq = clutter_color_state_params_new (context, CLUTTER_COLORSPACE_BT2020,
+                                       CLUTTER_TRANSFER_FUNCTION_PQ);
+  op = get_gamut_op (pq, blending);
+  reference_encoding_vertices (&bt2020_gamut, vertices);
+  reference_limits (vertices, &target_gamut, exact_tolerance, limits);
+
+  for (i = 0; i < G_N_ELEMENTS (samples); i++)
+    {
+      float data[4] = { samples[i][0], samples[i][1], samples[i][2], 1.0f };
+      double rgb[3] = { samples[i][0], samples[i][1], samples[i][2] };
+      double expected[3];
+      double ach = MAX (rgb[0], MAX (rgb[1], rgb[2]));
+
+      clutter_color_op_do_transform (op, data, 1);
+      reference_compress (rgb, limits, expected);
+
+      for (c = 0; c < 3; c++)
+        g_assert_cmpfloat_with_epsilon (data[c], expected[c], 1e-4 * ach);
+    }
+
+  /* A distance equal to a channel's limit lands on the boundary. */
+  for (c = 0; c < 3; c++)
+    {
+      float data[4] = { 1.0f, 1.0f, 1.0f, 1.0f };
+
+      data[c] = (float) (1.0 - limits[c]);
+      clutter_color_op_do_transform (op, data, 1);
+      g_assert_cmpfloat_with_epsilon (data[c], 0.0f, 1e-4f);
+    }
+}
+
+/* Compressed distances increase with the input distance, never exceed it,
+ * and equal it up to the threshold. */
+static void
+gamut_monotonic (void)
+{
+  ClutterContext *context = clutter_test_get_context ();
+  g_autoptr (ClutterColorState) output = create_pq_output (203.0f);
+  g_autoptr (ClutterColorState) blending = NULL;
+  g_autoptr (ClutterColorState) pq = NULL;
+  ClutterColorOp *op;
+  int c, i;
+
+  blending = create_gamut_blending (output, &target_gamut, FALSE, FALSE);
+  pq = clutter_color_state_params_new (context, CLUTTER_COLORSPACE_BT2020,
+                                       CLUTTER_TRANSFER_FUNCTION_PQ);
+  op = get_gamut_op (pq, blending);
+
+  for (c = 0; c < 3; c++)
+    {
+      double previous = -1.0;
+
+      for (i = 0; i <= 4000; i++)
+        {
+          float distance = i / 1000.0f;
+          float data[4] = { 1.0f, 1.0f, 1.0f, 1.0f };
+          double compressed;
+
+          data[c] = 1.0f - distance;
+          clutter_color_op_do_transform (op, data, 1);
+          compressed = 1.0 - data[c];
+
+          g_assert_cmpfloat (compressed, >=, previous);
+          g_assert_cmpfloat (compressed, <=, distance + 1e-6);
+          if (distance <= REF_GAMUT_THRESHOLD)
+            g_assert_cmpfloat (data[c], ==, 1.0f - distance);
+          previous = compressed;
+        }
+    }
+}
