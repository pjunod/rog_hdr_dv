 /*
  * clutter_color_state_params_get_peak_headroom:
  * @min_headroom: (out) (optional): the lowest luminance of the range
@@ -142,14 +193,15 @@ clutter_color_state_params_is_encoding_bounded (ClutterColorStateParams *color_s
  * The range of the content as multiples of its reference white luminance,
  * which every conversion anchors. The effective peak is the smallest of the
  * declared maximum content light level, the declared target (mastering)
- * maximum luminance and, for an encoding whose signal range bounds it, the
- * encoding's own maximum. MaxFALL, an average, never lowers it. Target
+ * maximum luminance and, for an encoding whose nominal maximum describes the
+ * content's peak (see clutter_color_state_params_nominal_max_is_content_peak()),
+ * the encoding's own maximum. MaxFALL, an average, never lowers it. Target
  * volume values are divided by the display reference luminance, the
  * encoding's by the state's reference luminance; for a state whose
  * luminances are absolute the two are the same.
  *
- * Returns: %FALSE if the effective peak is unknown: an extended-range
- *   encoding with neither MaxCLL nor a target maximum declared.
+ * Returns: %FALSE if the effective peak is unknown: a PQ or extended-range
+ *   linear encoding with neither MaxCLL nor a target maximum declared.
  */
 gboolean
 clutter_color_state_params_get_peak_headroom (ClutterColorStateParams *color_state_params,
@@ -169,8 +221,9 @@ clutter_color_state_params_get_peak_headroom (ClutterColorStateParams *color_sta
   display_ref =
     clutter_color_state_params_get_display_reference_luminance (color_state_params);
 
-  /* Extended range states can exceed their nominal maximum. */
-  if (clutter_color_state_params_is_encoding_bounded (color_state_params))
+  /* PQ's maximum is the encoding's capacity, and extended range states can
+   * exceed their nominal maximum. */
+  if (clutter_color_state_params_nominal_max_is_content_peak (color_state_params))
     peak = (double) MAX (lum->max, lum->mastering_max) / lum->ref;
   if (target_volume->has_luminance)
     peak = MIN (peak, target_volume->max_lum / display_ref);
