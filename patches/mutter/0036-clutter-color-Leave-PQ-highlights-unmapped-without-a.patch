            eotf->tf_name == CLUTTER_TRANSFER_FUNCTION_LINEAR);
 }
 
+/*
+ * Whether the encoding's nominal maximum luminance describes the content's
+ * peak: the most light the content can reach, as opposed to only the most
+ * the encoding can carry. The signal range is a separate question, see
+ * clutter_color_state_params_is_signal_range_bounded().
+ *
+ * It does for SDR transfer functions, whose maximum is reference white, and
+ * for HLG, whose nominal maximum is the peak of the display the signal is
+ * rendered for. It does not for PQ, whose 10000 cd/m² is the capacity of the
+ * absolute encoding, nor for extended-range linear encodings, which exceed
+ * their nominal maximum: their content's peak is known only from MaxCLL or
+ * a mastering maximum.
+ */
+gboolean
+clutter_color_state_params_nominal_max_is_content_peak (ClutterColorStateParams *color_state_params)
+{
+  const ClutterEOTF *eotf = &color_state_params->eotf;
+
+  switch (eotf->type)
+    {
+    case CLUTTER_EOTF_TYPE_GAMMA:
+      return TRUE;
+    case CLUTTER_EOTF_TYPE_NAMED:
+      switch (eotf->tf_name)
+        {
+        case CLUTTER_TRANSFER_FUNCTION_SRGB_PIECEWISE:
+        case CLUTTER_TRANSFER_FUNCTION_BT1886:
+        case CLUTTER_TRANSFER_FUNCTION_GAMMA22:
+        case CLUTTER_TRANSFER_FUNCTION_HLG:
+          return TRUE;
+        case CLUTTER_TRANSFER_FUNCTION_PQ:
+        case CLUTTER_TRANSFER_FUNCTION_LINEAR:
+          return FALSE;
+        }
+      break;
+    }
+
+  g_assert_not_reached ();
+}
