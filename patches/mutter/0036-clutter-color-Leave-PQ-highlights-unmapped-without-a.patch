+/*
+ * PQ without declarations: the encoding's 10000 cd/m² is its capacity, not
+ * the content's peak, so the peak is unknown and nothing is mapped. The
+ * conversion is the one without a target, so reference white keeps its
+ * anchoring, and direct scanout is not refused on mapping grounds. With a
+ * declared MaxCLL the peak is known and compared as for any content. HLG's
+ * nominal maximum is a display peak: at the 1000 cd/m² default it exceeds a
+ * 616 cd/m² target.
+ */
+static void
+mapping_undeclared_pq_peak (void)
+{
+  ClutterContext *context = clutter_test_get_context ();
+  g_autoptr (ClutterColorState) output = create_pq_output (203.0f);
+  g_autoptr (ClutterColorState) blending = NULL;
+  g_autoptr (ClutterColorState) target_616 = NULL;
+  g_autoptr (ClutterColorState) untargeted = NULL;
+  g_autoptr (ClutterColorState) untargeted_gamma = NULL;
+  g_autoptr (ClutterColorState) pq = NULL;
+  g_autoptr (ClutterColorState) pq_cll_above = NULL;
+  g_autoptr (ClutterColorState) pq_cll_below = NULL;
+  g_autoptr (ClutterColorState) hlg = NULL;
+  g_autoptr (ClutterColorState) linear = NULL;
+  const float reference_white[3] = {
+    (float) reference_pq_signal (203.0),
+    (float) reference_pq_signal (203.0),
+    (float) reference_pq_signal (203.0),
+  };
+  double min_headroom, peak_headroom;
+  float output_color[4];
+
+  blending = create_targeted_blending (output, TARGET_MAX_LUM, FALSE);
+  target_616 = create_targeted_blending (output, 616.0f, FALSE);
+  untargeted = clutter_color_state_get_blending (output, TRUE);
+  untargeted_gamma = clutter_color_state_get_blending (output, FALSE);
+  pq = clutter_color_state_params_new (context, CLUTTER_COLORSPACE_BT2020,
+                                       CLUTTER_TRANSFER_FUNCTION_PQ);
+  pq_cll_above = create_with_target_volume (pq, 0.0f, 1000.0f);
+  pq_cll_below = create_with_target_volume (pq, 0.0f, 400.0f);
+  hlg = clutter_color_state_params_new (context, CLUTTER_COLORSPACE_BT2020,
+                                        CLUTTER_TRANSFER_FUNCTION_HLG);
+
+  /* Plain PQ, at the protocol defaults. */
+  g_assert_false (clutter_color_state_params_get_peak_headroom (CLUTTER_COLOR_STATE_PARAMS (pq),
+                                                                &min_headroom,
+                                                                &peak_headroom));
+  g_assert_false (clutter_color_state_params_nominal_max_is_content_peak (CLUTTER_COLOR_STATE_PARAMS (pq)));
+  /* The encoding still bounds the signal, for gamut compression. */
+  g_assert_true (clutter_color_state_params_is_signal_range_bounded (CLUTTER_COLOR_STATE_PARAMS (pq)));
+  g_assert_false (clutter_color_transform_requires_highlight_mapping (pq, blending));
+  g_assert_false (clutter_color_transform_requires_highlight_mapping (pq, target_616));
+  g_assert_false (clutter_color_transform_requires_mapping (pq, blending));
+  g_assert_false (clutter_color_transform_requires_mapping (pq, target_616));
+  assert_pipelines_equal (pq, blending, untargeted_gamma);
+
+  /* Reference white is anchored: PQ 203 cd/m² stays 203 cd/m² on the
+   * display, linear blending keeping the output's units. */
+  {
+    g_autoptr (ClutterColorState) linear_blending =
+      create_targeted_blending (output, TARGET_MAX_LUM, TRUE);
+    const ClutterLuminance *lum = clutter_color_state_get_luminance (linear_blending);
+
+    transform_one (pq, linear_blending, reference_white, output_color);
+    g_assert_cmpfloat_with_epsilon (output_color[0] * lum->max, 203.0, 0.05);
+    transform_one (pq, untargeted, reference_white, output_color);
+    g_assert_cmpfloat_with_epsilon (output_color[0] * lum->max, 203.0, 0.05);
+  }
+
+  /* PQ with MaxCLL above the target: mapped. */
+  g_assert_true (clutter_color_state_params_get_peak_headroom (CLUTTER_COLOR_STATE_PARAMS (pq_cll_above),
+                                                               NULL,
+                                                               &peak_headroom));
+  g_assert_cmpfloat_with_epsilon (peak_headroom, 1000.0 / 203.0, 1e-9);
+  g_assert_true (clutter_color_transform_requires_highlight_mapping (pq_cll_above, blending));
+  g_assert_true (clutter_color_transform_requires_highlight_mapping (pq_cll_above, target_616));
+
+  /* PQ with MaxCLL below the target: not mapped. */
+  g_assert_false (clutter_color_transform_requires_highlight_mapping (pq_cll_below, blending));
+  g_assert_false (clutter_color_transform_requires_highlight_mapping (pq_cll_below, target_616));
+
+  /* HLG at its 1000 cd/m² default, above a 616 cd/m² target: mapped. */
+  g_assert_true (clutter_color_state_params_nominal_max_is_content_peak (CLUTTER_COLOR_STATE_PARAMS (hlg)));
+  g_assert_true (clutter_color_state_params_get_peak_headroom (CLUTTER_COLOR_STATE_PARAMS (hlg),
+                                                               NULL,
+                                                               &peak_headroom));
+  g_assert_cmpfloat_with_epsilon (peak_headroom, 1000.0 / 203.0, 1e-6);
+  g_assert_true (clutter_color_transform_requires_highlight_mapping (hlg, target_616));
+
+  /* Extended-range linear: neither notion holds. */
+  linear = clutter_color_state_params_new (context, CLUTTER_COLORSPACE_SRGB,
+                                           CLUTTER_TRANSFER_FUNCTION_LINEAR);
+  g_assert_false (clutter_color_state_params_nominal_max_is_content_peak (CLUTTER_COLOR_STATE_PARAMS (linear)));
+  g_assert_false (clutter_color_state_params_is_signal_range_bounded (CLUTTER_COLOR_STATE_PARAMS (linear)));
+}
