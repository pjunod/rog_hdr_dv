 src/tests/wayland-color-management-test.c     | 355 ++++++++++++++++++
 .../wayland-test-clients/color-management.c   |  68 ++++
 3 files changed, 425 insertions(+)

diff --git a/src/tests/meson.build b/src/tests/meson.build
