+/*
+ * The adaptation of a display's output to its adapted white, when
+ * converting @source_color_state, a state that carries one (the blending
+ * state of an output with Night Light, see
+ * clutter_color_state_params_new_adapted_display_target()), to
+ * @target_color_state, a state that does not: the output's encoding. The
+ * conversion of content to the blending state, which carries it too, does
+ * not adapt it, so that it is applied once.
+ */
+static gboolean
+get_white_adaptation (ClutterColorState *source_color_state,
+                      ClutterColorState *target_color_state,
+                      graphene_matrix_t *adaptation)
+{
+  ClutterColorStateParams *target_params;
+  float white_x, white_y;
+
+  if (!CLUTTER_IS_COLOR_STATE_PARAMS (source_color_state) ||
+      !CLUTTER_IS_COLOR_STATE_PARAMS (target_color_state))
+    return FALSE;
+
+  target_params = CLUTTER_COLOR_STATE_PARAMS (target_color_state);
+  if (!clutter_color_state_params_get_adapted_white (CLUTTER_COLOR_STATE_PARAMS (source_color_state),
+                                                     &white_x, &white_y) ||
+      clutter_color_state_params_get_adapted_white (target_params, NULL, NULL))
+    return FALSE;
+
+  return clutter_colorimetry_get_white_adaptation_matrix (clutter_color_state_params_get_colorimetry (target_params),
+                                                          white_x, white_y,
+                                                          adaptation,
+                                                          NULL);
+}
+
