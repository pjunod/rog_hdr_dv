  * The mapping decision for a pair of color states: whether converting the
  * source to the target maps its highlights, compresses its gamut, and, when
- * it does, with which limits. It is made once per pair, by
- * compute_highlight_mapping() and get_gamut_compression(), and kept with the
- * transform cache under the same exact key, so that the per frame and per
- * pointer motion questions of direct scanout and the hardware cursor plane
- * cost a lookup, and every reader, the renderer included, gets the same
- * answer.
+ * it does, with which limits, and whether it adapts the white of the
+ * display's output, with which matrix. It is made once per pair, by
+ * compute_highlight_mapping(), get_gamut_compression() and
+ * get_white_adaptation(), and kept with the transform cache under the same
+ * exact key, so that the per frame and per pointer motion questions of
+ * direct scanout and the hardware cursor plane cost a lookup, and every
+ * reader, the renderer included, gets the same answer.
  */
 typedef struct _MappingDecision
 {
   GamutCompression compression;
+  graphene_matrix_t white_adaptation;
   gboolean highlight;
   gboolean gamut;
+  gboolean white;
 } MappingDecision;
 
