+/*
+ * Computes the adaptation of a display's output to the white point
+ * (@white_x, @white_y), such as a Night Light white: a matrix on linear
+ * BT.2020, applied just before the conversion to the display's encoding,
+ * @colorimetry.
+ *
+ * That conversion adapts linear BT.2020, whose white is CLUTTER_D65, to the
+ * encoding's white point. The adaptation is therefore made in the frame of
+ * the colors the display shows: linear BT.2020 is taken to CIE XYZ with the
+ * encoding's white (the inverse of the encoding's own adaptation to D65),
+ * adapted with Bradford from the encoding's white point to the new one, and
+ * brought back. The encoding's white is then shown at the new white point,
+ * whatever the encoding's white point is.
+ *
+ * The result is scaled so that the brightest channel of the encoding's
+ * adapted white, in linear RGB of the encoding, is that of the unadapted
+ * white: the adapted output never becomes brighter.
+ *
+ * Returns %FALSE, setting @error, if the white point has no XYZ or a matrix
+ * cannot be computed.
+ */
+gboolean
+clutter_colorimetry_get_white_adaptation_matrix (const ClutterColorimetry  *colorimetry,
+                                                 float                      white_x,
+                                                 float                      white_y,
+                                                 graphene_matrix_t         *adaptation,
+                                                 GError                   **error)
+{
+  const ClutterPrimaries *primaries;
+  graphene_matrix_t to_linear_bt2020, from_linear_bt2020, XYZ_to_D65;
+  graphene_matrix_t XYZ_to_linear_bt2020, linear_bt2020_to_XYZ;
+  graphene_matrix_t D65_to_XYZ, to_white, scale, temp, matrix;
+  graphene_vec3_t encoding_white_XYZ, white_XYZ, white;
+  float brightest;
+
+  if (!clutter_colorimetry_get_linear_bt2020_matrices (colorimetry,
+                                                       &to_linear_bt2020,
+                                                       &from_linear_bt2020,
+                                                       error) ||
+      !clutter_colorimetry_get_source_matrices (colorimetry,
+                                                &to_linear_bt2020,
+                                                &XYZ_to_D65,
+                                                &XYZ_to_linear_bt2020,
+                                                &linear_bt2020_to_XYZ,
+                                                error))
+    return FALSE;
+
+  primaries = clutter_colorimetry_get_primaries (colorimetry);
+  /* Checked by clutter_colorimetry_get_source_matrices() above. */
+  if (!white_point_to_XYZ_checked (primaries->w_x, primaries->w_y,
+                                   &encoding_white_XYZ))
+    g_assert_not_reached ();
+
+  if (!white_point_to_XYZ_checked (white_x, white_y, &white_XYZ) ||
+      !clutter_chromatic_adaptation_matrix (&encoding_white_XYZ, &white_XYZ,
+                                            &to_white) ||
+      !graphene_matrix_inverse (&XYZ_to_D65, &D65_to_XYZ))
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+                           "The white point cannot be adapted to");
+      return FALSE;
+    }
+
+  /* linear BT.2020 → XYZ D65 → XYZ in the encoding's white → XYZ in the new
+   * white, taken by the encoding's adaptation to D65 → linear BT.2020 */
+  graphene_matrix_multiply (&linear_bt2020_to_XYZ, &D65_to_XYZ, &temp);
+  graphene_matrix_multiply (&temp, &to_white, &matrix);
+  graphene_matrix_multiply (&matrix, &XYZ_to_D65, &temp);
+  graphene_matrix_multiply (&temp, &XYZ_to_linear_bt2020, &matrix);
+
+  /* The encoding's white, RGB (1, 1, 1), adapted, in the encoding. */
+  graphene_matrix_multiply (&to_linear_bt2020, &matrix, &temp);
+  graphene_matrix_multiply (&temp, &from_linear_bt2020, &scale);
+  graphene_vec3_init (&white, 1.0f, 1.0f, 1.0f);
+  graphene_matrix_transform_vec3 (&scale, &white, &white);
+  brightest = MAX (graphene_vec3_get_x (&white),
+                   MAX (graphene_vec3_get_y (&white),
+                        graphene_vec3_get_z (&white)));
+  if (!matrix_is_finite (&matrix) || !isfinite (brightest) ||
+      !(brightest > 0.0f))
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+                           "The white point adaptation is not finite");
+      return FALSE;
+    }
+
+  graphene_matrix_init_scale (&scale, 1.0f / brightest, 1.0f / brightest,
+                              1.0f / brightest);
+  graphene_matrix_multiply (&matrix, &scale, adaptation);
+
+  return TRUE;
+}
+
 /*
  * The cross product of @b - @a and @p - @a in the xy plane: positive when the
  * turn from @a to @b to @p is counterclockwise.
diff --git a/src/tests/clutter/conform/color-hdr.c b/src/tests/clutter/conform/color-hdr.c
index 8245365..89274b2 100644
--- a/src/tests/clutter/conform/color-hdr.c
+++ b/src/tests/clutter/conform/color-hdr.c
@@ -3141,6 +3141,237 @@ mapping_decision_cache (void)
     g_object_unref (targets[j]);
 }
 
+/*
+ * Night Light white points: the Planckian chromaticities, in CIE 1931 xy,
+ * that the color device computes for 4000 K and 3990 K.
+ */
+static const float night_light_4000k[2] = { 0.3804111f, 0.3765993f };
+static const float night_light_3990k[2] = { 0.3808537f, 0.3768775f };
+
+static ClutterColorState *
+create_adapted_output_target (ClutterColorState *output,
+                              const float        white[2])
+{
+  const ClutterColorTargetVolume no_target = { 0 };
+
+  return clutter_color_state_params_new_adapted_display_target (CLUTTER_COLOR_STATE_PARAMS (output),
+                                                                &no_target,
+                                                                white[0],
+                                                                white[1]);
+}
+
+/* Whether two pipelines have the same operations, so the same shader. */
+static gboolean
+pipelines_have_same_ops (ClutterColorTransform *transform,
+                         ClutterColorTransform *other_transform)
+{
+  const GList *l = clutter_color_pipeline_get_ops (clutter_color_transform_get_pipeline (transform));
+  const GList *m = clutter_color_pipeline_get_ops (clutter_color_transform_get_pipeline (other_transform));
+
+  for (; l && m; l = l->next, m = m->next)
+    {
+      if (G_OBJECT_TYPE (l->data) != G_OBJECT_TYPE (m->data))
+        return FALSE;
+    }
+
+  return !l && !m;
+}
+
+/*
+ * The output of a display adapted to the Night Light white: converting its
+ * blending state to its PQ encoding shows the encoding's white at the
+ * Planckian white, within the precision of the matrices, and no channel
+ * brighter than without the adaptation.
+ */
+static void
+white_adaptation_white (void)
+{
+  g_autoptr (ClutterColorState) output = create_pq_output (203.0f);
+  g_autoptr (ClutterColorState) adapted = NULL;
+  double bt2020_to_xyz[3][3];
+  int linear;
+
+  adapted = create_adapted_output_target (output, night_light_4000k);
+  reference_rgb_to_xyz (&bt2020_gamut, bt2020_to_xyz);
+
+  for (linear = 0; linear < 2; linear++)
+    {
+      g_autoptr (ClutterColorState) blending = NULL;
+      g_autoptr (ClutterColorState) plain = NULL;
+      g_autoptr (ClutterColorTransform) transform = NULL;
+      g_autoptr (ClutterColorTransform) plain_transform = NULL;
+      float white[4] = { 0.5f, 0.5f, 0.5f, 1.0f };
+      float plain_white[4] = { 0.5f, 0.5f, 0.5f, 1.0f };
+      double lum[3], plain_lum[3], xyz[3], brightest = 0.0;
+      double plain_brightest = 0.0;
+      int c;
+
+      blending = clutter_color_state_get_blending (adapted, linear);
+      plain = clutter_color_state_get_blending (output, linear);
+      g_assert_true (clutter_color_transform_requires_mapping (blending, output));
+      g_assert_false (clutter_color_transform_requires_mapping (plain, output));
+
+      transform = clutter_color_transform_new (blending, output,
+                                               CLUTTER_COLOR_STATE_TRANSFORM_OPAQUE);
+      plain_transform = clutter_color_transform_new (plain, output,
+                                                     CLUTTER_COLOR_STATE_TRANSFORM_OPAQUE);
+      clutter_color_pipeline_do_transform (clutter_color_transform_get_pipeline (transform),
+                                           white, 1);
+      clutter_color_pipeline_do_transform (clutter_color_transform_get_pipeline (plain_transform),
+                                           plain_white, 1);
+
+      for (c = 0; c < 3; c++)
+        {
+          lum[c] = reference_pq_luminance (white[c]);
+          plain_lum[c] = reference_pq_luminance (plain_white[c]);
+          g_assert_cmpfloat (lum[c], <=, plain_lum[c] * (1.0 + 1e-4));
+          brightest = MAX (brightest, lum[c]);
+          plain_brightest = MAX (plain_brightest, plain_lum[c]);
+        }
+      g_assert_cmpfloat_with_epsilon (brightest / plain_brightest, 1.0, 1e-3);
+
+      reference_apply (bt2020_to_xyz, lum, xyz);
+      g_assert_cmpfloat_with_epsilon (xyz[0] / (xyz[0] + xyz[1] + xyz[2]),
+                                      night_light_4000k[0], 1e-4);
+      g_assert_cmpfloat_with_epsilon (xyz[1] / (xyz[0] + xyz[1] + xyz[2]),
+                                      night_light_4000k[1], 1e-4);
+    }
+}
+
+/*
+ * The adaptation applies once, converting the blending state to the
+ * output's encoding: converting content to the blending state is the same
+ * as without it. Planes that bypass the blending state cannot show it.
+ */
+static void
+white_adaptation_applied_once (void)
+{
+  ClutterContext *context = clutter_test_get_context ();
+  g_autoptr (ClutterColorState) output = create_pq_output (203.0f);
+  g_autoptr (ClutterColorState) adapted = NULL;
+  g_autoptr (ClutterColorState) same = NULL;
+  g_autoptr (ClutterColorState) other = NULL;
+  g_autoptr (ClutterColorState) blending = NULL;
+  g_autoptr (ClutterColorState) plain = NULL;
+  g_autoptr (ClutterColorState) pq = NULL;
+  g_autoptr (ClutterColorState) srgb = NULL;
+  ClutterColorState *sources[2];
+  float white_x, white_y;
+  int i;
+
+  adapted = create_adapted_output_target (output, night_light_4000k);
+  same = create_adapted_output_target (output, night_light_4000k);
+  other = create_adapted_output_target (output, night_light_3990k);
+  blending = clutter_color_state_get_blending (adapted, FALSE);
+  plain = clutter_color_state_get_blending (output, FALSE);
+
+  /* A declared value, compared exactly, and kept by the blending state. */
+  g_assert_true (clutter_color_state_params_get_adapted_white (CLUTTER_COLOR_STATE_PARAMS (blending),
+                                                               &white_x, &white_y));
+  g_assert_cmpfloat (white_x, ==, night_light_4000k[0]);
+  g_assert_cmpfloat (white_y, ==, night_light_4000k[1]);
+  g_assert_false (clutter_color_state_params_get_adapted_white (CLUTTER_COLOR_STATE_PARAMS (plain),
+                                                                NULL, NULL));
+  g_assert_true (clutter_color_state_identical (adapted, same));
+  g_assert_false (clutter_color_state_identical (adapted, other));
+  g_assert_false (clutter_color_state_equals (adapted, other));
+  g_assert_false (clutter_color_state_equals (adapted, output));
+
+  pq = clutter_color_state_params_new (context, CLUTTER_COLORSPACE_BT2020,
+                                       CLUTTER_TRANSFER_FUNCTION_PQ);
+  srgb = clutter_color_state_params_new (context, CLUTTER_COLORSPACE_SRGB,
+                                         CLUTTER_TRANSFER_FUNCTION_SRGB_PIECEWISE);
+  sources[0] = pq;
+  sources[1] = srgb;
+  for (i = 0; i < G_N_ELEMENTS (sources); i++)
+    {
+      ClutterColorTransform *transform, *plain_transform;
+      float color[4] = { 0.6f, 0.3f, 0.2f, 1.0f };
+      float plain_color[4] = { 0.6f, 0.3f, 0.2f, 1.0f };
+
+      g_assert_false (clutter_color_transform_requires_mapping (sources[i], blending));
+      g_assert_true (clutter_color_transform_requires_composition (sources[i], blending));
+      g_assert_false (clutter_color_transform_requires_composition (sources[i], plain));
+
+      transform = clutter_color_transform_from_color_states (context, sources[i],
+                                                             blending, 0);
+      plain_transform = clutter_color_transform_from_color_states (context, sources[i],
+                                                                   plain, 0);
+      g_assert_true (pipelines_have_same_ops (transform, plain_transform));
+      clutter_color_pipeline_do_transform (clutter_color_transform_get_pipeline (transform),
+                                           color, 1);
+      clutter_color_pipeline_do_transform (clutter_color_transform_get_pipeline (plain_transform),
+                                           plain_color, 1);
+      g_assert_cmpmem (color, sizeof (color), plain_color, sizeof (plain_color));
+    }
+
+  /* Content already in the blending state is not converted at all. */
+  g_assert_false (clutter_color_transform_requires_mapping (blending, blending));
+}
+
+/*
+ * A Night Light step changes the adaptation's value only: the conversion
+ * keeps its operations, so its shader, and the matrix is a uniform.
+ */
+static void
+white_adaptation_uniform (void)
+{
+  ClutterContext *context = clutter_test_get_context ();
+  g_autoptr (ClutterColorState) output = create_pq_output (203.0f);
+  g_autoptr (ClutterColorState) adapted = NULL;
+  g_autoptr (ClutterColorState) stepped = NULL;
+  g_autoptr (ClutterColorState) blending = NULL;
+  g_autoptr (ClutterColorState) stepped_blending = NULL;
+  ClutterColorTransform *transform, *stepped_transform;
+  float color[4] = { 0.5f, 0.5f, 0.5f, 1.0f };
+  float stepped_color[4] = { 0.5f, 0.5f, 0.5f, 1.0f };
+
+  adapted = create_adapted_output_target (output, night_light_4000k);
+  stepped = create_adapted_output_target (output, night_light_3990k);
+  blending = clutter_color_state_get_blending (adapted, FALSE);
+  stepped_blending = clutter_color_state_get_blending (stepped, FALSE);
+
+  transform = clutter_color_transform_from_color_states (context, blending,
+                                                         output, 0);
+  stepped_transform = clutter_color_transform_from_color_states (context,
+                                                                 stepped_blending,
+                                                                 output, 0);
+  g_assert_true (transform != stepped_transform);
+  g_assert_true (pipelines_have_same_ops (transform, stepped_transform));
+
+  clutter_color_pipeline_do_transform (clutter_color_transform_get_pipeline (transform),
+                                       color, 1);
+  clutter_color_pipeline_do_transform (clutter_color_transform_get_pipeline (stepped_transform),
+                                       stepped_color, 1);
+  g_assert_true (memcmp (color, stepped_color, sizeof (color)) != 0);
+}
+
+static void
+white_adaptation_shader_matches_cpu (void)
+{
+  g_autoptr (ClutterColorState) output = create_pq_output (203.0f);
+  g_autoptr (ClutterColorState) adapted = NULL;
+  g_autoptr (ClutterColorState) blending = NULL;
+  g_autoptr (ClutterColorState) linear_blending = NULL;
+  const float signals[][3] = {
+    { 1.0f, 1.0f, 1.0f },
+    { 0.5f, 0.5f, 0.5f },
+    { 0.8f, 0.2f, 0.1f },
+    { 0.1f, 0.7f, 0.3f },
+    { 0.2f, 0.1f, 0.9f },
+    { 0.0f, 0.0f, 0.0f },
+  };
+
+  adapted = create_adapted_output_target (output, night_light_4000k);
+  blending = clutter_color_state_get_blending (adapted, FALSE);
+  linear_blending = clutter_color_state_get_blending (adapted, TRUE);
+
+  assert_shader_matches_cpu (blending, output, signals, G_N_ELEMENTS (signals),
+                             2e-3f);
+  assert_shader_matches_cpu (linear_blending, output, signals,
+                             G_N_ELEMENTS (signals), 1e-4f);
+}
