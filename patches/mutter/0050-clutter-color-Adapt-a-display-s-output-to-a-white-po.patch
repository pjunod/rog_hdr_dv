  * Whether converting @source_color_state to @target_color_state maps it
- * toward a display's target: its highlights, its gamut, or both. This is the
- * single "mapping required" predicate: the transform builds a conversion,
- * even between equal encodings, exactly when it holds, and direct scanout and
- * the hardware cursor plane, which bypass the conversion, must be refused
- * when it does.
+ * toward a display's target: its highlights, its gamut, or the white its
+ * output is adapted to. This is the single "mapping required" predicate:
+ * the transform builds a conversion, even between equal encodings, exactly
+ * when it holds.
  */
 gboolean
 clutter_color_transform_requires_mapping (ClutterColorState *source_color_state,
@@ -1618,7 +1653,50 @@ clutter_color_transform_requires_mapping (ClutterColorState *source_color_state,
 
   decision = get_mapping_decision (source_color_state, target_color_state);
 
-  return decision->highlight || decision->gamut;
+  return decision->highlight || decision->gamut || decision->white;
+}
+
+/*
+ * Whether content in @source_color_state, on an output whose content is
+ * blended in @blending_color_state, can only be shown as the renderer shows
+ * it by compositing it: whether its conversion to the blending state maps
+ * it (see clutter_color_transform_requires_mapping()), or the blending
+ * state's conversion to the output's encoding adapts the output's white.
+ * Direct scanout and the hardware cursor plane, which bypass both
+ * conversions, are refused exactly when it holds.
+ */
+gboolean
+clutter_color_transform_requires_composition (ClutterColorState *source_color_state,
+                                              ClutterColorState *blending_color_state)
+{
+  g_return_val_if_fail (CLUTTER_IS_COLOR_STATE (source_color_state), FALSE);
+  g_return_val_if_fail (CLUTTER_IS_COLOR_STATE (blending_color_state), FALSE);
+
+  if (CLUTTER_IS_COLOR_STATE_PARAMS (blending_color_state) &&
+      clutter_color_state_params_get_adapted_white (CLUTTER_COLOR_STATE_PARAMS (blending_color_state),
+                                                    NULL, NULL))
+    return TRUE;
+
+  return clutter_color_transform_requires_mapping (source_color_state,
+                                                   blending_color_state);
+}
+
+/*
+ * The adaptation of the display's output to its adapted white, in linear
+ * BT.2020 just before the conversion to the output's encoding, with the
+ * matrix of get_white_adaptation(). Only its value changes with the white
+ * point, so a new white point updates a uniform of the same shader.
