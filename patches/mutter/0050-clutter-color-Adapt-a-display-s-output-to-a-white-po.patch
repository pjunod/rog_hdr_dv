+/*
+ * clutter_color_state_params_new_adapted_display_target:
+ * @color_state_params: the color state a display's content is rendered in
+ * @target_volume: the display's target color volume, see
+ *   clutter_color_state_params_new_display_target()
+ * @white_x: the CIE 1931 x of the white point the output is adapted to
+ * @white_y: the CIE 1931 y of the white point the output is adapted to
+ *
+ * Like clutter_color_state_params_new_display_target(), and the display's
+ * output is moreover adapted to the white point (@white_x, @white_y), such
+ * as the white of Night Light. The adaptation is applied once, in linear
+ * light, when the blending state derived from the display target is
+ * converted to the output's encoding (see
+ * clutter_colorimetry_get_white_adaptation_matrix()); converting content to
+ * the blending state does not apply it. The white point must be adaptable
+ * to from the encoding of @color_state_params.
+ *
+ * Returns: (transfer full): a new ClutterColorState
+ */
+ClutterColorState *
+clutter_color_state_params_new_adapted_display_target (ClutterColorStateParams        *color_state_params,
+                                                       const ClutterColorTargetVolume *target_volume,
+                                                       float                           white_x,
+                                                       float                           white_y)
+{
+  ClutterColorStateParams *copy;
+  graphene_matrix_t adaptation;
+
+  g_return_val_if_fail (CLUTTER_IS_COLOR_STATE_PARAMS (color_state_params),
+                        NULL);
+  g_return_val_if_fail (clutter_colorimetry_get_white_adaptation_matrix (&color_state_params->colorimetry,
+                                                                         white_x,
+                                                                         white_y,
+                                                                         &adaptation,
+                                                                         NULL),
+                        NULL);
+
+  copy = CLUTTER_COLOR_STATE_PARAMS (clutter_color_state_params_new_display_target (color_state_params,
+                                                                                    target_volume));
+  if (!copy)
+    return NULL;
+
+  copy->has_adapted_white = TRUE;
+  copy->adapted_white_x = white_x;
+  copy->adapted_white_y = white_y;
+
+  return CLUTTER_COLOR_STATE (copy);
+}
+
+/*
+ * Whether the state carries a white point its display's output is adapted
+ * to, see clutter_color_state_params_new_adapted_display_target().
+ */
+gboolean
+clutter_color_state_params_get_adapted_white (ClutterColorStateParams *color_state_params,
+                                              float                   *white_x,
+                                              float                   *white_y)
+{
+  if (!color_state_params->has_adapted_white)
+    return FALSE;
+
+  if (white_x)
+    *white_x = color_state_params->adapted_white_x;
+  if (white_y)
+    *white_y = color_state_params->adapted_white_y;
+
+  return TRUE;
+}
