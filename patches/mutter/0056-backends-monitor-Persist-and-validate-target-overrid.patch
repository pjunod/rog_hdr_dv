+static MetaMonitorConfigStore *
+get_target_override_test_store (void)
+{
+  MetaBackend *backend = meta_context_get_backend (test_context);
+  MetaMonitorManager *manager = meta_backend_get_monitor_manager (backend);
+
+  return meta_monitor_config_manager_get_store (manager->config_manager);
+}
+
+static MetaMonitorsConfig *
+lookup_target_override_config (MetaMonitorConfigStore *store)
+{
+  char connector1[] = "DP-1";
+  char connector2[] = "DP-2";
+  char vendor[] = "MetaProduct's Inc.";
+  char product[] = "MetaMonitor";
+  char serial1[] = "0x123456a";
+  char serial2[] = "0x123456b";
+  MetaMonitorSpec specs[] = {
+    { .connector = connector1, .vendor = vendor,
+      .product = product, .serial = serial1 },
+    { .connector = connector2, .vendor = vendor,
+      .product = product, .serial = serial2 },
+  };
+  MetaMonitorsConfigKey key = {
+    .layout_mode = META_LOGICAL_MONITOR_LAYOUT_MODE_LOGICAL,
+  };
+  MetaMonitorsConfig *config;
+
+  key.monitor_specs = g_list_append (NULL, &specs[0]);
+  key.monitor_specs = g_list_append (key.monitor_specs, &specs[1]);
+  config = meta_monitor_config_store_lookup (store, &key);
+  g_list_free (key.monitor_specs);
+  g_assert_nonnull (config);
+
+  return config;
+}
+
+static void
+assert_target_override_config (MetaMonitorsConfig *config)
+{
+  MetaLogicalMonitorConfig *first = config->logical_monitor_configs->data;
+  MetaLogicalMonitorConfig *second = config->logical_monitor_configs->next->data;
+  MetaMonitorConfig *monitor1 = first->monitor_configs->data;
+  MetaMonitorConfig *monitor2 = second->monitor_configs->data;
+  const MetaColorTargetOverride expected1 = {
+    .has_peak = TRUE, .peak = 400, .has_min = TRUE, .min = 0,
+    .gamut_source = META_HDR_GAMUT_SOURCE_NONE,
+  };
+  const MetaColorTargetOverride expected2 = {
+    .has_peak = TRUE, .peak = 600,
+    .gamut_source = META_HDR_GAMUT_SOURCE_BASE_EDID,
+  };
+
+  g_assert_true (meta_color_target_override_equal (&monitor1->target_override,
+                                                   &expected1));
+  g_assert_true (meta_color_target_override_equal (&monitor2->target_override,
+                                                   &expected2));
+}
