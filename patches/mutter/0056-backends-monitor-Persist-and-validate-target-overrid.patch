 #include "backends/meta-backend-private.h"
 #include "backends/meta-monitor-config-store.h"
 #include "backends/meta-monitor-config-utils.h"
@@ -1763,13 +1765,56 @@ meta_verify_monitor_spec (MetaMonitorSpec *monitor_spec,
     }
 }
 
+gboolean
+meta_verify_target_override (const MetaColorTargetOverride *target_override,
+                             GError                       **error)
+{
+  const ClutterEOTF pq = {
+    .type = CLUTTER_EOTF_TYPE_NAMED,
+    .tf_name = CLUTTER_TRANSFER_FUNCTION_PQ,
+  };
+  const ClutterLuminance *encoding = clutter_eotf_get_default_luminance (pq);
+  double minimum = target_override->has_min ? target_override->min : encoding->min;
+  double maximum = target_override->peak;
+
+  if (target_override->gamut_source < META_HDR_GAMUT_SOURCE_AUTO ||
+      target_override->gamut_source > META_HDR_GAMUT_SOURCE_NONE)
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_FAILED,
+                   "Invalid HDR gamut source");
+      return FALSE;
+    }
+
+  if (target_override->has_min && !target_override->has_peak)
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_FAILED,
+                   "Target minimum luminance requires a peak");
+      return FALSE;
+    }
+
+  /* Match declared-source wire limits and the nominal PQ white; an applied
+   * reference-luminance factor (including 2.1, ~426 cd/m²) is irrelevant. */
+  if (target_override->has_peak &&
+      (!isfinite (minimum) || !isfinite (maximum) ||
+       minimum < 0 || maximum <= encoding->ref ||
+       minimum >= floor (maximum) ||
+       minimum * 10000 > G_MAXUINT32 || maximum > G_MAXUINT32))
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_FAILED,
+                   "Invalid target luminance range");
+      return FALSE;
+    }
+
+  return TRUE;
+}
+
 gboolean
 meta_verify_monitor_config (MetaMonitorConfig *monitor_config,
                             GError           **error)
 {
   if (monitor_config->monitor_spec && monitor_config->mode_spec)
     {
-      return TRUE;
+      return meta_verify_target_override (&monitor_config->target_override, error);
     }
   else
     {
