+static void
+meta_test_monitor_store_target_override_roundtrip (void)
+{
+  MetaMonitorConfigStore *store = get_target_override_test_store ();
+  g_autofree char *input = g_test_build_filename (G_TEST_DIST, "monitor-configs",
+                                                  "target-overrides.xml", NULL);
+  g_autofree char *directory = NULL;
+  g_autofree char *output = NULL;
+  g_autofree char *saved = NULL;
+  g_autoptr (GError) error = NULL;
+  g_autoptr (MetaMonitorsConfig) config = NULL;
+
+  directory = g_dir_make_tmp ("mutter-target-override-XXXXXX", &error);
+  g_assert_no_error (error);
+  output = g_build_filename (directory, "monitors.xml", NULL);
+  g_assert_true (meta_monitor_config_store_set_custom (store, input, output,
+                   META_MONITORS_CONFIG_FLAG_NONE, &error));
+  g_assert_no_error (error);
+  config = g_object_ref (lookup_target_override_config (store));
+  assert_target_override_config (config);
+  meta_monitor_config_store_add (store, config);
+
+  g_assert_true (g_file_get_contents (output, &saved, NULL, &error));
+  g_assert_no_error (error);
+  g_assert_nonnull (strstr (saved, "<targetminluminance>0</targetminluminance>"));
+  g_assert_nonnull (strstr (saved, "<hdrgamutsource>none</hdrgamutsource>"));
+  g_assert_null (strstr (saved, "<hdrgamutsource>auto</hdrgamutsource>"));
+
+  g_assert_true (meta_monitor_config_store_set_custom (store, output, NULL,
+                   META_MONITORS_CONFIG_FLAG_NONE, &error));
+  g_assert_no_error (error);
+  assert_target_override_config (lookup_target_override_config (store));
+
+  g_assert_cmpint (g_remove (output), ==, 0);
+  g_assert_cmpint (g_rmdir (directory), ==, 0);
+}
