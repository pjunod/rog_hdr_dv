 src/backends/meta-monitor-config-manager.h    |   4 +
 src/backends/meta-monitor-config-store.c      | 158 +++++++++++++++-
 .../monitor-configs/target-overrides.xml      |  45 +++++
 src/tests/monitor-store-unit-tests.c          | 174 ++++++++++++++++++
 5 files changed, 426 insertions(+), 2 deletions(-)
 create mode 100644 src/tests/monitor-configs/target-overrides.xml

