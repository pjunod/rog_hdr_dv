+static void
+append_target_override (GString                       *buffer,
+                        const MetaColorTargetOverride *target_override)
+{
+  char value[G_ASCII_DTOSTR_BUF_SIZE];
+
+  if (target_override->has_peak)
+    {
+      g_ascii_dtostr (value, sizeof (value), target_override->peak);
+      g_string_append_printf (buffer,
+                              "        <targetpeakluminance>%s</targetpeakluminance>\n",
+                              value);
+    }
+  if (target_override->has_min)
+    {
+      g_ascii_dtostr (value, sizeof (value), target_override->min);
+      g_string_append_printf (buffer,
+                              "        <targetminluminance>%s</targetminluminance>\n",
+                              value);
+    }
+
+  switch (target_override->gamut_source)
+    {
+    case META_HDR_GAMUT_SOURCE_AUTO:
+      break;
+    case META_HDR_GAMUT_SOURCE_BASE_EDID:
+      g_string_append (buffer, "        <hdrgamutsource>base-edid</hdrgamutsource>\n");
+      break;
+    case META_HDR_GAMUT_SOURCE_NONE:
+      g_string_append (buffer, "        <hdrgamutsource>none</hdrgamutsource>\n");
+      break;
+    }
+}
