+static void
+meta_test_monitor_store_target_override_invalid (void)
+{
+  const char *invalid_fields[] = {
+    "<targetpeakluminance></targetpeakluminance>",
+    "<targetpeakluminance>garbage</targetpeakluminance>",
+    "<targetpeakluminance>nan</targetpeakluminance>",
+    "<targetpeakluminance>inf</targetpeakluminance>",
+    "<targetpeakluminance>203</targetpeakluminance>",
+    "<targetpeakluminance>4294967296</targetpeakluminance>",
+    "<targetminluminance>0</targetminluminance>",
+    "<targetpeakluminance>400</targetpeakluminance>"
+    "<targetminluminance>-1</targetminluminance>",
+    "<targetpeakluminance>400.5</targetpeakluminance>"
+    "<targetminluminance>400</targetminluminance>",
+    "<targetpeakluminance>500000</targetpeakluminance>"
+    "<targetminluminance>429496.75</targetminluminance>",
+    "<hdrgamutsource>unknown</hdrgamutsource>",
+    "<hdrgamutsource/>",
+    "<targetpeakluminance>400</targetpeakluminance>"
+    "<targetpeakluminance>600</targetpeakluminance>",
+    "<hdrgamutsource>auto</hdrgamutsource>"
+    "<hdrgamutsource>none</hdrgamutsource>",
+    "<targetpeakluminance><value>400</value></targetpeakluminance>",
+  };
+  MetaMonitorConfigStore *store = get_target_override_test_store ();
+  g_autofree char *fixture = g_test_build_filename (G_TEST_DIST, "monitor-configs",
+                                                   "single.xml", NULL);
+  g_autofree char *template = NULL;
+  g_autofree char *directory = NULL;
+  g_autofree char *input = NULL;
+  g_auto (GStrv) parts = NULL;
+  g_autoptr (GError) error = NULL;
+  size_t i;
+
+  g_assert_true (g_file_get_contents (fixture, &template, NULL, &error));
+  g_assert_no_error (error);
+  parts = g_strsplit (template, "</monitor>", 2);
+  directory = g_dir_make_tmp ("mutter-target-invalid-XXXXXX", &error);
+  g_assert_no_error (error);
+  input = g_build_filename (directory, "monitors.xml", NULL);
+
+  for (i = 0; i < G_N_ELEMENTS (invalid_fields); i++)
+    {
+      g_autofree char *xml = g_strconcat (parts[0], invalid_fields[i],
+                                         "</monitor>", parts[1], NULL);
+
+      g_assert_true (g_file_set_contents (input, xml, -1, &error));
+      g_assert_no_error (error);
+      g_assert_false (meta_monitor_config_store_set_custom (store, input, NULL,
+                       META_MONITORS_CONFIG_FLAG_NONE, &error));
+      g_assert_nonnull (error);
+      g_clear_error (&error);
+    }
+
+  /* Unterminated XML must not silently accept an unfinished declaration. */
