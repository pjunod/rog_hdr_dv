+/* The white point (@x, @y), with Y = 1, in linear RGB of the encoding whose
+ * XYZ to RGB matrix is @from_XYZ, without chromatic adaptation. */
+static gboolean
+white_point_to_rgb (const graphene_matrix_t  *from_XYZ,
+                    float                     x,
+                    float                     y,
+                    const char               *name,
+                    float                     rgb[3],
+                    GError                  **error)
+{
+  graphene_vec3_t white_XYZ, white_rgb;
+  int i;
+
+  if (!white_point_to_XYZ_checked (x, y, &white_XYZ))
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+                   "The %s must have a positive, finite y chromaticity", name);
+      return FALSE;
+    }
+
+  graphene_matrix_transform_vec3 (from_XYZ, &white_XYZ, &white_rgb);
+  rgb[0] = graphene_vec3_get_x (&white_rgb);
+  rgb[1] = graphene_vec3_get_y (&white_rgb);
+  rgb[2] = graphene_vec3_get_z (&white_rgb);
+
+  for (i = 0; i < 3; i++)
+    {
+      if (!isfinite (rgb[i]))
+        {
+          g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+                       "The %s is not finite in the encoding", name);
+          return FALSE;
+        }
+    }
+
+  return TRUE;
+}
+
 /*
  * Computes the per-channel factors that adapt a display's output to the
- * white point (@white_x, @white_y), such as a Night Light white: diagonal
- * von Kries factors in the linear RGB of the display's encoding,
- * @colorimetry, the frame of the colors the display shows.
+ * white point (@white_x, @white_y), such as a Night Light white, relative to
+ * the reference white (@reference_x, @reference_y) at which the output is
+ * not adapted at all, such as the Night Light white of the default
+ * temperature: diagonal von Kries factors in the linear RGB of the display's
+ * encoding, @colorimetry, the frame of the colors the display shows.
  *
- * The white point, with Y = 1, is converted to linear RGB of the encoding
+ * Both whites, with Y = 1, are converted to linear RGB of the encoding
  * through CIE XYZ without chromatic adaptation, since that is the RGB the
- * display shows it with. A white outside the encoding's gamut, such as the
- * Planckian white at 1000 K in BT.2020, has a negative component there: it
- * is clamped to zero, which projects the white into the gamut rather than
- * claiming its exact chromaticity. The factors are then divided by the
- * largest one. They are therefore finite, within [0, 1], and the largest is
- * 1: no channel of any nonnegative color is brighter than unadapted, and a
- * white within the gamut is shown at exactly the requested chromaticity.
+ * display shows them with, and each factor is the ratio of the white's
+ * channel to the reference's. This is the same per-channel family as the
+ * gamma ramp of Night Light in SDR, which is normalized at the default
+ * temperature: at the reference white the factors are exactly 1, so the
+ * adaptation is continuous where it starts, and elsewhere the output's own
+ * white moves by the ratio of the two Planckian whites. A white outside the
+ * encoding's gamut, such as the Planckian white at 1000 K in BT.2020, has a
+ * negative ratio there: it is clamped to zero, which projects the white into
+ * the gamut rather than claiming its exact ratio. The factors are then
+ * divided by the largest one. They are therefore finite, within [0, 1], and
+ * the largest is 1: no channel of any nonnegative color is brighter than
+ * unadapted.
  *
- * Returns %FALSE, setting @error, if the white point has no XYZ, the
- * colorimetry has no usable matrices, or no factor is positive.
+ * Returns %FALSE, setting @error, if a white point has no XYZ, the
+ * colorimetry has no usable matrices, a channel of the reference white is
+ * not positive in the encoding, or no factor is positive.
  */
 gboolean
 clutter_colorimetry_get_white_adaptation_factors (const ClutterColorimetry  *colorimetry,
                                                   float                      white_x,
                                                   float                      white_y,
+                                                  float                      reference_x,
+                                                  float                      reference_y,
                                                   float                      factors[3],
                                                   GError                   **error)
 {
   graphene_matrix_t to_XYZ, from_XYZ;
-  graphene_vec3_t white_XYZ, white_rgb;
-  float rgb[3], largest;
+  float rgb[3], reference_rgb[3], largest;
   int i;
 
   if (!colorimetry_to_XYZ_checked (colorimetry, &to_XYZ, error) ||
       !invert_to_XYZ (&to_XYZ, &from_XYZ, error))
     return FALSE;
 
-  if (!white_point_to_XYZ_checked (white_x, white_y, &white_XYZ))
-    {
-      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
-                           "The white point must have a positive, finite y "
-                           "chromaticity");
-      return FALSE;
-    }
-
-  graphene_matrix_transform_vec3 (&from_XYZ, &white_XYZ, &white_rgb);
-  rgb[0] = graphene_vec3_get_x (&white_rgb);
-  rgb[1] = graphene_vec3_get_y (&white_rgb);
-  rgb[2] = graphene_vec3_get_z (&white_rgb);
+  if (!white_point_to_rgb (&from_XYZ, white_x, white_y, "white point",
+                           rgb, error) ||
+      !white_point_to_rgb (&from_XYZ, reference_x, reference_y,
+                           "reference white", reference_rgb, error))
+    return FALSE;
 
   largest = 0.0f;
   for (i = 0; i < 3; i++)
     {
+      if (!(reference_rgb[i] > 0.0f))
+        {
+          g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+                               "The reference white must lie within the "
+                               "encoding's gamut");
+          return FALSE;
+        }
+
+      /* Equal channels give exactly 1. */
+      rgb[i] = rgb[i] / reference_rgb[i];
       if (!isfinite (rgb[i]))
         {
           g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
-                               "The white point is not finite in the encoding");
+                               "The white point adaptation is not finite");
           return FALSE;
         }
 
@@ -972,8 +1022,9 @@ clutter_colorimetry_get_white_adaptation_factors (const ClutterColorimetry  *col
 
 /*
  * Computes the adaptation of a display's output to the white point
- * (@white_x, @white_y) as a matrix on linear BT.2020, applied just before
- * the conversion to the display's encoding, @colorimetry: the conversion of
+ * (@white_x, @white_y), relative to the reference white (@reference_x,
+ * @reference_y), as a matrix on linear BT.2020, applied just before the
+ * conversion to the display's encoding, @colorimetry: the conversion of
  * linear BT.2020 to linear RGB of the encoding, the diagonal factors of
  * clutter_colorimetry_get_white_adaptation_factors() there, and the
  * conversion back. Followed by the conversion to the encoding, it scales
@@ -987,6 +1038,8 @@ gboolean
 clutter_colorimetry_get_white_adaptation_matrix (const ClutterColorimetry  *colorimetry,
                                                  float                      white_x,
                                                  float                      white_y,
+                                                 float                      reference_x,
+                                                 float                      reference_y,
                                                  graphene_matrix_t         *adaptation,
                                                  GError                   **error)
 {
@@ -999,6 +1052,8 @@ clutter_colorimetry_get_white_adaptation_matrix (const ClutterColorimetry  *colo
                                                        error) ||
       !clutter_colorimetry_get_white_adaptation_factors (colorimetry,
                                                          white_x, white_y,
+                                                         reference_x,
+                                                         reference_y,
                                                          factors, error))
     return FALSE;
 
