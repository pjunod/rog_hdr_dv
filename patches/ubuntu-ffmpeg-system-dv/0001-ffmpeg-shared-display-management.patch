From 7ed5a5d24c23514bfbed18d950c1ad99d4ff4338 Mon Sep 17 00:00:00 2001
From: ROG HDR contributors <rog-hdr@invalid>
Date: Sat, 7 Nov 2026 18:00:00 -0500
Subject: [PATCH] Map Dolby frames to an explicit HDR export target in the
 libplacebo filter

---
 configure                      |   2 +-
 debian/changelog               |   7 ++
 debian/control                 |   2 +-
 debian/rog-filter-stock.shlibs |   2 +
 debian/rules                   |   6 ++
 libavfilter/vf_libplacebo.c    | 120 +++++++++++++++++++++++++++++++--
 6 files changed, 133 insertions(+), 6 deletions(-)
 create mode 100644 debian/rog-filter-stock.shlibs

diff --git a/configure b/configure
index 1759694..0b3d05a 100755
--- a/configure
+++ b/configure
@@ -7355,7 +7355,7 @@ enabled libopus           && {
         require_pkg_config libopus opus opus_multistream.h opus_multistream_surround_encoder_create
     }
 }
-enabled libplacebo        && require_pkg_config libplacebo "libplacebo >= 5.229.0" libplacebo/vulkan.h pl_vulkan_create
+enabled libplacebo        && require_pkg_config libplacebo "rog-dv-provider >= 1" "libplacebo/vulkan.h dv_provider.h" "pl_vulkan_create dv_provider_abi"
 enabled libpulse          && require_pkg_config libpulse libpulse pulse/pulseaudio.h pa_context_new
 enabled libqrencode       && require_pkg_config libqrencode libqrencode qrencode.h QRcode_encodeString
 enabled libquirc          && require libquirc quirc.h quirc_decode -lquirc
diff --git a/debian/changelog b/debian/changelog
index 8630a24..0a21c15 100644
--- a/debian/changelog
+++ b/debian/changelog
@@ -1,3 +1,10 @@
+ffmpeg (7:8.1.2-2ubuntu2+rogdv1) stonking; urgency=medium
+
+  * Use the shared display mapper in the libplacebo filter for explicit
+    HDR export targets. Keep ordinary filter and codec configuration.
+
+ -- ROG HDR Maintainers <rog-hdr@invalid>  Sat, 07 Nov 2026 18:00:00 -0500
+
 ffmpeg (7:8.1.2-2ubuntu2) stonking; urgency=medium
 
   * No-change rebuild for libbluray4.
diff --git a/debian/control b/debian/control
index b5fa7e3..c0bc221 100644
--- a/debian/control
+++ b/debian/control
@@ -107,7 +107,7 @@ Build-Depends:
 # --enable-libopus
  libopus-dev,
 # --enable-libplacebo
- libplacebo-dev (>= 5.229) [linux-any] <!pkg.ffmpeg.stage1>,
+ librog-dv-provider-dev (>= 1) [linux-any] <!pkg.ffmpeg.stage1>,
 # --enable-libpulse
  libpulse-dev <!pkg.ffmpeg.stage1>,
 # --enable-librabbitmq
diff --git a/debian/rog-filter-stock.shlibs b/debian/rog-filter-stock.shlibs
new file mode 100644
index 0000000..7320666
--- /dev/null
+++ b/debian/rog-filter-stock.shlibs
@@ -0,0 +1,2 @@
+libavcodec 62 libavcodec62 (= 7:8.1.2-2ubuntu2)
+libavutil 60 libavutil60 (= 7:8.1.2-2ubuntu2)
diff --git a/debian/rules b/debian/rules
index 2f59121..7f921b2 100755
--- a/debian/rules
+++ b/debian/rules
@@ -341,6 +341,12 @@ ifeq ($(filter pkg.ffmpeg.noextra,$(DEB_BUILD_PROFILES)),)
 	done
 endif
 
+# Only this filter package is delivered. Its avpriv imports bind to the
+# exact Ubuntu libraries from the source package used for this build.
+override_dh_shlibdeps:
+	dh_shlibdeps -plibavfilter11 -- -Ldebian/rog-filter-stock.shlibs
+	dh_shlibdeps --remaining-packages
+
 # avoid error: Unknown DWARF DW_OP_0
 override_dh_dwz:
 	dh_dwz -Xlibavcodec -Xlibavfilter -Xlibavutil -Xlibswresample -Xlibswscale
diff --git a/libavfilter/vf_libplacebo.c b/libavfilter/vf_libplacebo.c
index 316eca3..8ee8b1c 100644
--- a/libavfilter/vf_libplacebo.c
+++ b/libavfilter/vf_libplacebo.c
@@ -24,6 +24,7 @@
 #include "libavutil/file.h"
 #include "libavutil/frame.h"
 #include "libavutil/mem.h"
+#include "libavutil/mastering_display_metadata.h"
 #include "libavutil/opt.h"
 #include "libavutil/parseutils.h"
 #include "formats.h"
@@ -32,6 +33,7 @@
 #include "vulkan_filter.h"
 #include "scale_eval.h"
 
+#include <dv_provider.h>
 #include <libplacebo/renderer.h>
 #include <libplacebo/utils/libav.h>
 #include <libplacebo/utils/frame_queue.h>
@@ -143,6 +145,8 @@ enum var_name {
 /* per-input dynamic filter state */
 typedef struct LibplaceboInput {
     int idx;
+    struct dv_provider *provider;
+    struct pl_color_space display;
     pl_renderer renderer;
     pl_queue queue;
     enum pl_queue_status qstatus;
@@ -216,6 +220,8 @@ typedef struct LibplaceboContext {
     int fit_sense;
     int apply_filmgrain;
     int apply_dovi;
+    double target_peak, target_black;
+    int target_gamut;
     int colorspace;
     int color_range;
     int color_primaries;
@@ -568,6 +574,25 @@ static int libplacebo_init(AVFilterContext *avctx)
     LibplaceboContext *s = avctx->priv;
     const AVVulkanDeviceContext *vkhwctx = NULL;
 
+    if (s->target_peak > 0) {
+        if ((s->target_gamut != PL_COLOR_PRIM_BT_2020 &&
+             s->target_gamut != PL_COLOR_PRIM_DISPLAY_P3 &&
+             s->target_gamut != PL_COLOR_PRIM_BT_709) ||
+            s->target_black >= s->target_peak ||
+            (s->colorspace >= 0 && s->colorspace != AVCOL_SPC_BT2020_NCL) ||
+            (s->color_trc >= 0 && s->color_trc != AVCOL_TRC_SMPTE2084) ||
+            (s->color_primaries >= 0 && s->color_primaries != AVCOL_PRI_BT2020)) {
+            av_log(avctx, AV_LOG_ERROR, "An HDR display target requires BT.2020/PQ encoding and black below peak.\n");
+            return AVERROR(EINVAL);
+        }
+        s->colorspace = AVCOL_SPC_BT2020_NCL;
+        s->color_primaries = AVCOL_PRI_BT2020;
+        s->color_trc = AVCOL_TRC_SMPTE2084;
+    } else if (s->target_black || s->target_gamut != PL_COLOR_PRIM_BT_2020) {
+        av_log(avctx, AV_LOG_ERROR, "Set target_peak when specifying the export display.\n");
+        return AVERROR(EINVAL);
+    }
+
     if (s->normalize_sar && s->fit_mode != FIT_FILL) {
         av_log(avctx, AV_LOG_WARNING, "normalize_sar has no effect when using "
                "a fit mode other than 'fill'\n");
@@ -696,6 +721,22 @@ static int input_init(AVFilterContext *avctx, LibplaceboInput *input, int idx)
     input->queue = pl_queue_create(s->gpu);
     input->renderer = pl_renderer_create(s->log, s->gpu);
     input->idx = idx;
+    if (s->target_peak > 0) {
+        if (dv_provider_abi() != DV_PROVIDER_ABI)
+            return AVERROR_EXTERNAL;
+        input->provider = dv_provider_create(s->gpu, s->log);
+        if (!input->provider)
+            return AVERROR(ENOMEM);
+        input->display = (struct pl_color_space) {
+            .primaries = PL_COLOR_PRIM_BT_2020,
+            .transfer = PL_COLOR_TRC_PQ,
+            .hdr = {
+                .min_luma = s->target_black,
+                .max_luma = s->target_peak,
+                .prim = *pl_raw_primaries_get(s->target_gamut),
+            },
+        };
+    }
 
     return 0;
 }
@@ -703,6 +744,7 @@ static int input_init(AVFilterContext *avctx, LibplaceboInput *input, int idx)
 static void input_uninit(LibplaceboInput *input)
 {
     pl_renderer_destroy(&input->renderer);
+    dv_provider_destroy(&input->provider);
     pl_queue_destroy(&input->queue);
     av_fifo_freep2(&input->out_pts);
 }
@@ -980,6 +1022,45 @@ static void update_crops(AVFilterContext *ctx, LibplaceboInput *in,
 }
 
 /* Construct and emit an output frame for a given timestamp */
+/* A layered filter graph may render into a linear intermediate texture.
+ * The display for per-shot trims is the final export destination. */
+static int map_dovi_export(void *priv, pl_gpu gpu, const uint8_t *rpu, size_t size,
+                           const struct pl_color_space *intermediate, pl_tex master,
+                           pl_tex *mapped, struct pl_color_space *color)
+{
+    LibplaceboInput *in = priv;
+    return dv_provider_map(in->provider, gpu, rpu, size, &in->display, master, mapped, color);
+}
+
+static void reset_dovi_export(void *priv)
+{
+    LibplaceboInput *in = priv;
+    dv_provider_reset(in->provider);
+}
+
+static int set_export_metadata(AVFrame *out, const struct pl_color_space *display)
+{
+    const struct pl_raw_primaries *p = &display->hdr.prim;
+    const struct pl_cie_xy rgb[] = { p->red, p->green, p->blue };
+    AVMasteringDisplayMetadata *md;
+
+    av_frame_remove_side_data(out, AV_FRAME_DATA_MASTERING_DISPLAY_METADATA);
+    av_frame_remove_side_data(out, AV_FRAME_DATA_CONTENT_LIGHT_LEVEL);
+    md = av_mastering_display_metadata_create_side_data(out);
+    if (!md)
+        return AVERROR(ENOMEM);
+    for (int i = 0; i < 3; i++) {
+        md->display_primaries[i][0] = av_d2q(rgb[i].x, 50000);
+        md->display_primaries[i][1] = av_d2q(rgb[i].y, 50000);
+    }
+    md->white_point[0] = av_d2q(p->white.x, 50000);
+    md->white_point[1] = av_d2q(p->white.y, 50000);
+    md->min_luminance = av_d2q(display->hdr.min_luma, 10000000);
+    md->max_luminance = av_d2q(display->hdr.max_luma, 10000000);
+    md->has_luminance = md->has_primaries = 1;
+    return 0;
+}
+
 static int output_frame(AVFilterContext *ctx, int64_t pts)
 {
     int err = 0, ok, changed = 0;
@@ -1055,7 +1136,8 @@ static int output_frame(AVFilterContext *ctx, int64_t pts)
     /* Strip side data if no longer relevant */
     if (out->width != ref->width || out->height != ref->height)
         changed |= AV_SIDE_DATA_PROP_SIZE_DEPENDENT;
-    if (ref->color_trc != out->color_trc || ref->color_primaries != out->color_primaries)
+    if (s->target_peak > 0 || ref->color_trc != out->color_trc ||
+        ref->color_primaries != out->color_primaries)
         changed |= AV_SIDE_DATA_PROP_COLOR_DEPENDENT;
     av_frame_side_data_remove_by_props(&out->side_data, &out->nb_side_data, changed);
 
@@ -1072,6 +1154,16 @@ static int output_frame(AVFilterContext *ctx, int64_t pts)
     }
 
 props_done:
+    if (s->target_peak > 0) {
+        const AVHWFramesContext *hw = out->hw_frames_ctx
+            ? (const AVHWFramesContext *) out->hw_frames_ctx->data : NULL;
+        const AVPixFmtDescriptor *pixels = hw ? av_pix_fmt_desc_get(hw->sw_format) : outdesc;
+        /* Encode the destination, including on cleared frames. */
+        out->color_primaries = AVCOL_PRI_BT2020;
+        out->color_trc = AVCOL_TRC_SMPTE2084;
+        out->colorspace = pixels->flags & AV_PIX_FMT_FLAG_RGB ? AVCOL_SPC_RGB : AVCOL_SPC_BT2020_NCL;
+        RET(set_export_metadata(out, &s->inputs[0].display));
+    }
     out->pts = pts;
     if (s->fps.num)
         out->duration = 1;
@@ -1123,7 +1215,15 @@ props_done:
         }
         tmp_params.skip_caching_single_frame = high_fps;
         update_crops(ctx, in, &target, target_pts);
-        pl_render_image_mix(in->renderer, &in->mix, &target, &tmp_params);
+        if (in->provider && s->apply_dovi) {
+            tmp_params.dovi_map = map_dovi_export;
+            tmp_params.dovi_reset = reset_dovi_export;
+            tmp_params.dovi_priv = in;
+            tmp_params.dovi_signature = DV_PROVIDER_ABI;
+        }
+        if (!pl_render_image_mix(in->renderer, &in->mix, &target, &tmp_params)) {
+            goto render_failed;
+        }
 
         /* Force straight output and set correct blend operator. This is
          * required to get correct blending onto YUV target buffers. */
@@ -1140,11 +1240,13 @@ props_done:
         /* Blit the linear intermediate image to the output frame */
         target.crop = orig_target.crop = (struct pl_rect2df) {0};
         target.repr.alpha = PL_ALPHA_PREMULTIPLIED;
-        pl_render_image(s->linear_rr, &target, &orig_target, &opts->params);
+        if (!pl_render_image(s->linear_rr, &target, &orig_target, &opts->params))
+            goto render_failed;
         target = orig_target;
     } else if (!ref) {
         /* Render an empty image to clear the frame to the desired fill color */
-        pl_render_image(s->linear_rr, NULL, &target, &opts->params);
+        if (!pl_render_image(s->linear_rr, NULL, &target, &opts->params))
+            goto render_failed;
     }
 
     if (outdesc->flags & AV_PIX_FMT_FLAG_HWACCEL) {
@@ -1155,6 +1257,10 @@ props_done:
     }
     return ff_filter_frame(outlink, out);
 
+render_failed:
+    if (outdesc->flags & AV_PIX_FMT_FLAG_HWACCEL)
+        pl_unmap_avframe(s->gpu, &orig_target);
+    err = AVERROR_EXTERNAL;
 fail:
     av_frame_free(&out);
     return err;
@@ -1738,6 +1844,12 @@ static const AVOption libplacebo_options[] = {
     { "antiringing", "Antiringing strength (for non-EWA filters)", OFFSET(antiringing), AV_OPT_TYPE_FLOAT, {.dbl = 0.0}, 0.0, 1.0, DYNAMIC },
     { "sigmoid", "Enable sigmoid upscaling", OFFSET(sigmoid), AV_OPT_TYPE_BOOL, {.i64 = 1}, 0, 1, DYNAMIC },
     { "apply_filmgrain", "Apply film grain metadata", OFFSET(apply_filmgrain), AV_OPT_TYPE_BOOL, {.i64 = 1}, 0, 1, DYNAMIC },
+    { "target_peak", "Export display peak luminance in cd/m2 (zero leaves the export target unspecified)", OFFSET(target_peak), AV_OPT_TYPE_DOUBLE, {.dbl = 0}, 0, 10000, STATIC },
+    { "target_black", "Export display black luminance in cd/m2", OFFSET(target_black), AV_OPT_TYPE_DOUBLE, {.dbl = 0}, 0, 10000, STATIC },
+    { "target_gamut", "Export display gamut inside the BT.2020/PQ encoding", OFFSET(target_gamut), AV_OPT_TYPE_INT, {.i64 = PL_COLOR_PRIM_BT_2020}, 0, PL_COLOR_PRIM_COUNT - 1, STATIC, .unit = "export_gamut" },
+        { "bt2020", "Rec. 2020", 0, AV_OPT_TYPE_CONST, {.i64 = PL_COLOR_PRIM_BT_2020}, 0, 0, STATIC, .unit = "export_gamut" },
+        { "p3", "Display P3 (D65)", 0, AV_OPT_TYPE_CONST, {.i64 = PL_COLOR_PRIM_DISPLAY_P3}, 0, 0, STATIC, .unit = "export_gamut" },
+        { "bt709", "Rec. 709", 0, AV_OPT_TYPE_CONST, {.i64 = PL_COLOR_PRIM_BT_709}, 0, 0, STATIC, .unit = "export_gamut" },
     { "apply_dolbyvision", "Apply Dolby Vision metadata", OFFSET(apply_dovi), AV_OPT_TYPE_BOOL, {.i64 = 1}, 0, 1, DYNAMIC },
 
     { "deinterlace", "Deinterlacing mode", OFFSET(deinterlace), AV_OPT_TYPE_INT, {.i64 = PL_DEINTERLACE_WEAVE}, 0, PL_DEINTERLACE_ALGORITHM_COUNT - 1, DYNAMIC, .unit = "deinterlace" },
