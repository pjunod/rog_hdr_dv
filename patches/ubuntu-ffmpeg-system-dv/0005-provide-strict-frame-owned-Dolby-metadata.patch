--- /dev/null
+++ b/libavcodec/dovi_parser.h
@@ -0,0 +1,59 @@
+/*
+ * Public Dolby Vision HEVC RPU resolver
+ * Copyright (C) 2026 ROG HDR contributors
+ *
+ * This file is part of FFmpeg, licensed under the GNU Lesser General Public
+ * License, version 2.1 or later. See COPYING.LGPLv2.1.
+ */
+#ifndef AVCODEC_DOVI_PARSER_H
+#define AVCODEC_DOVI_PARSER_H
+/* HEVC decoder option dovi_metadata_strict=1 marks only the current matched
+ * raw RPU side data after strict CRC/reference processing. Default decoders
+ * never emit this provenance. Rejected Dolby metadata does not reject video. */
+#define AV_DOVI_METADATA_STRICT_KEY "lavc.dovi.strict"
+#define AV_DOVI_METADATA_STRICT_VALUE "crc+references-v1"
+#include <stddef.h>
+#include <stdint.h>
+#include "libavutil/dovi_meta.h"
+/**
+ * Opaque, stream-owned Dolby Vision RPU state. Resolve in decode order, before
+ * picture reordering. The context is not thread-safe. No private layout is
+ * public; returned snapshots have no dependency on the context's lifetime.
+ */
+typedef struct AVDoviRpuParser AVDoviRpuParser;
+/** Allocate a resolver. logctx is an optional av_log-compatible context. */
+AVDoviRpuParser *av_dovi_rpu_parser_alloc(void *logctx);
+/**
+ * Replace stream configuration and discard all prior metadata state.
+ * NULL/zero clears configuration and enables HEVC profile guessing.
+ * config_size must cover the fields through dv_md_compression. The record is
+ * copied, never retained. AV1/EMDF (profile 10) is outside this HEVC API.
+ * Any error also discards prior state.
+ */
+int av_dovi_rpu_parser_configure(AVDoviRpuParser *parser,
+                                const AVDOVIDecoderConfigurationRecord *config,
+                                size_t config_size);
+/** Discard every mapping/DM reference at flush, seek or a stream boundary.
+ * The configured stream record and logctx are preserved. */
+void av_dovi_rpu_parser_flush(AVDoviRpuParser *parser);
+/** Free a resolver and set *parser to NULL. */
+void av_dovi_rpu_parser_free(AVDoviRpuParser **parser);
+/**
+ * Resolve one HEVC RPU from the original escaped NAL payload, beginning with
+ * 0x19, excluding start codes/length prefixes and the two-byte NAL header.
+ * payload_size is bounded to 65536 bytes. Input is borrowed only for this call.
+ *
+ * On success return 0 and place an allocated, complete public AVDOVIMetadata
+ * snapshot in *metadata and its allocation size in *metadata_size. The caller
+ * frees it with av_free(). No serialized private data or decoder frame is
+ * returned. On failure return a negative AVERROR, clear both outputs, and
+ * discard all inherited state. Missing references are errors: strict mode
+ * never substitutes another mapping ID. CRC and bitstream errors are fatal.
+ *
+ * Call only for the current picture's RPU. A metadata gap produces no call and
+ * no snapshot. It does not resolve to the last successfully parsed picture.
+ */
+int av_dovi_rpu_parser_parse(AVDoviRpuParser *parser,
+                            const uint8_t *payload, size_t payload_size,
+                            AVDOVIMetadata **metadata, size_t *metadata_size);
+#endif
