diff --git a/libavcodec/dovi_parser.c b/libavcodec/dovi_parser.c
new file mode 100644
index 00000000..6e6dbd52
--- /dev/null
+++ b/libavcodec/dovi_parser.c
@@ -0,0 +1,165 @@
+/*
+ * Public Dolby Vision HEVC RPU resolver
+ * Copyright (C) 2026 ROG HDR contributors
+ *
+ * This file is part of FFmpeg, licensed under the GNU Lesser General Public
+ * License, version 2.1 or later. See COPYING.LGPLv2.1.
+ */
+#include <errno.h>
+#include <stddef.h>
+#include <string.h>
+#include "libavutil/error.h"
+#include "libavutil/mem.h"
+#include "dovi_parser.h"
+#include "dovi_rpu.h"
+
+struct AVDoviRpuParser {
+    DOVIContext context;
+    AVDOVIDecoderConfigurationRecord config;
+};
+
+AVDoviRpuParser *av_dovi_rpu_parser_alloc(void *logctx)
+{
+    AVDoviRpuParser *parser = av_mallocz(sizeof(*parser));
+    if (parser)
+        parser->context.logctx = logctx;
+    return parser;
+}
+
+void av_dovi_rpu_parser_flush(AVDoviRpuParser *parser)
+{
+    if (parser) {
+        ff_dovi_ctx_flush(&parser->context);
+        /* Parse error paths can unref the entire internal context. Keep the
+         * public API's configured stream record authoritative across them. */
+        parser->context.cfg = parser->config;
+    }
+}
+
+void av_dovi_rpu_parser_free(AVDoviRpuParser **parser)
+{
+    if (parser && *parser) {
+        ff_dovi_ctx_unref(&(*parser)->context);
+        av_freep(parser);
+    }
+}
+
+int av_dovi_rpu_parser_configure(AVDoviRpuParser *parser,
+                                const AVDOVIDecoderConfigurationRecord *config,
+                                size_t config_size)
+{
+    if (!parser)
+        return AVERROR(EINVAL);
+    av_dovi_rpu_parser_flush(parser);
+    memset(&parser->config, 0, sizeof(parser->config));
+    memset(&parser->context.cfg, 0, sizeof(parser->context.cfg));
+    if (!config)
+        return config_size ? AVERROR(EINVAL) : 0;
+    if (config_size < offsetof(AVDOVIDecoderConfigurationRecord, dv_md_compression) +
+                      sizeof(config->dv_md_compression) ||
+        config->dv_profile > 9 || config->rpu_present_flag > 1 ||
+        config->el_present_flag > 1 || config->bl_present_flag > 1 ||
+        config->dv_md_compression > AV_DOVI_COMPRESSION_EXTENDED)
+        return AVERROR(EINVAL);
+#define COPY(field) parser->config.field = config->field
+    COPY(dv_version_major); COPY(dv_version_minor); COPY(dv_profile);
+    COPY(dv_level); COPY(rpu_present_flag); COPY(el_present_flag);
+    COPY(bl_present_flag); COPY(dv_bl_signal_compatibility_id);
+    COPY(dv_md_compression);
+#undef COPY
+    parser->context.cfg = parser->config;
+    return 0;
+}
+
+static int complete_metadata(const AVDOVIMetadata *metadata)
+{
+    const AVDOVIColorMetadata *color = av_dovi_get_color(metadata);
+    /* Compressed DM without its required prior full DM must not publish
+     * zero-initialized matrix fields as if they were a resolved picture. */
+    if (color->signal_bit_depth < 8 || color->signal_bit_depth > 16)
+        return 0;
+    for (int i = 0; i < 9; i++)
+        if (color->ycc_to_rgb_matrix[i].den <= 0 || color->rgb_to_lms_matrix[i].den <= 0)
+            return 0;
+    for (int i = 0; i < 3; i++)
+        if (color->ycc_to_rgb_offset[i].den <= 0)
+            return 0;
+    for (int i = 0; i < metadata->num_ext_blocks; i++) {
+        switch (av_dovi_get_ext(metadata, i)->level) {
+        case 1: case 2: case 3: case 4: case 5: case 6: case 8: case 9:
+        case 10: case 11: case 254: case 255: break;
+        default: return 0; /* Decoder skipped an unknown extension's values. */
+        }
+    }
+    return 1;
+}
+
+int av_dovi_rpu_parser_parse(AVDoviRpuParser *parser,
+                            const uint8_t *payload, size_t payload_size,
+                            AVDOVIMetadata **metadata, size_t *metadata_size)
+{
+    uint8_t *rbsp = NULL;
+    size_t length = 0;
+    unsigned zeros = 0;
+    int ret = AVERROR_INVALIDDATA;
+    if (metadata)
+        *metadata = NULL;
+    if (metadata_size)
+        *metadata_size = 0;
+    if (!parser)
+        return AVERROR(EINVAL);
+    if (!metadata || !metadata_size || !payload || payload_size < 7 ||
+        payload_size > 65536 || payload[0] != 0x19)
+        goto fail;
+    /* HEVC trailing_zero_8bits are outside the RPU. Keep the original bytes
+     * with the caller; only this bounded parser copy is unescaped/trimmed. */
+    while (payload_size && !payload[payload_size - 1])
+        payload_size--;
+    if (payload_size < 7)
+        goto fail;
+    rbsp = av_mallocz(payload_size + AV_INPUT_BUFFER_PADDING_SIZE);
+    if (!rbsp) {
+        ret = AVERROR(ENOMEM);
+        goto fail;
+    }
+    for (size_t i = 0; i < payload_size; i++) {
+        uint8_t byte = payload[i];
+        if (zeros == 2 && byte == 3) {
+            if (i + 1 == payload_size || payload[i + 1] > 3)
+                goto fail;
+            zeros = 0;
+            continue;
+        }
+        if (zeros == 2 && byte < 3)
+            goto fail;
+        rbsp[length++] = byte;
+        zeros = byte ? 0 : zeros + 1;
+    }
+    /* The internal decoder intentionally ignores unknown RPU types, retaining
+     * its prior state. This fresh-picture API must never publish that state. */
+    if (length < 7 || (rbsp[1] >> 2) != 2)
+        goto fail;
+    ret = ff_dovi_rpu_parse(&parser->context, rbsp, length,
+                           AV_EF_CRCCHECK | AV_EF_EXPLODE);
+    if (ret < 0)
+        goto fail;
+    ret = ff_dovi_get_metadata(&parser->context, metadata);
+    if (ret <= 0) {
+        if (!ret)
+            ret = AVERROR_INVALIDDATA;
+        goto fail;
+    }
+    if (!complete_metadata(*metadata)) {
+        ret = AVERROR_INVALIDDATA;
+        goto fail;
+    }
+    *metadata_size = ret;
+    av_free(rbsp);
+    return 0;
+fail:
+    if (metadata)
+        av_freep(metadata);
+    av_free(rbsp);
+    av_dovi_rpu_parser_flush(parser);
+    return ret;
+}
