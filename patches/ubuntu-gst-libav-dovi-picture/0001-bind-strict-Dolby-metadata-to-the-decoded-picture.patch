+          data ? data->dovi_epoch : ffmpegdec->dovi_epoch,
+          output_frame->system_frame_number, NULL);
+    }
+    if (dovi) {
+      const GstDoviGeometry *geometry = gst_dovi_picture_get_geometry (dovi);
+      if (geometry->x || geometry->y || geometry->width != geometry->coded_width ||
+          geometry->height != geometry->coded_height) {
+        /* A direct-render GstBuffer can still name the uncropped allocation,
+         * although FFmpeg moved its AVFrame planes. Copy the complete active
+         * image from those exact planes before attaching the source snapshot. */
+        GstBuffer *coded = output_frame->output_buffer;
