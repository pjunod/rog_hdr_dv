+        gst_buffer_unref (coded);
+        if (*ret != GST_FLOW_OK) {
+          gst_dovi_picture_unref (dovi);
+          goto no_output;
+        }
+      }
+      gst_buffer_add_dovi_picture_meta (output_frame->output_buffer, dovi);
+      gst_dovi_picture_unref (dovi);
+    }
+  }
