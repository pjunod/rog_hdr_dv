+  /* Publish only the metadata owned by this exact received AVFrame. The
+   * allocation/copy path above has completed; never borrow decoder storage. */
+  {
+    GstDoviPicture *dovi = NULL;
+    GstDoviPictureMeta *old;
+    AVFrame *decoded = ffmpegdec->picture;
+    output_frame->output_buffer =
+        gst_buffer_make_writable (output_frame->output_buffer);
+    while ((old = gst_buffer_get_dovi_picture_meta (output_frame->output_buffer)))
+      gst_buffer_remove_meta (output_frame->output_buffer, &old->meta);
+    if (!ffmpegdec->lowres &&
+        !decoded->crop_left && !decoded->crop_right &&
+        !decoded->crop_top && !decoded->crop_bottom &&
+        decoded->width == GST_VIDEO_INFO_WIDTH (&ffmpegdec->output_state->info) &&
+        decoded->height == GST_VIDEO_INFO_HEIGHT (&ffmpegdec->output_state->info))
+    {
+      GstFFMpegVidDecCodecFrameData *data = gst_video_codec_frame_get_user_data (output_frame);
+      dovi = gst_dovi_picture_from_avframe_with_config (decoded, NULL,
