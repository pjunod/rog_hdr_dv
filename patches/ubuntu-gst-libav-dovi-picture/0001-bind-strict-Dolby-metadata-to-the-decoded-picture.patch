+            &data->dovi_config, &data->dovi_config_bytes);
+    data->dovi_epoch = ffmpegdec->dovi_epoch;
+    /* An absent/incomplete record is an explicit clear, never 'no update'. */
+    uint8_t *side = av_packet_new_side_data (packet, AV_PKT_DATA_DOVI_CONF,
