+static void
+dovi_reset (GstVaH265Dec *self)
+{
+  if (self->dovi_resolver)
+    gst_dovi_resolver_reset (self->dovi_resolver);
+  self->dovi_generation++;
+}
+
+static gboolean
+gst_va_h265_dec_flush (GstVideoDecoder *decoder)
+{
+  GstVideoDecoderClass *parent = GST_VIDEO_DECODER_CLASS (parent_class);
+  GST_VA_H265_DEC (decoder)->dovi_config_ready = FALSE;
+  dovi_reset (GST_VA_H265_DEC (decoder));
+  return !parent->flush || parent->flush (decoder);
+}
+
+static void
+dovi_configure_from_caps (GstVaH265Dec *self)
+{
+  GstH265Decoder *decoder = GST_H265_DECODER (self);
+  AVDOVIDecoderConfigurationRecord config;
+  GBytes *bytes = NULL;
+  gboolean known = self->dovi_config_ready && decoder->input_state &&
+      gst_dovi_caps_get_stream_config (decoder->input_state->caps, &config, &bytes);
+  if (self->dovi_resolver)
+    gst_dovi_resolver_configure (self->dovi_resolver, known ? &config : NULL,
+        known ? sizeof (config) : 0, NULL);
+  g_clear_pointer (&bytes, g_bytes_unref);
+}
+static gboolean
+gst_va_h265_dec_sink_event (GstVideoDecoder *decoder, GstEvent *event)
+{
+  GstVaH265Dec *self = GST_VA_H265_DEC (decoder);
+  GstH265Decoder *h265 = GST_H265_DECODER (decoder);
+  GstVideoDecoderClass *parent = GST_VIDEO_DECODER_CLASS (parent_class);
+  GstEventType type = GST_EVENT_TYPE (event);
+  if (type == GST_EVENT_CAPS) {
+    AVDOVIDecoderConfigurationRecord ignored;
+    GBytes *before = NULL, *after = NULL;
+    gboolean was_ready = self->dovi_config_ready && !self->dovi_new_stream;
+    if (h265->input_state)
+      gst_dovi_caps_get_stream_config (h265->input_state->caps, &ignored, &before);
+    gboolean accepted = !parent->sink_event || parent->sink_event (decoder, event);
+    if (accepted && h265->input_state)
+      gst_dovi_caps_get_stream_config (h265->input_state->caps, &ignored, &after);
+    gboolean changed = (!before != !after) ||
+        (before && after && !g_bytes_equal (before, after));
+    self->dovi_new_stream = FALSE;
+    self->dovi_config_ready = accepted && h265->input_state != NULL;
+    if (!accepted || changed || !was_ready) {
+      dovi_reset (self);
+      dovi_configure_from_caps (self);
+    }
+    if (accepted && h265->input_state) {
+      GstVaBaseDec *base = GST_VA_BASE_DEC (self);
+      g_clear_pointer (&base->input_state, gst_video_codec_state_unref);
+      base->input_state = gst_video_codec_state_ref (h265->input_state);
+      base->need_negotiation = TRUE;
+    }
+    g_clear_pointer (&before, g_bytes_unref);
+    g_clear_pointer (&after, g_bytes_unref);
+    return accepted;
+  }
+  if (type == GST_EVENT_STREAM_START) {
+    self->dovi_new_stream = TRUE;
+    self->dovi_config_ready = FALSE;
+    dovi_reset (self);
+  } else if (type == GST_EVENT_SEGMENT && !self->dovi_new_stream) {
+    self->dovi_config_ready = TRUE;
+    dovi_configure_from_caps (self);
+  }
+  /* FLUSH_START is not serialized. Derived state is invalidated exclusively
+   * in the serialized flush callback, never by racing streaming state here. */
+  return !parent->sink_event || parent->sink_event (decoder, event);
+}
+
+static gboolean
+gst_va_h265_dec_stop (GstVideoDecoder *decoder)
+{
+  GstVideoDecoderClass *parent = GST_VIDEO_DECODER_CLASS (parent_class);
+  dovi_reset (GST_VA_H265_DEC (decoder));
+  return !parent->stop || parent->stop (decoder);
+}
