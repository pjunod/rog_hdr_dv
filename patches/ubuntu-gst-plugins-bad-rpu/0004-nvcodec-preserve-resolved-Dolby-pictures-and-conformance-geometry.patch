+    gst_buffer_remove_meta (frame->output_buffer, &old->meta);
+  if (!snapshot || snapshot->generation != self->dovi_generation)
+    return;
+  const GstDoviGeometry *g = gst_dovi_picture_get_geometry (snapshot->picture);
+  GstVideoMeta *video = gst_buffer_get_video_meta (frame->output_buffer);
+  GstVideoCropMeta *crop = gst_buffer_get_video_crop_meta (frame->output_buffer);
+  /* CUVID display_area materializes the active SPS window at origin zero. */
+  if (g->width == self->width && g->height == self->height &&
+      (!video || (video->width == g->width && video->height == g->height)) &&
+      (!crop || (!crop->x && !crop->y && crop->width == g->width &&
+          crop->height == g->height)))
