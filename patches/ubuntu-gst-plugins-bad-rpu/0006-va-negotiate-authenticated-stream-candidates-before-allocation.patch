@@ -0,0 +1,140 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef GST_VA_BASE_DEC_DOVI_H
+#define GST_VA_BASE_DEC_DOVI_H
+
+#include <gst/video/video.h>
+#include <gstdovipicture.h>
+
+/* This selects only clear coded single-layer HEVC routes understood by the VA
+ * producer. It does not qualify a picture, invent an RPU or certify an EL. */
+static inline GBytes *
+gst_va_dovi_qualified_configuration (const GstCaps *coded)
+{
+  AVDOVIDecoderConfigurationRecord config;
+  GBytes *bytes = NULL;
+  if (!coded || !gst_caps_is_fixed (coded) ||
+      gst_caps_get_size (coded) != 1 ||
+      !gst_structure_has_name (gst_caps_get_structure (coded, 0), "video/x-h265") ||
+      !gst_dovi_caps_get_stream_config (coded, &config, &bytes) ||
+      g_bytes_get_size (bytes) != 24 ||
+      !config.rpu_present_flag || !config.bl_present_flag ||
+      config.el_present_flag ||
+      config.dv_md_compression != AV_DOVI_COMPRESSION_NONE ||
+      !((config.dv_profile == 5 && config.dv_bl_signal_compatibility_id == 0) ||
+        (config.dv_profile == 8 && config.dv_bl_signal_compatibility_id == 1))) {
+    g_clear_pointer (&bytes, g_bytes_unref);
+    return NULL;
+  }
+  return bytes;
+}
+
+/* Preserve the decoder's real formats, features and DRM modifier alternatives.
+ * Only the exact parser-transmitted configuration is added before querying a
+ * consumer. In particular, this VA producer never manufactures a FEL marker. */
+static inline GstCaps *
+gst_va_dovi_query_allowed (GstPad *src, const GstCaps *real,
+    const GstVideoInfo *geometry, GBytes *configuration)
+{
+  GstCaps *peer, *allowed;
+  if (!real || gst_caps_is_any (real))
+    return gst_caps_new_empty ();
+  GstCaps *marked = gst_caps_copy (real);
+  for (guint i = gst_caps_get_size (marked); i > 0; i--) {
+    if (gst_caps_features_is_any (gst_caps_get_features (marked, i - 1)) ||
+        !gst_structure_has_name (gst_caps_get_structure (marked, i - 1),
+            "video/x-raw"))
+      gst_caps_remove_structure (marked, i - 1);
+  }
+  if (geometry) {
+    GstCaps *bounds = gst_caps_new_empty_simple ("video/x-raw");
+    GstStructure *st = gst_caps_get_structure (bounds, 0);
+    gst_caps_set_features_simple (bounds, gst_caps_features_new_any ());
+    if (GST_VIDEO_INFO_WIDTH (geometry) > 0)
+      gst_structure_set (st, "width", G_TYPE_INT,
+          GST_VIDEO_INFO_WIDTH (geometry), NULL);
+    if (GST_VIDEO_INFO_HEIGHT (geometry) > 0)
+      gst_structure_set (st, "height", G_TYPE_INT,
+          GST_VIDEO_INFO_HEIGHT (geometry), NULL);
+    if (GST_VIDEO_INFO_FPS_N (geometry) > 0 && GST_VIDEO_INFO_FPS_D (geometry) > 0)
+      gst_structure_set (st, "framerate", GST_TYPE_FRACTION,
+          GST_VIDEO_INFO_FPS_N (geometry), GST_VIDEO_INFO_FPS_D (geometry), NULL);
+    if (GST_VIDEO_INFO_PAR_N (geometry) > 0 && GST_VIDEO_INFO_PAR_D (geometry) > 0)
+      gst_structure_set (st, "pixel-aspect-ratio", GST_TYPE_FRACTION,
+          GST_VIDEO_INFO_PAR_N (geometry), GST_VIDEO_INFO_PAR_D (geometry), NULL);
+    allowed = gst_caps_intersect_full (marked, bounds, GST_CAPS_INTERSECT_FIRST);
+    gst_caps_unref (marked);
+    gst_caps_unref (bounds);
+    marked = allowed;
+  }
+  gst_dovi_caps_apply_stream_config (marked, configuration);
+  for (guint i = 0; i < gst_caps_get_size (marked); i++)
+    gst_structure_remove_field (gst_caps_get_structure (marked, i),
+        "dovi-fel-decoder");
+  if (gst_pad_is_linked (src)) {
+    peer = gst_pad_peer_query_caps (src, marked);
+    allowed = peer ? gst_caps_intersect_full (marked, peer,
+        GST_CAPS_INTERSECT_FIRST) : gst_caps_new_empty ();
+    gst_clear_caps (&peer);
+  } else {
+    /* Decodebin may expose a pad before its final filter chain is linked.
+     * This remains provisional and is revalidated before allocation. */
+    allowed = gst_caps_ref (marked);
+  }
+  gst_caps_unref (marked);
+  return allowed;
+}
+
+static inline gboolean
+gst_va_dovi_same_configuration (const GstCaps *caps, GBytes *configuration)
+{
+  AVDOVIDecoderConfigurationRecord ignored;
+  GBytes *actual = NULL;
+  gboolean known = gst_dovi_caps_get_stream_config (caps, &ignored, &actual);
+  gboolean same = known && actual && configuration &&
+      g_bytes_equal (actual, configuration);
+  g_clear_pointer (&actual, g_bytes_unref);
+  return same;
+}
+
+typedef gboolean (*GstVaDoviCandidateFunc) (GstCaps *candidate, gpointer data);
+
+/* Walk every actual alternative in the decoder's existing domain order. A
+ * rejected fixed modifier/format does not prevent trying the remaining ones. */
+static inline gboolean
+gst_va_dovi_foreach_candidate (const GstCaps *allowed,
+    GstVaDoviCandidateFunc accept, gpointer data)
+{
+  const gchar *domains[] = {
+    "memory:VAMemory", "memory:DMABuf", GST_CAPS_FEATURE_MEMORY_SYSTEM_MEMORY
+  };
+  for (guint domain = 0; domain < G_N_ELEMENTS (domains); domain++) {
+    for (guint i = 0; i < gst_caps_get_size (allowed); i++) {
+      const GstCapsFeatures *features = gst_caps_get_features (allowed, i);
+      if (gst_caps_features_is_any (features) ||
+          !gst_caps_features_contains (features, domains[domain]))
+        continue;
+      const gchar *field = domain == 1 ? "drm-format" : "format";
+      const GValue *formats = gst_structure_get_value (
+          gst_caps_get_structure (allowed, i), field);
+      if (!formats)
+        continue;
+      guint count = GST_VALUE_HOLDS_LIST (formats) ?
+          gst_value_list_get_size (formats) : 1;
+      for (guint j = 0; j < count; j++) {
+        const GValue *value = GST_VALUE_HOLDS_LIST (formats) ?
+            gst_value_list_get_value (formats, j) : formats;
+        if (!G_VALUE_HOLDS_STRING (value))
+          continue;
+        GstCaps *candidate = gst_caps_copy_nth (allowed, i);
+        gst_structure_set_value (gst_caps_get_structure (candidate, 0),
+            field, value);
+        gboolean accepted = accept (candidate, data);
+        gst_caps_unref (candidate);
+        if (accepted)
+          return TRUE;
+      }
+    }
+  }
+  return FALSE;
+}
+#endif
