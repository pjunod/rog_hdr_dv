+static gboolean
+_dovi_try_output_state (GstCaps *candidate, gpointer data)
+{
+  DoviOutput *output = data;
+  GstVaBaseDec *base = output->base;
+  GstVideoDecoder *decoder = GST_VIDEO_DECODER (base);
+  GstVideoFormat format = GST_VIDEO_FORMAT_UNKNOWN;
+  GstCapsFeatures *features = NULL;
+  guint64 modifier = 0;
+  DoviSelect select = {base, &format, &features, &modifier};
+  if (!_dovi_select_fields (candidate, &select))
+    return FALSE;
+  if (base->output_state) {
+    gst_video_codec_state_unref (base->output_state);
+    base->output_state = NULL;
+  }
+  base->output_state = gst_video_decoder_set_interlaced_output_state (decoder,
+      format, GST_VIDEO_INFO_INTERLACE_MODE (&base->output_info),
+      GST_VIDEO_INFO_WIDTH (&base->output_info),
+      GST_VIDEO_INFO_HEIGHT (&base->output_info), base->input_state);
+  if (!base->output_state) {
+    gst_caps_features_free (features);
+    return FALSE;
+  }
+  base->output_state->caps = gst_caps_features_contains (features,
+      GST_CAPS_FEATURE_MEMORY_DMABUF) ?
+      gst_va_video_info_to_dma_caps (&base->output_state->info, modifier) :
+      gst_video_info_to_caps (&base->output_state->info);
+  if (!base->output_state->caps) {
+    gst_caps_features_free (features);
+    goto reject;
+  }
+  gst_caps_set_features_simple (base->output_state->caps, features);
+  gst_dovi_caps_apply_stream_config (base->output_state->caps,
+      output->configuration);
+  if (!gst_caps_is_subset (base->output_state->caps, candidate))
+    goto reject;
+  if (gst_pad_is_linked (GST_VIDEO_DECODER_SRC_PAD (decoder)) &&
+      !gst_pad_peer_query_accept_caps (GST_VIDEO_DECODER_SRC_PAD (decoder),
+          base->output_state->caps))
+    goto reject;
+  GST_INFO_OBJECT (base, "Negotiated marked caps %" GST_PTR_FORMAT,
+      base->output_state->caps);
+  return TRUE;
+reject:
+  gst_video_codec_state_unref (base->output_state);
+  base->output_state = NULL;
+  return FALSE;
+}
