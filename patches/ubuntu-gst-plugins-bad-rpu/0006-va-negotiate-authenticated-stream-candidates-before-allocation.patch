 static gboolean
+gst_va_base_dec_negotiate_dovi (GstVideoDecoder *decoder)
+{
+  GstVaBaseDec *base = GST_VA_BASE_DEC (decoder);
+  GstVideoDecoderClass *parent =
+      GST_VIDEO_DECODER_CLASS (GST_VA_BASE_DEC_GET_PARENT_CLASS (decoder));
+  for (guint attempt = 0; attempt < 2; attempt++) {
+    if (base->need_negotiation || !base->output_state) {
+      /* A downstream reconfigure can change memory without changing the coded
+       * profile or dimensions; do not reopen matching hardware. */
+      if (!gst_va_decoder_config_is_equal (base->decoder, base->profile,
+              base->rt_format, base->width, base->height)) {
+        if (gst_va_decoder_is_open (base->decoder) &&
+            !gst_va_decoder_close (base->decoder))
+          return FALSE;
+        if (!gst_va_decoder_open (base->decoder, base->profile, base->rt_format) ||
+            !gst_va_decoder_set_frame_size (base->decoder, base->width,
+                base->height))
+          return FALSE;
+      }
+      if (!gst_va_base_dec_set_output_state (base)) {
+        base->need_negotiation = TRUE;
+        return FALSE;
+      }
+      base->need_negotiation = FALSE;
+    }
+    if (parent->negotiate (decoder))
+      return TRUE;
+    /* Initial decodebin exposure may only have seen a provisional template
+     * peer. Retry once against the now-linked chain, before any allocation. */
+    base->need_negotiation = TRUE;
+    if (!gst_pad_is_linked (GST_VIDEO_DECODER_SRC_PAD (decoder)))
+      break;
+  }
+  return FALSE;
+}
