 static void
 gst_va_base_dec_get_property (GObject * object, guint prop_id,
     GValue * value, GParamSpec * pspec)
@@ -796,6 +780,12 @@ gst_va_base_dec_negotiate (GstVideoDecoder * decoder)
   GBytes *configuration = _dovi_qualified_configuration (base);
   if (configuration) {
     g_bytes_unref (configuration);
+    /* A qualified stream recomputes its marked output state on every
