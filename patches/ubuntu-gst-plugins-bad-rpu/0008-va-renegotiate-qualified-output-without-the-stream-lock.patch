   return allowed;
 }
 
-static gboolean
-gst_va_base_dec_src_event (GstVideoDecoder *decoder, GstEvent *event)
-{
-  GstVaBaseDec *base = GST_VA_BASE_DEC (decoder);
-  if (GST_EVENT_TYPE (event) == GST_EVENT_RECONFIGURE) {
-    GST_VIDEO_DECODER_STREAM_LOCK (decoder);
