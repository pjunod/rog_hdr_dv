+/* ACCEPT_CAPS is shallow by design: a passthrough-capable converter (such as
+ * the one playsink puts in front of a video filter) answers it from its pad
+ * templates without asking the consumer behind it. A marked output must be
+ * accepted by the whole linked chain, so also require a filtered CAPS query,
+ * which every element answers for its downstream, to keep the exact caps.
+ * The pad helpers read a failed query as acceptance (ACCEPT_CAPS) or as the
+ * filter itself (CAPS); a linked peer that answers neither has accepted
+ * nothing, so both queries are issued directly and a failure rejects. */
+static inline gboolean
+gst_va_dovi_peer_accepts (GstPad *src, GstCaps *caps)
+{
+  GstQuery *query = gst_query_new_accept_caps (caps);
+  gboolean accepted = gst_pad_peer_query (src, query);
+  if (accepted)
+    gst_query_parse_accept_caps_result (query, &accepted);
+  gst_query_unref (query);
+  if (!accepted)
+    return FALSE;
+  query = gst_query_new_caps (caps);
+  accepted = gst_pad_peer_query (src, query);
+  if (accepted) {
+    GstCaps *peer = NULL;
+    gst_query_parse_caps_result (query, &peer);
+    accepted = peer && gst_caps_can_intersect (caps, peer);
+  }
+  gst_query_unref (query);
+  return accepted;
+}
