+/* Must be called with lock held. */
+static void
+remove_subtitle_refresh_source (GstPlay * self)
+{
+  if (self->subtitle_refresh_source) {
+    g_source_destroy (self->subtitle_refresh_source);
+    g_source_unref (self->subtitle_refresh_source);
+    self->subtitle_refresh_source = NULL;
+  }
+}
+
+static void
+cancel_subtitle_refresh (GstPlay * self)
+{
+  remove_subtitle_refresh_source (self);
+  self->subtitle_refresh_pending = FALSE;
+  self->subtitle_refresh_seqnum = GST_SEQNUM_INVALID;
+}
+
+static gboolean
+refresh_paused_subtitles (gpointer user_data)
+{
+  GstPlay *self = GST_PLAY (user_data);
+  gint64 position = -1;
+  guint32 seqnum;
+  gchar *uri;
+  gboolean queried;
+
+  g_mutex_lock (&self->lock);
+  if (self->subtitle_refresh_source != g_main_current_source ())
+    goto done;
+  remove_subtitle_refresh_source (self);
+  /* An already dispatched seek may still preroll the old selection. Retry the
+   * intent only when that seek completes; a later explicit seek cancels it. */
+  if (self->seek_pending || !self->subtitle_refresh_pending)
+    goto done;
+  if (self->seek_source || self->seek_position != GST_CLOCK_TIME_NONE ||
+      self->target_state != GST_STATE_PAUSED ||
+      self->current_state != GST_STATE_PAUSED || self->is_live || self->is_eos ||
+      !self->media_info || !self->media_info->seekable) {
+    cancel_subtitle_refresh (self);
+    goto done;
+  }
+  seqnum = self->subtitle_refresh_seqnum;
+  uri = g_strdup (self->uri);
+  g_mutex_unlock (&self->lock);
+  queried = gst_element_query_position (self->playbin, GST_FORMAT_TIME, &position);
+  g_mutex_lock (&self->lock);
+  if (queried && position >= 0 && self->subtitle_refresh_pending &&
+      self->subtitle_refresh_seqnum == seqnum && self->selection_seqnum == seqnum &&
+      g_strcmp0 (uri, self->uri) == 0 && self->target_state == GST_STATE_PAUSED &&
+      self->current_state == GST_STATE_PAUSED && !self->is_live && !self->is_eos &&
+      self->media_info && self->media_info->seekable && !self->seek_pending &&
+      !self->seek_source && self->seek_position == GST_CLOCK_TIME_NONE) {
+    cancel_subtitle_refresh (self);
+    self->seek_position = position;
+    gst_play_seek_internal_locked (self, TRUE);
+  } else if (self->subtitle_refresh_seqnum == seqnum) {
+    /* Never retain an unactionable generation for an unrelated later pause. */
+    cancel_subtitle_refresh (self);
+  }
+  g_free (uri);
+done:
+  g_mutex_unlock (&self->lock);
+  return G_SOURCE_REMOVE;
+}
+
+static void
+queue_subtitle_refresh (GstPlay * self)
+{
+  if (self->subtitle_refresh_pending && !self->subtitle_refresh_source) {
+    self->subtitle_refresh_source = g_idle_source_new ();
+    g_source_set_callback (self->subtitle_refresh_source,
+        refresh_paused_subtitles, self, NULL);
+    g_source_attach (self->subtitle_refresh_source, self->context);
+  }
+}
