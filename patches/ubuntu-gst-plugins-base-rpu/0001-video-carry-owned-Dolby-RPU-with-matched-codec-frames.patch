From 906fd88fde0187ec51baeea28bc7ddda90969226 Mon Sep 17 00:00:00 2001
From: ROG HDR contributors <rog-hdr@invalid>
Date: Sat, 7 Nov 2026 19:23:23 -0500
Subject: [PATCH] feat(video): carry owned Dolby RPU with matched codec frames

---
 gst-libs/gst/video/gstvideodecoder.c     |  12 +++
 gst-libs/gst/video/gstvideodovirpumeta.c | 115 +++++++++++++++++++++++
 gst-libs/gst/video/gstvideodovirpumeta.h |  74 +++++++++++++++
 gst-libs/gst/video/meson.build           |   2 +
 4 files changed, 203 insertions(+)
 create mode 100644 gst-libs/gst/video/gstvideodovirpumeta.c
 create mode 100644 gst-libs/gst/video/gstvideodovirpumeta.h

diff --git a/gst-libs/gst/video/gstvideodecoder.c b/gst-libs/gst/video/gstvideodecoder.c
index 78febe2..b8a5a2c 100644
--- a/gst-libs/gst/video/gstvideodecoder.c
+++ b/gst-libs/gst/video/gstvideodecoder.c
@@ -297,6 +297,7 @@
 #include <gst/video/video-event.h>
 #include <gst/video/gstvideopool.h>
 #include <gst/video/gstvideometa.h>
+#include "gstvideodovirpumeta.h"
 #include <string.h>
 
 GST_DEBUG_CATEGORY (videodecoder_debug);
@@ -3354,6 +3355,17 @@ gst_video_decoder_transform_meta_default (GstVideoDecoder *
     NULL,
   };
 
+  /* RPU instructions still describe the coded signal after decoding. Copy
+   * from this exact codec frame, never a parser-global "latest RPU". Unlike
+   * an ordinary color conversion, decoding does not consume the RPU. Refuse
+   * low-resolution or dimension-changing decoder output. */
+  if (info->api == GST_VIDEO_DOVI_RPU_META_API_TYPE) {
+    const GstVideoDoviRpuMeta *dovi = (const GstVideoDoviRpuMeta *) meta;
+    const GstVideoCodecState *state = decoder->priv->output_state;
+    return state && dovi->width == (guint) GST_VIDEO_INFO_WIDTH (&state->info) &&
+        dovi->height == (guint) GST_VIDEO_INFO_HEIGHT (&state->info);
+  }
+
   tags = gst_meta_api_type_get_tags (info->api);
 
   if (!tags)
diff --git a/gst-libs/gst/video/gstvideodovirpumeta.c b/gst-libs/gst/video/gstvideodovirpumeta.c
new file mode 100644
index 0000000..265b9cf
--- /dev/null
+++ b/gst-libs/gst/video/gstvideodovirpumeta.c
@@ -0,0 +1,115 @@
+/* GStreamer
+ * Copyright (C) 2026 ROG HDR contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Library General Public
+ * License as published by the Free Software Foundation; either
+ * version 2 of the License, or (at your option) any later version.
