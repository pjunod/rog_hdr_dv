+ * License along with this library; if not, write to the
+ * Free Software Foundation, Inc., 51 Franklin St, Fifth Floor,
+ * Boston, MA 02110-1301, USA.
+ */
+
+#ifdef HAVE_CONFIG_H
+#include "config.h"
+#endif
+
+#include "gstvideodovirpumeta.h"
+#include "video.h"
+
+GType
+gst_video_dovi_rpu_meta_api_get_type (void)
+{
+  static GType type = 0;
+  static const gchar *tags[] = {
+    GST_META_TAG_VIDEO_STR, GST_META_TAG_VIDEO_COLORSPACE_STR,
+    GST_META_TAG_VIDEO_SIZE_STR, NULL
+  };
+
+  if (g_once_init_enter (&type)) {
+    GType api = gst_meta_api_type_register ("GstVideoDoviRpuMetaAPI", tags);
+    g_once_init_leave (&type, api);
+  }
+  return type;
+}
+
+static gboolean
+gst_video_dovi_rpu_meta_init (GstMeta * meta, gpointer params,
+    GstBuffer * buffer)
+{
+  GstVideoDoviRpuMeta *dovi = (GstVideoDoviRpuMeta *) meta;
+  dovi->rpu = NULL;
+  dovi->width = dovi->height = 0;
+  return TRUE;
+}
+
+static void
+gst_video_dovi_rpu_meta_free (GstMeta * meta, GstBuffer * buffer)
+{
+  GstVideoDoviRpuMeta *dovi = (GstVideoDoviRpuMeta *) meta;
+  g_clear_pointer (&dovi->rpu, g_bytes_unref);
+}
+
+static gboolean
+gst_video_dovi_rpu_meta_transform (GstBuffer * dest, GstMeta * meta,
+    GstBuffer * buffer, GQuark type, gpointer data)
+{
+  GstVideoDoviRpuMeta *src = (GstVideoDoviRpuMeta *) meta;
+  GstVideoDoviRpuMeta *out;
+  const GstMetaTransformCopy *copy = data;
+
+  if (!GST_META_TRANSFORM_IS_COPY (type) || !src->rpu ||
+      (copy && copy->region) || gst_buffer_get_video_dovi_rpu_meta (dest))
+    return FALSE;
+  out = (GstVideoDoviRpuMeta *) gst_buffer_add_meta (dest,
+      GST_VIDEO_DOVI_RPU_META_INFO, NULL);
+  if (!out)
+    return FALSE;
+  out->rpu = g_bytes_ref (src->rpu);
+  out->width = src->width;
+  out->height = src->height;
+  return TRUE;
+}
+
+const GstMetaInfo *
+gst_video_dovi_rpu_meta_get_info (void)
+{
+  static const GstMetaInfo *info = NULL;
+  if (g_once_init_enter ((GstMetaInfo **) &info)) {
+    const GstMetaInfo *registered = gst_meta_register (
+        GST_VIDEO_DOVI_RPU_META_API_TYPE, "GstVideoDoviRpuMeta",
+        sizeof (GstVideoDoviRpuMeta), gst_video_dovi_rpu_meta_init,
+        gst_video_dovi_rpu_meta_free, gst_video_dovi_rpu_meta_transform);
+    g_once_init_leave ((GstMetaInfo **) &info, (GstMetaInfo *) registered);
+  }
+  return info;
+}
+
+GstVideoDoviRpuMeta *
+gst_buffer_add_video_dovi_rpu_meta (GstBuffer * buffer, const guint8 * rpu,
+    gsize size, guint width, guint height)
+{
+  GstVideoDoviRpuMeta *meta;
+
+  g_return_val_if_fail (GST_IS_BUFFER (buffer), NULL);
+  g_return_val_if_fail (gst_buffer_is_writable (buffer), NULL);
+  g_return_val_if_fail (rpu && size && size <= GST_VIDEO_DOVI_RPU_MAX_SIZE, NULL);
+  g_return_val_if_fail (width && width <= G_MAXINT && height && height <= G_MAXINT, NULL);
+  g_return_val_if_fail (!gst_buffer_get_video_dovi_rpu_meta (buffer), NULL);
+
+  meta = (GstVideoDoviRpuMeta *) gst_buffer_add_meta (buffer,
+      GST_VIDEO_DOVI_RPU_META_INFO, NULL);
+  if (meta) {
+    meta->rpu = g_bytes_new (rpu, size);
+    meta->width = width;
+    meta->height = height;
+  }
+  return meta;
+}
diff --git a/gst-libs/gst/video/gstvideodovirpumeta.h b/gst-libs/gst/video/gstvideodovirpumeta.h
new file mode 100644
index 0000000..b98f7eb
--- /dev/null
+++ b/gst-libs/gst/video/gstvideodovirpumeta.h
@@ -0,0 +1,74 @@
