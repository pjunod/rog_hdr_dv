+ * Free Software Foundation, Inc., 51 Franklin St, Fifth Floor,
+ * Boston, MA 02110-1301, USA.
+ */
+
+#ifndef __GST_VIDEO_DOVI_RPU_META_H__
+#define __GST_VIDEO_DOVI_RPU_META_H__
+
+#include <gst/gst.h>
+#include <gst/video/video-prelude.h>
+
+G_BEGIN_DECLS
+
+/* Private proposed API. This is raw transport, not a Dolby processing claim. */
+#define GST_VIDEO_DOVI_RPU_MAX_SIZE 65536
+#define GST_VIDEO_DOVI_RPU_META_API_TYPE (gst_video_dovi_rpu_meta_api_get_type ())
+#define GST_VIDEO_DOVI_RPU_META_INFO (gst_video_dovi_rpu_meta_get_info ())
+
+/**
+ * GstVideoDoviRpuMeta:
+ * @meta: parent #GstMeta
+ * @rpu: (transfer none): immutable original RPU bytes, without the two-byte
+ *   HEVC NAL header or the start code / length prefix
+ * @width: native visible picture width before scaling
+ * @height: native visible picture height before scaling
+ *
+ * One access unit's original Dolby Vision RPU, owned by its picture buffer.
+ * The bytes are not inherited from another picture. This does not assert
+ * that profile-specific reshaping, temporal metadata resolution or enhancement
+ * layer reconstruction has taken place. A downstream consumer must resolve
+ * those requirements using a public parser before interpreting the pixels.
+ * In particular, a base-layer-only FEL decode is never a reconstructed master.
+ *
+ * Read fields only. Whole-buffer copies retain the immutable bytes; region
+ * copies and non-copy transforms do not preserve this meta. The colorspace
+ * and size tags allow pixel-changing transforms to discard it. Decoders may
+ * transport it through their matched #GstVideoCodecFrame, without changing the
+ * visible dimensions. Consuming display management must remove it.
+ */
+typedef struct _GstVideoDoviRpuMeta {
+  GstMeta meta;
+  GBytes *rpu;
+  guint width;
+  guint height;
+} GstVideoDoviRpuMeta;
+
+GST_VIDEO_API
+GType gst_video_dovi_rpu_meta_api_get_type (void);
+GST_VIDEO_API
+const GstMetaInfo *gst_video_dovi_rpu_meta_get_info (void);
+
+#define gst_buffer_get_video_dovi_rpu_meta(b) \
+  ((GstVideoDoviRpuMeta *) gst_buffer_get_meta ((b), GST_VIDEO_DOVI_RPU_META_API_TYPE))
+
+GST_VIDEO_API
+GstVideoDoviRpuMeta *gst_buffer_add_video_dovi_rpu_meta (GstBuffer * buffer,
+    const guint8 * rpu, gsize size, guint width, guint height);
+
+G_END_DECLS
+#endif
