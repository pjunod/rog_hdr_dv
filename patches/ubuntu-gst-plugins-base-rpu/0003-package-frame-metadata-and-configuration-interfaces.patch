From 752d41500972a2b09be88f8d4fd0b5e393f3a66a Mon Sep 17 00:00:00 2001
From: ROG HDR contributors <rog-hdr@invalid>
Date: Sun, 8 Nov 2026 04:17:24 +0000
Subject: [PATCH] debian: package the frame metadata and sample configuration
 ABI

---
 debian/changelog                              | 7 +++++++
 debian/control                                | 1 +
 debian/libgstreamer-plugins-base1.0-0.symbols | 4 ++++
 3 files changed, 12 insertions(+)

diff --git a/debian/changelog b/debian/changelog
index 593893a..6f41637 100644
--- a/debian/changelog
+++ b/debian/changelog
@@ -1,3 +1,10 @@
+gst-plugins-base1.0 (1.28.7-1+rogdv1) stonking; urgency=medium
+
+  * Ship frame-owned Dolby RPU metadata and bounded HEVC configuration parsing.
+  * Name the joint video and pbutils ABI for downstream runtime consumers.
+
+ -- ROG HDR contributors <rog-hdr@invalid>  Sun, 08 Nov 2026 04:17:00 +0000
+
 gst-plugins-base1.0 (1.28.7-1) unstable; urgency=medium
 
   * New upstream version 1.28.7
diff --git a/debian/control b/debian/control
index 9746b6b..d106d0e 100644
--- a/debian/control
+++ b/debian/control
@@ -77,6 +77,7 @@ Description: GStreamer helper programs from the "base" set
 Package: libgstreamer-plugins-base1.0-0
 Architecture: any
 Multi-Arch: same
+Provides: rog-gstreamer-dovi-base-api (= 1)
 Pre-Depends: ${misc:Pre-Depends}
 Depends: ${misc:Depends},
          ${shlibs:Depends},
diff --git a/debian/libgstreamer-plugins-base1.0-0.symbols b/debian/libgstreamer-plugins-base1.0-0.symbols
index 0cb73af..da4cbf4 100644
--- a/debian/libgstreamer-plugins-base1.0-0.symbols
+++ b/debian/libgstreamer-plugins-base1.0-0.symbols
@@ -441,6 +441,7 @@ libgstpbutils-1.0.so.0 libgstreamer-plugins-base1.0-0 #MINVER#
  gst_codec_utils_h265_get_level_idc@Base 1.4.0
  gst_codec_utils_h265_get_profile@Base 1.4.0
  gst_codec_utils_h265_get_tier@Base 1.4.0
+ gst_codec_utils_h265_parse_dovi_configuration@Base 1.28.7-1+rogdv1
  gst_codec_utils_h266_caps_set_level_tier_and_profile@Base 1.25.90
  gst_codec_utils_h266_get_level@Base 1.25.90
  gst_codec_utils_h266_get_level_idc@Base 1.25.90
@@ -1678,6 +1679,9 @@ libgstvideo-1.0.so.0 libgstreamer-plugins-base1.0-0 #MINVER#
  gst_video_pack_flags_get_type@Base 1.0.0
  gst_video_primaries_mode_get_type@Base 1.6.0
  gst_video_region_of_interest_meta_add_param@Base 1.14.0
+ gst_video_dovi_rpu_meta_api_get_type@Base 1.28.7-1+rogdv1
+ gst_video_dovi_rpu_meta_get_info@Base 1.28.7-1+rogdv1
+ gst_buffer_add_video_dovi_rpu_meta@Base 1.28.7-1+rogdv1
  gst_video_region_of_interest_meta_api_get_type@Base 1.2.0
  gst_video_region_of_interest_meta_get_info@Base 1.2.0
  gst_video_region_of_interest_meta_get_param@Base 1.14.0
