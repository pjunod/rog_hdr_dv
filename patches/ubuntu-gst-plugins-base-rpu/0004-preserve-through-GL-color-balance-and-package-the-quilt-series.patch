+ /**
++ * gst_codec_utils_h265_parse_dovi_configuration:
++ * @data: (array length=size): dvcC or dvvC payload without its box header
++ * @size: number of bytes in @data
++ * @config: (out) (optional): parsed configuration, written only on success
++ *
++ * Parses the HEVC single-layer and dual-layer profiles supported by this
++ * integration. Short records may omit trailing fields. A missing
++ * compatibility identifier does not establish the base layer's color space.
++ *
++ * Returns: %TRUE if @data contains a supported configuration record.
++ */
++gboolean
++gst_codec_utils_h265_parse_dovi_configuration (const guint8 * data,
++    gsize size, GstH265DoviConfiguration * config)
++{
++  GstH265DoviConfiguration record = { 0 };
++  guint16 fields;
++
++  if (!data || size < 4 || size > 24 || data[0] != 1 || data[1] != 0)
++    return FALSE;
++  fields = GST_READ_UINT16_BE (data + 2);
++  record.version_major = data[0];
++  record.version_minor = data[1];
++  record.profile = fields >> 9;
++  record.level = (fields >> 3) & 0x3f;
++  record.rpu_present = (fields >> 2) & 1;
++  record.el_present = (fields >> 1) & 1;
++  record.bl_present = fields & 1;
++  if (!record.level || (!record.el_present && !record.bl_present))
++    return FALSE;
++
++  switch (record.profile) {
++    case 4:
++    case 7:
++      break;
++    case 5:
++    case 8:
++      if (record.el_present || !record.bl_present)
++        return FALSE;
++      break;
++    default:
++      return FALSE;
++  }
++
++  if (size > 4) {
++    record.compatibility_known = TRUE;
++    record.compatibility_id = data[4] >> 4;
++    record.compression = (data[4] >> 2) & 3;
++    /* Compression 2 is reserved. Both limited (1) and extended (3)
++     * compression are defined independently of a consumer's support. */
++    if ((data[4] & 3) != 0 || record.compression == 2)
++      return FALSE;
++    for (gsize i = 5; i < size; i++) {
++      if (data[i] != 0)
++        return FALSE;
++    }
++  }
++  if (config)
++    *config = record;
++  return TRUE;
++}
++
