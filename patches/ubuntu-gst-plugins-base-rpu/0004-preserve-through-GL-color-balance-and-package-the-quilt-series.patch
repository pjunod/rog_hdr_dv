++/**
++ * GstH265DoviConfiguration:
++ *
++ * Fields of a version 1.0 HEVC Dolby Vision decoder configuration record.
++ * @compatibility_known is false for a shortened four-byte record.
++ */
++typedef struct {
++  guint8 version_major;
++  guint8 version_minor;
++  guint8 profile;
++  guint8 level;
++  guint8 rpu_present;
++  guint8 el_present;
++  guint8 bl_present;
++  guint8 compatibility_id;
++  guint8 compression;
++  gboolean compatibility_known;
++  gpointer _gst_reserved[GST_PADDING];
++} GstH265DoviConfiguration;
++
++GST_PBUTILS_API
++gboolean gst_codec_utils_h265_parse_dovi_configuration (const guint8 * data,
++    gsize size, GstH265DoviConfiguration * config);
++
