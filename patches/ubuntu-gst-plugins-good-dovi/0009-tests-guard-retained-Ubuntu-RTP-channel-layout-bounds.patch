diff --git a/tests/check/elements/rtp-channel-layout.c b/tests/check/elements/rtp-channel-layout.c
new file mode 100644
index 0000000..3b4d32d
--- /dev/null
+++ b/tests/check/elements/rtp-channel-layout.c
@@ -0,0 +1,52 @@
+/* SPDX-License-Identifier: LGPL-2.0-or-later
+ * Copyright (C) 2026 ROG HDR contributors
+ * Exercise the actual RTP helper retained by Ubuntu CVE-2026-111183.
+ */
+#include <gst/check/gstcheck.h>
+#include "../../../gst/rtp/gstrtpchannels.h"
+
+GST_START_TEST (rtp_channel_layout_respects_capacity)
+{
+  const gint requested[] = { 1, 64, 65, 128 };
+  const gsize capacities[] = { 0, 1, 64 };
+  guint i, j, k;
+
+  for (i = 0; i < G_N_ELEMENTS (requested); i++) {
+    for (j = 0; j < G_N_ELEMENTS (capacities); j++) {
+      struct {
+        guint32 before;
+        GstAudioChannelPosition positions[64];
+        guint32 after;
+      } guarded;
+      const guint32 sentinel = 0x51a7cafe;
+      const gsize written = MIN ((gsize) requested[i], capacities[j]);
+
+      guarded.before = guarded.after = sentinel;
+      for (k = 0; k < G_N_ELEMENTS (guarded.positions); k++)
+        guarded.positions[k] = GST_AUDIO_CHANNEL_POSITION_FRONT_LEFT;
+
+      gst_rtp_channels_create_default (requested[i], guarded.positions,
+          capacities[j]);
+
+      fail_unless_equals_int (guarded.before, sentinel);
+      fail_unless_equals_int (guarded.after, sentinel);
+      for (k = 0; k < G_N_ELEMENTS (guarded.positions); k++)
+        fail_unless_equals_int (guarded.positions[k], k < written ?
+            GST_AUDIO_CHANNEL_POSITION_NONE : GST_AUDIO_CHANNEL_POSITION_FRONT_LEFT);
+    }
+  }
+}
+GST_END_TEST;
+
+static Suite *
+rtp_channel_layout_suite (void)
+{
+  Suite *s = suite_create ("rtp-channel-layout");
+  TCase *tc = tcase_create ("bounds");
+
+  suite_add_tcase (s, tc);
+  tcase_add_test (tc, rtp_channel_layout_respects_capacity);
+  return s;
+}
+
+GST_CHECK_MAIN (rtp_channel_layout)
