@@ -121,6 +121,8 @@ if not get_option('rtp').disabled() and not get_option('rtpmanager').disabled()
     [ 'elements/rtpulpfec' ],
     [ 'elements/rtpssrcdemux' ],
     [ 'elements/rtp-payloading' ],
+    [ 'elements/rtp-channel-layout', false, [],
+      ['../../gst/rtp/gstrtpchannels.c'] ],
     [ 'elements/rtpst2022-1-fecdec' ],
     [ 'elements/rtpst2022-1-fecenc' ],
   ]
