+/**
+ * GdkWaylandColorTarget:
+ * @generation: surface-local generation, including while unavailable
+ * @identity: Wayland image-description identity, local to this connection
+ * @primaries: CIE 1931 xy pairs for red, green, blue and white, in that order
+ * @min_luminance: target black luminance in cd/m², including ambient flare
+ * @max_luminance: target peak luminance in cd/m²
+ * @reference_luminance: encoding reference white luminance in cd/m²
+ *
+ * A caller-owned copy of the compositor's preferred parametric target.
+ * These are declared values, not optical measurements. No fallback values
+ * are supplied. A copy remains owned by its caller but becomes stale when
+ * the surface emits `color-target-changed`.
+ */
+typedef struct
+{
+  guint64 generation;
+  guint32 identity;
+  double primaries[8];
+  double min_luminance;
+  double max_luminance;
+  double reference_luminance;
+} GdkWaylandColorTarget;
+
+GDK_AVAILABLE_IN_4_24
+gboolean gdk_wayland_surface_get_color_target (GdkSurface            *surface,
+                                                GdkWaylandColorTarget *target);
+
 G_DEFINE_AUTOPTR_CLEANUP_FUNC (GdkWaylandSurface, g_object_unref)
 
 G_END_DECLS
