--- a/gdk/wayland/gdksurface-wayland.c
+++ b/gdk/wayland/gdksurface-wayland.c
@@ -915,19 +915,55 @@ static const struct wl_surface_listener surface_listener = {
 };
 
 static void
-preferred_changed (GdkWaylandColorSurface *color,
-                   GdkColorState          *color_state,
-                   gpointer                data)
+gdk_wayland_surface_invalidate_color_target (GdkWaylandSurface *self)
 {
-  GdkWaylandSurface *self = GDK_WAYLAND_SURFACE (data);
+  guint64 generation = self->color_target.generation + 1;
 
-  GDK_DISPLAY_DEBUG (gdk_surface_get_display (GDK_SURFACE (self)), EVENTS,
-                     "preferred color state, surface %p color state %s",
-                     self, gdk_color_state_get_name (color_state));
+  self->color_target = (GdkWaylandColorTarget) { .generation = generation };
+  self->color_target_valid = FALSE;
+}
 
-  gdk_surface_set_color_state (GDK_SURFACE (self), color_state);
+static void
+gdk_wayland_surface_emit_color_target_changed (GdkWaylandSurface *self)
+{
+  /* A handler may drop its last owned reference or destroy the surface. */
+  g_object_ref (self);
+  g_signal_emit_by_name (self, "color-target-changed");
+  g_object_unref (self);
+}
+
+static void
+preferred_changed (GdkWaylandColorSurface     *color,
+                   GdkColorState              *color_state,
+                   const GdkWaylandColorTarget *target,
+                   gpointer                    data)
+{
+  GdkWaylandSurface *self = GDK_WAYLAND_SURFACE (data);
 
-  self->color_state_changed = TRUE;
+  /* NULL color state is the start of a new asynchronous feedback query. */
+  if (color_state == NULL)
+    gdk_wayland_surface_invalidate_color_target (self);
+  else
+    {
+      guint64 generation = self->color_target.generation;
+
+      self->color_target = target ? *target : (GdkWaylandColorTarget) { 0 };
+      self->color_target.generation = generation;
+      self->color_target_valid = target != NULL;
+      GDK_DISPLAY_DEBUG (gdk_surface_get_display (GDK_SURFACE (self)), EVENTS,
+                         "preferred color state, surface %p color state %s",
+                         self, gdk_color_state_get_name (color_state));
+      gdk_surface_set_color_state (GDK_SURFACE (self), color_state);
+      self->color_state_changed = TRUE;
+    }
+
+  gdk_surface_invalidate_rect (GDK_SURFACE (self), NULL);
+  /* The initial query starts inside color_surface_new(), before the native
+   * surface and feedback owner are installed. Construction publishes no
+   * signal; callers connect and query after obtaining the surface. */
+  if (self->display_server.wl_surface)
+    gdk_wayland_surface_emit_color_target_changed (self);
+  /* Last: application handlers may destroy the native surface. */
 }
 
 static void
@@ -999,6 +1035,10 @@ gdk_wayland_surface_destroy_wl_surface (GdkWaylandSurface *self)
   g_clear_pointer (&self->display_server.viewport, wp_viewport_destroy);
   g_clear_pointer (&self->display_server.fractional_scale, wp_fractional_scale_v1_destroy);
   g_clear_pointer (&self->display_server.color, gdk_wayland_color_surface_free);
+  /* Publish unavailability now, but do not call application code in the
+   * middle of native teardown. The core's after_destroy boundary notifies
+   * only after the public destroyed state is set. */
+  gdk_wayland_surface_invalidate_color_target (self);
 
   g_clear_pointer (&self->display_server.wl_surface, wl_surface_destroy);
 
@@ -1319,6 +1359,12 @@ gdk_wayland_surface_destroy (GdkSurface *surface,
   g_signal_handlers_disconnect_by_func (frame_clock, on_frame_clock_after_paint, surface);
 }
 
+static void
+gdk_wayland_surface_after_destroy (GdkSurface *surface)
+{
+  gdk_wayland_surface_emit_color_target_changed (GDK_WAYLAND_SURFACE (surface));
+}
+
 static void
 gdk_wayland_surface_destroy_notify (GdkSurface *surface)
 {
@@ -1379,6 +1425,7 @@ gdk_wayland_surface_class_init (GdkWaylandSurfaceClass *klass)
   surface_class->get_device_state = gdk_wayland_surface_get_device_state;
   surface_class->set_input_region = gdk_wayland_surface_set_input_region;
   surface_class->destroy = gdk_wayland_surface_destroy;
+  surface_class->after_destroy = gdk_wayland_surface_after_destroy;
   surface_class->beep = gdk_wayland_surface_beep;
 
   surface_class->destroy_notify = gdk_wayland_surface_destroy_notify;
@@ -1389,10 +1436,59 @@ gdk_wayland_surface_class_init (GdkWaylandSurfaceClass *klass)
   surface_class->request_layout = gdk_wayland_surface_request_layout;
   surface_class->create_subsurface = gdk_wayland_surface_create_subsurface;
 
+  /**
+   * GdkWaylandSurface::color-target-changed:
+   * @surface: the surface
+   *
+   * Emitted when preferred target feedback is invalidated or completed, and
+   * after native teardown and publication of the destroyed state. No signal
+   * is emitted during construction. Query get_color_target() again;
+   * it returns FALSE while asynchronous feedback is pending or unavailable.
+   * Handlers run on the display's main context, as do other GDK operations.
+   */
+  g_signal_new ("color-target-changed",
+                G_TYPE_FROM_CLASS (klass), G_SIGNAL_RUN_LAST,
+                0, NULL, NULL, NULL, G_TYPE_NONE, 0);
+
   klass->handle_configure = gdk_wayland_surface_default_handle_configure;
   klass->hide_surface = gdk_wayland_surface_default_hide_surface;
 }
 
+/**
+ * gdk_wayland_surface_get_color_target:
+ * @surface: a Wayland surface
+ * @target: (out caller-allocates): caller-owned target snapshot
+ *
+ * Copies the currently completed preferred parametric display target. Call
+ * only on the display's main context. Connect to `color-target-changed` and
+ * query again on each notification, including after output moves. The
+ * compositor selects the preferred target for surfaces spanning outputs.
+ *
+ * Returns: TRUE for a complete target; FALSE while unavailable, pending,
+ *   unsupported or destroyed. On FALSE, only @target's generation is usable;
+ *   all target values are cleared. The generation is local to @surface and
+ *   changes on invalidation, even if a later target has identical values.
+ */
+gboolean
+gdk_wayland_surface_get_color_target (GdkSurface            *surface,
+                                      GdkWaylandColorTarget *target)
+{
+  GdkWaylandSurface *self;
+
+  g_return_val_if_fail (GDK_IS_WAYLAND_SURFACE (surface), FALSE);
+  g_return_val_if_fail (target != NULL, FALSE);
+
+  self = GDK_WAYLAND_SURFACE (surface);
+  if (!self->color_target_valid || GDK_SURFACE_DESTROYED (surface))
+    {
+      *target = (GdkWaylandColorTarget) { .generation = self->color_target.generation };
+      return FALSE;
+    }
+
+  *target = self->color_target;
+  return TRUE;
+}
+
