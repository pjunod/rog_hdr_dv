+  if (!self->hdr_requests && !self->hdr_frame_color_state)
+    return;
+  if (self->hdr_frame_context != context || !self->hdr_frame_color_state ||
+      !gdk_color_state_equal (self->hdr_frame_color_state, color_state))
+    {
