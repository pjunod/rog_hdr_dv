+      .floating_point = floating_point, .color_primaries = cicp->color_primaries,
+      .transfer_function = cicp->transfer_function, .matrix_coefficients = cicp->matrix_coefficients,
+      .range = cicp->range, .min_luminance = 0, .max_luminance = 10000, .reference_luminance = 203,
+    };
