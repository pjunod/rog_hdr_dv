diff --git a/gdk/wayland/gdkwaylandhdrrendering.c b/gdk/wayland/gdkwaylandhdrrendering.c
new file mode 100644
index 0000000..e8c060f
--- /dev/null
+++ b/gdk/wayland/gdkwaylandhdrrendering.c
@@ -0,0 +1,170 @@
+/* Per-surface HDR rendering leases. LGPL-2.1-or-later, like GDK. */
+#include "config.h"
+#include "gdksurface-wayland-private.h"
+#include "gdksurfaceprivate.h"
+
+struct _GdkWaylandHdrRendering
+{
+  GObject parent_instance;
+  GWeakRef surface;
+  guint64 generation;
+};
+
+struct _GdkWaylandHdrRenderingClass
+{
+  GObjectClass parent_class;
+};
+
+G_DEFINE_TYPE (GdkWaylandHdrRendering, gdk_wayland_hdr_rendering, G_TYPE_OBJECT)
+
+static void
+gdk_wayland_hdr_rendering_finalize (GObject *object)
+{
+  GdkWaylandHdrRendering *self = GDK_WAYLAND_HDR_RENDERING (object);
+  GdkWaylandSurface *surface = g_weak_ref_get (&self->surface);
+  if (surface)
+    {
+      surface->hdr_requests = g_list_remove (surface->hdr_requests, self);
+      if (!GDK_SURFACE_DESTROYED (GDK_SURFACE (surface)))
+        gdk_wayland_surface_hdr_requests_changed (surface);
+      g_object_unref (surface);
+    }
+  g_weak_ref_clear (&self->surface);
+  G_OBJECT_CLASS (gdk_wayland_hdr_rendering_parent_class)->finalize (object);
+}
+
+static void
+gdk_wayland_hdr_rendering_class_init (GdkWaylandHdrRenderingClass *klass)
+{
+  G_OBJECT_CLASS (klass)->finalize = gdk_wayland_hdr_rendering_finalize;
+  /**
+   * GdkWaylandHdrRendering::changed:
+   * @self: the rendering request
+   *
+   * Emitted when actual rendering availability or its target generation changes.
+   * Query get_state() again; a requested mode alone never implies readiness.
+   */
+  g_signal_new ("changed", G_TYPE_FROM_CLASS (klass), G_SIGNAL_RUN_LAST,
+                0, NULL, NULL, NULL, G_TYPE_NONE, 0);
+}
+
+static void
+gdk_wayland_hdr_rendering_init (GdkWaylandHdrRendering *self)
+{
+  g_weak_ref_init (&self->surface, NULL);
+}
+
+/**
+ * gdk_wayland_surface_request_hdr_rendering:
+ * @surface: (type GdkWaylandSurface): the Wayland surface
+ *
+ * Requests high-precision color-managed HDR rendering on this surface. The
+ * request is a lease: releasing it affects only that request. Other consumers
+ * remain active. The surface is not retained and destruction invalidates every
+ * lease. Requesting does not promise a supported compositor or framebuffer.
+ *
+ * Returns: (transfer full) (nullable): a rendering lease
+ */
+GdkWaylandHdrRendering *
+gdk_wayland_surface_request_hdr_rendering (GdkSurface *surface)
+{
+  GdkWaylandHdrRendering *request;
+  GdkWaylandSurface *self;
+  g_return_val_if_fail (GDK_IS_WAYLAND_SURFACE (surface), NULL);
+  if (GDK_SURFACE_DESTROYED (GDK_SURFACE (surface)))
+    return NULL;
+  self = g_object_ref (GDK_WAYLAND_SURFACE (surface));
+  request = g_object_new (GDK_TYPE_WAYLAND_HDR_RENDERING, NULL);
+  g_weak_ref_set (&request->surface, self);
+  request->generation = self->color_target.generation;
+  self->hdr_requests = g_list_prepend (self->hdr_requests, request);
+  gdk_wayland_surface_hdr_requests_changed (self);
+  g_object_unref (self);
+  return request;
+}
+
+/**
+ * gdk_wayland_hdr_rendering_get_state:
+ * @request: the rendering lease
+ * @state: (out caller-allocates): actual output snapshot
+ *
+ * Returns a snapshot only after a successful native HDR frame submission with
+ * its explicit Wayland content description and verified framebuffer precision.
+ * While unavailable only the current target generation is supplied. Call again
+ * after changed; snapshots become stale on target invalidation or teardown.
+ *
+ * Returns: whether a current actual HDR output snapshot is available
+ */
+gboolean
+gdk_wayland_hdr_rendering_get_state (GdkWaylandHdrRendering *request,
+                                     GdkWaylandHdrRenderState *state)
+{
+  GdkWaylandSurface *surface;
+  gboolean valid = FALSE;
+  g_return_val_if_fail (GDK_IS_WAYLAND_HDR_RENDERING (request), FALSE);
+  g_return_val_if_fail (state != NULL, FALSE);
+  *state = (GdkWaylandHdrRenderState) { .generation = request->generation };
+  surface = g_weak_ref_get (&request->surface);
+  if (surface)
+    {
+      state->generation = surface->color_target.generation;
+      valid = !GDK_SURFACE_DESTROYED (GDK_SURFACE (surface)) && surface->hdr_requested_active &&
+              surface->color_target_valid && surface->hdr_render_state_valid &&
+              surface->hdr_frame_context != NULL &&
+              surface->hdr_frame_context == gdk_surface_get_attached_context (GDK_SURFACE (surface)) &&
+              surface->hdr_render_state.generation == state->generation;
+      if (valid)
+        *state = surface->hdr_render_state;
+      g_object_unref (surface);
+    }
+  return valid;
+}
+
+static gboolean
+hdr_changed_idle (gpointer data)
+{
+  GdkWaylandSurface *surface = data;
+  GList *requests;
+  surface->hdr_notify_id = 0;
+  requests = g_list_copy_deep (surface->hdr_requests, (GCopyFunc) g_object_ref, NULL);
+  for (GList *l = requests; l; l = l->next)
+    {
+      GdkWaylandHdrRendering *request = l->data;
+      request->generation = surface->color_target.generation;
+      g_signal_emit_by_name (request, "changed");
+    }
+  g_list_free_full (requests, g_object_unref);
+  return G_SOURCE_REMOVE;
+}
+
+void
+gdk_wayland_hdr_rendering_surface_changed (GdkWaylandSurface *surface)
+{
+  /* Native frame completion still has draw-context/GSK bookkeeping to do.
+   * Notify application code afterward, when destroying or releasing a lease
+   * cannot reenter that native submission stack. Snapshot queries are current
+   * immediately; signals coalesce on the display's main thread. */
+  if (surface->hdr_requests && !surface->hdr_notify_id)
+    surface->hdr_notify_id = g_idle_add_full (G_PRIORITY_DEFAULT_IDLE, hdr_changed_idle,
+                                             g_object_ref (surface), g_object_unref);
+}
+
+void
+gdk_wayland_hdr_rendering_surface_destroyed (GdkWaylandSurface *surface)
+{
+  GList *requests = g_list_copy_deep (surface->hdr_requests, (GCopyFunc) g_object_ref, NULL);
+  if (surface->hdr_notify_id)
+    {
+      g_source_remove (surface->hdr_notify_id);
+      surface->hdr_notify_id = 0;
+    }
+  g_clear_pointer (&surface->hdr_requests, g_list_free);
+  for (GList *l = requests; l; l = l->next)
+    {
+      GdkWaylandHdrRendering *request = l->data;
+      request->generation = surface->color_target.generation;
+      g_weak_ref_set (&request->surface, NULL);
+      g_signal_emit_by_name (request, "changed");
+    }
+  g_list_free_full (requests, g_object_unref);
+}
