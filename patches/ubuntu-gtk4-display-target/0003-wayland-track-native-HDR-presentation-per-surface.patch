+/**
+ * GdkWaylandHdrRenderState:
+ * @generation: current surface target generation, also set while unavailable
+ * @red_bits: actual framebuffer red component precision
+ * @green_bits: actual framebuffer green component precision
+ * @blue_bits: actual framebuffer blue component precision
+ * @floating_point: whether framebuffer components are floating point
+ * @color_primaries: actual output CICP color primaries
+ * @transfer_function: actual output CICP transfer function
+ * @matrix_coefficients: actual output CICP matrix coefficients
+ * @range: actual output CICP range
+ * @min_luminance: declared encoding minimum in cd/m²
+ * @max_luminance: declared encoding maximum in cd/m²
+ * @reference_luminance: declared encoding reference white in cd/m²
+ *
+ * A caller-owned snapshot of a successfully submitted HDR framebuffer and
+ * its committed Wayland content description. This is not the physical display
+ * target: obtain that separately with gdk_wayland_surface_get_color_target().
+ */
+typedef struct
+{
+  guint64 generation;
+  guint red_bits;
+  guint green_bits;
+  guint blue_bits;
+  gboolean floating_point;
+  guint color_primaries;
+  guint transfer_function;
+  guint matrix_coefficients;
+  GdkCicpRange range;
+  double min_luminance;
+  double max_luminance;
+  double reference_luminance;
+} GdkWaylandHdrRenderState;
+
+typedef struct _GdkWaylandHdrRendering GdkWaylandHdrRendering;
+typedef struct _GdkWaylandHdrRenderingClass GdkWaylandHdrRenderingClass;
+
+#define GDK_TYPE_WAYLAND_HDR_RENDERING (gdk_wayland_hdr_rendering_get_type ())
+#define GDK_WAYLAND_HDR_RENDERING(obj) (G_TYPE_CHECK_INSTANCE_CAST ((obj), GDK_TYPE_WAYLAND_HDR_RENDERING, GdkWaylandHdrRendering))
+#define GDK_IS_WAYLAND_HDR_RENDERING(obj) (G_TYPE_CHECK_INSTANCE_TYPE ((obj), GDK_TYPE_WAYLAND_HDR_RENDERING))
+
+GDK_AVAILABLE_IN_4_24
+GType gdk_wayland_hdr_rendering_get_type (void) G_GNUC_CONST;
+
+GDK_AVAILABLE_IN_4_24
+GdkWaylandHdrRendering *gdk_wayland_surface_request_hdr_rendering (GdkSurface *surface);
+
+GDK_AVAILABLE_IN_4_24
+gboolean gdk_wayland_hdr_rendering_get_state (GdkWaylandHdrRendering   *request,
+                                              GdkWaylandHdrRenderState *state);
+
+G_DEFINE_AUTOPTR_CLEANUP_FUNC (GdkWaylandHdrRendering, g_object_unref)
+
 G_DEFINE_AUTOPTR_CLEANUP_FUNC (GdkWaylandSurface, g_object_unref)
 
 G_END_DECLS
