                libjpeg-dev,
                libjson-glib-dev:native,
diff --git a/debian/patches/gtkvideo-dovi-view.patch b/debian/patches/gtkvideo-dovi-view.patch
new file mode 100644
index 0000000..52db09d
--- /dev/null
+++ b/debian/patches/gtkvideo-dovi-view.patch
@@ -0,0 +1,1238 @@
+Description: Bind Dolby Vision rendering to each realized GtkVideo view
+Author: ROG HDR contributors <rog-hdr@invalid>
+Forwarded: not-needed
+
+diff --git a/gtk/gtkvideo.c b/gtk/gtkvideo.c
+index 3b2feb5..1b1b7c1 100644
+--- a/gtk/gtkvideo.c
++++ b/gtk/gtkvideo.c
+@@ -36,6 +36,10 @@
+ #include "gtkprivate.h"
+ #include "gtktypebuiltins.h"
+ 
++#ifdef HAVE_GST_GTK_DOVI_CORE
++#include "media/gtkgstdoviviewprivate.h"
++#endif
++
+ /**
+  * GtkVideo:
+  *
+@@ -64,6 +68,9 @@ struct _GtkVideo
+ 
+   GFile *file;
+   GtkMediaStream *media_stream;
++#ifdef HAVE_GST_GTK_DOVI_CORE
++  GdkPaintable *display_paintable;
++#endif
+ 
+   GtkWidget *box;
+   GtkWidget *video_picture;
+@@ -204,6 +211,11 @@ gtk_video_realize (GtkWidget *widget)
+       gtk_media_stream_realize (self->media_stream, surface);
+     }
+ 
++#ifdef HAVE_GST_GTK_DOVI_CORE
++  gtk_gst_dovi_view_set_surface (self->display_paintable,
++                                 gtk_native_get_surface (gtk_widget_get_native (widget)));
++#endif
++
+   if (self->file)
+     gtk_media_file_set_file (GTK_MEDIA_FILE (self->media_stream), self->file);
+ }
+@@ -213,6 +225,10 @@ gtk_video_unrealize (GtkWidget *widget)
+ {
+   GtkVideo *self = GTK_VIDEO (widget);
+ 
++#ifdef HAVE_GST_GTK_DOVI_CORE
++  gtk_gst_dovi_view_set_surface (self->display_paintable, NULL);
++#endif
++
+   if (self->autoplay && self->media_stream)
+     gtk_media_stream_pause (self->media_stream);
+ 
+@@ -711,6 +727,11 @@ gtk_video_set_media_stream (GtkVideo       *self,
+   if (self->media_stream == stream)
+     return;
+ 
++#ifdef HAVE_GST_GTK_DOVI_CORE
++  gtk_gst_dovi_view_set_surface (self->display_paintable, NULL);
++  g_clear_object (&self->display_paintable);
++#endif
++
+   if (self->media_stream)
+     {
+       if (self->autoplay)
+@@ -750,7 +771,21 @@ gtk_video_set_media_stream (GtkVideo       *self,
+     }
+ 
+   gtk_media_controls_set_media_stream (GTK_MEDIA_CONTROLS (self->controls), stream);
++#ifdef HAVE_GST_GTK_DOVI_CORE
++  self->display_paintable = stream ? gtk_gst_dovi_view_new (stream) : NULL;
++  if (self->display_paintable)
++    {
++      gtk_gst_dovi_view_set_composed (self->display_paintable,
++        gtk_graphics_offload_get_enabled (GTK_GRAPHICS_OFFLOAD (self->graphics_offload)) == GTK_GRAPHICS_OFFLOAD_DISABLED);
++      if (gtk_widget_get_realized (GTK_WIDGET (self)))
++        gtk_gst_dovi_view_set_surface (self->display_paintable,
++          gtk_native_get_surface (gtk_widget_get_native (GTK_WIDGET (self))));
++    }
++  gtk_picture_set_paintable (GTK_PICTURE (self->video_picture),
++                            self->display_paintable ? self->display_paintable : GDK_PAINTABLE (stream));
++#else
+   gtk_picture_set_paintable (GTK_PICTURE (self->video_picture), GDK_PAINTABLE (stream));
++#endif
+ 
+   gtk_video_update_all (self);
+ 
+@@ -1005,6 +1040,9 @@ gtk_video_set_graphics_offload (GtkVideo                  *self,
+     return;
+ 
+   gtk_graphics_offload_set_enabled (GTK_GRAPHICS_OFFLOAD (self->graphics_offload), enabled);
++#ifdef HAVE_GST_GTK_DOVI_CORE
++  gtk_gst_dovi_view_set_composed (self->display_paintable, enabled == GTK_GRAPHICS_OFFLOAD_DISABLED);
++#endif
+ 
+   g_object_notify_by_pspec (G_OBJECT (self), properties[PROP_GRAPHICS_OFFLOAD]);
+ }
+diff --git a/gtk/media/gtkgstdoviview.c b/gtk/media/gtkgstdoviview.c
+new file mode 100644
+index 0000000..5b57742
+--- /dev/null
++++ b/gtk/media/gtkgstdoviview.c
+@@ -0,0 +1,755 @@
++/* SPDX-License-Identifier: LGPL-2.1-or-later */
++/* The shared core owns source pixels and all Dolby mapping. This file only
++ * binds immutable pictures to one GTK view and its actual native output. */
++#include "config.h"
++#include "gtkgstdoviviewprivate.h"
++#include "gtkgstpaintableprivate.h"
++#include "gtkgstmediafileprivate.h"
++#include <gdk/wayland/gdkwayland.h>
++#include <gst/video/video.h>
++#include "gdk/gdkmemoryformatprivate.h"
++#include <mapper.h>
++#include <gmodule.h>
++
++typedef struct
++{
++  guint (*abi) (void);
++  void (*debug_init) (void);
++  GstGtkDoviMapper *(*mapper_new) (void);
++  void (*mapper_free) (GstGtkDoviMapper *);
++  GstGtkDoviNativeFrame *(*frame_from_buffer) (GstBuffer *, guint64 *);
++  void (*frame_unref) (GstGtkDoviNativeFrame *);
++  int (*frame_render) (GstGtkDoviNativeFrame *, GstGtkDoviMapper *,
++                       const GstContext *, GstBuffer **, GstVideoInfo *, GError **);
++} DoviCore;
++
++static const DoviCore *
++dovi_core (void)
++{
++  static gsize initialized;
++  static DoviCore api;
++  static gboolean available;
++
++  if (g_once_init_enter (&initialized))
++    {
++      GModule *module = g_module_open ("libgstgtkdovicore.so.0",
++                                       G_MODULE_BIND_LAZY | G_MODULE_BIND_LOCAL);
++      gboolean valid = module != NULL;
++#define RESOLVE(member, symbol) \
++      valid = valid && g_module_symbol (module, symbol, (gpointer *) &api.member)
++      RESOLVE (abi, "gst_gtk_dovi_core_abi");
++      RESOLVE (debug_init, "gst_gtk_dovi_debug_init");
++      RESOLVE (mapper_new, "gst_gtk_dovi_mapper_new");
++      RESOLVE (mapper_free, "gst_gtk_dovi_mapper_free");
++      RESOLVE (frame_from_buffer, "gst_gtk_dovi_native_frame_from_buffer");
++      RESOLVE (frame_unref, "gst_gtk_dovi_native_frame_unref");
++      RESOLVE (frame_render, "gst_gtk_dovi_native_frame_render");
++#undef RESOLVE
++      valid = valid && api.abi () == GST_GTK_DOVI_CORE_ABI;
++      if (valid)
++        {
++          g_module_make_resident (module);
++          available = TRUE;
++        }
++      else if (module)
++        g_module_close (module);
++      g_once_init_leave (&initialized, 1);
++    }
++
++  return available ? &api : NULL;
++}
++
++struct _GtkGstDoviFrame
++{
++  gatomicrefcount refs;
++  GstGtkDoviNativeFrame *native;
++  guint stream_epoch;
++  guint caps_epoch;
++};
++
++static GQuark
++frame_quark (void)
++{
++  return g_quark_from_static_string ("gtk-gst-owned-native-frame");
++}
++
++void
++gtk_gst_dovi_frame_unref (GtkGstDoviFrame *frame)
++{
++  if (frame && g_atomic_ref_count_dec (&frame->refs))
++    {
++      if (frame->native)
++        dovi_core ()->frame_unref (frame->native);
++      g_free (frame);
++    }
++}
++
++void
++gtk_gst_dovi_tag_texture (GdkTexture *texture,
++                           GstBuffer *buffer,
++                           guint       stream_epoch,
++                           guint       caps_epoch)
++{
++  GtkGstDoviFrame *frame = g_new0 (GtkGstDoviFrame, 1);
++  g_atomic_ref_count_init (&frame->refs);
++  frame->native = dovi_core () ? dovi_core ()->frame_from_buffer (buffer, NULL) : NULL;
++  frame->stream_epoch = stream_epoch;
++  frame->caps_epoch = caps_epoch;
++  g_object_set_qdata_full (G_OBJECT (texture), frame_quark (), frame,
++                          (GDestroyNotify) gtk_gst_dovi_frame_unref);
++}
++
++gboolean
++gtk_gst_dovi_texture_is_current (GdkTexture *texture,
++                                  guint       stream_epoch,
++                                  guint       caps_epoch)
++{
++  GtkGstDoviFrame *frame = g_object_get_qdata (G_OBJECT (texture), frame_quark ());
++  return frame == NULL ||
++         (frame->stream_epoch == stream_epoch && frame->caps_epoch == caps_epoch);
++}
++
++GtkGstDoviFrame *
++gtk_gst_dovi_texture_ref_frame (GdkTexture *texture)
++{
++  GtkGstDoviFrame *frame = g_object_get_qdata (G_OBJECT (texture), frame_quark ());
++  if (frame)
++    g_atomic_ref_count_inc (&frame->refs);
++  return frame;
++}
++
++gboolean
++gtk_gst_dovi_frame_is_native (GtkGstDoviFrame *frame)
++{
++  return frame && frame->native;
++}
++
++GtkGstPaintableFrame *
++gtk_gst_paintable_frame_ref (GtkGstPaintableFrame *frame)
++{
++  if (frame)
++    g_atomic_ref_count_inc (&frame->refs);
++  return frame;
++}
++
++void
++gtk_gst_paintable_frame_unref (GtkGstPaintableFrame *frame)
++{
++  if (frame && g_atomic_ref_count_dec (&frame->refs))
++    {
++      g_object_unref (frame->texture);
++      gtk_gst_dovi_frame_unref (frame->native);
++      g_free (frame);
++    }
++}
++
++GstElement *
++gtk_gst_dovi_create_filter (void)
++{
++  if (dovi_core () == NULL)
++    return NULL;
++  /* Capture original input before playsink conversion. No display context is
++   * installed on the shared producer: each realized view maps its own frame. */
++  return gst_element_factory_make ("gtkdovimap", NULL);
++}
++
++typedef struct
++{
++  gatomicrefcount refs;
++  GMutex lock;
++  GstGtkDoviMapper *mapper;
++} ViewMapper;
++
++typedef struct
++{
++  GObject parent_instance;
++  GtkMediaStream *source;
++  GtkGstPaintable *producer;
++  GWeakRef surface;
++  GdkWaylandHdrRendering *lease;
++  gulong lease_changed;
++  gulong source_contents;
++  gulong source_size;
++  GstContext *context;
++  char *context_signature;
++  guint64 target_revision;
++  guint64 binding_epoch;
++  gboolean context_ready;
++  gboolean composed;
++  gboolean busy;
++  gboolean target_refresh;
++  GtkGstPaintableFrame *latest;
++  GtkGstPaintableFrame *visible;
++  GdkPaintable *mapped;
++  guint64 mapped_revision;
++  guint64 failed_serial;
++  guint64 failed_revision;
++  ViewMapper *mapper;
++} GtkGstDoviView;
++
++typedef GObjectClass GtkGstDoviViewClass;
++static GType gtk_gst_dovi_view_get_type (void);
++static void view_paintable_init (GdkPaintableInterface *iface);
++static void view_update (GtkGstDoviView *self);
++
++G_DEFINE_TYPE_WITH_CODE (GtkGstDoviView, gtk_gst_dovi_view, G_TYPE_OBJECT,
++                         G_IMPLEMENT_INTERFACE (GDK_TYPE_PAINTABLE, view_paintable_init))
++
++static ViewMapper *
++view_mapper_ref (ViewMapper *mapper)
++{
++  g_atomic_ref_count_inc (&mapper->refs);
++  return mapper;
++}
++
++static void
++view_mapper_unref (ViewMapper *mapper)
++{
++  if (mapper && g_atomic_ref_count_dec (&mapper->refs))
++    {
++      dovi_core ()->mapper_free (mapper->mapper);
++      g_mutex_clear (&mapper->lock);
++      g_free (mapper);
++    }
++}
++
++static void
++clear_mapped (GtkGstDoviView *self)
++{
++  g_clear_object (&self->mapped);
++  g_clear_pointer (&self->visible, gtk_gst_paintable_frame_unref);
++  self->mapped_revision = 0;
++}
++
++static void
++lease_changed (GdkWaylandHdrRendering *lease,
++               gpointer                data)
++{
++  GtkGstDoviView *self = data;
++  if (lease == self->lease)
++    {
++      view_update (self);
++      gdk_paintable_invalidate_contents (GDK_PAINTABLE (self));
++    }
++}
++
++static void
++release_lease (GtkGstDoviView *self)
++{
++  if (self->lease)
++    {
++      g_signal_handler_disconnect (self->lease, self->lease_changed);
++      self->lease_changed = 0;
++      g_clear_object (&self->lease);
++    }
++}
++
++static void
++set_context_snapshot (GtkGstDoviView *self,
++                      GdkSurface     *surface)
++{
++  GdkWaylandColorTarget physical = { 0 };
++  GdkWaylandHdrRenderState state = { 0 };
++  gboolean valid, ready;
++  GstContext *context;
++  GstStructure *structure;
++  char *signature;
++
++  valid = gdk_wayland_surface_get_color_target (surface, &physical);
++  ready = gdk_wayland_hdr_rendering_get_state (self->lease, &state) && valid &&
++          state.generation == physical.generation &&
++          MIN (state.red_bits, MIN (state.green_bits, state.blue_bits)) >= 10 &&
++          state.color_primaries == 9 && state.transfer_function == 16 &&
++          state.matrix_coefficients == 0 && state.range == GDK_CICP_RANGE_FULL &&
++          state.reference_luminance == 203.0 && state.max_luminance == 10000.0;
++  context = gst_context_new ("gst.gtk.dovi.target.v1", FALSE);
++  structure = gst_context_writable_structure (context);
++  gst_structure_set (structure,
++                     "valid", G_TYPE_BOOLEAN, valid,
++                     "generation", G_TYPE_UINT64, physical.generation,
++                     "min-nits", G_TYPE_DOUBLE, physical.min_luminance,
++                     "max-nits", G_TYPE_DOUBLE, physical.max_luminance,
++                     "reference-nits", G_TYPE_DOUBLE, physical.reference_luminance,
++                     "composed", G_TYPE_BOOLEAN, self->composed,
++                     "hdr-ready", G_TYPE_BOOLEAN, ready,
++                     "encoding-reference-nits", G_TYPE_DOUBLE, state.reference_luminance,
++                     "encoding-max-nits", G_TYPE_DOUBLE, state.max_luminance,
++                     "primary-r-x", G_TYPE_DOUBLE, physical.primaries[0],
++                     "primary-r-y", G_TYPE_DOUBLE, physical.primaries[1],
++                     "primary-g-x", G_TYPE_DOUBLE, physical.primaries[2],
++                     "primary-g-y", G_TYPE_DOUBLE, physical.primaries[3],
++                     "primary-b-x", G_TYPE_DOUBLE, physical.primaries[4],
++                     "primary-b-y", G_TYPE_DOUBLE, physical.primaries[5],
++                     "white-x", G_TYPE_DOUBLE, physical.primaries[6],
++                     "white-y", G_TYPE_DOUBLE, physical.primaries[7], NULL);
++  signature = gst_structure_to_string (structure);
++  if (g_strcmp0 (signature, self->context_signature) != 0)
++    {
++      g_free (self->context_signature);
++      self->context_signature = signature;
++      g_clear_pointer (&self->context, gst_context_unref);
++      self->context = context;
++      self->target_revision++;
++      self->target_refresh = TRUE;
++    }
++  else
++    {
++      g_free (signature);
++      gst_context_unref (context);
++    }
++  self->context_ready = ready;
++}
++
++typedef struct
++{
++  GWeakRef view;
++  ViewMapper *mapper;
++  GtkGstPaintableFrame *frame;
++  GstContext *context;
++  guint64 target_revision;
++  guint64 binding_epoch;
++} RenderJob;
++
++typedef struct
++{
++  int result;
++  GstBuffer *buffer;
++  GstVideoInfo info;
++  GError *error;
++} RenderResult;
++
++static void
++render_job_free (gpointer data)
++{
++  RenderJob *job = data;
++  g_weak_ref_clear (&job->view);
++  view_mapper_unref (job->mapper);
++  gtk_gst_paintable_frame_unref (job->frame);
++  gst_context_unref (job->context);
++  g_free (job);
++}
++
++static void
++render_result_free (gpointer data)
++{
++  RenderResult *result = data;
++  gst_clear_buffer (&result->buffer);
++  g_clear_error (&result->error);
++  g_free (result);
++}
++
++static void
++render_thread (GTask        *task,
++               gpointer      source,
++               gpointer      data,
++               GCancellable *cancellable)
++{
++  RenderJob *job = data;
++  RenderResult *result = g_new0 (RenderResult, 1);
++
++  (void) source;
++  (void) cancellable;
++  g_mutex_lock (&job->mapper->lock);
++  result->result = dovi_core ()->frame_render (job->frame->native->native,
++                                                     job->mapper->mapper,
++                                                     job->context, &result->buffer,
++                                                     &result->info, &result->error);
++  g_mutex_unlock (&job->mapper->lock);
++  g_task_return_pointer (task, result, render_result_free);
++}
++
++typedef struct
++{
++  GstBuffer *buffer;
++  GstMapInfo map;
++} MappedPixels;
++
++static void
++mapped_pixels_free (gpointer data)
++{
++  MappedPixels *pixels = data;
++  gst_buffer_unmap (pixels->buffer, &pixels->map);
++  gst_buffer_unref (pixels->buffer);
++  g_free (pixels);
++}
++
++static GdkTexture *
++texture_from_result (RenderResult *result)
++{
++  GstVideoInfo *info = &result->info;
++  MappedPixels *pixels;
++  GdkMemoryTextureBuilder *builder;
++  GdkMemoryFormat format;
++  GdkTexture *texture;
++  GBytes *bytes;
++  guint64 required;
++  gsize offset;
++  int stride;
++
++  if (result->buffer == NULL || GST_VIDEO_INFO_WIDTH (info) <= 0 ||
++      GST_VIDEO_INFO_HEIGHT (info) <= 0 ||
++      GST_VIDEO_INFO_FORMAT (info) != GST_VIDEO_FORMAT_RGBA64_LE ||
++      info->colorimetry.transfer != GST_VIDEO_TRANSFER_SMPTE2084 ||
++      info->colorimetry.primaries != GST_VIDEO_COLOR_PRIMARIES_BT2020 ||
++      info->colorimetry.matrix != GST_VIDEO_COLOR_MATRIX_RGB ||
++      info->colorimetry.range != GST_VIDEO_COLOR_RANGE_0_255 ||
++      !gdk_memory_format_find_by_gst_video_format (GST_VIDEO_INFO_FORMAT (info),
++                                                   (GST_VIDEO_INFO_FLAGS (info) & GST_VIDEO_FLAG_PREMULTIPLIED_ALPHA) != 0,
++                                                   &format))
++    return NULL;
++  stride = GST_VIDEO_INFO_PLANE_STRIDE (info, 0);
++  offset = GST_VIDEO_INFO_PLANE_OFFSET (info, 0);
++  if (stride <= 0)
++    return NULL;
++  pixels = g_new0 (MappedPixels, 1);
++  pixels->buffer = gst_buffer_ref (result->buffer);
++  if (!gst_buffer_map (pixels->buffer, &pixels->map, GST_MAP_READ))
++    {
++      gst_buffer_unref (pixels->buffer);
++      g_free (pixels);
++      return NULL;
++    }
++  required = (guint64) offset +
++             (guint64) (GST_VIDEO_INFO_HEIGHT (info) - 1) * stride +
++             (guint64) GST_VIDEO_INFO_WIDTH (info) * 8;
++  if (required > pixels->map.size)
++    {
++      mapped_pixels_free (pixels);
++      return NULL;
++    }
++  bytes = g_bytes_new_with_free_func (pixels->map.data + offset,
++                                      pixels->map.size - offset,
++                                      mapped_pixels_free, pixels);
++  builder = gdk_memory_texture_builder_new ();
++  gdk_memory_texture_builder_set_width (builder, GST_VIDEO_INFO_WIDTH (info));
++  gdk_memory_texture_builder_set_height (builder, GST_VIDEO_INFO_HEIGHT (info));
++  gdk_memory_texture_builder_set_format (builder, format);
++  gdk_memory_texture_builder_set_stride (builder, stride);
++  gdk_memory_texture_builder_set_bytes (builder, bytes);
++  gdk_memory_texture_builder_set_color_state (builder, gdk_color_state_get_rec2100_pq ());
++  texture = gdk_memory_texture_builder_build (builder);
++  g_object_unref (builder);
++  g_bytes_unref (bytes);
++  return texture;
++}
++
++static void
++render_done (GObject      *source,
++             GAsyncResult *async,
++             gpointer      unused)
++{
++  GTask *task = G_TASK (async);
++  RenderJob *job = g_task_get_task_data (task);
++  RenderResult *result = g_task_propagate_pointer (task, NULL);
++  GtkGstDoviView *self = g_weak_ref_get (&job->view);
++  GdkTexture *texture = NULL;
++
++  (void) source;
++  (void) unused;
++  if (self == NULL)
++    {
++      render_result_free (result);
++      return;
++    }
++  /* Refresh actual GTK state before accepting a worker result. Deferred
++   * changed delivery must not make a vanished native witness appear current. */
++  view_update (self);
++  self->busy = FALSE;
++  if (self->context_ready && self->target_revision == job->target_revision &&
++      self->binding_epoch == job->binding_epoch &&
++      gtk_gst_paintable_frame_is_current (self->producer, job->frame) &&
++      (self->visible == NULL || job->frame->serial >= self->visible->serial))
++    {
