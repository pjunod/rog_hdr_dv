From 2568b2176cab5e64bc1e01dc5a6fdfbc946f833c Mon Sep 17 00:00:00 2001
From: ROG HDR contributors <rog-hdr@invalid>
Date: Sun, 8 Nov 2026 04:21:12 -0500
Subject: [PATCH 12/12] build(debian): package per-view GtkVideo support as
 rogdv4

---
 debian/changelog                        |    9 +
 debian/control                          |    1 +
 debian/patches/gtkvideo-dovi-view.patch | 1238 +++++++++++++++++++++++
 debian/patches/series                   |    1 +
 debian/rules                            |    5 +-
 5 files changed, 1253 insertions(+), 1 deletion(-)
 create mode 100644 debian/patches/gtkvideo-dovi-view.patch

diff --git a/debian/changelog b/debian/changelog
index 4f42fb1..d3c4955 100644
--- a/debian/changelog
+++ b/debian/changelog
@@ -1,3 +1,12 @@
+gtk4 (4.24.1+ds-1+rogdv4) stonking; urgency=medium
+
+  * Bind retained Dolby Vision pictures to each realized GtkVideo surface.
+  * Preserve paused retargeting, source invalidation and independent views.
+  * Load the optional mapping SDK only after validating its complete ABI.
+  * Recommend the normal GStreamer mapper integration on supported systems.
+
+ -- ROG HDR contributors <rog-hdr@invalid>  Sun, 08 Nov 2026 10:00:00 +0000
+
 gtk4 (4.24.1+ds-1+rogdv3) stonking; urgency=medium
 
   * Query the supported GLES framebuffer readback format and type.
