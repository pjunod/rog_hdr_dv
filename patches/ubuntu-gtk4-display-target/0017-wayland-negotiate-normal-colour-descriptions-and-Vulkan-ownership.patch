new file mode 100644
index 0000000..ff486e9
--- /dev/null
+++ b/testsuite/gdk/wayland-color.c
@@ -0,0 +1,363 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "config.h"
+#include <gtk/gtk.h>
+#include <errno.h>
+#include <drm_fourcc.h>
+#include <fcntl.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+/* Exercise the actual private producer and its generated protocol listeners.
+ * No copied transfer/identity implementation and no test-only product API. */
+#include "../../gdk/wayland/gdkwaylandcolor.c"
+
+#ifndef WP_IMAGE_DESCRIPTION_V1_READY2_SINCE_VERSION
+#error This regression fixture requires color-management-v1 XML version 2
+#endif
+
+typedef struct {
+  struct wl_display *display;
+  struct wl_registry *registry;
+  GdkWaylandColor *color;
+  int peer;
+  GByteArray *requests;
+  guint owners, bindings, luminance_requests;
+  guint32 creator, description, transfer;
+  guint32 luminances[3];
+} Fixture;
+
+typedef struct {
+  guint invalidated, published;
+  GdkWaylandColorTarget target;
+} Snapshot;
+
+static int
+message_index (const struct wl_interface *interface, gboolean event, const char *name)
+{
+  const struct wl_message *messages = event ? interface->events : interface->methods;
+  int count = event ? interface->event_count : interface->method_count;
+  for (int i = 0; i < count; i++)
+    if (g_str_equal (messages[i].name, name))
+      return i;
+  g_assert_not_reached ();
+}
+
+static void
+emit (Fixture *f, guint32 object, const struct wl_interface *interface,
+      const char *name, const guint32 *values, guint n_values)
+{
+  guint32 packet[16];
+  g_assert_cmpuint (n_values, <=, G_N_ELEMENTS (packet) - 2);
+  packet[0] = object;
+  packet[1] = ((n_values + 2) * 4 << 16) | message_index (interface, TRUE, name);
+  if (n_values)
+    memcpy (packet + 2, values, n_values * 4);
+  g_assert_cmpint (write (f->peer, packet, (n_values + 2) * 4), ==, (n_values + 2) * 4);
+  g_assert_cmpint (wl_display_dispatch (f->display), >=, 0);
+}
+
+static void
+advertise (Fixture *f, const char *name, guint32 value)
+{
+  emit (f, wl_proxy_get_id ((struct wl_proxy *) f->color->color_manager),
+        &wp_color_manager_v1_interface, name, &value, 1);
+}
+
+static void
+collect (Fixture *f)
+{
+  guint8 bytes[4096];
+  ssize_t n;
+  g_assert_cmpint (wl_display_flush (f->display), >=, 0);
+  while ((n = read (f->peer, bytes, sizeof bytes)) > 0)
+    g_byte_array_append (f->requests, bytes, n);
+  g_assert_true (n < 0 && errno == EAGAIN);
+  while (f->requests->len >= 8)
+    {
+      guint32 header[2], value;
+      memcpy (header, f->requests->data, 8);
+      guint size = header[1] >> 16, opcode = header[1] & 0xffff;
+      g_assert_cmpuint (size, >=, 8);
+      if (size > f->requests->len)
+        break;
+      value = 0;
+      if (size >= 12)
+        memcpy (&value, f->requests->data + 8, 4);
+      guint32 manager = f->color->color_manager
+                      ? wl_proxy_get_id ((struct wl_proxy *) f->color->color_manager) : 0;
+      if (header[0] == manager)
+        {
+          if (opcode == message_index (&wp_color_manager_v1_interface, FALSE, "get_surface"))
+            f->owners++;
+          if (opcode == message_index (&wp_color_manager_v1_interface, FALSE, "create_parametric_creator"))
+            f->creator = value;
+        }
+      if (header[0] == f->creator && f->creator)
+        {
+          if (opcode == message_index (&wp_image_description_creator_params_v1_interface, FALSE, "set_tf_named"))
+            f->transfer = value;
+          if (opcode == message_index (&wp_image_description_creator_params_v1_interface, FALSE, "set_luminances"))
+            {
+              f->luminance_requests++;
+              memcpy (f->luminances, f->requests->data + 8, sizeof f->luminances);
+            }
+          if (opcode == message_index (&wp_image_description_creator_params_v1_interface, FALSE, "create"))
+            {
+              f->description = value;
+              f->creator = 0;
+            }
+        }
+      g_byte_array_remove_range (f->requests, 0, size);
+    }
+}
+
+static Fixture
+fixture_new (guint version)
+{
+  Fixture f = { 0 };
+  int sockets[2];
+  g_assert_cmpint (socketpair (AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, sockets), ==, 0);
+  f.display = wl_display_connect_to_fd (sockets[0]);
+  g_assert_nonnull (f.display);
+  f.peer = sockets[1];
+  g_assert_cmpint (fcntl (f.peer, F_SETFL, O_NONBLOCK), ==, 0);
+  f.registry = wl_display_get_registry (f.display);
+  f.requests = g_byte_array_new ();
+  /* No GDK display/window is opened. Successful asynchronous paths below do
+   * not dereference the display; all protocol objects use this socket pair. */
+  f.color = gdk_wayland_color_new (NULL);
+  if (version)
+    {
+      gdk_wayland_color_set_color_manager (f.color, f.registry, 1, version);
+      g_assert_cmpuint (wp_color_manager_v1_get_version (f.color->color_manager), ==, version);
+      advertise (&f, "supported_feature", WP_COLOR_MANAGER_V1_FEATURE_PARAMETRIC);
+      advertise (&f, "supported_primaries_named", WP_COLOR_MANAGER_V1_PRIMARIES_SRGB);
+    }
+  return f;
+}
+
+static void
+fixture_free (Fixture *f)
+{
+  gdk_wayland_color_free (f->color);
+  wl_registry_destroy (f->registry);
+  wl_display_disconnect (f->display);
+  close (f->peer);
+  g_byte_array_unref (f->requests);
+}
+
+static void
+ready (Fixture *f, guint32 object, guint version, guint32 hi, guint32 lo)
+{
+  if (version >= 2)
+    emit (f, object, &wp_image_description_v1_interface, "ready2", (guint32[]) { hi, lo }, 2);
+  else
+    emit (f, object, &wp_image_description_v1_interface, "ready", &lo, 1);
+}
+
+static void
+snapshot (GdkWaylandColorSurface *surface, GdkColorState *cs,
+          const GdkWaylandColorTarget *target, gpointer data)
+{
+  Snapshot *seen = data;
+  if (!cs)
+    seen->invalidated++;
+  if (target)
+    {
+      seen->published++;
+      seen->target = *target;
+    }
+}
+
+static void
+test_exact_transfer (gconstpointer data)
+{
+  guint version = GPOINTER_TO_UINT (data);
+  Fixture f = fixture_new (version);
+  guint exact = version >= 2 ? WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_COMPOUND_POWER_2_4
+                            : WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_EXT_SRGB;
+  advertise (&f, "supported_tf_named", exact);
+  g_assert_cmpuint (cicp_to_wl_transfer (13, version, 1u << WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_SRGB), ==, 0);
+  g_assert_cmpuint (cicp_to_wl_transfer (13, version, 1u << exact), ==, exact);
+  if (version >= 2)
+    g_assert_cmpuint (cicp_to_wl_transfer (13, version, 1u << WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_EXT_SRGB), ==, 0);
+  else
+    g_assert_cmpuint (cicp_to_wl_transfer (13, version, 1u << WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_COMPOUND_POWER_2_4), ==, 0);
+  g_assert_cmpuint (cicp_to_wl_transfer (8, version, 1u << WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_EXT_LINEAR), ==,
+                   WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_EXT_LINEAR);
+  create_image_desc (f.color, GDK_COLOR_STATE_SRGB, FALSE, FALSE);
+  collect (&f);
+  g_assert_cmpuint (f.transfer, ==, exact);
+  /* Ordinary SDR uses protocol defaults, not the observed output white203. */
+  g_assert_cmpuint (f.luminance_requests, ==, 0);
+  ready (&f, f.description, version, 1, 7);
+  g_assert_nonnull (g_hash_table_lookup (f.color->cs_to_desc, GDK_COLOR_STATE_SRGB));
+  fixture_free (&f);
+}
+
+static void
+test_tokens (void)
+{
+  GdkWaylandColor *color = gdk_wayland_color_new (NULL);
+  ImageDescriptionIdentity *a = image_description_identity_ref (color, G_GUINT64_CONSTANT (0x100000007));
+  ImageDescriptionIdentity *same = image_description_identity_ref (color, G_GUINT64_CONSTANT (0x100000007));
+  color->next_identity = G_MAXUINT32; /* Exercise wrap while token1 is live. */
+  ImageDescriptionIdentity *b = image_description_identity_ref (color, G_GUINT64_CONSTANT (0x200000007));
+  g_assert_true (a == same);
+  g_assert_cmpuint (a->token, !=, b->token);
+  image_description_identity_unref (color, same);
+  g_assert_cmpuint (g_hash_table_size (color->identities_by_wire), ==, 2);
+  image_description_identity_unref (color, a);
+  image_description_identity_unref (color, b);
+  for (guint i = 0; i < 1000; i++)
+    image_description_identity_unref (color, image_description_identity_ref (color, i + 1));
+  g_assert_cmpuint (g_hash_table_size (color->identities_by_wire), ==, 0);
+  g_assert_cmpuint (g_hash_table_size (color->identities_by_token), ==, 0);
+  gdk_wayland_color_free (color);
+}
+
+static void
+test_preferred_events (gconstpointer data)
+{
+  guint version = GPOINTER_TO_UINT (data);
+  Fixture f = fixture_new (version);
+  Snapshot seen = { 0 };
+  f.color->rendering_enabled = FALSE;
+  struct wl_surface *wl_surface = wl_registry_bind (f.registry, 2, &wl_surface_interface, 1);
+  GdkWaylandColorSurface *surface = gdk_wayland_color_surface_new (f.color, wl_surface, snapshot, &seen);
+  g_assert_cmpuint (seen.invalidated, ==, 1);
+  guint32 image = wl_proxy_get_id ((struct wl_proxy *) surface->current_desc->image_desc);
+  ready (&f, image, version, 1, 7);
+  g_assert_cmpuint (surface->current_desc->identity->wire, ==,
+                   version >= 2 ? G_GUINT64_CONSTANT (0x100000007) : 7);
+  guint32 info = wl_proxy_get_id ((struct wl_proxy *) surface->current_desc->info);
+  emit (&f, info, &wp_image_description_info_v1_interface, "luminances", (guint32[]) { 2000, 80, 80 }, 3);
+  emit (&f, info, &wp_image_description_info_v1_interface, "target_primaries",
+        (guint32[]) { 708000,292000,170000,797000,131000,46000,312700,329000 }, 8);
+  emit (&f, info, &wp_image_description_info_v1_interface, "target_luminance", (guint32[]) { 5, 616 }, 2);
+  emit (&f, info, &wp_image_description_info_v1_interface, "done", NULL, 0);
+  g_assert_cmpuint (seen.published, ==, 1);
+  g_assert_cmpfloat (seen.target.reference_luminance, ==, 80);
+  g_assert_cmpfloat (seen.target.min_luminance, ==, 0.0005);
+  g_assert_nonnull (surface->published_description); /* Prevent v1 wire-ID recycling while published. */
+  g_assert_cmpuint (g_hash_table_size (f.color->identities_by_wire), ==, 1);
+  guint32 feedback = wl_proxy_get_id ((struct wl_proxy *) surface->mgmt_feedback);
+  if (version >= 2)
+    emit (&f, feedback, &wp_color_management_surface_feedback_v1_interface, "preferred_changed2", (guint32[]) { 2, 7 }, 2);
+  else
+    emit (&f, feedback, &wp_color_management_surface_feedback_v1_interface, "preferred_changed", (guint32[]) { 7 }, 1);
+  g_assert_cmpuint (seen.invalidated, ==, 2);
+  g_assert_null (surface->published_description);
+  g_assert_cmpuint (g_hash_table_size (f.color->identities_by_wire), ==, 0);
+  gdk_wayland_color_surface_free (surface); /* Cancels the pending replacement safely. */
+  wl_surface_destroy (wl_surface);
+  fixture_free (&f);
+}
+
+static void
+test_normal_sdr_owner (void)
+{
+  Fixture f = fixture_new (2);
+  advertise (&f, "supported_tf_named", WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_COMPOUND_POWER_2_4);
+  create_image_desc (f.color, GDK_COLOR_STATE_SRGB, FALSE, FALSE);
+  collect (&f);
+  ready (&f, f.description, 2, 0, 9);
+  struct wl_surface *wl_surface = wl_registry_bind (f.registry, 4, &wl_surface_interface, 1);
+  GdkWaylandColorSurface *surface = gdk_wayland_color_surface_new (f.color, wl_surface, NULL, NULL);
+  gdk_wayland_color_surface_set_color_state (surface, GDK_COLOR_STATE_SRGB, DRM_FORMAT_RGBA8888, TRUE);
+  g_assert_false (gdk_wayland_color_surface_has_hdr_description (surface));
+  g_assert_false (gdk_wayland_color_surface_request_hdr (surface, FALSE));
+  collect (&f);
+  g_assert_cmpuint (f.owners, ==, 1);
+  g_assert_cmpuint (f.luminance_requests, ==, 0);
+  gdk_wayland_color_surface_free (surface);
+  wl_surface_destroy (wl_surface);
+  fixture_free (&f);
+}
+
+static void
+test_owner_and_lease (void)
+{
+  Fixture f = fixture_new (2);
+  gdk_wayland_color_set_color_representation (f.color, f.registry, 3, 1);
+  advertise (&f, "supported_feature", WP_COLOR_MANAGER_V1_FEATURE_SET_LUMINANCES);
+  advertise (&f, "supported_intent", WP_COLOR_MANAGER_V1_RENDER_INTENT_PERCEPTUAL);
+  advertise (&f, "supported_tf_named", WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_ST2084_PQ);
+  advertise (&f, "supported_primaries_named", WP_COLOR_MANAGER_V1_PRIMARIES_BT2020);
+  guint32 repr = wl_proxy_get_id ((struct wl_proxy *) f.color->color_representation_manager);
+  emit (&f, repr, &wp_color_representation_manager_v1_interface, "supported_alpha_mode", (guint32[]) { 0 }, 1);
+  emit (&f, repr, &wp_color_representation_manager_v1_interface, "supported_coefficients_and_ranges", (guint32[]) { 1, 1 }, 2);
+  create_image_desc (f.color, GDK_COLOR_STATE_REC2100_PQ, FALSE, TRUE);
+  collect (&f);
+  ready (&f, f.description, 2, 0, 8);
+  g_assert_cmpuint (f.luminances[0], ==, 0);
+  g_assert_cmpuint (f.luminances[1], ==, 10000);
+  g_assert_cmpuint (f.luminances[2], ==, 203); /* Existing native lease normalization only. */
+  struct wl_surface *wl_surface = wl_registry_bind (f.registry, 4, &wl_surface_interface, 1);
+  f.color->rendering_enabled = FALSE;
+  GdkWaylandColorSurface *surface = gdk_wayland_color_surface_new (f.color, wl_surface, NULL, NULL);
+  collect (&f);
+  g_assert_cmpuint (f.owners, ==, 0);
+  /* Even before a lease, the renderer must reserve the GTK/pass-through path. */
+  g_assert_true (gdk_wayland_color_surface_needs_passthrough (surface));
+  g_assert_true (gdk_wayland_color_surface_request_hdr (surface, TRUE));
+  collect (&f);
+  g_assert_cmpuint (f.owners, ==, 1);
+  gdk_wayland_color_surface_set_color_state (surface, GDK_COLOR_STATE_REC2100_PQ, DRM_FORMAT_RGBA8888, TRUE);
+  g_assert_true (gdk_wayland_color_surface_has_hdr_description (surface));
+  g_assert_false (gdk_wayland_color_surface_request_hdr (surface, FALSE));
+  g_assert_false (gdk_wayland_color_surface_has_hdr_description (surface));
+  g_assert_true (gdk_wayland_color_surface_request_hdr (surface, TRUE));
+  collect (&f);
+  g_assert_cmpuint (f.owners, ==, 1); /* Native transition never acquires a second owner. */
+  gdk_wayland_color_surface_free (surface);
+  wl_surface_destroy (wl_surface);
+  fixture_free (&f);
+}
+
+static void
+test_legacy_and_unknown (void)
+{
+  Fixture f = fixture_new (0);
+  struct wl_surface *wl_surface = wl_registry_bind (f.registry, 2, &wl_surface_interface, 1);
+  GdkWaylandColorSurface *surface = gdk_wayland_color_surface_new (f.color, wl_surface, NULL, NULL);
+  g_assert_false (gdk_wayland_color_surface_needs_passthrough (surface));
+  gdk_wayland_color_set_color_manager (f.color, f.registry, 1, 2);
+  /* A manager arriving later must not steal a legacy WSI surface. */
+  g_assert_false (gdk_wayland_color_surface_request_hdr (surface, TRUE));
+  advertise (&f, "supported_tf_named", 32);
+  advertise (&f, "supported_feature", G_MAXUINT32);
+  advertise (&f, "supported_primaries_named", 32);
+  advertise (&f, "supported_intent", 32);
+  g_assert_cmpuint (f.color->color_manager_supported.transfers, ==, 0);
+  g_assert_cmpuint (f.color->color_manager_supported.features, ==, 0);
+  g_assert_cmpuint (f.color->color_manager_supported.primaries, ==, 0);
+  g_assert_cmpuint (f.color->color_manager_supported.intents, ==, 0);
+  g_assert_cmpuint (wl_to_cicp_transfer (G_MAXUINT32), ==, 0);
+  gdk_wayland_color_set_color_representation (f.color, f.registry, 3, 1);
+  guint32 repr = wl_proxy_get_id ((struct wl_proxy *) f.color->color_representation_manager);
+  emit (&f, repr, &wp_color_representation_manager_v1_interface, "supported_alpha_mode", (guint32[]) { 32 }, 1);
+  emit (&f, repr, &wp_color_representation_manager_v1_interface, "supported_coefficients_and_ranges", (guint32[]) { 32, 1 }, 2);
+  g_assert_cmpuint (f.color->color_representation_supported.alpha_modes, ==, 0);
+  g_assert_cmpuint (f.color->color_representation_supported.coefficients_full, ==, 0);
+  collect (&f);
+  g_assert_cmpuint (f.owners, ==, 0);
+  gdk_wayland_color_surface_free (surface);
+  wl_surface_destroy (wl_surface);
+  fixture_free (&f);
+}
+
+int
+main (int argc, char **argv)
+{
+  g_test_init (&argc, &argv, NULL);
+  g_test_add_data_func ("/wayland/color/v1-exact-transfer", GUINT_TO_POINTER (1), test_exact_transfer);
+  g_test_add_data_func ("/wayland/color/v2-exact-transfer", GUINT_TO_POINTER (2), test_exact_transfer);
+  g_test_add_func ("/wayland/color/bounded-identities", test_tokens);
+  g_test_add_data_func ("/wayland/color/v1-preferred-events", GUINT_TO_POINTER (1), test_preferred_events);
+  g_test_add_data_func ("/wayland/color/v2-preferred-events", GUINT_TO_POINTER (2), test_preferred_events);
+  g_test_add_func ("/wayland/color/normal-sdr-owner", test_normal_sdr_owner);
+  g_test_add_func ("/wayland/color/native-lease-owner", test_owner_and_lease);
+  g_test_add_func ("/wayland/color/legacy-and-unknown", test_legacy_and_unknown);
+  return g_test_run ();
+}
