+static ImageDescriptionIdentity *
+image_description_identity_ref (GdkWaylandColor *color,
+                                 guint64          wire)
+{
+  ImageDescriptionIdentity *identity;
+
+  identity = g_hash_table_lookup (color->identities_by_wire, &wire);
+  if (!identity)
+    {
+      identity = g_new0 (ImageDescriptionIdentity, 1);
+      identity->wire = wire;
+      do
+        {
+          color->next_identity++;
+          if (color->next_identity == 0)
+            color->next_identity++;
+        }
+      while (g_hash_table_contains (color->identities_by_token,
+                                    GUINT_TO_POINTER (color->next_identity)));
+      identity->token = color->next_identity;
+      g_hash_table_insert (color->identities_by_wire, &identity->wire, identity);
+      g_hash_table_insert (color->identities_by_token,
+                           GUINT_TO_POINTER (identity->token), identity);
+    }
+  identity->references++;
+  return identity;
+}
+
+static void
+image_description_identity_unref (GdkWaylandColor        *color,
+                                   ImageDescriptionIdentity *identity)
+{
+  if (!identity || --identity->references != 0)
+    return;
+  g_hash_table_remove (color->identities_by_token, GUINT_TO_POINTER (identity->token));
+  g_hash_table_remove (color->identities_by_wire, &identity->wire);
+}
