From d683e707b2cb2e54ca68e532ce72d90431c7e275 Mon Sep 17 00:00:00 2001
From: Paul Junod <donujp@gmail.com>
Date: Wed, 7 Oct 2026 23:08:59 -0400
Subject: [PATCH 02/14] test: cover private DisplayID parsing, precedence and
 allocation failure

Port the EDID-only upstream matrix through unchanged 0.3 public headers.
Pin the documented downstream unusable-CTA difference without erasing
valid authority. Compile private parser objects statically for effective
allocation wrapping, and assert successful earlier nested children are
released when a later child fails, including the EDID extension path.
---
 test/displayid2-allocation.c | 145 +++++++++++
 test/displayid2-bounds.c     |  50 ++++
 test/displayid2-private.c    | 144 +++++++++++
 test/meson.build             |  22 ++
 test/old-header-consumer.c   | 460 +++++++++++++++++++++++++++++++++++
 5 files changed, 821 insertions(+)
 create mode 100644 test/displayid2-allocation.c
 create mode 100644 test/displayid2-bounds.c
 create mode 100644 test/displayid2-private.c
 create mode 100644 test/old-header-consumer.c

diff --git a/test/displayid2-allocation.c b/test/displayid2-allocation.c
new file mode 100644
index 0000000..ba2a8db
--- /dev/null
+++ b/test/displayid2-allocation.c
@@ -0,0 +1,145 @@
+#include <assert.h>
+#include <errno.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <libdisplay-info/info.h>
+#include "displayid2.h"
+
+void *__real_calloc(size_t count, size_t size);
+void __real_free(void *ptr);
+void *__wrap_calloc(size_t count, size_t size);
+void __wrap_free(void *ptr);
+
+static bool enabled, fail_second_svd, failure_reached;
+static size_t attempts, fail_at, live, svds;
+static void *allocated[4096];
+static bool released[4096];
+
+void *
+__wrap_calloc(size_t count, size_t size)
+{
+	void *ptr;
+	size_t index;
+
+	if (!enabled)
+		return __real_calloc(count, size);
+	index = attempts++;
+	assert(index < 4096);
+	if (count == 1 && size == sizeof(struct di_cta_svd))
+		svds++;
+	if (attempts == fail_at || (fail_second_svd && svds == 2 &&
+	    count == 1 && size == sizeof(struct di_cta_svd))) {
+		failure_reached = true;
+		errno = ENOMEM;
+		return NULL;
+	}
+	ptr = __real_calloc(count, size);
+	assert(ptr);
+	allocated[index] = ptr;
+	live++;
+	return ptr;
+}
+
+void
+__wrap_free(void *ptr)
+{
+	size_t i;
+
+	if (enabled && ptr) {
+		for (i = 0; i < attempts; i++) {
+			if (allocated[i] == ptr && !released[i]) {
+				released[i] = true;
+				assert(live > 0);
+				live--;
+				break;
+			}
+		}
+	}
+	__real_free(ptr);
+}
+
+static void
+checksum(uint8_t *data, size_t size)
+{
+	uint8_t sum = 0;
+	size_t i;
+
+	data[size - 1] = 0;
+	for (i = 0; i < size - 1; i++)
+		sum += data[i];
+	data[size - 1] = (uint8_t) (0 - sum);
+}
+
+static void
+reset(size_t fail)
+{
+	assert(live == 0);
+	memset(allocated, 0, sizeof(allocated));
+	memset(released, 0, sizeof(released));
+	attempts = svds = 0;
+	fail_at = fail;
+	failure_reached = fail_second_svd = false;
+}
+
+int
+main(int argc, char *argv[])
+{
+	uint8_t section[] = {
+		0x20, 21, 2, 0,
+		0x26, 0, 9, 4, 0, 0, 0, 0, 0, 0x40, 0, 0,
+		0x81, 0, 6, 0x41, 16, 0x41, 17, 0x41, 18, 0,
+	};
+	uint8_t edid[256] = {0};
+	FILE *log = tmpfile(), *fixture;
+	struct di_logger logger = {.f = log, .section = "allocation"};
+	struct di_displayid2 d;
+	struct di_info *info;
+	bool ok;
+	size_t fail;
+
+	assert(log && argc == 2);
+	checksum(section, sizeof(section));
+	for (fail = 1; fail <= 9; fail++) {
+		reset(fail);
+		memset(&d, 0, sizeof(d));
+		enabled = true;
+		errno = ENOMEM; /* unrelated stale errno must not imply failure */
+		ok = _di_displayid2_parse(&d, section, sizeof(section), &logger);
+		assert(ok == (fail == 9));
+		assert(failure_reached == (fail != 9));
+		if (!ok)
+			assert(errno == ENOMEM);
+		if (fail == 6) {
+			/* First nested SVD completed before the second child's SVD failed. */
+			assert(svds == 2 && allocated[3] && released[3]);
+			assert(d.data_blocks_len == 1 && live == 1);
+		}
+		_di_displayid2_finish(&d);
+		_di_displayid2_finish(&d);
+		assert(live == 0 && errno == ENOMEM);
+		enabled = false;
+	}
+	/* Reach the same nested child failure through failed EDID extension cleanup. */
+	fixture = fopen(argv[1], "rb");
+	if (!fixture)
+		abort();
+	assert(fread(edid, 128, 1, fixture) == 1);
+	fclose(fixture);
+	edid[126] = 1;
+	checksum(edid, 128);
+	edid[128] = 0x70;
+	memcpy(edid + 129, section, sizeof(section));
+	checksum(edid + 128, 128);
+	reset(0);
+	fail_second_svd = enabled = true;
+	info = di_info_parse_edid(edid, sizeof(edid));
+	assert(!info && failure_reached && svds == 2);
+	assert(errno == ENOMEM && live == 0);
+	enabled = false;
+	fclose(log);
+	puts("wrapped static nested allocation failure and extension cleanup: PASS");
+	return 0;
+}
diff --git a/test/displayid2-bounds.c b/test/displayid2-bounds.c
new file mode 100644
index 0000000..2dc57c5
--- /dev/null
+++ b/test/displayid2-bounds.c
@@ -0,0 +1,50 @@
+#include <assert.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include "displayid2.h"
+#include <stdio.h>
+
+static void
+check(size_t payload, uint8_t declared)
+{
+	uint8_t *data = calloc(1, payload + 5);
+	struct di_displayid2 info = {0};
+	FILE *log = tmpfile();
+	struct di_logger logger = {.f = log, .section = "bounds"};
+	uint8_t sum = 0;
+	size_t i;
+
+	assert(data);
+	data[0] = 0x20;
+	data[1] = (uint8_t) payload;
+	data[2] = 2;
+	if (payload >= 3) {
+		data[4] = 0x20;
+		data[6] = declared;
+	} else if (payload) {
+		data[4] = 1;
+	}
+	for (i = 0; i < payload + 4; i++)
+		sum += data[i];
+	data[payload + 4] = (uint8_t) (0 - sum);
+	assert(log);
+	assert(_di_displayid2_parse(&info, data, payload + 5, &logger));
+	_di_displayid2_finish(&info);
+	_di_displayid2_finish(&info);
+	fclose(log);
+	free(data);
+}
+
+int
+main(void)
+{
+	check(0, 0);
+	check(1, 0);
+	check(2, 0);
+	check(3, 0);
+	check(3, 255);
+	check(12, 9);
+	check(3, 187); /* zero checksum, oversized block */
+	return 0;
+}
diff --git a/test/displayid2-private.c b/test/displayid2-private.c
new file mode 100644
index 0000000..4067105
--- /dev/null
+++ b/test/displayid2-private.c
@@ -0,0 +1,144 @@
+#include <assert.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include "displayid2.h"
+#include <stdio.h>
+
+static void
+checksum(uint8_t *data, size_t size)
+{
+	uint8_t sum = 0;
+	size_t i;
+
+	data[size - 1] = 0;
+	for (i = 0; i < size - 1; i++)
+		sum += data[i];
+	data[size - 1] = (uint8_t) (0 - sum);
+}
+
+static struct di_displayid2 *
+parse(const uint8_t *blocks, size_t size, FILE *log)
+{
+	uint8_t *data = calloc(1, size + 5);
+	struct di_displayid2 *displayid2 = calloc(1, sizeof(*displayid2));
+	struct di_logger logger = {.f = log, .section = "test"};
+
+	if (!data || !displayid2)
+		abort();
+	data[0] = 0x20;
+	data[1] = (uint8_t) size;
+	data[2] = 2;
+	memcpy(data + 4, blocks, size);
+	checksum(data, size + 5);
+	assert(_di_displayid2_parse(displayid2, data, size + 5, &logger));
+	free(data);
+	return displayid2;
+}
+
+static void
+check(const uint8_t *block, size_t size, bool valid)
+{
+	FILE *log = tmpfile();
+	struct di_displayid2 *d;
+	const struct di_displayid2_data_block *const *blocks;
+	const struct di_displayid2_interface_features *f;
+	size_t i;
+
+	assert(log);
+	d = parse(block, size, log);
+	blocks = _di_displayid2_get_data_blocks(d);
+	assert((blocks[0] != NULL) == valid);
+	if (!valid)
+		assert(ftell(log) > 0);
+	if (valid) {
+		f = _di_displayid2_data_block_get_interface_features(blocks[0]);
+		assert(f);
+		assert(f->rgb_bit_depths == (block[3] & 0x3F));
+		assert(f->ycbcr444_bit_depths == (block[4] & 0x3F));
+		assert(f->ycbcr422_bit_depths == (block[5] & 0x1F));
+		assert(f->ycbcr420_bit_depths == (block[6] & 0x1F));
+		assert(f->ycbcr420_min_pixel_rate == 74.25f * block[7]);
+		assert(f->audio_capabilities == block[8]);
+		assert(f->standard_combinations == (block[9] & 0x7F));
+		assert(f->additional_combinations_len == block[11]);
+		for (i = 0; i < block[11]; i++) {
+			assert(f->additional_combinations[i].color_space == block[12 + i] >> 4);
+			assert(f->additional_combinations[i].eotf == (block[12 + i] & 15));
+		}
+	}
+	_di_displayid2_finish(d);
+	_di_displayid2_finish(d); /* idempotent */
+	free(d);
+	fclose(log);
+}
+
+int
+main(void)
+{
+	uint8_t block[20] = {0x26, 0, 9, 4, 0, 0, 0, 0, 0, 0x50, 0, 0};
+	uint8_t full[] = {
+		0x26, 0, 16, 0x3F, 0x12, 0x1F, 0x19, 2, 0xE0, 0x7F, 0, 7,
+		0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x68,
+	};
+	uint8_t other[] = {0x20, 0, 0};
+	uint8_t two[24];
+	struct di_displayid2 *info;
+	FILE *log = tmpfile();
+	const struct di_displayid2_data_block *const *blocks;
+	size_t i;
+
+	check(full, sizeof(full), true);
+	info = parse(other, sizeof(other), log);
+	blocks = _di_displayid2_get_data_blocks(info);
+	assert(blocks[0] && !_di_displayid2_data_block_get_interface_features(blocks[0]));
+	_di_displayid2_finish(info);
+	free(info);
+	check(block, 12, true);
+	block[1] = 1;
+	check(block, 12, false);
+	block[1] = 8;
+	check(block, 12, false);
+	block[1] = 0;
+	for (i = 0; i < 9; i++) {
+		block[2] = (uint8_t) i;
+		check(block, i + 3, false);
+	}
+	block[2] = 9;
+	block[9] = 0x80;
+	check(block, 12, true); /* reserved bit never becomes a standard tuple */
+	block[9] = 0xC0;
+	block[11] = 1;
+	block[2] = 10;
+	block[12] = 0xFF;
+	check(block, 13, true); /* known standard tuple survives unknown pair */
+	block[12] = 0x68;
+	check(block, 13, true);
+	block[12] = 0x86;
+	check(block, 13, true); /* nibble order is not coerced */
+	block[11] = 7;
+	block[2] = 16;
+	check(block, 19, true);
+	block[11] = 8;
+	block[2] = 17;
+	check(block, 20, false);
+	block[11] = 1;
+	block[2] = 9;
+	check(block, 12, false); /* truncated pair */
+	block[11] = 0;
+	block[2] = 10;
+	check(block, 13, false); /* trailing payload */
+	block[2] = 9;
+	memcpy(two, block, 12);
+	memcpy(two + 12, block, 12);
+	two[1] = 1;
+	info = parse(two, sizeof(two), log);
+	blocks = _di_displayid2_get_data_blocks(info);
+	assert(blocks[0] && !blocks[1]); /* malformed block doesn't shadow valid */
+	_di_displayid2_finish(info);
+	free(info);
+	for (i = 0; i < 1000; i++)
+		check(block, 12, true);
+	fclose(log);
+	return 0;
+}
