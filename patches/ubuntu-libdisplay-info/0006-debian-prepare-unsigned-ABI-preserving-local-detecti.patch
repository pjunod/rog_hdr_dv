++	}
++	memcpy(cta, positive_hdr, sizeof(positive_hdr));
++	blocks[0] = 0x81;
++	blocks[1] = 0;
++	/* Nested EDID CTA also preserves positive metadata with native appended. */
++	memcpy(cta + sizeof(positive_hdr), positive_color, sizeof(positive_color));
++	len = sizeof(positive_hdr) + sizeof(positive_color);
++	blocks[2] = (uint8_t) len;
++	memcpy(blocks + 3, cta, len);
++	info = parse(blocks, len + 3);
++	memcpy(blocks + len + 3, native, sizeof(native));
++	{
++		struct di_info *with_native = parse(blocks, len + 3 + sizeof(native));
++		assert_same(info, with_native);
++		di_info_destroy(with_native);
++	}
++	di_info_destroy(info);
++}
++
++static void
++print_loaded_library(void)
++{
++	FILE *maps = fopen("/proc/self/maps", "r");
++	char line[1024];
++	bool found = false;
++
++	assert(maps);
++	while (fgets(line, sizeof(line), maps)) {
++		if (strstr(line, "libdisplay-info.so")) {
++			printf("loaded: %s", line);
++			found = true;
++		}
++	}
++	fclose(maps);
++	assert(found);
++	printf("struct sizes: HDR=%zu, signal=%zu\n",
++	       sizeof(struct di_hdr_static_metadata), sizeof(struct di_supported_signal_colorimetry));
++}
++
++static void
++check_unusable_cta(void)
++{
++	uint8_t blocks[64], malformed[] = {0x81, 1, 0};
++	uint8_t empty[] = {0x81, 0, 0};
++	uint8_t audio[] = {0x81, 0, 4, 0x23, 0x09, 0x07, 0x01};
++	uint8_t rejected[] = {0x81, 0, 2, 0xE1, 6};
++	uint8_t tail[] = {0x81, 0, 1, 0xE3};
++	static const uint8_t positive[] = {0x81, 0, 7, 0xE6, 6, 0x0F, 1, 96, 80, 4};
++	struct di_info *baseline, *info;
++	size_t order, short_size;
++	uint8_t short_header[] = {0x81, 0};
++
++	for (short_size = 1; short_size <= 2; short_size++) {
++		memcpy(blocks, native, sizeof(native));
++		memcpy(blocks + sizeof(native), short_header, short_size);
++		check(blocks, sizeof(native) + short_size, false);
++		check_extensions(native, sizeof(native), short_header, short_size, false);
++		check_extensions(short_header, short_size, native, sizeof(native), false);
++		baseline = parse(positive, sizeof(positive));
++		memcpy(blocks + sizeof(native), positive, sizeof(positive));
++		memcpy(blocks + sizeof(native) + sizeof(positive), short_header, short_size);
++		info = parse(blocks, sizeof(native) + sizeof(positive) + short_size);
++		assert_same(info, baseline);
++		di_info_destroy(info);
++		info = parse_extensions(blocks, sizeof(native) + sizeof(positive),
++					short_header, short_size);
++		assert_same(info, baseline);
++		di_info_destroy(info);
++		info = parse_extensions(short_header, short_size,
++					blocks, sizeof(native) + sizeof(positive));
++		assert_same(info, baseline);
++		di_info_destroy(info);
++		di_info_destroy(baseline);
++		short_header[0] = 0x26; /* unrelated partial native tag is not CTA evidence */
++		memcpy(blocks, native, sizeof(native));
++		memcpy(blocks + sizeof(native), short_header, short_size);
++		check(blocks, sizeof(native) + short_size, true);
++		check_extensions(native, sizeof(native), short_header, short_size, true);
++		check_extensions(short_header, short_size, native, sizeof(native), true);
++		short_header[0] = 0x81;
++	}
++	check_extensions(native, sizeof(native), malformed, sizeof(malformed), false);
++	check_extensions(malformed, sizeof(malformed), native, sizeof(native), false);
++	malformed[1] = 8; /* reserved parent flags */
++	check_extensions(native, sizeof(native), malformed, sizeof(malformed), false);
++	malformed[1] = 0;
++	malformed[2] = 255; /* no trustworthy outer boundary */
++	check_extensions(native, sizeof(native), malformed, sizeof(malformed), false);
++	check_extensions(malformed, sizeof(malformed), native, sizeof(native), false);
++	check_extensions(native, sizeof(native), rejected, sizeof(rejected), false);
++	rejected[4] = 5;
++	check_extensions(native, sizeof(native), rejected, sizeof(rejected), false);
++	check_extensions(native, sizeof(native), tail, sizeof(tail), false);
++	check_extensions(native, sizeof(native), empty, sizeof(empty), true);
++	check_extensions(native, sizeof(native), audio, sizeof(audio), true);
++	for (order = 0; order < 2; order++) {
++		baseline = parse_ordinary_nested(order != 0, false, true);
++		info = parse_ordinary_nested(order != 0, true, true);
++		assert_same(info, baseline);
++		assert(di_info_get_hdr_static_metadata(info)->pq);
++		assert(di_info_get_hdr_static_metadata(info)->type1);
++		di_info_destroy(info);
++		di_info_destroy(baseline);
++	}
++	/* Earlier valid Type1/luminance survive a malformed nested tail. */
++	memcpy(blocks, positive, sizeof(positive));
++	blocks[2]++;
++	blocks[sizeof(positive)] = 0xE3;
++	baseline = parse(positive, sizeof(positive));
++	info = parse(blocks, sizeof(positive) + 1);
++	assert_same(info, baseline);
++	memcpy(blocks + sizeof(positive) + 1, native, sizeof(native));
++	di_info_destroy(info);
++	info = parse(blocks, sizeof(positive) + 1 + sizeof(native));
++	assert_same(info, baseline);
++	assert(di_info_get_hdr_static_metadata(info)->type1);
++	assert(di_info_get_hdr_static_metadata(info)->desired_content_max_luminance > 0);
++	di_info_destroy(info);
++	di_info_destroy(baseline);
++	/* An unsupported block doesn't erase a later valid nested authority. */
++	memcpy(blocks, (uint8_t[]){0x81, 1, 0}, 3);
++	memcpy(blocks + 3, positive, sizeof(positive));
++	baseline = parse(positive, sizeof(positive));
++	info = parse(blocks, sizeof(positive) + 3);
++	assert_same(info, baseline);
++	di_info_destroy(info);
++	di_info_destroy(baseline);
++}
++
++int
++main(int argc, char *argv[])
++{
++	uint8_t block[32], two[32], cta[16];
++	FILE *f;
++	size_t pair;
++
++	assert(argc == 3);
++	f = fopen(argv[1], "rb");
++	if (!f)
++		abort();
++	assert(fread(base_edid, 128, 1, f) == 1);
++	fclose(f);
++	print_loaded_library();
++	if (strcmp(argv[2], "baseline") == 0) {
++		check(native, sizeof(native), false);
++		puts("baseline old-header native defaults: PASS");
++		return 0;
++	}
++	check_unusable_cta();
++	check(native, sizeof(native), true);
++	memcpy(block, native, sizeof(native));
++	block[9] = 0x10;
++	check(block, 12, false); /* P3 alone */
++	block[9] = 0x20;
++	check(block, 12, false); /* BT2020 SDR */
++	block[9] = 0x80;
++	check(block, 12, false); /* reserved standard bit */
++	block[9] = 0x40;
++	block[3] = 0;
++	check(block, 12, false); /* RGB absent */
++	block[3] = 0x80;
++	check(block, 12, false); /* reserved depth is not RGB support */
++	block[3] = 4;
++	block[2] = 10;
++	block[11] = 1;
++	block[12] = 0xFF;
++	check(block, 13, true); /* unknown pair doesn't erase known standard */
++	block[9] = 0;
++	check(block, 13, false);
++	block[12] = 0x68;
++	check(block, 13, true); /* additional complete BT2020/PQ tuple */
++	block[2] = 16;
++	block[11] = 7;
++	memset(block + 12, 0x66, 7);
++	block[18] = (TEST_BT2020 << 4) | TEST_ST2084;
++	check(block, 19, true); /* only seventh additional pair proves PQ */
++	block[18] = 0x58;
++	check(block, 19, false);
++	block[2] = 10;
++	block[11] = 1;
++	for (pair = 0; pair < 256; pair++) {
++		block[12] = (uint8_t) pair;
++		check(block, 13, pair == ((TEST_BT2020 << 4) | TEST_ST2084));
++	}
++	block[12] = 0x86;
++	check(block, 13, false); /* reversed nibble values */
++	block[2] = 11;
++	block[11] = 2;
++	block[12] = 0x66;
++	block[13] = 0x58;
++	check(block, 14, false); /* BT2020 SDR plus P3 PQ is not BT2020 PQ */
++	memcpy(two, native, 12);
++	memcpy(two + 12, native, 12);
++	two[3] = 0;
++	two[21] = 0;
++	check(two, 24, false); /* RGB and PQ in different blocks */
++	check_extensions(two, 12, two + 12, 12, false);
++	two[1] = 1;
++	memcpy(two + 12, native, 12);
++	check(two, 24, true); /* invalid first block */
++	check_extensions(two, 12, native, 12, true);
++	memcpy(two, native, 12);
++	two[9] = 0;
++	check(two, 24, true); /* ineligible first valid block */
++	check_extensions(two, 12, native, 12, true);
++	check_authority();
++	check_cta(true, false);
++	check_cta(false, true);
++	check_cta(true, true);
++	cta[0] = 0x81;
++	cta[1] = 0;
++	cta[2] = sizeof(hdr);
++	memcpy(cta + 3, hdr, sizeof(hdr));
++	check_extensions(cta, 7, native, 12, false);
++	check_extensions(native, 12, cta, 7, false);
++	cta[2] = sizeof(color);
++	memcpy(cta + 3, color, sizeof(color));
++	check_extensions(cta, 7, native, 12, false);
++	check_extensions(native, 12, cta, 7, false);
++	puts("old-header native/CTA/malformed regression matrix: PASS");
++	return 0;
++}
