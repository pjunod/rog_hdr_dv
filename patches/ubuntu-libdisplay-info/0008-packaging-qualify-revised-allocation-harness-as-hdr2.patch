From 50197825eb5eef97068159c259405ab44d07f921 Mon Sep 17 00:00:00 2001
From: Paul Junod <donujp@gmail.com>
Date: Wed, 7 Oct 2026 23:35:00 -0400
Subject: [PATCH 08/14] packaging: qualify revised allocation harness as hdr2

---
 debian/README.native-displayid            |  7 +++++++
 debian/changelog                          | 10 ++++++++++
 debian/patches/native-displayid-hdr.patch | 16 +++++++++++-----
 3 files changed, 28 insertions(+), 5 deletions(-)

diff --git a/debian/README.native-displayid b/debian/README.native-displayid
index 838326e..4b9f84a 100644
--- a/debian/README.native-displayid
+++ b/debian/README.native-displayid
@@ -51,3 +51,10 @@ This is an unsigned local test build, not an Ubuntu upload or an upstream
 acceptance claim. Human DCO attestation, normative DisplayID section checking
 and maintainer review of the high-level semantics remain submission gates.
 The private observed panel capture is not included in the source package.
+
+Allocation-failure tests use a private static source copy so linker wrapping
+actually reaches nested allocations. Those test objects and the allocation
+executable disable LTO, preserving optimization and hardening. Whole-program
+analysis cannot observe linker --wrap counter side effects; the O2/LTO build
+elided a required counter reload after cleanup. The installed library and
+old-header ABI consumer retain production LTO. No assertion is weakened.
diff --git a/debian/changelog b/debian/changelog
index a388aa6..676c239 100644
--- a/debian/changelog
+++ b/debian/changelog
@@ -1,3 +1,13 @@
+libdisplay-info (0.3.0-1ubuntu1~hdr2) stonking; urgency=medium
+
+  * Preserve allocation-test linker interposition by disabling LTO only for
+    private test objects and the fault executable. Keep all assertions,
+    optimization/hardening and production library/ABI consumer LTO.
+  * Replace the failed hdr1 qualification candidate; no hdr1 binary package
+    was delivered or installed.
+
+ -- Paul Junod <donujp@gmail.com>  Wed, 07 Oct 2026 23:35:00 -0400
+
 libdisplay-info (0.3.0-1ubuntu1~hdr1) stonking; urgency=medium
 
   * Local detection-only DisplayID2 backport, preserving the 0.3 public ABI.
diff --git a/debian/patches/native-displayid-hdr.patch b/debian/patches/native-displayid-hdr.patch
index 13e059e..afb108f 100644
--- a/debian/patches/native-displayid-hdr.patch
+++ b/debian/patches/native-displayid-hdr.patch
@@ -15,6 +15,9 @@ Description: privately derive native DisplayID RGB BT.2020/PQ for the 0.3 ABI
  valid empty/audio-only CTA do not suppress native support.
  .
  Regression/fault tests use static wrapped objects and unchanged 0.3 APIs.
+ Only the private static test copy and allocation executable disable LTO,
+ retaining optimization/hardening; installed library and ABI consumer keep
+ production LTO. Link-time wrapping otherwise hides counter side effects.
  This local detection build does not enable GNOME HDR: Mutter and i915's
  separate missing-Type1 signaling requirements remain unresolved.
 Author: Simon Ser <contact@emersion.fr>
@@ -2423,7 +2426,7 @@ index 0000000..012495a
 +edid[255] = -sum(edid[128:255]) % 256
 +pathlib.Path(sys.argv[1]).write_bytes(edid)
 diff --git a/test/meson.build b/test/meson.build
-index 8e91643..b65c263 100644
+index 8e91643..5479c9d 100644
 --- a/test/meson.build
 +++ b/test/meson.build
 @@ -10,6 +10,8 @@ di_edid_print = executable(
@@ -2435,7 +2438,7 @@ index 8e91643..b65c263 100644
  	'acer-p1276',
  	'amazon-fire-tv-48',
  	'apple-xdr-dp',
-@@ -85,3 +87,25 @@ if ref_edid_decode.found()
+@@ -85,3 +87,28 @@ if ref_edid_decode.found()
  		env: test_env,
  	)
  endif
@@ -2444,12 +2447,15 @@ index 8e91643..b65c263 100644
 +test('native-hdr-abi', old_header_consumer, args: [files('data/qemu.edid'), 'patched'])
 +
 +# Test-only static objects let --wrap intercept allocations inside the parser.
++# Linker wrapping is invisible to LTO whole-program side-effect analysis.
++# Keep optimized test objects, but preserve the interposition boundary.
++allocation_wrap_c_args = ['-fno-lto']
 +private_test_lib = static_library('displayid2-test-private',
 +	['../cta.c', '../cta-vic-table.c', '../cvt.c', '../displayid.c', '../displayid2.c',
 +	 '../dmt-table.c', '../edid.c', '../gtf.c', '../hdmi-vic-table.c', '../info.c',
 +	 '../log.c', '../memory-stream.c', pnp_id_table],
 +	include_directories: include_directories('../include'), dependencies: math,
-+	install: false)
++	c_args: allocation_wrap_c_args, install: false)
 +private_test_dep = declare_dependency(link_with: private_test_lib,
 +	include_directories: include_directories('../include'), dependencies: math)
 +private_test = executable('displayid2-private', 'displayid2-private.c', dependencies: private_test_dep)
@@ -2458,8 +2464,8 @@ index 8e91643..b65c263 100644
 +test('displayid2-bounds', bounds_test)
 +
 +allocation_test = executable('displayid2-allocation', 'displayid2-allocation.c',
-+	dependencies: private_test_dep,
-+	link_args: ['-Wl,--wrap=calloc', '-Wl,--wrap=free'])
++	dependencies: private_test_dep, c_args: allocation_wrap_c_args,
++	link_args: ['-fno-lto', '-Wl,--wrap=calloc', '-Wl,--wrap=free'])
 +test('displayid2-allocation', allocation_test, args: files('data/qemu.edid'))
 diff --git a/test/old-header-consumer.c b/test/old-header-consumer.c
 new file mode 100644
