diff --git a/test/native-api-consumer.c b/test/native-api-consumer.c
new file mode 100644
index 0000000..44d2a3c
--- /dev/null
+++ b/test/native-api-consumer.c
@@ -0,0 +1,157 @@
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <libdisplay-info/info.h>
+#include <libdisplay-info/edid.h>
+#include <libdisplay-info/displayid2.h>
+
+static uint8_t base[128];
+static const uint8_t native[] = {0x26, 0, 9, 4, 0, 0, 0, 0, 0, 0x40, 0, 0};
+static const uint8_t empty[] = {0x81, 0, 0};
+static const uint8_t audio[] = {0x81, 0, 4, 0x23, 9, 7, 7};
+static const uint8_t tail[] = {0x81, 0, 2, 0x43, 16};
+
+static void
+checksum(uint8_t *data, size_t size)
+{
+	uint8_t sum = 0;
+	size_t i;
+
+	data[size - 1] = 0;
+	for (i = 0; i < size - 1; i++)
+		sum += data[i];
+	data[size - 1] = (uint8_t) (0 - sum);
+}
+
+static void
+extension(uint8_t *data, const uint8_t *blocks, size_t size)
+{
+	assert(size <= 121); /* Keep both section and EDID checksums separate. */
+	data[0] = 0x70;
+	data[1] = 0x20;
+	data[2] = (uint8_t) size;
+	data[3] = 2;
+	memcpy(data + 5, blocks, size);
+	checksum(data + 1, size + 5);
+	checksum(data, 128);
+}
+
+static void
+check(const uint8_t *other, size_t size, bool diagnosed, bool separate, bool reverse)
+{
+	uint8_t edid[384] = {0}, blocks[64];
+	struct di_info *info;
+	const struct di_edid_ext *const *exts;
+	const struct di_displayid2 *displayid2;
+	const struct di_displayid2_data_block *const *db;
+	const struct di_displayid2_interface_features *f;
+	const struct di_cta_data_block *const *children;
+	const struct di_hdr_static_metadata *h;
+	const struct di_supported_signal_colorimetry *c;
+	bool found = false;
+	size_t i, j, k, containers = 0, child_count = 0;
+	size_t edid_size = separate ? 384 : 256;
+
+	assert(size <= sizeof(blocks) - sizeof(native));
+	memcpy(edid, base, 128);
+	edid[126] = separate ? 2 : 1;
+	checksum(edid, 128);
+	if (separate) {
+		extension(edid + (reverse ? 256 : 128), native, sizeof(native));
+		extension(edid + (reverse ? 128 : 256), other, size);
+	} else {
+		if (reverse) {
+			memcpy(blocks, other, size);
+			memcpy(blocks + size, native, sizeof(native));
+		} else {
+			memcpy(blocks, native, sizeof(native));
+			memcpy(blocks + sizeof(native), other, size);
+		}
+		extension(edid + 128, blocks, sizeof(native) + size);
+	}
+	info = di_info_parse_edid(edid, edid_size);
+	assert(info);
+	assert((di_info_get_failure_msg(info) != NULL) == diagnosed);
+	h = di_info_get_hdr_static_metadata(info);
+	c = di_info_get_supported_signal_colorimetry(info);
+	assert(h->traditional_sdr && !h->traditional_hdr &&
+	       !h->pq && !h->hlg && !h->type1);
+	assert(h->desired_content_max_luminance == 0 && h->desired_content_min_luminance == 0);
+	assert(h->desired_content_max_frame_avg_luminance == 0);
+	assert(!c->bt2020_rgb && !c->bt2020_ycc && !c->bt2020_cycc &&
+	       !c->ictcp && !c->st2113_rgb);
+	exts = di_edid_get_extensions(di_info_get_edid(info));
+	for (i = 0; exts[i]; i++) {
+		displayid2 = di_edid_ext_get_displayid2(exts[i]);
+		assert(displayid2);
+		db = di_displayid2_get_data_blocks(displayid2);
+		for (j = 0; db[j]; j++) {
+			f = di_displayid2_data_block_get_interface_features(db[j]);
+			if (!f) {
+				assert(di_displayid2_data_block_get_tag(db[j]) == DI_DISPLAYID2_DATA_BLOCK_CTA861);
+				children = di_displayid2_data_block_get_cta_data_blocks(db[j]);
+				assert(children);
+				containers++;
+				for (k = 0; children[k]; k++)
+					child_count++;
+				continue;
+			}
+			assert(di_displayid2_data_block_get_tag(db[j]) ==
+			       DI_DISPLAYID2_DATA_BLOCK_DISPLAY_INTERFACE_FEATURES);
+			assert(!di_displayid2_data_block_get_cta_data_blocks(db[j]));
+			assert(f->rgb_bit_depths == DI_DISPLAYID2_BIT_DEPTH_444_10);
+			assert(f->standard_combinations == DI_DISPLAYID2_COMBINATION_BT2020_ST2084);
+			assert(f->additional_combinations_len == 0);
+			assert(!f->ycbcr444_bit_depths && !f->ycbcr422_bit_depths && !f->ycbcr420_bit_depths);
+			assert(!f->audio_capabilities && f->ycbcr420_min_pixel_rate == 0);
+			found = true;
+		}
+	}
+	/* Unsupported parents must disappear, not merely carry a diagnostic. */
+	if (size >= 3 && other[1] == 0 && size == (size_t) other[2] + 3) {
+		assert(containers == 1);
+		assert(child_count == (size == sizeof(audio) ? 1u : 0u));
+	} else {
+		assert(containers == 0 && child_count == 0);
+	}
+	/* A truncated same-section prefix can hide later native data. */
+	if (!(diagnosed && !separate && reverse && size < 3))
+		assert(found);
+	di_info_destroy(info);
+}
+
+int
+main(int argc, char **argv)
+{
+	uint8_t data[7];
+	FILE *f;
+	size_t separate, reverse, payload, bad;
+
+	assert(argc == 2);
+	f = fopen(argv[1], "rb");
+	assert(f && fread(base, 128, 1, f) == 1);
+	fclose(f);
+	for (separate = 0; separate < 2; separate++) {
+		for (reverse = 0; reverse < 2; reverse++) {
+			check(empty, sizeof(empty), false, separate != 0, reverse != 0);
+			check(audio, sizeof(audio), false, separate != 0, reverse != 0);
+			check(tail, sizeof(tail), true, separate != 0, reverse != 0);
+			for (payload = 0; payload < 2; payload++) {
+				memcpy(data, payload ? audio : empty,
+				       payload ? sizeof(audio) : sizeof(empty));
+				for (bad = 0; bad < 2; bad++) {
+					data[1] = bad ? 8 : 1;
+					check(data, payload ? sizeof(audio) : sizeof(empty),
+					      true, separate != 0, reverse != 0);
+				}
+			}
+			data[0] = 0x81;
+			data[1] = 0;
+			check(data, 1, true, separate != 0, reverse != 0);
+			check(data, 2, true, separate != 0, reverse != 0);
+		}
+	}
+	puts("additive parsed API, legacy defaults and diagnosed nested parent matrix: PASS");
+	return 0;
+}
