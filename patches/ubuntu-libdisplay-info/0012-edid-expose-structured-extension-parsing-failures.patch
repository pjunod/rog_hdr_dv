index b9f696c..9d566f2 100644
--- a/include/log.h
+++ b/include/log.h
@@ -13,6 +13,7 @@ struct di_logger {
 	FILE *f;
 	const char *section;
 	bool initialized;
+	bool has_failures;
 };
 
