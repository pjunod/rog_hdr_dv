index 3fb7578..5f7f217 100644
--- a/log.c
+++ b/log.c
@@ -3,6 +3,7 @@
 void
 _di_logger_va_add_failure(struct di_logger *logger, const char fmt[], va_list args)
 {
+	logger->has_failures = true;
 	if (!logger->initialized) {
 		if (ftell(logger->f) > 0) {
