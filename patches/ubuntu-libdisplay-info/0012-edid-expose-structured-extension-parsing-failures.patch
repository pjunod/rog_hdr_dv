 log.c                           |   1 +
 test/edid-extension-failures.c  | 198 ++++++++++++++++++++++++++++++++
 test/meson.build                |   4 +
 test/native-api-consumer.c      |   1 +
 9 files changed, 247 insertions(+), 5 deletions(-)
 create mode 100644 test/edid-extension-failures.c

