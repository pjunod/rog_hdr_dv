++ * Check for known extension parsing or framing failures.
++ *
++ * This includes extension diagnostics, discarded or uninterpretable extension
++ * records, invalid extension checksums, and a mismatch between the input size
++ * and encoded block count. Base-block descriptive diagnostics are excluded;
++ * invalid base headers, versions and checksums already prevent parsing.
++ *
++ * A false result does not guarantee full conformance, interpretation of every
++ * opaque field, or readiness for any particular display transport.
++ */
++bool
++di_edid_has_extension_failures(const struct di_edid *edid);
