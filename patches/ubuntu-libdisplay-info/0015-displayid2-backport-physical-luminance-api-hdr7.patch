diff --git a/displayid2.c b/displayid2.c
index 32ec5b3..14b56c6 100644
--- a/displayid2.c
+++ b/displayid2.c
@@ -1,5 +1,6 @@
 #include <errno.h>
 #include <inttypes.h>
+#include <math.h>
 #include <stdlib.h>
 #include <sys/types.h>
 
@@ -135,6 +136,48 @@ parse_interface_features(struct di_displayid2 *displayid2,
 	return true;
 }
 
+static bool
+decode_luminance(const uint8_t data[2], float *value)
+{
+	uint16_t bits = (uint16_t) (data[0] | (data[1] << 8));
+	unsigned int exponent = (bits >> 10) & 0x1F;
+	unsigned int fraction = bits & 0x3FF;
+
+	/* Includes the do-not-use -0 sentinel, all signed values, infinity and NaN. */
+	if ((bits & 0x8000) || exponent == 0x1F)
+		return false;
+
+	if (exponent == 0)
+		*value = ldexpf((float) fraction, -24);
+	else
+		*value = ldexpf((float) (fraction | 0x400), (int) exponent - 25);
+	return true;
+}
+
+static void
+parse_luminance(struct di_displayid2_data_block *block,
+		const uint8_t *data, size_t size)
+{
+	struct di_displayid2_luminance *luminance = &block->luminance;
+
+	/* DisplayID 2.0/2.1 Display Parameters: exactly 29 payload bytes.
+	 * Header bit 7 selects image-size units; bits 6:3 are not understood.
+	 * Feature bits 4:3 must declare minimum-guaranteed physical values.
+	 * Keep unsupported optional data opaque, without new legacy diagnostics.
+	 */
+	if (size != DISPLAYID2_DATA_BLOCK_HEADER_SIZE + 29 ||
+	    (data[1] & 0x7F) > 1 || (data[0x0B] & 0x18))
+		return;
+
+	block->has_luminance_format = true;
+	luminance->has_max_luminance_full =
+		decode_luminance(data + 0x18, &luminance->max_luminance_full);
+	luminance->has_max_luminance_10pct =
+		decode_luminance(data + 0x1A, &luminance->max_luminance_10pct);
+	luminance->has_min_luminance =
+		decode_luminance(data + 0x1C, &luminance->min_luminance);
+}
+
 static ssize_t
 parse_data_block(struct di_displayid2 *displayid2, const uint8_t *data,
 		 size_t size)
@@ -176,8 +219,10 @@ parse_data_block(struct di_displayid2 *displayid2, const uint8_t *data,
 		if (!parse_interface_features(displayid2, data_block, data, data_block_size))
 			goto skip;
 		break;
-	case DI_DISPLAYID2_DATA_BLOCK_PRODUCT_ID:
 	case DI_DISPLAYID2_DATA_BLOCK_DISPLAY_PARAMS:
+		parse_luminance(data_block, data, data_block_size);
+		break;
+	case DI_DISPLAYID2_DATA_BLOCK_PRODUCT_ID:
 	case DI_DISPLAYID2_DATA_BLOCK_TYPE_VII_TIMING:
 	case DI_DISPLAYID2_DATA_BLOCK_TYPE_VIII_TIMING:
 	case DI_DISPLAYID2_DATA_BLOCK_TYPE_IX_TIMING:
@@ -404,3 +449,12 @@ di_displayid2_data_block_get_interface_features(const struct di_displayid2_data_
 		return NULL;
 	return &data_block->interface_features;
 }
+
+const struct di_displayid2_luminance *
+di_displayid2_data_block_get_luminance(const struct di_displayid2_data_block *data_block)
+{
+	if (data_block->tag != DI_DISPLAYID2_DATA_BLOCK_DISPLAY_PARAMS ||
+	    !data_block->has_luminance_format)
+		return NULL;
+	return &data_block->luminance;
+}
