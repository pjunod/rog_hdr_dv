@@ -120,3 +120,7 @@ test('native-api-consumer', native_api_consumer, args: files('data/qemu.edid'))
 extension_failures = executable('edid-extension-failures', 'edid-extension-failures.c',
 	dependencies: di_dep)
 test('edid-extension-failures', extension_failures, args: files('data/qemu.edid'))
+
+luminance = executable('displayid2-luminance', 'displayid2-luminance.c',
+	dependencies: di_dep)
+test('displayid2-luminance', luminance, args: files('data/qemu.edid'))
