diff --git a/displayid2.c b/displayid2.c
index 14b56c6..edecaa9 100644
--- a/displayid2.c
+++ b/displayid2.c
@@ -178,6 +178,54 @@ parse_luminance(struct di_displayid2_data_block *block,
 		decode_luminance(data + 0x1C, &luminance->min_luminance);
 }
 
+static void
+decode_chromaticity(struct di_displayid2_chromaticity_point *point,
+		   const uint8_t data[3], bool cie1976)
+{
+	int32_t denominator;
+
+	point->a = (uint16_t) (data[0] | ((data[1] & 0x0F) << 8));
+	point->b = (uint16_t) ((data[1] >> 4) | (data[2] << 4));
+	if (!cie1976) {
+		point->valid = point->b > 0 && point->a + point->b <= 4096;
+		return;
+	}
+
+	/* xy = (9u', 4v') / (6u' - 16v' + 12). Keep domain checks
+	 * integral, including exact x+y=1 boundaries. */
+	denominator = 6 * point->a - 16 * point->b + 12 * 4096;
+	point->valid = denominator > 0 && point->b > 0 &&
+		9 * point->a + 4 * point->b <= denominator;
+}
+
+static void
+parse_native_chromaticities(struct di_displayid2_data_block *block,
+			    const uint8_t *data, size_t size)
+{
+	struct di_displayid2_native_chromaticities *chromaticities =
+		&block->native_chromaticities;
+	bool cie1976;
+	size_t i;
+
+	/* Format corroborated by edid-decode at 1316a80455ef70889bea89491f37cd69170f3ee7
+	 * and NVIDIA's parser at 61dcc93722ecb418bb5f2e00923f05b4b8051dd1.
+	 * Complete independent VESA-standard verification remains open. Feature
+	 * bit 5 is not understood; keep that boundary local and without new
+	 * legacy diagnostics. Luminance class is independent of chromaticity. */
+	if (size != DISPLAYID2_DATA_BLOCK_HEADER_SIZE + 29 ||
+	    (data[1] & 0x7F) > 1 || (data[0x0B] & 0x20))
+		return;
+
+	block->has_native_chromaticities_format = true;
+	cie1976 = (data[0x0B] & 0x40) != 0;
+	chromaticities->revision = data[1] & 7;
+	chromaticities->coordinates = cie1976 ? DI_DISPLAYID2_CHROMATICITY_CIE1976 :
+		DI_DISPLAYID2_CHROMATICITY_CIE1931;
+	for (i = 0; i < 3; i++)
+		decode_chromaticity(&chromaticities->primaries[i], data + 0x0C + 3 * i, cie1976);
+	decode_chromaticity(&chromaticities->white_point, data + 0x15, cie1976);
+}
+
 static ssize_t
 parse_data_block(struct di_displayid2 *displayid2, const uint8_t *data,
 		 size_t size)
@@ -221,6 +269,7 @@ parse_data_block(struct di_displayid2 *displayid2, const uint8_t *data,
 		break;
 	case DI_DISPLAYID2_DATA_BLOCK_DISPLAY_PARAMS:
 		parse_luminance(data_block, data, data_block_size);
+		parse_native_chromaticities(data_block, data, data_block_size);
 		break;
 	case DI_DISPLAYID2_DATA_BLOCK_PRODUCT_ID:
 	case DI_DISPLAYID2_DATA_BLOCK_TYPE_VII_TIMING:
@@ -458,3 +507,12 @@ di_displayid2_data_block_get_luminance(const struct di_displayid2_data_block *da
 		return NULL;
 	return &data_block->luminance;
 }
+
+const struct di_displayid2_native_chromaticities *
+di_displayid2_data_block_get_native_chromaticities(const struct di_displayid2_data_block *data_block)
+{
+	if (data_block->tag != DI_DISPLAYID2_DATA_BLOCK_DISPLAY_PARAMS ||
+	    !data_block->has_native_chromaticities_format)
+		return NULL;
+	return &data_block->native_chromaticities;
+}
