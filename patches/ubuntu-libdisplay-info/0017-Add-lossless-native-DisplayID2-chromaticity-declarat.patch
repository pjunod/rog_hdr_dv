diff --git a/debian/changelog b/debian/changelog
index 49c7078..bac28b4 100644
--- a/debian/changelog
+++ b/debian/changelog
@@ -1,3 +1,14 @@
+libdisplay-info (0.3.0-1ubuntu1~hdr8) UNRELEASED; urgency=medium
+
+  * Add an independent raw native DisplayID2 chromaticity getter without
+    changing existing public structures or default-signal primaries.
+  * Preserve exact counts and coordinate-system provenance; per-point validity
+    describes mathematical usability, never presence or optical calibration.
+  * Add synthetic parser/format coverage. Full VESA standard verification and
+    installed-package qualification remain open.
+
+ -- Codex <codex@invalid>  Fri, 09 Oct 2026 00:00:00 +0000
+
 libdisplay-info (0.3.0-1ubuntu1~hdr7) UNRELEASED; urgency=medium
 
   * Add a low-level optional DisplayID2 minimum-guaranteed physical luminance
diff --git a/debian/libdisplay-info3.symbols b/debian/libdisplay-info3.symbols
index 570c6fc..b723766 100644
--- a/debian/libdisplay-info3.symbols
+++ b/debian/libdisplay-info3.symbols
@@ -30,6 +30,7 @@ libdisplay-info.so.3 libdisplay-info3 #MINVER#
  di_displayid2_data_block_get_cta_data_blocks@Base 0.3.0-1ubuntu1~hdr4~
  di_displayid2_data_block_get_interface_features@Base 0.3.0-1ubuntu1~hdr4~
