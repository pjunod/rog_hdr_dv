From f76a69d6e443faf99debec2833da96cde74b330d Mon Sep 17 00:00:00 2001
From: ROG HDR contributors <rog-hdr@invalid>
Date: Sun, 8 Nov 2026 03:04:12 +0000
Subject: [PATCH 4/5] debian: verify the generated public C API during package
 assembly

---
 debian/changelog | 7 +++++++
 debian/rules     | 1 +
 2 files changed, 8 insertions(+)

diff --git a/debian/changelog b/debian/changelog
index 7827287..577f0c4 100644
--- a/debian/changelog
+++ b/debian/changelog
@@ -1,3 +1,10 @@
+rust-dolby-vision (3.3.2-3+rogdv1) stonking; urgency=medium
+
+  * Backport upstream C FFI handling, error returns and pivot bounds.
+  * Verify that the generated development header exposes usable declarations.
+
+ -- ROG HDR contributors <rog-hdr@invalid>  Sun, 08 Nov 2026 03:00:00 +0000
+
 rust-dolby-vision (3.3.2-3) unstable; urgency=medium
 
   * Team upload.
diff --git a/debian/rules b/debian/rules
index 8d92a1d..0ec921a 100755
--- a/debian/rules
+++ b/debian/rules
@@ -36,3 +36,4 @@ override_dh_auto_install:
 
 execute_after_dh_install:
 	find debian -name Cargo.lock -delete
+	printf '%s\n' '#include <libdovi/rpu_parser.h>' 'void check_dovi_header(void) { (void)dovi_parse_unspec62_nalu; (void)dovi_rpu_free; }' | $(CC) -x c -Werror -fsyntax-only -I debian/libdovi-dev/usr/include -

