@@ -1609,6 +1614,27 @@ static bool pass_read_image(struct pass_state *pass)
 
     // Original ref texture, even after preprocessing
     pl_tex ref_tex = ref->plane.texture;
+    // Reconstruct the full visible master before display management. Its native
+    // extent is independent of the user's crop and of allocated texture padding.
+    pl_rect2df read_crop = image->crop;
+    enum pl_lut_type source_lut = guess_frame_lut_type(image, false);
+    bool full_dovi_master = params->dovi_map && image->dovi_rpu &&
+        image->dovi_rpu_size && !image->icc &&
+        source_lut != PL_LUT_NATIVE && source_lut != PL_LUT_CONVERSION &&
+        !params->deband_params &&
+        !(image->field != PL_FIELD_NONE && params->deinterlace_params) &&
+        image->dovi_master_width > 0 && image->dovi_master_height > 0 &&
