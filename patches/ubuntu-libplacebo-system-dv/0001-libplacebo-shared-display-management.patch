+        image->dovi_master_height <= ref_tex->params.h;
+    for (int i = 0; i < params->num_hooks; i++)
+        full_dovi_master &= !(params->hooks[i]->stages & (PL_HOOK_RGB - 1));
+    if (full_dovi_master) {
+        read_crop = (pl_rect2df) {
+            .x1 = image->dovi_master_width,
+            .y1 = image->dovi_master_height,
+        };
+    }
+
 
     // Merge all compatible planes into 'combined' shaders
     for (int i = 0; i < image->num_planes; i++) {
@@ -1735,10 +1761,10 @@ static bool pass_read_image(struct pass_state *pass)
               sy = st->plane.shift_y;
 
         st->img.rect = (pl_rect2df) {
-            .x0 = (image->crop.x0 - sx) * rrx,
-            .y0 = (image->crop.y0 - sy) * rry,
-            .x1 = (image->crop.x1 - sx) * rrx,
-            .y1 = (image->crop.y1 - sy) * rry,
+            .x0 = (read_crop.x0 - sx) * rrx,
+            .y0 = (read_crop.y0 - sy) * rry,
+            .x1 = (read_crop.x1 - sx) * rrx,
+            .y1 = (read_crop.y1 - sy) * rry,
         };
 
         st->plane_w = ref_tex->params.w * rrx;
@@ -1930,12 +1956,82 @@ static bool pass_read_image(struct pass_state *pass)
         }
     }
 
+    bool map_dovi = params->dovi_map && image->dovi_rpu && image->dovi_rpu_size;
+    // This first integration only maps a complete native master. Cropping before
+    // the provider would change its whole-frame analysis and spatial filter.
+    bool complete_master = full_dovi_master;
+    bool source_override = !complete_master || !needs_conversion ||
+        lut_type == PL_LUT_NATIVE || image->icc || params->deband_params ||
+        (image->field != PL_FIELD_NONE && params->deinterlace_params);
+    for (int i = 0; i < params->num_hooks; i++)
+        source_override |= (params->hooks[i]->stages & (PL_HOOK_RGB - 1)) != 0;
+    bool supported_master = pass->img.color.primaries == PL_COLOR_PRIM_BT_2020 &&
+                            pass->img.color.transfer == PL_COLOR_TRC_PQ &&
+                            pass->img.comps == 3;
+    if (map_dovi && (source_override || !supported_master)) {
+        if (!rr->dovi_override_warned) {
+            PL_WARN(rr, "Shared Dolby display management unavailable for modified "
+                        "cropped or unsupported master; using ordinary rendering");
+            rr->dovi_override_warned = true;
+        }
+        map_dovi = false;
+    }
+
     if (needs_conversion) {
         if (pass->img.repr.sys == PL_COLOR_SYSTEM_XYZ) {
             pl_shader_linearize(sh, &pass->img.color);
             pass->img.color.transfer = PL_COLOR_TRC_LINEAR;
         }
+        pl_shader_decode_color(sh, &pass->img.repr,
+                               map_dovi ? NULL : params->color_adjustment);
+    }
+
+    if (map_dovi) {
+        pl_tex master = img_tex(pass, &pass->img);
+        pl_tex mapped = NULL;
+        struct pl_color_space mapped_color = {0};
+        if (!master) {
+            pass->dovi_fatal = true;
+            return false;
+        }
+        int mapped_status = params->dovi_map(params->dovi_priv, rr->gpu,
+                image->dovi_rpu, image->dovi_rpu_size, &pass->target.color,
+                master, &mapped, &mapped_color);
+        if (mapped_status < 0 || (mapped_status > 0 && (!mapped ||
+            mapped->params.w != master->params.w ||
+            mapped->params.h != master->params.h || !mapped->params.sampleable ||
+            mapped_color.primaries != PL_COLOR_PRIM_BT_2020 ||
+            mapped_color.transfer != PL_COLOR_TRC_PQ))) {
+            PL_ERR(rr, "Dolby display management failed");
+            pass->dovi_fatal = true;
+            return false;
+        }
+        // Consume the provider-owned texture immediately into a renderer FBO.
+        // This keeps mixer-cache entries independent of provider scratch reuse.
+        if (mapped_status > 0) {
+            pass->dovi_mapped = true;
+            pass->img.tex = mapped;
+            pass->img.color = mapped_color;
+            pass->image.color = mapped_color;
+        }
+        sh = img_sh(pass, &pass->img);
+        if (!img_tex(pass, &pass->img)) {
+            pass->dovi_fatal = true;
+            return false;
+        }
+        sh = img_sh(pass, &pass->img);
+        // User grading belongs after display management, never in the master
+        // texture used for analysis and the deployed mapping arithmetic.
         pl_shader_decode_color(sh, &pass->img.repr, params->color_adjustment);
+    } else if (params->dovi_reset) {
