--- a/src/include/libplacebo/renderer.h
+++ b/src/include/libplacebo/renderer.h
@@ -357,6 +357,20 @@ struct pl_render_params {
     void (*info_callback)(void *priv, const struct pl_render_info *info);
     void *info_priv;
 
+    // Optional display-management provider. Input is reconstructed full-range
+    // RGB BT.2020/PQ before scaling. The provider owns its returned texture until
+    // the next call; output color describes the actual mapped signal. A failure
+    // fails the render rather than silently presenting unprocessed Dolby Vision.
+    // Return 1 when mapped, 0 for inapplicable targets (ordinary rendering),
+    // or -1 on eligible-input processing failure.
+    int (*dovi_map)(void *priv, pl_gpu gpu, const uint8_t *rpu, size_t rpu_size,
+                     const struct pl_color_space *target, pl_tex master,
+                     pl_tex *mapped, struct pl_color_space *mapped_color);
+    void (*dovi_reset)(void *priv);
+    void *dovi_priv;
+    // Change when provider configuration or output target policy changes.
+    uint64_t dovi_signature;
+
     // --- Deprecated/removed fields
     PL_DEPRECATED_IN(v6.254) bool allow_delayed_peak_detect; // moved to pl_peak_detect_params
     PL_DEPRECATED_IN(v6.327) const struct pl_icc_params *icc_params; // use pl_frame.icc
@@ -642,6 +656,14 @@ struct pl_frame {
     // un-applying grain makes little sense.
     struct pl_film_grain_data film_grain;
 
+    // Original per-frame Dolby Vision RPU, including all target trims. Caller
+    // retains immutable backing storage through the entire render/mix lifetime.
+    // An absent RPU means absent metadata; never inherit another frame's RPU.
+    const uint8_t *dovi_rpu;
+    size_t dovi_rpu_size;
+    // Native visible master size, independent of crop/zoom and texture padding.
+    int dovi_master_width, dovi_master_height;
+
     // Ignored by libplacebo. May be useful for users.
     void *user_data;
 };
diff --git a/src/include/libplacebo/utils/libav_internal.h b/src/include/libplacebo/utils/libav_internal.h
index 13a21d2..dd8275b 100644
--- a/src/include/libplacebo/utils/libav_internal.h
+++ b/src/include/libplacebo/utils/libav_internal.h
@@ -1286,6 +1286,11 @@ PL_LIBAV_API bool pl_map_avframe_ex(pl_gpu gpu, struct pl_frame *out,
     pl_frame_from_avframe(out, frame);
     priv->avframe = av_frame_clone(frame);
     out->user_data = priv;
+    if (!priv->avframe) {
+        free(priv);
+        out->user_data = NULL;
+        goto error;
+    }
 
 #ifdef PL_HAVE_LAV_DOLBY_VISION
     if (params->map_dovi) {
@@ -1298,6 +1303,16 @@ PL_LIBAV_API bool pl_map_avframe_ex(pl_gpu gpu, struct pl_frame *out,
                 pl_map_avdovi_metadata(&out->color, &out->repr, &priv->dovi, metadata);
         }
 
+        // Borrow from the retained clone, whose AVBufferRef keeps the original
+        // bytes alive even when the decoder reuses or frees its input AVFrame.
+        sd = av_frame_get_side_data(priv->avframe, AV_FRAME_DATA_DOVI_RPU_BUFFER);
+        if (sd && out->repr.sys == PL_COLOR_SYSTEM_DOLBYVISION) {
+            out->dovi_rpu = sd->data;
+            out->dovi_rpu_size = sd->size;
+            out->dovi_master_width = frame->width;
+            out->dovi_master_height = frame->height;
+        }
+
 #ifdef PL_HAVE_LIBDOVI
         sd = av_frame_get_side_data(frame, AV_FRAME_DATA_DOVI_RPU_BUFFER);
         if (sd)
