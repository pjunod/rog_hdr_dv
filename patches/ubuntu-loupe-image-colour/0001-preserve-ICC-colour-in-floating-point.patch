+/// Convert a validated frame row by row. Commit a new layout only after a
+/// successful transform; an invalid profile leaves the original pixels intact.
+pub fn apply_transformation(
+    profile: &[u8],
+    frame: &mut Frame,
+    pixels: &[u8],
+) -> Result<(ImgBuf, ColorState), Error> {
+    let input = frame.memory_format;
+    let output = match (input.channel_type(), input.has_alpha()) {
+        (ChannelType::U8, false) => MemoryFormat::R16g16b16Float,
+        (ChannelType::U8, true) => MemoryFormat::R16g16b16a16Float,
+        (_, false) => MemoryFormat::R32g32b32Float,
+        (_, true) => MemoryFormat::R32g32b32a32Float,
     };
-
