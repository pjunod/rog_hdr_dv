+        .ok_or(Error::TextureTooLarge)?;
+    let bytes = u64::from(stride) * u64::from(frame.height);
+    if bytes > crate::dbus::MAX_TEXTURE_SIZE {
+        return Err(Error::TextureTooLarge);
+    }
+    let len = usize::try_from(bytes).map_err(|_| Error::TextureTooLarge)?;
+    let mut converted = Vec::new();
+    converted
+        .try_reserve_exact(len)
+        .map_err(|_| Error::TextureTooLarge)?;
+    converted.resize(len, 0);
+    let source_width = frame.width as usize * input.n_bytes().usize();
+    for (src, dst) in pixels
+        .chunks(frame.stride as usize)
+        .zip(converted.chunks_exact_mut(stride as usize))
