+/// Produce canonical, unassociated GrayA/RGBA f32 pixels. A zero-alpha
+/// pixel has no defined colour and is represented as transparent black.
+fn unassociate_row(format: MemoryFormat, source: &[u8], output: &mut Vec<u8>) {
+    output.clear();
+    let (order, alpha): (&[usize], usize) = match format {
+        MemoryFormat::B8g8r8a8Premultiplied => (&[2, 1, 0], 3),
+        MemoryFormat::A8r8g8b8Premultiplied => (&[1, 2, 3], 0),
+        MemoryFormat::G8a8Premultiplied | MemoryFormat::G16a16Premultiplied => (&[0], 1),
+        _ => (&[0, 1, 2], 3),
+    };
+    for pixel in source.chunks_exact(format.n_bytes().usize()) {
+        let component = |index: usize| match format.channel_type() {
+            ChannelType::U8 => pixel[index] as f32 / 255.0,
+            ChannelType::U16 => {
+                f32::from(u16::from_ne_bytes(
+                    pixel[index * 2..index * 2 + 2].try_into().unwrap(),
+                )) / 65535.0
+            }
+            ChannelType::F32 => {
+                f32::from_ne_bytes(pixel[index * 4..index * 4 + 4].try_into().unwrap())
+            }
+            _ => unreachable!("premultiplied formats only support U8/U16/F32"),
+        };
+        let a = component(alpha);
+        for &index in order {
+            let value = if a == 0.0 { 0.0 } else { component(index) / a };
+            output.extend_from_slice(&value.to_ne_bytes());
+        }
+        output.extend_from_slice(&a.to_ne_bytes());
+    }
+}
