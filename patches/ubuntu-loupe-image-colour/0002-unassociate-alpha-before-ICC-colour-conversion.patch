+    // Little CMS does not provide every integer-premultiplied formatter.
+    // Normalize and unassociate these rows explicitly before colour conversion.
+    let associated = lcms_pixel_format(input).premultiplied();
+    let source_format = if associated {
+        if input.n_channels() == 2 {
+            // Little CMS EXTRA_SH(1): one alpha sample after grayscale.
+            lcms2::PixelFormat(lcms2::PixelFormat::GRAY_FLT.0 | (1 << 7))
+        } else {
+            lcms2::PixelFormat::RGBA_FLT
+        }
+    } else {
+        lcms_pixel_format(input)
+    };
     let transform = lcms2::Transform::<u8, u8>::new_flags(
