From 9b90c65c8df97fdb763c544b6df50f613dedb435 Mon Sep 17 00:00:00 2001
From: ROG HDR contributors <rog-hdr@invalid>
Date: Sun, 8 Nov 2026 00:06:00 +0000
Subject: [PATCH] Omit unknown optional content light levels from Wayland
 descriptions

---
 debian/changelog           |  7 ++++
 video/out/wayland_common.c | 74 ++++++++++++++++++++++++++------------
 2 files changed, 59 insertions(+), 22 deletions(-)

diff --git a/debian/changelog b/debian/changelog
index 6a314a4..a89284f 100644
--- a/debian/changelog
+++ b/debian/changelog
@@ -1,3 +1,10 @@
+mpv (0.41.0-2ubuntu5+rogdv2) stonking; urgency=medium
+
+  * Omit unknown or invalid optional Wayland content-light metadata requests.
+  * Validate quantized unsigned mastering luminance and content-light bounds.
+
+ -- Local HDR integration <operator@localhost>  Sat, 07 Nov 2026 20:00:00 +0000
+
 mpv (0.41.0-2ubuntu5+rogdv1) stonking; urgency=medium
 
   * Integrate the isolated shared Dolby display-management provider in gpu-next.
diff --git a/video/out/wayland_common.c b/video/out/wayland_common.c
index b5b889b..fdfeabd 100644
--- a/video/out/wayland_common.c
+++ b/video/out/wayland_common.c
@@ -17,6 +17,8 @@
 
 #include <errno.h>
 #include <limits.h>
+#include <math.h>
+#include <stdint.h>
 #include <linux/input-event-codes.h>
 #include <poll.h>
 #include <time.h>
@@ -3283,28 +3285,49 @@ static int handle_round(int scale, int n)
     return (scale * n + WAYLAND_SCALE_FACTOR / 2) / WAYLAND_SCALE_FACTOR;
 }
 
-static bool hdr_metadata_valid(struct vo_wayland_state *wl, struct pl_hdr_metadata *hdr)
+struct wayland_hdr_metadata {
+    uint32_t min_luma, max_luma, max_cll, max_fall;
+    bool has_cll, has_fall;
+};
+
+static bool encode_luminance(double value, double scale, bool positive,
+                             uint32_t *encoded)
 {
-    // Always return a hard failure if this condition fails.
-    if (hdr->min_luma >= hdr->max_luma)
+    if (!isfinite(value) || value < 0.0)
         return false;
+    double rounded = nearbyint(value * scale);
+    if (!isfinite(rounded) || rounded < 0.0 || rounded > UINT32_MAX ||
+        (positive && rounded == 0.0))
+        return false;
+    *encoded = (uint32_t) rounded;
+    return true;
+}
 
-    // If max_cll or max_fall are invalid, set them to zero.
-    if (wp_color_manager_v1_get_version(wl->color_manager) == 1) {
-      if (hdr->max_cll &&
-         (hdr->max_cll <= hdr->min_luma || hdr->max_cll > hdr->max_luma))
-        hdr->max_cll = 0;
-
-      if (hdr->max_fall &&
-         (hdr->max_fall <= hdr->min_luma || hdr->max_fall > hdr->max_luma))
-        hdr->max_fall = 0;
-    }
-
-    if (hdr->max_cll && hdr->max_fall && hdr->max_fall > hdr->max_cll) {
-        hdr->max_cll = 0;
-        hdr->max_fall = 0;
-    }
+static bool hdr_metadata_valid(struct vo_wayland_state *wl,
+                               const struct pl_hdr_metadata *hdr,
+                               struct wayland_hdr_metadata *out)
+{
+    *out = (struct wayland_hdr_metadata) {0};
+    // Validate the actual unsigned protocol arguments, including quantization.
+    // Minimum luminance has 1/10000 cd/m2 units; maximum has whole cd/m2.
+    if (!encode_luminance(hdr->min_luma, WAYLAND_MIN_LUM_FACTOR, false,
+                          &out->min_luma) ||
+        !encode_luminance(hdr->max_luma, 1.0, true, &out->max_luma) ||
+        (uint64_t) out->min_luma >=
+            (uint64_t) out->max_luma * WAYLAND_MIN_LUM_FACTOR)
+        return false;
 
+    out->has_cll = encode_luminance(hdr->max_cll, 1.0, true, &out->max_cll);
+    out->has_fall = encode_luminance(hdr->max_fall, 1.0, true, &out->max_fall);
+    if (wp_color_manager_v1_get_version(wl->color_manager) == 1) {
+        out->has_cll &= (uint64_t) out->max_cll * WAYLAND_MIN_LUM_FACTOR >
+                           out->min_luma && out->max_cll <= out->max_luma;
+        out->has_fall &= (uint64_t) out->max_fall * WAYLAND_MIN_LUM_FACTOR >
+                            out->min_luma && out->max_fall <= out->max_luma;
+    }
+    // Omit only the inconsistent optional average; keep a valid content peak.
+    if (out->has_cll && out->has_fall && out->max_fall > out->max_cll)
+        out->has_fall = false;
     return true;
 }
 
@@ -3530,7 +3553,8 @@ static void set_color_management(struct vo_wayland_state *wl)
 
     struct pl_hdr_metadata hdr = wl->target_params.color.hdr;
     bool is_hdr = pl_color_transfer_is_hdr(color.transfer);
-    bool use_metadata = hdr_metadata_valid(wl, &hdr);
+    struct wayland_hdr_metadata encoded;
+    bool use_metadata = hdr_metadata_valid(wl, &hdr, &encoded);
     if (!use_metadata)
         MP_VERBOSE(wl, "supplied HDR metadata does not conform to the wayland color management protocol. It will not be used.\n");
     if (is_hdr && use_metadata) {
@@ -3555,11 +3579,17 @@ static void set_color_management(struct vo_wayland_state *wl)
 
             MP_VERBOSE(wl, "min_luma: %f, max_luma: %f\n", hdr.min_luma, hdr.max_luma);
             wp_image_description_creator_params_v1_set_mastering_luminance(image_creator_params,
-                lrintf(hdr.min_luma * WAYLAND_MIN_LUM_FACTOR), lrintf(hdr.max_luma));
+                encoded.min_luma, encoded.max_luma);
         }
         MP_VERBOSE(wl, "max_cll: %f, max_fall: %f\n", hdr.max_cll, hdr.max_fall);
-        wp_image_description_creator_params_v1_set_max_cll(image_creator_params, lrintf(hdr.max_cll));
-        wp_image_description_creator_params_v1_set_max_fall(image_creator_params, lrintf(hdr.max_fall));
+        // Undefined/invalid content-light metadata is represented by omitting
+        // its request, never by transmitting an invented zero luminance.
+        if (encoded.has_cll)
+            wp_image_description_creator_params_v1_set_max_cll(image_creator_params,
+                                                               encoded.max_cll);
+        if (encoded.has_fall)
+            wp_image_description_creator_params_v1_set_max_fall(image_creator_params,
+                                                                encoded.max_fall);
     }
     struct wp_image_description_v1 *image_description = wp_image_description_creator_params_v1_create(image_creator_params);
     wp_image_description_v1_add_listener(image_description, &image_description_listener, wl);
