+/* Part of mpv; licensed under LGPL-2.1-or-later, like its native caller. */
+#ifndef MPV_DOVI_PHYSICAL_H
+#define MPV_DOVI_PHYSICAL_H
+#include <math.h>
+#include <stdbool.h>
+#include <libplacebo/colorspace.h>
+
+/* Inverse of Mutter add_luminance_mapping_op for a PQ surface whose protocol
+ * defaults are primary maximum 10000 and reference white 203. This is a
+ * multiplicative encoding transport, not the creative display-management
+ * target. Encoding minimum is deliberately not subtracted from physical black.
+ */
+static inline bool mp_dovi_transport_gain(float reference, float encoding_max,
+                                          float physical_min, float physical_max,
+                                          float *gain)
+{
+    if (!isfinite(reference) || reference <= 0 || !isfinite(encoding_max) ||
+        encoding_max <= 0 || !isfinite(physical_min) || physical_min < 0 ||
+        !isfinite(physical_max) || physical_max <= physical_min)
+        return false;
+    double g = ((double)PL_COLOR_SDR_WHITE / reference) * (encoding_max / 10000.0);
+    double peak = physical_max * g, black = physical_min * g;
+    if (!isfinite(g) || g <= 0 || !isfinite(peak) || peak > 10000 ||
+        !isfinite(black) || (physical_min > 0 && (float)black <= 0))
+        return false;
+    *gain = g;
+    return isfinite(*gain) && *gain > 0;
+}
+#endif
