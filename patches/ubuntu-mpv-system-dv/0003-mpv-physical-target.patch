+static uint64_t dovi_render_signature(struct priv *p)
+{
+    return p->dovi_physical_active
+        ? DV_PROVIDER_ABI ^ ((p->dovi_render_generation + 1) * UINT64_C(0x9e3779b97f4a7c15))
+        : DV_PROVIDER_ABI;
+}
+
+static void update_dovi_physical_target(struct priv *p, struct vo *vo,
+                                         const struct mp_image *image)
+{
+    bool active = false;
+    uint64_t generation = 0;
+#if HAVE_WAYLAND
+    const struct gl_video_opts *opts = p->opts_cache->opts;
+    struct vo_wayland_physical_target raw;
+    bool raw_rpu = false;
+    if (image) {
+        for (int i = 0; i < image->num_ff_side_data; i++)
+            raw_rpu |= image->ff_side_data[i].type == AV_FRAME_DATA_DOVI_RPU_BUFFER;
+    }
+    // Only automatic physical Wayland/PQ display treatment. Explicit exports,
+    // source passthrough, ICC and SDR retain their original path and metadata.
+    if (image && raw_rpu && image->params.repr.sys == PL_COLOR_SYSTEM_DOLBYVISION &&
+        !strcmp(p->ra_ctx->fns->name, "waylandvk") &&
+        p->next_opts->target_hint != 0 && p->next_opts->target_hint_mode == 0 &&
+        !opts->target_prim && !opts->target_trc && !opts->target_peak &&
+        !opts->target_gamut && !opts->target_contrast && !opts->hdr_reference_white &&
+        !p->icc_profile && !p->next_opts->target_lut.path &&
+        vo_wayland_get_physical_target(vo, &raw) &&
+        raw.display.transfer == PL_COLOR_TRC_PQ &&
+        raw.display.primaries == PL_COLOR_PRIM_BT_2020 &&
+        raw.display.hdr.max_luma >= raw.reference_luma &&
+        mp_dovi_transport_gain(raw.reference_luma, raw.encoding_max,
+                               raw.display.hdr.min_luma, raw.display.hdr.max_luma,
+                               &p->dovi_transport_gain)) {
+        active = true;
+        generation = raw.generation;
+        p->dovi_physical_target = raw.display;
+        p->dovi_reference = raw.reference_luma;
+        p->dovi_encoding_min = raw.encoding_min;
+        p->dovi_encoding_max = raw.encoding_max;
+    }
+#endif
+    if (active != p->dovi_physical_active ||
+        (active && generation != p->dovi_physical_generation)) {
+        pl_renderer_flush_cache(p->rr);
+        dv_provider_reset(p->dovi_provider);
+        p->dovi_render_generation++;
+        p->dovi_display_signal_valid = p->dovi_physical_logged = false;
+    }
+    p->dovi_physical_active = active;
+    p->dovi_physical_generation = generation;
+}
+
+static void dovi_reset(void *priv)
+{
+    struct priv *p = priv;
+    dv_provider_reset(p->dovi_provider);
+}
+
+static int dovi_map(void *priv, pl_gpu gpu, const uint8_t *rpu, size_t size,
+                     const struct pl_color_space *target, pl_tex master,
+                     pl_tex *mapped, struct pl_color_space *mapped_color)
+{
+    struct priv *p = priv;
+    p->dovi_map_calls++;
+    if (!p->dovi_physical_active || target->transfer != PL_COLOR_TRC_PQ ||
+        target->primaries != PL_COLOR_PRIM_BT_2020) {
+        return dv_provider_map(p->dovi_provider, gpu, rpu, size, target,
+                               master, mapped, mapped_color);
+    }
+
+    // Keep the legacy signal envelope for unsupported/fallback frames. Only
+    // successful private display management receives the physical declaration.
+    struct pl_color_space physical = p->dovi_physical_target;
+    int status = dv_provider_map(p->dovi_provider, gpu, rpu, size, &physical,
+                                 master, mapped, mapped_color);
+    if (status <= 0)
+        return status;
+
+    if (!mapped || !*mapped || gpu != p->gpu)
+        return -1;
+    if (p->dovi_transport_gain != 1.0f) {
+        pl_fmt fmt = pl_find_fmt(gpu, PL_FMT_FLOAT, 4, 32, 0,
+                                 PL_FMT_CAP_RENDERABLE | PL_FMT_CAP_SAMPLEABLE | PL_FMT_CAP_HOST_READABLE);
+        if (!fmt || !pl_tex_recreate(gpu, &p->dovi_transport, pl_tex_params(
+                .w = (*mapped)->params.w, .h = (*mapped)->params.h, .format = fmt,
+                .sampleable = true, .renderable = true, .host_readable = true,
+                .storable = fmt->caps & PL_FMT_CAP_STORABLE)))
+            return -1;
+        pl_shader sh = pl_dispatch_begin(p->dovi_dispatch);
+        if (!pl_shader_sample_direct(sh, pl_sample_src(.tex = *mapped))) {
+            pl_dispatch_abort(p->dovi_dispatch, &sh);
+            return -1;
+        }
+        const struct pl_color_space pq = {
+            .primaries = PL_COLOR_PRIM_BT_2020, .transfer = PL_COLOR_TRC_PQ,
+        };
+        pl_shader_linearize(sh, &pq);
+        struct pl_shader_var gain = {
+            .var = pl_var_float("dv_physical_transport_gain"),
+            .data = &p->dovi_transport_gain, .dynamic = true,
+        };
+        if (!pl_shader_custom(sh, &(struct pl_custom_shader) {
+                .description = "physical DV to Wayland PQ reference transport",
+                .body = "color.rgb *= dv_physical_transport_gain;",
+                .input = PL_SHADER_SIG_COLOR, .output = PL_SHADER_SIG_COLOR,
+                .variables = &gain, .num_variables = 1})) {
+            pl_dispatch_abort(p->dovi_dispatch, &sh);
+            return -1;
+        }
+        pl_shader_delinearize(sh, &pq);
+        if (!pl_dispatch_finish(p->dovi_dispatch, pl_dispatch_params(
+                .shader = &sh, .target = p->dovi_transport)))
+            return -1;
+
+        *mapped = p->dovi_transport;
+    }
+    // Static encoding conversion must see the unchanged signal envelope, so it
+    // cannot perform a second black/peak remapping. Physical fit and the one
+    // reference transport already happened above.
+    *mapped_color = *target;
+    if (!p->dovi_physical_logged) {
+        MP_INFO(p, "automatic DV physical target %.9g..%.9g nits; encoding %.9g..%.9g; "
+                "reference %.9g; PQ transport gain %.9g -> signal %.9g..%.9g; generation %llu\n",
+                physical.hdr.min_luma, physical.hdr.max_luma,
+                p->dovi_encoding_min, p->dovi_encoding_max, p->dovi_reference,
+                p->dovi_transport_gain, physical.hdr.min_luma * p->dovi_transport_gain,
+                physical.hdr.max_luma * p->dovi_transport_gain,
+                (unsigned long long)p->dovi_render_generation);
+        p->dovi_physical_logged = true;
+    }
+    return 1;
+}
