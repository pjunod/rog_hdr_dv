diff --git a/src/backends/edid-parse.c b/src/backends/edid-parse.c
index 121bba7..6c2be44 100644
--- a/src/backends/edid-parse.c
+++ b/src/backends/edid-parse.c
@@ -31,10 +31,88 @@
 
 #include <libdisplay-info/cta.h>
 #include <libdisplay-info/edid.h>
+#include <libdisplay-info/displayid2.h>
 #include <libdisplay-info/info.h>
 
 #include "backends/edid.h"
 
+static gboolean
+has_cta_color_metadata (const struct di_cta_data_block *const *blocks)
+{
+  if (!blocks)
+    return FALSE;
+
+  for (; *blocks; blocks++)
+    {
+      enum di_cta_data_block_tag tag = di_cta_data_block_get_tag (*blocks);
+
+      if (tag == DI_CTA_DATA_BLOCK_HDR_STATIC_METADATA ||
+          tag == DI_CTA_DATA_BLOCK_COLORIMETRY)
+        return TRUE;
+    }
+
+  return FALSE;
+}
+
+static gboolean
+has_native_rgb_bt2020_pq (const struct di_info *info)
+{
+  const struct di_edid_ext *const *extensions;
+  gboolean supported = FALSE;
+  const char *failure_msg = di_info_get_failure_msg (info);
+
+  /* An uninterpretable block may contain authoritative CTA metadata. */
+  if (failure_msg && *failure_msg)
+    return FALSE;
+
+  extensions = di_edid_get_extensions (di_info_get_edid (info));
+  for (; *extensions; extensions++)
+    {
+      const struct di_edid_cta *cta = di_edid_ext_get_cta (*extensions);
+      const struct di_displayid2 *displayid;
+      const struct di_displayid2_data_block *const *blocks;
+
+      if (cta && has_cta_color_metadata (di_edid_cta_get_data_blocks (cta)))
+        return FALSE;
+
+      displayid = di_edid_ext_get_displayid2 (*extensions);
+      if (!displayid)
+        continue;
+
+      blocks = di_displayid2_get_data_blocks (displayid);
+      for (; *blocks; blocks++)
+        {
+          const struct di_displayid2_interface_features *features;
+          const struct di_cta_data_block *const *children;
+          unsigned int i;
+
+          children = di_displayid2_data_block_get_cta_data_blocks (*blocks);
+          if (has_cta_color_metadata (children))
+            return FALSE;
+
+          features = di_displayid2_data_block_get_interface_features (*blocks);
+          if (!features || !features->rgb_bit_depths)
+            continue;
+
+          if (features->standard_combinations &
+              DI_DISPLAYID2_COMBINATION_BT2020_ST2084)
+            supported = TRUE;
+
+          for (i = 0; i < features->additional_combinations_len; i++)
+            {
+              const struct di_displayid2_color_eotf *combination =
+                &features->additional_combinations[i];
+
+              if (combination->color_space == DI_DISPLAYID2_COLOR_SPACE_BT2020 &&
+                  combination->eotf == DI_DISPLAYID2_EOTF_ST2084)
+                supported = TRUE;
+            }
+        }
+    }
+
+  return supported;
+}
+
 MetaEdidInfo *
 meta_edid_info_new_parse (const uint8_t *edid,
                           size_t         size)
@@ -116,6 +194,8 @@ meta_edid_info_new_parse (const uint8_t *edid,
           hdr_static_metadata,
           sizeof (*hdr_static_metadata));
 
+  info->native_rgb_bt2020_pq = has_native_rgb_bt2020_pq (di_info);
+
   di_info_destroy (di_info);
   return g_steal_pointer (&info);
 }
