From 9aa3fbe392242b5ae591e0044a77998959fd37ea Mon Sep 17 00:00:00 2001
From: Paul Junod <donujp@gmail.com>
Date: Thu, 8 Oct 2026 01:42:16 -0400
Subject: [PATCH 2/5] backends/native: scope native capability veto to
 extension failures

The actual ROG EDID has unrelated base timing/range diagnostics, so the
initial global diagnostic veto rejects its valid native RGB/PQ tuple.
Use the additive structured extension-failure query instead. Every malformed
or dropped extension and envelope ambiguity still vetoes native fallback;
base descriptive warnings remain visible without altering CTA precedence.

Require the new query in the compile/link API probe. Extend actual
EDID-to-KMS tests with base-warning positives, dropped/unknown/checksum
extension negatives, all envelope mismatches and unchanged fatal base
rejection. The private raw ROG/PQ-cleared gate follows source review.
---
 meson.build                  |   3 +-
 src/backends/edid-parse.c    |   5 +-
 src/tests/native-hdr-tests.c | 227 +++++++++++++++++++++++++++++++++--
 3 files changed, 220 insertions(+), 15 deletions(-)

diff --git a/meson.build b/meson.build
index 7015624..84bd95e 100644
--- a/meson.build
+++ b/meson.build
@@ -149,7 +149,8 @@ if not cc.links('''
       di_displayid2_data_block_get_interface_features (*blocks);
     const struct di_cta_data_block *const *children =
       di_displayid2_data_block_get_cta_data_blocks (*blocks);
-    return di_displayid2_data_block_get_tag (*blocks) +
+    return di_edid_has_extension_failures (0) +
+      di_displayid2_data_block_get_tag (*blocks) +
       features->rgb_bit_depths + features->standard_combinations +
       features->additional_combinations_len +
       features->additional_combinations[0].color_space +
diff --git a/src/backends/edid-parse.c b/src/backends/edid-parse.c
index 6c2be44..d653d31 100644
--- a/src/backends/edid-parse.c
+++ b/src/backends/edid-parse.c
@@ -59,10 +59,9 @@ has_native_rgb_bt2020_pq (const struct di_info *info)
 {
   const struct di_edid_ext *const *extensions;
   gboolean supported = FALSE;
-  const char *failure_msg = di_info_get_failure_msg (info);
 
-  /* An uninterpretable block may contain authoritative CTA metadata. */
-  if (failure_msg && *failure_msg)
+  /* Failed extension parsing may hide authoritative CTA metadata. */
+  if (di_edid_has_extension_failures (di_info_get_edid (info)))
     return FALSE;
 
   extensions = di_edid_get_extensions (di_info_get_edid (info));
diff --git a/src/tests/native-hdr-tests.c b/src/tests/native-hdr-tests.c
index 7eed3f8..097e3f0 100644
--- a/src/tests/native-hdr-tests.c
+++ b/src/tests/native-hdr-tests.c
@@ -52,19 +52,17 @@ extension (uint8_t       *data,
   checksum (data, 128);
 }
 
-static MetaOutputInfo *
-parse_extensions (const uint8_t *first,
-                  size_t         first_size,
-                  const uint8_t *second,
-                  size_t         second_size,
-                  gboolean       first_cta,
-                  gboolean       second_cta)
+static size_t
+make_edid (uint8_t       *edid,
+           const uint8_t *first,
+           size_t         first_size,
+           const uint8_t *second,
+           size_t         second_size,
+           gboolean       first_cta,
+           gboolean       second_cta)
 {
-  uint8_t edid[384] = { 0 };
   const uint8_t header[] = { 0, 255, 255, 255, 255, 255, 255, 0 };
   const uint8_t version[] = { 1, 36, 1, 4, 0xa5, 0, 0, 120, 2 };
-  g_autoptr (GBytes) bytes = NULL;
-  MetaOutputInfo *info = meta_output_info_new ();
   unsigned int i;
 
   memcpy (edid, header, sizeof (header));
@@ -80,12 +78,37 @@ parse_extensions (const uint8_t *first,
   extension (edid + 128, first, first_size, first_cta);
   if (second)
     extension (edid + 256, second, second_size, second_cta);
-  bytes = g_bytes_new (edid, second ? 384 : 256);
+  return second ? 384 : 256;
+}
+
+static MetaOutputInfo *
+parse_bytes (const uint8_t *edid,
+             size_t         size)
+{
+  g_autoptr (GBytes) bytes = g_bytes_new (edid, size);
+  MetaOutputInfo *info = meta_output_info_new ();
+
   meta_output_info_parse_edid (info, bytes);
   g_assert_nonnull (info->edid_info);
   return info;
 }
 
+static MetaOutputInfo *
+parse_extensions (const uint8_t *first,
+                  size_t         first_size,
+                  const uint8_t *second,
+                  size_t         second_size,
+                  gboolean       first_cta,
+                  gboolean       second_cta)
+{
+  uint8_t edid[384] = { 0 };
+  size_t size;
+
+  size = make_edid (edid, first, first_size, second, second_size,
+                    first_cta, second_cta);
+  return parse_bytes (edid, size);
+}
+
 static MetaOutputInfo *
 parse (const uint8_t *first,
        size_t         first_size,
@@ -279,6 +302,184 @@ test_diagnostics (void)
           }
 }
 
+static void
+test_extension_failures (void)
+{
+  const uint8_t empty[] = { 0x81, 0, 0 };
+  unsigned int reverse, failure;
+
+  for (reverse = 0; reverse < 2; reverse++)
+    for (failure = 0; failure < 15; failure++)
+      {
+        uint8_t edid[257 * 128 + 1] = { 0 };
+        uint8_t *other = edid + (reverse ? 128 : 256);
+        size_t size = make_edid (edid, reverse ? empty : native,
+                                reverse ? sizeof (empty) : sizeof (native),
+                                reverse ? native : empty,
+                                reverse ? sizeof (native) : sizeof (empty),
+                                FALSE, FALSE);
+        g_autoptr (MetaOutputInfo) info = NULL;
+
+        switch (failure)
+          {
+          case 0: /* Unrelated base range diagnostics remain visible and safe. */
+            memset (edid + 54, 0, 18);
+            edid[57] = 0xfd;
+            edid[59] = 40;
+            edid[60] = 60;
+            edid[61] = 30;
+            edid[62] = 90;
+            edid[63] = 100;
+            checksum (edid, 128);
+            break;
+          case 1: /* Unsupported DisplayID major, silently dropped previously. */
+            other[1] = 0x30;
+            checksum (other + 1, other[2] + 5);
+            checksum (other, 128);
+            break;
+          case 2: /* Unsupported ordinary CTA envelope, dropped without text. */
+            other[0] = 2;
+            other[1] = 3;
+            other[2] = 2;
+            checksum (other, 128);
+            break;
+          case 3:
+            other[0] = 0xee;
+            checksum (other, 128);
+            break;
+          case 4:
+            other[127] ^= 1;
+            break;
+          case 5:
+            size--;
+            break;
+          case 6:
+            size++;
+            break;
+          case 7:
+            edid[126] = 1;
+            checksum (edid, 128);
+            break;
+          case 8:
+            edid[126] = 3;
+            checksum (edid, 128);
+            break;
+          case 9:
+            {
+              unsigned int i;
+
+              edid[126] = 255;
+              checksum (edid, 128);
+              for (i = 3; i < 257; i++)
+                {
+                  edid[128 * i] = 0xf0;
+                  checksum (edid + 128 * i, 128);
+                }
+              size = 257 * 128;
+            }
+            break;
+          case 10:
+            memset (other, 0, 128);
+            other[0] = 2;
+            other[1] = 3;
+            other[2] = 6;
+            other[4] = 0xe2;
+            other[5] = 6;
+            checksum (other, 128);
+            break;
+          case 11:
+            other[3] = 0xff;
+            checksum (other + 1, other[2] + 5);
+            checksum (other, 128);
+            break;
+          case 12:
+            other[5] = 0x99;
+            checksum (other + 1, other[2] + 5);
+            checksum (other, 128);
+            break;
+          case 13:
+            other[other[2] + 5] ^= 1;
+            checksum (other, 128);
+            break;
+          case 14: /* An opaque known non-CTA extension keeps prior behavior. */
+            memset (other, 0, 128);
+            other[0] = 0xf0;
+            checksum (other, 128);
+            break;
+          }
+        info = parse_bytes (edid, size);
+        g_assert_cmpint (info->edid_info->native_rgb_bt2020_pq, ==, failure == 0 || failure == 14);
+        check_kms (info, failure == 0 || failure == 14, FALSE, FALSE);
+      }
+}
+
+static void
+test_cta_with_extension_failure (void)
+{
+  const uint8_t children[] = { 0xe6, 6, 5, 1, 100, 80, 2, 0xe3, 5, 0x80, 0 };
+  const uint8_t unsupported[] = { 0x81, 1, 0 };
+  uint8_t nested[sizeof (children) + 3] = { 0x81, 0, sizeof (children) };
+  unsigned int ordinary, reverse, dropped;
+
+  memcpy (nested + 3, children, sizeof (children));
+  for (ordinary = 0; ordinary < 2; ordinary++)
+    for (reverse = 0; reverse < 2; reverse++)
+      for (dropped = 0; dropped < 2; dropped++)
+        {
+          uint8_t edid[512] = { 0 };
+          const uint8_t *cta = ordinary ? children : nested;
+          size_t cta_size = ordinary ? sizeof (children) : sizeof (nested);
+          g_autoptr (MetaOutputInfo) info = NULL;
+
+          make_edid (edid, reverse ? cta : native,
+                     reverse ? cta_size : sizeof (native),
+                     reverse ? native : cta,
+                     reverse ? sizeof (native) : cta_size,
+                     ordinary && reverse, ordinary && !reverse);
+          extension (edid + 384, unsupported, sizeof (unsupported), FALSE);
+          if (dropped)
+            {
+              edid[385] = 0x30;
+              checksum (edid + 385, edid[386] + 5);
+              checksum (edid + 384, 128);
+            }
+          edid[126] = 3;
+          checksum (edid, 128);
+          info = parse_bytes (edid, sizeof (edid));
+          g_assert_false (info->edid_info->native_rgb_bt2020_pq);
+          g_assert_true (info->edid_info->hdr_static_metadata.type1);
+          g_assert_true (info->edid_info->hdr_static_metadata.pq);
+          g_assert_true (info->edid_info->colorimetry.bt2020_rgb);
+          g_assert_cmpfloat (
+            info->edid_info->hdr_static_metadata.desired_content_max_luminance,
+            >, 0);
+          check_kms (info, FALSE, TRUE, TRUE);
+        }
+}
+
+static void
+test_fatal_base (void)
+{
+  unsigned int failure;
+
+  for (failure = 0; failure < 3; failure++)
+    {
+      uint8_t edid[256] = { 0 };
+      size_t size = make_edid (edid, native, sizeof (native), NULL, 0,
+                              FALSE, FALSE);
+      g_autoptr (GBytes) bytes = NULL;
+      g_autoptr (MetaOutputInfo) info = meta_output_info_new ();
+
+      edid[failure == 0 ? 0 : failure == 1 ? 18 : 127] ^= 1;
+      if (failure != 2)
+        checksum (edid, 128);
+      bytes = g_bytes_new (edid, size);
+      meta_output_info_parse_edid (info, bytes);
+      g_assert_null (info->edid_info);
+      check_kms (info, FALSE, FALSE, FALSE);
+    }
+}
+
 int
 main (int argc, char **argv)
 {
@@ -286,5 +487,9 @@ main (int argc, char **argv)
   g_test_add_func ("/native-hdr/complete-tuple-and-kms-gates", test_native);
   g_test_add_func ("/native-hdr/cta-authority", test_cta_authority);
   g_test_add_func ("/native-hdr/diagnostics", test_diagnostics);
+  g_test_add_func ("/native-hdr/scoped-extension-failures", test_extension_failures);
+  g_test_add_func ("/native-hdr/fatal-base", test_fatal_base);
+  g_test_add_func ("/native-hdr/cta-preserved-with-extension-failure",
+                   test_cta_with_extension_failure);
   return g_test_run ();
 }
