diff --git a/src/backends/edid-parse.c b/src/backends/edid-parse.c
index 6780412..07e0713 100644
--- a/src/backends/edid-parse.c
+++ b/src/backends/edid-parse.c
@@ -112,6 +112,97 @@ has_native_rgb_bt2020_pq (const struct di_info *info)
   return supported;
 }
 
+static gboolean
+luminance_equal (const struct di_displayid2_luminance *a,
+                 const struct di_displayid2_luminance *b)
+{
+  return a->has_min_luminance == b->has_min_luminance &&
+         a->has_max_luminance_full == b->has_max_luminance_full &&
+         a->has_max_luminance_10pct == b->has_max_luminance_10pct &&
+         (!a->has_min_luminance || a->min_luminance == b->min_luminance) &&
+         (!a->has_max_luminance_full || a->max_luminance_full == b->max_luminance_full) &&
+         (!a->has_max_luminance_10pct || a->max_luminance_10pct == b->max_luminance_10pct);
+}
+
+static gboolean
+luminance_valid (const struct di_displayid2_luminance *lum)
+{
+  if ((lum->has_min_luminance &&
+       (!isfinite (lum->min_luminance) || lum->min_luminance < 0 ||
+        (double) lum->min_luminance * 10000 > G_MAXUINT32)) ||
+      (lum->has_max_luminance_full &&
+       (!isfinite (lum->max_luminance_full) || lum->max_luminance_full < 0 ||
+        (double) lum->max_luminance_full > G_MAXUINT32)) ||
+      (lum->has_max_luminance_10pct &&
+       (!isfinite (lum->max_luminance_10pct) || lum->max_luminance_10pct < 1 ||
+        (double) lum->max_luminance_10pct > G_MAXUINT32)))
+    return FALSE;
+
+  return !(lum->has_min_luminance && lum->has_max_luminance_10pct &&
+           lum->min_luminance > lum->max_luminance_10pct) &&
+         !(lum->has_min_luminance && lum->has_max_luminance_full &&
+           lum->min_luminance > lum->max_luminance_full) &&
+         !(lum->has_max_luminance_full && lum->has_max_luminance_10pct &&
+           lum->max_luminance_full > lum->max_luminance_10pct);
+}
+
+static void
+read_native_luminance (MetaEdidInfo         *info,
+                       const struct di_info *di_info)
+{
+  const struct di_edid_ext *const *extensions;
+  gboolean found = FALSE;
+
+  if (di_edid_has_extension_failures (di_info_get_edid (di_info)))
+    {
+      info->native_luminance_status = META_NATIVE_LUMINANCE_INVALID;
+      return;
+    }
+
+  extensions = di_edid_get_extensions (di_info_get_edid (di_info));
+  for (; *extensions; extensions++)
+    {
+      const struct di_displayid2 *displayid = di_edid_ext_get_displayid2 (*extensions);
+      const struct di_displayid2_data_block *const *blocks;
+
+      if (!displayid)
+        continue;
+
+      blocks = di_displayid2_get_data_blocks (displayid);
+      for (; *blocks; blocks++)
+        {
+          const struct di_displayid2_luminance *lum;
+
+          if (di_displayid2_data_block_get_tag (*blocks) !=
+              DI_DISPLAYID2_DATA_BLOCK_DISPLAY_PARAMS)
+            continue;
+
+          lum = di_displayid2_data_block_get_luminance (*blocks);
+          if (!lum || !luminance_valid (lum))
+            {
+              info->native_luminance_status = META_NATIVE_LUMINANCE_INVALID;
+              memset (&info->native_luminance, 0, sizeof (info->native_luminance));
+              return;
+            }
+
+          if (found && !luminance_equal (&info->native_luminance, lum))
+            {
+              info->native_luminance_status = META_NATIVE_LUMINANCE_CONFLICT;
+              memset (&info->native_luminance, 0, sizeof (info->native_luminance));
+              return;
+            }
+
+          info->native_luminance = *lum;
+          found = TRUE;
+        }
+    }
+
+  if (found && (info->native_luminance.has_min_luminance ||
+                info->native_luminance.has_max_luminance_full ||
+                info->native_luminance.has_max_luminance_10pct))
+    info->native_luminance_status = META_NATIVE_LUMINANCE_FIRMWARE_DECLARED;
+}
+
 MetaEdidInfo *
 meta_edid_info_new_parse (const uint8_t *edid,
                           size_t         size)
@@ -194,6 +285,7 @@ meta_edid_info_new_parse (const uint8_t *edid,
           sizeof (*hdr_static_metadata));
 
   info->native_rgb_bt2020_pq = has_native_rgb_bt2020_pq (di_info);
+  read_native_luminance (info, di_info);
 
   di_info_destroy (di_info);
   return g_steal_pointer (&info);
