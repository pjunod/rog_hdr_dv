+static guint
+description_record_hash (gconstpointer data)
+{
+  const MetaWaylandDescriptionRecord *record = data;
+
+  return g_direct_hash (record->color_state) ^
+         record->target_minimum ^ record->target_maximum;
+}
+
+static gboolean
+description_record_equal (gconstpointer a,
+                          gconstpointer b)
+{
+  const MetaWaylandDescriptionRecord *ra = a;
+  const MetaWaylandDescriptionRecord *rb = b;
+
+  return ra->color_state == rb->color_state &&
+         ra->target_minimum == rb->target_minimum &&
+         ra->target_maximum == rb->target_maximum;
+}
+
+static MetaWaylandDescriptionIds *
+description_ids_ref (MetaWaylandDescriptionIds *ids)
+{
+  g_ref_count_inc (&ids->ref_count);
+  return ids;
+}
+
+static void
+description_ids_unref (MetaWaylandDescriptionIds *ids)
+{
+  if (!g_ref_count_dec (&ids->ref_count))
+    return;
+
+  g_assert (g_hash_table_size (ids->records) == 0);
+  g_hash_table_unref (ids->records);
+  g_queue_free (ids->to_reuse);
+  g_free (ids);
+}
+
+static MetaWaylandDescriptionRecord *
+description_record_ref (MetaWaylandDescriptionRecord *record)
+{
+  g_ref_count_inc (&record->ref_count);
+  return record;
+}
+
+static void
+description_record_unref (MetaWaylandDescriptionRecord *record)
+{
+  if (!g_ref_count_dec (&record->ref_count))
+    return;
+
+  g_hash_table_remove (record->ids->records, record);
+  g_queue_push_tail (record->ids->to_reuse, GUINT_TO_POINTER (record->identity));
+  g_clear_object (&record->color_state);
+  description_ids_unref (record->ids);
+  g_free (record);
+}
+
+G_DEFINE_AUTOPTR_CLEANUP_FUNC (MetaWaylandDescriptionRecord,
+                               description_record_unref)
+
+static MetaWaylandDescriptionRecord *
+description_record_get (MetaWaylandColorManager       *color_manager,
+                        ClutterColorState             *color_state,
+                        const MetaColorTargetLuminance *target)
+{
+  const ClutterLuminance *encoding = clutter_color_state_get_luminance (color_state);
+  MetaWaylandDescriptionRecord lookup = {
+    .color_state = color_state,
+    .target_minimum = (uint32_t) MIN ((double) (target ? target->minimum : encoding->min) * 10000,
+                                     G_MAXUINT32),
+    .target_maximum = (uint32_t) (target ? target->maximum : encoding->max),
+  };
+  MetaWaylandDescriptionRecord *record;
+  MetaWaylandDescriptionIds *ids = color_manager->ids;
+
+  record = g_hash_table_lookup (ids->records, &lookup);
+  if (record)
+    return description_record_ref (record);
+
+  record = g_new0 (MetaWaylandDescriptionRecord, 1);
+  g_ref_count_init (&record->ref_count);
+  record->ids = description_ids_ref (ids);
+  record->color_state = g_object_ref (color_state);
+  record->target_minimum = lookup.target_minimum;
+  record->target_maximum = lookup.target_maximum;
+  if (!g_queue_is_empty (ids->to_reuse))
+    record->identity = GPOINTER_TO_UINT (g_queue_pop_head (ids->to_reuse));
+  else
+    {
+      g_assert (ids->next_id < G_MAXUINT32);
+      record->identity = ++ids->next_id;
+    }
+  g_assert (ids->next_id64 < G_MAXUINT64);
+  record->identity64 = ++ids->next_id64;
+  g_hash_table_insert (ids->records, record, record);
+  return record;
+}
+
+static gboolean
+update_output_record (MetaWaylandColorManagementOutput *cm_output)
+{
+  MetaWaylandColorManager *color_manager = cm_output->color_manager;
+  MetaMonitor *monitor = meta_wayland_output_get_monitor (cm_output->output);
+  MetaColorDevice *device =
+    meta_color_manager_get_color_device (get_meta_color_manager (color_manager), monitor);
+  const MetaColorTargetLuminance *target =
+    device ? meta_color_device_get_target_luminance (device) : NULL;
+  g_autoptr (MetaWaylandDescriptionRecord) record = NULL;
+
+  record = description_record_get (color_manager,
+                                    get_output_color_state (color_manager, monitor),
+                                    target);
+  if (cm_output->record &&
+      clutter_color_state_equals (cm_output->record->color_state, record->color_state) &&
+      cm_output->record->target_minimum == record->target_minimum &&
+      cm_output->record->target_maximum == record->target_maximum)
+    return FALSE;
+
+  g_clear_pointer (&cm_output->record, description_record_unref);
+  cm_output->record = g_steal_pointer (&record);
+  return TRUE;
+}
+
+static MetaWaylandDescriptionRecord *
+get_output_record (MetaWaylandColorManager *color_manager,
+                    MetaMonitor             *monitor)
+{
+  MetaWaylandOutput *output =
+    g_hash_table_lookup (color_manager->compositor->outputs, meta_monitor_get_spec (monitor));
+  MetaWaylandColorManagementOutput *cm_output;
+
+  if (!output)
+    return color_manager->default_record;
+
+  cm_output = ensure_color_management_output (color_manager, output);
+  update_output_record (cm_output);
+  return cm_output->record;
+}
