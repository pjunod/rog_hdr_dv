 static void
@@ -742,6 +752,94 @@ get_color_metadata_from_monitor (MetaMonitor        *monitor,
   g_assert_not_reached ();
 }
 
+void
+meta_color_target_luminance_init (MetaColorTargetLuminance *target,
+                                  const MetaEdidInfo       *edid_info,
+                                  gboolean                  native_hdr,
+                                  const ClutterLuminance   *encoding)
+{
+  *target = (MetaColorTargetLuminance) {
+    .minimum = encoding->min,
+    .maximum = encoding->max,
+  };
+
+  if (!native_hdr || !edid_info ||
+      edid_info->native_luminance_status != META_NATIVE_LUMINANCE_FIRMWARE_DECLARED)
+    return;
+
+  target->physical = edid_info->native_luminance;
+  if (target->physical.has_min_luminance)
+    {
+      target->minimum = target->physical.min_luminance;
+      target->minimum_source = META_COLOR_TARGET_FIRMWARE_DECLARED;
+    }
+  if (target->physical.has_max_luminance_10pct)
+    {
+      target->maximum = target->physical.max_luminance_10pct;
+      target->maximum_source = META_COLOR_TARGET_FIRMWARE_DECLARED;
+    }
+
+  /* A partial declaration must also agree with the explicit fallback. */
+  if (!isfinite (target->minimum) || !isfinite (target->maximum) ||
+      target->minimum < 0 || target->maximum < 1 ||
+      target->minimum > target->maximum ||
+      (double) target->minimum * 10000 > G_MAXUINT32 ||
+      (double) target->maximum > G_MAXUINT32)
+    {
+      target->minimum = encoding->min;
+      target->maximum = encoding->max;
+      target->minimum_source = META_COLOR_TARGET_ENCODING_FALLBACK;
+      target->maximum_source = META_COLOR_TARGET_ENCODING_FALLBACK;
+    }
+}
+
+static gboolean
+target_luminance_equal (const MetaColorTargetLuminance *a,
+                        const MetaColorTargetLuminance *b)
+{
+  const struct di_displayid2_luminance *pa = &a->physical;
+  const struct di_displayid2_luminance *pb = &b->physical;
+
+  return a->minimum == b->minimum && a->maximum == b->maximum &&
+         a->minimum_source == b->minimum_source &&
+         a->maximum_source == b->maximum_source &&
+         pa->has_min_luminance == pb->has_min_luminance &&
+         pa->has_max_luminance_full == pb->has_max_luminance_full &&
+         pa->has_max_luminance_10pct == pb->has_max_luminance_10pct &&
+         (!pa->has_min_luminance || pa->min_luminance == pb->min_luminance) &&
+         (!pa->has_max_luminance_full || pa->max_luminance_full == pb->max_luminance_full) &&
+         (!pa->has_max_luminance_10pct || pa->max_luminance_10pct == pb->max_luminance_10pct);
+}
+
+static UpdateResult
+update_target_luminance (MetaColorDevice *color_device)
+{
+  MetaMonitor *monitor = color_device->monitor;
+  MetaOutput *output = meta_monitor_get_main_output (monitor);
+  const MetaOutputInfo *info = meta_output_get_info (output);
+  MetaBackend *backend = meta_color_manager_get_backend (color_device->color_manager);
+  MetaDebugControl *debug_control =
+    meta_context_get_debug_control (meta_backend_get_context (backend));
+  const ClutterLuminance *encoding =
+    clutter_color_state_params_get_luminance (CLUTTER_COLOR_STATE_PARAMS (color_device->color_state));
+  MetaColorTargetLuminance target;
+  gboolean native_hdr;
+
+  native_hdr = meta_monitor_is_active (monitor) &&
+               meta_monitor_get_color_mode (monitor) == META_COLOR_MODE_BT2100 &&
+               !meta_debug_control_is_hdr_forced (debug_control) &&
+               info->connector_type == META_CONNECTOR_TYPE_eDP &&
+               info->edid_info && info->edid_info->native_rgb_bt2020_pq &&
+               (info->supported_hdr_eotfs & (1 << META_OUTPUT_HDR_METADATA_EOTF_PQ)) &&
+               (info->supported_color_spaces & (1 << META_OUTPUT_COLORSPACE_BT2020));
+  meta_color_target_luminance_init (&target, info->edid_info, native_hdr, encoding);
+  if (target_luminance_equal (&color_device->target_luminance, &target))
+    return 0;
+
+  color_device->target_luminance = target;
+  return UPDATE_RESULT_TARGET_VOLUME;
+}
+
 static UpdateResult
 update_color_state (MetaColorDevice *color_device)
 {
@@ -802,6 +900,7 @@ meta_color_device_new (MetaColorManager *color_manager,
   color_device->reference_luminance_factor = 1.0;
 
   update_color_state (color_device);
+  update_target_luminance (color_device);
 
   if (meta_monitor_is_virtual (monitor))
     {
@@ -1464,6 +1563,12 @@ meta_color_device_get_color_state (MetaColorDevice *color_device)
   return color_device->color_state;
 }
 
+const MetaColorTargetLuminance *
+meta_color_device_get_target_luminance (MetaColorDevice *color_device)
+{
+  return &color_device->target_luminance;
+}
+
 MetaColorProfile *
 meta_color_device_get_device_profile (MetaColorDevice *color_device)
 {
@@ -1590,17 +1695,20 @@ do_update (MetaColorDevice *color_device)
   MetaMonitor *monitor = color_device->monitor;
   UpdateResult result = 0;
 
-  if (!meta_monitor_is_active (monitor))
-    return;
-
-  result |= update_white_point (color_device);
-  result |= update_color_state (color_device);
+  if (meta_monitor_is_active (monitor))
+    {
+      result |= update_white_point (color_device);
+      result |= update_color_state (color_device);
+    }
+  result |= update_target_luminance (color_device);
 
   if (result & UPDATE_RESULT_CALIBRATION)
     g_signal_emit (color_device, signals[CALIBRATION_CHANGED], 0);
 
   if (result & UPDATE_RESULT_COLOR_STATE)
     g_signal_emit (color_device, signals[COLOR_STATE_CHANGED], 0);
+  if (result & UPDATE_RESULT_TARGET_VOLUME)
+    g_signal_emit (color_device, signals[TARGET_VOLUME_CHANGED], 0);
 }
 
