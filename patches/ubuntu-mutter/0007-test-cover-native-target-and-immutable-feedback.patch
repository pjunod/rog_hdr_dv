 #include "core/window-private.h"
 #include "meta-test/meta-context-test.h"
 #include "tests/meta-test-utils.h"
@@ -164,6 +171,132 @@ color_management (void)
   meta_wayland_test_client_finish (wayland_test_client);
 }
 
+static void
+count_color_signal (MetaColorDevice *device,
+                     unsigned int    *count)
+{
+  (*count)++;
+}
+
+static void
+set_test_color_mode (MetaOutput    *output,
+                     MetaColorMode  mode)
+{
+  g_autoptr (MetaCrtc) crtc = g_object_ref (meta_output_get_assigned_crtc (output));
+  MetaOutputAssignment assignment = {
+    .output = output,
+    .is_primary = meta_output_is_primary (output),
+    .color_mode = mode,
+  };
+
+  meta_output_assign_crtc (output, crtc, &assignment);
+}
+
+static void
+target_luminance (gconstpointer data)
+{
+  int version = GPOINTER_TO_INT (data);
+  g_autoptr (MetaVirtualMonitor) other = meta_create_test_monitor (test_context, 320, 240, 60);
+  MetaBackend *backend = meta_context_get_backend (test_context);
+  MetaColorManager *manager = meta_backend_get_color_manager (backend);
+  MetaOutput *output = meta_virtual_monitor_get_output (virtual_monitor);
+  MetaOutputInfo *info = (MetaOutputInfo *) meta_output_get_info (output);
+  MetaColorDevice *device = meta_color_manager_get_color_device (manager, meta_output_get_monitor (output));
+  MetaDebugControl *debug = meta_context_get_debug_control (test_context);
+  MetaWaylandTestClient *client;
+  g_autoptr (ClutterColorState) encoding = NULL;
+  unsigned int color_changes = 0, target_changes = 0;
+  gulong color_handler, target_handler;
+
+  info->connector_type = META_CONNECTOR_TYPE_eDP;
+  info->supported_hdr_eotfs = 1 << META_OUTPUT_HDR_METADATA_EOTF_PQ;
+  info->supported_color_spaces = 1 << META_OUTPUT_COLORSPACE_BT2020;
+  g_clear_pointer (&info->edid_info, meta_edid_info_free);
+  info->edid_info = g_new0 (MetaEdidInfo, 1);
+  info->edid_info->native_rgb_bt2020_pq = TRUE;
+  info->edid_info->native_luminance_status = META_NATIVE_LUMINANCE_FIRMWARE_DECLARED;
+  info->edid_info->native_luminance = (struct di_displayid2_luminance) {
+    .has_min_luminance = TRUE,
+    .has_max_luminance_full = TRUE,
+    .has_max_luminance_10pct = TRUE,
+    .min_luminance = 1049.0f / 2097152.0f,
+    .max_luminance_full = 400,
+    .max_luminance_10pct = 616,
+  };
+  set_test_color_mode (output, META_COLOR_MODE_BT2100);
+  meta_color_device_update (device);
+  encoding = g_object_ref (meta_color_device_get_color_state (device));
+  g_assert_cmpfloat (meta_color_device_get_target_luminance (device)->maximum, ==, 616);
+  color_handler = g_signal_connect (device, "color-state-changed", G_CALLBACK (count_color_signal), &color_changes);
+  target_handler = g_signal_connect (device, "target-volume-changed", G_CALLBACK (count_color_signal), &target_changes);
+
+  meta_wayland_test_driver_set_property (test_driver, "target-output", meta_output_get_name (output));
+  client = meta_wayland_test_client_new_with_args (test_context, "color-management",
+                                                   version == 1 ? "target-v1" : "target-v2", NULL);
+  wait_for_sync_point (10);
+  info->edid_info->native_luminance.max_luminance_10pct = 700;
+  meta_color_device_update (device);
+  g_assert_true (meta_color_device_get_color_state (device) == encoding);
+  g_assert_cmpuint (color_changes, ==, 0);
+  g_assert_cmpuint (target_changes, ==, 1);
+  emit_sync_event (10);
+
+  wait_for_sync_point (11);
+  info->edid_info->native_luminance.max_luminance_full = 500;
+  meta_color_device_update (device);
+  g_assert_cmpuint (target_changes, ==, 2);
+  g_assert_true (meta_color_device_get_color_state (device) == encoding);
+  emit_sync_event (11);
+
+  wait_for_sync_point (12);
+  g_object_set (debug, "force-hdr", TRUE, NULL);
+  g_assert_cmpfloat (meta_color_device_get_target_luminance (device)->maximum, ==, 10000);
+  g_assert_true (meta_color_device_get_color_state (device) == encoding);
+  emit_sync_event (12);
+
+  wait_for_sync_point (13);
+  g_object_set (debug, "force-hdr", FALSE, NULL);
+  g_assert_cmpfloat (meta_color_device_get_target_luminance (device)->maximum, ==, 700);
+  emit_sync_event (13);
+
+  wait_for_sync_point (14);
+  info->edid_info->native_rgb_bt2020_pq = FALSE;
+  info->edid_info->hdr_static_metadata.type1 = TRUE;
+  info->edid_info->hdr_static_metadata.pq = TRUE;
+  info->edid_info->colorimetry.bt2020_rgb = TRUE;
+  meta_color_device_update (device);
+  g_assert_cmpfloat (meta_color_device_get_target_luminance (device)->maximum, ==, 10000);
+  g_assert_true (meta_color_device_get_color_state (device) == encoding);
+  g_assert_cmpuint (color_changes, ==, 0);
+  emit_sync_event (14);
+
+  wait_for_sync_point (15);
+  meta_color_device_update (device);
+  emit_sync_event (15);
+
+  wait_for_sync_point (16);
+  set_test_color_mode (output, META_COLOR_MODE_DEFAULT);
+  meta_color_device_update (device);
+  g_assert_cmpfloat (meta_color_device_get_target_luminance (device)->maximum, ==, 80);
+  g_assert_cmpuint (color_changes, ==, 1);
+  emit_sync_event (16);
+
+  wait_for_sync_point (17);
+  if (version == 2)
+    {
+      MetaWaylandCompositor *compositor = meta_context_get_wayland_compositor (test_context);
+      GObject *wayland_manager = g_object_get_data (G_OBJECT (compositor), "-meta-wayland-color-manager");
+
+      /* Live immutable descriptions must outlast repeated manager disposal. */
+      g_object_run_dispose (wayland_manager);
+      g_object_run_dispose (wayland_manager);
+    }
+  emit_sync_event (17);
+  meta_wayland_test_client_finish (client);
+  g_signal_handler_disconnect (device, color_handler);
+  g_signal_handler_disconnect (device, target_handler);
+}
+
 static void
 on_before_tests (void)
 {
@@ -188,6 +321,8 @@ init_tests (void)
 {
   g_test_add_func ("/wayland/color-management",
                    color_management);
+  g_test_add_data_func ("/wayland/target-luminance/v1", GINT_TO_POINTER (1), target_luminance);
+  g_test_add_data_func ("/wayland/target-luminance/v2", GINT_TO_POINTER (2), target_luminance);
 }
 
