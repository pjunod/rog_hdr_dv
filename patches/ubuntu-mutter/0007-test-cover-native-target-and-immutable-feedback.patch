+static void
+target_registry_global (void *data, struct wl_registry *registry, uint32_t name,
+                        const char *interface, uint32_t version)
+{
+  TargetClient *client = data;
+
+  if (strcmp (interface, wp_color_manager_v1_interface.name) == 0)
+    {
+      g_assert_cmpuint (version, >=, client->version);
+      client->manager = wl_registry_bind (registry, name, &wp_color_manager_v1_interface, client->version);
+      wp_color_manager_v1_add_listener (client->manager, &target_manager_listener, client);
+    }
+  else if (strcmp (interface, wl_output_interface.name) == 0)
+    {
+      TargetOutput *output;
+
+      g_assert_cmpuint (client->n_outputs, <, G_N_ELEMENTS (client->outputs));
+      g_assert_cmpuint (version, >=, 4);
+      output = &client->outputs[client->n_outputs++];
+      output->output = wl_registry_bind (registry, name, &wl_output_interface, 4);
+      wl_output_add_listener (output->output, &target_output_listener, output);
+    }
+}
