+static void
+target_luminance_client (WaylandDisplay *display, int version)
+{
+  TargetClient client = { .version = version };
+  struct wl_registry *registry = wl_display_get_registry (display->display);
+  struct wl_surface *surface = wl_compositor_create_surface (display->compositor);
+  struct wp_color_management_surface_feedback_v1 *feedback;
+  TargetOutput *target = NULL;
+  TargetSnapshot snapshots[8] = { 0 }, preferred = { 0 };
+  TargetInfo info;
+  unsigned int i, phase;
+  const uint32_t maxima[] = { 700, 700, 10000, 700, 10000, 10000, 80 };
+
+  wl_registry_add_listener (registry, &target_registry_listener, &client);
+  wl_display_roundtrip (display->display);
+  wl_display_roundtrip (display->display);
+  g_assert_nonnull (client.manager);
+  g_assert_cmpuint (client.n_outputs, ==, 2);
+  for (i = 0; i < client.n_outputs; i++)
+    {
+      TargetOutput *output = &client.outputs[i];
+
+      if (g_strcmp0 (output->name, lookup_property_string (display, "target-output")) == 0)
+        target = output;
+      output->color_output = wp_color_manager_v1_get_output (client.manager, output->output);
+      wp_color_management_output_v1_add_listener (output->color_output, &target_color_output_listener, output);
+      output->done = 0;
+    }
+  g_assert_nonnull (target);
+  /* An unmapped surface has no main/output membership: use primary fallback. */
+  feedback = wp_color_manager_v1_get_surface_feedback (client.manager, surface);
+  wp_color_management_surface_feedback_v1_add_listener (feedback, &target_feedback_listener, &client);
+  wl_display_roundtrip (display->display);
+  g_assert_cmpuint (client.preferred_changes, ==, 1);
+  snapshots[0].description = wp_color_management_output_v1_get_image_description (target->color_output);
+  wait_target_snapshot (display, &snapshots[0]);
+  preferred.description = wp_color_management_surface_feedback_v1_get_preferred (feedback);
+  wait_target_snapshot (display, &preferred);
+  g_assert_cmpuint (snapshots[0].identity, ==, preferred.identity);
+  g_assert_cmpuint (client.preferred, ==, preferred.identity);
+  wp_image_description_v1_destroy (preferred.description);
+  info = read_target_info (display, &snapshots[0]);
+  g_assert_cmpuint (info.encoding_min, ==, 50);
+  g_assert_cmpuint (info.encoding_max, ==, 10000);
+  g_assert_cmpuint (info.reference, ==, 203);
+  g_assert_cmpuint (info.target_min, ==, 5);
+  g_assert_cmpuint (info.target_max, ==, 616);
+  g_assert_cmpuint (info.primaries, ==, WP_COLOR_MANAGER_V1_PRIMARIES_BT2020);
+  g_assert_cmpuint (info.tf, ==, WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_ST2084_PQ);
+  client.preferred_changes = 0;
+
+  for (phase = 0; phase < G_N_ELEMENTS (maxima); phase++)
+    {
+      unsigned int changed = phase == 1 || phase == 5 ? 0 : 1;
+
+      test_driver_sync_point (display->test_driver, 10 + phase, NULL);
+      wait_for_sync_event (display, 10 + phase);
+      wl_display_roundtrip (display->display);
+      check_target_events (&client, target, changed);
+      snapshots[phase + 1].description = wp_color_management_output_v1_get_image_description (target->color_output);
+      wait_target_snapshot (display, &snapshots[phase + 1]);
+      preferred = (TargetSnapshot) {
+        .description = wp_color_management_surface_feedback_v1_get_preferred (feedback),
+      };
+      wait_target_snapshot (display, &preferred);
+      g_assert_cmpuint (preferred.identity, ==, snapshots[phase + 1].identity);
+      g_assert_cmpuint (client.preferred, ==, preferred.identity);
+      wp_image_description_v1_destroy (preferred.description);
+      if (changed)
+        g_assert_cmpuint (snapshots[phase + 1].identity, !=, snapshots[phase].identity);
+      else
+        g_assert_cmpuint (snapshots[phase + 1].identity, ==, snapshots[phase].identity);
+      info = read_target_info (display, &snapshots[phase + 1]);
+      g_assert_cmpuint (info.target_max, ==, maxima[phase]);
+      g_assert_cmpuint (info.encoding_max, ==, phase == 6 ? 80 : 10000);
+      g_assert_cmpuint (info.reference, ==, phase == 6 ? 80 : 203);
+      info = read_target_info (display, &snapshots[0]);
+      g_assert_cmpuint (info.target_min, ==, 5);
+      g_assert_cmpuint (info.target_max, ==, 616);
+    }
+
+  test_driver_sync_point (display->test_driver, 17, NULL);
+  wait_for_sync_event (display, 17);
+  /* Version 2 has just disposed the manager twice with these objects alive. */
+  info = read_target_info (display, &snapshots[0]);
+  g_assert_cmpuint (info.target_max, ==, 616);
+  for (i = 0; i < G_N_ELEMENTS (snapshots); i++)
+    wp_image_description_v1_destroy (snapshots[i].description);
+  wp_color_management_surface_feedback_v1_destroy (feedback);
+  wl_surface_destroy (surface);
+  for (i = 0; i < client.n_outputs; i++)
+    {
+      wp_color_management_output_v1_destroy (client.outputs[i].color_output);
+      wl_output_release (client.outputs[i].output);
+      g_free (client.outputs[i].name);
+    }
+  wp_color_manager_v1_destroy (client.manager);
+  wl_registry_destroy (registry);
+  wl_display_roundtrip (display->display);
+}
