diff --git a/src/tests/native-hdr-tests.c b/src/tests/native-hdr-tests.c
index 5e9c5af..d21a003 100644
--- a/src/tests/native-hdr-tests.c
+++ b/src/tests/native-hdr-tests.c
@@ -7,6 +7,7 @@
 #include <glib.h>
 
 #include "backends/meta-output.h"
+#include "backends/meta-color-device.h"
 #include "backends/native/meta-output-kms.h"
 
 static const uint8_t native[] = {
@@ -480,6 +481,144 @@ test_fatal_base (void)
     }
 }
 
+static void
+parameters (uint8_t data[32])
+{
+  memset (data, 0, 32);
+  data[0] = 0x21;
+  data[2] = 29;
+  data[0x18] = 0x40;
+  data[0x19] = 0x5e; /* Synthetic full coverage: 400 cd/m2. */
+  data[0x1a] = 0xd0;
+  data[0x1b] = 0x60; /* Synthetic 10% coverage: 616 cd/m2. */
+  data[0x1c] = 0x19;
+  data[0x1d] = 0x10; /* Fractional minimum, not an optical measurement. */
+}
+
+static void
+test_physical_luminance (void)
+{
+  uint8_t blocks[76] = { 0 };
+  g_autoptr (MetaOutputInfo) info = NULL;
+  unsigned int reverse;
+
+  memcpy (blocks, native, sizeof (native));
+  parameters (blocks + sizeof (native));
+  info = parse (blocks, 44, NULL, 0, FALSE);
+  g_assert_cmpint (info->edid_info->native_luminance_status, ==,
+                   META_NATIVE_LUMINANCE_FIRMWARE_DECLARED);
+  g_assert_cmpfloat (info->edid_info->native_luminance.min_luminance, ==,
+                     1049.0f / 2097152.0f);
+  g_assert_cmpfloat (info->edid_info->native_luminance.max_luminance_full, ==, 400);
+  g_assert_cmpfloat (info->edid_info->native_luminance.max_luminance_10pct, ==, 616);
+  g_assert_true (info->edid_info->native_rgb_bt2020_pq);
+  g_assert_cmpfloat (info->edid_info->hdr_static_metadata.desired_content_max_luminance, ==, 0);
+  g_clear_pointer (&info, meta_output_info_unref);
+
+  memcpy (blocks + 44, blocks + 12, 32);
+  info = parse (blocks, sizeof (blocks), NULL, 0, FALSE);
+  g_assert_cmpint (info->edid_info->native_luminance_status, ==,
+                   META_NATIVE_LUMINANCE_FIRMWARE_DECLARED);
+  g_clear_pointer (&info, meta_output_info_unref);
+
+  for (reverse = 0; reverse < 2; reverse++)
+    {
+      parameters (blocks + 12);
+      parameters (blocks + 44);
+      blocks[(reverse ? 12 : 44) + 0x1a] = 0xd2;
+      info = parse (blocks, sizeof (blocks), NULL, 0, FALSE);
+      g_assert_cmpint (info->edid_info->native_luminance_status, ==,
+                       META_NATIVE_LUMINANCE_CONFLICT);
+      g_assert_false (info->edid_info->native_luminance.has_max_luminance_10pct);
+      g_assert_true (info->edid_info->native_rgb_bt2020_pq);
+      g_clear_pointer (&info, meta_output_info_unref);
+    }
+
+  parameters (blocks + 12);
+  blocks[12 + 0x1d] = 0x7e; /* Unavailable minimum leaves other fields intact. */
+  info = parse (blocks, 44, NULL, 0, FALSE);
+  g_assert_cmpint (info->edid_info->native_luminance_status, ==,
+                   META_NATIVE_LUMINANCE_FIRMWARE_DECLARED);
+  g_assert_false (info->edid_info->native_luminance.has_min_luminance);
+  g_assert_true (info->edid_info->native_luminance.has_max_luminance_10pct);
+  g_clear_pointer (&info, meta_output_info_unref);
+
+  parameters (blocks + 12);
+  blocks[12 + 0x18] = 0xff; /* Full coverage exceeds 10% peak. */
+  blocks[12 + 0x19] = 0x60;
+  info = parse (blocks, 44, NULL, 0, FALSE);
+  g_assert_cmpint (info->edid_info->native_luminance_status, ==, META_NATIVE_LUMINANCE_INVALID);
+  g_assert_true (info->edid_info->native_rgb_bt2020_pq);
+  g_clear_pointer (&info, meta_output_info_unref);
+
+  parameters (blocks + 12);
+  blocks[13] = 2; /* Unsupported Display Parameters revision. */
+  info = parse (blocks, 44, NULL, 0, FALSE);
+  g_assert_cmpint (info->edid_info->native_luminance_status, ==, META_NATIVE_LUMINANCE_INVALID);
+  g_clear_pointer (&info, meta_output_info_unref);
+
+  info = parse (native, sizeof (native), NULL, 0, FALSE);
+  g_assert_cmpint (info->edid_info->native_luminance_status, ==, META_NATIVE_LUMINANCE_UNAVAILABLE);
+}
+
+static void
+test_target_luminance_policy (void)
+{
+  MetaEdidInfo edid = {
+    .native_luminance_status = META_NATIVE_LUMINANCE_FIRMWARE_DECLARED,
+    .native_luminance = {
+      .has_min_luminance = TRUE,
+      .has_max_luminance_10pct = TRUE,
+      .has_max_luminance_full = TRUE,
+      .min_luminance = 1049.0f / 2097152.0f,
+      .max_luminance_10pct = 616,
+      .max_luminance_full = 400,
+    },
+  };
+  ClutterLuminance encoding = { .min = 0.005f, .max = 10000, .ref = 203 };
+  MetaColorTargetLuminance target;
+
+  meta_color_target_luminance_init (&target, &edid, TRUE, &encoding);
+  g_assert_cmpfloat (target.minimum, ==, edid.native_luminance.min_luminance);
+  g_assert_cmpfloat (target.maximum, ==, 616);
+  g_assert_cmpfloat (target.physical.max_luminance_full, ==, 400);
+  g_assert_cmpint (target.maximum_source, ==, META_COLOR_TARGET_FIRMWARE_DECLARED);
+  g_assert_cmpfloat (encoding.max, ==, 10000);
+  g_assert_cmpfloat (encoding.ref, ==, 203);
+
+  /* Eligibility is separately decided from active mode/KMS/native capability. */
+  meta_color_target_luminance_init (&target, &edid, FALSE, &encoding);
+  g_assert_cmpfloat (target.maximum, ==, encoding.max);
+  g_assert_false (target.physical.has_max_luminance_10pct);
+  g_assert_cmpint (target.maximum_source, ==, META_COLOR_TARGET_ENCODING_FALLBACK);
+
+  edid.native_luminance.has_min_luminance = FALSE;
+  meta_color_target_luminance_init (&target, &edid, TRUE, &encoding);
+  g_assert_cmpfloat (target.minimum, ==, encoding.min);
+  g_assert_cmpfloat (target.maximum, ==, 616);
+  g_assert_cmpint (target.minimum_source, ==, META_COLOR_TARGET_ENCODING_FALLBACK);
+  edid.native_luminance.has_min_luminance = TRUE;
+  edid.native_luminance.has_max_luminance_10pct = FALSE;
+  edid.native_luminance.min_luminance = 15000;
+  meta_color_target_luminance_init (&target, &edid, TRUE, &encoding);
+  g_assert_cmpfloat (target.minimum, ==, encoding.min);
+  g_assert_cmpfloat (target.maximum, ==, encoding.max);
+  g_assert_cmpint (target.minimum_source, ==, META_COLOR_TARGET_ENCODING_FALLBACK);
+
+  edid.native_luminance_status = META_NATIVE_LUMINANCE_CONFLICT;
+  meta_color_target_luminance_init (&target, &edid, TRUE, &encoding);
+  g_assert_cmpfloat (target.maximum, ==, encoding.max);
+
+  /* Wire maximum has whole-nit precision: do not publish an inverted range. */
+  edid.native_luminance_status = META_NATIVE_LUMINANCE_FIRMWARE_DECLARED;
+  edid.native_luminance.has_max_luminance_10pct = TRUE;
+  edid.native_luminance.min_luminance = 1.5f;
+  edid.native_luminance.max_luminance_10pct = 1.75f;
+  meta_color_target_luminance_init (&target, &edid, TRUE, &encoding);
+  g_assert_cmpfloat (target.minimum, ==, encoding.min);
+  g_assert_cmpfloat (target.maximum, ==, encoding.max);
+}
+
 int
 main (int    argc,
       char **argv)
@@ -492,5 +631,7 @@ main (int    argc,
   g_test_add_func ("/native-hdr/fatal-base", test_fatal_base);
   g_test_add_func ("/native-hdr/cta-preserved-with-extension-failure",
                    test_cta_with_extension_failure);
+  g_test_add_func ("/native-hdr/physical-luminance", test_physical_luminance);
+  g_test_add_func ("/native-hdr/target-luminance-policy", test_target_luminance_policy);
   return g_test_run ();
 }
diff --git a/src/tests/wayland-color-management-test.c b/src/tests/wayland-color-management-test.c
index f1ee183..3817251 100644
--- a/src/tests/wayland-color-management-test.c
+++ b/src/tests/wayland-color-management-test.c
@@ -26,6 +26,13 @@
 #include <stdint.h>
 
 #include "backends/meta-virtual-monitor.h"
+#include "backends/meta-backend-private.h"
+#include "backends/meta-color-device.h"
+#include "backends/meta-color-manager.h"
+#include "backends/meta-monitor-private.h"
+#include "backends/meta-monitor-manager-private.h"
