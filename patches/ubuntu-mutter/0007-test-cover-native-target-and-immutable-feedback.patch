+static void
+check_target_events (TargetClient *client, TargetOutput *target, unsigned int count)
+{
+  unsigned int i;
+
+  g_assert_cmpuint (target->changed, ==, count);
+  g_assert_cmpuint (target->done, ==, count);
+  g_assert_false (target->awaiting_done);
+  g_assert_cmpuint (client->preferred_changes, ==, count);
+  for (i = 0; i < client->n_outputs; i++)
+    {
+      TargetOutput *output = &client->outputs[i];
+
+      if (output != target)
+        {
+          g_assert_cmpuint (output->changed, ==, 0);
+          g_assert_cmpuint (output->done, ==, 0);
+        }
+      output->changed = output->done = 0;
+    }
+  client->preferred_changes = 0;
+}
