From 9c10145fe252b6a6d5f8b8547e8561a3c9acfee3 Mon Sep 17 00:00:00 2001
From: Codex <codex@invalid>
Date: Fri, 9 Oct 2026 01:04:12 -0400
Subject: [PATCH] fix(color): refresh preferred targets after output topology
 changes

---
 src/backends/meta-color-device.c              |  2 +-
 src/tests/native-hdr-tests.c                  |  9 +-
 src/tests/wayland-color-management-test.c     | 47 ++++++++-
 .../wayland-test-clients/color-management.c   | 56 ++++++++++-
 src/wayland/meta-wayland-color-management.c   | 96 +++++++++++++------
 src/wayland/meta-wayland-color-management.h   |  2 +
 src/wayland/meta-wayland-outputs.c            |  3 +
 7 files changed, 180 insertions(+), 35 deletions(-)

diff --git a/src/backends/meta-color-device.c b/src/backends/meta-color-device.c
index 5aee553..b2931e9 100644
--- a/src/backends/meta-color-device.c
+++ b/src/backends/meta-color-device.c
@@ -783,7 +783,7 @@ meta_color_target_luminance_init (MetaColorTargetLuminance *target,
   if (!isfinite (target->minimum) || !isfinite (target->maximum) ||
       target->minimum < 0 || target->maximum < 1 ||
       target->minimum > target->maximum ||
-      (double) target->minimum > floor ((double) target->maximum) ||
+      (double) target->minimum >= floor ((double) target->maximum) ||
       (double) target->minimum * 10000 > G_MAXUINT32 ||
       (double) target->maximum > G_MAXUINT32)
     {
diff --git a/src/tests/native-hdr-tests.c b/src/tests/native-hdr-tests.c
index d21a003..f3091cb 100644
--- a/src/tests/native-hdr-tests.c
+++ b/src/tests/native-hdr-tests.c
@@ -609,7 +609,7 @@ test_target_luminance_policy (void)
   meta_color_target_luminance_init (&target, &edid, TRUE, &encoding);
   g_assert_cmpfloat (target.maximum, ==, encoding.max);
 
-  /* Wire maximum has whole-nit precision: do not publish an inverted range. */
+  /* Wire maximum has whole-nit precision: reject inverted or empty ranges. */
   edid.native_luminance_status = META_NATIVE_LUMINANCE_FIRMWARE_DECLARED;
   edid.native_luminance.has_max_luminance_10pct = TRUE;
   edid.native_luminance.min_luminance = 1.5f;
@@ -617,6 +617,13 @@ test_target_luminance_policy (void)
   meta_color_target_luminance_init (&target, &edid, TRUE, &encoding);
   g_assert_cmpfloat (target.minimum, ==, encoding.min);
   g_assert_cmpfloat (target.maximum, ==, encoding.max);
+
+  edid.native_luminance.min_luminance = 1.0f;
+  meta_color_target_luminance_init (&target, &edid, TRUE, &encoding);
+  g_assert_cmpfloat (target.minimum, ==, encoding.min);
+  g_assert_cmpfloat (target.maximum, ==, encoding.max);
+  g_assert_cmpint (target.minimum_source, ==, META_COLOR_TARGET_ENCODING_FALLBACK);
+  g_assert_cmpint (target.maximum_source, ==, META_COLOR_TARGET_ENCODING_FALLBACK);
 }
 
 int
diff --git a/src/tests/wayland-color-management-test.c b/src/tests/wayland-color-management-test.c
index c676e1d..6b65831 100644
--- a/src/tests/wayland-color-management-test.c
+++ b/src/tests/wayland-color-management-test.c
@@ -30,6 +30,7 @@
 #include "backends/meta-color-device.h"
 #include "backends/meta-color-manager.h"
 #include "backends/meta-monitor-private.h"
+#include "backends/meta-logical-monitor-private.h"
 #include "backends/meta-monitor-manager-private.h"
 #include "backends/meta-output.h"
 #include "core/meta-debug-control-private.h"
@@ -199,12 +200,16 @@ target_luminance (gconstpointer data)
   g_autoptr (MetaVirtualMonitor) other = meta_create_test_monitor (test_context, 320, 240, 60);
   MetaBackend *backend = meta_context_get_backend (test_context);
   MetaColorManager *manager = meta_backend_get_color_manager (backend);
+  MetaMonitorManager *monitor_manager = meta_backend_get_monitor_manager (backend);
+  MetaMonitor *other_monitor = NULL;
+  MetaMonitorMode *other_mode = NULL;
   MetaOutput *output = meta_virtual_monitor_get_output (virtual_monitor);
   MetaOutputInfo *info = (MetaOutputInfo *) meta_output_get_info (output);
   MetaColorDevice *device = meta_color_manager_get_color_device (manager, meta_output_get_monitor (output));
   MetaDebugControl *debug = meta_context_get_debug_control (test_context);
   MetaWaylandTestClient *client;
   g_autoptr (ClutterColorState) encoding = NULL;
+  const ClutterLuminance *encoding_luminance;
   unsigned int color_changes = 0, target_changes = 0;
   gulong color_handler, target_handler;
 
@@ -226,6 +231,7 @@ target_luminance (gconstpointer data)
   set_test_color_mode (output, META_COLOR_MODE_BT2100);
   meta_color_device_update (device);
   encoding = g_object_ref (meta_color_device_get_color_state (device));
+  encoding_luminance = clutter_color_state_params_get_luminance (CLUTTER_COLOR_STATE_PARAMS (encoding));
   g_assert_cmpfloat (meta_color_device_get_target_luminance (device)->maximum, ==, 616);
   color_handler = g_signal_connect (device, "color-state-changed", G_CALLBACK (count_color_signal), &color_changes);
   target_handler = g_signal_connect (device, "target-volume-changed", G_CALLBACK (count_color_signal), &target_changes);
@@ -250,7 +256,7 @@ target_luminance (gconstpointer data)
 
   wait_for_sync_point (12);
   g_object_set (debug, "force-hdr", TRUE, NULL);
-  g_assert_cmpfloat (meta_color_device_get_target_luminance (device)->maximum, ==, 10000);
+  g_assert_cmpfloat (meta_color_device_get_target_luminance (device)->maximum, ==, encoding_luminance->max);
   g_assert_true (meta_color_device_get_color_state (device) == encoding);
   emit_sync_event (12);
 
@@ -265,7 +271,7 @@ target_luminance (gconstpointer data)
   info->edid_info->hdr_static_metadata.pq = TRUE;
   info->edid_info->colorimetry.bt2020_rgb = TRUE;
   meta_color_device_update (device);
-  g_assert_cmpfloat (meta_color_device_get_target_luminance (device)->maximum, ==, 10000);
+  g_assert_cmpfloat (meta_color_device_get_target_luminance (device)->maximum, ==, encoding_luminance->max);
   g_assert_true (meta_color_device_get_color_state (device) == encoding);
   g_assert_cmpuint (color_changes, ==, 0);
   emit_sync_event (14);
@@ -274,6 +280,41 @@ target_luminance (gconstpointer data)
   meta_color_device_update (device);
   emit_sync_event (15);
 
+  /* Topology-only changes must update a role-less surface's primary fallback,
+   * even when no device emits a color/target change. Emit the canonical output
+   * lifecycle signal after changing this isolated monitor fixture's topology. */
+  wait_for_sync_point (18);
+  {
+    MetaLogicalMonitor *target_logical =
+      meta_monitor_get_logical_monitor (meta_output_get_monitor (output));
+    MetaLogicalMonitor *other_logical;
+    unsigned int old_target_changes = target_changes;
+
+    other_monitor = meta_output_get_monitor (meta_virtual_monitor_get_output (other));
+    other_mode = meta_monitor_get_current_mode (other_monitor);
+    other_logical = meta_monitor_get_logical_monitor (other_monitor);
+    target_logical->is_primary = FALSE;
+    other_logical->is_primary = TRUE;
+    monitor_manager->primary_logical_monitor = other_logical;
+    g_signal_emit_by_name (monitor_manager, "monitors-changing");
+    g_assert_true (meta_color_device_get_color_state (device) == encoding);
+    g_assert_cmpuint (color_changes, ==, 0);
+    g_assert_cmpuint (target_changes, ==, old_target_changes);
+    emit_sync_event (18);
+
+    wait_for_sync_point (19);
+    other_logical->is_primary = FALSE;
+    target_logical->is_primary = TRUE;
+    monitor_manager->primary_logical_monitor = target_logical;
+    /* The active-output table must drop the old primary before preferences. */
+    meta_monitor_set_current_mode (other_monitor, NULL);
+    g_signal_emit_by_name (monitor_manager, "monitors-changing");
+    g_assert_true (meta_color_device_get_color_state (device) == encoding);
+    g_assert_cmpuint (color_changes, ==, 0);
+    g_assert_cmpuint (target_changes, ==, old_target_changes);
+    emit_sync_event (19);
+  }
+
   wait_for_sync_point (16);
   set_test_color_mode (output, META_COLOR_MODE_DEFAULT);
   meta_color_device_update (device);
@@ -295,6 +336,8 @@ target_luminance (gconstpointer data)
   meta_wayland_test_client_finish (client);
   g_signal_handler_disconnect (device, color_handler);
   g_signal_handler_disconnect (device, target_handler);
+  meta_monitor_set_current_mode (other_monitor, other_mode);
+  g_signal_emit_by_name (monitor_manager, "monitors-changing");
 }
 
 static void
diff --git a/src/tests/wayland-test-clients/color-management.c b/src/tests/wayland-test-clients/color-management.c
index ce8f409..970377a 100644
--- a/src/tests/wayland-test-clients/color-management.c
+++ b/src/tests/wayland-test-clients/color-management.c
@@ -652,6 +652,21 @@ check_target_events (TargetClient *client,
   client->preferred_changes = 0;
 }
 
+static void
+check_topology_preference (TargetClient *client)
+{
+  unsigned int i;
+
+  g_assert_cmpuint (client->preferred_changes, ==, 1);
+  client->preferred_changes = 0;
+  for (i = 0; i < client->n_outputs; i++)
+    {
+      g_assert_cmpuint (client->outputs[i].changed, ==, 0);
+      g_assert_cmpuint (client->outputs[i].done, ==, 0);
+      g_assert_false (client->outputs[i].awaiting_done);
+    }
+}
+
 static void
 target_luminance_client (WaylandDisplay *display,
                          int             version)
@@ -660,8 +675,8 @@ target_luminance_client (WaylandDisplay *display,
   struct wl_registry *registry = wl_display_get_registry (display->display);
   struct wl_surface *surface = wl_compositor_create_surface (display->compositor);
   struct wp_color_management_surface_feedback_v1 *feedback;
-  TargetOutput *target = NULL;
-  TargetSnapshot snapshots[8] = { 0 }, preferred = { 0 };
+  TargetOutput *target = NULL, *other = NULL;
+  TargetSnapshot snapshots[8] = { 0 }, preferred = { 0 }, other_snapshot = { 0 };
   TargetInfo info;
   unsigned int i, phase;
   const uint32_t maxima[] = { 700, 700, 10000, 700, 10000, 10000, 80 };
@@ -682,6 +697,14 @@ target_luminance_client (WaylandDisplay *display,
       output->done = 0;
     }
   g_assert_nonnull (target);
+  for (i = 0; i < client.n_outputs; i++)
+    {
+      if (&client.outputs[i] != target)
+        other = &client.outputs[i];
+    }
+  g_assert_nonnull (other);
+  other_snapshot.description = wp_color_management_output_v1_get_image_description (other->color_output);
+  wait_target_snapshot (display, &other_snapshot);
   /* An unmapped surface has no main/output membership: use primary fallback. */
   feedback = wp_color_manager_v1_get_surface_feedback (client.manager, surface);
   wp_color_management_surface_feedback_v1_add_listener (feedback, &target_feedback_listener, &client);
@@ -708,6 +731,34 @@ target_luminance_client (WaylandDisplay *display,
     {
       unsigned int changed = phase == 1 || phase == 5 ? 0 : 1;
 
+      if (phase == 6)
+        {
+          unsigned int topology_phase;
+
+          for (topology_phase = 0; topology_phase < 2; topology_phase++)
+            {
+              uint64_t expected_identity = topology_phase == 0 ?
+                                           other_snapshot.identity : snapshots[phase].identity;
+
+              test_driver_sync_point (display->test_driver, 18 + topology_phase, NULL);
+              wait_for_sync_event (display, 18 + topology_phase);
+              wl_display_roundtrip (display->display);
+              check_topology_preference (&client);
+              preferred = (TargetSnapshot) {
+                .description = wp_color_management_surface_feedback_v1_get_preferred (feedback),
+              };
+              wait_target_snapshot (display, &preferred);
+              g_assert_cmpuint (client.preferred, ==, expected_identity);
+              g_assert_cmpuint (preferred.identity, ==, expected_identity);
+              info = read_target_info (display, &preferred);
+              g_assert_cmpuint (info.target_max, ==, topology_phase == 0 ? 80 : 10000);
+              wp_image_description_v1_destroy (preferred.description);
+              /* The removed primary's old description remains readable. */
+              info = read_target_info (display, &other_snapshot);
+              g_assert_cmpuint (info.target_max, ==, 80);
+            }
+        }
+
       test_driver_sync_point (display->test_driver, 10 + phase, NULL);
       wait_for_sync_event (display, 10 + phase);
       wl_display_roundtrip (display->display);
@@ -741,6 +792,7 @@ target_luminance_client (WaylandDisplay *display,
   g_assert_cmpuint (info.target_max, ==, 616);
   for (i = 0; i < G_N_ELEMENTS (snapshots); i++)
     wp_image_description_v1_destroy (snapshots[i].description);
+  wp_image_description_v1_destroy (other_snapshot.description);
   wp_color_management_surface_feedback_v1_destroy (feedback);
   wl_surface_destroy (surface);
   for (i = 0; i < client.n_outputs; i++)
diff --git a/src/wayland/meta-wayland-color-management.c b/src/wayland/meta-wayland-color-management.c
index 05d8988..89b923c 100644
--- a/src/wayland/meta-wayland-color-management.c
+++ b/src/wayland/meta-wayland-color-management.c
@@ -2064,47 +2064,85 @@ color_management_bind (struct wl_client *client,
 }
 
 static void
-update_output_color_state (MetaWaylandColorManager *color_manager,
-                           MetaMonitor             *monitor)
+notify_output_record_changed (MetaWaylandColorManagementOutput *cm_output)
 {
-  MetaWaylandColorManagementOutput *cm_output;
-  GHashTableIter iter_surfaces;
+  GList *l;
+
+  for (l = cm_output->resources; l; l = l->next)
+    wp_color_management_output_v1_send_image_description_changed (l->data);
+
+  for (l = (GList *) meta_wayland_output_get_resources (cm_output->output); l; l = l->next)
+    {
+      struct wl_resource *resource = l->data;
+
+      if (wl_resource_get_version (resource) >= WL_OUTPUT_DONE_SINCE_VERSION)
+        wl_output_send_done (resource);
+    }
+}
+
+static void
+update_surface_preferences (MetaWaylandColorManager *color_manager)
+{
+  GHashTableIter iter;
   MetaWaylandColorManagementSurface *cm_surface;
-  MetaWaylandOutput *wayland_output;
 
-  wayland_output = g_hash_table_lookup (color_manager->compositor->outputs,
-                                        meta_monitor_get_spec (monitor));
+  g_hash_table_iter_init (&iter, color_manager->surfaces);
+  while (g_hash_table_iter_next (&iter, NULL, (gpointer *) &cm_surface))
+    update_preferred_color_state (cm_surface);
+}
 
-  if (!wayland_output)
-    return;
+void
+meta_wayland_color_management_outputs_changed (MetaWaylandCompositor *compositor)
+{
+  MetaWaylandColorManager *color_manager =
+    g_object_get_data (G_OBJECT (compositor), "-meta-wayland-color-manager");
+  g_autoptr (GPtrArray) changed_outputs = NULL;
+  GHashTableIter iter;
+  MetaWaylandOutput *output;
+  unsigned int i;
 
-  cm_output = ensure_color_management_output (color_manager, wayland_output);
+  /* Initial output setup precedes the manager; disposed managers are inert. */
+  if (!color_manager || !color_manager->outputs || !color_manager->surfaces ||
+      !compositor->outputs)
+    return;
 
-  if (update_output_record (cm_output))
+  changed_outputs = g_ptr_array_new ();
+  g_hash_table_iter_init (&iter, compositor->outputs);
+  while (g_hash_table_iter_next (&iter, NULL, (gpointer *) &output))
     {
-      GList *l;
+      MetaWaylandColorManagementOutput *cm_output =
+        ensure_color_management_output (color_manager, output);
+
+      if (update_output_record (cm_output))
+        g_ptr_array_add (changed_outputs, cm_output);
+    }
 
-      for (l = cm_output->resources; l; l = l->next)
-        {
-          struct wl_resource *resource = l->data;
+  /* Publish every active record before selecting any surface's new target. */
+  for (i = 0; i < changed_outputs->len; i++)
+    notify_output_record_changed (g_ptr_array_index (changed_outputs, i));
+  update_surface_preferences (color_manager);
+}
 
-          wp_color_management_output_v1_send_image_description_changed (resource);
-        }
+static void
+update_output_color_state (MetaWaylandColorManager *color_manager,
+                           MetaMonitor             *monitor)
+{
+  MetaWaylandColorManagementOutput *cm_output;
+  MetaWaylandOutput *output;
 
-      for (l = (GList *) meta_wayland_output_get_resources (wayland_output); l; l = l->next)
-        {
-          struct wl_resource *resource = l->data;
+  if (!color_manager->outputs || !color_manager->surfaces ||
+      !color_manager->compositor->outputs)
+    return;
 
-          if (wl_resource_get_version (resource) >= WL_OUTPUT_DONE_SINCE_VERSION)
-            wl_output_send_done (resource);
-        }
-    }
+  output = g_hash_table_lookup (color_manager->compositor->outputs,
+                                meta_monitor_get_spec (monitor));
+  if (!output)
+    return;
 
-  g_hash_table_iter_init (&iter_surfaces, color_manager->surfaces);
-  while (g_hash_table_iter_next (&iter_surfaces, NULL, (gpointer *)&cm_surface))
-    {
-      update_preferred_color_state (cm_surface);
-    }
+  cm_output = ensure_color_management_output (color_manager, output);
+  if (update_output_record (cm_output))
+    notify_output_record_changed (cm_output);
+  update_surface_preferences (color_manager);
 }
 
 static void
diff --git a/src/wayland/meta-wayland-color-management.h b/src/wayland/meta-wayland-color-management.h
index 07cbbf2..ec3348f 100644
--- a/src/wayland/meta-wayland-color-management.h
+++ b/src/wayland/meta-wayland-color-management.h
@@ -23,3 +23,5 @@
 #include "wayland/meta-wayland-types.h"
 
 void meta_wayland_init_color_management (MetaWaylandCompositor *compositor);
+
+void meta_wayland_color_management_outputs_changed (MetaWaylandCompositor *compositor);
diff --git a/src/wayland/meta-wayland-outputs.c b/src/wayland/meta-wayland-outputs.c
index 84cd16e..b0c1cd5 100644
--- a/src/wayland/meta-wayland-outputs.c
+++ b/src/wayland/meta-wayland-outputs.c
@@ -31,6 +31,7 @@
 #include "backends/meta-monitor-manager-private.h"
 #include "mtk/mtk.h"
 #include "wayland/meta-wayland-private.h"
+#include "wayland/meta-wayland-color-management.h"
 
 #ifdef HAVE_XWAYLAND
 #include "wayland/meta-xwayland.h"
@@ -611,6 +612,8 @@ meta_wayland_compositor_update_outputs (MetaWaylandCompositor *compositor,
       mtk_timeout_add_seconds_once (10, delayed_destroy_outputs,
                                     g_steal_pointer (&old_table));
     }
+
+  meta_wayland_color_management_outputs_changed (compositor);
 }
 
 static void
