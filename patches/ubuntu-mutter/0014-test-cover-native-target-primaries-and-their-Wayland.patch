From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@invalid>
Date: Sat, 10 Oct 2026 14:37:32 -0400
Subject: [PATCH 14/15] test: cover native target primaries and their Wayland
 feedback

Parser cases cover complete, duplicate, conflicting, invalid-point and
luminance-independent declarations. Policy cases cover CIE 1931 and
CIE 1976 conversion, quantization-invalid geometry, degenerate and
incomplete RGBW, and conflicts. Wayland v1/v2 cases check that target
primaries change independently of encoding, emit one notification per
target-volume change, and leave the PQ encoding state unchanged.
---
 src/tests/native-hdr-tests.c                  | 162 ++++++++++++++++
 src/tests/wayland-color-management-test.c     | 124 +++++++++++++
 .../wayland-test-clients/color-management.c   | 175 +++++++++++++++++-
 3 files changed, 460 insertions(+), 1 deletion(-)

diff --git a/src/tests/native-hdr-tests.c b/src/tests/native-hdr-tests.c
index f3091cb..6e34a15 100644
--- a/src/tests/native-hdr-tests.c
+++ b/src/tests/native-hdr-tests.c
@@ -626,6 +626,166 @@ test_target_luminance_policy (void)
   g_assert_cmpint (target.maximum_source, ==, META_COLOR_TARGET_ENCODING_FALLBACK);
 }
 
+static void
+chromaticities (uint8_t data[32])
+{
+  const uint16_t points[4][2] = {
+    { 2816, 1280 }, { 1024, 2816 }, { 512, 256 }, { 1280, 1344 },
+  };
+  unsigned int i;
+
+  parameters (data);
+  for (i = 0; i < 4; i++)
+    {
+      unsigned int offset = 0x0c + 3 * i;
+
+      data[offset] = points[i][0] & 0xff;
+      data[offset + 1] = (points[i][0] >> 8) | ((points[i][1] & 15) << 4);
+      data[offset + 2] = points[i][1] >> 4;
+    }
+}
+
+static void
+test_physical_chromaticities (void)
+{
+  uint8_t blocks[76] = { 0 };
+  g_autoptr (MetaOutputInfo) info = NULL;
+  unsigned int reverse;
+
+  memcpy (blocks, native, sizeof (native));
+  chromaticities (blocks + 12);
+  info = parse (blocks, 44, NULL, 0, FALSE);
+  g_assert_cmpint (info->edid_info->native_chromaticities_status, ==,
+                   META_NATIVE_CHROMATICITIES_FIRMWARE_DECLARED);
+  g_assert_cmpuint (info->edid_info->native_chromaticities.primaries[0].a, ==, 2816);
+  g_assert_cmpuint (info->edid_info->native_chromaticities.white_point.b, ==, 1344);
+  g_assert_cmpint (info->edid_info->native_luminance_status, ==,
+                   META_NATIVE_LUMINANCE_FIRMWARE_DECLARED);
+  g_assert_true (info->edid_info->native_rgb_bt2020_pq);
+  g_clear_pointer (&info, meta_output_info_unref);
+
+  memcpy (blocks + 44, blocks + 12, 32);
+  info = parse (blocks, 76, NULL, 0, FALSE);
+  g_assert_cmpint (info->edid_info->native_chromaticities_status, ==,
+                   META_NATIVE_CHROMATICITIES_FIRMWARE_DECLARED);
+  g_clear_pointer (&info, meta_output_info_unref);
+  for (reverse = 0; reverse < 2; reverse++)
+    {
+      chromaticities (blocks + 12);
+      chromaticities (blocks + 44);
+      blocks[(reverse ? 12 : 44) + 0x15]++;
+      info = parse (blocks, 76, NULL, 0, FALSE);
+      g_assert_cmpint (info->edid_info->native_chromaticities_status, ==,
+                       META_NATIVE_CHROMATICITIES_CONFLICT);
+      g_assert_cmpint (info->edid_info->native_luminance_status, ==,
+                       META_NATIVE_LUMINANCE_FIRMWARE_DECLARED);
+      g_clear_pointer (&info, meta_output_info_unref);
+
+      chromaticities (blocks + 12);
+      chromaticities (blocks + 44);
+      blocks[(reverse ? 12 : 44) + 0x0b] = 0x40;
+      info = parse (blocks, 76, NULL, 0, FALSE);
+      g_assert_cmpint (info->edid_info->native_chromaticities_status, ==,
+                       META_NATIVE_CHROMATICITIES_CONFLICT);
+      g_clear_pointer (&info, meta_output_info_unref);
+
+      chromaticities (blocks + 12);
+      chromaticities (blocks + 44);
+      blocks[(reverse ? 12 : 44) + 1] = 2;
+      info = parse (blocks, 76, NULL, 0, FALSE);
+      g_assert_cmpint (info->edid_info->native_chromaticities_status, ==,
+                       META_NATIVE_CHROMATICITIES_INVALID);
+      g_clear_pointer (&info, meta_output_info_unref);
+    }
+
+  chromaticities (blocks + 12);
+  memset (blocks + 12 + 0x15, 0, 3);
+  info = parse (blocks, 44, NULL, 0, FALSE);
+  g_assert_cmpint (info->edid_info->native_chromaticities_status, ==,
+                   META_NATIVE_CHROMATICITIES_INVALID);
+  g_assert_cmpuint (info->edid_info->native_chromaticities.primaries[0].a, ==, 2816);
+  g_assert_cmpint (info->edid_info->native_luminance_status, ==,
+                   META_NATIVE_LUMINANCE_FIRMWARE_DECLARED);
+  g_clear_pointer (&info, meta_output_info_unref);
+  chromaticities (blocks + 12);
+  blocks[12 + 0x0b] = 0x18; /* Luminance-class support is independent. */
+  info = parse (blocks, 44, NULL, 0, FALSE);
+  g_assert_cmpint (info->edid_info->native_chromaticities_status, ==,
+                   META_NATIVE_CHROMATICITIES_FIRMWARE_DECLARED);
+  g_assert_cmpint (info->edid_info->native_luminance_status, ==, META_NATIVE_LUMINANCE_INVALID);
+  g_clear_pointer (&info, meta_output_info_unref);
+  info = parse (native, sizeof (native), NULL, 0, FALSE);
+  g_assert_cmpint (info->edid_info->native_chromaticities_status, ==,
+                   META_NATIVE_CHROMATICITIES_UNAVAILABLE);
+}
+
+static void
+set_raw_points (MetaEdidInfo   edid[1],
+                const uint16_t points[4][2])
+{
+  unsigned int i;
+
+  for (i = 0; i < 3; i++)
+    edid->native_chromaticities.primaries[i] =
+      (struct di_displayid2_chromaticity_point) { points[i][0], points[i][1], TRUE };
+  edid->native_chromaticities.white_point =
+    (struct di_displayid2_chromaticity_point) { points[3][0], points[3][1], TRUE };
+}
+
+static void
+test_target_primaries_policy (void)
+{
+  const uint16_t xy[4][2] = {
+    { 2816, 1280 }, { 1024, 2816 }, { 512, 256 }, { 1280, 1344 },
+  };
+  const uint16_t uv[4][2] = {
+    { 1024, 2304 }, { 512, 2304 }, { 719, 647 }, { 810, 1918 },
+  };
+  /* Raw white is strictly inside; published rounding puts it outside RG. */
+  const uint16_t quantized[4][2] = {
+    { 1, 1000 }, { 1501, 1001 }, { 1301, 1002 }, { 1500, 1001 },
+  };
+  MetaEdidInfo edid = { .native_chromaticities_status = META_NATIVE_CHROMATICITIES_FIRMWARE_DECLARED };
+  const ClutterPrimaries *encoding = clutter_colorspace_to_primaries (CLUTTER_COLORSPACE_BT2020);
+  MetaColorTargetPrimaries target, fallback;
+  unsigned int i;
+
+  set_raw_points (&edid, xy);
+  meta_color_target_primaries_init (&target, &edid, TRUE, encoding);
+  g_assert_cmpint (target.source, ==, META_COLOR_TARGET_FIRMWARE_DECLARED);
+  g_assert_cmpint (target.coordinates[0], ==, 687500);
+  g_assert_cmpint (target.coordinates[1], ==, 312500);
+  g_assert_cmpint (target.coordinates[6], ==, 312500);
+  g_assert_cmpint (target.coordinates[7], ==, 328125);
+  meta_color_target_primaries_init (&fallback, &edid, FALSE, encoding);
+  g_assert_cmpint (fallback.source, ==, META_COLOR_TARGET_ENCODING_FALLBACK);
+  g_assert_cmpint (fallback.coordinates[0], ==, 708000);
+  g_assert_cmpfloat (encoding->r_x, ==, 0.708f);
+
+  edid.native_chromaticities.coordinates = DI_DISPLAYID2_CHROMATICITY_CIE1976;
+  set_raw_points (&edid, uv);
+  meta_color_target_primaries_init (&target, &edid, TRUE, encoding);
+  g_assert_cmpint (target.source, ==, META_COLOR_TARGET_FIRMWARE_DECLARED);
+  g_assert_cmpint (target.coordinates[0], ==, 500000);
+  g_assert_cmpint (target.coordinates[1], ==, 500000);
+  set_raw_points (&edid, quantized);
+  meta_color_target_primaries_init (&target, &edid, TRUE, encoding);
+  g_assert_cmpint (target.source, ==, META_COLOR_TARGET_ENCODING_FALLBACK);
+
+  edid.native_chromaticities.coordinates = DI_DISPLAYID2_CHROMATICITY_CIE1931;
+  for (i = 0; i < 4; i++)
+    {
+      set_raw_points (&edid, xy);
+      if (i == 0) edid.native_chromaticities.primaries[1] = edid.native_chromaticities.primaries[0];
+      if (i == 1) edid.native_chromaticities.white_point = edid.native_chromaticities.primaries[0];
+      if (i == 2) edid.native_chromaticities.white_point.valid = FALSE;
+      if (i == 3) edid.native_chromaticities_status = META_NATIVE_CHROMATICITIES_CONFLICT;
+      meta_color_target_primaries_init (&target, &edid, TRUE, encoding);
+      g_assert_cmpint (target.source, ==, META_COLOR_TARGET_ENCODING_FALLBACK);
+      g_assert_cmpint (target.coordinates[6], ==, fallback.coordinates[6]);
+    }
+}
+
 int
 main (int    argc,
       char **argv)
@@ -640,5 +800,7 @@ main (int    argc,
                    test_cta_with_extension_failure);
   g_test_add_func ("/native-hdr/physical-luminance", test_physical_luminance);
   g_test_add_func ("/native-hdr/target-luminance-policy", test_target_luminance_policy);
+  g_test_add_func ("/native-hdr/physical-chromaticities", test_physical_chromaticities);
+  g_test_add_func ("/native-hdr/target-primaries-policy", test_target_primaries_policy);
   return g_test_run ();
 }
