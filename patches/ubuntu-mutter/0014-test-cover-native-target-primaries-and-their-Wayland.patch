+static void
+check_gamut (const TargetInfo *info,
+             const int32_t encoding[8],
+             const int32_t target[8])
+{
+  unsigned int i;
+
+  for (i = 0; i < 8; i++)
+    {
+      g_assert_cmpint (info->encoding_primaries[i], ==, encoding[i]);
+      g_assert_cmpint (info->target_primaries[i], ==, target[i]);
+    }
+}
+
+static void
+target_primaries_client (WaylandDisplay *display,
+                         int             version)
+{
+  const int32_t bt2020[8] = { 708000, 292000, 170000, 797000, 131000, 46000, 312700, 329000 };
+  const int32_t srgb[8] = { 640000, 330000, 300000, 600000, 150000, 60000, 312700, 329000 };
+  const int32_t initial[8] = { 687500, 312500, 250000, 687500, 125000, 62500, 312500, 328125 };
+  const int32_t changed[8] = { 687500, 312500, 250000, 687500, 125000, 62500, 312744, 328125 };
+  TargetClient client = { .version = version };
+  struct wl_registry *registry = wl_display_get_registry (display->display);
+  struct wl_surface *surface = wl_compositor_create_surface (display->compositor);
+  struct wp_color_management_surface_feedback_v1 *feedback;
+  TargetOutput *target = NULL, *other = NULL;
+  TargetSnapshot snapshots[11] = { 0 }, preferred = { 0 };
+  TargetSnapshot other_snapshot = { 0 }, current_other = { 0 };
+  TargetInfo info;
+  unsigned int i, phase;
+
+  wl_registry_add_listener (registry, &target_registry_listener, &client);
+  wl_display_roundtrip (display->display);
+  wl_display_roundtrip (display->display);
+  g_assert_nonnull (client.manager);
+  g_assert_cmpuint (client.n_outputs, ==, 2);
+  for (i = 0; i < client.n_outputs; i++)
+    {
+      TargetOutput *output = &client.outputs[i];
+
+      if (g_strcmp0 (output->name, lookup_property_string (display, "target-output")) == 0)
+        target = output;
+      else
+        other = output;
+      output->color_output = wp_color_manager_v1_get_output (client.manager, output->output);
+      wp_color_management_output_v1_add_listener (output->color_output, &target_color_output_listener, output);
+      output->done = 0;
+    }
+  g_assert_nonnull (target);
+  g_assert_nonnull (other);
+  other_snapshot.description = wp_color_management_output_v1_get_image_description (other->color_output);
+  wait_target_snapshot (display, &other_snapshot);
+  feedback = wp_color_manager_v1_get_surface_feedback (client.manager, surface);
+  wp_color_management_surface_feedback_v1_add_listener (feedback, &target_feedback_listener, &client);
+  wl_display_roundtrip (display->display);
+  g_assert_cmpuint (client.preferred_changes, ==, 1);
+  snapshots[0].description = wp_color_management_output_v1_get_image_description (target->color_output);
+  wait_target_snapshot (display, &snapshots[0]);
+  g_assert_cmpuint (client.preferred, ==, snapshots[0].identity);
+  info = read_target_info (display, &snapshots[0]);
+  check_gamut (&info, bt2020, initial);
+  g_assert_cmpuint (info.target_max, ==, 616);
+  client.preferred_changes = 0;
+
+  for (phase = 0; phase < 10; phase++)
+    {
+      gboolean topology = phase == 6 || phase == 7;
+      gboolean changes = phase != 1 && !topology;
+      const int32_t *expected = phase == 2 || phase == 4 || phase == 8 ? bt2020 : changed;
+
+      if (phase == 6)
+        {
+          current_other.description = wp_color_management_output_v1_get_image_description (other->color_output);
