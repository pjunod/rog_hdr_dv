From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude Agent <claude-agent@invalid>
Date: Sat, 10 Oct 2026 14:37:32 -0400
Subject: [PATCH 15/15] test: isolate target-volume cases in bounded
 subprocesses

The target-luminance v2 case disposes the shared Wayland colour manager to
exercise teardown with live description records, and every target-volume
case rewrites the fixture output's connector, capabilities, EDID, colour
mode, forced-HDR state and topology. Cases registered after it therefore
ran against a disposed manager and inherited mutated fixture state.

Run each target-volume case in its own bounded GLib test subprocess with a
fresh context, so no case observes another's fixture or manager lifetime.
---
 src/tests/wayland-color-management-test.c | 41 ++++++++++++++++++++---
 1 file changed, 37 insertions(+), 4 deletions(-)

diff --git a/src/tests/wayland-color-management-test.c b/src/tests/wayland-color-management-test.c
index a66efa6..09091c4 100644
--- a/src/tests/wayland-color-management-test.c
+++ b/src/tests/wayland-color-management-test.c
@@ -488,6 +488,39 @@ target_primaries (gconstpointer data)
   g_signal_emit_by_name (monitor_manager, "monitors-changing");
 }
 
+/* Target-volume cases mutate the fixture output (connector, capabilities, EDID,
+ * colour mode, forced HDR, topology) and the v2 cases dispose the shared
+ * Wayland colour manager to exercise teardown with live records. Each case
+ * therefore runs in a fresh, bounded test subprocess with its own context, so
+ * no case observes another case's fixture or manager lifetime. */
+static void
+run_isolated (gconstpointer data,
+              GTestDataFunc body)
+{
+  if (g_test_subprocess ())
+    {
+      body (data);
+      return;
+    }
+
+  g_test_trap_subprocess (NULL, 30 * G_USEC_PER_SEC,
+                          G_TEST_SUBPROCESS_INHERIT_STDOUT |
+                          G_TEST_SUBPROCESS_INHERIT_STDERR);
+  g_test_trap_assert_passed ();
+}
+
+static void
+isolated_target_luminance (gconstpointer data)
+{
+  run_isolated (data, target_luminance);
+}
+
+static void
+isolated_target_primaries (gconstpointer data)
+{
+  run_isolated (data, target_primaries);
+}
+
 static void
 on_before_tests (void)
 {
@@ -512,10 +545,10 @@ init_tests (void)
 {
   g_test_add_func ("/wayland/color-management",
                    color_management);
-  g_test_add_data_func ("/wayland/target-luminance/v1", GINT_TO_POINTER (1), target_luminance);
-  g_test_add_data_func ("/wayland/target-luminance/v2", GINT_TO_POINTER (2), target_luminance);
-  g_test_add_data_func ("/wayland/target-primaries/v1", GINT_TO_POINTER (1), target_primaries);
-  g_test_add_data_func ("/wayland/target-primaries/v2", GINT_TO_POINTER (2), target_primaries);
+  g_test_add_data_func ("/wayland/target-luminance/v1", GINT_TO_POINTER (1), isolated_target_luminance);
+  g_test_add_data_func ("/wayland/target-luminance/v2", GINT_TO_POINTER (2), isolated_target_luminance);
+  g_test_add_data_func ("/wayland/target-primaries/v1", GINT_TO_POINTER (1), isolated_target_primaries);
+  g_test_add_data_func ("/wayland/target-primaries/v2", GINT_TO_POINTER (2), isolated_target_primaries);
 }
 
 int
