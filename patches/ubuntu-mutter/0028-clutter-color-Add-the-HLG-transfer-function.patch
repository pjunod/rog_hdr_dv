+/*
+ * Computes the Rec. ITU-R BT.2100-2 HLG system gamma and black level lift for
+ * the nominal peak luminance @max_lum (Lw) and black level @min_lum (Lb),
+ * using the extended system gamma formula of Report ITU-R BT.2390 for every
+ * Lw:
+ *
+ *   gamma = 1.2 * 1.111^log2 (Lw / 1000)
+ *   beta = sqrt (3 * (Lb / Lw)^(1 / gamma))
+ *
+ * The black level lift maps black into the square-root segment of the
+ * inverse OETF, which holds only while beta <= 0.5; beyond it decoding would
+ * invert, and at beta = 1 encoding would divide by zero.
+ *
+ * Returns %FALSE, setting @error, unless the luminances are finite with
+ * 0 <= Lb < Lw and beta <= 0.5. Every HLG color state and every HLG pipeline
+ * is validated with this one definition.
+ */
+gboolean
+clutter_luminance_get_hlg_parameters (float    min_lum,
+                                      float    max_lum,
+                                      float   *gamma,
+                                      float   *beta,
+                                      GError **error)
+{
+  double system_gamma, black_lift;
+
+  if (!isfinite (min_lum) || !isfinite (max_lum) ||
+      !(min_lum >= 0.0f) || !(max_lum > min_lum))
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+                           "HLG luminances must be finite, with the minimum "
+                           "at least 0 and below the maximum");
+      return FALSE;
+    }
+
+  system_gamma = 1.2 * pow (1.111, log2 ((double) max_lum / 1000.0));
+  black_lift = sqrt (3.0 * pow ((double) min_lum / (double) max_lum,
+                                1.0 / system_gamma));
+
+  if (!isfinite (system_gamma) || !isfinite (black_lift) || black_lift > 0.5)
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+                           "The HLG black level is too high for the nominal "
+                           "peak luminance");
+      return FALSE;
+    }
+
+  if (gamma)
+    *gamma = (float) system_gamma;
+  if (beta)
+    *beta = (float) black_lift;
+
+  return TRUE;
+}
+
+/*
+ * Retrieves the luminance coefficients of linear RGB in @colorimetry: the Y
+ * row of its RGB to CIE XYZ matrix, in its own white point, so that they sum
+ * to 1. For BT.2020 they are 0.2627, 0.6780 and 0.0593.
+ *
+ * The colorimetry is accepted only if it is usable for rendering, by the same
+ * definition as clutter_colorimetry_get_linear_bt2020_matrices(); otherwise
+ * %FALSE is returned and @error is set.
+ */
+gboolean
+clutter_colorimetry_get_luminance_coefficients (const ClutterColorimetry  *colorimetry,
+                                                float                      coefficients[3],
+                                                GError                   **error)
+{
+  graphene_matrix_t to_XYZ;
+  int i;
+
+  if (!clutter_colorimetry_get_linear_bt2020_matrices (colorimetry,
+                                                       NULL, NULL,
+                                                       error) ||
+      !colorimetry_to_XYZ_checked (colorimetry, &to_XYZ, error))
+    return FALSE;
+
+  /* Row i of the matrix is the XYZ of primary i at full intensity. */
+  for (i = 0; i < 3; i++)
+    coefficients[i] = graphene_matrix_get_value (&to_XYZ, i, 1);
+
+  return TRUE;
+}
