+
+#pragma once
+
+#include "clutter/clutter-color-op.h"
+
+/*
+ * Color operations that act on the whole RGB vector rather than per channel.
+ * They are built only by ClutterColorTransform and are not part of the
+ * installed API.
+ */
+
+/*
+ * The Rec. ITU-R BT.2100-2 hybrid log-gamma EOTF: black level lift, inverse
+ * OETF to scene light, then the OOTF. The OOTF scales each sample by a power
+ * of its luminance, so it needs the luminance coefficients of the primaries
+ * the samples are in, and it runs before any primaries matrix. The result is
+ * display light normalized to the nominal peak luminance.
+ */
+#define CLUTTER_TYPE_COLOR_OP_HLG_EOTF (clutter_color_op_hlg_eotf_get_type ())
+G_DECLARE_FINAL_TYPE (ClutterColorOpHlgEotf,
+                      clutter_color_op_hlg_eotf,
+                      CLUTTER, COLOR_OP_HLG_EOTF,
+                      ClutterColorOp)
+
+ClutterColorOp * clutter_color_op_hlg_eotf_new (float       gamma,
+                                                float       beta,
+                                                const float coefficients[3]);
+
+/* The exact inverse of ClutterColorOpHlgEotf; out of range values clip. */
+#define CLUTTER_TYPE_COLOR_OP_HLG_INV_EOTF (clutter_color_op_hlg_inv_eotf_get_type ())
+G_DECLARE_FINAL_TYPE (ClutterColorOpHlgInvEotf,
+                      clutter_color_op_hlg_inv_eotf,
+                      CLUTTER, COLOR_OP_HLG_INV_EOTF,
+                      ClutterColorOp)
+
+ClutterColorOp * clutter_color_op_hlg_inv_eotf_new (float       gamma,
+                                                    float       beta,
+                                                    const float coefficients[3]);
+
+void clutter_color_op_hlg_get_parameters (ClutterColorOp *op,
+                                          float          *gamma,
+                                          float          *beta,
+                                          const float   **coefficients);
diff --git a/clutter/clutter/clutter-color-op.c b/clutter/clutter/clutter-color-op.c
index 2a11736..3f17042 100644
--- a/clutter/clutter/clutter-color-op.c
+++ b/clutter/clutter/clutter-color-op.c
@@ -22,6 +22,7 @@
 #include "config.h"
 
 #include "clutter-color-op.h"
+#include "clutter-color-op-private.h"
 
 #include <math.h>
 
@@ -537,6 +538,237 @@ clutter_color_op_pq_inv_eotf_new (void)
   return g_object_new (CLUTTER_TYPE_COLOR_OP_PQ_INV_EOTF, NULL);
 }
 
+/* Rec. ITU-R BT.2100-2, Table 5: HLG OETF constants. */
+#define HLG_A 0.17883277f
+#define HLG_B 0.28466892f /* 1 - 4a */
+#define HLG_C 0.55991073f /* 0.5 - a ln (4a) */
+
+typedef struct _HlgParameters
+{
+  float gamma;
+  float beta;
+  float coefficients[3];
+} HlgParameters;
+
+static float
+hlg_inv_oetf (float signal)
+{
+  if (signal <= 0.5f)
+    return signal * signal / 3.0f;
+  else
+    return (expf ((signal - HLG_C) / HLG_A) + HLG_B) / 12.0f;
+}
+
+static float
+hlg_oetf (float scene)
+{
+  if (scene <= 1.0f / 12.0f)
+    return sqrtf (3.0f * scene);
+  else
+    return HLG_A * logf (12.0f * scene - HLG_B) + HLG_C;
+}
+
+static char *
+hlg_parameters_to_string (const char          *name,
+                          const HlgParameters *parameters)
+{
+  char gamma_str[G_ASCII_DTOSTR_BUF_SIZE];
+  char beta_str[G_ASCII_DTOSTR_BUF_SIZE];
+
+  g_ascii_formatd (gamma_str, sizeof (gamma_str), "%.4f", parameters->gamma);
+  g_ascii_formatd (beta_str, sizeof (beta_str), "%.4f", parameters->beta);
+
+  return g_strdup_printf ("%s(gamma %s, beta %s)", name, gamma_str, beta_str);
+}
+
+struct _ClutterColorOpHlgEotf
+{
+  ClutterColorOp parent;
+
+  HlgParameters parameters;
+};
+
+G_DEFINE_FINAL_TYPE (ClutterColorOpHlgEotf, clutter_color_op_hlg_eotf,
+                     CLUTTER_TYPE_COLOR_OP)
+
+static void
+clutter_color_op_hlg_eotf_do_transform (ClutterColorOp *op,
+                                        float          *data,
+                                        size_t          n_samples)
+{
+  const HlgParameters *parameters = &CLUTTER_COLOR_OP_HLG_EOTF (op)->parameters;
+
+  for (size_t i = 0; i < n_samples; i++)
+    {
+      float scene[3];
+      float luminance = 0.0f;
+      float scale = 0.0f;
+      int c;
+
+      for (c = 0; c < 3; c++)
+        {
+          float signal;
+
+          signal = MAX (0.0f,
+                        (1.0f - parameters->beta) * data[c] + parameters->beta);
+          scene[c] = hlg_inv_oetf (signal);
+          luminance += parameters->coefficients[c] * scene[c];
+        }
+
+      /* OOTF: F = Ys^(gamma - 1) E, normalized to the nominal peak. */
+      if (luminance > 0.0f)
+        scale = powf (luminance, parameters->gamma - 1.0f);
+
+      for (c = 0; c < 3; c++)
+        data[c] = scene[c] * scale;
+
+      data += 4;
+    }
+}
+
+static char *
+clutter_color_op_hlg_eotf_to_string (ClutterColorOp *op)
+{
+  return hlg_parameters_to_string ("hlg_eotf",
+                                   &CLUTTER_COLOR_OP_HLG_EOTF (op)->parameters);
+}
+
+static void
+clutter_color_op_hlg_eotf_class_init (ClutterColorOpHlgEotfClass *klass)
+{
+  ClutterColorOpClass *op_class = CLUTTER_COLOR_OP_CLASS (klass);
+
+  op_class->to_string = clutter_color_op_hlg_eotf_to_string;
+  op_class->do_transform = clutter_color_op_hlg_eotf_do_transform;
+}
+
+static void
+clutter_color_op_hlg_eotf_init (ClutterColorOpHlgEotf *op)
+{
+}
+
+ClutterColorOp *
+clutter_color_op_hlg_eotf_new (float       gamma,
+                               float       beta,
+                               const float coefficients[3])
+{
+  ClutterColorOpHlgEotf *op;
+
+  op = g_object_new (CLUTTER_TYPE_COLOR_OP_HLG_EOTF, NULL);
+  op->parameters = (HlgParameters) {
+    .gamma = gamma,
+    .beta = beta,
+    .coefficients = { coefficients[0], coefficients[1], coefficients[2] },
+  };
+
+  return CLUTTER_COLOR_OP (op);
+}
+
+struct _ClutterColorOpHlgInvEotf
+{
+  ClutterColorOp parent;
+
+  HlgParameters parameters;
+};
+
+G_DEFINE_FINAL_TYPE (ClutterColorOpHlgInvEotf, clutter_color_op_hlg_inv_eotf,
+                     CLUTTER_TYPE_COLOR_OP)
+
+static void
+clutter_color_op_hlg_inv_eotf_do_transform (ClutterColorOp *op,
+                                            float          *data,
+                                            size_t          n_samples)
+{
+  const HlgParameters *parameters =
+    &CLUTTER_COLOR_OP_HLG_INV_EOTF (op)->parameters;
+
+  for (size_t i = 0; i < n_samples; i++)
+    {
+      float luminance = 0.0f;
+      float scale = 0.0f;
+      int c;
+
+      for (c = 0; c < 3; c++)
+        luminance += parameters->coefficients[c] * data[c];
+
+      /* Inverse OOTF: Ys = Yd^(1 / gamma), E = F Ys^(1 - gamma). */
+      if (luminance > 0.0f)
+        scale = powf (luminance,
+                      (1.0f - parameters->gamma) / parameters->gamma);
+
+      for (c = 0; c < 3; c++)
+        {
+          float scene, signal;
+
+          scene = CLAMP (data[c] * scale, 0.0f, 1.0f);
+          signal = hlg_oetf (scene);
+          data[c] = CLAMP ((signal - parameters->beta) /
+                           (1.0f - parameters->beta),
+                           0.0f, 1.0f);
+        }
+
+      data += 4;
+    }
+}
+
+static char *
+clutter_color_op_hlg_inv_eotf_to_string (ClutterColorOp *op)
+{
+  return hlg_parameters_to_string ("hlg_inv_eotf",
+                                   &CLUTTER_COLOR_OP_HLG_INV_EOTF (op)->parameters);
+}
+
+static void
+clutter_color_op_hlg_inv_eotf_class_init (ClutterColorOpHlgInvEotfClass *klass)
+{
+  ClutterColorOpClass *op_class = CLUTTER_COLOR_OP_CLASS (klass);
+
+  op_class->to_string = clutter_color_op_hlg_inv_eotf_to_string;
+  op_class->do_transform = clutter_color_op_hlg_inv_eotf_do_transform;
+}
+
+static void
+clutter_color_op_hlg_inv_eotf_init (ClutterColorOpHlgInvEotf *op)
+{
+}
+
+ClutterColorOp *
+clutter_color_op_hlg_inv_eotf_new (float       gamma,
+                                   float       beta,
+                                   const float coefficients[3])
+{
+  ClutterColorOpHlgInvEotf *op;
+
+  op = g_object_new (CLUTTER_TYPE_COLOR_OP_HLG_INV_EOTF, NULL);
+  op->parameters = (HlgParameters) {
+    .gamma = gamma,
+    .beta = beta,
+    .coefficients = { coefficients[0], coefficients[1], coefficients[2] },
+  };
+
+  return CLUTTER_COLOR_OP (op);
+}
+
+void
+clutter_color_op_hlg_get_parameters (ClutterColorOp *op,
+                                     float          *gamma,
+                                     float          *beta,
+                                     const float   **coefficients)
+{
+  const HlgParameters *parameters;
+
+  if (CLUTTER_IS_COLOR_OP_HLG_EOTF (op))
+    parameters = &CLUTTER_COLOR_OP_HLG_EOTF (op)->parameters;
+  else if (CLUTTER_IS_COLOR_OP_HLG_INV_EOTF (op))
+    parameters = &CLUTTER_COLOR_OP_HLG_INV_EOTF (op)->parameters;
+  else
+    g_assert_not_reached ();
+
+  *gamma = parameters->gamma;
+  *beta = parameters->beta;
+  *coefficients = parameters->coefficients;
+}
+
 typedef struct _ClutterColorOp3DLutPrivate
 {
   uint32_t size;
diff --git a/clutter/clutter/clutter-color-pipeline-shader.c b/clutter/clutter/clutter-color-pipeline-shader.c
index f5eddb2..306b01b 100644
--- a/clutter/clutter/clutter-color-pipeline-shader.c
+++ b/clutter/clutter/clutter-color-pipeline-shader.c
@@ -27,6 +27,7 @@
 
 #include "clutter/clutter-backend-private.h"
 #include "clutter/clutter-color-op.h"
+#include "clutter/clutter-color-op-private.h"
 #include "clutter/clutter-color-pipeline.h"
 #include "clutter/clutter-color-transform-private.h"
 #include "clutter/clutter-main.h"
@@ -213,6 +214,49 @@ static const char pq_inv_eotf_source[] =
   "  return pow (num / den, vec3 (m2));\n"
   "}\n";
 
+/* Rec. ITU-R BT.2100-2 HLG; must match ClutterColorOpHlgEotf. */
+static const char hlg_eotf_source[] =
+  "vec3 hlg_eotf (vec3 color, float gamma, float beta, vec3 coefficients)\n"
+  "{\n"
+  "  const float a = 0.17883277;\n"
+  "  const float b = 0.28466892;\n"
+  "  const float c = 0.55991073;\n"
+  "\n"
+  "  vec3 signal = max ((1.0 - beta) * color + beta, vec3 (0.0));\n"
+  "  vec3 lo_part = signal * signal / 3.0;\n"
+  "  vec3 hi_part = (exp ((signal - c) / a) + b) / 12.0;\n"
+  "  vec3 is_low = vec3 (lessThanEqual (signal, vec3 (0.5)));\n"
+  "  vec3 scene = mix (hi_part, lo_part, is_low);\n"
+  "  float luminance = dot (coefficients, scene);\n"
+  "\n"
+  "  if (luminance > 0.0)\n"
+  "    return scene * pow (luminance, gamma - 1.0);\n"
+  "  return vec3 (0.0);\n"
+  "}\n";
+
+/* The exact inverse of hlg_eotf; must match ClutterColorOpHlgInvEotf. */
+static const char hlg_inv_eotf_source[] =
+  "vec3 hlg_inv_eotf (vec3 color, float gamma, float beta, vec3 coefficients)\n"
+  "{\n"
+  "  const float a = 0.17883277;\n"
+  "  const float b = 0.28466892;\n"
+  "  const float c = 0.55991073;\n"
+  "\n"
+  "  float luminance = dot (coefficients, color);\n"
+  "  vec3 scene = vec3 (0.0);\n"
+  "\n"
+  "  if (luminance > 0.0)\n"
+  "    scene = clamp (color * pow (luminance, (1.0 - gamma) / gamma),\n"
+  "                   0.0, 1.0);\n"
+  "\n"
+  "  vec3 lo_part = sqrt (3.0 * scene);\n"
+  "  /* Keep the unused branch finite below 1/12. */\n"
+  "  vec3 hi_part = a * log (max (12.0 * scene - b, vec3 (1.0 - b))) + c;\n"
+  "  vec3 is_low = vec3 (lessThanEqual (scene, vec3 (1.0 / 12.0)));\n"
+  "  vec3 signal = mix (hi_part, lo_part, is_low);\n"
+  "  return clamp ((signal - beta) / (1.0 - beta), 0.0, 1.0);\n"
+  "}\n";
+
 static const char lut_3d_source[] =
   "// Tetrahedral interpolation\n"
   "vec3 sample_3d_lut_SIZE (vec3 color, sampler2D lut_texture, float lut_size)\n"
@@ -653,6 +697,71 @@ update_multiply_state (ClutterColorOp *op,
   cogl_pipeline_set_uniform_1f (pipeline, uniform_location, value);
 }
 
+static char *
+get_hlg_declarations (ClutterColorOp *op,
+                      size_t          op_id)
+{
+  return g_strdup_printf ("uniform float hlg_gamma_%zu;\n"
+                          "uniform float hlg_beta_%zu;\n"
+                          "uniform vec3 hlg_coefficients_%zu;\n",
+                          op_id, op_id, op_id);
+}
+
+static char *
+get_hlg_eotf_invocation (ClutterColorOp *op,
+                         size_t          op_id)
+{
+  return g_strdup_printf ("vec4 (hlg_eotf (color.rgb, hlg_gamma_%zu, "
+                          "hlg_beta_%zu, hlg_coefficients_%zu), color.a)",
+                          op_id, op_id, op_id);
+}
+
+static char *
+get_hlg_inv_eotf_invocation (ClutterColorOp *op,
+                             size_t          op_id)
+{
+  return g_strdup_printf ("vec4 (hlg_inv_eotf (color.rgb, hlg_gamma_%zu, "
+                          "hlg_beta_%zu, hlg_coefficients_%zu), color.a)",
+                          op_id, op_id, op_id);
+}
+
+static void
+set_uniform_1f (CoglPipeline *pipeline,
+                const char   *name,
+                size_t        op_id,
+                float         value)
+{
+  g_autofree char *uniform_name = NULL;
+  int uniform_location;
+
+  uniform_name = g_strdup_printf ("%s_%zu", name, op_id);
+  uniform_location = cogl_pipeline_get_uniform_location (pipeline,
+                                                         uniform_name);
+  cogl_pipeline_set_uniform_1f (pipeline, uniform_location, value);
+}
+
+static void
+update_hlg_state (ClutterColorOp *op,
+                  size_t          op_id,
+                  CoglPipeline   *pipeline)
+{
+  g_autofree char *uniform_name = NULL;
+  const float *coefficients;
+  float gamma, beta;
+  int uniform_location;
+
+  clutter_color_op_hlg_get_parameters (op, &gamma, &beta, &coefficients);
+
+  set_uniform_1f (pipeline, "hlg_gamma", op_id, gamma);
+  set_uniform_1f (pipeline, "hlg_beta", op_id, beta);
+
+  uniform_name = g_strdup_printf ("hlg_coefficients_%zu", op_id);
+  uniform_location = cogl_pipeline_get_uniform_location (pipeline,
+                                                         uniform_name);
+  cogl_pipeline_set_uniform_float (pipeline, uniform_location,
+                                   3, 1, coefficients);
+}
+
 typedef struct _ShaderOpInfo
 {
   GType (*get_type) (void);
@@ -693,6 +802,20 @@ static const ShaderOpInfo shader_op_infos[] = {
     .shader_source = pq_inv_eotf_source,
     .invocation = "vec4 (pq_inv_eotf (color.rgb), color.a)",
   },
+  {
+    .get_type = clutter_color_op_hlg_eotf_get_type,
+    .shader_source = hlg_eotf_source,
+    .get_declarations = get_hlg_declarations,
+    .get_invocation = get_hlg_eotf_invocation,
+    .update_state = update_hlg_state,
+  },
+  {
+    .get_type = clutter_color_op_hlg_inv_eotf_get_type,
+    .shader_source = hlg_inv_eotf_source,
+    .get_declarations = get_hlg_declarations,
+    .get_invocation = get_hlg_inv_eotf_invocation,
+    .update_state = update_hlg_state,
+  },
   {
     .get_type = clutter_color_op_unpremultiply_get_type,
     .shader_source = unpremultiply_source,
