+  if (target_volume->max_cll > 0.0f)
+    g_string_append_printf (string, ", max cll: %f", target_volume->max_cll);
+  if (target_volume->max_fall > 0.0f)
+    g_string_append_printf (string, ", max fall: %f", target_volume->max_fall);
+
+  g_string_append (string, ")");
 
+  return g_string_free_and_steal (g_steal_pointer (&string));
 }
 
 static ClutterEncodingRequiredFormat
@@ -258,6 +443,20 @@ clutter_color_state_params_get_blending (ClutterColorState *color_state,
                                                          blending_luminance);
 }
 
+static guint
+float_hash (float value)
+{
+  uint32_t bits;
+
+  /* 0.0 and -0.0 compare equal. */
+  if (value == 0.0f)
+    return 0;
+
+  memcpy (&bits, &value, sizeof (bits));
+
+  return bits;
+}
+
 static guint
 clutter_color_state_params_hash (ClutterColorState *color_state)
 {
@@ -272,6 +471,14 @@ clutter_color_state_params_hash (ClutterColorState *color_state)
   if (params->eotf.type == CLUTTER_EOTF_TYPE_NAMED)
     hash = hash * 31 + params->eotf.tf_name;
 
+  /* Target volumes compare exactly, so their values can be hashed. */
+  hash = hash * 31 + params->target_volume.has_primaries;
+  hash = hash * 31 + params->target_volume.has_luminance;
+  if (params->target_volume.has_luminance)
+    hash = hash * 31 + float_hash (params->target_volume.max_lum);
+  hash = hash * 31 + float_hash (params->target_volume.max_cll);
+  hash = hash * 31 + float_hash (params->target_volume.max_fall);
+
   return hash;
 }
 
@@ -453,6 +660,45 @@ clutter_color_state_params_new_from_primitives (ClutterContext     *context,
                                               luminance.mastering_max);
 }
 
+/*
+ * clutter_color_state_params_new_with_target_volume:
+ * @color_state_params: the color state to copy
+ * @target_volume: the target color volume, in the units of the luminance of
+ *   @color_state_params
+ *
+ * Creates a copy of @color_state_params whose target color volume is
+ * @target_volume. The caller validates the target volume.
+ *
+ * Returns: (transfer full): a new ClutterColorState
+ */
+ClutterColorState *
+clutter_color_state_params_new_with_target_volume (ClutterColorStateParams        *color_state_params,
+                                                   const ClutterColorTargetVolume *target_volume)
+{
+  ClutterColorState *color_state = CLUTTER_COLOR_STATE (color_state_params);
+  ClutterColorStateParams *copy;
+
+  g_return_val_if_fail (CLUTTER_IS_COLOR_STATE_PARAMS (color_state_params),
+                        NULL);
+  g_return_val_if_fail (target_volume != NULL, NULL);
+
+  copy = g_object_new (CLUTTER_TYPE_COLOR_STATE_PARAMS,
+                       "context", clutter_color_state_get_context (color_state),
+                       NULL);
+  copy->colorimetry = color_state_params->colorimetry;
+  if (copy->colorimetry.type == CLUTTER_COLORIMETRY_TYPE_PRIMARIES)
+    {
+      copy->colorimetry.primaries =
+        g_memdup2 (color_state_params->colorimetry.primaries,
+                   sizeof (ClutterPrimaries));
+    }
+  copy->eotf = color_state_params->eotf;
+  copy->luminance = color_state_params->luminance;
+  copy->target_volume = *target_volume;
+
+  return CLUTTER_COLOR_STATE (copy);
+}
+
 static gboolean
 cicp_primaries_to_clutter (ClutterCicpPrimaries   primaries,
                            ClutterColorimetry    *colorimetry,
