   lum = clutter_color_state_params_get_luminance (color_state_params);
 
-  return g_strdup_printf ("ClutterColorState %" G_GUINT64_FORMAT " "
+  string = g_string_new (NULL);
+  g_string_append_printf (string,
+                          "ClutterColorState %" G_GUINT64_FORMAT " "
                           "(primaries: %s, transfer function: %s, "
                           "min lum: %f, max lum: %f, ref lum: %f, "
-                          "mastering max lum: %f)",
+                          "mastering max lum: %f",
                           id,
                           primaries_name,
                           transfer_function_name,
@@ -162,7 +321,33 @@ clutter_color_state_params_to_string (ClutterColorState *color_state)
                           lum->ref,
                           lum->mastering_max);
 
+  if (target_volume->has_primaries)
+    {
+      const ClutterPrimaries *primaries = &target_volume->primaries;
+
+      g_string_append_printf (string,
+                              ", target primaries: [R: %f, %f G: %f, %f "
+                              "B: %f, %f W: %f, %f]",
+                              primaries->r_x, primaries->r_y,
+                              primaries->g_x, primaries->g_y,
+                              primaries->b_x, primaries->b_y,
