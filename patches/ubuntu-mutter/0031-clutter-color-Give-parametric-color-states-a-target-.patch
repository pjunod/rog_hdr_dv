@@ -135,12 +216,88 @@ clutter_color_state_params_equals (ClutterColorState *color_state,
   return clutter_luminance_equal (lum, target_lum);
 }
 
+/*
+ * Target volumes are compared exactly: they are declared values, not derived
+ * ones, and a different declaration is a different image description.
+ */
+static gboolean
+target_volume_equal (const ClutterColorTargetVolume *target_volume,
+                     const ClutterColorTargetVolume *other_target_volume)
+{
+  const ClutterPrimaries *primaries = &target_volume->primaries;
+  const ClutterPrimaries *other_primaries = &other_target_volume->primaries;
+
+  if (target_volume->has_primaries != other_target_volume->has_primaries ||
+      target_volume->has_luminance != other_target_volume->has_luminance ||
+      target_volume->max_cll != other_target_volume->max_cll ||
+      target_volume->max_fall != other_target_volume->max_fall)
+    return FALSE;
+
+  if (target_volume->has_primaries &&
+      (primaries->r_x != other_primaries->r_x ||
+       primaries->r_y != other_primaries->r_y ||
+       primaries->g_x != other_primaries->g_x ||
+       primaries->g_y != other_primaries->g_y ||
+       primaries->b_x != other_primaries->b_x ||
+       primaries->b_y != other_primaries->b_y ||
+       primaries->w_x != other_primaries->w_x ||
+       primaries->w_y != other_primaries->w_y))
+    return FALSE;
+
+  if (target_volume->has_luminance &&
+      (target_volume->min_lum != other_target_volume->min_lum ||
+       target_volume->max_lum != other_target_volume->max_lum))
+    return FALSE;
+
+  return TRUE;
+}
+
+static gboolean
+clutter_color_state_params_equals (ClutterColorState *color_state,
+                                   ClutterColorState *other_color_state)
+{
+  ClutterColorStateParams *color_state_params =
+    CLUTTER_COLOR_STATE_PARAMS (color_state);
+  ClutterColorStateParams *other_color_state_params =
+    CLUTTER_COLOR_STATE_PARAMS (other_color_state);
+
+  return clutter_color_state_params_encoding_equals (color_state_params,
+                                                     other_color_state_params) &&
+         target_volume_equal (&color_state_params->target_volume,
+                              &other_color_state_params->target_volume);
+}
+
+/*
+ * clutter_color_state_encoding_equals:
+ *
+ * Like clutter_color_state_equals(), but ignores the target color volume of
+ * parametric color states: whether the two states encode pixels the same
+ * way, so that converting between them needs no operation.
+ */
+gboolean
+clutter_color_state_encoding_equals (ClutterColorState *color_state,
+                                     ClutterColorState *other_color_state)
+{
+  if (CLUTTER_IS_COLOR_STATE_PARAMS (color_state) &&
+      CLUTTER_IS_COLOR_STATE_PARAMS (other_color_state))
+    {
+      return clutter_color_state_params_encoding_equals (
+        CLUTTER_COLOR_STATE_PARAMS (color_state),
+        CLUTTER_COLOR_STATE_PARAMS (other_color_state));
+    }
+
+  return clutter_color_state_equals (color_state, other_color_state);
+}
