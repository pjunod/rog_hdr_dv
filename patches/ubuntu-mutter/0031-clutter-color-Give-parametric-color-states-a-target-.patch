+/*
+ * clutter_color_state_params_get_target_volume:
+ *
+ * Returns: (transfer none): the target color volume declared for the
+ *   content, whose undeclared parts are absent.
+ */
+const ClutterColorTargetVolume *
+clutter_color_state_params_get_target_volume (ClutterColorStateParams *color_state_params)
+{
+  g_return_val_if_fail (CLUTTER_IS_COLOR_STATE_PARAMS (color_state_params),
+                        NULL);
+
+  return &color_state_params->target_volume;
+}
+
+/*
+ * Whether the encoding's signal range bounds the light the content can
+ * reach. Extended-range linear encodings (ext_linear, scRGB-style content)
+ * give meaning to values above 1.0, so their nominal maximum does not.
+ */
+static gboolean
+encoding_bounds_peak (ClutterColorStateParams *color_state_params)
+{
+  const ClutterEOTF *eotf = &color_state_params->eotf;
+
+  return !(eotf->type == CLUTTER_EOTF_TYPE_NAMED &&
+           eotf->tf_name == CLUTTER_TRANSFER_FUNCTION_LINEAR);
+}
+
+/*
+ * clutter_color_state_params_get_peak_headroom:
+ * @min_headroom: (out) (optional): the lowest luminance of the range
+ * @peak_headroom: (out) (optional): the effective peak luminance
+ *
+ * The range of the content as multiples of its reference white luminance,
+ * which every conversion anchors. The effective peak is the smallest of the
+ * declared maximum content light level, the declared target (mastering)
+ * maximum luminance and, for an encoding whose signal range bounds it, the
+ * encoding's own maximum. MaxFALL, an average, never lowers it.
+ *
+ * Returns: %FALSE if the effective peak is unknown: an extended-range
+ *   encoding with neither MaxCLL nor a target maximum declared.
+ */
+gboolean
+clutter_color_state_params_get_peak_headroom (ClutterColorStateParams *color_state_params,
+                                              double                  *min_headroom,
+                                              double                  *peak_headroom)
+{
+  const ClutterColorTargetVolume *target_volume;
+  const ClutterLuminance *lum;
+  double ref;
+  double peak = INFINITY;
+
+  g_return_val_if_fail (CLUTTER_IS_COLOR_STATE_PARAMS (color_state_params),
+                        FALSE);
+
+  target_volume = &color_state_params->target_volume;
+  lum = clutter_color_state_params_get_luminance (color_state_params);
+  ref = lum->ref;
+
+  /* Extended range states can exceed their nominal maximum. */
+  if (encoding_bounds_peak (color_state_params))
+    peak = MAX (lum->max, lum->mastering_max) / ref;
+  if (target_volume->has_luminance)
+    peak = MIN (peak, target_volume->max_lum / ref);
+  if (target_volume->max_cll > 0.0f)
+    peak = MIN (peak, target_volume->max_cll / ref);
+
+  if (min_headroom)
+    {
+      *min_headroom = target_volume->has_luminance ?
+                      target_volume->min_lum / ref :
+                      lum->min / ref;
+    }
+  if (peak_headroom)
+    *peak_headroom = peak;
+
+  return isfinite (peak);
+}
