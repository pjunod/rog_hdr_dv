+#pragma once
+
+#include "clutter/clutter-color-state-params.h"
+
+/*
+ * The target color volume of a parametric color state: the color volume its
+ * content was prepared for, as opposed to the encoding's primary color
+ * volume. For client content these are the mastering display primaries and
+ * luminance range and the maximum content and frame-average light levels of
+ * wp_image_description_creator_params_v1 (SMPTE ST 2086, CTA-861-H).
+ *
+ * Luminances are in the units of the state's own ClutterLuminance. A value
+ * that was not declared is absent: has_primaries and has_luminance are FALSE,
+ * and max_cll and max_fall are 0.
+ *
+ * Not part of the installed API.
+ */
+typedef struct _ClutterColorTargetVolume
+{
+  gboolean has_primaries;
+  ClutterPrimaries primaries;
+
+  gboolean has_luminance;
+  float min_lum;
+  float max_lum;
+
+  float max_cll;
+  float max_fall;
+} ClutterColorTargetVolume;
+
+/* Exported for libmutter, which creates color states from client input. */
+CLUTTER_EXPORT
+ClutterColorState * clutter_color_state_params_new_with_target_volume (ClutterColorStateParams        *color_state_params,
+                                                                       const ClutterColorTargetVolume *target_volume);
+
+CLUTTER_EXPORT
+const ClutterColorTargetVolume * clutter_color_state_params_get_target_volume (ClutterColorStateParams *color_state_params);
+
+CLUTTER_EXPORT
+gboolean clutter_color_state_params_get_peak_headroom (ClutterColorStateParams *color_state_params,
+                                                       double                  *min_headroom,
+                                                       double                  *peak_headroom);
+
+gboolean clutter_color_state_encoding_equals (ClutterColorState *color_state,
+                                              ClutterColorState *other_color_state);
