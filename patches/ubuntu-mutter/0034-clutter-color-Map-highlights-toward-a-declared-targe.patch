-  double ref;
+  double display_ref;
   double peak = INFINITY;
 
   g_return_val_if_fail (CLUTTER_IS_COLOR_STATE_PARAMS (color_state_params),
@@ -156,21 +165,22 @@ clutter_color_state_params_get_peak_headroom (ClutterColorStateParams *color_sta
 
   target_volume = &color_state_params->target_volume;
   lum = clutter_color_state_params_get_luminance (color_state_params);
-  ref = lum->ref;
+  display_ref =
+    clutter_color_state_params_get_display_reference_luminance (color_state_params);
 
   /* Extended range states can exceed their nominal maximum. */
   if (encoding_bounds_peak (color_state_params))
-    peak = MAX (lum->max, lum->mastering_max) / ref;
+    peak = (double) MAX (lum->max, lum->mastering_max) / lum->ref;
   if (target_volume->has_luminance)
