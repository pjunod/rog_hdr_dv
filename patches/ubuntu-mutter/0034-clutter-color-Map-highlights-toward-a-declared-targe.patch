diff --git a/clutter/clutter/clutter-color-op-private.h b/clutter/clutter/clutter-color-op-private.h
index 097318b..a78ef3e 100644
--- a/clutter/clutter/clutter-color-op-private.h
+++ b/clutter/clutter/clutter-color-op-private.h
@@ -59,3 +59,38 @@ void clutter_color_op_hlg_get_parameters (ClutterColorOp *op,
                                           float          *gamma,
                                           float          *beta,
                                           const float   **coefficients);
+
+/*
+ * The Report ITU-R BT.2390 EETF highlight compression, applied to
+ * max (R, G, B) with all channels scaled by the same ratio, so hue and
+ * saturation ratios are kept and negative components stay negative. Samples
+ * whose largest component is not positive are left unchanged, without any
+ * division.
+ *
+ * Only highlights are compressed: the BT.2390 black level lift is not
+ * applied (b = 0), so black is never raised and near-black samples are not
+ * scaled up.
+ *
+ * @scale converts a sample component to absolute luminance in cd/m². The
+ * curve parameters are those of BT.2390, in the PQ domain: the source range
+ * starts at @source_min and spans @source_range PQ code values, @knee_start is
+ * KS and @max_lum is maxLum, in the normalized source range.
+ */
+#define CLUTTER_TYPE_COLOR_OP_BT2390_EETF (clutter_color_op_bt2390_eetf_get_type ())
+G_DECLARE_FINAL_TYPE (ClutterColorOpBt2390Eetf,
+                      clutter_color_op_bt2390_eetf,
+                      CLUTTER, COLOR_OP_BT2390_EETF,
+                      ClutterColorOp)
+
+typedef struct _ClutterBt2390EetfParameters
+{
+  float scale;
+  float source_min;
+  float source_range;
+  float knee_start;
+  float max_lum;
+} ClutterBt2390EetfParameters;
+
+ClutterColorOp * clutter_color_op_bt2390_eetf_new (const ClutterBt2390EetfParameters *parameters);
+
+const ClutterBt2390EetfParameters * clutter_color_op_bt2390_eetf_get_parameters (ClutterColorOp *op);
diff --git a/clutter/clutter/clutter-color-op.c b/clutter/clutter/clutter-color-op.c
index 3f17042..6616e15 100644
--- a/clutter/clutter/clutter-color-op.c
+++ b/clutter/clutter/clutter-color-op.c
@@ -769,6 +769,136 @@ clutter_color_op_hlg_get_parameters (ClutterColorOp *op,
   *coefficients = parameters->coefficients;
 }
 
+/* SMPTE ST 2084 constants, exact. */
+#define PQ_M1 (2610.0f / 16384.0f)
+#define PQ_M2 (2523.0f / 4096.0f * 128.0f)
+#define PQ_C1 (3424.0f / 4096.0f)
+#define PQ_C2 (2413.0f / 4096.0f * 32.0f)
+#define PQ_C3 (2392.0f / 4096.0f * 32.0f)
+
+/* Absolute luminance in cd/m² to a PQ code value; defined above 10000. */
+static float
+pq_signal_from_luminance (float luminance)
+{
+  float p = powf (MAX (luminance, 0.0f) / 10000.0f, PQ_M1);
+
+  return powf ((PQ_C1 + PQ_C2 * p) / (1.0f + PQ_C3 * p), PQ_M2);
+}
+
+static float
+pq_luminance_from_signal (float signal)
+{
+  float p = powf (MAX (signal, 0.0f), 1.0f / PQ_M2);
+
+  return 10000.0f * powf (MAX (p - PQ_C1, 0.0f) / (PQ_C2 - PQ_C3 * p),
+                          1.0f / PQ_M1);
+}
+
+struct _ClutterColorOpBt2390Eetf
+{
+  ClutterColorOp parent;
+
+  ClutterBt2390EetfParameters parameters;
+};
+
+G_DEFINE_FINAL_TYPE (ClutterColorOpBt2390Eetf, clutter_color_op_bt2390_eetf,
+                     CLUTTER_TYPE_COLOR_OP)
+
+static void
+clutter_color_op_bt2390_eetf_do_transform (ClutterColorOp *op,
+                                           float          *data,
+                                           size_t          n_samples)
+{
+  const ClutterBt2390EetfParameters *parameters =
+    &CLUTTER_COLOR_OP_BT2390_EETF (op)->parameters;
+  float ks = parameters->knee_start;
+
+  for (size_t i = 0; i < n_samples; i++)
+    {
+      float peak, luminance, e1, e2, mapped, ratio;
+
+      /* Without a positive component there is nothing to compress, and no
+       * ratio to take. */
+      peak = MAX (data[0], MAX (data[1], data[2]));
+      if (peak > 0.0f)
+        {
+          luminance = peak * parameters->scale;
+
+          e1 = (pq_signal_from_luminance (luminance) - parameters->source_min) /
+               parameters->source_range;
+
+          /* Below the knee the curve is the identity, down to and below the
+           * source minimum: nothing is raised, and there is no black level
+           * lift (b = 0). A knee at 1 or above leaves nothing to compress.
+           * Above the source peak, the curve stays at the target peak. */
+          if (e1 >= ks && ks < 1.0f)
+            {
+              float t = (MIN (e1, 1.0f) - ks) / (1.0f - ks);
+              float t2 = t * t;
+              float t3 = t2 * t;
+
+              e2 = (2.0f * t3 - 3.0f * t2 + 1.0f) * ks +
+                   (t3 - 2.0f * t2 + t) * (1.0f - ks) +
+                   (-2.0f * t3 + 3.0f * t2) * parameters->max_lum;
+
+              mapped = pq_luminance_from_signal (e2 * parameters->source_range +
+                                                 parameters->source_min);
+              ratio = mapped / luminance;
+
+              data[0] *= ratio;
+              data[1] *= ratio;
+              data[2] *= ratio;
+            }
+        }
+
+      data += 4;
+    }
+}
+
+static char *
+clutter_color_op_bt2390_eetf_to_string (ClutterColorOp *op)
+{
+  const ClutterBt2390EetfParameters *parameters =
+    &CLUTTER_COLOR_OP_BT2390_EETF (op)->parameters;
+  char max_lum_str[G_ASCII_DTOSTR_BUF_SIZE];
+
+  g_ascii_formatd (max_lum_str, sizeof (max_lum_str), "%.4f",
+                   parameters->max_lum);
+
+  return g_strdup_printf ("bt2390_eetf(max lum %s)", max_lum_str);
+}
+
+static void
+clutter_color_op_bt2390_eetf_class_init (ClutterColorOpBt2390EetfClass *klass)
+{
+  ClutterColorOpClass *op_class = CLUTTER_COLOR_OP_CLASS (klass);
+
+  op_class->to_string = clutter_color_op_bt2390_eetf_to_string;
+  op_class->do_transform = clutter_color_op_bt2390_eetf_do_transform;
+}
+
+static void
+clutter_color_op_bt2390_eetf_init (ClutterColorOpBt2390Eetf *op)
+{
+}
+
+ClutterColorOp *
+clutter_color_op_bt2390_eetf_new (const ClutterBt2390EetfParameters *parameters)
+{
+  ClutterColorOpBt2390Eetf *op;
+
+  op = g_object_new (CLUTTER_TYPE_COLOR_OP_BT2390_EETF, NULL);
+  op->parameters = *parameters;
+
+  return CLUTTER_COLOR_OP (op);
+}
+
+const ClutterBt2390EetfParameters *
+clutter_color_op_bt2390_eetf_get_parameters (ClutterColorOp *op)
+{
+  return &CLUTTER_COLOR_OP_BT2390_EETF (op)->parameters;
+}
