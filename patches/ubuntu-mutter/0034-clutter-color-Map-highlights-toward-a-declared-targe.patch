 typedef struct _ClutterColorOp3DLutPrivate
 {
   uint32_t size;
diff --git a/clutter/clutter/clutter-color-pipeline-shader.c b/clutter/clutter/clutter-color-pipeline-shader.c
index 306b01b..534a7d3 100644
--- a/clutter/clutter/clutter-color-pipeline-shader.c
+++ b/clutter/clutter/clutter-color-pipeline-shader.c
@@ -257,6 +257,62 @@ static const char hlg_inv_eotf_source[] =
   "  return clamp ((signal - beta) / (1.0 - beta), 0.0, 1.0);\n"
   "}\n";
 
+/* Report ITU-R BT.2390 EETF; must match ClutterColorOpBt2390Eetf. */
+static const char bt2390_eetf_source[] =
+  "float bt2390_pq_signal (float luminance)\n"
+  "{\n"
+  "  const float m1 = 2610.0 / 16384.0;\n"
+  "  const float m2 = 2523.0 / 4096.0 * 128.0;\n"
+  "  const float c1 = 3424.0 / 4096.0;\n"
+  "  const float c2 = 2413.0 / 4096.0 * 32.0;\n"
+  "  const float c3 = 2392.0 / 4096.0 * 32.0;\n"
+  "\n"
+  "  float p = pow (max (luminance, 0.0) / 10000.0, m1);\n"
+  "  return pow ((c1 + c2 * p) / (1.0 + c3 * p), m2);\n"
+  "}\n"
+  "\n"
+  "float bt2390_pq_luminance (float signal)\n"
+  "{\n"
+  "  const float m1 = 2610.0 / 16384.0;\n"
+  "  const float m2 = 2523.0 / 4096.0 * 128.0;\n"
+  "  const float c1 = 3424.0 / 4096.0;\n"
+  "  const float c2 = 2413.0 / 4096.0 * 32.0;\n"
+  "  const float c3 = 2392.0 / 4096.0 * 32.0;\n"
+  "\n"
+  "  float p = pow (max (signal, 0.0), 1.0 / m2);\n"
+  "  return 10000.0 * pow (max (p - c1, 0.0) / (c2 - c3 * p), 1.0 / m1);\n"
+  "}\n"
+  "\n"
+  "vec3 bt2390_eetf (vec3  color,\n"
+  "                  float scale,\n"
+  "                  float source_min,\n"
+  "                  float source_range,\n"
+  "                  float ks,\n"
+  "                  float max_lum)\n"
+  "{\n"
+  "  float peak = max (color.r, max (color.g, color.b));\n"
+  "\n"
+  "  if (peak <= 0.0)\n"
+  "    return color;\n"
+  "\n"
+  "  float luminance = peak * scale;\n"
+  "  float e1 = (bt2390_pq_signal (luminance) - source_min) / source_range;\n"
+  "\n"
+  "  /* Identity below the knee; no black level lift. */\n"
+  "  if (e1 < ks || ks >= 1.0)\n"
+  "    return color;\n"
+  "\n"
+  "  float t = (min (e1, 1.0) - ks) / (1.0 - ks);\n"
+  "  float t2 = t * t;\n"
+  "  float t3 = t2 * t;\n"
+  "  float e2 = (2.0 * t3 - 3.0 * t2 + 1.0) * ks +\n"
+  "             (t3 - 2.0 * t2 + t) * (1.0 - ks) +\n"
+  "             (-2.0 * t3 + 3.0 * t2) * max_lum;\n"
+  "  float mapped = bt2390_pq_luminance (e2 * source_range + source_min);\n"
+  "\n"
+  "  return color * (mapped / luminance);\n"
+  "}\n";
+
 static const char lut_3d_source[] =
   "// Tetrahedral interpolation\n"
   "vec3 sample_3d_lut_SIZE (vec3 color, sampler2D lut_texture, float lut_size)\n"
@@ -762,6 +818,45 @@ update_hlg_state (ClutterColorOp *op,
                                    3, 1, coefficients);
 }
 
+static char *
+get_bt2390_eetf_declarations (ClutterColorOp *op,
+                              size_t          op_id)
+{
+  return g_strdup_printf ("uniform float bt2390_scale_%zu;\n"
+                          "uniform float bt2390_source_min_%zu;\n"
+                          "uniform float bt2390_source_range_%zu;\n"
+                          "uniform float bt2390_knee_start_%zu;\n"
+                          "uniform float bt2390_max_lum_%zu;\n",
+                          op_id, op_id, op_id, op_id, op_id);
+}
+
+static char *
+get_bt2390_eetf_invocation (ClutterColorOp *op,
+                            size_t          op_id)
+{
+  return g_strdup_printf ("vec4 (bt2390_eetf (color.rgb, bt2390_scale_%zu, "
+                          "bt2390_source_min_%zu, bt2390_source_range_%zu, "
+                          "bt2390_knee_start_%zu, bt2390_max_lum_%zu), "
+                          "color.a)",
+                          op_id, op_id, op_id, op_id, op_id);
+}
+
+static void
+update_bt2390_eetf_state (ClutterColorOp *op,
+                          size_t          op_id,
+                          CoglPipeline   *pipeline)
+{
+  const ClutterBt2390EetfParameters *parameters =
+    clutter_color_op_bt2390_eetf_get_parameters (op);
+
+  set_uniform_1f (pipeline, "bt2390_scale", op_id, parameters->scale);
+  set_uniform_1f (pipeline, "bt2390_source_min", op_id, parameters->source_min);
+  set_uniform_1f (pipeline, "bt2390_source_range", op_id,
+                  parameters->source_range);
+  set_uniform_1f (pipeline, "bt2390_knee_start", op_id, parameters->knee_start);
+  set_uniform_1f (pipeline, "bt2390_max_lum", op_id, parameters->max_lum);
+}
