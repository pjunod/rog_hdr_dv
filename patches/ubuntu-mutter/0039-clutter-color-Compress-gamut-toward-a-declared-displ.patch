+                                        double                  y)
+{
+  const double vertices[3][2] = {
+    { outer->r_x, outer->r_y },
+    { outer->g_x, outer->g_y },
+    { outer->b_x, outer->b_y },
+  };
+  gboolean violated[3] = { FALSE, FALSE, FALSE };
+  double orientation;
+  int i;
+
+  orientation = chromaticity_cross (vertices[0][0], vertices[0][1],
+                                    vertices[1][0], vertices[1][1],
+                                    vertices[2][0], vertices[2][1]);
+
+  /* Side i runs from primary i to primary i + 1. */
+  for (i = 0; i < 3; i++)
+    {
+      const double *a = vertices[i];
+      const double *b = vertices[(i + 1) % 3];
+      double cross = chromaticity_cross (a[0], a[1], b[0], b[1], x, y);
+
+      if ((orientation > 0.0 && cross < 0.0) ||
+          (orientation < 0.0 && cross > 0.0))
+        {
+          double length = hypot (b[0] - a[0], b[1] - a[1]);
+          double side_tolerance = MAX (tolerance[i], tolerance[(i + 1) % 3]);
+
+          if (fabs (cross) / length > side_tolerance)
+            return FALSE;
+
+          violated[i] = TRUE;
+        }
+    }
+
+  /* Primary i is where sides i - 1 and i meet. */
+  for (i = 0; i < 3; i++)
+    {
+      if (violated[i] && violated[(i + 2) % 3] &&
+          hypot (x - vertices[i][0], y - vertices[i][1]) > tolerance[i])
+        return FALSE;
+    }
 
