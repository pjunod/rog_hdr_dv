+  ClutterColorimetry target_colorimetry;
+  GamutTarget target;
+  graphene_matrix_t to_linear_bt2020, XYZ_to_D65, XYZ_to_linear_bt2020;
+  double encoding[3][3], mastering[3][3];
+  double (*limit_vertices)[3];
+  gboolean bounded, contained;
+  int i, c;
+
+  if (!CLUTTER_IS_COLOR_STATE_PARAMS (target_color_state) ||
+      !clutter_color_state_params_get_display_gamut (CLUTTER_COLOR_STATE_PARAMS (target_color_state),
