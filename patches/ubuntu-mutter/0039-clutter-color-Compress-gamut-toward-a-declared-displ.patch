+/*
+ * The limits: for each channel, the largest distance a point of the source
+ * gamut boundary outside the target reaches in linear RGB of the target.
+ *
+ * The boundary is the three sides between the source primaries @vertices,
+ * given in linear BT.2020; the distance is scale invariant, so a side is the
+ * set of positive combinations v = (1 - l) a + l b of its two primaries in
+ * target RGB. Wherever the largest channel k of v stays the same, the
+ * distance 1 - v_c / v_k of a channel c is a linear-fractional function of
+ * l, so monotonic: on each side the maximum lies at a primary or where two
+ * channels of v are equal. These points are all that is evaluated, which
+ * makes the limits exact, so that no point of the boundary (primaries and
+ * sides) ends up beyond distance 1 and each channel's maximising point lands
+ * at 1. The interior adds nothing: along a line where two channels are
+ * equal the distance is again linear-fractional, with its maximum at the
+ * line's ends on the sides.
+ *
+ * Points within the target, by its tolerances, are ignored. The achromatic
+ * value max (R, G, B) is a convex, piecewise linear function along a side,
+ * so its minimum is among the same points: if one of them has no positive
+ * achromatic value, or any value is not finite, the side passes through
+ * directions the compression cannot map, and %FALSE is returned: nothing is
+ * compressed. Otherwise returns whether some channel's limit exceeds 1, the
+ * only case in which the op does anything.
+ */
+static gboolean
+compute_gamut_limits (const GamutTarget *target,
+                      const double       vertices[3][3],
+                      GamutCompression  *compression)
+{
+  double rgb[3][3];
+  int i, j, c, side;
+
+  for (i = 0; i < 3; i++)
+    {
+      transform_double (&compression->from_linear_bt2020, vertices[i], rgb[i]);
+      if (!is_finite3 (rgb[i]))
+        return FALSE;
+    }
+
+  for (c = 0; c < 3; c++)
+    compression->limit[c] = 0.0f;
+
+  for (side = 0; side < 3; side++)
+    {
+      const double *a = rgb[side], *b = rgb[(side + 1) % 3];
+      const double *bt2020_a = vertices[side];
+      const double *bt2020_b = vertices[(side + 1) % 3];
+      double candidates[5] = { 0.0, 1.0 };
+      int n_candidates = 2, n;
+
+      for (i = 0; i < 3; i++)
+        {
+          for (j = i + 1; j < 3; j++)
+            {
+              double denominator = (a[i] - a[j]) - (b[i] - b[j]);
+              double l;
+
+              if (denominator == 0.0)
+                continue;
+
+              l = (a[i] - a[j]) / denominator;
+              if (l > 0.0 && l < 1.0)
+                candidates[n_candidates++] = l;
+            }
+        }
+
+      for (n = 0; n < n_candidates; n++)
+        {
+          double l = candidates[n];
+          double v[3], bt2020[3], ach;
+          gboolean contained;
+
+          for (c = 0; c < 3; c++)
+            {
+              v[c] = (1.0 - l) * a[c] + l * b[c];
+              bt2020[c] = (1.0 - l) * bt2020_a[c] + l * bt2020_b[c];
+            }
+
+          ach = MAX (v[0], MAX (v[1], v[2]));
+          if (!is_finite3 (v) || !(ach > 0.0))
+            return FALSE;
+
+          if (!gamut_target_contains (target, bt2020, &contained))
+            return FALSE;
+          if (contained)
+            continue;
+
+          for (c = 0; c < 3; c++)
+            {
+              compression->limit[c] = MAX (compression->limit[c],
+                                           (float) ((ach - v[c]) / ach));
+            }
+        }
+    }
