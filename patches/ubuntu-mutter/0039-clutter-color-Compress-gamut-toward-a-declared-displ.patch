+  if (clutter_color_state_params_is_encoding_bounded (color_state_params))
     peak = (double) MAX (lum->max, lum->mastering_max) / lum->ref;
   if (target_volume->has_luminance)
     peak = MIN (peak, target_volume->max_lum / display_ref);
@@ -244,7 +245,10 @@ target_volume_equal (const ClutterColorTargetVolume *target_volume,
     return FALSE;
 
   if (target_volume->has_primaries &&
