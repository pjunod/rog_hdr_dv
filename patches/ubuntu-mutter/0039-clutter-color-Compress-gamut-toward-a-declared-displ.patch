+/* ACES 1.3 Reference Gamut Compression: threshold and power. */
+#define GAMUT_COMPRESSION_THRESHOLD 0.8f
+#define GAMUT_COMPRESSION_POWER 1.2f
+
+/*
+ * The adapted chromaticities carry single precision rounding, about 1e-7;
+ * a point closer than the protocol's chromaticity unit, 1e-6, to the outside
+ * of a side is taken to be on it.
+ */
+#define GAMUT_CONTAINMENT_MARGIN 1e-6f
+
+typedef struct _GamutCompression
+{
+  graphene_matrix_t from_linear_bt2020;
+  graphene_matrix_t to_linear_bt2020;
+  float limit[3];
+} GamutCompression;
+
+typedef struct _GamutTarget
+{
+  ClutterPrimaries primaries;
+  float tolerance[3];
+  graphene_matrix_t linear_bt2020_to_XYZ;
+} GamutTarget;
+
+/* @v times @matrix, row vector convention as graphene uses, in double. */
+static void
+transform_double (const graphene_matrix_t *matrix,
+                  const double             v[3],
+                  double                   out[3])
+{
+  int i, j;
+
+  for (j = 0; j < 3; j++)
+    {
+      out[j] = 0.0;
+      for (i = 0; i < 3; i++)
+        out[j] += v[i] * graphene_matrix_get_value (matrix, i, j);
+    }
+}
+
+static gboolean
+is_finite3 (const double v[3])
+{
+  return isfinite (v[0]) && isfinite (v[1]) && isfinite (v[2]);
+}
+
+/*
+ * Whether linear BT.2020 @bt2020 lies within the target triangle, with its
+ * tolerances, by its CIE 1931 chromaticity. Returns %FALSE if it has none
+ * (X + Y + Z not positive, or not finite).
+ */
+static gboolean
+gamut_target_contains (const GamutTarget *target,
+                       const double       bt2020[3],
+                       gboolean          *contains)
+{
+  double XYZ[3], sum;
+
+  transform_double (&target->linear_bt2020_to_XYZ, bt2020, XYZ);
+  sum = XYZ[0] + XYZ[1] + XYZ[2];
+  if (!is_finite3 (XYZ) || !(sum > 0.0))
+    return FALSE;
+
+  *contains = clutter_primaries_contain_chromaticity (&target->primaries,
+                                                      target->tolerance,
+                                                      XYZ[0] / sum,
+                                                      XYZ[1] / sum);
+  return TRUE;
+}
+
+/* Whether all three vertices lie within the target; %FALSE if one has no
+ * chromaticity. */
+static gboolean
+gamut_target_contains_all (const GamutTarget *target,
+                           const double       vertices[3][3],
+                           gboolean          *contains)
+{
+  int i;
+
+  *contains = TRUE;
+  for (i = 0; i < 3; i++)
+    {
+      gboolean vertex_contained;
+
+      if (!gamut_target_contains (target, vertices[i], &vertex_contained))
+        return FALSE;
+      if (!vertex_contained)
+        *contains = FALSE;
+    }
+
+  return TRUE;
+}
