diff --git a/clutter/clutter/clutter-color-op-private.h b/clutter/clutter/clutter-color-op-private.h
index a78ef3e..874e5f6 100644
--- a/clutter/clutter/clutter-color-op-private.h
+++ b/clutter/clutter/clutter-color-op-private.h
@@ -94,3 +94,44 @@ typedef struct _ClutterBt2390EetfParameters
 ClutterColorOp * clutter_color_op_bt2390_eetf_new (const ClutterBt2390EetfParameters *parameters);
 
 const ClutterBt2390EetfParameters * clutter_color_op_bt2390_eetf_get_parameters (ClutterColorOp *op);
+
+/*
+ * The ACES 1.3 Reference Gamut Compression distance compression, applied in
+ * linear RGB of a target gamut. The achromatic value of a sample is
+ * ach = max (R, G, B); each channel c has the distance d = (ach - c) / ach
+ * from it, which is 1 on the gamut boundary and above 1 outside it. A
+ * distance above @threshold is compressed with the published curve of
+ * @power:
+ *
+ *   d' = t + s x / (1 + x^p)^(1/p), x = (d - t) / s
+ *
+ * with the channel's @scale s, and the channel becomes ach - d' ach. The
+ * curve is evaluated as t + s (1 + x^-p)^(-1/p), which is the same and does
+ * not overflow for large x. A channel whose scale is 0 is left untouched, as
+ * is every channel of a sample whose achromatic value is not positive or not
+ * finite, and every channel whose distance is not above the threshold: such
+ * values are not rewritten at all. Finite channels never become NaN.
+ *
+ * @limit is the distance each channel maps onto the boundary (d' = 1); the
+ * scale is derived from it on construction, see
+ * clutter_color_op_gamut_compress_new(), and the shader only evaluates.
+ */
+#define CLUTTER_TYPE_COLOR_OP_GAMUT_COMPRESS (clutter_color_op_gamut_compress_get_type ())
+G_DECLARE_FINAL_TYPE (ClutterColorOpGamutCompress,
+                      clutter_color_op_gamut_compress,
+                      CLUTTER, COLOR_OP_GAMUT_COMPRESS,
+                      ClutterColorOp)
+
+typedef struct _ClutterGamutCompressParameters
+{
+  float threshold;
+  float power;
+  float limit[3];
+  float scale[3];
+} ClutterGamutCompressParameters;
+
+ClutterColorOp * clutter_color_op_gamut_compress_new (float       threshold,
+                                                      float       power,
+                                                      const float limit[3]);
+
+const ClutterGamutCompressParameters * clutter_color_op_gamut_compress_get_parameters (ClutterColorOp *op);
diff --git a/clutter/clutter/clutter-color-op.c b/clutter/clutter/clutter-color-op.c
index 6616e15..c366c34 100644
--- a/clutter/clutter/clutter-color-op.c
+++ b/clutter/clutter/clutter-color-op.c
@@ -899,6 +899,138 @@ clutter_color_op_bt2390_eetf_get_parameters (ClutterColorOp *op)
   return &CLUTTER_COLOR_OP_BT2390_EETF (op)->parameters;
 }
 
+struct _ClutterColorOpGamutCompress
+{
+  ClutterColorOp parent;
+
+  ClutterGamutCompressParameters parameters;
+};
+
+G_DEFINE_FINAL_TYPE (ClutterColorOpGamutCompress, clutter_color_op_gamut_compress,
+                     CLUTTER_TYPE_COLOR_OP)
+
+static void
+clutter_color_op_gamut_compress_do_transform (ClutterColorOp *op,
+                                              float          *data,
+                                              size_t          n_samples)
+{
+  const ClutterGamutCompressParameters *parameters =
+    &CLUTTER_COLOR_OP_GAMUT_COMPRESS (op)->parameters;
+  float t = parameters->threshold;
+  float p = parameters->power;
+
+  for (size_t i = 0; i < n_samples; i++)
+    {
+      float ach = MAX (data[0], MAX (data[1], data[2]));
+
+      /* Without a positive, finite achromatic value there is no distance to
+       * take: such samples are left unchanged. */
+      if (ach > 0.0f && isfinite (ach))
+        {
+          for (int c = 0; c < 3; c++)
+            {
+              float s = parameters->scale[c];
+              float d, x, compressed;
+
+              if (s <= 0.0f)
+                continue;
+
+              /* Not above the threshold, including a NaN channel. */
+              d = (ach - data[c]) / ach;
+              if (!(d > t))
+                continue;
+
+              /* x / (1 + x^p)^(1/p) written as (1 + x^-p)^(-1/p), which
+               * neither overflows for large x nor divides infinity by
+               * infinity, and approaches 1 as x grows; x is kept positive so
+               * that x^-p is defined. */
+              x = MAX ((d - t) / s, G_MINFLOAT);
+              compressed = t + s * powf (1.0f + powf (x, -p), -1.0f / p);
+              data[c] = ach - compressed * ach;
+            }
+        }
+
+      data += 4;
+    }
+}
+
+static char *
+clutter_color_op_gamut_compress_to_string (ClutterColorOp *op)
+{
+  const ClutterGamutCompressParameters *parameters =
+    &CLUTTER_COLOR_OP_GAMUT_COMPRESS (op)->parameters;
+  char limit_str[3][G_ASCII_DTOSTR_BUF_SIZE];
+  int c;
+
+  for (c = 0; c < 3; c++)
+    {
+      g_ascii_formatd (limit_str[c], sizeof (limit_str[c]), "%.4f",
+                       parameters->scale[c] > 0.0f ? parameters->limit[c] : 0.0);
+    }
+
+  return g_strdup_printf ("gamut_compress(limits %s, %s, %s)",
+                          limit_str[0], limit_str[1], limit_str[2]);
+}
+
+static void
+clutter_color_op_gamut_compress_class_init (ClutterColorOpGamutCompressClass *klass)
+{
+  ClutterColorOpClass *op_class = CLUTTER_COLOR_OP_CLASS (klass);
+
+  op_class->to_string = clutter_color_op_gamut_compress_to_string;
+  op_class->do_transform = clutter_color_op_gamut_compress_do_transform;
+}
+
+static void
+clutter_color_op_gamut_compress_init (ClutterColorOpGamutCompress *op)
+{
+}
+
+/*
+ * Creates the compression for the given threshold t and power p, mapping the
+ * distance @limit[c] of each channel c onto the gamut boundary. The scale
+ * follows from requiring d' = 1 at d = L:
+ *
+ *   s = (L - t) / (((1 - t) / (L - t))^(-p) - 1)^(1/p)
+ *
+ * evaluated in double precision. A channel whose limit is at most 1 already
+ * lies within the boundary and is left untouched (scale 0); so is one whose
+ * scale would not be a positive single precision value.
+ */
+ClutterColorOp *
+clutter_color_op_gamut_compress_new (float       threshold,
+                                     float       power,
+                                     const float limit[3])
+{
+  ClutterColorOpGamutCompress *op;
+  int c;
+
+  op = g_object_new (CLUTTER_TYPE_COLOR_OP_GAMUT_COMPRESS, NULL);
+  op->parameters.threshold = threshold;
+  op->parameters.power = power;
+
+  for (c = 0; c < 3; c++)
+    {
+      double t = threshold, p = power, l = limit[c];
+      double scale = 0.0;
+
+      if (l > 1.0 && t < 1.0)
+        scale = (l - t) / pow (pow ((1.0 - t) / (l - t), -p) - 1.0, 1.0 / p);
+
+      op->parameters.limit[c] = limit[c];
+      op->parameters.scale[c] = scale > 0.0 && scale <= G_MAXFLOAT ?
+                                (float) scale : 0.0f;
+    }
+
+  return CLUTTER_COLOR_OP (op);
+}
+
+const ClutterGamutCompressParameters *
+clutter_color_op_gamut_compress_get_parameters (ClutterColorOp *op)
+{
+  return &CLUTTER_COLOR_OP_GAMUT_COMPRESS (op)->parameters;
+}
+
 typedef struct _ClutterColorOp3DLutPrivate
 {
   uint32_t size;
diff --git a/clutter/clutter/clutter-color-pipeline-shader.c b/clutter/clutter/clutter-color-pipeline-shader.c
index 534a7d3..9a43e2a 100644
--- a/clutter/clutter/clutter-color-pipeline-shader.c
+++ b/clutter/clutter/clutter-color-pipeline-shader.c
@@ -313,6 +313,48 @@ static const char bt2390_eetf_source[] =
   "  return color * (mapped / luminance);\n"
   "}\n";
 
+/* ACES 1.3 Reference Gamut Compression; must match
+ * ClutterColorOpGamutCompress. */
+static const char gamut_compress_source[] =
+  "float gamut_compress_channel (float c,\n"
+  "                              float ach,\n"
+  "                              float threshold,\n"
+  "                              float power,\n"
+  "                              float scale)\n"
+  "{\n"
+  "  if (scale <= 0.0)\n"
+  "    return c;\n"
+  "\n"
+  "  float d = (ach - c) / ach;\n"
+  "  if (!(d > threshold))\n"
+  "    return c;\n"
+  "\n"
+  "  /* Overflow-safe form of x / (1 + x^p)^(1/p). */\n"
+  "  float x = max ((d - threshold) / scale, 1.17549435e-38);\n"
+  "  float compressed = threshold +\n"
+  "                     scale * pow (1.0 + pow (x, -power), -1.0 / power);\n"
+  "  return ach - compressed * ach;\n"
+  "}\n"
+  "\n"
+  "vec3 gamut_compress (vec3  color,\n"
+  "                     float threshold,\n"
+  "                     float power,\n"
+  "                     vec3  scale)\n"
+  "{\n"
+  "  float ach = max (color.r, max (color.g, color.b));\n"
+  "\n"
+  "  /* Not positive, or not finite. */\n"
+  "  if (!(ach > 0.0) || ach > 3.40282347e38)\n"
+  "    return color;\n"
+  "\n"
+  "  return vec3 (gamut_compress_channel (color.r, ach, threshold, power,\n"
+  "                                       scale.r),\n"
+  "               gamut_compress_channel (color.g, ach, threshold, power,\n"
+  "                                       scale.g),\n"
+  "               gamut_compress_channel (color.b, ach, threshold, power,\n"
+  "                                       scale.b));\n"
+  "}\n";
+
 static const char lut_3d_source[] =
   "// Tetrahedral interpolation\n"
   "vec3 sample_3d_lut_SIZE (vec3 color, sampler2D lut_texture, float lut_size)\n"
@@ -857,6 +899,46 @@ update_bt2390_eetf_state (ClutterColorOp *op,
   set_uniform_1f (pipeline, "bt2390_max_lum", op_id, parameters->max_lum);
 }
 
+static char *
+get_gamut_compress_declarations (ClutterColorOp *op,
+                                 size_t          op_id)
+{
+  return g_strdup_printf ("uniform float gamut_threshold_%zu;\n"
+                          "uniform float gamut_power_%zu;\n"
+                          "uniform vec3 gamut_scale_%zu;\n",
+                          op_id, op_id, op_id);
+}
+
+static char *
+get_gamut_compress_invocation (ClutterColorOp *op,
+                               size_t          op_id)
+{
+  return g_strdup_printf ("vec4 (gamut_compress (color.rgb, "
+                          "gamut_threshold_%zu, gamut_power_%zu, "
+                          "gamut_scale_%zu), color.a)",
+                          op_id, op_id, op_id);
+}
+
+static void
+update_gamut_compress_state (ClutterColorOp *op,
+                             size_t          op_id,
+                             CoglPipeline   *pipeline)
+{
+  const ClutterGamutCompressParameters *parameters =
+    clutter_color_op_gamut_compress_get_parameters (op);
+  g_autofree char *uniform_name = NULL;
+  int uniform_location;
+
+  set_uniform_1f (pipeline, "gamut_threshold", op_id, parameters->threshold);
+  set_uniform_1f (pipeline, "gamut_power", op_id, parameters->power);
+
+  uniform_name = g_strdup_printf ("gamut_scale_%zu", op_id);
+  uniform_location = cogl_pipeline_get_uniform_location (pipeline,
+                                                         uniform_name);
+  cogl_pipeline_set_uniform_float (pipeline, uniform_location,
+                                   3, 1, parameters->scale);
+}
+
 typedef struct _ShaderOpInfo
 {
   GType (*get_type) (void);
@@ -918,6 +1000,13 @@ static const ShaderOpInfo shader_op_infos[] = {
     .get_invocation = get_bt2390_eetf_invocation,
     .update_state = update_bt2390_eetf_state,
   },
+  {
+    .get_type = clutter_color_op_gamut_compress_get_type,
+    .shader_source = gamut_compress_source,
+    .get_declarations = get_gamut_compress_declarations,
+    .get_invocation = get_gamut_compress_invocation,
+    .update_state = update_gamut_compress_state,
+  },
   {
     .get_type = clutter_color_op_unpremultiply_get_type,
     .shader_source = unpremultiply_source,
