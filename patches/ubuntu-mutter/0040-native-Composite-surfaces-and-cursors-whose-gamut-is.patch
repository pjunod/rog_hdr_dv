From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude Agent <claude-agent@invalid>
Date: Sat, 10 Oct 2026 20:58:15 -0400
Subject: [PATCH] native: Composite surfaces and cursors whose gamut is
 compressed

Direct scanout and the hardware cursor plane bypass the view's blending
state, so they must be refused whenever the conversion to it would map
the content toward the output's target, not only when it would map
highlights: a surface or cursor whose gamut would be compressed would
otherwise reach the panel uncompressed.

Decide both with clutter_color_transform_requires_mapping(), the single
predicate the transform uses to add highlight mapping or gamut
compression, from the surface's or cursor's color state to the view's
blending state. Nothing changes yet: no blending state carries target
primaries until the colour device declares them.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01DLZiLBYev72J1s4D37L7Bi
---
 src/backends/native/meta-cursor-renderer-native.c | 9 +++++----
 src/compositor/meta-compositor-view-native.c      | 9 +++++----
 2 files changed, 10 insertions(+), 8 deletions(-)

diff --git a/src/backends/native/meta-cursor-renderer-native.c b/src/backends/native/meta-cursor-renderer-native.c
index 026e6c8..f34e9ee 100644
--- a/src/backends/native/meta-cursor-renderer-native.c
+++ b/src/backends/native/meta-cursor-renderer-native.c
@@ -435,12 +435,13 @@ meta_cursor_renderer_native_update_cursor (MetaCursorRenderer *cursor_renderer,
           has_hw_cursor = FALSE;
         }
       else if (cursor_color_state && blending_color_state &&
-               clutter_color_transform_requires_highlight_mapping (cursor_color_state,
-                                                                   blending_color_state))
+               clutter_color_transform_requires_mapping (cursor_color_state,
+                                                         blending_color_state))
         {
           /* Like direct scanout, the cursor plane bypasses the blending
-           * state, whose conversion would map the cursor's highlights
-           * toward the output's target: draw the cursor there instead. */
+           * state, whose conversion would map the cursor's highlights or
+           * gamut toward the output's target: draw the cursor there
+           * instead. */
           cursor_stage_view->is_hw_cursor_valid = FALSE;
           has_hw_cursor = FALSE;
         }
diff --git a/src/compositor/meta-compositor-view-native.c b/src/compositor/meta-compositor-view-native.c
index 05c96dd..0e02040 100644
--- a/src/compositor/meta-compositor-view-native.c
+++ b/src/compositor/meta-compositor-view-native.c
@@ -266,8 +266,9 @@ surface_actor_has_overlapping_cursor_overlays (MetaCompositor     *compositor,
  * Whether a surface in @surface_color_state must be composited rather than
  * scanned out to an output in @output_color_state, whose content is blended
  * in @blending_color_state: if rendering it would either convert its encoding
- * or map its highlights toward the output's target. The latter uses the same
- * test as the color transform that would otherwise apply the mapping.
+ * or map it toward the output's target, its highlights or its gamut. The
+ * latter uses the same test as the color transform that would otherwise
+ * apply the mapping.
  */
 gboolean
 meta_compositor_view_native_color_state_prevents_scanout (ClutterColorState *surface_color_state,
@@ -279,8 +280,8 @@ meta_compositor_view_native_color_state_prevents_scanout (ClutterColorState *sur
     return TRUE;
 
   return surface_color_state && blending_color_state &&
-         clutter_color_transform_requires_highlight_mapping (surface_color_state,
-                                                             blending_color_state);
+         clutter_color_transform_requires_mapping (surface_color_state,
+                                                   blending_color_state);
 }
 
 static gboolean
