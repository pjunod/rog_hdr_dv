+/*
+ * The mapping decision for a pair of color states: whether converting the
+ * source to the target maps its highlights, compresses its gamut, and, when
+ * it does, with which limits. It is made once per pair, by
+ * compute_highlight_mapping() and get_gamut_compression(), and kept with the
+ * transform cache under the same exact key, so that the per frame and per
+ * pointer motion questions of direct scanout and the hardware cursor plane
+ * cost a lookup, and every reader, the renderer included, gets the same
+ * answer.
+ */
+typedef struct _MappingDecision
+{
+  GamutCompression compression;
+  gboolean highlight;
+  gboolean gamut;
+} MappingDecision;
+
+static const MappingDecision * get_mapping_decision (ClutterColorState *source_color_state,
+                                                     ClutterColorState *target_color_state);
+
+/*
+ * Whether converting @source_color_state to @target_color_state maps its
+ * highlights, by compute_highlight_mapping(): toward a display target, and
+ * only when the source's effective peak is known and exceeds the target's.
+ */
+gboolean
+clutter_color_transform_requires_highlight_mapping (ClutterColorState *source_color_state,
+                                                    ClutterColorState *target_color_state)
+{
+  g_return_val_if_fail (CLUTTER_IS_COLOR_STATE (source_color_state), FALSE);
+  g_return_val_if_fail (CLUTTER_IS_COLOR_STATE (target_color_state), FALSE);
+
+  return get_mapping_decision (source_color_state,
+                               target_color_state)->highlight;
+}
+
 /*
  * Whether converting @source_color_state to @target_color_state compresses
  * the gamut, by get_gamut_compression(): toward a display gamut target, and
  * only when the content can exceed it. The renderer adds the compression
- * exactly when this returns %TRUE. It returns early, without computing any
- * matrix, whenever the content is found within the target; when it is not,
- * it computes the limits too, since whether any of them exceeds 1 is part of
- * the decision the op builder makes.
+ * exactly when this returns %TRUE.
  */
 gboolean
 clutter_color_transform_requires_gamut_compression (ClutterColorState *source_color_state,
                                                     ClutterColorState *target_color_state)
 {
-  GamutCompression compression;
-
   g_return_val_if_fail (CLUTTER_IS_COLOR_STATE (source_color_state), FALSE);
   g_return_val_if_fail (CLUTTER_IS_COLOR_STATE (target_color_state), FALSE);
 
-  return get_gamut_compression (source_color_state, target_color_state,
-                                &compression);
+  return get_mapping_decision (source_color_state,
+                               target_color_state)->gamut;
 }
 
 /*
@@ -1508,10 +1538,14 @@ gboolean
 clutter_color_transform_requires_mapping (ClutterColorState *source_color_state,
                                           ClutterColorState *target_color_state)
 {
-  return clutter_color_transform_requires_highlight_mapping (source_color_state,
-                                                             target_color_state) ||
-         clutter_color_transform_requires_gamut_compression (source_color_state,
-                                                             target_color_state);
+  const MappingDecision *decision;
+
+  g_return_val_if_fail (CLUTTER_IS_COLOR_STATE (source_color_state), FALSE);
+  g_return_val_if_fail (CLUTTER_IS_COLOR_STATE (target_color_state), FALSE);
+
+  decision = get_mapping_decision (source_color_state, target_color_state);
+
+  return decision->highlight || decision->gamut;
 }
 
