+  /* Keyed exactly like the transforms, with no flags: they do not take part
+   * in the decision. */
+  GHashTable *mapping_decisions; /* ColorTransformCacheKey * -> MappingDecision * */
   GHashTable *tracked_states; /* ClutterColorState * (set) */
   ClutterContext *context;
 } ColorTransformCache;
@@ -1679,6 +1714,7 @@ color_transform_cache_free (gpointer data)
     }
 
   g_hash_table_unref (cache->transforms);
+  g_hash_table_unref (cache->mapping_decisions);
   g_hash_table_unref (cache->tracked_states);
   g_free (cache);
 }
@@ -1699,6 +1735,11 @@ get_color_transform_cache (ClutterContext *context)
                                color_transform_cache_key_equal,
                                g_free,
                                g_object_unref);
+      cache->mapping_decisions =
+        g_hash_table_new_full (color_transform_cache_key_hash,
+                               color_transform_cache_key_equal,
+                               g_free,
+                               g_aligned_free);
       cache->tracked_states =
         g_hash_table_new (g_direct_hash, g_direct_equal);
       g_object_set_data_full (G_OBJECT (context),
@@ -1732,6 +1773,15 @@ on_color_state_destroyed (ClutterColorState *color_state,
         g_hash_table_iter_remove (&iter);
     }
 
+  g_hash_table_iter_init (&iter, cache->mapping_decisions);
+  while (g_hash_table_iter_next (&iter, &key, NULL))
+    {
