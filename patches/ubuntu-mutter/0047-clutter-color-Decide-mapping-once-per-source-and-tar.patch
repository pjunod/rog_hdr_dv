index 575404b..086b47f 100644
--- a/src/tests/clutter/conform/color-hdr.c
+++ b/src/tests/clutter/conform/color-hdr.c
@@ -2873,6 +2873,103 @@ gamut_shader_matches_cpu (void)
                              2e-3f);
 }
 
+/*
+ * The mapping decision is made once per pair of states and kept with the
+ * transform cache: every reader gets the decision the renderer builds from,
+ * the pipeline holds the mapping ops exactly when the predicates say so,
+ * repeated questions get the same answer, and a decision does not outlive
+ * the states it was made for, even when a new state takes a destroyed
+ * one's address.
+ */
+static void
+mapping_decision_cache (void)
+{
+  ClutterContext *context = clutter_test_get_context ();
+  g_autoptr (ClutterColorState) output = create_pq_output (203.0f);
+  g_autoptr (ClutterColorState) pq = NULL;
+  g_autoptr (ClutterColorState) srgb = NULL;
+  g_autoptr (ClutterColorState) hlg = NULL;
+  ClutterColorState *sources[6];
+  ClutterColorState *targets[4];
+  int i, j, round;
+
+  pq = clutter_color_state_params_new (context, CLUTTER_COLORSPACE_BT2020,
+                                       CLUTTER_TRANSFER_FUNCTION_PQ);
+  srgb = clutter_color_state_params_new (context, CLUTTER_COLORSPACE_SRGB,
+                                         CLUTTER_TRANSFER_FUNCTION_GAMMA22);
+  hlg = clutter_color_state_params_new (context, CLUTTER_COLORSPACE_BT2020,
+                                        CLUTTER_TRANSFER_FUNCTION_HLG);
+  sources[0] = g_object_ref (pq);
+  sources[1] = g_object_ref (srgb);
+  sources[2] = g_object_ref (hlg);
+  sources[3] = create_with_target_volume (pq, 4000.0f, 0.0f);
+  sources[4] = create_with_target_volume (pq, 400.0f, 0.0f);
+  sources[5] = create_with_mastering_primaries (pq, &srgb_gamut);
+  targets[0] = create_targeted_blending (output, TARGET_MAX_LUM, FALSE);
+  targets[1] = create_gamut_blending (output, &target_gamut, FALSE, FALSE);
+  targets[2] = create_gamut_blending (output, &target_gamut, TRUE, TRUE);
+  targets[3] = clutter_color_state_get_blending (output, FALSE);
+
+  for (round = 0; round < 2; round++)
+    {
+      for (i = 0; i < G_N_ELEMENTS (sources); i++)
+        {
+          for (j = 0; j < G_N_ELEMENTS (targets); j++)
+            {
+              ClutterColorTransform *transform;
+              gboolean highlight, gamut;
+
+              highlight =
+                clutter_color_transform_requires_highlight_mapping (sources[i],
+                                                                    targets[j]);
+              gamut =
+                clutter_color_transform_requires_gamut_compression (sources[i],
+                                                                    targets[j]);
+              g_assert_cmpint (clutter_color_transform_requires_mapping (sources[i],
+                                                                         targets[j]),
+                               ==, highlight || gamut);
+
+              transform = clutter_color_transform_from_color_states (context,
+                                                                     sources[i],
+                                                                     targets[j],
+                                                                     0);
+              g_assert_cmpint (find_op_index (transform,
+                                              "ClutterColorOpBt2390Eetf") >= 0,
+                               ==, highlight);
+              g_assert_cmpint (find_op_index (transform,
+                                              "ClutterColorOpGamutCompress") >= 0,
+                               ==, gamut);
+            }
+        }
+    }
+
+  /* Sanity: the set holds both outcomes of both mappings. */
+  g_assert_true (clutter_color_transform_requires_highlight_mapping (sources[3], targets[0]));
+  g_assert_false (clutter_color_transform_requires_highlight_mapping (sources[4], targets[0]));
+  g_assert_true (clutter_color_transform_requires_gamut_compression (sources[0], targets[1]));
+  g_assert_false (clutter_color_transform_requires_gamut_compression (sources[5], targets[1]));
+
+  /* A decision ends with its states. */
+  for (round = 0; round < 8; round++)
+    {
+      g_autoptr (ClutterColorState) above = NULL;
+      g_autoptr (ClutterColorState) below = NULL;
+
+      above = create_with_target_volume (pq, 4000.0f, 0.0f);
+      g_assert_true (clutter_color_transform_requires_mapping (above, targets[0]));
+      g_clear_object (&above);
+
+      below = create_with_target_volume (pq, 400.0f, 0.0f);
+      g_assert_false (clutter_color_transform_requires_mapping (below, targets[0]));
+      g_clear_object (&below);
+    }
+
+  for (i = 0; i < G_N_ELEMENTS (sources); i++)
+    g_object_unref (sources[i]);
+  for (j = 0; j < G_N_ELEMENTS (targets); j++)
+    g_object_unref (targets[j]);
+}
