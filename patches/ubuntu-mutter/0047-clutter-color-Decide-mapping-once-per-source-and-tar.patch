+
   g_hash_table_remove (cache->tracked_states, color_state);
 }
 
@@ -1749,6 +1799,47 @@ ensure_color_state_tracking (ColorTransformCache *cache,
   g_hash_table_add (cache->tracked_states, color_state);
 }
 
+/*
+ * The mapping decision for the pair, made on first use and kept until either
+ * state is destroyed. The returned decision belongs to the cache and is
+ * valid until a color state is next destroyed.
+ */
+static const MappingDecision *
+get_mapping_decision (ClutterColorState *source_color_state,
+                      ClutterColorState *target_color_state)
+{
+  ClutterContext *context = clutter_color_state_get_context (source_color_state);
+  ColorTransformCache *cache = get_color_transform_cache (context);
+  ColorTransformCacheKey lookup_key = {
+    .source = source_color_state,
+    .target = target_color_state,
+    .flags = 0,
+  };
+  MappingDecision *decision;
+
+  decision = g_hash_table_lookup (cache->mapping_decisions, &lookup_key);
+  if (decision)
+    return decision;
+
+  /* Aligned for the matrices it holds. */
+  decision = g_aligned_alloc0 (1, sizeof (MappingDecision),
+                               G_ALIGNOF (MappingDecision));
+  decision->highlight = compute_highlight_mapping (source_color_state,
+                                                   target_color_state);
+  decision->gamut = get_gamut_compression (source_color_state,
+                                           target_color_state,
+                                           &decision->compression);
+
+  ensure_color_state_tracking (cache, source_color_state);
+  ensure_color_state_tracking (cache, target_color_state);
+
+  g_hash_table_insert (cache->mapping_decisions,
+                       g_memdup2 (&lookup_key, sizeof (ColorTransformCacheKey)),
+                       decision);
+
+  return decision;
+}
+
 ClutterColorTransform *
 clutter_color_transform_from_color_states (ClutterContext                  *context,
                                            ClutterColorState               *source_color_state,
