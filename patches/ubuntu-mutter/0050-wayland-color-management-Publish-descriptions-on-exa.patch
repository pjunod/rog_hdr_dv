-    # declared target peak or declared target primaries.
+    # declared target peak or declared target primaries, and the published
+    # case a declared target peak and reference luminance factors.
     'separate_cases': [
       '/wayland/target-luminance/v1',
       '/wayland/target-luminance/v2',
@@ -964,6 +965,7 @@ wayland_test_cases = [
