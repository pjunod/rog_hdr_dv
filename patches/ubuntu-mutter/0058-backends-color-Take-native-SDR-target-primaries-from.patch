+    return FALSE;
   native = &edid_info->native_chromaticities;
   declaration_tolerance (native, physical.tolerance);
   for (i = 0; i < 4; i++)
@@ -1174,7 +1168,7 @@ meta_color_target_primaries_init (MetaColorTargetPrimaries *target,
         i < 3 ? &native->primaries[i] : &native->white_point;
 
       if (!point->valid || point->a >= 4096 || point->b >= 4096)
-        return;
+        return FALSE;
       switch (native->coordinates)
         {
         case DI_DISPLAYID2_CHROMATICITY_CIE1931:
@@ -1186,11 +1180,11 @@ meta_color_target_primaries_init (MetaColorTargetPrimaries *target,
                                       6 * point->a - 16 * point->b + 12 * 4096 };
           break;
         default:
-          return;
+          return FALSE;
         }
       if (points[i].z <= 0 || points[i].y <= 0 ||
           points[i].x + points[i].y > points[i].z)
-        return;
+        return FALSE;
       physical.coordinates[2 * i] = (int32_t) ((points[i].x * 1000000) / points[i].z);
       physical.coordinates[2 * i + 1] = (int32_t) ((points[i].y * 1000000) / points[i].z);
       published[i] = (TargetPoint) { physical.coordinates[2 * i],
@@ -1199,8 +1193,105 @@ meta_color_target_primaries_init (MetaColorTargetPrimaries *target,
 
   /* 12-bit homogeneous and 1e6-scaled determinants fit int64. A complete
    * RGBW target must remain usable after the protocol's quantization. */
-  if (target_geometry_valid (points) && target_geometry_valid (published))
-    *target = physical;
+  if (!target_geometry_valid (points) || !target_geometry_valid (published))
+    return FALSE;
+
+  *target = physical;
+  return TRUE;
+}
+
+/*
+ * The base EDID color characteristics, accepted as the native SDR mode
+ * accepts them before rendering with them (see
+ * meta_color_colorimetry_from_edid_primaries()), and, as published, within
+ * the chromaticity domain the DisplayID declaration is held to (x >= 0,
+ * y > 0, x + y <= 1) and with a usable geometry. In the native SDR mode they
+ * are also the encoding primaries, and both publish the same coordinates.
+ *
+ * The EDID declares each coordinate in 10 bits, in steps of 1/1024, so a
+ * declared primary lies within sqrt (2) / 2 steps of the true one, and
+ * publishing adds less than sqrt (2) * 1e-6: one step is the tolerance of
+ * every primary.
+ */
+static gboolean
+select_edid_primaries (MetaColorTargetPrimaries *target,
+                       const MetaEdidInfo       *edid_info)
+{
+  g_auto (ClutterColorimetry) colorimetry = { 0 };
+  MetaColorTargetPrimaries declared = { .source = META_COLOR_TARGET_EDID_DECLARED };
+  TargetPoint published[4];
+  unsigned int i;
+
+  if (!meta_color_colorimetry_from_edid_primaries (edid_info, &colorimetry, NULL))
+    return FALSE;
+  if (!meta_color_primaries_to_fixed (colorimetry.primaries, declared.coordinates))
+    return FALSE;
+
+  /* Within the domain, the 1e6-scaled determinants fit int64. */
+  for (i = 0; i < 4; i++)
+    {
+      int64_t x = declared.coordinates[2 * i];
+      int64_t y = declared.coordinates[2 * i + 1];
+
+      if (x < 0 || y <= 0 || x + y > 1000000)
+        return FALSE;
+      published[i] = (TargetPoint) { x, y, 1 };
+    }
+  if (!target_geometry_valid (published))
+    return FALSE;
+
+  for (i = 0; i < 3; i++)
+    declared.tolerance[i] = 1.0f / 1024.0f;
+
+  *target = declared;
+  return TRUE;
+}
+
+/*
+ * Selects the target primaries of an output from the one declaration
+ * @sources allows, taken as a whole when it is usable:
+ *
+ *  - META_COLOR_TARGET_PRIMARIES_SOURCES_DISPLAYID (BT.2100): the DisplayID
+ *    2 native chromaticities, the display's physical gamut. The base EDID
+ *    color characteristics describe the default SDR colorimetry, which many
+ *    HDR displays declare narrower than what they show in HDR, so they are
+ *    no HDR target;
+ *  - META_COLOR_TARGET_PRIMARIES_SOURCES_BASE_EDID (native SDR): the base
+ *    EDID color characteristics, the gamut the mode encodes in. Colors
+ *    outside the encoding gamut clip whatever the target, so a target gamut
+ *    that differs from them would compress toward a gamut the encoding
+ *    cannot express.
+ *
+ * Otherwise the target is the encoding gamut, the explicit fallback,
+ * published exactly as the encoding primaries themselves are.
+ */
+void
+meta_color_target_primaries_init (MetaColorTargetPrimaries        *target,
+                                  const MetaEdidInfo              *edid_info,
+                                  MetaColorTargetPrimariesSources  sources,
+                                  const ClutterPrimaries          *encoding)
+{
+  *target = (MetaColorTargetPrimaries) { .source = META_COLOR_TARGET_ENCODING_FALLBACK };
+  if (!meta_color_primaries_to_fixed (encoding, target->coordinates))
+    g_warning ("Encoding primaries cannot be represented in protocol units; "
+               "publishing saturated coordinates");
+
+  if (!edid_info)
+    return;
+
+  switch (sources)
+    {
+    case META_COLOR_TARGET_PRIMARIES_SOURCES_NONE:
+      return;
+    case META_COLOR_TARGET_PRIMARIES_SOURCES_DISPLAYID:
+      select_displayid_primaries (target, edid_info);
+      return;
+    case META_COLOR_TARGET_PRIMARIES_SOURCES_BASE_EDID:
+      select_edid_primaries (target, edid_info);
+      return;
+    }
+
+  g_assert_not_reached ();
 }
 
 static gboolean
@@ -1276,21 +1367,27 @@ update_target_volume (MetaColorDevice *color_device)
     colorimetry->type == CLUTTER_COLORIMETRY_TYPE_COLORSPACE ?
     clutter_colorspace_to_primaries (colorimetry->colorspace) : colorimetry->primaries;
   MetaColorTargetPrimaries target_primaries;
-  gboolean declared, hdr, native_hdr;
+  MetaColorTargetPrimariesSources primaries_sources =
+    META_COLOR_TARGET_PRIMARIES_SOURCES_NONE;
+  MetaColorMode color_mode = meta_monitor_get_color_mode (monitor);
+  gboolean declared;
 
   /* The default SDR mode renders into an assumed sRGB encoding, and forced
-   * HDR into an encoding the output did not choose: neither has a target. */
+   * HDR into an encoding the output did not choose: neither has a target.
+   * Target luminance is only selected in BT.2100. Target primaries are the
