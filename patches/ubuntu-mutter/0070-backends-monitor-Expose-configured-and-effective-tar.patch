+static gboolean
+target_override_from_variant (GVariant                *properties,
+                              MetaColorTargetOverride *override,
+                              GError                 **error)
+{
+  GVariantIter iter;
+  const char *name;
+  GVariant *value;
+  gboolean seen_gamut = FALSE;
+
+  g_variant_iter_init (&iter, properties);
+  while (g_variant_iter_next (&iter, "{&sv}", &name, &value))
+    {
+      g_autoptr (GVariant) property = value;
+
+      if (g_str_equal (name, "target-peak-luminance") ||
+          g_str_equal (name, "target-min-luminance"))
+        {
+          gboolean is_peak = g_str_equal (name, "target-peak-luminance");
+          gboolean *present = is_peak ? &override->has_peak : &override->has_min;
+          double number;
+
+          if (*present || !g_variant_is_of_type (value, G_VARIANT_TYPE_DOUBLE))
+            goto invalid_property;
+          number = g_variant_get_double (value);
+          if (!isfinite (number) || number < 0 ||
+              (is_peak && number > G_MAXUINT32) ||
+              (!is_peak && number * 10000 > G_MAXUINT32))
+            goto invalid_property;
+
+          *present = TRUE;
+          if (is_peak)
+            override->peak = (float) number;
+          else
+            override->min = (float) number;
+        }
+      else if (g_str_equal (name, "hdr-gamut-source"))
+        {
+          const char *source;
+
+          if (seen_gamut || !g_variant_is_of_type (value, G_VARIANT_TYPE_STRING))
+            goto invalid_property;
+          seen_gamut = TRUE;
+          source = g_variant_get_string (value, NULL);
+          if (g_str_equal (source, "auto"))
+            override->gamut_source = META_HDR_GAMUT_SOURCE_AUTO;
+          else if (g_str_equal (source, "base-edid"))
+            override->gamut_source = META_HDR_GAMUT_SOURCE_BASE_EDID;
+          else if (g_str_equal (source, "none"))
+            override->gamut_source = META_HDR_GAMUT_SOURCE_NONE;
+          else
+            goto invalid_property;
+        }
+      continue;
+
+invalid_property:
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_FAILED,
+                   "Invalid or duplicate target property '%s'", name);
+      return FALSE;
+    }
+
+  return meta_verify_target_override (override, error);
+}
