+typedef struct
+{
+  gboolean done;
+  GVariant *reply;
+  GError *error;
+} TargetCall;
+
+static void
+target_call_done (GObject      *source,
+                  GAsyncResult *result,
+                  gpointer      user_data)
+{
+  TargetCall *call = user_data;
+
+  call->reply = g_dbus_proxy_call_finish (G_DBUS_PROXY (source), result, &call->error);
+  call->done = TRUE;
+}
+
+static GVariant *
+target_call (GDBusProxy  *proxy,
+             const char  *method,
+             GVariant    *parameters,
+             GError     **error)
+{
+  TargetCall call = { 0 };
+
+  g_dbus_proxy_call (proxy, method, parameters, G_DBUS_CALL_FLAGS_NONE,
+                     5000, NULL, target_call_done, &call);
+  while (!call.done)
+    g_main_context_iteration (NULL, TRUE);
+  if (call.error)
+    g_propagate_error (error, call.error);
+  return call.reply;
+}
+
+static GDBusProxy *
+create_target_proxy (void)
+{
+  GDBusProxy *proxy = NULL;
+
+  g_dbus_proxy_new_for_bus (G_BUS_TYPE_SESSION,
+                            G_DBUS_PROXY_FLAGS_DO_NOT_AUTO_START,
+                            NULL, "org.gnome.Mutter.DisplayConfig",
+                            "/org/gnome/Mutter/DisplayConfig",
+                            "org.gnome.Mutter.DisplayConfig", NULL,
+                            proxy_ready_cb, &proxy);
+  while (!proxy)
+    g_main_context_iteration (NULL, TRUE);
+  return proxy;
+}
+
+static GVariant *
+apply_target_properties (GDBusProxy                *proxy,
+                         MetaMonitorManager        *manager,
+                         MetaMonitor               *monitor,
+                         MetaMonitorsConfigMethod   method,
+                         GVariant                  *properties,
+                         GError                   **error)
+{
+  GVariantBuilder monitors;
+  GVariantBuilder logical;
+
+  g_variant_builder_init (&monitors, G_VARIANT_TYPE ("a(ssa{sv})"));
+  g_variant_builder_add (&monitors, "(ss@a{sv})",
+                         meta_monitor_get_connector (monitor),
+                         meta_monitor_mode_get_id (meta_monitor_get_preferred_mode (monitor)),
+                         g_variant_ref (properties));
+  g_variant_builder_init (&logical, G_VARIANT_TYPE ("a(iiduba(ssa{sv}))"));
+  g_variant_builder_add (&logical, "(iiduba(ssa{sv}))",
+                         0, 0, 1.0, 0, TRUE, &monitors);
+  return target_call (proxy, "ApplyMonitorsConfig",
+                      g_variant_new ("(uua(iiduba(ssa{sv}))a{sv})",
+                                     manager->serial, method, &logical, NULL), error);
+}
+
+static GVariant *
+read_target_properties (GDBusProxy *proxy)
+{
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) state = target_call (proxy, "GetCurrentState", NULL, &error);
+  g_autoptr (GVariant) monitors = NULL;
+  g_autoptr (GVariant) monitor = NULL;
+
+  g_assert_no_error (error);
+  g_assert_nonnull (state);
+  monitors = g_variant_get_child_value (state, 1);
+  monitor = g_variant_get_child_value (monitors, 0);
+  return g_variant_get_child_value (monitor, 2);
+}
+
+static void
+assert_effective_target (GVariant        *properties,
+                         MetaColorDevice *device)
+{
+  const MetaColorTargetLuminance *luminance = meta_color_device_get_target_luminance (device);
+  const MetaColorTargetPrimaries *primaries = meta_color_device_get_target_primaries (device);
+  g_autoptr (GVariant) xy = NULL;
+  const char *source;
+  double minimum, maximum;
+  unsigned int i;
+
+  g_assert_true (g_variant_lookup (properties, "target-luminance", "(dd)",
+                                   &minimum, &maximum));
+  g_assert_cmpfloat (minimum, ==, luminance->minimum);
+  g_assert_cmpfloat (maximum, ==, luminance->maximum);
+  g_assert_true (g_variant_lookup (properties, "target-min-luminance-source", "&s", &source));
+  g_assert_cmpstr (source, ==, meta_color_target_provenance_to_string (luminance->minimum_source));
+  g_assert_true (g_variant_lookup (properties, "target-max-luminance-source", "&s", &source));
+  g_assert_cmpstr (source, ==, meta_color_target_provenance_to_string (luminance->maximum_source));
+  g_assert_true (g_variant_lookup (properties, "target-primaries-source", "&s", &source));
+  g_assert_cmpstr (source, ==, meta_color_target_provenance_to_string (primaries->source));
+  xy = g_variant_lookup_value (properties, "target-primaries", G_VARIANT_TYPE ("(dddddddd)"));
+  g_assert_nonnull (xy);
+  for (i = 0; i < 8; i++)
+    {
+      g_autoptr (GVariant) coordinate = g_variant_get_child_value (xy, i);
+
+      g_assert_cmpfloat (g_variant_get_double (coordinate), ==,
+                         meta_color_chromaticity_from_fixed (primaries->coordinates[i]));
+    }
+}
+
+static void
+meta_test_monitor_target_dbus (void)
+{
+  MonitorTestCaseSetup setup = {
+    .modes = { { .width = 800, .height = 600, .refresh_rate = 60 } },
+    .n_modes = 1,
+    .outputs = { {
+      .crtc = 0, .modes = { 0 }, .n_modes = 1, .preferred_mode = 0,
+      .possible_crtcs = { 0 }, .n_possible_crtcs = 1,
+      .width_mm = 222, .height_mm = 125,
+      .supported_color_spaces = 1 << META_OUTPUT_COLORSPACE_BT2020,
+      .supported_hdr_eotfs = 1 << META_OUTPUT_HDR_METADATA_EOTF_PQ,
+    } },
+    .n_outputs = 1,
+    .crtcs = { { .current_mode = 0, .disable_gamma_lut = TRUE } },
+    .n_crtcs = 1,
+  };
+  const char *invalid[] = {
+    "{'target-peak-luminance': <'400'>}",
+    "{'target-peak-luminance': <uint32 400>}",
+    "{'target-min-luminance': <false>}",
+    "{'hdr-gamut-source': <uint32 0>}",
+    "{'hdr-gamut-source': <'unknown'>}",
+    "{'target-peak-luminance': <double nan>}",
+    "{'target-peak-luminance': <double inf>}",
+    "{'target-peak-luminance': <double 203>}",
+    "{'target-peak-luminance': <double 0>}",
+    "{'target-peak-luminance': <double 4294967296>}",
+    "{'target-min-luminance': <double 0>}",
+    "{'target-peak-luminance': <double 400>, 'target-min-luminance': <double -1>}",
+    "{'target-peak-luminance': <double 400.5>, 'target-min-luminance': <double 400>}",
+    "{'target-peak-luminance': <double 500000>, 'target-min-luminance': <double 429496.75>}",
+    "{'target-peak-luminance': <double 400>, 'target-peak-luminance': <double 600>}",
+    "{'hdr-gamut-source': <'auto'>, 'hdr-gamut-source': <'none'>}",
+  };
+  MetaBackend *backend = meta_context_get_backend (test_context);
+  MetaMonitorManager *manager = meta_backend_get_monitor_manager (backend);
+  MetaColorManager *color_manager = meta_backend_get_color_manager (backend);
+  MetaMonitor *monitor;
+  MetaColorDevice *device;
+  MetaMonitorsConfig *before;
+  g_autoptr (GDBusProxy) proxy = create_target_proxy ();
+  g_autoptr (GVariant) valid = NULL;
+  g_autoptr (GVariant) reply = NULL;
+  g_autoptr (GVariant) properties = NULL;
+  g_autoptr (GError) error = NULL;
+  double peak, minimum;
+  const char *source;
+  size_t i;
+
+  meta_emulate_hotplug (meta_create_monitor_test_setup (backend, &setup,
+                                                       MONITOR_TEST_FLAG_NO_STORED));
+  monitor = meta_monitor_manager_get_monitors (manager)->data;
+  device = meta_color_manager_get_color_device (color_manager, monitor);
+  g_assert_nonnull (device);
+  valid = g_variant_parse (G_VARIANT_TYPE_VARDICT,
+    "{'color-mode': <uint32 1>, 'target-peak-luminance': <double 400>, "
+    "'target-min-luminance': <double 0>, 'hdr-gamut-source': <'none'>}",
+    NULL, NULL, &error);
+  g_assert_no_error (error);
+  before = meta_monitor_config_manager_get_current (manager->config_manager);
+  reply = apply_target_properties (proxy, manager, monitor,
+                                   META_MONITORS_CONFIG_METHOD_VERIFY, valid, &error);
+  g_assert_no_error (error);
+  g_assert_nonnull (reply);
+  g_clear_pointer (&reply, g_variant_unref);
+  g_assert_true (before == meta_monitor_config_manager_get_current (manager->config_manager));
+  g_assert_false (meta_monitor_get_target_override (monitor)->has_peak);
+
+  reply = apply_target_properties (proxy, manager, monitor,
+                                   META_MONITORS_CONFIG_METHOD_TEMPORARY, valid, &error);
+  g_assert_no_error (error);
+  g_assert_nonnull (reply);
+  g_clear_pointer (&reply, g_variant_unref);
+  meta_color_device_set_reference_luminance_factor (device, 2.1f);
+  properties = read_target_properties (proxy);
+  g_assert_true (g_variant_lookup (properties, "target-peak-luminance", "d", &peak));
+  g_assert_true (g_variant_lookup (properties, "target-min-luminance", "d", &minimum));
+  g_assert_cmpfloat (peak, ==, 400);
+  g_assert_cmpfloat (minimum, ==, 0);
+  g_assert_true (g_variant_lookup (properties, "hdr-gamut-source", "&s", &source));
+  g_assert_cmpstr (source, ==, "none");
+  assert_effective_target (properties, device);
+  /* The integrated selector must honor 400 even at ~426 cd/m² scaled white. */
+  g_assert_cmpfloat (meta_color_device_get_target_luminance (device)->maximum, ==, 400);
+  g_assert_true (g_variant_lookup (properties, "target-max-luminance-source", "&s", &source));
+  g_assert_cmpstr (source, ==, "user-declared");
+
+  before = meta_monitor_config_manager_get_current (manager->config_manager);
+  for (i = 0; i < G_N_ELEMENTS (invalid); i++)
+    {
+      g_autoptr (GVariant) malformed = g_variant_parse (G_VARIANT_TYPE_VARDICT,
+                                                      invalid[i], NULL, NULL, &error);
+
+      g_assert_no_error (error);
+      reply = apply_target_properties (proxy, manager, monitor,
+                                       META_MONITORS_CONFIG_METHOD_TEMPORARY,
+                                       malformed, &error);
+      g_assert_null (reply);
+      g_assert_nonnull (error);
+      g_clear_error (&error);
+      g_assert_true (before == meta_monitor_config_manager_get_current (manager->config_manager));
+      g_assert_cmpfloat (meta_monitor_get_target_override (monitor)->peak, ==, 400);
+    }
+
+  /* Persistent proposals use the ordinary rejection/restore lifecycle. */
+  g_clear_pointer (&valid, g_variant_unref);
+  valid = g_variant_parse (G_VARIANT_TYPE_VARDICT,
+    "{'color-mode': <uint32 1>, 'target-peak-luminance': <double 600>}",
+    NULL, NULL, &error);
+  g_assert_no_error (error);
+  reply = apply_target_properties (proxy, manager, monitor,
+                                   META_MONITORS_CONFIG_METHOD_PERSISTENT, valid, &error);
+  g_assert_no_error (error);
+  g_clear_pointer (&reply, g_variant_unref);
+  g_assert_cmpfloat (meta_monitor_get_target_override (monitor)->peak, ==, 600);
+  meta_monitor_manager_confirm_configuration (manager, FALSE);
+  while (manager->restore_config_id)
+    g_main_context_iteration (NULL, TRUE);
+  g_assert_cmpfloat (meta_monitor_get_target_override (monitor)->peak, ==, 400);
+
+  /* Omission replaces the declaration, rather than silently retaining it. */
+  g_clear_pointer (&valid, g_variant_unref);
+  valid = g_variant_parse (G_VARIANT_TYPE_VARDICT, "{}", NULL, NULL, &error);
+  g_assert_no_error (error);
+  reply = apply_target_properties (proxy, manager, monitor,
+                                   META_MONITORS_CONFIG_METHOD_TEMPORARY, valid, &error);
+  g_assert_no_error (error);
+  g_assert_false (meta_monitor_get_target_override (monitor)->has_peak);
+  g_assert_false (meta_monitor_get_target_override (monitor)->has_min);
+  g_assert_cmpint (meta_monitor_get_target_override (monitor)->gamut_source, ==,
+                   META_HDR_GAMUT_SOURCE_AUTO);
+  g_clear_pointer (&properties, g_variant_unref);
+  properties = read_target_properties (proxy);
+  assert_effective_target (properties, device);
+  g_assert_null (g_variant_lookup_value (properties, "target-peak-luminance", NULL));
+}
+
 static void
 init_dbus_tests (void)
 {
+  meta_add_monitor_test ("/backends/monitor/target-overrides-dbus",
+                         meta_test_monitor_target_dbus);
   meta_add_monitor_test ("/backends/monitor/has-external-monitor",
                          meta_test_monitor_has_external_monitor);
 }
