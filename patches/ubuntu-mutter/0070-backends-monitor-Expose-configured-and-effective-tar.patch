+static void
+append_monitor_target_properties (MetaMonitorManager *manager,
+                                  MetaMonitor        *monitor,
+                                  GVariantBuilder    *properties)
+{
+  const MetaColorTargetOverride *override = meta_monitor_get_target_override (monitor);
+  MetaColorManager *color_manager = meta_backend_get_color_manager (manager->backend);
+  MetaColorDevice *device = meta_color_manager_get_color_device (color_manager, monitor);
+  const MetaColorTargetLuminance *luminance;
+  const MetaColorTargetPrimaries *primaries;
+  double xy[8];
+  unsigned int i;
+
+  if (override->has_peak)
+    g_variant_builder_add (properties, "{sv}", "target-peak-luminance",
+                           g_variant_new_double (override->peak));
+  if (override->has_min)
+    g_variant_builder_add (properties, "{sv}", "target-min-luminance",
+                           g_variant_new_double (override->min));
+  if (override->gamut_source != META_HDR_GAMUT_SOURCE_AUTO)
+    g_variant_builder_add (properties, "{sv}", "hdr-gamut-source",
+                           g_variant_new_string (hdr_gamut_source_to_string (override->gamut_source)));
+
+  /* Do not reconstruct selection from EDID or the requested configuration:
+   * report the state actually used by the applied color device. */
+  if (!meta_monitor_is_active (monitor) || !device ||
+      !meta_color_device_get_color_state (device))
+    return;
+
+  luminance = meta_color_device_get_target_luminance (device);
+  primaries = meta_color_device_get_target_primaries (device);
+  g_variant_builder_add (properties, "{sv}", "target-luminance",
+                         g_variant_new ("(dd)", (double) luminance->minimum,
+                                               (double) luminance->maximum));
+  g_variant_builder_add (properties, "{sv}", "target-min-luminance-source",
+                         g_variant_new_string (meta_color_target_provenance_to_string (luminance->minimum_source)));
+  g_variant_builder_add (properties, "{sv}", "target-max-luminance-source",
+                         g_variant_new_string (meta_color_target_provenance_to_string (luminance->maximum_source)));
+  for (i = 0; i < G_N_ELEMENTS (xy); i++)
+    xy[i] = meta_color_chromaticity_from_fixed (primaries->coordinates[i]);
+  g_variant_builder_add (properties, "{sv}", "target-primaries",
+                         g_variant_new ("(dddddddd)", xy[0], xy[1], xy[2], xy[3],
+                                                     xy[4], xy[5], xy[6], xy[7]));
+  g_variant_builder_add (properties, "{sv}", "target-primaries-source",
+                         g_variant_new_string (meta_color_target_provenance_to_string (primaries->source)));
+}
