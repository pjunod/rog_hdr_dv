 src/backends/meta-color-device.c              |  10 +-
 src/backends/meta-color-device.h              |   4 +
 src/backends/meta-monitor-manager-private.h   |   1 +
 src/backends/meta-monitor-manager.c           | 136 +++++++++
 src/tests/monitor-dbus-tests.c                | 265 ++++++++++++++++++
 6 files changed, 440 insertions(+), 5 deletions(-)

diff --git a/data/dbus-interfaces/org.gnome.Mutter.DisplayConfig.xml b/data/dbus-interfaces/org.gnome.Mutter.DisplayConfig.xml
index 1fdc2ef..f435eb8 100644
--- a/data/dbus-interfaces/org.gnome.Mutter.DisplayConfig.xml
+++ b/data/dbus-interfaces/org.gnome.Mutter.DisplayConfig.xml
@@ -398,6 +398,22 @@
 	    - "color-mode" (u): current color mode
 	    - "supported-color-modes" (au): list of supported color modes
 	    - "rgb-range" (u): current RGB quantization range
+	    - "target-peak-luminance" (d): configured target peak in cd/m²,
+	      present only when explicitly set
+	    - "target-min-luminance" (d): configured target black in cd/m²,
+	      present only when explicitly set (zero is a valid black level)
+	    - "hdr-gamut-source" (s): configured HDR gamut policy, "base-edid"
+	      or "none"; absence means "auto"
+	    - "target-luminance" (dd): effective minimum and maximum in cd/m²
+	    - "target-min-luminance-source" (s): effective minimum provenance
+	    - "target-max-luminance-source" (s): effective maximum provenance
+	    - "target-primaries" (dddddddd): effective CIE1931 xy, R, G, B, W
+	    - "target-primaries-source" (s): effective gamut provenance
+
+        Effective targets are read from the applied color device and are
+        present only for active monitors with an initialized color state.
+        Sources are "encoding-fallback", "firmware-declared", "cta-declared",
+        "edid-declared" or "user-declared". None is a measurement.
 
         Possible mode flags:
           1 : preferred mode
@@ -510,6 +526,19 @@
 					      is supported (see GetCurrentState).
 		- "color-mode" (u): selected color mode. Defaults to
 				    "default". See GetCurrentState().
+		- "target-peak-luminance" (d): finite target peak in cd/m²,
+		  greater than nominal PQ reference white (203), at most 4294967295
+		- "target-min-luminance" (d): optional finite nonnegative black
+		  in cd/m²; requires a peak, must be below its integer part and
+		  at most 429496.7295
+		- "hdr-gamut-source" (s): "auto", "base-edid" or "none"
+
+        Target fields replace the previous declaration: omitted fields reset
+        to encoding black, no peak override and automatic gamut respectively.
+        A minimum without a peak, wrong types, duplicate fields, invalid
+        enums or invalid ranges reject the whole request before mutation.
+        Overrides do not force a color mode; they affect BT.2100 targets only.
+        VERIFY validates but does not change the applied output or its target.
 
 	@properties may effect the global monitor configuration state. Possible
 	properties are:
