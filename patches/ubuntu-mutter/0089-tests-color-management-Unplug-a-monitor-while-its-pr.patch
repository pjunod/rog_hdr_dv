From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude Agent <claude-agent@invalid>
Date: Mon, 12 Oct 2026 13:49:00 +0000
Subject: [PATCH] tests/color-management: Unplug a monitor while its profile is
 generated

Unplug a monitor while its device profile is being generated, wait for
the generation to end and for the cancelled requests to complete, and
check that colord no longer has its device.
---
 src/tests/color-management-tests.c | 68 ++++++++++++++++++++++++++++++
 1 file changed, 68 insertions(+)

diff --git a/src/tests/color-management-tests.c b/src/tests/color-management-tests.c
index 5555dcc..6f8197c 100644
--- a/src/tests/color-management-tests.c
+++ b/src/tests/color-management-tests.c
@@ -24,6 +24,7 @@
 #include "backends/meta-color-device.h"
 #include "backends/meta-color-manager-private.h"
 #include "backends/meta-color-profile.h"
+#include "backends/meta-color-store.h"
 #include "backends/meta-crtc.h"
 #include "backends/meta-monitor-manager-private.h"
 #include "backends/meta-monitor-private.h"
@@ -798,6 +799,71 @@ meta_test_color_management_device_moved_connector (void)
   wait_for_device_registered (color_device);
 }
 
+/*
+ * A monitor that is unplugged while its device profile is being generated
+ * cancels its setup. The generation still runs to its end and holds the last
+ * reference to the color device, so the cancelled profile request completes
+ * after the device is gone. The profile it made, which nothing wants any
+ * more, then goes away, possibly while colord is still creating it.
+ */
+static void
+meta_test_color_management_device_unplug_during_setup (void)
+{
+  MetaBackend *backend = meta_context_get_backend (test_context);
+  MetaMonitorManager *monitor_manager =
+    meta_backend_get_monitor_manager (backend);
+  MetaMonitorManagerTest *monitor_manager_test =
+    META_MONITOR_MANAGER_TEST (monitor_manager);
+  MetaColorManager *color_manager =
+    meta_backend_get_color_manager (backend);
+  MetaColorStore *color_store =
+    meta_color_manager_get_color_store (color_manager);
+  MonitorTestCaseSetup test_case_setup = base_monitor_setup;
+  MetaMonitorTestSetup *test_setup;
+  MetaMonitor *monitor;
+  MetaColorDevice *color_device;
+  g_autofree char *cd_device_id = NULL;
+
+  while (meta_color_store_has_pending_profiles (color_store))
+    g_main_context_iteration (NULL, TRUE);
+
+  test_case_setup.outputs[0].serial = "device_unplug_during_setup/serial";
+  test_case_setup.n_outputs = 1;
+  test_case_setup.n_crtcs = 1;
+  test_setup = meta_create_monitor_test_setup (backend, &test_case_setup,
+                                               MONITOR_TEST_FLAG_NO_STORED);
+  meta_monitor_manager_test_emulate_hotplug (monitor_manager_test, test_setup);
+
+  monitor =
+    META_MONITOR (meta_monitor_manager_get_monitors (monitor_manager)->data);
+  g_assert_null (meta_monitor_get_edid_checksum_md5 (monitor));
+  g_assert_true (meta_monitor_supports_gamma_lut (monitor));
+  color_device = meta_color_manager_get_color_device (color_manager, monitor);
+  g_assert_nonnull (color_device);
+  cd_device_id = g_strdup (meta_color_device_get_id (color_device));
+
+  while (!meta_color_store_has_pending_profiles (color_store))
+    g_main_context_iteration (NULL, TRUE);
+  g_assert_false (meta_color_device_is_ready (color_device));
+
+  test_case_setup.n_outputs = 0;
+  test_setup = meta_create_monitor_test_setup (backend, &test_case_setup,
+                                               MONITOR_TEST_FLAG_NO_STORED);
+  meta_monitor_manager_test_emulate_hotplug (monitor_manager_test, test_setup);
+  g_assert_cmpint (meta_color_manager_get_num_color_devices (color_manager),
+                   ==,
+                   0);
+
+  while (meta_color_store_has_pending_profiles (color_store))
+    g_main_context_iteration (NULL, TRUE);
+
+  /* The cancelled profile request of the gone device completes in the
+   * following iterations, and so does the colord creation of the profile,
+   * cancelled if colord has not answered it yet. */
+  g_assert_false (colord_has_device (cd_device_id));
+  while (g_main_context_iteration (NULL, FALSE));
+}
+
 static void
 meta_test_color_management_device_no_edid_no_gamma (void)
 {
@@ -2343,6 +2409,8 @@ init_tests (void)
                   meta_test_color_management_device_unplug_referenced);
   add_color_test ("/color-management/device/moved-connector",
                   meta_test_color_management_device_moved_connector);
+  add_color_test ("/color-management/device/unplug-during-setup",
+                  meta_test_color_management_device_unplug_during_setup);
   add_color_test ("/color-management/profile/device",
                   meta_test_color_management_profile_device);
   add_color_test ("/color-management/profile/device-bogus",
