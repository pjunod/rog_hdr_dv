From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: HDR Engineering <hdr-engineering@users.noreply.github.com>
Date: Mon, 12 Oct 2026 21:45:02 +0000
Subject: [PATCH] backend: destroy the owned Clutter event source before
 releasing its context

---
 src/backends/meta-backend.c | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/src/backends/meta-backend.c b/src/backends/meta-backend.c
index e6571ae..6f0daa3 100644
--- a/src/backends/meta-backend.c
+++ b/src/backends/meta-backend.c
@@ -167,6 +167,7 @@ struct _MetaBackendPrivate
 #endif
 
   ClutterContext *clutter_context;
+  GSource *clutter_source;
   ClutterSeat *default_seat;
   ClutterActor *stage;
 
@@ -223,6 +224,12 @@ meta_backend_dispose (GObject *object)
   MetaBackend *backend = META_BACKEND (object);
   MetaBackendPrivate *priv = meta_backend_get_instance_private (backend);
 
+  if (priv->clutter_source)
+    {
+      g_source_destroy (priv->clutter_source);
+      g_clear_pointer (&priv->clutter_source, g_source_unref);
+    }
+
   g_clear_pointer (&priv->cursor_tracker, meta_cursor_tracker_destroy);
   g_clear_object (&priv->current_device);
   g_clear_object (&priv->monitor_manager);
@@ -1212,7 +1219,7 @@ init_clutter (MetaBackend  *backend,
   backend_source = (MetaBackendSource *) source;
   backend_source->backend = backend;
   g_source_attach (source, main_context);
-  g_source_unref (source);
+  priv->clutter_source = source;
 
   return TRUE;
 }
