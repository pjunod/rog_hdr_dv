  clutter_color_state_params_nominal_max_is_content_peak@Base 51.0-1ubuntu3+nativehdr8~
  clutter_color_state_required_format@Base 47.0
diff --git a/src/tests/clutter/conform/color-hdr.c b/src/tests/clutter/conform/color-hdr.c
index 1984eed..017e261 100644
--- a/src/tests/clutter/conform/color-hdr.c
+++ b/src/tests/clutter/conform/color-hdr.c
@@ -666,6 +666,54 @@ create_with_target_volume (ClutterColorState *color_state,
                                                             &target_volume);
 }
 
+/* Reproduce the integer values a PQ Vulkan client can signal for a
+ * display with a different reference white. */
+static void
+mapping_wire_peak (void)
+{
+  g_autoptr (ClutterColorState) output = create_pq_output (142.0f);
+  g_autoptr (ClutterColorState) target = create_targeted_blending (output, 616.0f, FALSE);
+  g_autoptr (ClutterColorState) pq = create_pq_output (203.0f);
+  static const struct {
+    float mastering_max;
+    float max_cll;
+    gboolean exact_maps;
+    gboolean wire_maps;
+  } cases[] = {
+    { 880.0f, 0.0f, FALSE, FALSE },
+    { 881.0f, 0.0f, TRUE,  FALSE },
+    { 882.0f, 0.0f, TRUE,  TRUE  },
+    { 0.0f, 881.0f, TRUE,  FALSE },
+    { 882.0f, 881.0f, TRUE, FALSE },
+    { 882.0f, 882.0f, TRUE, TRUE },
+    { 0.0f, 0.0f, FALSE, FALSE },
+  };
+
+  for (size_t i = 0; i < G_N_ELEMENTS (cases); i++)
+    {
+      ClutterColorTargetVolume volume = {
+        .has_luminance = cases[i].mastering_max > 0.0f,
+        .max_lum = cases[i].mastering_max,
+        .max_cll = cases[i].max_cll,
+      };
+      g_autoptr (ClutterColorState) exact =
+        clutter_color_state_params_new_with_target_volume (CLUTTER_COLOR_STATE_PARAMS (pq),
+                                                           &volume);
+      g_autoptr (ClutterColorState) wire =
+        clutter_color_state_params_new_with_integer_peak_volume (CLUTTER_COLOR_STATE_PARAMS (pq),
+                                                                 &volume);
+
+      /* Alternate states with identical numeric peaks through the shared
+       * renderer and plane-eligibility decision cache. */
+      g_assert_cmpint (clutter_color_transform_requires_highlight_mapping (exact, target),
+                       ==, cases[i].exact_maps);
+      g_assert_cmpint (clutter_color_transform_requires_highlight_mapping (wire, target),
+                       ==, cases[i].wire_maps);
+      g_assert_cmpint (clutter_color_transform_requires_highlight_mapping (exact, target),
+                       ==, cases[i].exact_maps);
+    }
+}
+
 static void
 mapping_predicate (void)
 {
@@ -3898,6 +3946,7 @@ CLUTTER_TEST_SUITE (
   CLUTTER_TEST_UNIT ("/color-hdr/hlg/cicp", hlg_from_cicp)
   CLUTTER_TEST_UNIT ("/color-hdr/hlg/parameters-validity", hlg_parameters_validity)
   CLUTTER_TEST_UNIT ("/color-hdr/hlg/shader-matches-cpu", hlg_shader_matches_cpu)
+  CLUTTER_TEST_UNIT ("/color-hdr/mapping/wire-peak", mapping_wire_peak)
   CLUTTER_TEST_UNIT ("/color-hdr/mapping/predicate", mapping_predicate)
   CLUTTER_TEST_UNIT ("/color-hdr/mapping/extended-range-peak", mapping_extended_range_peak)
   CLUTTER_TEST_UNIT ("/color-hdr/mapping/undeclared-pq-peak", mapping_undeclared_pq_peak)
diff --git a/src/wayland/meta-wayland-color-management.c b/src/wayland/meta-wayland-color-management.c
index b653fef..199f36f 100644
--- a/src/wayland/meta-wayland-color-management.c
+++ b/src/wayland/meta-wayland-color-management.c
