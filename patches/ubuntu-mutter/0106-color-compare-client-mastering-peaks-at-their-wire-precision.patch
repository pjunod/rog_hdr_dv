           g_autoptr (ClutterColorState) encoding = g_steal_pointer (&color_state);
 
           color_state =
-            clutter_color_state_params_new_with_target_volume (CLUTTER_COLOR_STATE_PARAMS (encoding),
-                                                               &creator_params->target_volume);
+            clutter_color_state_params_new_with_integer_peak_volume (CLUTTER_COLOR_STATE_PARAMS (encoding),
+                                                                     &creator_params->target_volume);
         }
 
       meta_wayland_image_description_set_ready (image_desc,
