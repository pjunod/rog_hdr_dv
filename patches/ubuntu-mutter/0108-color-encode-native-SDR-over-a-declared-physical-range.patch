diff --git a/src/backends/meta-color-device.c b/src/backends/meta-color-device.c
index cf2f112..b91d36a 100644
--- a/src/backends/meta-color-device.c
+++ b/src/backends/meta-color-device.c
@@ -1052,6 +1052,79 @@ meta_color_target_luminance_init (MetaColorTargetLuminance      *target,
   select_cta_luminance (target, edid_info, encoding);
 }
 
+/*
+ * The reference white of the native-gamma HDR route at the default
+ * brightness: the HDR reference white of BT.2408, to which a PQ grade
+ * anchors its SDR white, so that at the default brightness a grade is shown
+ * at its graded luminance.
+ */
+#define NATIVE_HDR_REFERENCE_WHITE 203.0f
+
+/*
+ * The physical range of the native-gamma HDR route (docs/NATIVE_GAMMA_HDR.md
+ * in the rog_hdr_dv repository), if @monitor is on it: a built-in panel in
+ * the native SDR mode, active, HDR not forced, with a declared target peak
+ * above NATIVE_HDR_REFERENCE_WHITE. Only a built-in panel: the declared peak
+ * is its peak at the full backlight the route holds, and an external
+ * monitor has no backlight the compositor holds. The output then stays gamma 2.2 over its
+ * native primaries, but its encoding spans the declared range rather than
+ * the 80 cd/m2 of SDR. Black is the declared minimum, or the ideal zero:
+ * nothing else is known about it. Only the declaration selects the route;
+ * firmware describes no physical luminance for a gamma 2.2 panel.
+ *
+ * This reads the monitor, not the device, so that the backlight selection,
+ * made when the output is configured, and the color state agree.
+ */
+static gboolean
+get_native_hdr_range (MetaMonitor              *monitor,
+                      MetaColorTargetLuminance *range)
+{
+  MetaBackend *backend = meta_monitor_get_backend (monitor);
+  MetaDebugControl *debug_control =
+    meta_context_get_debug_control (meta_backend_get_context (backend));
+  ClutterLuminance encoding = {
+    .type = CLUTTER_LUMINANCE_TYPE_EXPLICIT,
+    .min = 0.0f,
+    .ref = NATIVE_HDR_REFERENCE_WHITE,
+  };
+
+  if (!meta_monitor_is_builtin (monitor) ||
+      !meta_monitor_is_active (monitor) ||
+      meta_debug_control_is_hdr_forced (debug_control) ||
+      meta_monitor_get_color_mode (monitor) != META_COLOR_MODE_SDR_NATIVE)
+    return FALSE;
+
+  return select_user_luminance (range,
+                                meta_monitor_get_target_override (monitor),
+                                &encoding);
+}
+
+/*
+ * The reference white of the native-gamma HDR route at reference factor
+ * @factor: NATIVE_HDR_REFERENCE_WHITE scaled, in whole cd/m2 as published,
+ * and kept strictly inside @range, above its black and below its peak. The
+ * reference-white backlight reaches a factor of 2.1, which would put SDR
+ * white above a peak below 426 cd/m2 and clip it; brightness above the
+ * peak has nothing physical to show, so SDR white stops just below it.
+ */
+static float
+get_native_hdr_reference (const MetaColorTargetLuminance *range,
+                          float                           factor)
+{
+  float reference = roundf (NATIVE_HDR_REFERENCE_WHITE * factor);
+
+  reference = MAX (reference, floorf (range->minimum) + 1.0f);
+  return MIN (reference, ceilf (range->maximum) - 1.0f);
+}
+
+gboolean
+meta_color_device_is_native_hdr (MetaMonitor *monitor)
+{
+  MetaColorTargetLuminance range;
+
+  return get_native_hdr_range (monitor, &range);
+}
+
 static gboolean
 target_luminance_equal (const MetaColorTargetLuminance *a,
                         const MetaColorTargetLuminance *b)
@@ -1448,6 +1521,19 @@ get_target_encoding_luminance (ClutterColorStateParams *color_state_params,
   return luminance;
 }
 
+/* As get_target_encoding_luminance(), on the native-gamma HDR route: with
+ * its reference white at the default brightness, which selects the route.
+ * At other brightnesses the reference white is kept inside the declared
+ * range (see get_native_hdr_reference()). */
+static const ClutterLuminance *
+get_native_hdr_encoding_luminance (ClutterColorStateParams *color_state_params,
+                                   ClutterLuminance        *luminance)
+{
+  *luminance = *clutter_color_state_params_get_luminance (color_state_params);
+  luminance->ref = NATIVE_HDR_REFERENCE_WHITE;
+  return luminance;
+}
