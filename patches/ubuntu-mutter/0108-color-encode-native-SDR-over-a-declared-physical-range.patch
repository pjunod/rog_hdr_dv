+   * encoding spans the same range (see get_native_hdr_range()).
    * Target primaries in BT.2100 follow the override's gamut source, by
    * default the DisplayID physical gamut; in the native SDR mode they are
    * the base EDID gamut it encodes in, whatever the override. */
@@ -1487,7 +1578,8 @@ update_target_volume (MetaColorDevice *color_device)
   else if (declared && color_mode == META_COLOR_MODE_SDR_NATIVE)
     primaries_sources = META_COLOR_TARGET_PRIMARIES_SOURCES_BASE_EDID;
   meta_color_target_luminance_init (&target, info->edid_info, override,
-                                    declared && color_mode == META_COLOR_MODE_BT2100,
+                                    declared && (color_mode == META_COLOR_MODE_BT2100 ||
+                                                 native_hdr),
                                     encoding);
   meta_color_target_primaries_init (&target_primaries, info->edid_info, override,
                                     primaries_sources, encoding_primaries);
@@ -1730,6 +1822,7 @@ update_color_state (MetaColorDevice *color_device)
   g_auto (ClutterColorimetry) colorimetry = { 0 };
   ClutterEOTF eotf;
   ClutterLuminance luminance;
+  MetaColorTargetLuminance native_range;
   UpdateResult result = 0;
 
   get_color_metadata_from_monitor (color_device, &colorimetry, &eotf);
@@ -1743,9 +1836,26 @@ update_color_state (MetaColorDevice *color_device)
     }
 
   luminance = *clutter_eotf_get_default_luminance (eotf);
-  /* Whole cd/m², as the Wayland image descriptions publish it, so that a
-   * client copying the published reference luminance gets this one. */
-  luminance.ref = roundf (luminance.ref * color_device->reference_luminance_factor);
+  /* On the native-gamma HDR route the gamma 2.2 encoding spans the declared
+   * physical range, with SDR white at the HDR reference white: full code is
+   * the declared peak, not SDR white. Clutter maps luminance relative to the
+   * peak, so a declared black is published and targeted, not subtracted. */
+  if (get_native_hdr_range (color_device->monitor, &native_range))
+    {
+      luminance.type = CLUTTER_LUMINANCE_TYPE_EXPLICIT;
+      luminance.min = native_range.minimum;
+      luminance.max = native_range.maximum;
+      luminance.ref =
+        get_native_hdr_reference (&native_range,
+                                  color_device->reference_luminance_factor);
+      luminance.mastering_max = native_range.maximum;
+    }
+  else
+    {
+      /* Whole cd/m², as the Wayland image descriptions publish it, so that a
+       * client copying the published reference luminance gets this one. */
+      luminance.ref = roundf (luminance.ref * color_device->reference_luminance_factor);
+    }
 
   color_state = clutter_color_state_params_new_from_primitives (clutter_context,
                                                                 colorimetry,
