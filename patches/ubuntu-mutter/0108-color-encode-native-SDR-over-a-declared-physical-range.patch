 }
 
+/* The PQ code value of @luminance cd/m² (SMPTE ST 2084). */
+static float
+pq_encode (double luminance)
+{
+  const double m1 = 2610.0 / 16384.0, m2 = 2523.0 / 4096.0 * 128.0;
+  const double c1 = 3424.0 / 4096.0, c2 = 2413.0 / 4096.0 * 32.0;
+  const double c3 = 2392.0 / 4096.0 * 32.0;
+  double y = pow (luminance / 10000.0, m1);
+
+  return (float) pow ((c1 + c2 * y) / (1.0 + c3 * y), m2);
+}
+
+/* The signal of a neutral PQ pixel of @luminance cd/m² converted to
+ * @output_state, the output encoding or a rendering state targeting it. */
+static void
+assert_native_signal (ClutterColorState *output_state,
+                      double             luminance,
+                      double             expected)
+{
+  ClutterContext *context = clutter_color_state_get_context (output_state);
+  g_autoptr (ClutterColorState) pq = NULL;
+  ClutterColorTransform *transform;
+  float code = pq_encode (luminance);
+  float pixel[4] = { code, code, code, 1.0f };
+  unsigned int i;
+
+  pq = clutter_color_state_params_new (context, CLUTTER_COLORSPACE_BT2020,
+                                       CLUTTER_TRANSFER_FUNCTION_PQ);
+  transform = clutter_color_transform_from_color_states (context, pq,
+                                                         output_state, 0);
+  clutter_color_pipeline_do_transform (clutter_color_transform_get_pipeline (transform),
+                                       pixel, 1);
+  for (i = 0; i < 3; i++)
+    g_assert_cmpfloat_with_epsilon (pixel[i], expected, 2e-4);
+}
+
+/* The luminance of the output color state of @device. */
+static const ClutterLuminance *
+get_output_luminance (MetaColorDevice *device)
+{
+  ClutterColorState *state = meta_color_device_get_color_state (device);
+
+  return clutter_color_state_params_get_luminance (CLUTTER_COLOR_STATE_PARAMS (state));
+}
+
+/*
+ * The native-gamma HDR route (docs/NATIVE_GAMMA_HDR.md in the rog_hdr_dv
+ * repository) on a built-in gamma 2.2 panel with a wide base EDID gamut and
+ * no HDR declaration. Without an override the native SDR mode is exactly
+ * SDR, published as before. A declared 500 cd/m² peak makes the gamma 2.2
+ * encoding span 0–500 cd/m², with SDR white at 203 cd/m² scaled by the
+ * reference factor, the same range as the luminance target, and the range
+ * published. A neutral PQ grade encodes as (L / 500)^(1/2.2) — 1, 0.6638 and
+ * 0.4347 at 500, 203 and 80 cd/m² — both into the encoding and through the
+ * rendering state, which maps nothing below the peak. Clutter maps relative
+ * to the peak, so a declared black is published and targeted but does not
+ * move the signal. SDR white stays strictly inside the declared range at
+ * every reference factor the backlight reaches. A peak not above 203 cd/m²,
+ * and forced HDR, leave the route.
+ */
+static void
+native_gamma_hdr_route (void)
+{
+  MetaBackend *backend = meta_context_get_backend (test_context);
+  MetaColorManager *manager = meta_backend_get_color_manager (backend);
+  MetaOutput *output = meta_virtual_monitor_get_output (virtual_monitor);
+  MetaMonitor *monitor = meta_output_get_monitor (output);
+  MetaOutputInfo *info = (MetaOutputInfo *) meta_output_get_info (output);
+  MetaColorDevice *device = meta_color_manager_get_color_device (manager, monitor);
+  MetaColorTargetOverride override = {
+    .has_peak = TRUE,
+    .peak = 500,
+    .gamut_source = META_HDR_GAMUT_SOURCE_AUTO,
+  };
+  const MetaColorTargetLuminance *target;
+  const ClutterLuminance *lum;
+  ClutterColorState *state;
+  int32_t wide_gamut[8];
+
+  get_wide_gamut_coordinates (wide_gamut);
+
+  info->connector_type = META_CONNECTOR_TYPE_eDP;
+  info->supported_hdr_eotfs = 0;
+  info->supported_color_spaces = 0;
+  g_clear_pointer (&info->edid_info, meta_edid_info_free);
+  info->edid_info = g_new0 (MetaEdidInfo, 1);
+  info->edid_info->default_gamma = 2.2;
+  set_wide_gamut_base_primaries (info->edid_info);
+
+  /* Without a declared peak, native SDR is SDR. */
+  set_test_color_mode (output, META_COLOR_MODE_SDR_NATIVE);
+  meta_color_device_update (device);
+  g_assert_false (meta_color_device_is_native_hdr (monitor));
+  state = meta_color_device_get_color_state (device);
+  lum = clutter_color_state_params_get_luminance (CLUTTER_COLOR_STATE_PARAMS (state));
+  g_assert_cmpfloat (lum->min, ==, 0.2f);
+  g_assert_cmpfloat (lum->max, ==, 80.0f);
+  g_assert_cmpfloat (lum->ref, ==, 80.0f);
+  g_assert_cmpint (meta_color_device_get_target_luminance (device)->maximum_source,
+                   ==, META_COLOR_TARGET_ENCODING_FALLBACK);
+  check_published_target (output, 2000, 80, wide_gamut, wide_gamut);
+
+  /* A declared 500 cd/m² peak. */
+  set_test_color_mode_with_override (output, META_COLOR_MODE_SDR_NATIVE, &override);
+  meta_color_device_update (device);
+  g_assert_true (meta_color_device_is_native_hdr (monitor));
+  state = meta_color_device_get_color_state (device);
+  g_assert_cmpuint (clutter_color_state_params_get_eotf (CLUTTER_COLOR_STATE_PARAMS (state))->tf_name,
+                    ==, CLUTTER_TRANSFER_FUNCTION_GAMMA22);
+  lum = clutter_color_state_params_get_luminance (CLUTTER_COLOR_STATE_PARAMS (state));
+  g_assert_cmpfloat (lum->min, ==, 0.0f);
+  g_assert_cmpfloat (lum->max, ==, 500.0f);
+  g_assert_cmpfloat (lum->ref, ==, 203.0f);
+  target = meta_color_device_get_target_luminance (device);
+  g_assert_cmpfloat (target->maximum, ==, 500.0f);
+  g_assert_cmpint (target->maximum_source, ==, META_COLOR_TARGET_USER_DECLARED);
+  g_assert_cmpint (target->minimum_source, ==, META_COLOR_TARGET_ENCODING_FALLBACK);
+  g_assert_cmpfloat (target->minimum, ==, 0.0f);
+  g_assert_cmpint (meta_color_device_get_target_primaries (device)->source,
+                   ==, META_COLOR_TARGET_EDID_DECLARED);
+  assert_native_signal (state, 500.0, 1.0);
+  assert_native_signal (state, 203.0, pow (203.0 / 500.0, 1.0 / 2.2));
+  assert_native_signal (state, 80.0, pow (80.0 / 500.0, 1.0 / 2.2));
+  assert_native_signal (state, 1.0, pow (1.0 / 500.0, 1.0 / 2.2));
+  /* What is rendered: the rendering state targets the same range, so content
+   * below the peak is not mapped. */
+  state = meta_color_device_get_rendering_color_state (device);
+  assert_native_signal (state, 203.0, pow (203.0 / 500.0, 1.0 / 2.2));
+  assert_native_signal (state, 80.0, pow (80.0 / 500.0, 1.0 / 2.2));
+  check_published_target (output, 0, 500, wide_gamut, wide_gamut);
+
+  /* Brightness moves the reference white, never the physical range. */
+  meta_color_device_set_reference_luminance_factor (device, 0.5f);
+  lum = get_output_luminance (device);
+  g_assert_cmpfloat (lum->ref, ==, 102.0f);
+  g_assert_cmpfloat (lum->max, ==, 500.0f);
+  g_assert_cmpfloat (meta_color_device_get_target_luminance (device)->maximum, ==, 500.0f);
+  /* The top of the backlight range: 426 cd/m², still below the peak. */
+  meta_color_device_set_reference_luminance_factor (device, 2.1f);
+  g_assert_cmpfloat (get_output_luminance (device)->ref, ==, 426.0f);
+  meta_color_device_set_reference_luminance_factor (device, 1.0f);
+
+  /* A 270 cd/m² peak: at the top of the backlight range SDR white stops
+   * just below the peak instead of clipping above it. */
+  override.peak = 270;
+  set_test_color_mode_with_override (output, META_COLOR_MODE_SDR_NATIVE, &override);
+  meta_color_device_update (device);
+  g_assert_true (meta_color_device_is_native_hdr (monitor));
+  meta_color_device_set_reference_luminance_factor (device, 2.1f);
+  lum = get_output_luminance (device);
+  g_assert_cmpfloat (lum->ref, ==, 269.0f);
+  g_assert_cmpfloat (lum->max, ==, 270.0f);
+  meta_color_device_set_reference_luminance_factor (device, 1.0f);
+  override.peak = 500;
+
+  /* A declared black is published and targeted; clutter maps relative to
+   * the peak, so it does not move the signal. 50 cd/m² is large enough that
+   * (L - B) / (P - B) would differ measurably. At the bottom of the
+   * backlight range SDR white stays above it. */
+  override.has_min = TRUE;
+  override.min = 50.0f;
+  set_test_color_mode_with_override (output, META_COLOR_MODE_SDR_NATIVE, &override);
+  meta_color_device_update (device);
+  state = meta_color_device_get_color_state (device);
+  lum = get_output_luminance (device);
+  g_assert_cmpfloat (lum->min, ==, 50.0f);
+  g_assert_cmpfloat (meta_color_device_get_target_luminance (device)->minimum, ==, 50.0f);
+  assert_native_signal (state, 203.0, pow (203.0 / 500.0, 1.0 / 2.2));
+  check_published_target (output, 500000, 500, wide_gamut, wide_gamut);
+  meta_color_device_set_reference_luminance_factor (device, 0.1f);
+  g_assert_cmpfloat (get_output_luminance (device)->ref, ==, 51.0f);
+  meta_color_device_set_reference_luminance_factor (device, 1.0f);
+
+  /* A peak not above the reference white is no route. */
+  override.has_min = FALSE;
+  override.peak = 203;
+  set_test_color_mode_with_override (output, META_COLOR_MODE_SDR_NATIVE, &override);
+  meta_color_device_update (device);
+  g_assert_false (meta_color_device_is_native_hdr (monitor));
+  state = meta_color_device_get_color_state (device);
+  g_assert_cmpfloat (clutter_color_state_params_get_luminance (CLUTTER_COLOR_STATE_PARAMS (state))->max,
+                     ==, 80.0f);
+
+  /* Forced HDR leaves the route. */
+  override.peak = 500;
+  set_test_color_mode_with_override (output, META_COLOR_MODE_SDR_NATIVE, &override);
+  set_fixture_force_hdr (meta_context_get_debug_control (test_context),
+                         meta_backend_get_monitor_manager (backend), TRUE);
+  g_assert_false (meta_color_device_is_native_hdr (monitor));
+  state = meta_color_device_get_color_state (device);
+  g_assert_cmpuint (clutter_color_state_params_get_eotf (CLUTTER_COLOR_STATE_PARAMS (state))->tf_name,
+                    ==, CLUTTER_TRANSFER_FUNCTION_PQ);
+  set_fixture_force_hdr (meta_context_get_debug_control (test_context),
+                         meta_backend_get_monitor_manager (backend), FALSE);
+
+  set_test_color_mode (output, META_COLOR_MODE_DEFAULT);
+  meta_color_device_update (device);
+}
+
 static void
 call_gsd_color_mock (const char *method,
                      GVariant   *parameters)
@@ -2727,6 +2930,8 @@ init_tests (void)
