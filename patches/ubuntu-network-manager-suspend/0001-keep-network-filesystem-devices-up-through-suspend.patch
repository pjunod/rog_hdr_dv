 network-manager (1.58.1-1ubuntu3) stonking; urgency=low
 
   * Merge from Debian unstable. Remaining changes:
diff --git a/debian/patches/Keep-network-filesystem-devices-up-through-suspend.patch b/debian/patches/Keep-network-filesystem-devices-up-through-suspend.patch
new file mode 100644
index 0000000..d2e0f82
--- /dev/null
+++ b/debian/patches/Keep-network-filesystem-devices-up-through-suspend.patch
@@ -0,0 +1,111 @@
+Description: keep devices carrying a network filesystem up through suspend
+ NetworkManager takes managed hardware devices down when the system prepares to
+ sleep, before the kernel freezes user tasks. A task blocked in a buffered read
+ of a hard NFS or SMB mount then waits on a page lock that only the outstanding
+ READ can release; with the transport gone it never freezes and the kernel
+ refuses to suspend (-EBUSY). Treat a device that routes to the server of a
+ mounted network filesystem like a Wake-on-LAN device: skip it before sleep and
+ re-check it on wake.
+Forwarded: not-yet
+Last-Update: 2026-11-16
+---
+Index: network-manager-1.58.1/src/core/nm-manager.c
+===================================================================
+--- network-manager-1.58.1.orig/src/core/nm-manager.c
++++ network-manager-1.58.1/src/core/nm-manager.c
+@@ -2320,6 +2320,69 @@ device_is_wake_on_lan(NMPlatform *platfo
+     return nm_platform_link_get_wake_on_lan(platform, ifindex);
+ }
+ 
++/* Tasks blocked on I/O to a network filesystem cannot be frozen once its
++ * transport is gone: a buffered read waits for a page lock that only the
++ * outstanding READ can release. Taking such a device down before suspend
++ * therefore makes the kernel refuse to suspend (-EBUSY). Detect devices that
++ * reach the server of a mounted NFS or SMB filesystem, so they can stay up
++ * through the freeze like Wake-on-LAN devices. */
++static gboolean
++device_carries_network_filesystem(NMPlatform *platform, NMDevice *device)
++{
++    gs_free char        *contents = NULL;
++    gs_free const char **lines    = NULL;
++    int                  ifindex;
++    gsize                i;
++
++    ifindex = nm_device_get_ip_ifindex(device);
++    if (ifindex <= 0)
++        return FALSE;
++
++    if (!g_file_get_contents("/proc/self/mountinfo", &contents, NULL, NULL))
++        return FALSE;
++
++    lines = nm_strsplit_set(contents, "\n");
++    for (i = 0; lines && lines[i]; i++) {
++        gs_free const char **fields = NULL;
++        gs_free const char **opts   = NULL;
++        const char          *sep;
++        gsize                j;
++
++        /* "... - fstype source superoptions"; paths escape spaces as \040. */
++        sep = strstr(lines[i], " - ");
++        if (!sep)
++            continue;
++        fields = nm_strsplit_set(sep + 3, " ");
++        if (!fields || !fields[0] || !fields[1] || !fields[2])
++            continue;
++        if (!NM_IN_STRSET(fields[0], "nfs", "nfs4", "cifs", "smb3"))
++            continue;
++
++        opts = nm_strsplit_set(fields[2], ",");
++        for (j = 0; opts && opts[j]; j++) {
++            nm_auto_nmpobj const NMPObject *route = NULL;
++            NMIPAddr                        addr;
++            int                             addr_family = AF_UNSPEC;
++
++            if (!g_str_has_prefix(opts[j], "addr="))
++                continue;
++            if (!nm_inet_parse_bin(AF_UNSPEC, &opts[j][NM_STRLEN("addr=")], &addr_family, &addr))
++                break;
++            if (nm_platform_ip_route_get(platform,
++                                         addr_family,
++                                         &addr,
++                                         0,
++                                         0,
++                                         (NMPObject **) &route)
++                    >= 0
++                && NMP_OBJECT_CAST_IPX_ROUTE(route)->rx.ifindex == ifindex)
++                return TRUE;
++            break;
++        }
++    }
++    return FALSE;
++}
++
+ static void
+ remove_device(NMManager *self, NMDevice *device, gboolean quitting)
+ {
+@@ -7386,6 +7449,15 @@ do_sleep_wake(NMManager *self, gboolean
+                 continue;
+             }
+ 
++            /* So are devices carrying a network filesystem: user tasks blocked
++             * on it must be able to finish their I/O and freeze. */
++            if (suspending && device_carries_network_filesystem(priv->platform, device)) {
++                _LOGD(LOGD_SUSPEND,
++                      "sleep: device %s carries a network filesystem, skipping",
++                      nm_device_get_ip_iface(device));
++                continue;
++            }
++
+             _handle_device_takedown(self, device, suspending, FALSE);
+         }
+     } else {
+@@ -7403,7 +7475,8 @@ do_sleep_wake(NMManager *self, gboolean
+                 /* Belatedly take down Wake-on-LAN devices; ideally we wouldn't have to do this
+                  * but for now it's the only way to make sure we re-check their connectivity.
+                  */
+-                if (device_is_wake_on_lan(priv->platform, device))
++                if (device_is_wake_on_lan(priv->platform, device)
++                    || device_carries_network_filesystem(priv->platform, device))
+                     nm_device_set_unmanaged_by_flags(device,
+                                                      NM_UNMANAGED_MANAGER_DISABLED,
+                                                      NM_UNMAN_FLAG_OP_SET_UNMANAGED,
diff --git a/debian/patches/series b/debian/patches/series
index 13e7d1f..880d0a9 100644
--- a/debian/patches/series
+++ b/debian/patches/series
@@ -10,3 +10,4 @@ netplan/0001-netplan-Adopt-buildsystems-for-Netplan-integration.patch
 netplan/0002-netplan-make-use-of-libnetplan-for-YAML-backend.patch
 netplan/0003-Allow-the-NetworkManager-daemon-to-write-to-lib-netp.patch
 netplan/keyfile-update-test-for-expected-netplan-output.patch
+Keep-network-filesystem-devices-up-through-suspend.patch
diff --git a/src/core/nm-manager.c b/src/core/nm-manager.c
index 31b6c25..3e3d64c 100644
--- a/src/core/nm-manager.c
+++ b/src/core/nm-manager.c
@@ -2320,6 +2320,69 @@ device_is_wake_on_lan(NMPlatform *platform, NMDevice *device)
     return nm_platform_link_get_wake_on_lan(platform, ifindex);
 }
 
+/* Tasks blocked on I/O to a network filesystem cannot be frozen once its
+ * transport is gone: a buffered read waits for a page lock that only the
+ * outstanding READ can release. Taking such a device down before suspend
+ * therefore makes the kernel refuse to suspend (-EBUSY). Detect devices that
+ * reach the server of a mounted NFS or SMB filesystem, so they can stay up
+ * through the freeze like Wake-on-LAN devices. */
+static gboolean
+device_carries_network_filesystem(NMPlatform *platform, NMDevice *device)
+{
+    gs_free char        *contents = NULL;
+    gs_free const char **lines    = NULL;
+    int                  ifindex;
+    gsize                i;
+
+    ifindex = nm_device_get_ip_ifindex(device);
+    if (ifindex <= 0)
+        return FALSE;
+
+    if (!g_file_get_contents("/proc/self/mountinfo", &contents, NULL, NULL))
+        return FALSE;
+
+    lines = nm_strsplit_set(contents, "\n");
+    for (i = 0; lines && lines[i]; i++) {
+        gs_free const char **fields = NULL;
+        gs_free const char **opts   = NULL;
+        const char          *sep;
+        gsize                j;
+
+        /* "... - fstype source superoptions"; paths escape spaces as \040. */
+        sep = strstr(lines[i], " - ");
+        if (!sep)
+            continue;
+        fields = nm_strsplit_set(sep + 3, " ");
+        if (!fields || !fields[0] || !fields[1] || !fields[2])
+            continue;
+        if (!NM_IN_STRSET(fields[0], "nfs", "nfs4", "cifs", "smb3"))
+            continue;
+
+        opts = nm_strsplit_set(fields[2], ",");
+        for (j = 0; opts && opts[j]; j++) {
+            nm_auto_nmpobj const NMPObject *route = NULL;
+            NMIPAddr                        addr;
+            int                             addr_family = AF_UNSPEC;
+
+            if (!g_str_has_prefix(opts[j], "addr="))
+                continue;
+            if (!nm_inet_parse_bin(AF_UNSPEC, &opts[j][NM_STRLEN("addr=")], &addr_family, &addr))
+                break;
+            if (nm_platform_ip_route_get(platform,
+                                         addr_family,
+                                         &addr,
+                                         0,
+                                         0,
+                                         (NMPObject **) &route)
+                    >= 0
+                && NMP_OBJECT_CAST_IPX_ROUTE(route)->rx.ifindex == ifindex)
+                return TRUE;
+            break;
+        }
+    }
+    return FALSE;
+}
+
 static void
 remove_device(NMManager *self, NMDevice *device, gboolean quitting)
 {
@@ -7386,6 +7449,15 @@ do_sleep_wake(NMManager *self, gboolean sleeping_changed)
                 continue;
             }
 
+            /* So are devices carrying a network filesystem: user tasks blocked
+             * on it must be able to finish their I/O and freeze. */
+            if (suspending && device_carries_network_filesystem(priv->platform, device)) {
+                _LOGD(LOGD_SUSPEND,
+                      "sleep: device %s carries a network filesystem, skipping",
+                      nm_device_get_ip_iface(device));
+                continue;
+            }
+
             _handle_device_takedown(self, device, suspending, FALSE);
         }
     } else {
@@ -7403,7 +7475,8 @@ do_sleep_wake(NMManager *self, gboolean sleeping_changed)
                 /* Belatedly take down Wake-on-LAN devices; ideally we wouldn't have to do this
                  * but for now it's the only way to make sure we re-check their connectivity.
                  */
-                if (device_is_wake_on_lan(priv->platform, device))
+                if (device_is_wake_on_lan(priv->platform, device)
+                    || device_carries_network_filesystem(priv->platform, device))
                     nm_device_set_unmanaged_by_flags(device,
                                                      NM_UNMANAGED_MANAGER_DISABLED,
                                                      NM_UNMAN_FLAG_OP_SET_UNMANAGED,
