+--- a/src/core/nm-manager.c
++++ b/src/core/nm-manager.c
+@@ -226,6 +226,10 @@ typedef struct {
+ 
+     GHashTable *sleep_devices;
+ 
++    /* ifindexes kept up through suspend because they carry a network
++     * filesystem; re-checked on wake like Wake-on-LAN devices. */
++    GHashTable *sleep_netfs_ifindexes;
++
+     /* Firmware dir monitor */
+     GFileMonitor *fw_monitor;
+     guint         fw_changed_id;
+@@ -2321,6 +2325,112 @@ device_is_wake_on_lan(NMPlatform *platfo
+ }
+ 
+ static void
++netfs_add_link(NMPlatform *platform, GHashTable *set, int ifindex, guint depth)
++{
++    gs_unref_ptrarray GPtrArray *links = NULL;
++    const NMPlatformLink        *link;
++    guint                        i;
++
++    if (ifindex <= 0 || depth > 4 || !g_hash_table_add(set, GINT_TO_POINTER(ifindex)))
++        return;
++    link = nm_platform_link_get(platform, ifindex);
++    if (!link)
++        return;
++    /* A VLAN, MACsec or similar link depends on its parent... */
++    if (link->parent > 0)
++        netfs_add_link(platform, set, link->parent, depth + 1);
++    /* ...and a bridge or bond on its ports. */
++    links = nm_platform_link_get_all(platform);
++    for (i = 0; links && i < links->len; i++) {
++        const NMPlatformLink *port = NMP_OBJECT_CAST_LINK(links->pdata[i]);
++
++        if (port->controller == ifindex)
++            netfs_add_link(platform, set, port->ifindex, depth + 1);
++    }
++}
++
++/* Tasks blocked on I/O to a network filesystem cannot be frozen once its
++ * transport is gone: a buffered read waits for a page lock that only the
++ * outstanding READ can release, so the kernel refuses to suspend (-EBUSY).
++ * Return the ifindexes that carry the traffic of mounted NFS and SMB
++ * filesystems: the link the kernel routes each server address through, plus
++ * the links that one depends on. NULL when there are none.
++ *
++ * NetworkManager may run in its own mount namespace (PrivateTmp and other
++ * systemd sandboxing), so read the init namespace's mount table first. */
++static GHashTable *
++network_filesystem_ifindexes(NMPlatform *platform)
++{
++    gs_free char        *contents = NULL;
++    gs_free const char **lines    = NULL;
++    GHashTable          *set      = NULL;
++    gsize                i;
++
++    if (!g_file_get_contents("/proc/1/mountinfo", &contents, NULL, NULL)
++        && !g_file_get_contents("/proc/self/mountinfo", &contents, NULL, NULL))
++        return NULL;
++
++    lines = nm_strsplit_set(contents, "\n");
++    for (i = 0; lines && lines[i]; i++) {
++        gs_free const char **fields = NULL;
++        gs_free const char **opts   = NULL;
++        const char          *sep;
++        gsize                j;
++
++        /* "... - fstype source superoptions"; paths escape spaces as \040. */
++        sep = strstr(lines[i], " - ");
++        if (!sep)
++            continue;
++        fields = nm_strsplit_set(sep + 3, " ");
++        if (!fields || !fields[0] || !fields[1] || !fields[2])
++            continue;
++        if (!NM_IN_STRSET(fields[0], "nfs", "nfs4", "cifs", "smb3"))
++            continue;
++
++        opts = nm_strsplit_set(fields[2], ",");
++        for (j = 0; opts && opts[j]; j++) {
++            nm_auto_nmpobj const NMPObject *route  = NULL;
++            gs_free char                   *text   = NULL;
++            char                           *scope;
++            NMIPAddr                        addr;
++            int                             addr_family = AF_UNSPEC;
++            int                             oif         = 0;
++
++            if (!g_str_has_prefix(opts[j], "addr="))
++                continue;
++            text = g_strdup(&opts[j][NM_STRLEN("addr=")]);
++            /* An IPv6 link-local server is printed as fe80::1%ifname. */
++            scope = strchr(text, '%');
++            if (scope) {
++                *scope = '\0';
++                oif    = nm_platform_link_get_ifindex(platform, scope + 1);
++            }
++            if (nm_inet_parse_bin(AF_UNSPEC, text, &addr_family, &addr)
++                && nm_platform_ip_route_get(platform,
++                                            addr_family,
++                                            &addr,
++                                            0,
++                                            oif > 0 ? oif : 0,
++                                            (NMPObject **) &route)
++                       >= 0) {
++                if (!set)
++                    set = g_hash_table_new(nm_direct_hash, NULL);
++                netfs_add_link(platform, set, NMP_OBJECT_CAST_IPX_ROUTE(route)->rx.ifindex, 0);
++            }
++        }
++    }
++    return set;
++}
++
++static gboolean
++device_in_ifindex_set(GHashTable *set, NMDevice *device)
++{
++    return set
++           && (g_hash_table_contains(set, GINT_TO_POINTER(nm_device_get_ifindex(device)))
++               || g_hash_table_contains(set, GINT_TO_POINTER(nm_device_get_ip_ifindex(device))));
++}
++
++static void
+ remove_device(NMManager *self, NMDevice *device, gboolean quitting)
+ {
+     NMManagerPrivate *priv     = NM_MANAGER_GET_PRIVATE(self);
+@@ -7368,6 +7478,10 @@ do_sleep_wake(NMManager *self, gboolean
+         /* FIXME: are there still hardware devices that need to be disabled around
+          * suspend/resume?
+          */
++        if (suspending) {
++            nm_clear_pointer(&priv->sleep_netfs_ifindexes, g_hash_table_unref);
++            priv->sleep_netfs_ifindexes = network_filesystem_ifindexes(priv->platform);
++        }
+         c_list_for_each_entry (device, &priv->devices_lst_head, devices_lst) {
+             if (nm_device_is_software(device)) {
+                 /* If a user disables networking we consider that as an
+@@ -7386,6 +7500,15 @@ do_sleep_wake(NMManager *self, gboolean
+                 continue;
+             }
+ 
++            /* So are devices carrying a network filesystem: user tasks blocked
++             * on it must be able to finish their I/O and freeze. */
++            if (suspending && device_in_ifindex_set(priv->sleep_netfs_ifindexes, device)) {
++                _LOGD(LOGD_SUSPEND,
++                      "sleep: device %s carries a network filesystem, skipping",
++                      nm_device_get_iface(device));
++                continue;
++            }
++
+             _handle_device_takedown(self, device, suspending, FALSE);
+         }
+     } else {
+@@ -7403,7 +7526,8 @@ do_sleep_wake(NMManager *self, gboolean
+                 /* Belatedly take down Wake-on-LAN devices; ideally we wouldn't have to do this
+                  * but for now it's the only way to make sure we re-check their connectivity.
+                  */
+-                if (device_is_wake_on_lan(priv->platform, device))
++                if (device_is_wake_on_lan(priv->platform, device)
++                    || device_in_ifindex_set(priv->sleep_netfs_ifindexes, device))
+                     nm_device_set_unmanaged_by_flags(device,
+                                                      NM_UNMANAGED_MANAGER_DISABLED,
+                                                      NM_UNMAN_FLAG_OP_SET_UNMANAGED,
+@@ -7422,6 +7546,8 @@ do_sleep_wake(NMManager *self, gboolean
+             }
+         }
+ 
++        nm_clear_pointer(&priv->sleep_netfs_ifindexes, g_hash_table_unref);
++
+         /* Ensure rfkill state is up-to-date since we don't respond to state
+          * changes during sleep.
+          */
+@@ -9441,6 +9567,7 @@ dispose(GObject *object)
+         sleep_devices_clear(self);
+         nm_clear_pointer(&priv->sleep_devices, g_hash_table_unref);
+     }
++    nm_clear_pointer(&priv->sleep_netfs_ifindexes, g_hash_table_unref);
+ 
+     if (priv->power_monitor) {
+         g_signal_handlers_disconnect_by_func(priv->power_monitor, sleeping_cb, self);
