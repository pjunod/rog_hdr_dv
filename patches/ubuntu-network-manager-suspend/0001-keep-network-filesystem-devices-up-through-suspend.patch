 debian/patches/series                         |   1 +
 src/core/nm-manager.c                         |  75 +++++++++++-
 4 files changed, 193 insertions(+), 1 deletion(-)
 create mode 100644 debian/patches/Keep-network-filesystem-devices-up-through-suspend.patch

