+        ref();
+        auto unlink = g_signal_connect_data(pad, "unlinked", G_CALLBACK(+[](GstPad* pad, GstPad*, gpointer data) { static_cast<GStreamerDoviSourcePolicy*>(data)->removePadProof(pad); }),
+            this, +[](gpointer data, GClosure*) { static_cast<GStreamerDoviSourcePolicy*>(data)->deref(); }, GConnectFlags(0));
+        remember(std::make_unique<Connection>(G_OBJECT(pad), unlink));
+        bool protectedInput = false;
+        for (guint i = 0;; ++i) {
+            auto protection = adoptGRef(gst_pad_get_sticky_event(pad, GST_EVENT_PROTECTION, i));
+            if (!protection) break;
+            protectedInput = true;
+        }
