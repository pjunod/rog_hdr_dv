+// Main-thread source state goes to the owning page. UI activation is a bounded
+// live registry; a revoked token is removed and can never be reused.
+WEBCORE_EXPORT void setGTKVideoSourceStateHandler(Function<void(PageIdentifier, uint64_t, uint64_t, bool)>&&);
+WEBCORE_EXPORT void notifyGTKVideoSourceState(PageIdentifier, uint64_t, uint64_t selection, bool active);
+
+
+// One realized view binding. A new lease may reuse another surface's generation.
+struct GTKVideoTarget {
+    uint64_t revision { 0 };
+    uint64_t generation { 0 };
+    std::array<double, 8> primaries { };
+    double black { 0 };
+    double peak { 0 };
+    double reference { 0 };
+    bool ready { false };
+    bool operator==(const GTKVideoTarget&) const = default;
+};
+
+// The only transport format is opaque full-range RGBA64_LE, RGB/BT.2020/PQ.
+// Rows are tightly packed, top-down, plane zero, offset zero.
+struct GTKVideoPlane {
+    uint64_t revision;
+    uint64_t generation;
+    ProcessIdentifier sourceProcess;
+    uint64_t sourceRevision;
+    uint64_t sourceSelection;
+    uint64_t epoch;
+    uint64_t picture;
+    IntRect destination;
+    IntSize size;
+    uint32_t stride;
+    UnixFileDescriptor pixels;
+
+    static constexpr size_t maxBytes = gtkNativeVideoMaxBytes;
+    static size_t byteLength(const IntSize& size, uint32_t stride)
+    {
+        return gtkNativeVideoByteLength(size.width(), size.height(), stride);
+    }
+};
+
+} // namespace WebCore
