+#pragma once
+
+#include <WebCore/ColorConversion.h>
+#include <WebCore/ColorTypes.h>
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <optional>
+#include <limits>
+
+namespace WebCore {
+
+// This conversion is for an explicitly SDR video destination, not a declaration
+// that the browser page or its GTK framebuffer supports HDR. The caller must map
+// the original picture exactly once to the chosen SDR mastering target first.
+struct GStreamerSDRVideoDestination {
+    // Undo the upstream renderer's declared linear PQ transport scaling.
+    // This is distinct from the fixed logical mastering white below.
+    double inverseTransportScale { 1 };
+    double referenceWhiteNits { 100 };
+};
+
+inline std::optional<SRGBA<float>> sdrVideoPixelFromTransportPQ(const std::array<float, 3>& encoded, const GStreamerSDRVideoDestination& destination)
+{
+    if (!std::isfinite(destination.inverseTransportScale) || destination.inverseTransportScale <= 0
+        || !std::isfinite(destination.referenceWhiteNits) || destination.referenceWhiteNits <= 0)
+        return std::nullopt;
+
+    auto linearChannel = [&](float value) -> std::optional<float> {
+        if (!std::isfinite(value) || value < 0 || value > 1)
+            return std::nullopt;
+
+        // SMPTE ST 2084: decode to absolute cd/m² before undoing transport.
+        constexpr double m1 = 2610.0 / 16384.0;
+        constexpr double m2 = 2523.0 / 32.0;
+        constexpr double c1 = 3424.0 / 4096.0;
+        constexpr double c2 = 2413.0 / 128.0;
+        constexpr double c3 = 2392.0 / 128.0;
+        double p = std::pow(value, 1.0 / m2);
+        double nits = 10000 * std::pow(std::max(p - c1, 0.0) / (c2 - c3 * p), 1.0 / m1);
+        double relative = nits * destination.inverseTransportScale / destination.referenceWhiteNits;
+        if (!std::isfinite(relative) || relative > std::numeric_limits<float>::max())
+            return std::nullopt;
+        return static_cast<float>(relative);
+    };
+    auto red = linearChannel(encoded[0]);
+    auto green = linearChannel(encoded[1]);
+    auto blue = linearChannel(encoded[2]);
+    if (!red || !green || !blue)
+        return std::nullopt;
+
+    // Reuse WebCore's D65 matrix and sRGB transfer conversion. Keep the input
+    // extended until after the gamut conversion, then clip to the SDR range.
+    return convertColor<SRGBA<float>>(ExtendedLinearRec2020<float> { *red, *green, *blue, 1 });
+}
+
+} // namespace WebCore
