+                api.render = reinterpret_cast<decltype(api.render)>(dlsym(core, "gst_gtk_dovi_native_frame_render_destination"));
+            }
+            if (api.frame && api.release && api.sourceRevision && api.sourceSelection && api.createMapper && api.freeMapper && api.render)
+                return api;
+            dlclose(core);
+            return GTKNativeVideoAPI { };
+        }();
+        return api;
+    }
+};
+
+inline TextureMapper::RenderNativeVideo nativeVideoRenderer(GstBuffer* sample, const IntSize& displayedSize)
+{
+    if (displayedSize.isEmpty() || displayedSize.width() > 8192 || displayedSize.height() > 8192
+        || !GTKVideoPlane::byteLength(displayedSize, static_cast<uint32_t>(displayedSize.width()) * 8))
+        return { };
+    if (!sample || gst_buffer_get_video_overlay_composition_meta(sample) || !gst_meta_get_info("GstGtkDoviNativeFrameMeta"))
+        return { };
+    const auto& api = GTKNativeVideoAPI::singleton();
+    if (!api.frame)
+        return { };
+    std::shared_ptr<GstGtkDoviNativeFrame> frame(api.frame(sample, nullptr), api.release);
+    if (!frame || !api.sourceRevision(frame.get()) || !api.sourceSelection(frame.get()))
+        return { };
+    return [frame = WTF::move(frame), displayedSize](const GTKVideoTarget& target, std::shared_ptr<void>& mapper, const IntRect& rect) -> std::optional<GTKVideoPlane> {
+        const auto& api = GTKNativeVideoAPI::singleton();
+        auto sourceRevision = api.sourceRevision(frame.get());
+        auto sourceSelection = api.sourceSelection(frame.get());
+        if (!sourceRevision || !sourceSelection)
+            return std::nullopt;
+        if (!mapper)
+            mapper = std::shared_ptr<GstGtkDoviMapper>(api.createMapper(), api.freeMapper);
+        if (!mapper)
+            return std::nullopt;
+        auto context = adoptGRef(gst_context_new("gst.gtk.dovi.target.v1", false));
+        auto* s = gst_context_writable_structure(context.get());
+        gst_structure_set(s, "generation", G_TYPE_UINT64, target.generation,
+            "valid", G_TYPE_BOOLEAN, TRUE, "composed", G_TYPE_BOOLEAN, TRUE, "hdr-ready", G_TYPE_BOOLEAN, TRUE,
+            "min-nits", G_TYPE_DOUBLE, target.black, "max-nits", G_TYPE_DOUBLE, target.peak,
+            "reference-nits", G_TYPE_DOUBLE, target.reference,
+            "encoding-reference-nits", G_TYPE_DOUBLE, 203., "encoding-max-nits", G_TYPE_DOUBLE, 10000., nullptr);
+        static constexpr const char* keys[] = { "primary-r-x", "primary-r-y", "primary-g-x", "primary-g-y", "primary-b-x", "primary-b-y", "white-x", "white-y" };
+        for (unsigned i = 0; i < target.primaries.size(); ++i)
+            gst_structure_set(s, keys[i], G_TYPE_DOUBLE, target.primaries[i], nullptr);
+        GstVideoInfo info { };
+        GstBuffer* raw = nullptr;
+        guint64 epoch = 0, picture = 0;
+        int status = api.render(frame.get(), static_cast<GstGtkDoviMapper*>(mapper.get()), GST_GTK_DOVI_DESTINATION_DISPLAY_PQ, context.get(), &raw, &info, &epoch, &picture, nullptr);
+        auto pixels = adoptGRef(raw);
+        if (status != 1 || !pixels || GST_VIDEO_INFO_FORMAT(&info) != GST_VIDEO_FORMAT_RGBA64_LE
+            || info.colorimetry.transfer != GST_VIDEO_TRANSFER_SMPTE2084 || info.colorimetry.primaries != GST_VIDEO_COLOR_PRIMARIES_BT2020
+            || info.colorimetry.matrix != GST_VIDEO_COLOR_MATRIX_RGB || info.colorimetry.range != GST_VIDEO_COLOR_RANGE_0_255
+            || gst_buffer_get_video_overlay_composition_meta(pixels.get()))
+            return std::nullopt;
+        IntSize size { info.width, info.height };
+        if (size != displayedSize || size.isEmpty() || size.width() > 8192)
+            return std::nullopt;
+        uint32_t stride = size.width() * 8;
+        size_t bytes = GTKVideoPlane::byteLength(size, stride);
+        if (!bytes)
+            return std::nullopt;
+        UnixFileDescriptor fd { memfd_create("WebKit-native-video", MFD_CLOEXEC | MFD_ALLOW_SEALING), UnixFileDescriptor::Adopt };
+        if (!fd || ftruncate(fd.value(), bytes))
+            return std::nullopt;
+        GstVideoFrame mapped { };
+        if (!gst_video_frame_map(&mapped, &info, pixels.get(), GST_MAP_READ))
+            return std::nullopt;
+        bool valid = GST_VIDEO_FRAME_PLANE_STRIDE(&mapped, 0) >= static_cast<int>(stride);
+        auto* plane = static_cast<const uint8_t*>(GST_VIDEO_FRAME_PLANE_DATA(&mapped, 0));
+        for (int y = 0; valid && y < size.height(); ++y) {
+            auto* row = plane + static_cast<size_t>(y) * GST_VIDEO_FRAME_PLANE_STRIDE(&mapped, 0);
+            for (uint32_t x = 0; x < stride; x += 8) {
+                if (row[x + 6] != 255 || row[x + 7] != 255) {
+                    valid = false;
+                    break;
+                }
+            }
+            if (valid)
+                valid = pwrite(fd.value(), row, stride, static_cast<off_t>(y) * stride) == static_cast<ssize_t>(stride);
+        }
+        gst_video_frame_unmap(&mapped);
+        if (!valid || fcntl(fd.value(), F_ADD_SEALS, F_SEAL_WRITE | F_SEAL_SHRINK | F_SEAL_GROW | F_SEAL_SEAL))
+            return std::nullopt;
+        if (api.sourceRevision(frame.get()) != sourceRevision || api.sourceSelection(frame.get()) != sourceSelection)
+            return std::nullopt;
+        return GTKVideoPlane { target.revision, target.generation, Process::identifier(), sourceRevision, sourceSelection, epoch, picture, rect, size, stride, WTF::move(fd) };
+    };
+}
+#else
+inline TextureMapper::RenderNativeVideo nativeVideoRenderer(GstBuffer*, const IntSize&) { return { }; }
+#endif
+} // namespace WebCore
diff --git a/Source/WebCore/platform/graphics/texmap/tests/GTKVideoSourceRegistry.cpp b/Source/WebCore/platform/graphics/texmap/tests/GTKVideoSourceRegistry.cpp
new file mode 100644
index 00000000..583fc859
--- /dev/null
+++ b/Source/WebCore/platform/graphics/texmap/tests/GTKVideoSourceRegistry.cpp
@@ -0,0 +1,40 @@
+/* Copyright (C) 2026 ROG HDR contributors. SPDX-License-Identifier: BSD-2-Clause */
+#include "GTKVideoSourceRegistry.h"
+#include "GTKNativeVideoLimits.h"
+#include <cassert>
+#include <cstdio>
+using namespace WebCore;
+int main()
+{
+    GTKVideoSourceRegistry registry;
+    assert(registry.activate(10, 1)); // A exported plane is held by UI.
+    assert(registry.accepts(10, 1));
+    registry.revoke(10, 1); // Downstream-only S_START invalidates A before B.
+    assert(!registry.accepts(10, 1)); // Full SDR page remains available.
+    assert(registry.activate(10, 2));
+    assert(!registry.accepts(10, 1) && registry.accepts(10, 2));
+    registry.revoke(10, 1); // Late A revoke cannot remove B.
+    assert(registry.accepts(10, 2));
+    registry.revoke(10, 2); // Filter-local flush, while paused.
+    assert(!registry.accepts(10, 2));
+    assert(registry.activate(10, 3));
+    assert(!registry.accepts(10, 2) && registry.accepts(10, 3));
+    assert(registry.activate(11, 1));
+    registry.revoke(10, 0); // Synchronous whole-origin CDM/source revoke.
+    assert(!registry.accepts(10, 3) && registry.accepts(11, 1));
+    registry.clear(); // Connection/view process swap.
+    assert(!registry.accepts(11, 1));
+    for (uint64_t i = 1; i <= 64; ++i) assert(registry.activate(i, 1));
+    assert(!registry.activate(65, 1));
+    assert(registry.activate(1, 2));
+    for (uint64_t i = 1; i <= 64; ++i) registry.revoke(i, 0);
+    assert(registry.activate(65, 1)); // No tombstone/history growth.
+    int rendererCalls = 0;
+    auto render = [&](int width, int height) {
+        if (gtkNativeVideoByteLength(width, height, static_cast<uint32_t>(width) * 8)) ++rendererCalls;
+    };
+    render(4096, 2160); render(7680, 4320);
+    assert(!rendererCalls);
+    render(3840, 2160); assert(rendererCalls == 1);
+    std::puts("PASS selected-source registry, held-export revoke/restore, bounded lifetime, pre-render size envelope");
+}
