+        else if (auto caps = adoptGRef(gst_pad_get_current_caps(pad))) record(pad, caps.get());
+        GST_PAD_STREAM_UNLOCK(pad);
+    }
+    void announce(uint64_t revision)
+    {
+        if (isMainThread()) notifyGTKVideoSourceState(m_page, revision, 0, false);
+        else callOnMainThread([self = Ref { *this }, revision] { notifyGTKVideoSourceState(self->m_page, revision, 0, false); });
+    }
+    void selectionChanged(uint64_t revision, uint64_t selection, bool active)
+    {
+        callOnMainThread([self = Ref { *this }, revision, selection, active] {
+            {
+                std::lock_guard lock(self->m_mutex);
+                if (self->m_revision != revision || (active && (self->m_revoked || self->m_untrusted.load(std::memory_order_acquire)))) return;
+                if (active) {
+                    if (self->m_proofs.empty()) { self->markUntrusted("selection activated without any clear proof"); return; }
+                    for (const auto& [id, proof] : self->m_proofs) {
+                        (void)id;
+                        if (!self->proofIsLive(*proof)) { self->markUntrusted("selection activated with a stale proof"); return; }
+                    }
+                }
+            }
+            if (active) {
+                auto filter = adoptGRef(GST_ELEMENT(g_weak_ref_get(&self->m_filter))); guint64 actualRevision = 0, actualSelection = 0;
+                if (!filter) return;
+                g_object_get(filter.get(), "active-source-revision", &actualRevision, "active-source-selection", &actualSelection, nullptr);
+                if (actualRevision != revision || actualSelection != selection) return;
+            }
+            notifyGTKVideoSourceState(self->m_page, revision, selection, active);
+        });
+    }
+    void observeSelections(GstElement* filter)
+    {
+        for (bool active : { false, true }) {
+            ref();
+            auto id = g_signal_connect_data(filter, active ? "source-selection-activated" : "source-selection-revoked",
+                active ? G_CALLBACK(+[](GstElement*, guint64 r, guint64 s, gpointer data) { static_cast<GStreamerDoviSourcePolicy*>(data)->selectionChanged(r, s, true); })
+                       : G_CALLBACK(+[](GstElement*, guint64 r, guint64 s, gpointer data) { static_cast<GStreamerDoviSourcePolicy*>(data)->selectionChanged(r, s, false); }),
+                this, +[](gpointer data, GClosure*) { static_cast<GStreamerDoviSourcePolicy*>(data)->deref(); }, GConnectFlags(0));
+            m_connections.push_back(std::make_unique<Connection>(G_OBJECT(filter), id));
+        }
+    }
+    void sendContext(uint64_t revision, bool blocked, const char* id = nullptr, GstCaps* coded = nullptr)
+    {
+        if (!revision) return;
+        auto filter = adoptGRef(GST_ELEMENT(g_weak_ref_get(&m_filter))); if (!filter) return;
+        blocked |= m_untrusted.load(std::memory_order_acquire);
+        auto context = adoptGRef(gst_context_new("gst.webkit.dovi.source.v1", false)); auto* st = gst_context_writable_structure(context.get());
+        gst_structure_set(st, "source-revision", G_TYPE_UINT64, revision, "blocked", G_TYPE_BOOLEAN, blocked, nullptr);
+        if (!blocked && id) gst_structure_set(st, "stream-id", G_TYPE_STRING, id, nullptr);
+        if (!blocked && coded) gst_structure_set(st, "clear-coded-caps", GST_TYPE_CAPS, coded, nullptr);
+        GST_DEBUG("Dolby source policy: context revision %" G_GUINT64_FORMAT " blocked=%d stream=%s", revision, blocked, (!blocked && id) ? id : "-");
+        gst_element_set_context(filter.get(), context.get());
+    }
+    std::mutex m_mutex;
+    GWeakRef m_filter, m_source;
+    PageIdentifier m_page;
+    std::unordered_map<GstElement*, std::shared_ptr<Input>> m_inputs;
+    std::unordered_map<std::string, std::unique_ptr<Proof>> m_proofs;
+    std::vector<std::unique_ptr<Connection>> m_connections;
+    std::atomic<bool> m_untrusted { false }, m_sourceStarted { false };
+    std::atomic<uint64_t> m_atomicRevision { 0 };
+    uint64_t m_revision { 0 };
+    bool m_revoked { false };
+};
+} // namespace WebCore
+#endif
