+
+void TextureMapper::offerNativeVideo(uint64_t precedingDraw, const FloatRect& rect, const TransformationMatrix& transform, RenderNativeVideo&& render)
+{
+    m_encounteredNativeVideo = true;
+    // Only a single, actually issued, axis-aligned draw on the page framebuffer.
+    // Subsequent page draws that might cover this rectangle invalidate the offer.
+    if (currentSurface() || m_isMaskMode || glIsEnabled(GL_DEPTH_TEST) || m_nativeVideoDrawSerial != precedingDraw + 1
+        || !transform.isAffine() || transform.m12() || transform.m21() || transform.m11() <= 0 || transform.m22() <= 0
+        || !m_patternTransform.isIdentity() || m_wrapMode != WrapMode::Stretch
+        || clipStack().isRoundedRectClipEnabled() || clipStack().getStencilIndex() != 1)
+        return;
+    auto mapped = transform.mapRect(rect);
+    auto bounds = enclosingIntRect(mapped);
+    if (bounds.isEmpty() || FloatRect(bounds) != mapped || !clipStack().current().scissorBox.contains(bounds))
+        return;
+    m_nativeVideoRect = bounds;
+    m_renderNativeVideo = WTF::move(render);
+}
+
+std::optional<GTKVideoPlane> TextureMapper::renderNativeVideo(const GTKVideoTarget& target)
+{
+    if (!m_renderNativeVideo || !target.ready)
+        return std::nullopt;
+    return m_renderNativeVideo(target, m_nativeVideoMapper, m_nativeVideoRect);
+}
