+#pragma once
+#if PLATFORM(GTK) && USE(GTK4) && ENABLE(VIDEO) && USE(GSTREAMER)
+#include "GStreamerCommon.h"
+#include "GStreamerDoviOriginalSource.h"
+#include "GStreamerDoviInputHistory.h"
+#include "GStreamerDoviInputSetup.h"
+#include "GTKNativeVideo.h"
+#include <atomic>
+#include <mutex>
+#include <string>
