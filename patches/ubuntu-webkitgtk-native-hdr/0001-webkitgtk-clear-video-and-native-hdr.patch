--- /dev/null
+++ b/Source/WebCore/platform/graphics/texmap/GTKVideoSourceRegistry.h
@@ -0,0 +1,36 @@
+/* Copyright (C) 2026 ROG HDR contributors. SPDX-License-Identifier: BSD-2-Clause */
+#pragma once
+#include <array>
+#include <cstdint>
+namespace WebCore {
+// One UI view/connection owns this bounded live table. Revoked history is not
+// retained; late exports must match the current selected lease exactly.
+class GTKVideoSourceRegistry {
+public:
+    bool activate(uint64_t origin, uint64_t selection)
+    {
+        if (!origin || !selection) return false;
+        for (auto& entry : m_entries)
+            if (entry.origin == origin) { entry.selection = selection; return true; }
+        for (auto& entry : m_entries)
+            if (!entry.origin) { entry = { origin, selection }; return true; }
+        return false;
+    }
+    void revoke(uint64_t origin, uint64_t selection)
+    {
+        for (auto& entry : m_entries)
+            if (entry.origin == origin && (!selection || entry.selection == selection)) entry = { };
+    }
+    bool accepts(uint64_t origin, uint64_t selection) const
+    {
+        if (!origin || !selection) return false;
+        for (const auto& entry : m_entries)
+            if (entry.origin == origin) return entry.selection == selection;
+        return false;
+    }
+    void clear() { m_entries = { }; }
+private:
+    struct Entry { uint64_t origin { 0 }; uint64_t selection { 0 }; };
+    std::array<Entry, 64> m_entries;
+};
+} // namespace WebCore
