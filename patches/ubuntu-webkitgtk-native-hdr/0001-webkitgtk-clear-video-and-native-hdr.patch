+        if (!m_videoLease) {
+            m_videoSurface = surface;
+            m_videoLease = adoptGRef(G_OBJECT(request(surface)));
+            if (m_videoLease) {
+                auto changed = +[](AcceleratedBackingStore* self) {
+                    self->updateVideoTarget(self->m_videoCandidate);
+                    if (self->m_webPage)
+                        gtk_widget_queue_draw(self->m_webPage->viewWidget());
+                };
+                g_signal_connect_swapped(m_videoLease.get(), "changed", G_CALLBACK(changed), this);
