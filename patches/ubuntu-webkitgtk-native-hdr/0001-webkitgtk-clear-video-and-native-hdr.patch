diff --git a/Source/WebCore/platform/graphics/gstreamer/GStreamerDecoderPreference.h b/Source/WebCore/platform/graphics/gstreamer/GStreamerDecoderPreference.h
new file mode 100644
index 00000000..e235b982
--- /dev/null
+++ b/Source/WebCore/platform/graphics/gstreamer/GStreamerDecoderPreference.h
@@ -0,0 +1,91 @@
+/* Copyright (C) 2026 ROG HDR contributors. SPDX-License-Identifier: BSD-2-Clause */
+#pragma once
+#if PLATFORM(GTK) && USE(GTK4) && ENABLE(VIDEO) && USE(GSTREAMER)
+#include "GStreamerCommon.h"
+#include <wtf/Vector.h>
+#include <wtf/text/CString.h>
+#if USE(GBM)
+#include "DRMDeviceManager.h"
+#endif
+
+namespace WebCore {
+
+// True for an H.265 stream whose Dolby Vision configuration record declares an
+// enhancement layer (Profile 7 FEL or MEL). The record keeps its version, then a
+// 7-bit profile, a 6-bit level and the RPU, EL and BL presence flags.
+inline bool doviStreamHasEnhancementLayer(GstCaps* caps)
+{
+    if (!caps || gst_caps_is_empty(caps) || gst_caps_is_any(caps))
+        return false;
+    auto* structure = gst_caps_get_structure(caps, 0);
+    if (!gst_structure_has_name(structure, "video/x-h265"))
+        return false;
+    const GValue* value = gst_structure_get_value(structure, "dovi-configuration");
+    if (!value || !GST_VALUE_HOLDS_BUFFER(value))
+        return false;
+    uint8_t record[4];
+    if (gst_buffer_extract(gst_value_get_buffer(value), 0, record, sizeof(record)) != sizeof(record))
+        return false;
+    return record[0] == 1 && (record[3] & 0x2);
+}
+
+// Orders decodebin's decoder candidates for one coded stream, from registry
+// metadata alone (no plugin is loaded, so no other GPU is woken to decide).
+//
+// A decoder on the GPU that renders the page comes first: its pictures reach the
+// compositor without a copy, and ordinary video does not wake a second GPU.
+// Decoders of equal rank are otherwise tried in name order, which on a hybrid
+// laptop puts the discrete GPU's decoder first for every stream. Decoders state
+// their device as "drm-render-node" element metadata.
+//
+// A Dolby Vision stream with an enhancement layer is the exception: only a decoder
+// that states "dovi-enhancement-layer" = "compose" reconstructs the full picture,
+// and any other presents just the base layer, so those lead wherever they run.
+//
+// Other candidates (parsers) keep their positions, and decoders otherwise keep
+// decodebin's rank order. Returns null when nothing moves.
+inline GValueArray* orderDecoderFactories(GstCaps* caps, GValueArray* factories)
+{
+ALLOW_DEPRECATED_DECLARATIONS_BEGIN
+    CString renderNode;
+#if USE(GBM)
+    if (DRMDeviceManager::singleton().isInitialized())
+        renderNode = DRMDeviceManager::singleton().mainDevice().renderNode;
+#endif
+    bool needsComposition = doviStreamHasEnhancementLayer(caps);
+    auto preferred = [&](GstElementFactory* factory) {
+        if (needsComposition)
+            return !g_strcmp0(gst_element_factory_get_metadata(factory, "dovi-enhancement-layer"), "compose");
+        return !renderNode.isNull() && !g_strcmp0(gst_element_factory_get_metadata(factory, "drm-render-node"), renderNode.data());
+    };
+
+    Vector<unsigned> slots;
+    Vector<GstElementFactory*> decoders;
+    for (unsigned i = 0; i < factories->n_values; i++) {
+        auto* factory = GST_ELEMENT_FACTORY_CAST(g_value_get_object(g_value_array_get_nth(factories, i)));
+        if (gst_element_factory_list_is_type(factory, GST_ELEMENT_FACTORY_TYPE_DECODER)) {
+            slots.append(i);
+            decoders.append(factory);
+        }
+    }
+    Vector<GstElementFactory*> ordered;
+    for (bool lead : { true, false }) {
+        for (auto* factory : decoders) {
+            if (preferred(factory) == lead)
+                ordered.append(factory);
+        }
+    }
+    if (ordered == decoders)
+        return nullptr;
+
+    GST_DEBUG("Decoder order for %" GST_PTR_FORMAT ": %s first (%s)", caps, GST_OBJECT_NAME(ordered.first()),
+        needsComposition ? "composes the Dolby enhancement layer" : "on the rendering GPU");
+    GValueArray* result = g_value_array_copy(factories);
+    for (unsigned j = 0; j < slots.size(); j++)
+        g_value_set_object(g_value_array_get_nth(result, slots[j]), ordered[j]);
+    return result;
+ALLOW_DEPRECATED_DECLARATIONS_END
+}
+
+} // namespace WebCore
+#endif
diff --git a/Source/WebCore/platform/graphics/gstreamer/GStreamerDoviInputHistory.h b/Source/WebCore/platform/graphics/gstreamer/GStreamerDoviInputHistory.h
new file mode 100644
index 00000000..92471ef5
--- /dev/null
+++ b/Source/WebCore/platform/graphics/gstreamer/GStreamerDoviInputHistory.h
@@ -0,0 +1,72 @@
+/* Copyright (C) 2026 ROG HDR contributors.
+ * SPDX-License-Identifier: BSD-2-Clause */
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <functional>
+
+namespace WebCore {
+
+// One input-holder history in one caller-owned, drained source/load epoch.
+// Construct with true only when attached BEFORE any input in that epoch. A new
+// instance is allowed only after the caller proves a whole-pipeline READY drain.
+// The caller owns pipeline blocking/order, topology subscriptions/revalidation,
+// upstream-holder history checks, and fresh stream/CAPS/protection qualification.
+// This atomic history does not itself stop a buffer or reset a GStreamer element.
+class OriginalInputHistory {
+public:
+    explicit OriginalInputHistory(bool observedBeforeBytes)
+        : m_word(observedBeforeBytes ? pending : tainted) { }
+
+    // Single use. The nonthrowing callback must finish every subscription,
+    // topology revalidation and upstream-holder check before returning true.
+    // It runs without a history lock. Any first byte or invalidation while the
+    // callback runs prevents the exact arming -> armed CAS from succeeding.
+    bool arm(const std::function<bool()>& subscriptionAndRevalidate)
+    {
+        uint32_t expected = pending;
+        if (!subscriptionAndRevalidate || !m_word.compare_exchange_strong(expected, arming, std::memory_order_acq_rel, std::memory_order_acquire)) {
+            invalidate();
+            return false;
+        }
+        if (!subscriptionAndRevalidate()) {
+            invalidate();
+            return false;
+        }
+        expected = arming; // EXACTLY arming: neither seen nor tainted may be set.
+        if (!m_word.compare_exchange_strong(expected, armed, std::memory_order_acq_rel, std::memory_order_acquire)) {
+            invalidate();
+            return false;
+        }
+        return isArmed();
+    }
+
+    // The first operation records Seen in the SAME atomic word as the state,
+    // before taking any caller lock. A separate seen flag and state load would
+    // let arm commit between those operations and retroactively trust old input.
+    bool observeBytes()
+    {
+        uint32_t previous = m_word.fetch_or(seen, std::memory_order_acq_rel);
+        if ((previous & (stateMask | tainted)) != armed) {
+            invalidate();
+            return false;
+        }
+        return isArmed();
+    }
+    void invalidate() { m_word.fetch_or(tainted, std::memory_order_acq_rel); }
+    bool isArmed() const { return (m_word.load(std::memory_order_acquire) & (stateMask | tainted)) == armed; }
+    bool hasSeenBytes() const { return m_word.load(std::memory_order_acquire) & seen; }
+
+private:
+    static constexpr uint32_t pending = 0;
+    static constexpr uint32_t arming = 1;
+    static constexpr uint32_t armed = 2;
+    static constexpr uint32_t stateMask = 3;
+    static constexpr uint32_t seen = 4;
+    static constexpr uint32_t tainted = 8;
+    static_assert(std::atomic<uint32_t>::is_always_lock_free);
+    std::atomic<uint32_t> m_word;
+};
+
+} // namespace WebCore
diff --git a/Source/WebCore/platform/graphics/gstreamer/GStreamerDoviInputSetup.h b/Source/WebCore/platform/graphics/gstreamer/GStreamerDoviInputSetup.h
new file mode 100644
index 00000000..9b014ff7
--- /dev/null
+++ b/Source/WebCore/platform/graphics/gstreamer/GStreamerDoviInputSetup.h
@@ -0,0 +1,25 @@
+/* Copyright (C) 2026 ROG HDR contributors. SPDX-License-Identifier: BSD-2-Clause */
+#pragma once
+#include <gst/gst.h>
+namespace WebCore {
+// Keep both locks through probe/subscription installation. Committed READY
+// alone is insufficient: READY->PAUSED may already be activating the pad/task.
+class OriginalInputSetup {
+public:
+    OriginalInputSetup(GstElement* element, GstPad* pad) : m_element(element), m_pad(pad)
+    { GST_STATE_LOCK(m_element); GST_PAD_STREAM_LOCK(m_pad); }
+    ~OriginalInputSetup() { GST_PAD_STREAM_UNLOCK(m_pad); GST_STATE_UNLOCK(m_element); }
+    OriginalInputSetup(const OriginalInputSetup&) = delete;
+    OriginalInputSetup& operator=(const OriginalInputSetup&) = delete;
+    bool beforeBytes() const
+    {
+        auto pending = GST_STATE_PENDING(m_element);
+        return GST_STATE(m_element) <= GST_STATE_READY
+            && (pending == GST_STATE_VOID_PENDING || pending <= GST_STATE_READY)
+            && !gst_pad_is_active(m_pad);
+    }
+private:
+    GstElement* m_element;
+    GstPad* m_pad;
+};
+} // namespace WebCore
diff --git a/Source/WebCore/platform/graphics/gstreamer/GStreamerDoviOriginalSource.h b/Source/WebCore/platform/graphics/gstreamer/GStreamerDoviOriginalSource.h
new file mode 100644
index 00000000..1c11664b
--- /dev/null
+++ b/Source/WebCore/platform/graphics/gstreamer/GStreamerDoviOriginalSource.h
@@ -0,0 +1,320 @@
+/* Copyright (C) 2026 ROG HDR contributors.
+ * SPDX-License-Identifier: BSD-2-Clause */
+#pragma once
+
+#include <gst/gst.h>
+#include <algorithm>
+#include <functional>
+#include <memory>
+#include <optional>
+#include <utility>
+#include <vector>
+
+namespace WebCore {
+
+class OriginalSourceTopology;
+inline std::optional<OriginalSourceTopology> captureOriginalSourceTopology(GstElement*, GstPad*, GstElement*);
+inline std::optional<OriginalSourceTopology> captureOriginalByteInputTopology(GstElement*, GstPad*, GstElement*);
+
+// A referenced topology witness, NOT a lock or a mutation lease. The caller must
+// subscribe to linked/unlinked on ALL observed pads (including ghost internals),
+// pad-added/removed on observed elements, and element-added/removed on observed
+// bins, FILTERING those signals with observesPadMutation/observesElementMutation,
+// then revalidate before use. Unrelated downstream autoplugging is not a change
+// to this upstream proof. GstObject notify::parent is not emitted by set_parent/
+// unparent. Any relevant observed mutation permanently invalidates that lease;
+// revalidation alone cannot detect unlink/relink ABA or make a snapshot atomic.
+// The caller also authenticates the original WebKitWebSrc instance, binds the
+// actual demux OUTPUT pad and source/load epoch, and handles stream/protection
+// events. This helper only establishes the byte-preserving upstream topology.
+// It cannot certify bytes previously buffered by any element: the caller must
+// arm before first input or prove a reset/drain and fresh post-proof stream/CAPS.
+class OriginalSourceTopology {
+public:
+    OriginalSourceTopology(OriginalSourceTopology&&) = default;
+    OriginalSourceTopology& operator=(OriginalSourceTopology&&) = default;
+    OriginalSourceTopology(const OriginalSourceTopology&) = delete;
+    OriginalSourceTopology& operator=(const OriginalSourceTopology&) = delete;
+
+    enum class EdgeKind { Parent, Peer, Internal, Target };
+    struct Edge {
+        EdgeKind kind;
+        GstObject* from;
+        GstObject* to;
+        bool operator==(const Edge& other) const { return kind == other.kind && from == other.from && to == other.to; }
+    };
+    const std::vector<Edge>& observedEdges() const { return m_relations; }
+    const std::vector<GstPad*>& observedPads() const { return m_pads; }
+    const std::vector<GstElement*>& observedElements() const { return m_elements; }
+    bool revalidate() const;
+    bool observesPadMutation(GstElement* owner, GstPad* changed) const
+    {
+        for (const auto& inventory : m_inventories) {
+            if (inventory.element == owner)
+                return !inventory.sinksOnly || GST_PAD_DIRECTION(changed) == GST_PAD_SINK;
+        }
+        return std::find(m_pads.begin(), m_pads.end(), changed) != m_pads.end()
+            && recorded(EdgeKind::Parent, GST_OBJECT(changed)) == GST_OBJECT(owner);
+    }
+    bool observesElementMutation(GstElement* owner, GstElement* changed) const
+    {
+        return recorded(EdgeKind::Parent, GST_OBJECT(changed)) == GST_OBJECT(owner);
+    }
+
+private:
+    friend std::optional<OriginalSourceTopology> captureOriginalSourceTopology(GstElement*, GstPad*, GstElement*);
+    friend std::optional<OriginalSourceTopology> captureOriginalByteInputTopology(GstElement*, GstPad*, GstElement*);
+    struct Inventory {
+        GstElement* element;
+        bool sinksOnly;
+        std::vector<GstPad*> pads;
+        bool operator==(const Inventory& other) const { return element == other.element && sinksOnly == other.sinksOnly && pads == other.pads; }
+    };
+    OriginalSourceTopology(GstElement* demux, GstPad* sink, GstElement* source, bool byteInput = false)
+        : m_demux(demux), m_sink(sink), m_source(source), m_byteInput(byteInput) { }
+
+    // All getters return full references; retain() also keeps borrowed identities
+    // alive, preventing an object address from being reused during revalidation.
+    bool retain(GstObject* object)
+    {
+        if (!object || std::find(m_objects.begin(), m_objects.end(), object) != m_objects.end())
+            return true;
+        if (m_objects.size() >= 512)
+            return false;
+        m_objects.push_back(object);
+        m_refs.emplace_back(static_cast<GstObject*>(gst_object_ref(object)), gst_object_unref);
+        if (GST_IS_ELEMENT(object))
+            m_elements.push_back(GST_ELEMENT(object));
+        auto* parent = gst_object_get_parent(object);
+        m_relations.push_back({ EdgeKind::Parent, object, parent });
+        bool valid = retain(parent);
+        if (parent)
+            gst_object_unref(parent);
+        return valid;
+    }
+    bool relation(EdgeKind kind, GstObject* from, GstObject* to)
+    {
+        m_relations.push_back({ kind, from, to });
+        return retain(from) && retain(to);
+    }
+    GstObject* recorded(EdgeKind kind, GstObject* from) const
+    {
+        auto edge = std::find_if(m_relations.begin(), m_relations.end(), [&](const auto& candidate) {
+            return candidate.kind == kind && candidate.from == from;
+        });
+        return edge == m_relations.end() ? nullptr : edge->to;
+    }
+    bool observePad(GstPad* pad)
+    {
+        if (!pad)
+            return false;
+        if (std::find(m_pads.begin(), m_pads.end(), pad) != m_pads.end())
+            return true;
+        if (m_pads.size() >= 256 || !retain(GST_OBJECT(pad)))
+            return false;
+        m_pads.push_back(pad);
+        auto* peer = gst_pad_get_peer(pad);
+        bool valid = relation(EdgeKind::Peer, GST_OBJECT(pad), GST_OBJECT(peer));
+        if (peer)
+            gst_object_unref(peer);
+        if (GST_IS_PROXY_PAD(pad)) {
+            auto* internal = gst_proxy_pad_get_internal(GST_PROXY_PAD(pad));
+            valid = relation(EdgeKind::Internal, GST_OBJECT(pad), GST_OBJECT(internal)) && valid;
+            if (internal) {
+                valid = observePad(GST_PAD(internal)) && valid;
+                gst_object_unref(internal);
+            }
+        }
+        if (GST_IS_GHOST_PAD(pad)) {
+            auto* target = gst_ghost_pad_get_target(GST_GHOST_PAD(pad));
+            valid = relation(EdgeKind::Target, GST_OBJECT(pad), GST_OBJECT(target)) && valid;
+            if (target) {
+                valid = observePad(target) && valid;
+                gst_object_unref(target);
+            }
+        }
+        return valid;
+    }
+    bool inventory(GstElement* element, std::vector<GstPad*>& pads, bool sinksOnly = false)
+    {
+        auto* iterator = sinksOnly ? gst_element_iterate_sink_pads(element) : gst_element_iterate_pads(element);
+        GValue value = G_VALUE_INIT;
+        GstIteratorResult result;
+        while ((result = gst_iterator_next(iterator, &value)) == GST_ITERATOR_OK) {
+            auto* pad = GST_PAD(g_value_get_object(&value));
+            if (!observePad(pad)) {
+                g_value_unset(&value);
+                gst_iterator_free(iterator);
+                return false;
+            }
+            pads.push_back(pad);
+            g_value_reset(&value);
+        }
+        if (G_IS_VALUE(&value))
+            g_value_unset(&value);
+        gst_iterator_free(iterator);
+        // RESYNC means a concurrent mutation, not permission to accept a partial
+        // inventory. Fail closed rather than retrying an unstable graph.
+        if (result != GST_ITERATOR_DONE)
+            return false;
+        std::sort(pads.begin(), pads.end(), std::less<GstPad*>());
+        m_inventories.push_back({ element, sinksOnly, pads });
+        return retain(GST_OBJECT(element));
+    }
+    static bool factoryIs(GstElement* element, const char* name)
+    {
+        auto* factory = gst_element_factory_find(name);
+        bool matches = factory && gst_element_get_factory(element) == factory;
+        if (factory)
+            gst_object_unref(factory);
+        return matches;
+    }
+    bool ghostIsConsistent(GstPad* ghost) const
+    {
+        if (!GST_IS_GHOST_PAD(ghost))
+            return false;
+        // All pointers below come from the same recorded graph and have strong
+        // references. Never requery an edge and assume its new result was the
+        // object retained by observePad: concurrent retarget may replace/remove it.
+        auto* owner = recorded(EdgeKind::Parent, GST_OBJECT(ghost));
+        bool structuralOwner = owner && GST_IS_BIN(owner)
+            && (G_OBJECT_TYPE(owner) == GST_TYPE_BIN
+                || factoryIs(GST_ELEMENT(owner), "playbin")
+                || factoryIs(GST_ELEMENT(owner), "uridecodebin")
+                || factoryIs(GST_ELEMENT(owner), "decodebin"));
+        if (!structuralOwner)
+            return false;
+        auto* internal = recorded(EdgeKind::Internal, GST_OBJECT(ghost));
+        auto* target = recorded(EdgeKind::Target, GST_OBJECT(ghost));
+        auto* targetOwner = target ? recorded(EdgeKind::Parent, target) : nullptr;
+        return internal && GST_IS_PROXY_PAD(internal) && target && GST_IS_PAD(target)
+            && recorded(EdgeKind::Internal, internal) == GST_OBJECT(ghost)
+            && recorded(EdgeKind::Parent, internal) == GST_OBJECT(ghost)
+            && recorded(EdgeKind::Peer, internal) == target
+            && recorded(EdgeKind::Peer, target) == internal
+            && targetOwner && GST_IS_ELEMENT(targetOwner)
+            && recorded(EdgeKind::Parent, targetOwner) == owner
+            && GST_PAD_DIRECTION(GST_PAD(target)) == GST_PAD_DIRECTION(ghost)
+            && GST_PAD_DIRECTION(GST_PAD(internal)) != GST_PAD_DIRECTION(ghost);
+    }
+    bool build()
+    {
+        if (!m_demux || !m_sink || !m_source || m_demux == m_source
+            || !(factoryIs(m_demux, "qtdemux") || (m_byteInput && (factoryIs(m_demux, "typefind")
+                || factoryIs(m_demux, "queue2") || factoryIs(m_demux, "downloadbuffer"))))
+            || GST_IS_BIN(m_source)
+            || GST_PAD_DIRECTION(m_sink) != GST_PAD_SINK
+            || !gst_object_has_as_parent(GST_OBJECT(m_sink), GST_OBJECT(m_demux)))
+            return false;
+        std::vector<GstPad*> demuxPads;
+        // Dynamic audio/video outputs are owned by the caller's selected-output
+        // binding. Recording them here would revoke a valid upstream proof during
+        // ordinary downstream autoplugging immediately after demux pad-added.
+        if (!inventory(m_demux, demuxPads, true) || demuxPads.size() != 1 || demuxPads.front() != m_sink
+            || recorded(EdgeKind::Parent, GST_OBJECT(m_sink)) != GST_OBJECT(m_demux))
+            return false;
+        GstPad* current = m_sink;
+        std::vector<GstPad*> visited;
+        for (unsigned hop = 0; hop < 64; ++hop) {
+            if (std::find(visited.begin(), visited.end(), current) != visited.end() || !observePad(current))
+                return false;
+            visited.push_back(current);
+            if (GST_PAD_DIRECTION(current) == GST_PAD_SINK) {
+                auto* peer = recorded(EdgeKind::Peer, GST_OBJECT(current));
+                if (!peer || !GST_IS_PAD(peer) || !observePad(GST_PAD(peer))
+                    || recorded(EdgeKind::Peer, peer) != GST_OBJECT(current)
+                    || GST_PAD_DIRECTION(GST_PAD(peer)) != GST_PAD_SRC)
+                    return false;
+                current = GST_PAD(peer);
+                continue;
+            }
+            if (GST_PAD_DIRECTION(current) != GST_PAD_SRC)
+                return false;
+            if (GST_IS_GHOST_PAD(current)) {
+                if (!ghostIsConsistent(current))
+                    return false;
+                current = GST_PAD(recorded(EdgeKind::Target, GST_OBJECT(current)));
+                continue;
+            }
+            if (GST_IS_PROXY_PAD(current)) {
+                // A source proxy is the INTERNAL side of an outer sink ghost.
+                // Its upstream continuation is that ghost's external peer,
+                // never the proxy's own peer (which points downstream).
+                auto* outer = recorded(EdgeKind::Internal, GST_OBJECT(current));
+                if (!outer || !GST_IS_GHOST_PAD(outer)
+                    || GST_PAD_DIRECTION(GST_PAD(outer)) != GST_PAD_SINK
+                    || !ghostIsConsistent(GST_PAD(outer)))
+                    return false;
+                current = GST_PAD(outer);
+                continue;
+            }
+            auto* parent = recorded(EdgeKind::Parent, GST_OBJECT(current));
+            if (!parent || !GST_IS_ELEMENT(parent))
+                return false;
+            auto* element = GST_ELEMENT(parent);
+            bool source = element == m_source;
+            bool allowed = source || (!GST_IS_BIN(element) && (factoryIs(element, "typefind")
+                || factoryIs(element, "queue2") || factoryIs(element, "downloadbuffer")));
+            std::vector<GstPad*> pads;
+            bool valid = allowed && inventory(element, pads);
+            GstPad* sink = nullptr;
+            unsigned sourceCount = 0;
+            unsigned sinkCount = 0;
+            for (auto* pad : pads) {
+                if (GST_PAD_DIRECTION(pad) == GST_PAD_SRC) {
+                    ++sourceCount;
+                    valid = valid && pad == current;
+                } else if (GST_PAD_DIRECTION(pad) == GST_PAD_SINK) {
+                    ++sinkCount;
+                    sink = pad;
+                } else
+                    valid = false;
+            }
+            if (!valid || sourceCount != 1 || sinkCount != (source ? 0u : 1u))
+                return false;
+            if (source)
+                return true;
+            current = sink;
+        }
+        return false;
+    }
+
+    GstElement* m_demux;
+    GstPad* m_sink;
+    GstElement* m_source;
+    bool m_byteInput;
+    std::vector<std::shared_ptr<GstObject>> m_refs;
+    std::vector<GstObject*> m_objects;
+    std::vector<GstPad*> m_pads;
+    std::vector<GstElement*> m_elements;
+    std::vector<Edge> m_relations;
+    std::vector<Inventory> m_inventories;
+};
+
+inline std::optional<OriginalSourceTopology> captureOriginalSourceTopology(GstElement* demux, GstPad* sink, GstElement* source)
+{
+    OriginalSourceTopology proof(demux, sink, source);
+    if (!proof.build())
+        return std::nullopt;
+    return proof;
+}
+
+// For a caller arming byte-history attestation BEFORE first input: the terminal
+// may also be one of the three supported byte holders. This snapshot alone does
+// not assert that any previously buffered bytes have the same provenance.
+inline std::optional<OriginalSourceTopology> captureOriginalByteInputTopology(GstElement* consumer, GstPad* sink, GstElement* source)
+{
+    OriginalSourceTopology proof(consumer, sink, source, true);
+    if (!proof.build())
+        return std::nullopt;
+    return proof;
+}
+
+inline bool OriginalSourceTopology::revalidate() const
+{
+    auto current = m_byteInput ? captureOriginalByteInputTopology(m_demux, m_sink, m_source)
+        : captureOriginalSourceTopology(m_demux, m_sink, m_source);
+    return current && current->m_relations == m_relations && current->m_inventories == m_inventories;
+}
+
+} // namespace WebCore
