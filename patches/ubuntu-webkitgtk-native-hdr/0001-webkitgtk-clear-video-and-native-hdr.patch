+/* Copyright (C) 2026 ROG HDR contributors. SPDX-License-Identifier: BSD-2-Clause */
+#pragma once
+#include <cstddef>
+#include <cstdint>
+namespace WebCore {
+constexpr size_t gtkNativeVideoMaxBytes = 64 * 1024 * 1024;
+constexpr size_t gtkNativeVideoByteLength(int width, int height, uint32_t stride)
+{
+    if (width <= 0 || height <= 0 || width > 8192 || height > 8192
+        || stride != static_cast<uint32_t>(width) * 8) return 0;
+    auto bytes = static_cast<size_t>(stride) * height;
+    return bytes <= gtkNativeVideoMaxBytes ? bytes : 0;
+}
+} // namespace WebCore
diff --git a/Source/WebCore/platform/graphics/texmap/GTKVideoSourceRegistry.h b/Source/WebCore/platform/graphics/texmap/GTKVideoSourceRegistry.h
new file mode 100644
