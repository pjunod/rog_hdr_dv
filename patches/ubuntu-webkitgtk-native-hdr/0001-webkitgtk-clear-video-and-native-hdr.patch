+            && state.reference_luminance == 203 && state.max_luminance == 10000
+            && std::isfinite(physical.max_luminance) && std::isfinite(physical.min_luminance)
+            && physical.max_luminance > physical.min_luminance && physical.min_luminance >= 0
+            && std::isfinite(physical.reference_luminance) && physical.reference_luminance > 0) {
+            target.generation = physical.generation;
+            std::copy_n(physical.primaries, target.primaries.size(), target.primaries.begin());
+            target.black = physical.min_luminance;
+            target.peak = physical.max_luminance;
+            target.reference = physical.reference_luminance;
