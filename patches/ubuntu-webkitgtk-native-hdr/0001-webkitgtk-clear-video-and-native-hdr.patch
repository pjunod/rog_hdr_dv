+void AcceleratedBackingStore::updateVideoTarget(bool candidate)
+{
+    GTKVideoTarget target;
+    target.revision = m_videoTarget.revision;
+#if PLATFORM(WAYLAND) && defined(GDK_TYPE_WAYLAND_HDR_RENDERING)
+    static auto request = reinterpret_cast<decltype(&gdk_wayland_surface_request_hdr_rendering)>(dlsym(RTLD_DEFAULT, "gdk_wayland_surface_request_hdr_rendering"));
+    static auto physicalTarget = reinterpret_cast<decltype(&gdk_wayland_surface_get_color_target)>(dlsym(RTLD_DEFAULT, "gdk_wayland_surface_get_color_target"));
+    static auto renderState = reinterpret_cast<decltype(&gdk_wayland_hdr_rendering_get_state)>(dlsym(RTLD_DEFAULT, "gdk_wayland_hdr_rendering_get_state"));
