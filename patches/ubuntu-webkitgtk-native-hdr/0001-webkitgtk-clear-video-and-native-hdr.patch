+
+void AcceleratedBackingStore::setVideoSourceState(ProcessIdentifier process, uint64_t revision, uint64_t selection, bool active)
+{
+    if (!revision || !m_webPage || m_webPage->legacyMainFrameProcess().coreProcessIdentifier() != process)
+        return;
+    if (m_sourceProcess != process) {
+        m_activeVideoSources.clear();
+        m_sourceProcess = process;
+    }
+    if (active) {
+        if (!m_activeVideoSources.activate(revision, selection))
+            return;
+        if (m_surfaceID) {
+            if (RefPtr source = m_legacyMainFrameProcess.get(); source && source->coreProcessIdentifier() == process)
+                source->send(Messages::AcceleratedSurface::SourceActivated(revision), m_surfaceID);
+        }
+    } else
+        m_activeVideoSources.revoke(revision, selection);
+    auto accepts = [&](const GTKVideoPlane& plane) {
+        return m_sourceProcess == plane.sourceProcess
+            && m_activeVideoSources.accepts(plane.sourceRevision, plane.sourceSelection);
+    };
+    if (m_pendingPlane && !accepts(*m_pendingPlane))
+        m_pendingPlane.reset();
+    if (m_committedPlane && !accepts(*m_committedPlane)) {
+        m_committedPlane.reset(); m_videoTexture = nullptr;
+    }
+    gtk_widget_queue_draw(m_webPage->viewWidget());
+}
+
+void AcceleratedBackingStore::videoFrame(uint64_t id, Rects&& damage, UnixFileDescriptor&& fence, uint64_t serial, std::optional<GTKVideoPlane>&& plane)
+{
+    frame(id, WTF::move(damage), WTF::move(fence));
+    if (!m_pendingBuffer || m_pendingBuffer->id() != id || serial <= m_lastVideoSerial)
+        return;
+    m_lastVideoSerial = serial;
+    m_pendingVideoCandidate = true;
+    if (plane && (m_sourceProcess != plane->sourceProcess || !m_activeVideoSources.accepts(plane->sourceRevision, plane->sourceSelection)))
+        plane.reset();
+    m_pendingPlane = WTF::move(plane);
+}
+
+bool AcceleratedBackingStore::snapshotNativeVideo(GtkSnapshot* snapshot)
+{
+#if GTK_CHECK_VERSION(4, 16, 0) && G_BYTE_ORDER == G_LITTLE_ENDIAN
+    if (!m_videoTarget.ready || !m_committedPlane || !m_committedBuffer->texture())
+        return false;
+    auto& plane = *m_committedPlane;
+    const auto& extent = m_committedBuffer->pixelSize();
+    const auto& rect = plane.destination;
+    if (m_sourceProcess != plane.sourceProcess || !m_activeVideoSources.accepts(plane.sourceRevision, plane.sourceSelection)
+        || plane.revision != m_videoTarget.revision || plane.generation != m_videoTarget.generation || rect.isEmpty()
+        || rect.x() < 0 || rect.y() < 0 || rect.width() > extent.width() - rect.x() || rect.height() > extent.height() - rect.y())
+        return false;
+    if (!m_videoTexture) {
+        size_t bytes = GTKVideoPlane::byteLength(plane.size, plane.stride);
+        struct stat st { };
+        constexpr int requiredSeals = F_SEAL_WRITE | F_SEAL_SHRINK | F_SEAL_GROW;
+        int seals = plane.pixels ? fcntl(plane.pixels.value(), F_GET_SEALS) : -1;
+        if (!bytes || seals < 0 || (seals & requiredSeals) != requiredSeals || fstat(plane.pixels.value(), &st)
+            || !S_ISREG(st.st_mode) || st.st_size != static_cast<off_t>(bytes))
+            return false;
+        GMappedFile* file = g_mapped_file_new_from_fd(plane.pixels.value(), false, nullptr);
+        if (!file)
+            return false;
+        auto pixels = adoptGRef(g_mapped_file_get_bytes(file));
+        g_mapped_file_unref(file);
+        auto builder = adoptGRef(gdk_memory_texture_builder_new());
+        gdk_memory_texture_builder_set_bytes(builder.get(), pixels.get());
+        gdk_memory_texture_builder_set_width(builder.get(), plane.size.width());
+        gdk_memory_texture_builder_set_height(builder.get(), plane.size.height());
+        gdk_memory_texture_builder_set_stride(builder.get(), plane.stride);
+        gdk_memory_texture_builder_set_format(builder.get(), GDK_MEMORY_R16G16B16A16);
+        gdk_memory_texture_builder_set_color_state(builder.get(), gdk_color_state_get_rec2100_pq());
+        m_videoTexture = adoptGRef(gdk_memory_texture_builder_build(builder.get()));
+        if (!m_videoTexture)
+            return false;
+    }
+
+    float scale = m_committedBuffer->deviceScaleFactor();
+    auto clip = [scale](const IntRect& r) -> graphene_rect_t {
+        return GRAPHENE_RECT_INIT(r.x() / scale, r.y() / scale, r.width() / scale, r.height() / scale);
+    };
+    auto bounds = clip(rect);
+    gtk_snapshot_append_texture(snapshot, m_videoTexture.get(), &bounds);
+    // Keep the full SDR page available. Construct the hole in this GTK snapshot
+    // only; a revoked target can immediately present the very same SDR frame.
+    const IntRect bands[] = {
+        { 0, 0, extent.width(), rect.y() }, { 0, rect.maxY(), extent.width(), extent.height() - rect.maxY() },
+        { 0, rect.y(), rect.x(), rect.height() }, { rect.maxX(), rect.y(), extent.width() - rect.maxX(), rect.height() }
+    };
+    for (const auto& band : bands) {
+        if (band.isEmpty())
+            continue;
+        auto bounds = clip(band);
+        gtk_snapshot_push_clip(snapshot, &bounds);
+        m_committedBuffer->snapshot(snapshot);
+        gtk_snapshot_pop(snapshot);
+    }
+    return true;
+#else
+    UNUSED_PARAM(snapshot);
+    return false;
+#endif
+}
