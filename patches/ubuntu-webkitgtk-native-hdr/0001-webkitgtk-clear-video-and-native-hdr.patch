diff --git a/Tools/dovi-input-history-probe.cpp b/Tools/dovi-input-history-probe.cpp
new file mode 100644
index 00000000..e4776428
--- /dev/null
+++ b/Tools/dovi-input-history-probe.cpp
@@ -0,0 +1,191 @@
+/* Copyright (C) 2026 ROG HDR contributors.
+ * SPDX-License-Identifier: BSD-2-Clause */
+// CPU-only state/topology probe: no media, network, decoder, GPU or browser.
+// Build with C++20, -pthread, -Wall -Wextra -Werror and gstreamer-1.0 pkg-config.
+// Run with G_DEBUG=fatal-criticals and ASan/UBSan; production pipeline ordering,
+// whole-pipeline drain evidence and browser UI leases are separate obligations.
+#include "GStreamerDoviInputHistory.h"
+#include "GStreamerDoviOriginalSource.h"
+#include <barrier>
+#include <cstdio>
+#include <cstdlib>
+#include <thread>
+
+using WebCore::OriginalInputHistory;
+using WebCore::captureOriginalByteInputTopology;
+using WebCore::captureOriginalSourceTopology;
+
+static void require(bool condition, const char* description)
+{
+    if (!condition) {
+        std::fprintf(stderr, "FAIL: %s\n", description);
+        std::abort();
+    }
+}
+
+struct Graph {
+    GstElement* pipeline { gst_pipeline_new(nullptr) };
+    ~Graph()
+    {
+        gst_element_set_state(pipeline, GST_STATE_NULL);
+        gst_object_unref(pipeline);
+    }
+    GstElement* make(const char* factory)
+    {
+        auto* element = gst_element_factory_make(factory, nullptr);
+        require(element && gst_bin_add(GST_BIN(pipeline), element), factory);
+        return element;
+    }
+    void readyDrain()
+    {
+        require(gst_element_set_state(pipeline, GST_STATE_READY) != GST_STATE_CHANGE_FAILURE, "caller resets complete synthetic pipeline to READY");
+        GstState state = GST_STATE_NULL;
+        require(gst_element_get_state(pipeline, &state, nullptr, GST_SECOND) != GST_STATE_CHANGE_FAILURE && state == GST_STATE_READY, "caller observes READY completion");
+    }
+};
+
+static GstPad* sink(GstElement* element)
+{
+    auto* pad = gst_element_get_static_pad(element, "sink");
+    require(pad, "consumer sink exists");
+    gst_object_unref(pad); // Borrowed from an element retained by Graph.
+    return pad;
+}
+
+static void link(GstElement* source, GstElement* consumer)
+{
+    require(gst_element_link(source, consumer), "link source path");
+}
+
+static void stateTransitions()
+{
+    OriginalInputHistory late(false);
+    bool called = false;
+    require(!late.arm([&] { called = true; return true; }) && !called, "late attachment starts tainted without running arm callback");
+    require(!late.observeBytes() && late.hasSeenBytes(), "late attachment still records input");
+
+    OriginalInputHistory before(false);
+    before.invalidate();
+    require(!before.arm([] { return true; }), "invalidation cannot be undone");
+
+    OriginalInputHistory early(true);
+    require(!early.isArmed() && !early.hasSeenBytes(), "early history starts pending without bytes");
+    require(!early.observeBytes() && early.hasSeenBytes(), "pending first byte taints before arming");
+    require(!early.arm([] { return true; }), "pending prefill cannot be retroactively armed");
+
+    OriginalInputHistory rejected(true);
+    require(!rejected.arm([] { return false; }), "failed upstream/subscription check rejects arm");
+    require(!rejected.arm([] { return true; }), "failed arm permanently taints");
+
+    OriginalInputHistory empty(true);
+    require(!empty.arm({}) && !empty.arm([] { return true; }), "empty arm callback permanently taints");
+
+    OriginalInputHistory valid(true);
+    require(valid.arm([] { return true; }) && valid.isArmed(), "pristine history arms after successful checks");
+    require(valid.observeBytes() && valid.hasSeenBytes() && valid.isArmed(), "normal armed first byte records Seen without taint");
+    require(valid.observeBytes(), "later bytes remain valid in the same armed history");
+    valid.invalidate();
+    require(!valid.isArmed() && !valid.observeBytes(), "mutation permanently invalidates armed history");
+
+    OriginalInputHistory singleUse(true);
+    require(singleUse.arm([] { return true; }), "single-use initial arm");
+    require(!singleUse.arm([] { return true; }) && !singleUse.isArmed(), "repeated arm is rejected and cannot reopen history");
+}
+
+static void prefillAndReset()
+{
+    Graph graph;
+    auto* source = graph.make("fakesrc");
+    auto* unknown = graph.make("identity");
+    auto* holder = graph.make("queue2");
+    auto* demux = graph.make("qtdemux");
+    link(source, unknown);
+    link(unknown, holder);
+    link(holder, demux);
+    require(!captureOriginalByteInputTopology(holder, sink(holder), source), "unknown wrapped holder input rejected");
+    require(!captureOriginalSourceTopology(demux, sink(demux), source), "unknown wrapped demux path rejected");
+    OriginalInputHistory prefilling(true);
+    require(!prefilling.observeBytes(), "wrapped input before arm taints holder");
+    gst_element_unlink(source, unknown);
+    gst_element_unlink(unknown, holder);
+    link(source, holder);
+    auto direct = captureOriginalByteInputTopology(holder, sink(holder), source);
+    require(direct && direct->revalidate(), "current direct path is now a valid topology snapshot");
+    bool callbackRan = false;
+    require(!prefilling.arm([&] { callbackRan = true; return direct->revalidate(); }) && !callbackRan,
+        "old wrapped prefill cannot regain history after direct relink");
+    OriginalInputHistory lateDirect(false);
+    require(!lateDirect.arm([&] { return direct->revalidate(); }), "late attachment cannot certify existing direct-path bytes");
+
+    // This synthetic graph has sent no GstBuffers. It exercises the caller's
+    // explicit reset boundary; it is not proof of production queue draining.
+    graph.readyDrain();
+    OriginalInputHistory resetHolder(true);
+    auto holderProof = captureOriginalByteInputTopology(holder, sink(holder), source);
+    require(holderProof.has_value(), "reset holder direct path captured");
+    require(resetHolder.arm([&] { return holderProof->revalidate(); }), "fresh history after caller reset can arm");
+    OriginalInputHistory resetDemux(true);
+    auto demuxProof = captureOriginalSourceTopology(demux, sink(demux), source);
+    require(demuxProof.has_value(), "reset demux path includes allowed byte holder");
+    require(resetDemux.arm([&] { return resetHolder.isArmed() && demuxProof->revalidate(); }), "demux arms only after upstream holder history is valid");
+    require(resetHolder.observeBytes() && resetDemux.observeBytes(), "post-arm bytes traverse separately valid holder histories");
+    resetHolder.invalidate();
+    resetDemux.invalidate(); // The production owner propagates path invalidation.
+    require(!resetHolder.isArmed() && !resetDemux.isArmed(), "mutation revokes the dependent history chain");
+}
+
+static void armingRace(bool injectByte)
+{
+    Graph graph;
+    auto* source = graph.make("fakesrc");
+    auto* demux = graph.make("qtdemux");
+    link(source, demux);
+    OriginalInputHistory history(true);
+    std::barrier rendezvous(2);
+    bool armed = true;
+    std::thread worker([&] {
+        armed = history.arm([&] {
+            auto proof = captureOriginalSourceTopology(demux, sink(demux), source);
+            require(proof && proof->revalidate(), "concurrent arm callback checks actual direct topology");
+            rendezvous.arrive_and_wait(); // Arming is active, before final CAS.
+            rendezvous.arrive_and_wait(); // Wait until main records input/mutation.
+            return proof->revalidate();
+        });
+    });
+    rendezvous.arrive_and_wait();
+    if (injectByte)
+        require(!history.observeBytes(), "byte during Arming immediately taints");
+    else
+        history.invalidate();
+    rendezvous.arrive_and_wait();
+    worker.join();
+    require(!armed && !history.isArmed(), "exact Arming CAS cannot overwrite concurrent Seen/Tainted bits");
+    require(history.hasSeenBytes() == injectByte, "Seen accurately distinguishes byte from mutation");
+    require(!history.arm([] { return true; }), "race-tainted history cannot rearm");
+}
+
+static void normalConcurrentBytes()
+{
+    OriginalInputHistory history(true);
+    require(history.arm([] { return true; }), "arm before concurrent normal bytes");
+    std::barrier rendezvous(3);
+    bool first = false;
+    bool second = false;
+    std::thread a([&] { rendezvous.arrive_and_wait(); first = history.observeBytes(); });
+    std::thread b([&] { rendezvous.arrive_and_wait(); second = history.observeBytes(); });
+    rendezvous.arrive_and_wait();
+    a.join();
+    b.join();
+    require(first && second && history.isArmed() && history.hasSeenBytes(), "concurrent post-arm bytes preserve valid history");
+}
+
+int main(int argc, char** argv)
+{
+    gst_init(&argc, &argv);
+    stateTransitions();
+    prefillAndReset();
+    armingRace(true);
+    armingRace(false);
+    normalConcurrentBytes();
+    std::puts("PASS: single-word input history, prefill/relink/reset boundaries, exact topology, barrier-controlled byte/mutation races");
+}
diff --git a/Tools/dovi-input-setup-probe.cpp b/Tools/dovi-input-setup-probe.cpp
new file mode 100644
index 00000000..908e533b
--- /dev/null
+++ b/Tools/dovi-input-setup-probe.cpp
@@ -0,0 +1,54 @@
+/* Copyright (C) 2026 ROG HDR contributors. SPDX-License-Identifier: BSD-2-Clause */
+#include "GStreamerDoviInputSetup.h"
+#include "GStreamerDoviInputHistory.h"
+#include <cassert>
+#include <cstdio>
+using namespace WebCore;
+static unsigned received;
+static GstFlowReturn accept(GstPad*, GstObject*, GstBuffer* buffer)
+{ ++received; gst_buffer_unref(buffer); return GST_FLOW_OK; }
+int main(int argc, char** argv)
+{
+    gst_init(&argc, &argv);
+    auto* source = gst_element_factory_make("identity", nullptr);
+    auto* sink = gst_element_factory_make("identity", nullptr);
+    assert(source && sink);
+    gst_element_set_state(source, GST_STATE_READY);
+    gst_element_set_state(sink, GST_STATE_READY);
+    auto* output = gst_element_get_static_pad(source, "src");
+    auto* input = gst_element_get_static_pad(sink, "sink");
+    {
+        OriginalInputSetup setup(sink, input);
+        assert(setup.beforeBytes()); // Normal inactive READY setup.
+        OriginalInputHistory early(setup.beforeBytes());
+        assert(early.arm([] { return true; }));
+    }
+    // Exercise pad delivery independently of identity's normal PAUSED-state
+    // caps/allocation handler: the negative case intentionally stays READY.
+    gst_pad_set_event_function(input, +[](GstPad*, GstObject*, GstEvent* event) -> gboolean {
+        gst_event_unref(event); return TRUE;
+    });
+    gst_pad_set_chain_function(input, accept);
+    assert(gst_pad_set_active(input, TRUE));
+    assert(gst_pad_set_active(output, TRUE));
+    assert(gst_pad_link(output, input) == GST_PAD_LINK_OK);
+    gst_pad_push_event(output, gst_event_new_stream_start("cpu/old-history"));
+    auto* caps = gst_caps_new_empty_simple("application/octet-stream");
+    gst_pad_push_event(output, gst_event_new_caps(caps)); gst_caps_unref(caps);
+    GstSegment segment; gst_segment_init(&segment, GST_FORMAT_BYTES);
+    gst_pad_push_event(output, gst_event_new_segment(&segment));
+    assert(gst_pad_push(output, gst_buffer_new_allocate(nullptr, 4, nullptr)) == GST_FLOW_OK);
+    assert(received == 1 && GST_STATE(source) == GST_STATE_READY && GST_STATE(sink) == GST_STATE_READY);
+    bool observedEarly;
+    { OriginalInputSetup setup(sink, input); observedEarly = setup.beforeBytes(); assert(!observedEarly); }
+    OriginalInputHistory late(observedEarly);
+    assert(!late.arm([] { return true; }));
+    // Becoming inactive does not erase already accepted bytes or reopen history.
+    gst_pad_unlink(output, input);
+    gst_pad_set_active(output, FALSE); gst_pad_set_active(input, FALSE);
+    { OriginalInputSetup setup(sink, input); assert(setup.beforeBytes()); }
+    assert(!late.arm([] { return true; }));
+    gst_element_set_state(source, GST_STATE_NULL); gst_element_set_state(sink, GST_STATE_NULL);
+    gst_object_unref(output); gst_object_unref(input); gst_object_unref(source); gst_object_unref(sink);
+    std::puts("PASS inactive READY setup; active data while committed READY stays unqualified after deactivation");
+}
diff --git a/Tools/dovi-original-source-probe.cpp b/Tools/dovi-original-source-probe.cpp
new file mode 100644
index 00000000..db1f5d6a
--- /dev/null
+++ b/Tools/dovi-original-source-probe.cpp
@@ -0,0 +1,379 @@
+/* Copyright (C) 2026 ROG HDR contributors.
+ * SPDX-License-Identifier: BSD-2-Clause */
+// Run stress with G_DEBUG=fatal-criticals; additionally compile with
+// -fsanitize=address,undefined -fno-omit-frame-pointer when supported.
+// CPU-only topology probe; no pipeline state transition, media, decoder, GPU,
+// network access, or browser is needed. fakesrc stands in for the original source
+// INSTANCE only: the production caller separately authenticates WebKitWebSrc.
+// Build: c++ -std=c++20 -Wall -Wextra -Werror -pthread Tools/dovi-original-source-probe.cpp
+//   -ISource/WebCore/platform/graphics/gstreamer $(pkg-config --cflags --libs gstreamer-1.0) -o <owned-external-output>
+#include "GStreamerDoviOriginalSource.h"
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <thread>
+
+using WebCore::captureOriginalSourceTopology;
+using WebCore::captureOriginalByteInputTopology;
+using WebCore::OriginalSourceTopology;
+
+static void require(bool condition, const char* description)
+{
+    if (!condition) {
+        std::fprintf(stderr, "FAIL: %s\n", description);
+        std::abort();
+    }
+}
+
+struct Graph {
+    GstElement* pipeline { gst_pipeline_new(nullptr) };
+    ~Graph() { gst_object_unref(pipeline); }
+    GstElement* make(const char* factory, GstElement* parent = nullptr)
+    {
+        auto* element = gst_element_factory_make(factory, nullptr);
+        require(element, factory);
+        require(gst_bin_add(GST_BIN(parent ? parent : pipeline), element), "add element");
+        return element;
+    }
+    GstElement* bin(GstElement* parent = nullptr)
+    {
+        auto* element = gst_bin_new(nullptr);
+        require(gst_bin_add(GST_BIN(parent ? parent : pipeline), element), "add structural bin");
+        return element;
+    }
+};
+
+static GstPad* pad(GstElement* element, const char* name)
+{
+    auto* result = gst_element_get_static_pad(element, name);
+    require(result, name);
+    // Return a borrowed pointer. The owning element remains alive in Graph.
+    gst_object_unref(result);
+    return result;
+}
+
+static void link(GstElement* from, GstElement* to)
+{
+    require(gst_element_link(from, to), "link elements");
+}
+
+static GstPad* ghost(GstElement* owner, GstPad* target)
+{
+    auto* result = gst_ghost_pad_new(GST_PAD_DIRECTION(target) == GST_PAD_SRC ? "src" : "sink", target);
+    require(result && gst_element_add_pad(owner, result), "add ghost pad");
+    return result;
+}
+
+// Exercises the REQUIRED caller handshake and monotonic invalidation. A raw
+// witness intentionally does not remember mutations that restore identical
+// topology. Never use a successful later snapshot to reopen an old lease.
+class Lease {
+public:
+    explicit Lease(OriginalSourceTopology&& proof) : m_proof(std::move(proof))
+    {
+        for (auto* observed : m_proof.observedPads()) {
+            connect(G_OBJECT(observed), "linked", G_CALLBACK(+[](GstPad*, GstPad*, gpointer data) { static_cast<Lease*>(data)->revoke(); }));
+            connect(G_OBJECT(observed), "unlinked", G_CALLBACK(+[](GstPad*, GstPad*, gpointer data) { static_cast<Lease*>(data)->revoke(); }));
+        }
+        for (auto* observed : m_proof.observedElements()) {
+            connect(G_OBJECT(observed), "pad-added", G_CALLBACK(+[](GstElement* owner, GstPad* changed, gpointer data) { static_cast<Lease*>(data)->padMutation(owner, changed); }));
+            connect(G_OBJECT(observed), "pad-removed", G_CALLBACK(+[](GstElement* owner, GstPad* changed, gpointer data) { static_cast<Lease*>(data)->padMutation(owner, changed); }));
+            if (GST_IS_BIN(observed)) {
+                connect(G_OBJECT(observed), "element-added", G_CALLBACK(+[](GstBin* owner, GstElement* changed, gpointer data) { static_cast<Lease*>(data)->elementMutation(GST_ELEMENT(owner), changed); }));
+                connect(G_OBJECT(observed), "element-removed", G_CALLBACK(+[](GstBin* owner, GstElement* changed, gpointer data) { static_cast<Lease*>(data)->elementMutation(GST_ELEMENT(owner), changed); }));
+            }
+        }
+        if (!m_proof.revalidate())
+            revoke();
+    }
+    ~Lease() { for (const auto& signal : m_signals) g_signal_handler_disconnect(signal.first, signal.second); }
+    bool authorized() const { return !m_revoked.load() && m_proof.revalidate() && !m_revoked.load(); }
+private:
+    void revoke() { m_revoked.store(true); }
+    void padMutation(GstElement* owner, GstPad* changed)
+    {
+        if (m_proof.observesPadMutation(owner, changed))
+            revoke();
+    }
+    void elementMutation(GstElement* owner, GstElement* changed)
+    {
+        if (m_proof.observesElementMutation(owner, changed))
+            revoke();
+    }
+    void connect(GObject* object, const char* signal, GCallback callback)
+    {
+        m_signals.emplace_back(object, g_signal_connect(object, signal, callback, this));
+        require(m_signals.back().second, signal);
+    }
+    OriginalSourceTopology m_proof;
+    std::vector<std::pair<GObject*, gulong>> m_signals;
+    std::atomic<bool> m_revoked { false };
+};
+
+static void directAndIdentity()
+{
+    Graph graph;
+    auto* source = graph.make("fakesrc");
+    auto* otherSource = graph.make("fakesrc");
+    auto* demux = graph.make("qtdemux");
+    require(!captureOriginalSourceTopology(demux, pad(demux, "sink"), source), "unlinked graph rejected");
+    link(source, demux);
+    auto proof = captureOriginalSourceTopology(demux, pad(demux, "sink"), source);
+    require(proof && proof->revalidate(), "direct exact source accepted");
+    require(!captureOriginalSourceTopology(demux, pad(demux, "sink"), otherSource), "different same-factory source rejected");
+    require(!captureOriginalSourceTopology(demux, pad(source, "src"), source), "wrong demux sink rejected");
+    Lease lease(std::move(*proof));
+    require(lease.authorized(), "subscribed lease initially valid");
+    gst_element_unlink(source, demux);
+    require(!lease.authorized(), "unlink revokes lease");
+    link(source, demux);
+    require(!lease.authorized(), "unlink/relink cannot revive old lease");
+    auto fresh = captureOriginalSourceTopology(demux, pad(demux, "sink"), source);
+    require(fresh && fresh->revalidate(), "new proof can describe restored graph");
+}
+
+static void wrappers()
+{
+    Graph graph;
+    auto* source = graph.make("fakesrc");
+    auto* previous = source;
+    for (auto* name : { "queue2", "typefind", "downloadbuffer" }) {
+        auto* next = graph.make(name);
+        link(previous, next);
+        previous = next;
+    }
+    auto* demux = graph.make("qtdemux");
+    link(previous, demux);
+    auto proof = captureOriginalSourceTopology(demux, pad(demux, "sink"), source);
+    require(proof && proof->revalidate(), "only explicitly allowed wrapper chain accepted");
+}
+
+// Intentionally has no GstElementFactory: missing factory is NOT permission
+// to treat an arbitrary processing subclass as a plain structural GstBin.
+typedef struct _UnknownProcessingBin { GstBin parent; } UnknownProcessingBin;
+typedef struct _UnknownProcessingBinClass { GstBinClass parent; } UnknownProcessingBinClass;
+G_DEFINE_TYPE(UnknownProcessingBin, unknown_processing_bin, GST_TYPE_BIN)
+static void unknown_processing_bin_class_init(UnknownProcessingBinClass*) { }
+static void unknown_processing_bin_init(UnknownProcessingBin*) { }
+
+static void structuralBinTypes()
+{
+    Graph graph;
+    auto* unknown = GST_ELEMENT(g_object_new(unknown_processing_bin_get_type(), nullptr));
+    require(gst_bin_add(GST_BIN(graph.pipeline), unknown), "add unregistered derived processing bin");
+    require(!gst_element_get_factory(unknown), "test subclass is not registered as a factory");
+    auto* source = graph.make("fakesrc", unknown);
+    ghost(unknown, pad(source, "src"));
+    auto* demux = graph.make("qtdemux");
+    link(unknown, demux);
+    require(!captureOriginalSourceTopology(demux, pad(demux, "sink"), source), "unregistered GstBin subclass rejected");
+    // Exercise exact plain GstBin even when constructed through its factory.
+    auto* factory = gst_element_factory_find("bin");
+    if (factory) {
+        gst_object_unref(factory);
+        Graph plainGraph;
+        auto* plain = plainGraph.make("bin");
+        require(G_OBJECT_TYPE(plain) == GST_TYPE_BIN, "bin factory produces exact plain GstBin");
+        auto* exactSource = plainGraph.make("fakesrc", plain);
+        ghost(plain, pad(exactSource, "src"));
+        auto* exactDemux = plainGraph.make("qtdemux");
+        link(plain, exactDemux);
+        auto proof = captureOriginalSourceTopology(exactDemux, pad(exactDemux, "sink"), exactSource);
+        require(proof && proof->revalidate(), "factory-created exact plain GstBin accepted");
+    }
+}
+
+static void normalDownstreamAutoplug()
+{
+    Graph graph;
+    auto* source = graph.make("fakesrc");
+    auto* demux = graph.make("qtdemux");
+    link(source, demux);
+    auto proof = captureOriginalSourceTopology(demux, pad(demux, "sink"), source);
+    require(proof.has_value(), "capture upstream before dynamic outputs exist");
+    Lease lease(std::move(*proof));
+    for (auto* name : { "video_0", "audio_0" }) {
+        require(gst_element_add_pad(demux, gst_pad_new(name, GST_PAD_SRC)), "add ordinary dynamic demux output");
+        auto* downstream = graph.make("fakesink");
+        require(gst_pad_link(pad(demux, name), pad(downstream, "sink")) == GST_PAD_LINK_OK, "autoplug downstream sink");
+        require(lease.authorized(), "dynamic output and unrelated downstream addition preserve upstream proof");
+        require(gst_element_remove_pad(demux, pad(demux, name)), "remove ordinary downstream output");
+        require(gst_bin_remove(GST_BIN(graph.pipeline), downstream), "remove unrelated downstream child");
+        require(lease.authorized(), "ordinary output/child removal preserves upstream proof");
+    }
+    graph.make("identity"); // An unrelated graph addition also stays irrelevant.
+    require(lease.authorized(), "unrelated downstream processing element addition preserves upstream proof");
+    require(gst_element_add_pad(demux, gst_pad_new("alternate-sink", GST_PAD_SINK)), "add alternate demux sink");
+    require(!lease.authorized(), "alternate input sink irrevocably invalidates proof");
+    require(gst_element_remove_pad(demux, pad(demux, "alternate-sink")), "remove alternate demux sink");
+    require(!lease.authorized(), "sink inventory ABA cannot revive old lease");
+}
+
+static void byteInputEndpoints()
+{
+    for (auto* name : { "queue2", "typefind", "downloadbuffer" }) {
+        Graph graph;
+        auto* source = graph.make("fakesrc");
+        auto* consumer = graph.make(name);
+        link(source, consumer);
+        auto proof = captureOriginalByteInputTopology(consumer, pad(consumer, "sink"), source);
+        require(proof && proof->revalidate(), "explicit byte holder input accepts exact direct source");
+        require(!captureOriginalSourceTopology(consumer, pad(consumer, "sink"), source), "demux output API still requires actual qtdemux");
+    }
+    Graph graph;
+    auto* source = graph.make("fakesrc");
+    auto* unknown = graph.make("identity");
+    link(source, unknown);
+    require(!captureOriginalByteInputTopology(unknown, pad(unknown, "sink"), source), "byte-input API rejects unknown terminal factory");
+}
+
+static void concurrentRetargetLifetime()
+{
+    Graph graph;
+    auto* owner = graph.bin();
+    auto* source = graph.make("fakesrc", owner);
+    auto* outer = ghost(owner, pad(source, "src"));
+    auto* demux = graph.make("qtdemux");
+    link(owner, demux);
+    std::atomic<bool> start { false };
+    std::thread mutator([&] {
+        while (!start.load()) std::this_thread::yield();
+        for (unsigned i = 0; i < 1500; ++i) {
+            auto* transient = graph.make("fakesrc", owner);
+            auto* target = gst_element_get_static_pad(transient, "src");
+            require(target, "transient target exists");
+            require(gst_ghost_pad_set_target(GST_GHOST_PAD(outer), target), "race replaces ghost target");
+            require(gst_ghost_pad_set_target(GST_GHOST_PAD(outer), nullptr), "race removes ghost target");
+            gst_object_unref(target);
+            require(gst_bin_remove(GST_BIN(owner), transient), "race removes transient target owner");
+            require(gst_ghost_pad_set_target(GST_GHOST_PAD(outer), pad(source, "src")), "race restores original target");
+        }
+    });
+    start.store(true);
+    for (unsigned i = 0; i < 3000; ++i) {
+        auto proof = captureOriginalSourceTopology(demux, pad(demux, "sink"), source);
+        // Concurrent mutation may legitimately make capture/revalidate fail.
+        // Every pointer in any returned witness must nevertheless remain alive.
+        if (proof) {
+            for (auto* retained : proof->observedPads())
+                require(GST_IS_PAD(retained), "concurrent retarget witness retains every pad");
+            proof->revalidate();
+        }
+    }
+    mutator.join();
+    auto settled = captureOriginalSourceTopology(demux, pad(demux, "sink"), source);
+    require(settled && settled->revalidate(), "settled original topology valid after retarget/remove stress");
+}
+
+static void rejectedProcessing()
+{
+    for (auto* name : { "identity", "qtdemux" }) {
+        Graph graph;
+        auto* source = graph.make("fakesrc");
+        auto* wrapper = graph.make(name);
+        if (std::string(name) == "qtdemux")
+            require(gst_element_add_pad(wrapper, gst_pad_new("test-src", GST_PAD_SRC)), "synthetic nested demux output");
+        else
+            gst_object_set_name(GST_OBJECT(wrapper), "decrypt-like-wrapper");
+        auto* demux = graph.make("qtdemux");
+        link(source, wrapper);
+        require(gst_pad_link(pad(wrapper, std::string(name) == "qtdemux" ? "test-src" : "src"), pad(demux, "sink")) == GST_PAD_LINK_OK, "link unknown processing output");
+        require(!captureOriginalSourceTopology(demux, pad(demux, "sink"), source), "unknown/decrypt/nested demux rejected without protection event");
+    }
+    Graph graph;
+    auto* wrapper = graph.make("parsebin");
+    auto* source = graph.make("fakesrc", wrapper);
+    ghost(wrapper, pad(source, "src"));
+    auto* demux = graph.make("qtdemux");
+    link(wrapper, demux);
+    require(!captureOriginalSourceTopology(demux, pad(demux, "sink"), source), "plugin processing bin rejected despite direct ghost target");
+}
+
+static void ghostsAndMutation()
+{
+    Graph graph;
+    auto* sourceOuter = graph.bin();
+    auto* sourceInner = graph.make("decodebin", sourceOuter);
+    auto* source = graph.make("fakesrc", sourceInner);
+    auto* alternative = graph.make("fakesrc", sourceInner);
+    auto* innerGhost = ghost(sourceInner, pad(source, "src"));
+    ghost(sourceOuter, innerGhost);
+    auto* sinkOuter = graph.bin();
+    auto* sinkInner = graph.bin(sinkOuter);
+    auto* demux = graph.make("qtdemux", sinkInner);
+    ghost(sinkOuter, ghost(sinkInner, pad(demux, "sink")));
+    link(sourceOuter, sinkOuter);
+    auto proof = captureOriginalSourceTopology(demux, pad(demux, "sink"), source);
+    require(proof && proof->revalidate(), "nested source/sink ghosts and stock decodebin owner accepted");
+    require(proof->observedPads().size() >= 10, "ghost internals included in subscription surface");
+    Lease lease(std::move(*proof));
+    auto snapshot = captureOriginalSourceTopology(demux, pad(demux, "sink"), source);
+    require(gst_ghost_pad_set_target(GST_GHOST_PAD(innerGhost), pad(alternative, "src")), "replace ghost target");
+    require(!snapshot->revalidate() && !lease.authorized(), "target change rejects snapshot and revokes lease");
+    require(gst_ghost_pad_set_target(GST_GHOST_PAD(innerGhost), pad(source, "src")), "restore ghost target");
+    require(snapshot->revalidate(), "snapshot documents ABA limitation explicitly");
+    require(!lease.authorized(), "target ABA never revives old lease");
+    auto current = captureOriginalSourceTopology(demux, pad(demux, "sink"), source);
+    Lease removalLease(std::move(*current));
+    auto* oldGhost = pad(sourceOuter, "src");
+    require(gst_element_remove_pad(sourceOuter, oldGhost), "remove outer source pad");
+    require(gst_ghost_pad_set_target(GST_GHOST_PAD(oldGhost), nullptr), "detach removed pad's target");
+    ghost(sourceOuter, innerGhost);
+    link(sourceOuter, sinkOuter);
+    require(!snapshot->revalidate() && !removalLease.authorized(), "removed/replaced ghost pad rejected");
+}
+
+static void boundsAndAmbiguity()
+{
+    {
+        Graph graph;
+        auto* source = graph.make("fakesrc");
+        auto* previous = source;
+        for (unsigned i = 0; i < 34; ++i) {
+            auto* queue = graph.make("queue2");
+            link(previous, queue);
+            previous = queue;
+        }
+        auto* demux = graph.make("qtdemux");
+        link(previous, demux);
+        require(!captureOriginalSourceTopology(demux, pad(demux, "sink"), source), "hop bound rejects overlong topology");
+    }
+    {
+        Graph graph;
+        auto* source = graph.make("fakesrc");
+        auto* demux = graph.make("qtdemux");
+        link(source, demux);
+        require(gst_element_add_pad(source, gst_pad_new("ambiguous-src", GST_PAD_SRC)), "add ambiguous source output");
+        require(!captureOriginalSourceTopology(demux, pad(demux, "sink"), source), "ambiguous original source outputs rejected");
+    }
+    {
+        Graph graph;
+        auto* source = graph.make("fakesrc");
+        auto* first = graph.make("queue2");
+        auto* second = graph.make("queue2");
+        auto* demux = graph.make("qtdemux");
+        link(first, second);
+        link(second, first);
+        // A reachable cycle with an exit necessarily branches: the ambiguity
+        // check rejects it before following the cyclic processing path.
+        require(gst_element_add_pad(first, gst_pad_new("branch-src", GST_PAD_SRC)), "add cycle exit");
+        require(gst_pad_link(pad(first, "branch-src"), pad(demux, "sink")) == GST_PAD_LINK_OK, "link reachable cyclic component");
+        require(!captureOriginalSourceTopology(demux, pad(demux, "sink"), source), "reachable ambiguous cycle rejected");
+    }
+}
+
+int main(int argc, char** argv)
+{
+    gst_init(&argc, &argv);
+    directAndIdentity();
+    wrappers();
+    structuralBinTypes();
+    normalDownstreamAutoplug();
+    byteInputEndpoints();
+    concurrentRetargetLifetime();
+    rejectedProcessing();
+    ghostsAndMutation();
+    boundsAndAmbiguity();
+    std::puts("PASS: exact original source topology, wrappers, ghost internals, mutation leases, rejection and bounds");
+}
