+
+namespace WebCore {
+// Created only after a confirmed whole-playbin READY drain. Source bytes cannot
+// certify earlier contents of a queue: every byte holder is armed before input,
+// and every proof belongs to a live demux output pad, not a reusable string.
+class GStreamerDoviSourcePolicy final : public ThreadSafeRefCounted<GStreamerDoviSourcePolicy> {
+    struct Connection {
+        GWeakRef object;
+        gulong id;
+        bool probe;
+        Connection(GObject* o, gulong value, bool p = false) : id(value), probe(p) { g_weak_ref_init(&object, o); }
+        ~Connection()
+        {
+            auto objectRef = adoptGRef(G_OBJECT(g_weak_ref_get(&object)));
+            if (objectRef) {
+                if (probe) gst_pad_remove_probe(GST_PAD(objectRef.get()), id);
+                else if (g_signal_handler_is_connected(objectRef.get(), id)) g_signal_handler_disconnect(objectRef.get(), id);
+            }
+            g_weak_ref_clear(&object);
+        }
+    };
+    struct Input {
+        GWeakRef element, sink;
+        bool demux;
+        std::atomic<bool> required { false };
+        OriginalInputHistory history;
+        std::shared_ptr<OriginalSourceTopology> topology;
+        std::vector<std::unique_ptr<Connection>> watches;
+        Input(GstElement* e, GstPad* p, bool d, bool early) : demux(d), history(early)
+        { g_weak_ref_init(&element, e); g_weak_ref_init(&sink, p); }
+        ~Input() { g_weak_ref_clear(&element); g_weak_ref_clear(&sink); }
+        void disconnect() { watches.clear(); topology.reset(); }
+    };
+    struct Proof {
+        GWeakRef pad;
+        GstCaps* caps;
+        std::shared_ptr<Input> input;
+        Proof(GstPad* p, GstCaps* c, std::shared_ptr<Input> h) : caps(gst_caps_ref(c)), input(WTF::move(h)) { g_weak_ref_init(&pad, p); }
+        ~Proof() { gst_caps_unref(caps); g_weak_ref_clear(&pad); }
+    };
+    struct Watch {
+        Ref<GStreamerDoviSourcePolicy> policy;
+        std::shared_ptr<Input> input;
+        std::shared_ptr<OriginalSourceTopology> topology;
+    };
+public:
+    static Ref<GStreamerDoviSourcePolicy> create(GstElement* filter, PageIdentifier page)
+    {
+        auto policy = adoptRef(*new GStreamerDoviSourcePolicy(filter, page));
+        policy->observeSelections(filter); policy->advance(); return policy;
+    }
+    ~GStreamerDoviSourcePolicy() { g_weak_ref_clear(&m_filter); g_weak_ref_clear(&m_source); }
+    void revoke()
+    {
+        std::lock_guard lock(m_mutex);
+        if (m_revision) announce(m_revision);
+        if (m_revoked) return;
+        m_revoked = true;
+        GST_DEBUG("Dolby source policy: revoked at revision %" G_GUINT64_FORMAT, m_revision);
+        sendContext(m_revision, true);
+        m_proofs.clear();
+        for (auto& [element, input] : m_inputs) { (void)element; input->history.invalidate(); input->disconnect(); }
+        m_connections.clear(); m_inputs.clear();
+    }
+    void advance()
+    {
+        std::lock_guard lock(m_mutex);
+        if (m_revoked || m_untrusted.load(std::memory_order_acquire)) return;
+        if (m_revision) announce(m_revision);
+        static std::atomic<uint64_t> next { 1 };
+        m_revision = next.fetch_add(1, std::memory_order_relaxed);
+        m_atomicRevision.store(m_revision, std::memory_order_release);
+        if (!m_revision) { m_revoked = true; return; }
+        GST_DEBUG("Dolby source policy: advanced to revision %" G_GUINT64_FORMAT " with %zu proof(s)", m_revision, m_proofs.size());
+        sendContext(m_revision, false);
+        for (auto it = m_proofs.begin(); it != m_proofs.end();) {
+            if (!proofIsLive(*it->second)) it = m_proofs.erase(it);
+            else { sendContext(m_revision, false, it->first.c_str(), it->second->caps); ++it; }
+        }
+    }
+    // Only sourceSetup's verified WebKitWebSrc instance may be passed here.
+    void bindOriginalSource(GstElement* source)
+    {
+        auto src = adoptGRef(gst_element_get_static_pad(source, "src"));
+        if (!src) { markUntrusted("original source has no src pad"); return; }
+        OriginalInputSetup setup(source, src.get());
+        std::lock_guard lock(m_mutex);
+        if (m_revoked || m_untrusted.load(std::memory_order_acquire)) return;
+        auto previous = adoptGRef(GST_ELEMENT(g_weak_ref_get(&m_source)));
+        if (previous.get() == source) return;
+        if (previous || m_sourceStarted.load(std::memory_order_acquire)) { markUntrusted("a second or late original source"); return; }
+        g_weak_ref_set(&m_source, source);
+        if (!setup.beforeBytes()) { markUntrusted("original source bound after bytes"); return; }
+        ref();
+        auto id = gst_pad_add_probe(src.get(), static_cast<GstPadProbeType>(GST_PAD_PROBE_TYPE_BUFFER | GST_PAD_PROBE_TYPE_BUFFER_LIST),
+            +[](GstPad*, GstPadProbeInfo*, gpointer data) -> GstPadProbeReturn {
+                static_cast<GStreamerDoviSourcePolicy*>(data)->beforeOriginalBytes(); return GST_PAD_PROBE_OK;
+            }, this, +[](gpointer data) { static_cast<GStreamerDoviSourcePolicy*>(data)->deref(); });
+        m_connections.push_back(std::make_unique<Connection>(G_OBJECT(src.get()), id, true));
+    }
+    void observeElement(GstElement* element)
+    {
+        bool demux = factoryIs(element, "qtdemux");
+        if (!demux && !isHolder(element)) return;
+        auto sink = adoptGRef(gst_element_get_static_pad(element, "sink"));
+        if (!sink) { markUntrusted("byte holder or demux has no sink pad"); return; }
+        std::shared_ptr<Input> input;
+        OriginalInputSetup setup(element, sink.get());
+        {
+            std::lock_guard lock(m_mutex);
+            if (m_revoked || m_inputs.contains(element)) return;
+            // Decoding bins autoplug byte holders only after typefinding has
+            // consumed original bytes, so "before bytes" is judged per input:
+            // an input whose own sink has carried nothing can still be armed
+            // before its first buffer, behind an already attested route.
+            bool early = setup.beforeBytes();
+            GST_DEBUG("Dolby source policy: observing %s %s (before bytes=%d, source started=%d, early=%d)", demux ? "demux" : "byte holder",
+                GST_ELEMENT_NAME(element), setup.beforeBytes(), m_sourceStarted.load(std::memory_order_acquire), early);
+            input = std::make_shared<Input>(element, sink.get(), demux, early);
+            auto* hook = new Watch { Ref { *this }, input, nullptr };
+            auto probe = gst_pad_add_probe(sink.get(), static_cast<GstPadProbeType>(GST_PAD_PROBE_TYPE_BUFFER | GST_PAD_PROBE_TYPE_BUFFER_LIST | GST_PAD_PROBE_TYPE_EVENT_DOWNSTREAM),
+                +[](GstPad*, GstPadProbeInfo* info, gpointer data) -> GstPadProbeReturn {
+                    auto& hook = *static_cast<Watch*>(data);
+                    if (GST_PAD_PROBE_INFO_TYPE(info) & (GST_PAD_PROBE_TYPE_BUFFER | GST_PAD_PROBE_TYPE_BUFFER_LIST)) {
+                        if (!hook.input->history.isArmed() && !hook.input->history.hasSeenBytes()) hook.policy->armBeforeFirstBytes(hook.input);
+                        if (!hook.input->history.observeBytes() && hook.input->required.load(std::memory_order_acquire)) hook.policy->markUntrusted("bytes reached a required input before it was armed");
+                    } else if (GST_EVENT_TYPE(GST_PAD_PROBE_INFO_EVENT(info)) == GST_EVENT_PROTECTION) hook.policy->markUntrusted("protection event on a source input");
+                    return GST_PAD_PROBE_OK;
+                }, hook, +[](gpointer data) { delete static_cast<Watch*>(data); });
+            input->watches.push_back(std::make_unique<Connection>(G_OBJECT(sink.get()), probe, true));
+            connectInputSignal(input, sink.get(), "linked", false);
+            connectInputSignal(input, sink.get(), "unlinked", true);
+            m_inputs.emplace(element, input);
+        }
+        if (demux) {
+            for (bool added : { false, true }) {
+                ref();
+                auto id = g_signal_connect_data(element, added ? "pad-added" : "pad-removed",
+                    added ? G_CALLBACK(+[](GstElement*, GstPad* pad, gpointer data) { static_cast<GStreamerDoviSourcePolicy*>(data)->observeOutput(pad); })
+                          : G_CALLBACK(+[](GstElement*, GstPad* pad, gpointer data) { static_cast<GStreamerDoviSourcePolicy*>(data)->removePadProof(pad); }),
+                    this, +[](gpointer data, GClosure*) { static_cast<GStreamerDoviSourcePolicy*>(data)->deref(); }, GConnectFlags(0));
+                remember(std::make_unique<Connection>(G_OBJECT(element), id));
+            }
+            // A first link after this early subscription must already have a
+            // complete, attested upstream route; a late snapshot is insufficient.
+            if (gst_pad_is_linked(sink.get())) armDemux(input);
+            GUniquePtr<GstIterator> iterator(gst_element_iterate_src_pads(element));
+            while (gst_iterator_foreach(iterator.get(), +[](const GValue* item, gpointer data) {
+                static_cast<GStreamerDoviSourcePolicy*>(data)->observeOutput(GST_PAD(g_value_get_object(item)));
+            }, this) == GST_ITERATOR_RESYNC) gst_iterator_resync(iterator.get());
+        }
+    }
+private:
+    GStreamerDoviSourcePolicy(GstElement* filter, PageIdentifier page) : m_page(page)
+    { g_weak_ref_init(&m_filter, filter); g_weak_ref_init(&m_source, nullptr); }
+    static bool factoryIs(GstElement* element, const char* name)
+    {
+        auto* expected = gst_element_factory_find(name);
+        bool matches = expected && gst_element_get_factory(element) == expected;
+        if (expected) gst_object_unref(expected);
+        return matches;
+    }
+    static bool isHolder(GstElement* element)
+    { return factoryIs(element, "typefind") || factoryIs(element, "queue2") || factoryIs(element, "downloadbuffer"); }
+    void markUntrusted(const char* reason)
+    {
+        if (m_untrusted.exchange(true, std::memory_order_acq_rel)) return;
+        GST_INFO("Dolby source policy: ordinary route for this load (%s)", reason);
+        // No policy mutex: topology signals can be nested inside sendContext.
+        // Core blocking is immediate; owning-page cleanup is queued safely.
+        sendContext(m_atomicRevision.load(std::memory_order_acquire), true);
+        callOnMainThread([self = Ref { *this }] { self->revoke(); });
+    }
+    void beforeOriginalBytes()
+    {
+        if (m_sourceStarted.exchange(true, std::memory_order_acq_rel)) return;
+        std::lock_guard lock(m_mutex);
+        if (m_revoked || m_untrusted.load(std::memory_order_acquire)) return;
+        for (size_t pass = 0; pass <= m_inputs.size(); ++pass) {
+            bool progress = false;
+            for (auto& [element, input] : m_inputs) { (void)element;
+                if (!input->history.isArmed()) progress |= tryArm(input);
+            }
+            if (!progress) break;
+        }
+    }
+    void armDemux(const std::shared_ptr<Input>& input)
+    {
+        std::lock_guard lock(m_mutex);
+        if (m_revoked || m_untrusted.load(std::memory_order_acquire)) return;
+        // Content-type hints may link the container before the first source
+        // buffer. Seal any complete upstream holders in topological order first.
+        for (size_t pass = 0; pass <= m_inputs.size(); ++pass) {
+            bool progress = false;
+            for (auto& [element, upstream] : m_inputs) { (void)element;
+                if (!upstream->demux && !upstream->history.isArmed()) progress |= tryArm(upstream);
+            }
+            if (!progress) break;
+        }
+        if (!input->history.isArmed() && !tryArm(input)) {
+            GST_DEBUG("Dolby source policy: demux input could not be armed (required=%d)", input->required.load(std::memory_order_acquire));
+            input->history.invalidate();
+            if (input->required.load(std::memory_order_acquire)) markUntrusted("required input could not be armed");
+        }
+    }
+    // Runs in the input's streaming thread with its first buffer in hand and
+    // not yet delivered: the last moment its byte history is still empty.
+    void armBeforeFirstBytes(const std::shared_ptr<Input>& input)
+    {
+        std::lock_guard lock(m_mutex);
+        if (m_revoked || m_untrusted.load(std::memory_order_acquire) || input->history.isArmed() || input->history.hasSeenBytes()) return;
+        tryArm(input);
+    }
+    bool tryArm(const std::shared_ptr<Input>& input)
+    {
+        if (input->history.isArmed()) return true;
+        if (m_untrusted.load(std::memory_order_acquire)) return false;
+        auto source = adoptGRef(GST_ELEMENT(g_weak_ref_get(&m_source)));
+        auto element = adoptGRef(GST_ELEMENT(g_weak_ref_get(&input->element)));
+        auto sink = adoptGRef(GST_PAD(g_weak_ref_get(&input->sink)));
+        if (!source || !element || !sink) { GST_DEBUG("Dolby source policy: cannot arm, source/input released"); return false; }
+        auto capture = captureOriginalByteInputTopology(element.get(), sink.get(), source.get());
+        if (!capture) { GST_DEBUG("Dolby source policy: cannot arm %s, route to the original source is not attestable", GST_ELEMENT_NAME(element.get())); return false; }
+        auto topology = std::make_shared<OriginalSourceTopology>(WTF::move(*capture));
+        for (auto* upstream : topology->observedElements()) {
+            if (upstream == element.get() || !isHolder(upstream)) continue;
+            auto entry = m_inputs.find(upstream);
+            if (entry == m_inputs.end() || !entry->second->history.isArmed()) {
+                GST_DEBUG("Dolby source policy: cannot arm %s, upstream byte holder %s is %s", GST_ELEMENT_NAME(element.get()), GST_ELEMENT_NAME(upstream),
+                    entry == m_inputs.end() ? "unobserved" : "not armed");
+                return false;
+            }
+        }
+        bool armed = input->history.arm([&] {
+            input->required.store(true, std::memory_order_release);
+            installTopologyWatches(input, topology);
+            if (!topology->revalidate() || m_untrusted.load(std::memory_order_acquire)) return false;
+            input->topology = topology; return true;
+        });
+        GST_DEBUG("Dolby source policy: arming %s %s", GST_ELEMENT_NAME(element.get()), armed ? "succeeded" : "failed");
+        return armed;
+    }
+    void connectInputSignal(const std::shared_ptr<Input>& input, GstPad* pad, const char* signal, bool unlink)
+    {
+        auto* hook = new Watch { Ref { *this }, input, nullptr };
+        auto id = g_signal_connect_data(pad, signal, unlink ? G_CALLBACK(+[](GstPad*, GstPad*, gpointer data) {
+            auto& hook = *static_cast<Watch*>(data);
+            hook.input->history.invalidate();
+            if (hook.input->required.load(std::memory_order_acquire)) hook.policy->markUntrusted("required input pad signal");
+        }) : G_CALLBACK(+[](GstPad*, GstPad*, gpointer data) {
+            auto& hook = *static_cast<Watch*>(data); if (hook.input->demux) hook.policy->armDemux(hook.input);
+        }), hook, +[](gpointer data, GClosure*) { delete static_cast<Watch*>(data); }, GConnectFlags(0));
+        input->watches.push_back(std::make_unique<Connection>(G_OBJECT(pad), id));
+    }
+    void installTopologyWatches(const std::shared_ptr<Input>& input, const std::shared_ptr<OriginalSourceTopology>& topology)
+    {
+        for (auto* pad : topology->observedPads()) for (auto* signal : { "linked", "unlinked" }) {
+            auto* hook = new Watch { Ref { *this }, input, topology };
+            auto id = g_signal_connect_data(pad, signal, G_CALLBACK(+[](GstPad*, GstPad*, gpointer data) {
+                auto& hook = *static_cast<Watch*>(data); hook.input->history.invalidate(); hook.policy->markUntrusted("source topology watch fired");
+            }), hook, +[](gpointer data, GClosure*) { delete static_cast<Watch*>(data); }, GConnectFlags(0));
+            input->watches.push_back(std::make_unique<Connection>(G_OBJECT(pad), id));
+        }
+        for (auto* element : topology->observedElements()) {
+            for (auto* signal : { "pad-added", "pad-removed" }) {
+                auto* hook = new Watch { Ref { *this }, input, topology };
+                auto id = g_signal_connect_data(element, signal, G_CALLBACK(+[](GstElement* owner, GstPad* changed, gpointer data) {
+                    auto& hook = *static_cast<Watch*>(data);
+                    if (hook.topology->observesPadMutation(owner, changed)) { hook.input->history.invalidate(); hook.policy->markUntrusted("source topology pad mutation"); }
+                }), hook, +[](gpointer data, GClosure*) { delete static_cast<Watch*>(data); }, GConnectFlags(0));
+                input->watches.push_back(std::make_unique<Connection>(G_OBJECT(element), id));
+            }
+            if (GST_IS_BIN(element)) for (auto* signal : { "element-added", "element-removed" }) {
+                auto* hook = new Watch { Ref { *this }, input, topology };
+                auto id = g_signal_connect_data(element, signal, G_CALLBACK(+[](GstBin* owner, GstElement* changed, gpointer data) {
+                    auto& hook = *static_cast<Watch*>(data);
+                    if (hook.topology->observesElementMutation(GST_ELEMENT(owner), changed)) { hook.input->history.invalidate(); hook.policy->markUntrusted("source topology element mutation"); }
+                }), hook, +[](gpointer data, GClosure*) { delete static_cast<Watch*>(data); }, GConnectFlags(0));
+                input->watches.push_back(std::make_unique<Connection>(G_OBJECT(element), id));
+            }
+        }
+    }
+    bool proofIsLive(const Proof& proof)
+    {
+        if (!proof.input->history.isArmed() || !proof.input->history.hasSeenBytes() || !proof.input->topology || !proof.input->topology->revalidate()) {
+            GST_DEBUG("Dolby source policy: proof not live (armed=%d, seen bytes=%d, topology=%d)", proof.input->history.isArmed(),
+                proof.input->history.hasSeenBytes(), !!proof.input->topology);
+            return false;
+        }
+        auto pad = adoptGRef(GST_PAD(g_weak_ref_get(const_cast<GWeakRef*>(&proof.pad))));
+        auto demux = adoptGRef(GST_ELEMENT(g_weak_ref_get(&proof.input->element)));
+        return pad && demux && GST_PAD_DIRECTION(pad.get()) == GST_PAD_SRC && gst_pad_is_linked(pad.get())
+            && gst_object_has_as_parent(GST_OBJECT(pad.get()), GST_OBJECT(demux.get()));
+    }
+    void record(GstPad* pad, GstCaps* caps)
+    {
+        if (!caps || !gst_caps_is_fixed(caps) || gst_caps_get_size(caps) != 1) return;
+        auto* structure = gst_caps_get_structure(caps, 0);
+        if (gst_structure_has_name(structure, "application/x-cenc") || gst_structure_has_field(structure, "protection-system")) { markUntrusted("encrypted coded caps"); return; }
+        auto demux = adoptGRef(gst_pad_get_parent_element(pad));
+        char* id = gst_pad_get_stream_id(pad);
+        if (!demux || !id) { g_free(id); return; }
+        bool changed = false;
+        {
+            std::lock_guard lock(m_mutex);
+            auto history = m_inputs.find(demux.get());
+            if (!m_revoked && !m_untrusted.load(std::memory_order_acquire) && history != m_inputs.end() && history->second->demux) {
+                auto proof = std::make_unique<Proof>(pad, caps, history->second);
+                bool clear = gst_structure_has_name(structure, "video/x-h265") && gst_structure_has_field(structure, "dovi-configuration") && proofIsLive(*proof);
+                GST_DEBUG("Dolby source policy: demux caps on stream %s: %s", id, clear ? "clear proof" : "no clear proof");
+                auto previous = m_proofs.find(id);
+                auto oldPad = previous != m_proofs.end() ? adoptGRef(GST_PAD(g_weak_ref_get(&previous->second->pad))) : GRefPtr<GstPad> { };
+                if (previous != m_proofs.end() && oldPad && oldPad.get() != pad && proofIsLive(*previous->second)) { markUntrusted("stream id moved to another live demux pad"); }
+                else if (clear) {
+                    changed = previous == m_proofs.end() || oldPad.get() != pad || !gst_caps_is_equal(previous->second->caps, caps);
+                    m_proofs.insert_or_assign(id, WTF::move(proof));
+                    if (!changed) sendContext(m_revision, false, id, caps);
+                } else if (previous != m_proofs.end() && oldPad.get() == pad) { m_proofs.erase(previous); changed = true; }
+            }
+        }
+        if (changed) advance();
+        g_free(id);
+    }
+    void removePadProof(GstPad* pad)
+    {
+        bool changed = false;
+        {
+            std::lock_guard lock(m_mutex);
+            for (auto it = m_proofs.begin(); it != m_proofs.end();) {
+                auto old = adoptGRef(GST_PAD(g_weak_ref_get(&it->second->pad)));
+                if (old.get() == pad) {
+                    sendContext(m_revision, false, it->first.c_str(), nullptr);
+                    it = m_proofs.erase(it); changed = true;
+                } else ++it;
+            }
+        }
+        if (changed) advance();
+    }
+    void remember(std::unique_ptr<Connection> connection)
