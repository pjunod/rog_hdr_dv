+bool ImageBackingStore::canUseColorProfile(const SharedBuffer& profile)
+{
+    skcms_ICCProfile parsed;
+    auto bytes = profile.span();
+    bool parsedBySkia = skcms_Parse(bytes.data(), bytes.size(), &parsed);
+#if USE(LCMS)
+    auto source = LCMSProfilePtr(cmsOpenProfileFromMem(bytes.data(), bytes.size()));
+    if (!source || cmsGetColorSpace(source.get()) != cmsSigRgbData)
+        return false;
+    if (parsedBySkia && SkColorSpace::Make(parsed))
+        return true;
+    auto xyz = LCMSProfilePtr(cmsCreateXYZProfile());
+    return !!LCMSTransformPtr(cmsCreateTransform(source.get(), TYPE_RGB_FLT, xyz.get(), TYPE_XYZ_FLT,
+        INTENT_RELATIVE_COLORIMETRIC, cmsFLAGS_NOOPTIMIZE));
+#else
+    return parsedBySkia && !!SkColorSpace::Make(parsed);
+#endif
+}
+
+bool ImageBackingStore::setColorProfile(RefPtr<SharedBuffer> profile)
+{
+    if (!profile || !canUseColorProfile(*profile))
+        return false;
+    skcms_ICCProfile parsed;
+    auto bytes = profile->span();
+    m_colorSpace = skcms_Parse(bytes.data(), bytes.size(), &parsed) ? SkColorSpace::Make(parsed) : nullptr;
+    m_colorProfile = WTF::move(profile);
+    return true;
+}
