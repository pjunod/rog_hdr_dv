+static std::optional<SkImageInfo> pixelBufferImageInfo(const PixelBufferFormat& format, const IntSize& size)
+{
+    SkColorType colorType;
+    switch (format.pixelFormat) {
+    case PixelFormat::RGBA8:
+        colorType = kRGBA_8888_SkColorType;
+        break;
+    case PixelFormat::BGRA8:
+        colorType = kBGRA_8888_SkColorType;
+        break;
+    default:
+        return std::nullopt;
+    }
+    return SkImageInfo::Make(size.width(), size.height(), colorType,
+        format.alphaFormat == AlphaPremultiplication::Premultiplied ? kPremul_SkAlphaType : kUnpremul_SkAlphaType,
+        format.colorSpace.platformColorSpace());
+}
+
+void ImageBufferSkiaSurfaceBackend::readPixelBuffer(const IntRect& sourceRect, PixelBuffer& destination)
+{
+    // This is the intentional logical API conversion, never a raw F16 byte copy.
+    destination.zeroFill();
+    auto info = pixelBufferImageInfo(destination.format(), destination.size());
+    if (!info)
+        return;
+    const auto clippedSource = intersection(IntRect { { }, size() }, sourceRect);
+    if (clippedSource.isEmpty())
+        return;
+    IntRect destinationRect { IntPoint { clippedSource.x() - sourceRect.x(), clippedSource.y() - sourceRect.y() }, clippedSource.size() };
+    SkPixmap pixels(*info, destination.bytes().data(), info->minRowBytes64());
+    SkPixmap subset;
+    if (pixels.extractSubset(&subset, destinationRect))
+        m_surface->readPixels(subset, clippedSource.x(), clippedSource.y());
+}
+
+void ImageBufferSkiaSurfaceBackend::writePixelBuffer(const PixelBufferSourceView& source, const IntRect& sourceRect, const IntPoint& destinationOffset)
+{
+    auto info = pixelBufferImageInfo(source.format(), source.size());
+    if (!info)
+        return;
+    auto clippedSource = intersection(IntRect { { }, source.size() }, sourceRect);
+    if (clippedSource.isEmpty())
+        return;
+    IntRect destinationRect = clippedSource;
+    destinationRect.moveBy(destinationOffset);
+    destinationRect.move(-std::min(0, sourceRect.x()), -std::min(0, sourceRect.y()));
+    auto clippedDestination = intersection(IntRect { { }, size() }, destinationRect);
+    if (clippedDestination.isEmpty())
+        return;
+    clippedSource.move(clippedDestination.x() - destinationRect.x(), clippedDestination.y() - destinationRect.y());
+    clippedSource.setSize(clippedDestination.size());
+    SkPixmap pixels(*info, source.bytes().data(), info->minRowBytes64());
+    SkPixmap subset;
+    if (pixels.extractSubset(&subset, clippedSource))
+        m_surface->writePixels(subset, clippedDestination.x(), clippedDestination.y());
+}
+
+void ImageBufferSkiaSurfaceBackend::convertToLuminanceMask()
+{
+    flushContext();
+    auto info = m_surface->imageInfo().makeColorType(kRGBA_F32_SkColorType).makeAlphaType(kUnpremul_SkAlphaType);
+    SkBitmap pixels;
+    if (!pixels.tryAllocPixels(info) || !m_surface->readPixels(info, pixels.getPixels(), pixels.rowBytes(), 0, 0))
+        return;
+    for (int y = 0; y < size().height(); ++y) {
+        auto row = unsafeMakeSpan(static_cast<float*>(pixels.getAddr(0, y)), size().width() * 4);
+        for (int x = 0; x < size().width(); ++x) {
+            unsigned offset = x * 4;
+            row[offset + 3] = std::clamp((row[offset] * 0.2125f + row[offset + 1] * 0.7154f + row[offset + 2] * 0.0721f) * row[offset + 3], 0.f, 1.f);
+        }
+    }
+    m_surface->writePixels(pixels.pixmap(), 0, 0);
+}
+
 bool ImageBufferSkiaSurfaceBackend::canMapBackingStore() const
 {
     return true;
