+TEST(SkiaDecodedImageColour, JPEGUsesSharedICCProfileAndIgnoredProfileStaysSRGB)
+{
+    auto profile = linearP3Profile();
+    jpeg_compress_struct encoder;
+    jpeg_error_mgr error;
+    encoder.err = jpeg_std_error(&error);
+    jpeg_create_compress(&encoder);
+    unsigned char* memory = nullptr;
+    unsigned long length = 0;
+    jpeg_mem_dest(&encoder, &memory, &length);
+    encoder.image_width = 2;
+    encoder.image_height = 1;
+    encoder.input_components = 3;
+    encoder.in_color_space = JCS_RGB;
+    jpeg_set_defaults(&encoder);
+    jpeg_set_quality(&encoder, 100, true);
+    jpeg_start_compress(&encoder, true);
+    std::vector<uint8_t> marker { 'I', 'C', 'C', '_', 'P', 'R', 'O', 'F', 'I', 'L', 'E', 0, 1, 1 };
+    marker.insert(marker.end(), profile.begin(), profile.end());
+    jpeg_write_marker(&encoder, JPEG_APP0 + 2, marker.data(), marker.size());
+    std::array<uint8_t, 6> row { 255, 0, 0, 255, 0, 0 };
+    JSAMPROW rowPointer = row.data();
+    jpeg_write_scanlines(&encoder, &rowPointer, 1);
+    jpeg_finish_compress(&encoder);
+    auto data = SharedBuffer::create(std::span<const uint8_t> { memory, length });
+    jpeg_destroy_compress(&encoder);
+    free(memory);
+    for (auto option : { GammaAndColorProfileOption::Applied, GammaAndColorProfileOption::Ignored }) {
+        auto decoder = JPEGImageDecoder::create(AlphaOption::Premultiplied, option);
+        decoder->setData(data, true);
+        auto image = decoder->createFrameImageAtIndex(0);
+        ASSERT_TRUE(image);
+        EXPECT_EQ(image->colorSpace()->isSRGB(), option == GammaAndColorProfileOption::Ignored);
+        EXPECT_EQ(image->colorType(), kN32_SkColorType);
+    }
+}
