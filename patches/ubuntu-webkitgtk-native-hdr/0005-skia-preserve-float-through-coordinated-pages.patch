+#if USE(SKIA)
+bool BitmapTexture::updateContents(const SkPixmap& source, const IntRect& targetRect, const IntPoint& sourceOffset)
+{
+    // SkPixmap conversion is required even for an 8-bit P3 source: a raw GL
+    // upload has neither a source colour space nor a colour transform.
+    SkBitmap converted;
+    auto info = m_imageInfo.makeDimensions({ targetRect.width(), targetRect.height() });
+    if (!converted.tryAllocPixels(info))
+        return false;
+    if (!source.readPixels(converted.pixmap(), sourceOffset.x(), sourceOffset.y()))
+        return false;
+
+    m_pixelFormat = PixelFormat::RGBA8; // Both physical working types use RGBA order.
+    glBindTexture(GL_TEXTURE_2D, m_id);
+    GLint previousAlignment;
+    glGetIntegerv(GL_UNPACK_ALIGNMENT, &previousAlignment);
+    glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+    glTexSubImage2D(GL_TEXTURE_2D, 0, targetRect.x(), targetRect.y(), targetRect.width(), targetRect.height(), GL_RGBA,
+        info.colorType() == kRGBA_F16_SkColorType ? halfFloat : s_pixelDataType, converted.getPixels());
+    glPixelStorei(GL_UNPACK_ALIGNMENT, previousAlignment);
+    return true;
+}
+
+void BitmapTexture::copyFromTexture(const BitmapTexture& source, const IntRect& targetRect, const IntSize& sourceOffset)
+{
+    // The physical copy converts between fixed and floating storage as needed;
+    // working textures have the same explicit nonlinear-sRGB colour space.
+    ASSERT(SkColorSpace::Equals(m_imageInfo.colorSpace(), source.m_imageInfo.colorSpace()));
+    copyFromExternalTexture(source.id(), targetRect, sourceOffset);
+    m_pixelFormat = source.m_pixelFormat;
+}
+#endif
