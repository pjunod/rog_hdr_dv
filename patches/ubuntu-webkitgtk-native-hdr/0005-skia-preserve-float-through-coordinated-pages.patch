+
+bool BitmapTexture::supportsExtendedColor()
+{
+    auto* context = GLContext::current();
+    if (!context || context->version() < 300)
+        return false;
+
+    auto* version = reinterpret_cast<const char*>(glGetString(GL_VERSION));
+    if (!version)
+        return false;
+    if (!std::strstr(version, "OpenGL ES"))
+        return true; // Floating colour attachments are core in desktop GL 3.
+
+    auto* extensions = reinterpret_cast<const char*>(glGetString(GL_EXTENSIONS));
+    return extensions && (GLContext::isExtensionSupported(extensions, "GL_EXT_color_buffer_float")
+        || GLContext::isExtensionSupported(extensions, "GL_EXT_color_buffer_half_float"));
+}
+
+SkImageInfo BitmapTexture::workingImageInfo(const IntSize& size, bool)
+{
+    // Keep a premultiplied alpha channel even for opaque layer content: these
+    // textures are also used by copies, masks and transparency intermediates.
+    return SkImageInfo::Make(size.width(), size.height(), supportsExtendedColor() ? kRGBA_F16_SkColorType : kRGBA_8888_SkColorType, kPremul_SkAlphaType, SkColorSpace::MakeSRGB());
+}
+
+unsigned BitmapTexture::internalFormat() const
+{
+    return m_imageInfo.colorType() == kRGBA_F16_SkColorType ? rgba16f : GL_RGBA8;
