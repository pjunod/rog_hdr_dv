+TEST(SkiaDecodedImageColour, OnePixelOptimizationPreservesWideFloatAndFrameClearCost)
+{
+    auto store = ImageBackingStore::create({ 1, 1 });
+    ASSERT_TRUE(store->setStorageFormat(kRGBA_F16_SkColorType));
+    store->setPixelFloat(0, 0, 1.2f, -0.1f, 0.2f, 0.5f);
+    auto maybeNative = NativeImage::create(store->image());
+    ASSERT_TRUE(maybeNative);
+    Ref native = maybeNative.releaseNonNull();
+    auto color = native->singlePixelSolidColor();
+    ASSERT_TRUE(color);
+    auto [r, g, b, a] = color->toColorTypeLossy<ExtendedSRGBA<float>>().resolved();
+    EXPECT_NEAR(r, 1.2f, 0.002f);
+    EXPECT_NEAR(g, -0.1f, 0.001f);
+    EXPECT_NEAR(b, 0.2f, 0.001f);
+    EXPECT_EQ(a, 0.5f);
+
+    auto bitmap = BitmapImage::create(native.copyRef());
+    auto page = ImageBuffer::create({ 2, 1 }, RenderingMode::Unaccelerated, RenderingPurpose::Unspecified,
+        1, DestinationColorSpace::SRGB(), PixelFormat::BGRA8);
+    ASSERT_TRUE(page);
+    page->context().drawImage(bitmap.get(), { 0, 0, 2, 1 }, { 0, 0, 1, 1 }, { });
+    auto result = page->copyNativeImage();
+    ASSERT_TRUE(result);
+    auto readback = pixels(result->platformImage());
+    EXPECT_NEAR(readback[0], 1.2f, 0.002f);
+    EXPECT_NEAR(readback[1], -0.1f, 0.001f);
+    EXPECT_NEAR(readback[2], 0.2f, 0.001f);
+    EXPECT_EQ(readback[3], 0.5f);
+
+    ImageFrame frame(native.copyRef());
+    EXPECT_EQ(frame.sizeInBytes(), 8u);
+    EXPECT_EQ(frame.clearSourceImage(ShouldDecodeToHDR::No), 8u);
+    EXPECT_EQ(frame.sizeInBytes(), 0u);
+    EXPECT_EQ(frame.clearSourceImage(ShouldDecodeToHDR::No), 0u);
+
+    // Actual raster row padding counts as storage; it is not width*height*4.
+    std::array<uint8_t, 32> padded { };
+    auto info = SkImageInfo::Make(1, 2, kRGBA_F16_SkColorType, kPremul_SkAlphaType, SkColorSpace::MakeSRGB());
+    SkPixmap pixmap(info, padded.data(), 16);
+    auto paddedNative = NativeImage::create(SkImages::RasterFromPixmap(pixmap, nullptr, nullptr));
+    ASSERT_TRUE(paddedNative);
+    ImageFrame paddedFrame(paddedNative.releaseNonNull());
+    EXPECT_EQ(paddedFrame.sizeInBytes(), 32u);
+    EXPECT_EQ(paddedFrame.clearImage(), 32u);
+    EXPECT_EQ(paddedFrame.sizeInBytes(), 0u);
+}
