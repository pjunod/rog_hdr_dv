+#if USE(SKIA)
+size_t ImageFrame::nativeImageSizeInBytes(const NativeImage& nativeImage)
+{
+    auto image = nativeImage.platformImage();
+    SkPixmap pixels;
+    if (image->peekPixels(&pixels)) {
+        auto bytes = CheckedSize(pixels.rowBytes()) * image->height();
+        return bytes.hasOverflowed() ? std::numeric_limits<size_t>::max() : bytes.value();
+    }
+    // GPU resident allocation is driver-dependent. This is a checked nominal
+    // pixel-storage estimate with the actual colour type, not a residency claim.
+    return image->imageInfo().computeMinByteSize();
+}
+#endif
+
+unsigned ImageFrame::sizeInBytes(std::optional<ShouldDecodeToHDR> shouldDecodeToHDR) const
+{
+#if USE(SKIA)
+    auto image = nativeImage(shouldDecodeToHDR);
+    if (!image)
+        return 0;
+    auto bytes = nativeImageSizeInBytes(*image);
+    return isInBounds<unsigned>(bytes) ? static_cast<unsigned>(bytes) : std::numeric_limits<unsigned>::max();
+#else
+    UNUSED_PARAM(shouldDecodeToHDR);
+    return (size().area() * sizeof(uint32_t)).value();
+#endif
+}
+
