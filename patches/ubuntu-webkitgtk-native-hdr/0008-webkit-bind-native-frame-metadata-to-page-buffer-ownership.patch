+static GRefPtr<GdkTexture> memoryTexture(bool pq)
+{
+    std::array<uint16_t, 4> pixels = pq ? std::array<uint16_t, 4> { 65535, 0, 0, 65535 } : std::array<uint16_t, 4> { 0x3c00, 0, 0, 0x3c00 };
+    auto bytes = adoptGRef(g_bytes_new(pixels.data(), sizeof(pixels)));
+    auto builder = adoptGRef(gdk_memory_texture_builder_new());
+    gdk_memory_texture_builder_set_bytes(builder.get(), bytes.get());
+    gdk_memory_texture_builder_set_width(builder.get(), 1);
+    gdk_memory_texture_builder_set_height(builder.get(), 1);
+    gdk_memory_texture_builder_set_stride(builder.get(), sizeof(pixels));
+    gdk_memory_texture_builder_set_format(builder.get(), pq ? GDK_MEMORY_R16G16B16A16 : GDK_MEMORY_R16G16B16A16_FLOAT_PREMULTIPLIED);
+    gdk_memory_texture_builder_set_color_state(builder.get(), pq ? gdk_color_state_get_rec2100_pq() : gdk_color_state_get_srgb());
+    return adoptGRef(gdk_memory_texture_builder_build(builder.get()));
+}
+
+// This replaces only the hardware allocation/import. Frame state, metadata
+// movement, colour-contract binding, and retirement are the production helper.
+class TestBuffer final : public RefCounted<TestBuffer> {
+public:
+    static Ref<TestBuffer> create(uint64_t id)
+    {
+        return adoptRef(*new TestBuffer(id));
+    }
+    const WebCore::DestinationColorSpace& colorSpace() const { return m_colorSpace; }
+    uint64_t id() const { return m_id; }
+    void rebuildTexture() { texture = memoryTexture(false); }
+    void release()
+    {
+        ++releaseCredits;
+        texture = nullptr;
+    }
+    GRefPtr<GdkTexture> texture;
+    unsigned releaseCredits { 0 };
+private:
+    explicit TestBuffer(uint64_t id) : m_id(id) { rebuildTexture(); }
+    uint64_t m_id;
+    WebCore::DestinationColorSpace m_colorSpace { WebCore::DestinationColorSpace::SRGB() };
+};
+
+TEST(RendererBufferFrame, SameIDNativeToOrdinaryRetainsTextureAndRetiresAllocationOnce)
+{
+    using Frame = WebKit::RendererBufferFrame<TestBuffer>;
+    auto page = TestBuffer::create(7);
+    ASSERT_TRUE(page->texture);
+    Frame pending;
+    pending.attach(RefPtr { page.ptr() }, { });
+    // Pixel seals and source authorization are separate acceptance boundaries;
+    // this case exercises the committed metadata and allocation ownership.
+    WebCore::GTKVideoPlane plane { 1, 1, WebCore::ProcessIdentifier::generate(), 1, 1, 1, 1, { { }, { 1, 1 } }, { 1, 1 }, 8, { } };
+    pending.setNativeVideo(11, std::make_optional(WTF::move(plane)));
+    Frame committed;
+    committed.commitFrom(WTF::move(pending));
+    ASSERT_TRUE(committed.plane);
+    EXPECT_TRUE(committed.nativeVideoCandidate);
+    EXPECT_EQ(11u, committed.nativeVideoSerial);
+    committed.nativeTexture = memoryTexture(true);
+    ASSERT_TRUE(committed.nativeTexture);
+    EXPECT_TRUE(gdk_color_state_equal(gdk_texture_get_color_state(committed.nativeTexture.get()), gdk_color_state_get_rec2100_pq()));
+
+    // The next ordinary frame uses the identical allocation and a fresh page
+    // texture. Its fence transfers to the monitor exactly once and must finish
+    // before the caller commits, as in swapBuffersIfNeeded().
+    int pipeFDs[2];
+    ASSERT_EQ(0, pipe(pipeFDs));
+    UnixFileDescriptor readEnd { pipeFDs[0], UnixFileDescriptor::Adopt };
+    UnixFileDescriptor writeEnd { pipeFDs[1], UnixFileDescriptor::Adopt };
+    int fenceFD = readEnd.value();
+    page->rebuildTexture();
+    auto* rebuilt = page->texture.get();
+    pending.attach(RefPtr { page.ptr() }, WTF::move(readEnd));
+    auto waitingFence = pending.takeRenderingFence();
+    EXPECT_EQ(fenceFD, waitingFence.value());
+    EXPECT_FALSE(pending.takeRenderingFence());
+    EXPECT_GE(fcntl(fenceFD, F_GETFD), 0);
+    waitingFence = { }; // FenceMonitor completion releases its owned descriptor.
+    errno = 0;
+    EXPECT_EQ(-1, fcntl(fenceFD, F_GETFD));
+    EXPECT_EQ(EBADF, errno);
+    committed.commitFrom(WTF::move(pending));
+
+    EXPECT_EQ(7u, committed.buffer->id());
+    EXPECT_EQ(rebuilt, committed.buffer->texture.get());
+    EXPECT_EQ(0u, page->releaseCredits);
+    EXPECT_FALSE(committed.nativeVideoCandidate);
+    EXPECT_FALSE(committed.plane);
+    EXPECT_FALSE(committed.nativeTexture);
+    EXPECT_EQ(0u, committed.nativeVideoSerial);
+    EXPECT_TRUE(committed.colorSpace() == WebCore::DestinationColorSpace::SRGB());
+    EXPECT_TRUE(gdk_color_state_equal(gdk_texture_get_color_state(committed.buffer->texture.get()), gdk_color_state_get_srgb()));
+
+    // ReleaseBuffer credits belong to the allocation. Return the old credit
+    // only when a different allocation replaces it, then never return it again.
+    auto replacement = TestBuffer::create(8);
+    pending.attach(RefPtr { replacement.ptr() }, { });
+    committed.commitFrom(WTF::move(pending));
+    EXPECT_EQ(1u, page->releaseCredits);
+    EXPECT_FALSE(page->texture);
+    auto third = TestBuffer::create(9);
+    pending.attach(RefPtr { third.ptr() }, { });
+    committed.commitFrom(WTF::move(pending));
+    EXPECT_EQ(1u, page->releaseCredits);
+    EXPECT_EQ(1u, replacement->releaseCredits);
+}
