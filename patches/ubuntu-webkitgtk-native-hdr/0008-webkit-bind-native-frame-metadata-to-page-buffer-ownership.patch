+#include <WebCore/DestinationColorSpace.h>
+#include <optional>
+#include <utility>
+#include <wtf/RefPtr.h>
+#include <wtf/unix/UnixFileDescriptor.h>
+
+#if USE(GTK4) && ENABLE(VIDEO) && USE(GSTREAMER)
+#include <WebCore/GTKNativeVideo.h>
+#include <gtk/gtk.h>
+#include <wtf/glib/GRefPtr.h>
+#endif
+
+namespace WebKit {
+
+// One page-buffer ownership interval. Its source colour contract belongs to
+// the allocation; optional native-video metadata belongs to the individual
+// frame and never retags the ordinary page texture.
+template<typename Buffer> class RendererBufferFrame {
+public:
+    RefPtr<Buffer> buffer;
+#if USE(GTK4) && ENABLE(VIDEO) && USE(GSTREAMER)
+    bool nativeVideoCandidate { false };
+    uint64_t nativeVideoSerial { 0 };
+    std::optional<WebCore::GTKVideoPlane> plane;
+    GRefPtr<GdkTexture> nativeTexture;
+
+    void clearNativeVideo()
+    {
+        nativeVideoCandidate = false;
+        invalidateNativePlane();
+    }
+
+    void invalidateNativePlane()
+    {
+        nativeVideoSerial = 0;
+        plane.reset();
+        nativeTexture = nullptr;
+    }
+
+    void setNativeVideo(uint64_t serial, std::optional<WebCore::GTKVideoPlane>&& nextPlane)
+    {
+        ASSERT(buffer);
+        nativeVideoCandidate = true;
+        nativeVideoSerial = serial;
+        plane = WTF::move(nextPlane);
+        nativeTexture = nullptr;
+    }
+#endif
+
+    const WebCore::DestinationColorSpace& colorSpace() const
+    {
+        ASSERT(buffer);
+        return buffer->colorSpace();
+    }
+
+    void attach(RefPtr<Buffer>&& nextBuffer, UnixFileDescriptor&& renderingFence)
+    {
+        ASSERT(!buffer);
+#if USE(GTK4) && ENABLE(VIDEO) && USE(GSTREAMER)
+        clearNativeVideo();
+#endif
+        buffer = WTF::move(nextBuffer);
+        m_renderingFence = WTF::move(renderingFence);
+    }
+
+    UnixFileDescriptor takeRenderingFence()
+    {
+        return std::exchange(m_renderingFence, UnixFileDescriptor { });
+    }
+
+    void commitFrom(RendererBufferFrame&& next)
+    {
+        // FenceMonitor owns the transferred fence and the caller waits for it
+        // before reaching this commit. ReleaseBuffer is an allocation credit,
+        // not a frame credit: retaining the same allocation must not make it
+        // available to the producer while this frame still samples it.
+        ASSERT(!next.m_renderingFence);
+        if (buffer && buffer != next.buffer)
+            buffer->release();
+        *this = WTF::move(next);
+        next.clear();
+    }
+
+    void clear()
+    {
+        buffer = nullptr;
+        m_renderingFence = { };
+#if USE(GTK4) && ENABLE(VIDEO) && USE(GSTREAMER)
+        clearNativeVideo();
+#endif
+    }
+
+private:
+    UnixFileDescriptor m_renderingFence;
+};
+
+} // namespace WebKit
