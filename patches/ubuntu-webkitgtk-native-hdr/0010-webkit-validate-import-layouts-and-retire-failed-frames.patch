+// One bounded recovery transaction per surface. Only a real non-SHM import
+// rejection requests an ordinary redraw; rejecting the SHM leaf is terminal.
+class RendererBufferImportState {
+public:
+    bool reject(bool sharedMemory)
+    {
+        if (sharedMemory) {
+            m_state = State::Terminal;
+            return false;
+        }
+        if (m_state != State::Negotiated)
+            return false;
+        m_state = State::SharedMemory;
+        return true;
+    }
+    bool usesSharedMemory() const { return m_state == State::SharedMemory; }
+    bool terminal() const { return m_state == State::Terminal; }
+private:
+    enum class State { Negotiated, SharedMemory, Terminal };
+    State m_state { State::Negotiated };
+};
+
+template<typename Texture, typename Build>
+bool updateRendererBufferTexture(Texture& current, Build&& build)
+{
+    auto candidate = build();
+    if (!candidate)
+        return false;
+    current = WTF::move(candidate);
+    return true;
+}
+
