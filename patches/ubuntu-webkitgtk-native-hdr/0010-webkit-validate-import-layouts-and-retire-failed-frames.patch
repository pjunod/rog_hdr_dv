+inline bool rendererBufferLayoutIsAllowed(std::span<const RendererBufferFormat::Format> allowed, uint32_t fourcc, uint64_t modifier)
+{
+    for (const auto& format : allowed) {
+        if (format.fourcc == fourcc && format.modifiers.contains(modifier))
+            return true;
+    }
+    return false;
+}
+
+// Allocation owns its unpublished GL/EGL resources. Rejected actual layouts
+// are destroyed before trying the legal U8 alternative. Only the publisher
+// may send creation IPC, and it sees admitted actual tuples exclusively.
+template<typename Allocate, typename Publish>
+auto createAllowedRendererBuffer(std::span<const RendererBufferFormat::Format> allowed, bool preferFloat, Allocate&& allocate, Publish&& publish)
+{
+    using Result = decltype(publish(allocate(false)));
+    if (allowed.empty())
+        return Result { };
+    for (bool floating : { true, false }) {
+        if (floating && !preferFloat)
+            continue;
+        auto allocation = allocate(floating);
+        if (!allocation || !rendererBufferLayoutIsAllowed(allowed, allocation->fourcc(), allocation->modifier()))
+            continue;
+        if (auto result = publish(WTF::move(allocation)))
+            return result;
+    }
+    return Result { };
+}
+
 } // namespace WebKit
