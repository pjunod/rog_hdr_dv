+TEST_F(SkiaTextureContextTest, LegacyU8AllocationUploadCopySampleHasNoGLError)
+{
+    auto* version = reinterpret_cast<const char*>(glGetString(GL_VERSION));
+    auto* renderer = reinterpret_cast<const char*>(glGetString(GL_RENDERER));
+    RecordProperty("actualGLVersion", version ? version : "unavailable");
+    RecordProperty("actualGLAPI", version && std::strstr(version, "OpenGL ES") ? "OpenGL ES" : "OpenGL");
+    RecordProperty("actualGLRenderer", renderer ? renderer : "unavailable");
+    RecordProperty("actualGLNumericVersion", static_cast<int>(GLContext::current()->version()));
+    // This always executes the production unsized RGBA/UNSIGNED_BYTE branch.
+    // GL3 execution is useful U8 coverage, not a claim of a genuine GLES2 run.
+    EXPECT_EQ(static_cast<GLenum>(GL_NO_ERROR), glGetError());
+    auto info = workingInfo(2, 1, kRGBA_8888_SkColorType);
+    auto source = BitmapTexturePool::singleton().acquireTexture(info, { BitmapTexture::Flags::SupportsAlpha });
+    std::array<uint8_t, 8> pixels { 64, 128, 192, 255, 192, 64, 128, 255 };
+    SkPixmap pixmap(info, pixels.data(), pixels.size());
+    ASSERT_TRUE(source->updateContents(pixmap, { { }, { 2, 1 } }, { }));
+    auto copied = BitmapTexturePool::singleton().acquireTexture(info, { BitmapTexture::Flags::SupportsAlpha });
+    copied->copyFromTexture(source.get(), { { }, { 2, 1 } }, { });
+    auto sampled = BitmapTexturePool::singleton().acquireTexture(info, { BitmapTexture::Flags::SupportsAlpha });
+    auto mapper = TextureMapper::create();
+    mapper->beginPainting(TextureMapper::FlipY::No, sampled.ptr());
+    mapper->drawTexture(copied.get(), { { }, { 2, 1 } }, { }, 1.f, TextureMapper::AllEdgesExposed::No);
+    mapper->endPainting();
+    GLuint framebuffer;
+    glGenFramebuffers(1, &framebuffer);
+    glBindFramebuffer(GL_FRAMEBUFFER, framebuffer);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, sampled->id(), 0);
+    EXPECT_EQ(static_cast<GLenum>(GL_FRAMEBUFFER_COMPLETE), glCheckFramebufferStatus(GL_FRAMEBUFFER));
+    std::array<uint8_t, 8> actual { };
+    glReadPixels(0, 0, 2, 1, GL_RGBA, GL_UNSIGNED_BYTE, actual.data());
+    EXPECT_EQ(pixels, actual);
+    EXPECT_EQ(static_cast<GLenum>(GL_NO_ERROR), glGetError());
+    glBindFramebuffer(GL_FRAMEBUFFER, 0);
+    glDeleteFramebuffers(1, &framebuffer);
+}
