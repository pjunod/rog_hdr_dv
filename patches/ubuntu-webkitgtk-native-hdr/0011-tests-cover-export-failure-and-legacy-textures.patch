+TEST(RendererBufferLayouts, RejectsActualModifierOrFourccBeforePublishingLegalFallback)
+{
+    constexpr uint32_t f16 = 0x48344241; // DRM AB4H
+    constexpr uint32_t otherF16 = 0x48345241; // DRM AR4H
+    constexpr uint32_t u8 = 0x34325241; // DRM AR24
+    Vector<WebKit::RendererBufferFormat::Format> allowed { { f16, { 17 } }, { u8, { 23 } } };
+    struct Allocation {
+        uint32_t format;
+        uint64_t layout;
+        unsigned& destroyed;
+        Allocation(uint32_t format, uint64_t layout, unsigned& destroyed) : format(format), layout(layout), destroyed(destroyed) { }
+        ~Allocation() { ++destroyed; }
+        uint32_t fourcc() const { return format; }
+        uint64_t modifier() const { return layout; }
+    };
+    for (bool wrongFourcc : { false, true }) {
+        unsigned destroyed = 0;
+        unsigned published = 0;
+        auto result = WebKit::createAllowedRendererBuffer(allowed.span(), true, [&](bool floating) {
+            return std::make_unique<Allocation>(floating ? (wrongFourcc ? otherF16 : f16) : u8, floating ? (wrongFourcc ? 17u : 19u) : 23u, destroyed);
+        }, [&](std::unique_ptr<Allocation>&& allocation) {
+            EXPECT_EQ(1u, destroyed); // The rejected export was disposed before IPC.
+            EXPECT_EQ(u8, allocation->fourcc());
+            EXPECT_EQ(23u, allocation->modifier());
+            ++published;
+            return WTF::move(allocation);
+        });
+        ASSERT_TRUE(result);
+        EXPECT_EQ(1u, published);
+        result = nullptr;
+        EXPECT_EQ(2u, destroyed);
+    }
+}
+
+TEST(RendererBufferLayouts, RejectedActualFloatAndPackedLayoutsReachSHMWithoutPublication)
+{
+    constexpr uint32_t f16 = 0x48344241;
+    constexpr uint32_t u8 = 0x34325241;
+    Vector<WebKit::RendererBufferFormat::Format> allowed { { f16, { 17 } }, { u8, { 23 } } };
+    struct Allocation {
+        uint32_t format;
+        uint32_t fourcc() const { return format; }
+        uint64_t modifier() const { return 99; }
+    };
+    unsigned publications = 0;
+    auto result = WebKit::createAllowedRendererBuffer(allowed.span(), true, [&](bool floating) {
+        return std::make_unique<Allocation>(Allocation { floating ? f16 : u8 });
+    }, [&](std::unique_ptr<Allocation>&& allocation) {
+        ++publications;
+        return WTF::move(allocation);
+    });
+    EXPECT_FALSE(result);
+    EXPECT_EQ(0u, publications);
+    // The production caller selects its existing SHM allocator when no actual
+    // export is admitted; that leaf never publishes either illegal tuple.
+    WebKit::RendererBufferImportState route;
+    EXPECT_TRUE(route.reject(false));
+    EXPECT_TRUE(route.usesSharedMemory());
+}
+
+TEST(RendererBufferFrame, FailedSameAllocationImportPreservesTextureAndAcknowledgesOnce)
+{
+    using Frame = WebKit::RendererBufferFrame<TestBuffer>;
+    auto page = TestBuffer::create(7);
+    Frame pending;
+    pending.attach(RefPtr { page.ptr() }, { });
+    Frame committed;
+    committed.commitFrom(WTF::move(pending));
+    committed.nativeTexture = memoryTexture(true);
+    committed.nativeVideoCandidate = true;
+    auto* valid = page->texture.get();
+    auto* native = committed.nativeTexture.get();
+    pending.attach(RefPtr { page.ptr() }, { });
+    unsigned rejects = 0;
+    unsigned acknowledgements = 0;
+    EXPECT_FALSE(committed.importAndCommitFrom(WTF::move(pending), [&](TestBuffer& buffer, TestBuffer*) {
+        return WebKit::updateRendererBufferTexture(buffer.texture, [] { return GRefPtr<GdkTexture> { }; });
+    }, [&](TestBuffer& buffer, bool retained) {
+        EXPECT_EQ(page.ptr(), &buffer);
+        EXPECT_TRUE(retained);
+        ++rejects;
+    }, [&] { ++acknowledgements; }));
+    EXPECT_EQ(valid, page->texture.get());
+    EXPECT_EQ(native, committed.nativeTexture.get());
+    EXPECT_TRUE(committed.nativeVideoCandidate);
+    EXPECT_EQ(0u, page->releaseCredits);
+    EXPECT_EQ(1u, rejects);
+    EXPECT_EQ(1u, acknowledgements);
+    EXPECT_FALSE(pending.buffer);
+}
+
+TEST(RendererBufferFrame, RejectedNewImportPreservesCommittedOwnershipWithoutFreeCredit)
+{
+    using Frame = WebKit::RendererBufferFrame<TestBuffer>;
+    auto held = TestBuffer::create(7);
+    auto rejected = TestBuffer::create(8);
+    Frame pending;
+    pending.attach(RefPtr { held.ptr() }, { });
+    Frame committed;
+    committed.commitFrom(WTF::move(pending));
+    auto* valid = held->texture.get();
+    pending.attach(RefPtr { rejected.ptr() }, { });
+    unsigned retired = 0;
+    unsigned acknowledgements = 0;
+    EXPECT_FALSE(committed.importAndCommitFrom(WTF::move(pending), [&](TestBuffer& buffer, TestBuffer*) {
+        return WebKit::updateRendererBufferTexture(buffer.texture, [] { return GRefPtr<GdkTexture> { }; });
+    }, [&](TestBuffer& buffer, bool retained) {
+        EXPECT_FALSE(retained);
+        EXPECT_EQ(rejected.ptr(), &buffer);
+        ++retired; // Rejection retires the locked allocation; never returns free credit.
+    }, [&] { ++acknowledgements; }));
+    EXPECT_EQ(held.ptr(), committed.buffer.get());
+    EXPECT_EQ(valid, held->texture.get());
+    EXPECT_EQ(0u, held->releaseCredits);
+    EXPECT_EQ(0u, rejected->releaseCredits);
+    EXPECT_EQ(1u, retired);
+    EXPECT_EQ(1u, acknowledgements);
+    EXPECT_FALSE(pending.buffer);
+}
+
+TEST(RendererBufferFrame, StaticPageFallbackRequestsOneRedrawAndSHMFailureTerminates)
+{
+    WebKit::RendererBufferImportState route;
+    unsigned ordinaryRedraws = 0;
+    auto reject = [&](bool shm) {
+        if (route.reject(shm))
+            ++ordinaryRedraws; // The real handler invokes ordinary RenderingUpdate.
+    };
+    reject(false);
+    EXPECT_EQ(1u, ordinaryRedraws);
+    EXPECT_TRUE(route.usesSharedMemory());
+    reject(false); // A second old in-flight allocation cannot start another chain.
+    EXPECT_EQ(1u, ordinaryRedraws);
+    reject(true);
+    EXPECT_TRUE(route.terminal());
+    EXPECT_FALSE(route.usesSharedMemory());
+    reject(true);
+    reject(false);
+    EXPECT_EQ(1u, ordinaryRedraws);
+    EXPECT_TRUE(route.terminal());
+}
