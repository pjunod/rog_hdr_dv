From 12298c70afd74df3fbb4b46e08658be82368627d Mon Sep 17 00:00:00 2001
From: Claude Agent <claude-agent@invalid>
Date: Sat, 14 Nov 2026 21:28:02 +0000
Subject: [PATCH] Release Skia GL resources with their own context current

2.52.6 defaults ~SkiaGLContext, so the thread-local Skia context could be
destroyed (for example by TLS destructors when a thread or the process
exits) with no GL context current. GrDirectContext then released its GL
objects unbound; the first build of the focused colour tests aborted
there in libepoxy. Make the owning context current and call
releaseResourcesAndAbandonContext(); if it cannot be made current, only
abandon the context, without calling into GL.

Backport of WebKit 63f86c394bc8 and c5b6ec5b34d7 (bug 317604). The later
terminated-display guard of e0b1fddaa468 depends on API that 2.52.6
lacks.

Agent-Model: claude-opus-5-5
Agent-Session: 01BCWL9zQ3AH5jz3cWrpdXCg
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../graphics/skia/PlatformDisplaySkia.cpp        | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/Source/WebCore/platform/graphics/skia/PlatformDisplaySkia.cpp b/Source/WebCore/platform/graphics/skia/PlatformDisplaySkia.cpp
index 134a1cf11..aeebe3b59 100644
--- a/Source/WebCore/platform/graphics/skia/PlatformDisplaySkia.cpp
+++ b/Source/WebCore/platform/graphics/skia/PlatformDisplaySkia.cpp
@@ -235,7 +235,21 @@ public:
         return adoptRef(*new SkiaGLContext(display));
     }
 
-    ~SkiaGLContext() = default;
+    ~SkiaGLContext()
+    {
+        // Release Skia's GL objects while their own context is current. A
+        // thread-local context can die from TLS destructors with nothing
+        // current, and GrDirectContext would then call into GL unbound.
+        // Backport of WebKit 63f86c394bc8 and c5b6ec5b34d7 (bug 317604).
+        Locker locker { m_lock };
+        if (!m_skiaGrContext)
+            return;
+        if (m_skiaGLContext && m_skiaGLContext->makeContextCurrent())
+            m_skiaGrContext->releaseResourcesAndAbandonContext();
+        else
+            m_skiaGrContext->abandonContext();
+        m_skiaGrContext = nullptr;
+    }
 
     GLContext* skiaGLContext() const
     {
