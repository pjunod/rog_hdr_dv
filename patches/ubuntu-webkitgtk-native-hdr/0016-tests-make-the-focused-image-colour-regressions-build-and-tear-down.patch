         decoder->setData(buffer, true);
diff --git a/Tools/TestWebKitAPI/Tests/WebCore/glib/SkiaWorkingTexture.cpp b/Tools/TestWebKitAPI/Tests/WebCore/glib/SkiaWorkingTexture.cpp
index d14fc03c..ec49beda 100644
--- a/Tools/TestWebKitAPI/Tests/WebCore/glib/SkiaWorkingTexture.cpp
+++ b/Tools/TestWebKitAPI/Tests/WebCore/glib/SkiaWorkingTexture.cpp
@@ -125,6 +125,17 @@ protected:
         if (!BitmapTexture::supportsExtendedColor())
             GTEST_SKIP() << "No floating colour attachment support";
     }
+
+    void TearDown() override
+    {
+        // Release the thread-local Skia context, and the GPU objects its
+        // GrDirectContext owns, while its own GL context is current, rather
+        // than from TLS destructors at process exit with no context current.
+        if (auto* context = PlatformDisplay::sharedDisplay().skiaGLContext())
+            context->makeContextCurrent();
+        PlatformDisplay::sharedDisplay().clearGLContexts();
+        SkiaTextureContextTest::TearDown();
+    }
 };
 
