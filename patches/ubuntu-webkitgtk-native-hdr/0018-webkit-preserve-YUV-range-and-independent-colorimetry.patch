+
+#pragma once
+
+#include "TextureMapperYUVColorConversion.h"
+#include <gst/video/video.h>
+
+namespace WebCore {
+
+inline YUVColorDescription gstreamerVideoColorDescription(const GstVideoColorimetry& colorimetry)
+{
+    YUVColorDescription description;
+    // These fields are independent. Unknown primaries or transfer must not
+    // discard an explicitly signalled matrix or full-range coding.
+    switch (colorimetry.matrix) {
+    case GST_VIDEO_COLOR_MATRIX_BT709:
+        description.matrix = YUVMatrix::Bt709;
+        break;
+    case GST_VIDEO_COLOR_MATRIX_BT2020:
+        description.matrix = YUVMatrix::Bt2020;
+        break;
+    case GST_VIDEO_COLOR_MATRIX_SMPTE240M:
+        description.matrix = YUVMatrix::Smpte240M;
+        break;
+    default:
+        break;
+    }
+    switch (colorimetry.range) {
+    case GST_VIDEO_COLOR_RANGE_0_255:
+        description.range = YUVRange::Full;
+        break;
+    case GST_VIDEO_COLOR_RANGE_16_235:
+        description.range = YUVRange::Limited;
+        break;
+    default:
+        break;
+    }
+    if (colorimetry.transfer == GST_VIDEO_TRANSFER_SMPTE2084)
+        description.transfer = YUVTransferFunction::Pq;
+    return description;
+}
+
+} // namespace WebCore
