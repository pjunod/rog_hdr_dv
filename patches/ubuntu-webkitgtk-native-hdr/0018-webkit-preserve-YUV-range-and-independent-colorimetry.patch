+ * THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR
+ * PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL APPLE INC. OR ITS CONTRIBUTORS
+ * BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR
+ * CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF
+ * SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS
+ * INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
+ * CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+ * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF
+ * THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#pragma once
+
+#include <array>
+#include <cstdint>
+
+namespace WebCore {
+
+enum class YUVMatrix : uint8_t { Bt601, Bt709, Bt2020, Smpte240M };
+enum class YUVTransferFunction : uint8_t { Bt709, Pq };
+enum class YUVRange : uint8_t { Unknown, Limited, Full };
+enum class YUVSampleFormat : uint8_t { Unorm8, P010 };
+
+struct YUVColorDescription {
+    YUVMatrix matrix { YUVMatrix::Bt601 };
+    YUVTransferFunction transfer { YUVTransferFunction::Bt709 };
+    YUVRange range { YUVRange::Unknown };
+    YUVSampleFormat sampleFormat { YUVSampleFormat::Unorm8 };
+};
+
+inline std::array<float, 16> textureMapperYUVToRGBMatrix(YUVMatrix matrix, YUVRange range, YUVSampleFormat sampleFormat)
+{
+    // Preserve the historical conversion exactly for producers that supply no
+    // range. They have not declared how their texture samples are normalized.
+    if (range == YUVRange::Unknown) {
+        switch (matrix) {
+        case YUVMatrix::Bt601:
+            return { 1.164383561643836, 0.0, 1.596026785714286, -0.874202217873451,
+                1.164383561643836, -0.391762290094914, -0.812967647237771, 0.531667823499146,
+                1.164383561643836, 2.017232142857143, 0.0, -1.085630789302022,
+                0.0, 0.0, 0.0, 1.0 };
+        case YUVMatrix::Bt709:
+            return { 1.164383561643836, 0.0, 1.792741071428571, -0.972945075016308,
+                1.164383561643836, -0.213248614273730, -0.532909328559444, 0.301482665475862,
+                1.164383561643836, 2.112401785714286, 0.0, -1.133402217873451,
+                0.0, 0.0, 0.0, 1.0 };
+        case YUVMatrix::Bt2020:
+            return { 1.164383561643836, 0.0, 1.678674107142857, -0.915687932159165,
+                1.164383561643836, -0.187326104219343, -0.650424318505057, 0.347458498519301,
+                1.164383561643836, 2.141772321428571, 0.0, -1.148145075016308,
+                0.0, 0.0, 0.0, 1.0 };
+        case YUVMatrix::Smpte240M:
+            return { 1.164383561643836, 0.0, 1.793651785714286, -0.973402217873451,
+                1.164383561643836, -0.256532845251675, -0.542724809537390, 0.328136638536074,
+                1.164383561643836, 2.07984375, 0.0, -1.117059360730593,
+                0.0, 0.0, 0.0, 1.0 };
+        }
+    }
+
+    double kr = 0.299;
+    double kb = 0.114;
+    switch (matrix) {
+    case YUVMatrix::Bt601:
+        break;
+    case YUVMatrix::Bt709:
+        kr = 0.2126;
+        kb = 0.0722;
+        break;
+    case YUVMatrix::Bt2020:
+        kr = 0.2627;
+        kb = 0.0593;
+        break;
+    case YUVMatrix::Smpte240M:
+        kr = 0.212;
+        kb = 0.087;
+        break;
+    }
+
+    // P010 planes are imported as normalized R16/GR1616 textures. Their ten
+    // significant bits occupy bits 15..6, so sample = code * 64 / 65535.
+    bool p010 = sampleFormat == YUVSampleFormat::P010;
+    double normalizedCode = p010 ? 64.0 / 65535.0 : 1.0 / 255.0;
+    double codeScale = p010 ? 4 : 1;
+    double black = range == YUVRange::Full ? 0 : 16 * codeScale;
+    double white = range == YUVRange::Full ? (p010 ? 1023 : 255) : 235 * codeScale;
+    double neutral = 128 * codeScale;
+    double chromaRange = range == YUVRange::Full ? (p010 ? 1023 : 255) : 224 * codeScale;
+    double yScale = 1 / ((white - black) * normalizedCode);
+    double cScale = 1 / (chromaRange * normalizedCode);
+    double yOffset = -black / (white - black);
+    double redV = 2 * (1 - kr) * cScale;
+    double blueU = 2 * (1 - kb) * cScale;
+    double greenU = -2 * kb * (1 - kb) / (1 - kr - kb) * cScale;
+    double greenV = -2 * kr * (1 - kr) / (1 - kr - kb) * cScale;
+    double cOffset = neutral * normalizedCode;
+    return { static_cast<float>(yScale), 0, static_cast<float>(redV), static_cast<float>(yOffset - redV * cOffset),
+        static_cast<float>(yScale), static_cast<float>(greenU), static_cast<float>(greenV), static_cast<float>(yOffset - (greenU + greenV) * cOffset),
+        static_cast<float>(yScale), static_cast<float>(blueU), 0, static_cast<float>(yOffset - blueU * cOffset),
+        0, 0, 0, 1 };
+}
+
+} // namespace WebCore
