+#include "config.h"
+#include "Test.h"
+
+#if USE(COORDINATED_GRAPHICS) && USE(GSTREAMER)
+#include <WebCore/GStreamerVideoColorDescription.h>
+#include <WebCore/TextureMapperYUVColorConversion.h>
+
+namespace TestWebKitAPI {
+using namespace WebCore;
+
+static std::array<float, 3> convert(const std::array<float, 16>& matrix, float y, float u, float v)
+{
+    return { matrix[0] * y + matrix[1] * u + matrix[2] * v + matrix[3],
+        matrix[4] * y + matrix[5] * u + matrix[6] * v + matrix[7],
+        matrix[8] * y + matrix[9] * u + matrix[10] * v + matrix[11] };
+}
+
+TEST(TextureMapperYUVColorConversion, PartialColorimetryKeepsIndependentFields)
+{
+    GstVideoColorimetry color { GST_VIDEO_COLOR_RANGE_UNKNOWN, GST_VIDEO_COLOR_MATRIX_BT709, GST_VIDEO_TRANSFER_UNKNOWN, GST_VIDEO_COLOR_PRIMARIES_UNKNOWN };
+    auto description = gstreamerVideoColorDescription(color);
+    EXPECT_EQ(YUVMatrix::Bt709, description.matrix);
+    EXPECT_EQ(YUVRange::Unknown, description.range);
+    EXPECT_EQ(YUVTransferFunction::Bt709, description.transfer);
+    color.range = GST_VIDEO_COLOR_RANGE_0_255;
+    color.matrix = GST_VIDEO_COLOR_MATRIX_UNKNOWN;
+    color.transfer = GST_VIDEO_TRANSFER_SMPTE2084;
+    description = gstreamerVideoColorDescription(color);
+    EXPECT_EQ(YUVMatrix::Bt601, description.matrix);
+    EXPECT_EQ(YUVRange::Full, description.range);
+    EXPECT_EQ(YUVTransferFunction::Pq, description.transfer);
+    color.range = GST_VIDEO_COLOR_RANGE_16_235;
+    color.matrix = GST_VIDEO_COLOR_MATRIX_BT2020;
+    color.transfer = GST_VIDEO_TRANSFER_UNKNOWN;
+    description = gstreamerVideoColorDescription(color);
+    EXPECT_EQ(YUVMatrix::Bt2020, description.matrix);
+    EXPECT_EQ(YUVRange::Limited, description.range);
+    EXPECT_EQ(YUVTransferFunction::Bt709, description.transfer);
+}
+
+TEST(TextureMapperYUVColorConversion, ExplicitRangesMapPhysicalBlackAndWhite)
+{
+    for (auto matrix : { YUVMatrix::Bt601, YUVMatrix::Bt709, YUVMatrix::Bt2020, YUVMatrix::Smpte240M }) {
+        for (auto format : { YUVSampleFormat::Unorm8, YUVSampleFormat::P010 }) {
+            bool p010 = format == YUVSampleFormat::P010;
+            float unit = p010 ? 64.f / 65535 : 1.f / 255;
+            float scale = p010 ? 4 : 1;
+            for (auto range : { YUVRange::Limited, YUVRange::Full }) {
+                auto transform = textureMapperYUVToRGBMatrix(matrix, range, format);
+                float neutral = 128 * scale * unit;
+                float black = range == YUVRange::Full ? 0 : 16 * scale * unit;
+                float white = (range == YUVRange::Full ? (p010 ? 1023 : 255) : 235 * scale) * unit;
+                for (float channel : convert(transform, black, neutral, neutral))
+                    EXPECT_NEAR(0.f, channel, 0.000001f);
+                for (float channel : convert(transform, white, neutral, neutral))
+                    EXPECT_NEAR(1.f, channel, 0.000001f);
+            }
+        }
+    }
+}
+
+TEST(TextureMapperYUVColorConversion, BT709ChromaAndP010HighBitLayout)
+{
+    // An independently encoded BT.709 red has Y'=Kr, Cb=-Kr/(2*(1-Kb)),
+    // Cr=1/2. Verify chroma signs and coefficients, not just neutral samples.
+    for (auto format : { YUVSampleFormat::Unorm8, YUVSampleFormat::P010 }) {
+        bool p010 = format == YUVSampleFormat::P010;
+        double unit = p010 ? 64.0 / 65535 : 1.0 / 255;
+        double scale = p010 ? 4 : 1;
+        for (auto range : { YUVRange::Limited, YUVRange::Full }) {
+            double black = range == YUVRange::Full ? 0 : 16 * scale;
+            double yRange = range == YUVRange::Full ? (p010 ? 1023 : 255) : 219 * scale;
+            double chromaRange = range == YUVRange::Full ? (p010 ? 1023 : 255) : 224 * scale;
+            auto result = convert(textureMapperYUVToRGBMatrix(YUVMatrix::Bt709, range, format),
+                (black + 0.2126 * yRange) * unit,
+                (128 * scale - 0.2126 / (2 * (1 - 0.0722)) * chromaRange) * unit,
+                (128 * scale + chromaRange / 2) * unit);
+            EXPECT_NEAR(1.f, result[0], 0.000001f);
+            EXPECT_NEAR(0.f, result[1], 0.000001f);
+            EXPECT_NEAR(0.f, result[2], 0.000001f);
+        }
+    }
+}
+
+TEST(TextureMapperYUVColorConversion, UnknownRangePreservesLegacyCoefficients)
+{
+    for (auto matrix : { YUVMatrix::Bt601, YUVMatrix::Bt709, YUVMatrix::Bt2020, YUVMatrix::Smpte240M }) {
+        auto legacy = textureMapperYUVToRGBMatrix(matrix, YUVRange::Unknown, YUVSampleFormat::Unorm8);
+        EXPECT_EQ(legacy, textureMapperYUVToRGBMatrix(matrix, YUVRange::Unknown, YUVSampleFormat::P010));
+        EXPECT_FLOAT_EQ(1.164383561643836f, legacy[0]);
+    }
+    auto limited = textureMapperYUVToRGBMatrix(YUVMatrix::Bt601, YUVRange::Unknown, YUVSampleFormat::P010);
+    auto full = textureMapperYUVToRGBMatrix(YUVMatrix::Bt601, YUVRange::Full, YUVSampleFormat::P010);
+    // The dark full-range values observed in the ordinary base-layer control
+    // must survive; the old limited-range matrix would make them negative.
+    float neutral = 512.f * 64 / 65535;
+    auto dark = convert(full, 8.f * 64 / 65535, neutral, neutral);
+    for (float channel : dark)
+        EXPECT_NEAR(8.f / 1023, channel, 0.000001f);
+    EXPECT_LT(convert(limited, 8.f * 64 / 65535, neutral, neutral)[0], 0.f);
+}
+
+} // namespace TestWebKitAPI
+#endif
