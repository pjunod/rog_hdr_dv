+TEST_F(SkiaWorkingTextureTest, YUVP010FullRangeKeepsDarkPictureAndUsesCachedDescription)
+{
+    // These are physical R16/GR1616 P010 codes, not normalized helper inputs.
+    // Full-range code 8 is visible; treating it as limited crushes it below 0.
+    auto dark = renderYUV(YUVSampleFormat::P010, 8, 512, 512, YUVRange::Full, YUVRange::Full);
+    for (unsigned channel = 0; channel < 3; ++channel)
+        EXPECT_NEAR(8.f / 1023, dark[0][channel], 0.00002f);
+    auto reused = renderYUV(YUVSampleFormat::P010, 64, 512, 512, YUVRange::Full, YUVRange::Limited);
+    for (unsigned channel = 0; channel < 3; ++channel) {
+        EXPECT_NEAR(64.f / 1023, reused[0][channel], 0.0001f);
+        EXPECT_NEAR(0.f, reused[1][channel], 0.00001f);
+        EXPECT_NEAR(64.f / 1023, reused[2][channel], 0.0001f);
+    }
+}
