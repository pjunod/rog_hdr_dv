 dlls/kernelbase/kernelbase.spec      |   1 +
 dlls/kernelbase/tests/Makefile.in    |   1 +
 dlls/kernelbase/tests/file_fromapp.c | 214 +++++++++++++++++++++++++++
 4 files changed, 227 insertions(+)
