diff --git a/dlls/kernelbase/file.c b/dlls/kernelbase/file.c
index e271b03..bab8d1f 100644
--- a/dlls/kernelbase/file.c
+++ b/dlls/kernelbase/file.c
@@ -745,6 +745,17 @@ HANDLE WINAPI DECLSPEC_HOTPATCH CreateFile2( LPCWSTR name, DWORD access, DWORD s
 }
 
 
+/*************************************************************************
+ *	CreateFileFromAppW   (kernelbase.@)
+ */
+HANDLE WINAPI DECLSPEC_HOTPATCH CreateFileFromAppW( LPCWSTR name, DWORD access, DWORD sharing,
+                                                    LPSECURITY_ATTRIBUTES sa, DWORD creation,
+                                                    DWORD attributes, HANDLE template )
+{
+    /* AppContainer file-access brokerage is not implemented. */
+    return CreateFileW( name, access, sharing, sa, creation, attributes, template );
+}
+
 /*************************************************************************
  *	CreateFileA   (kernelbase.@)
  */
