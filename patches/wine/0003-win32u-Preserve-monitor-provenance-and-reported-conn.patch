+static struct wine_monitor_properties sanitize_monitor_properties( const struct wine_monitor_properties *properties )
+{
+    struct wine_monitor_properties result = *properties;
+
+    result.flags &= WINE_MONITOR_OUTPUT_TECHNOLOGY_VALID;
+    if (result.origin > WINE_MONITOR_ORIGIN_VIRTUAL) result.origin = WINE_MONITOR_ORIGIN_UNKNOWN;
+    if (result.flags & WINE_MONITOR_OUTPUT_TECHNOLOGY_VALID)
+    {
+        switch (result.output_technology)
+        {
+        case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_OTHER:
+        case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_HD15:
+        case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_SVIDEO:
+        case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_COMPOSITE_VIDEO:
+        case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_COMPONENT_VIDEO:
+        case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_DVI:
+        case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_HDMI:
+        case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_LVDS:
+        case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_D_JPN:
+        case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_SDI:
+        case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_DISPLAYPORT_EXTERNAL:
+        case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_DISPLAYPORT_EMBEDDED:
+        case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_UDI_EXTERNAL:
+        case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_UDI_EMBEDDED:
+        case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_SDTVDONGLE:
+        case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_MIRACAST:
+        case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_INTERNAL:
+            break;
+        default:
+            result.flags &= ~WINE_MONITOR_OUTPUT_TECHNOLOGY_VALID;
+            break;
+        }
+    }
+    if (!(result.flags & WINE_MONITOR_OUTPUT_TECHNOLOGY_VALID))
+        result.output_technology = DISPLAYCONFIG_OUTPUT_TECHNOLOGY_OTHER;
+    return result;
+}
+
+static DISPLAYCONFIG_VIDEO_OUTPUT_TECHNOLOGY monitor_output_technology( const struct monitor *monitor )
+{
+    if (monitor->properties.flags & WINE_MONITOR_OUTPUT_TECHNOLOGY_VALID)
+        return monitor->properties.output_technology;
+    return DISPLAYCONFIG_OUTPUT_TECHNOLOGY_OTHER;
+}
