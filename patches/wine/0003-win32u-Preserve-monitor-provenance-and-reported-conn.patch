+static LONG (WINAPI *query_display_config)(UINT32, UINT32 *, DISPLAYCONFIG_PATH_INFO *,
+                                          UINT32 *, DISPLAYCONFIG_MODE_INFO *, DISPLAYCONFIG_TOPOLOGY_ID *);
+static LONG (WINAPI *get_display_config_buffer_sizes)(UINT32, UINT32 *, UINT32 *);
+static LONG (WINAPI *display_config_get_device_info)(DISPLAYCONFIG_DEVICE_INFO_HEADER *);
+
+static void check_backend_properties( const DISPLAYCONFIG_TARGET_DEVICE_NAME *name,
+                                      DISPLAYCONFIG_VIDEO_OUTPUT_TECHNOLOGY technology )
+{
+    struct wine_monitor_properties properties;
+    SP_DEVICE_INTERFACE_DATA iface = {sizeof(iface)};
+    SP_DEVINFO_DATA devinfo = {sizeof(devinfo)};
+    HDEVINFO set;
+    DEVPROPTYPE type;
+    DWORD size;
+    BOOL ret;
+
+    /* These private provenance facts are Wine-specific, not a Windows promise. */
+    if (strcmp( winetest_platform, "wine" )) return;
+    set = SetupDiCreateDeviceInfoList( NULL, NULL );
+    ok( set != INVALID_HANDLE_VALUE, "Failed to create device info list: %lu.\n", GetLastError() );
+    if (set == INVALID_HANDLE_VALUE) return;
+    ret = SetupDiOpenDeviceInterfaceW( set, name->monitorDevicePath, 0, &iface );
+    ok( ret, "Failed to resolve DisplayConfig monitor interface: %lu.\n", GetLastError() );
+    if (!ret) goto done;
+    ret = SetupDiGetDeviceInterfaceDetailW( set, &iface, NULL, 0, &size, &devinfo );
+    ok( !ret && GetLastError() == ERROR_INSUFFICIENT_BUFFER, "Unexpected detail sizing result %d, error %lu.\n",
+        ret, GetLastError() );
+    if (GetLastError() != ERROR_INSUFFICIENT_BUFFER) goto done;
+    size = sizeof(properties);
+    ret = SetupDiGetDevicePropertyW( set, &devinfo, &WINE_DEVPROPKEY_MONITOR_PROPERTIES,
+                                    &type, (BYTE *)&properties, size, &size, 0 );
+    ok( ret, "Monitor backend properties unavailable: %lu.\n", GetLastError() );
+    if (!ret) goto done;
+    ok( type == DEVPROP_TYPE_BINARY && size == sizeof(properties), "Unexpected property shape %#lx, %lu.\n", type, size );
+    if (type != DEVPROP_TYPE_BINARY || size != sizeof(properties)) goto done;
+    ok( properties.origin <= WINE_MONITOR_ORIGIN_VIRTUAL, "Invalid origin %u.\n", properties.origin );
+    ok( !(properties.flags & ~WINE_MONITOR_OUTPUT_TECHNOLOGY_VALID), "Unknown property flags %#x.\n", properties.flags );
+    if (properties.flags & WINE_MONITOR_OUTPUT_TECHNOLOGY_VALID)
+        ok( technology == properties.output_technology, "Connector differs from backend fact %#x, got %#x.\n",
+            properties.output_technology, technology );
+    else
+        ok( technology == DISPLAYCONFIG_OUTPUT_TECHNOLOGY_OTHER, "Absent connector was reported as %#x.\n", technology );
+    if (properties.origin == WINE_MONITOR_ORIGIN_VIRTUAL)
+        ok( technology == DISPLAYCONFIG_OUTPUT_TECHNOLOGY_OTHER, "Synthetic Wine monitor reported a physical connector %#x.\n",
+            technology );
+done:
+    SetupDiDestroyDeviceInfoList( set );
+}
+
+static void test_connector_consistency(void)
+{
+    DISPLAYCONFIG_MODE_INFO *modes = NULL;
+    DISPLAYCONFIG_PATH_INFO *paths = NULL;
+    DISPLAYCONFIG_TARGET_DEVICE_NAME name;
+    UINT32 path_count, mode_count, i;
+    LONG ret;
+    unsigned int attempt;
+
+    /* Retry only the documented topology sizing race, not test failures. */
+    for (attempt = 0; attempt < 3; attempt++)
+    {
+        ret = get_display_config_buffer_sizes( QDC_ONLY_ACTIVE_PATHS, &path_count, &mode_count );
+        ok( !ret, "Failed to size active topology: %ld.\n", ret );
+        if (ret) return;
+        if (!path_count || !mode_count)
+        {
+            trace( "No active monitor paths; no physical monitor is inferred.\n" );
+            return;
+        }
+        paths = calloc( path_count, sizeof(*paths) );
+        modes = calloc( mode_count, sizeof(*modes) );
+        ok( paths && modes, "Allocation failed.\n" );
+        if (!paths || !modes) goto done;
+        ret = query_display_config( QDC_ONLY_ACTIVE_PATHS, &path_count, paths, &mode_count, modes, NULL );
+        if (ret != ERROR_INSUFFICIENT_BUFFER) break;
+        free( paths );
+        free( modes );
+        paths = NULL;
+        modes = NULL;
+    }
+    ok( !ret, "Failed to query active topology: %ld.\n", ret );
+    if (ret) goto done;
+    for (i = 0; i < path_count; i++)
+    {
+        memset( &name, 0, sizeof(name) );
+        name.header.type = DISPLAYCONFIG_DEVICE_INFO_GET_TARGET_NAME;
+        name.header.size = sizeof(name);
+        name.header.adapterId = paths[i].targetInfo.adapterId;
+        name.header.id = paths[i].targetInfo.id;
+        ret = display_config_get_device_info( &name.header );
+        ok( !ret, "Failed to obtain target identity: %ld.\n", ret );
+        if (ret) continue;
+        ok( name.outputTechnology == paths[i].targetInfo.outputTechnology,
+            "Same target has conflicting connector types %#x and %#x.\n",
+            paths[i].targetInfo.outputTechnology, name.outputTechnology );
+        check_backend_properties( &name, name.outputTechnology );
+    }
+done:
+    free( modes );
+    free( paths );
+}
+
+START_TEST(displayconfig)
+{
+    HMODULE user32 = GetModuleHandleW( L"user32.dll" );
+
+    query_display_config = (void *)GetProcAddress( user32, "QueryDisplayConfig" );
+    get_display_config_buffer_sizes = (void *)GetProcAddress( user32, "GetDisplayConfigBufferSizes" );
+    display_config_get_device_info = (void *)GetProcAddress( user32, "DisplayConfigGetDeviceInfo" );
+    if (!query_display_config || !get_display_config_buffer_sizes || !display_config_get_device_info)
+    {
+        win_skip( "DisplayConfig APIs unavailable.\n" );
+        return;
+    }
+    test_connector_consistency();
+}
