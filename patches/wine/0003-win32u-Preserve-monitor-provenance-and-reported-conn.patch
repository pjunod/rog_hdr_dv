+/* RandR ConnectorType is an ATOM/32 property containing one item. An absent
+ * or unknown value does not imply VGA, DisplayPort or an internal panel. */
+static struct wine_monitor_properties get_monitor_properties( RROutput output )
+{
+    static const struct
+    {
+        const char *name;
+        DISPLAYCONFIG_VIDEO_OUTPUT_TECHNOLOGY technology;
+    } connectors[] =
+    {
+        { "VGA", DISPLAYCONFIG_OUTPUT_TECHNOLOGY_HD15 },
+        { "DVI", DISPLAYCONFIG_OUTPUT_TECHNOLOGY_DVI },
+        { "DVI-I", DISPLAYCONFIG_OUTPUT_TECHNOLOGY_DVI },
+        { "DVI-D", DISPLAYCONFIG_OUTPUT_TECHNOLOGY_DVI },
+        { "DVI-A", DISPLAYCONFIG_OUTPUT_TECHNOLOGY_DVI },
+        { "HDMI", DISPLAYCONFIG_OUTPUT_TECHNOLOGY_HDMI },
+        { "Panel", DISPLAYCONFIG_OUTPUT_TECHNOLOGY_INTERNAL },
+        { "TV-Composite", DISPLAYCONFIG_OUTPUT_TECHNOLOGY_COMPOSITE_VIDEO },
+        { "TV-SVideo", DISPLAYCONFIG_OUTPUT_TECHNOLOGY_SVIDEO },
+        { "TV-Component", DISPLAYCONFIG_OUTPUT_TECHNOLOGY_COMPONENT_VIDEO },
+        { "DisplayPort", DISPLAYCONFIG_OUTPUT_TECHNOLOGY_DISPLAYPORT_EXTERNAL },
+    };
+    struct wine_monitor_properties properties = {.origin = WINE_MONITOR_ORIGIN_DISPLAY_SERVER};
+    unsigned long count = 0, remaining = 0;
+    unsigned char *data = NULL;
+    Atom property, type;
+    char *name;
+    int format, ret;
+    unsigned int i;
+
+    property = XInternAtom( gdi_display, RR_PROPERTY_CONNECTOR_TYPE, True );
+    if (!property) return properties;
+    ret = pXRRGetOutputProperty( gdi_display, output, property, 0, 1, FALSE, FALSE,
+                                XA_ATOM, &type, &format, &count, &remaining, &data );
+    if (ret == Success && type == XA_ATOM && format == 32 && count == 1 && !remaining && data)
+    {
+        if ((name = XGetAtomName( gdi_display, *(Atom *)data )))
+        {
+            for (i = 0; i < ARRAY_SIZE(connectors); i++)
+            {
+                if (strcmp( name, connectors[i].name )) continue;
+                properties.flags |= WINE_MONITOR_OUTPUT_TECHNOLOGY_VALID;
+                properties.output_technology = connectors[i].technology;
+                break;
+            }
+            XFree( name );
+        }
+    }
+    if (data) XFree( data );
+    return properties;
+}
