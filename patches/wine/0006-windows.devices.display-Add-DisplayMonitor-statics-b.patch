+static void test_synthetic_descriptor(void)
+{
+    HDEVINFO set;
+    SP_DEVINFO_DATA device = {.cbSize = sizeof(device)};
+    SP_DEVICE_INTERFACE_DATA iface = {.cbSize = sizeof(iface)};
+    SP_DEVICE_INTERFACE_DETAIL_DATA_W *detail;
+    struct wine_monitor_properties properties = {0};
+    IDisplayMonitor *monitor, *again;
+    IReference_Size *reference;
+    DisplayMonitorConnectionKind connection;
+    DisplayMonitorPhysicalConnectorKind connector;
+    SizeInt32 resolution;
+    Size physical;
+    FLOAT value;
+    BYTE edid[256], *copy;
+    UINT32 length;
+    WCHAR id[128];
+    HSTRING device_id;
+    HKEY key;
+    DWORD size;
+    HRESULT hr;
+    BOOL ret;
+
+    /* Test-owned device nodes are created only under Wine, never on Windows
+     * or by the production implementation. They do not join the display
+     * topology and are removed on every completed fixture path. */
+    if (!winetest_platform || strcmp(winetest_platform, "wine")) return;
+    swprintf( id, ARRAY_SIZE(id), L"ROOT\\WINETEST_DISPLAYMONITOR\\%08lx", GetCurrentProcessId() );
+    set = SetupDiCreateDeviceInfoList( &GUID_DEVCLASS_MONITOR, NULL );
+    ret = SetupDiCreateDeviceInfoW( set, id, &GUID_DEVCLASS_MONITOR, L"Wine test monitor", NULL, 0, &device );
+    ok( ret, "Create test device error %lu.\n", GetLastError() );
+    if (!ret) goto done;
+    ret = SetupDiRegisterDeviceInfo( set, &device, 0, NULL, NULL, NULL );
+    ok( ret, "Register test device error %lu.\n", GetLastError() );
+    if (!ret) goto done;
+    ret = SetupDiCreateDeviceInterfaceW( set, &device, &monitor_interface, NULL, 0, &iface );
+    ok( ret, "Create test interface error %lu.\n", GetLastError() );
+    if (!ret) goto remove;
+    key = SetupDiCreateDevRegKeyW( set, &device, DICS_FLAG_GLOBAL, 0, DIREG_DEV, NULL, NULL );
+    ok( key != INVALID_HANDLE_VALUE, "Create test key error %lu.\n", GetLastError() );
+    if (key == INVALID_HANDLE_VALUE) goto remove;
+    make_edid( edid );
+    RegSetValueExW( key, L"EDID", 0, REG_BINARY, edid, sizeof(edid) );
+    SetupDiSetDevicePropertyW( set, &device, &WINE_DEVPROPKEY_MONITOR_PROPERTIES,
+                              DEVPROP_TYPE_BINARY, (BYTE *)&properties, sizeof(properties), 0 );
+    SetupDiGetDeviceInterfaceDetailW( set, &iface, NULL, 0, &size, NULL );
+    detail = malloc( size );
+    detail->cbSize = sizeof(*detail);
+    ret = SetupDiGetDeviceInterfaceDetailW( set, &iface, detail, size, NULL, NULL );
+    ok( ret, "Interface detail error %lu.\n", GetLastError() );
+    if (!ret) goto close;
+    hr = get_monitor( detail->DevicePath, TRUE, &monitor );
+    ok( hr == S_OK, "Synthetic monitor hr %#lx.\n", hr );
+    if (FAILED(hr)) goto close;
+    hr = IDisplayMonitor_get_DeviceId( monitor, &device_id );
+    ok( hr == S_OK && !wcscmp( WindowsGetStringRawBuffer(device_id, NULL), id ), "Wrong device identity.\n" );
+    WindowsDeleteString( device_id );
+    hr = IDisplayMonitor_get_ConnectionKind( monitor, &connection );
+    ok( hr == HRESULT_FROM_WIN32(ERROR_NOT_SUPPORTED), "Unknown connection hr %#lx.\n", hr );
+    hr = IDisplayMonitor_get_PhysicalConnector( monitor, &connector );
+    ok( hr == S_OK && connector == DisplayMonitorPhysicalConnectorKind_Unknown, "Unknown connector fabricated.\n" );
+    hr = IDisplayMonitor_get_NativeResolutionInRawPixels( monitor, &resolution );
+    ok( hr == S_OK && resolution.Width == 1920 && resolution.Height == 1080, "Native resolution hr %#lx.\n", hr );
+    hr = IDisplayMonitor_get_PhysicalSizeInInches( monitor, &reference );
+    ok( hr == S_OK && reference, "Physical size hr %#lx.\n", hr );
+    if (reference)
+    {
+        IReference_Size_get_Value( reference, &physical );
+        ok( physical.Width > 11.80f && physical.Width < 11.82f, "Wrong native physical width %f.\n", physical.Width );
+        IReference_Size_Release( reference );
+    }
+    hr = IDisplayMonitor_get_MaxLuminanceInNits( monitor, &value );
+    ok( hr == S_OK && value == 616, "Maximum hr %#lx, value %f.\n", hr, value );
+    hr = IDisplayMonitor_get_MinLuminanceInNits( monitor, &value );
+    ok( hr == S_OK && value == 0.25f, "Minimum hr %#lx, value %f.\n", hr, value );
+    hr = IDisplayMonitor_GetDescriptor( monitor, DisplayMonitorDescriptorKind_Edid, &length, &copy );
+    ok( hr == S_OK && length == sizeof(edid) && !memcmp(copy, edid, sizeof(edid)), "EDID byte copy differs.\n" );
+    if (SUCCEEDED(hr))
+    {
+        copy[0] = 17;
+        CoTaskMemFree( copy );
+        hr = IDisplayMonitor_GetDescriptor( monitor, DisplayMonitorDescriptorKind_Edid, &length, &copy );
+        ok( hr == S_OK && !memcmp(copy, edid, sizeof(edid)), "Descriptor ownership differs.\n" );
+        CoTaskMemFree( copy );
+    }
+    /* Update registry after object creation: immutable snapshots remain valid. */
+    memset( edid, 0, sizeof(edid) );
+    RegSetValueExW( key, L"EDID", 0, REG_BINARY, edid, sizeof(edid) );
+    hr = IDisplayMonitor_get_MaxLuminanceInNits( monitor, &value );
+    ok( hr == S_OK && value == 616, "Snapshot changed after registry update.\n" );
+    hr = get_monitor( id, FALSE, &again );
+    ok( hr == S_OK, "New instance resolution hr %#lx.\n", hr );
+    if (SUCCEEDED(hr))
+    {
+        hr = IDisplayMonitor_get_MaxLuminanceInNits( again, &value );
+        ok( hr == HRESULT_FROM_WIN32(ERROR_NOT_SUPPORTED), "Invalid descriptor produced known luminance.\n" );
+        hr = IDisplayMonitor_get_PhysicalSizeInInches( again, &reference );
+        ok( hr == S_OK && !reference, "Unknown size is not null.\n" );
+        IDisplayMonitor_Release( again );
+    }
+    IDisplayMonitor_Release( monitor );
+    test_descriptor_cases( key, id );
+close:
+    free( detail );
+    RegCloseKey( key );
+remove:
+    SetupDiRemoveDevice( set, &device );
+done:
+    SetupDiDestroyDeviceInfoList( set );
+}
+
+START_TEST(displaymonitor)
+{
+    HSTRING name;
+    HRESULT hr;
+    hr = RoInitialize( RO_INIT_MULTITHREADED );
+    ok( SUCCEEDED(hr), "RoInitialize hr %#lx.\n", hr );
+    if (FAILED(hr)) return;
+    WindowsCreateString( RuntimeClass_Windows_Devices_Display_DisplayMonitor,
+                         wcslen(RuntimeClass_Windows_Devices_Display_DisplayMonitor), &name );
+    hr = RoGetActivationFactory( name, &IID_IDisplayMonitorStatics, (void **)&statics );
+    WindowsDeleteString( name );
+    if (FAILED(hr))
+    {
+        win_skip( "DisplayMonitor statics unavailable, hr %#lx.\n", hr );
+        RoUninitialize();
+        return;
+    }
+    test_factory();
+    test_async_lifetime();
+    test_real_interfaces();
+    test_synthetic_descriptor();
+    IDisplayMonitorStatics_Release( statics );
+    RoUninitialize();
+}
