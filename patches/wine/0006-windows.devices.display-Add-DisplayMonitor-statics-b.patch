+
+
+#include "initguid.h"
+#include "private.h"
+#include "winreg.h"
+#include "setupapi.h"
+#include "devguid.h"
+#include "roapi.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(displaymonitor);
+
+static const GUID monitor_interface = {0xe6f07b5f,0xee97,0x4a90,{0xb0,0x76,0x33,0xf5,0x7b,0xf4,0xea,0xa7}};
+static const GUID adapter_interface = {0x5b45201d,0xf2f2,0x4f3b,{0x85,0xbb,0x30,0xff,0x1f,0x95,0x35,0x99}};
+static const DEVPROPKEY monitor_luid = {{0xca085853,0x16ce,0x48aa,{0xb1,0x14,0xde,0x9c,0x72,0x33,0x42,0x23}},1};
+static const DEVPROPKEY monitor_target = {{0xca085853,0x16ce,0x48aa,{0xb1,0x14,0xde,0x9c,0x72,0x33,0x42,0x23}},2};
+static const DEVPROPKEY adapter_luid = {{0x60b193cb,0x5276,0x4d0f,{0x96,0xfc,0xf1,0x73,0xab,0xad,0x3e,0xc6}},2};
+
+struct monitor
+{
+    IDisplayMonitor IDisplayMonitor_iface;
+    LONG ref;
+    HSTRING device_id, display_name, adapter_device_id;
+    DisplayAdapterId adapter_id;
+    UINT32 target_id;
+    BOOL has_adapter, has_target;
+    struct wine_monitor_properties properties;
+    BYTE *edid;
+    UINT32 edid_size;
+    struct monitor_descriptor descriptor;
+};
+
+static HRESULT inspectable_iids( const IID *iid, ULONG *count, IID **iids )
+{
+    if (!count || !iids) return E_POINTER;
+    *count = 0;
+    *iids = CoTaskMemAlloc( sizeof(**iids) );
+    if (!*iids) return E_OUTOFMEMORY;
+    **iids = *iid;
+    *count = 1;
+    return S_OK;
+}
+
+static HRESULT class_name( HSTRING *name )
+{
+    if (!name) return E_POINTER;
+    return WindowsCreateString( RuntimeClass_Windows_Devices_Display_DisplayMonitor,
+                               wcslen(RuntimeClass_Windows_Devices_Display_DisplayMonitor), name );
+}
+
+static struct monitor *impl_from_IDisplayMonitor( IDisplayMonitor *iface )
+{
+    return CONTAINING_RECORD( iface, struct monitor, IDisplayMonitor_iface );
+}
+
+static HRESULT WINAPI monitor_QueryInterface( IDisplayMonitor *iface, REFIID iid, void **out )
+{
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!IsEqualGUID( iid, &IID_IUnknown ) && !IsEqualGUID( iid, &IID_IInspectable ) &&
+        !IsEqualGUID( iid, &IID_IAgileObject ) && !IsEqualGUID( iid, &IID_IDisplayMonitor )) return E_NOINTERFACE;
+    *out = iface;
+    IDisplayMonitor_AddRef( iface );
+    return S_OK;
+}
+
+static ULONG WINAPI monitor_AddRef( IDisplayMonitor *iface )
+{
+    return InterlockedIncrement( &impl_from_IDisplayMonitor(iface)->ref );
+}
+
+static ULONG WINAPI monitor_Release( IDisplayMonitor *iface )
+{
+    struct monitor *impl = impl_from_IDisplayMonitor( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        WindowsDeleteString( impl->device_id );
+        WindowsDeleteString( impl->display_name );
+        WindowsDeleteString( impl->adapter_device_id );
+        free( impl->edid );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI monitor_GetIids( IDisplayMonitor *iface, ULONG *count, IID **iids )
+{
+    return inspectable_iids( &IID_IDisplayMonitor, count, iids );
+}
+
+static HRESULT WINAPI monitor_GetRuntimeClassName( IDisplayMonitor *iface, HSTRING *name )
+{
+    return class_name( name );
+}
+
+static HRESULT WINAPI monitor_GetTrustLevel( IDisplayMonitor *iface, TrustLevel *level )
+{
+    if (!level) return E_POINTER;
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI monitor_get_DeviceId( IDisplayMonitor *iface, HSTRING *value )
+{
+    if (!value) return E_POINTER;
+    return WindowsDuplicateString( impl_from_IDisplayMonitor(iface)->device_id, value );
+}
+
+static HRESULT WINAPI monitor_get_DisplayName( IDisplayMonitor *iface, HSTRING *value )
+{
+    if (!value) return E_POINTER;
+    return WindowsDuplicateString( impl_from_IDisplayMonitor(iface)->display_name, value );
+}
+
+static HRESULT WINAPI monitor_get_ConnectionKind( IDisplayMonitor *iface, DisplayMonitorConnectionKind *value )
+{
+    struct monitor *impl = impl_from_IDisplayMonitor( iface );
+    if (!value) return E_POINTER;
+    if (impl->properties.origin == WINE_MONITOR_ORIGIN_VIRTUAL)
+    {
+        *value = DisplayMonitorConnectionKind_Virtual;
+        return S_OK;
+    }
+    if (!(impl->properties.flags & WINE_MONITOR_OUTPUT_TECHNOLOGY_VALID)) return DISPLAYMONITOR_UNAVAILABLE;
+    switch (impl->properties.output_technology)
+    {
+    case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_INTERNAL:
+    case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_LVDS:
+    case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_DISPLAYPORT_EMBEDDED:
+    case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_UDI_EMBEDDED:
+        *value = DisplayMonitorConnectionKind_Internal;
+        break;
+    case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_MIRACAST:
+        *value = DisplayMonitorConnectionKind_Wireless;
+        break;
+    case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_HD15:
+    case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_SVIDEO:
+    case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_COMPOSITE_VIDEO:
+    case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_COMPONENT_VIDEO:
+    case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_DVI:
+    case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_HDMI:
+    case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_D_JPN:
+    case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_SDI:
+    case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_DISPLAYPORT_EXTERNAL:
+    case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_UDI_EXTERNAL:
+        *value = DisplayMonitorConnectionKind_Wired;
+        break;
+    default: return DISPLAYMONITOR_UNAVAILABLE;
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI monitor_get_PhysicalConnector( IDisplayMonitor *iface, DisplayMonitorPhysicalConnectorKind *value )
+{
+    struct monitor *impl = impl_from_IDisplayMonitor( iface );
+    if (!value) return E_POINTER;
+    *value = DisplayMonitorPhysicalConnectorKind_Unknown;
+    if (!(impl->properties.flags & WINE_MONITOR_OUTPUT_TECHNOLOGY_VALID)) return S_OK;
+    switch (impl->properties.output_technology)
+    {
+    case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_HD15: *value = DisplayMonitorPhysicalConnectorKind_HD15; break;
+    case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_SVIDEO:
+    case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_COMPOSITE_VIDEO:
+    case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_COMPONENT_VIDEO: *value = DisplayMonitorPhysicalConnectorKind_AnalogTV; break;
+    case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_DVI: *value = DisplayMonitorPhysicalConnectorKind_Dvi; break;
+    case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_HDMI: *value = DisplayMonitorPhysicalConnectorKind_Hdmi; break;
+    case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_LVDS: *value = DisplayMonitorPhysicalConnectorKind_Lvds; break;
+    case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_SDI: *value = DisplayMonitorPhysicalConnectorKind_Sdi; break;
+    case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_DISPLAYPORT_EXTERNAL:
+    case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_DISPLAYPORT_EMBEDDED: *value = DisplayMonitorPhysicalConnectorKind_DisplayPort; break;
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI monitor_get_DisplayAdapterDeviceId( IDisplayMonitor *iface, HSTRING *value )
+{
+    struct monitor *impl = impl_from_IDisplayMonitor( iface );
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (!impl->adapter_device_id) return DISPLAYMONITOR_UNAVAILABLE;
+    return WindowsDuplicateString( impl->adapter_device_id, value );
+}
+
+static HRESULT WINAPI monitor_get_DisplayAdapterId( IDisplayMonitor *iface, DisplayAdapterId *value )
+{
+    struct monitor *impl = impl_from_IDisplayMonitor( iface );
+    if (!value) return E_POINTER;
+    if (!impl->has_adapter) return DISPLAYMONITOR_UNAVAILABLE;
+    *value = impl->adapter_id;
+    return S_OK;
+}
+
+static HRESULT WINAPI monitor_get_DisplayAdapterTargetId( IDisplayMonitor *iface, UINT32 *value )
+{
+    struct monitor *impl = impl_from_IDisplayMonitor( iface );
+    if (!value) return E_POINTER;
+    if (!impl->has_target) return DISPLAYMONITOR_UNAVAILABLE;
+    *value = impl->target_id;
+    return S_OK;
+}
+
+#define DESCRIPTOR_GETTER(name, type, flag, field) \
+static HRESULT WINAPI monitor_get_##name( IDisplayMonitor *iface, type *value ) \
+{ \
+    struct monitor *impl = impl_from_IDisplayMonitor( iface ); \
+    if (!value) return E_POINTER; \
+    if (!(impl->descriptor.flags & flag)) return DISPLAYMONITOR_UNAVAILABLE; \
+    *value = impl->descriptor.field; \
+    return S_OK; \
+}
+DESCRIPTOR_GETTER(UsageKind, DisplayMonitorUsageKind, MONITOR_USAGE, usage)
+DESCRIPTOR_GETTER(NativeResolutionInRawPixels, SizeInt32, MONITOR_NATIVE_RESOLUTION, native_resolution)
+DESCRIPTOR_GETTER(RedPrimary, Point, MONITOR_NATIVE_PRIMARIES, primaries[0])
+DESCRIPTOR_GETTER(GreenPrimary, Point, MONITOR_NATIVE_PRIMARIES, primaries[1])
+DESCRIPTOR_GETTER(BluePrimary, Point, MONITOR_NATIVE_PRIMARIES, primaries[2])
+DESCRIPTOR_GETTER(WhitePoint, Point, MONITOR_NATIVE_PRIMARIES, primaries[3])
+DESCRIPTOR_GETTER(MaxLuminanceInNits, FLOAT, MONITOR_MAX_LUMINANCE, max_luminance)
+DESCRIPTOR_GETTER(MinLuminanceInNits, FLOAT, MONITOR_MIN_LUMINANCE, min_luminance)
+DESCRIPTOR_GETTER(MaxAverageFullFrameLuminanceInNits, FLOAT, MONITOR_FULL_LUMINANCE, full_luminance)
+
+static HRESULT WINAPI monitor_get_PhysicalSizeInInches( IDisplayMonitor *iface, IReference_Size **value )
+{
+    struct monitor *impl = impl_from_IDisplayMonitor( iface );
+    IPropertyValueStatics *statics;
+    IInspectable *boxed;
+    HSTRING name;
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (!(impl->descriptor.flags & MONITOR_PHYSICAL_SIZE)) return S_OK;
+    hr = WindowsCreateString( RuntimeClass_Windows_Foundation_PropertyValue,
+                              wcslen(RuntimeClass_Windows_Foundation_PropertyValue), &name );
+    if (FAILED(hr)) return hr;
+    hr = RoGetActivationFactory( name, &IID_IPropertyValueStatics, (void **)&statics );
+    WindowsDeleteString( name );
+    if (FAILED(hr)) return hr;
+    hr = IPropertyValueStatics_CreateSize( statics, impl->descriptor.physical_size, &boxed );
+    IPropertyValueStatics_Release( statics );
+    if (FAILED(hr)) return hr;
+    hr = IInspectable_QueryInterface( boxed, &IID_IReference_Size, (void **)value );
+    IInspectable_Release( boxed );
+    return hr;
+}
+
+static HRESULT monitor_dpi( struct monitor *impl, BOOL vertical, FLOAT *value )
+{
+    if (!value) return E_POINTER;
+    if ((impl->descriptor.flags & (MONITOR_NATIVE_RESOLUTION | MONITOR_PHYSICAL_SIZE)) !=
+        (MONITOR_NATIVE_RESOLUTION | MONITOR_PHYSICAL_SIZE)) return DISPLAYMONITOR_UNAVAILABLE;
+    *value = vertical ? impl->descriptor.native_resolution.Height / impl->descriptor.physical_size.Height :
+                        impl->descriptor.native_resolution.Width / impl->descriptor.physical_size.Width;
+    return S_OK;
+}
+static HRESULT WINAPI monitor_get_RawDpiX( IDisplayMonitor *iface, FLOAT *value )
+{
+    return monitor_dpi( impl_from_IDisplayMonitor(iface), FALSE, value );
+}
+static HRESULT WINAPI monitor_get_RawDpiY( IDisplayMonitor *iface, FLOAT *value )
+{
+    return monitor_dpi( impl_from_IDisplayMonitor(iface), TRUE, value );
+}
+
+static HRESULT WINAPI monitor_GetDescriptor( IDisplayMonitor *iface, DisplayMonitorDescriptorKind kind,
+                                           UINT32 *size, BYTE **value )
+{
+    struct monitor *impl = impl_from_IDisplayMonitor( iface );
+    UINT32 offset = 0, length;
+    if (!size || !value) return E_POINTER;
+    *size = 0;
+    *value = NULL;
+    if (kind == DisplayMonitorDescriptorKind_Edid) length = impl->edid_size;
+    else if (kind == DisplayMonitorDescriptorKind_DisplayId)
+    {
+        offset = impl->descriptor.displayid_offset;
+        length = impl->descriptor.displayid_size;
+    }
+    else return E_INVALIDARG;
+    if (!length) return DISPLAYMONITOR_UNAVAILABLE;
+    if (!(*value = CoTaskMemAlloc( length ))) return E_OUTOFMEMORY;
+    memcpy( *value, impl->edid + offset, length );
+    *size = length;
+    return S_OK;
+}
+
+static const IDisplayMonitorVtbl monitor_vtbl =
+{
+    monitor_QueryInterface, monitor_AddRef, monitor_Release,
+    monitor_GetIids, monitor_GetRuntimeClassName, monitor_GetTrustLevel,
+    monitor_get_DeviceId, monitor_get_DisplayName, monitor_get_ConnectionKind, monitor_get_PhysicalConnector,
+    monitor_get_DisplayAdapterDeviceId, monitor_get_DisplayAdapterId, monitor_get_DisplayAdapterTargetId,
+    monitor_get_UsageKind, monitor_get_NativeResolutionInRawPixels, monitor_get_PhysicalSizeInInches,
+    monitor_get_RawDpiX, monitor_get_RawDpiY, monitor_get_RedPrimary, monitor_get_GreenPrimary,
+    monitor_get_BluePrimary, monitor_get_WhitePoint, monitor_get_MaxLuminanceInNits,
+    monitor_get_MinLuminanceInNits, monitor_get_MaxAverageFullFrameLuminanceInNits, monitor_GetDescriptor
+};
+
+static BOOL read_property( HDEVINFO set, SP_DEVINFO_DATA *device, const DEVPROPKEY *key,
+                           DEVPROPTYPE expected, void *value, DWORD size )
+{
+    DEVPROPTYPE type;
+    DWORD needed;
+    return SetupDiGetDevicePropertyW( set, device, key, &type, value, size, &needed, 0 ) &&
+           type == expected && needed == size;
+}
+
+static HRESULT instance_id( HDEVINFO set, SP_DEVINFO_DATA *device, HSTRING *value )
+{
+    WCHAR *buffer;
+    DWORD size;
+    HRESULT hr;
+    SetupDiGetDeviceInstanceIdW( set, device, NULL, 0, &size );
+    if (GetLastError() != ERROR_INSUFFICIENT_BUFFER) return HRESULT_FROM_WIN32(GetLastError());
+    if (!(buffer = malloc( size * sizeof(*buffer) ))) return E_OUTOFMEMORY;
+    if (!SetupDiGetDeviceInstanceIdW( set, device, buffer, size, NULL )) hr = HRESULT_FROM_WIN32(GetLastError());
+    else hr = WindowsCreateString( buffer, wcslen(buffer), value );
+    free( buffer );
+    return hr;
+}
+
+static void read_adapter_device_id( struct monitor *impl )
+{
+    HDEVINFO set;
+    SP_DEVICE_INTERFACE_DATA iface = {.cbSize = sizeof(iface)};
+    SP_DEVINFO_DATA device = {.cbSize = sizeof(device)};
+    SP_DEVICE_INTERFACE_DETAIL_DATA_W *detail;
+    DisplayAdapterId luid;
+    DWORD index, size;
+
+    if (!impl->has_adapter) return;
+    set = SetupDiGetClassDevsW( &adapter_interface, NULL, NULL, DIGCF_DEVICEINTERFACE | DIGCF_PRESENT );
+    if (set == INVALID_HANDLE_VALUE) return;
+    for (index = 0; SetupDiEnumDeviceInterfaces( set, NULL, &adapter_interface, index, &iface ); index++)
+    {
+        SetupDiGetDeviceInterfaceDetailW( set, &iface, NULL, 0, &size, NULL );
+        if (GetLastError() != ERROR_INSUFFICIENT_BUFFER || !(detail = malloc(size))) continue;
+        detail->cbSize = sizeof(*detail);
+        if (SetupDiGetDeviceInterfaceDetailW( set, &iface, detail, size, NULL, &device ) &&
+            read_property( set, &device, &adapter_luid, DEVPROP_TYPE_INT64, &luid, sizeof(luid) ) &&
+            !memcmp( &luid, &impl->adapter_id, sizeof(luid) ))
+            WindowsCreateString( detail->DevicePath, wcslen(detail->DevicePath), &impl->adapter_device_id );
+        free( detail );
+        if (impl->adapter_device_id) break;
+    }
+    SetupDiDestroyDeviceInfoList( set );
+}
+
+static void read_descriptor( HDEVINFO set, SP_DEVINFO_DATA *device, struct monitor *impl )
+{
+    HKEY key;
+    DWORD size, type;
+    key = SetupDiOpenDevRegKey( set, device, DICS_FLAG_GLOBAL, 0, DIREG_DEV, KEY_READ );
+    if (key == INVALID_HANDLE_VALUE) return;
+    if (!RegQueryValueExW( key, L"EDID", NULL, &type, NULL, &size ) && type == REG_BINARY &&
+        size && size <= DISPLAYMONITOR_MAX_EDID_SIZE && (impl->edid = malloc(size)))
+    {
+        impl->edid_size = size;
+        if (RegQueryValueExW( key, L"EDID", NULL, &type, impl->edid, &size ) || type != REG_BINARY || size != impl->edid_size)
+        {
+            free( impl->edid );
+            impl->edid = NULL;
+            impl->edid_size = 0;
+        }
+    }
+    RegCloseKey( key );
+    monitor_descriptor_parse( impl->edid, impl->edid_size, &impl->descriptor );
+}
+
+static void read_name( HDEVINFO set, SP_DEVINFO_DATA *device, struct monitor *impl )
+{
+    WCHAR buffer[512];
+    DWORD type, size;
+    UINT32 i, j, length;
+    BOOL found;
+    found = SetupDiGetDeviceRegistryPropertyW( set, device, SPDRP_FRIENDLYNAME, &type,
+                                              (BYTE *)buffer, sizeof(buffer), &size );
+    if (!found) found = SetupDiGetDeviceRegistryPropertyW( set, device, SPDRP_DEVICEDESC, &type,
+                                                         (BYTE *)buffer, sizeof(buffer), &size );
+    if (found && type == REG_SZ && size >= sizeof(WCHAR) && size <= sizeof(buffer) &&
+        !(size % sizeof(WCHAR)) && !buffer[size / sizeof(WCHAR) - 1])
+    {
+        WindowsCreateString( buffer, wcslen(buffer), &impl->display_name );
+        return;
+    }
+    if (impl->edid_size < 128) return;
+    for (i = 54; i <= 108; i += 18)
+    {
+        if (memcmp( impl->edid + i, "\0\0\0\xfc\0", 5 )) continue;
+        for (j = 0; j < 13 && impl->edid[i + 5 + j] >= 32 && impl->edid[i + 5 + j] <= 126; j++)
+            buffer[j] = impl->edid[i + 5 + j];
+        length = j;
+        while (length && buffer[length - 1] == ' ') length--;
+        WindowsCreateString( buffer, length, &impl->display_name );
+        return;
+    }
+}
+
+static HRESULT monitor_create( HSTRING id, BOOL interface_id, IInspectable **result )
+{
+    HDEVINFO set;
+    SP_DEVINFO_DATA device = {.cbSize = sizeof(device)};
+    SP_DEVICE_INTERFACE_DATA iface = {.cbSize = sizeof(iface)};
+    struct monitor *impl;
+    HRESULT hr;
+    DWORD size;
+    const WCHAR *buffer = WindowsGetStringRawBuffer( id, NULL );
+
+    *result = NULL;
+    TRACE( "Resolving monitor, interface_id %d.\n", interface_id );
+    set = SetupDiCreateDeviceInfoList( NULL, NULL );
+    if (set == INVALID_HANDLE_VALUE) return HRESULT_FROM_WIN32(GetLastError());
+    if (interface_id)
+    {
+        if (!SetupDiOpenDeviceInterfaceW( set, buffer, 0, &iface )) goto failed;
+        if (!IsEqualGUID( &iface.InterfaceClassGuid, &monitor_interface ))
+        {
+            hr = E_INVALIDARG;
+            goto done;
+        }
+        /* The sizing call returns the interface's real device instance. */
+        SetupDiGetDeviceInterfaceDetailW( set, &iface, NULL, 0, &size, &device );
+        if (GetLastError() != ERROR_INSUFFICIENT_BUFFER) goto failed;
+    }
+    else if (!SetupDiOpenDeviceInfoW( set, buffer, NULL, 0, &device )) goto failed;
+    if (!IsEqualGUID( &device.ClassGuid, &GUID_DEVCLASS_MONITOR ))
+    {
+        hr = E_INVALIDARG;
+        goto done;
+    }
+    if (!(impl = calloc( 1, sizeof(*impl) )))
+    {
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+    impl->IDisplayMonitor_iface.lpVtbl = &monitor_vtbl;
+    impl->ref = 1;
+    hr = instance_id( set, &device, &impl->device_id );
+    if (FAILED(hr))
+    {
+        IDisplayMonitor_Release( &impl->IDisplayMonitor_iface );
+        goto done;
+    }
+    if (!read_property( set, &device, &WINE_DEVPROPKEY_MONITOR_PROPERTIES, DEVPROP_TYPE_BINARY,
+                        &impl->properties, sizeof(impl->properties) ))
+        memset( &impl->properties, 0, sizeof(impl->properties) );
+    impl->has_adapter = read_property( set, &device, &monitor_luid, DEVPROP_TYPE_INT64,
+                                      &impl->adapter_id, sizeof(impl->adapter_id) );
+    impl->has_target = read_property( set, &device, &monitor_target, DEVPROP_TYPE_UINT32,
+                                     &impl->target_id, sizeof(impl->target_id) );
+    read_adapter_device_id( impl );
+    read_descriptor( set, &device, impl );
+    read_name( set, &device, impl );
+    if (impl->properties.origin == WINE_MONITOR_ORIGIN_VIRTUAL && !(impl->descriptor.flags & MONITOR_USAGE))
+    {
+        impl->descriptor.flags |= MONITOR_USAGE;
+        impl->descriptor.usage = DisplayMonitorUsageKind_Standard;
+    }
+    *result = (IInspectable *)&impl->IDisplayMonitor_iface;
+    hr = S_OK;
+    goto done;
+failed:
+    hr = HRESULT_FROM_WIN32(GetLastError());
+done:
+    SetupDiDestroyDeviceInfoList( set );
+    return hr;
+}
+
+struct request
+{
+    IUnknown IUnknown_iface;
+    LONG ref;
+    HSTRING id;
+    BOOL interface_id;
+};
+static struct request *impl_from_request( IUnknown *iface )
+{
+    return CONTAINING_RECORD( iface, struct request, IUnknown_iface );
+}
+static HRESULT WINAPI request_QueryInterface( IUnknown *iface, REFIID iid, void **out )
+{
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!IsEqualGUID( iid, &IID_IUnknown )) return E_NOINTERFACE;
+    *out = iface;
+    IUnknown_AddRef( iface );
+    return S_OK;
+}
+static ULONG WINAPI request_AddRef( IUnknown *iface )
+{
+    return InterlockedIncrement( &impl_from_request(iface)->ref );
+}
+static ULONG WINAPI request_Release( IUnknown *iface )
+{
+    struct request *impl = impl_from_request( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        WindowsDeleteString( impl->id );
+        free( impl );
+    }
+    return ref;
+}
+static const IUnknownVtbl request_vtbl = {request_QueryInterface, request_AddRef, request_Release};
+
+static HRESULT monitor_async( IUnknown *invoker, IUnknown *param, PROPVARIANT *result, BOOL called_async )
+{
+    struct request *request = impl_from_request( param );
+    IInspectable *monitor;
+    HRESULT hr;
+    if (!called_async) return STATUS_PENDING;
+    if (FAILED(hr = monitor_create( request->id, request->interface_id, &monitor ))) return hr;
+    result->vt = VT_UNKNOWN;
+    result->punkVal = (IUnknown *)monitor;
+    return S_OK;
+}
+
+struct factory
+{
+    IActivationFactory IActivationFactory_iface;
+    IDisplayMonitorStatics IDisplayMonitorStatics_iface;
+    LONG ref;
+};
+static struct factory *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct factory, IActivationFactory_iface );
+}
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct factory *impl = impl_from_IActivationFactory( iface );
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+        *out = &impl->IActivationFactory_iface;
+    else if (IsEqualGUID( iid, &IID_IDisplayMonitorStatics )) *out = &impl->IDisplayMonitorStatics_iface;
+    else return E_NOINTERFACE;
+    IActivationFactory_AddRef( iface );
+    return S_OK;
+}
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface )
+{
+    return InterlockedIncrement( &impl_from_IActivationFactory(iface)->ref );
+}
+static ULONG WINAPI factory_Release( IActivationFactory *iface )
+{
+    return InterlockedDecrement( &impl_from_IActivationFactory(iface)->ref );
+}
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *count, IID **iids )
+{
+    return inspectable_iids( &IID_IDisplayMonitorStatics, count, iids );
+}
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *name )
+{
+    return class_name( name );
+}
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *level )
+{
+    if (!level) return E_POINTER;
+    *level = BaseTrust;
+    return S_OK;
+}
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **value )
+{
+    if (!value) return E_POINTER;
+    *value = NULL;
+    return E_ILLEGAL_METHOD_CALL;
+}
+static const IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface, factory_AddRef, factory_Release,
+    factory_GetIids, factory_GetRuntimeClassName, factory_GetTrustLevel, factory_ActivateInstance
+};
+
+DEFINE_IINSPECTABLE( statics, IDisplayMonitorStatics, struct factory, IActivationFactory_iface )
+
+static HRESULT WINAPI statics_GetDeviceSelector( IDisplayMonitorStatics *iface, HSTRING *value )
+{
+    static const WCHAR selector[] = L"System.Devices.InterfaceClassGuid:=\"{E6F07B5F-EE97-4A90-B076-33F57BF4EAA7}\"";
+    if (!value) return E_POINTER;
+    return WindowsCreateString( selector, ARRAY_SIZE(selector) - 1, value );
+}
+static HRESULT start_request( HSTRING id, BOOL interface_id, IAsyncOperation_DisplayMonitor **operation )
+{
+    struct request *request;
+    HRESULT hr;
+    UINT32 size;
+    BOOL embedded_null;
+    if (!operation) return E_POINTER;
+    *operation = NULL;
+    WindowsGetStringRawBuffer( id, &size );
+    if (!size || FAILED(WindowsStringHasEmbeddedNull( id, &embedded_null )) || embedded_null) return E_INVALIDARG;
+    if (!(request = calloc( 1, sizeof(*request) ))) return E_OUTOFMEMORY;
+    request->IUnknown_iface.lpVtbl = &request_vtbl;
+    request->ref = 1;
+    request->interface_id = interface_id;
+    if (FAILED(hr = WindowsDuplicateString( id, &request->id )))
+    {
+        IUnknown_Release( &request->IUnknown_iface );
+        return hr;
+    }
+    hr = async_operation_inspectable_create( &IID_IAsyncOperation_DisplayMonitor, NULL, &request->IUnknown_iface,
+                                            monitor_async, (IAsyncOperation_IInspectable **)operation );
+    IUnknown_Release( &request->IUnknown_iface );
+    return hr;
+}
+static HRESULT WINAPI statics_FromIdAsync( IDisplayMonitorStatics *iface, HSTRING id,
+                                         IAsyncOperation_DisplayMonitor **operation )
+{
+    return start_request( id, FALSE, operation );
+}
+static HRESULT WINAPI statics_FromInterfaceIdAsync( IDisplayMonitorStatics *iface, HSTRING id,
+                                                  IAsyncOperation_DisplayMonitor **operation )
+{
+    return start_request( id, TRUE, operation );
+}
+static const IDisplayMonitorStaticsVtbl statics_vtbl =
+{
+    statics_QueryInterface, statics_AddRef, statics_Release,
+    statics_GetIids, statics_GetRuntimeClassName, statics_GetTrustLevel,
+    statics_GetDeviceSelector, statics_FromIdAsync, statics_FromInterfaceIdAsync
+};
+static struct factory factory = {{&factory_vtbl}, {&statics_vtbl}, 1};
+
+HRESULT WINAPI DllGetActivationFactory( HSTRING name, IActivationFactory **value )
+{
+    UINT32 length;
+    const WCHAR *buffer = WindowsGetStringRawBuffer( name, &length );
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (length != wcslen(RuntimeClass_Windows_Devices_Display_DisplayMonitor) ||
+        memcmp( buffer, RuntimeClass_Windows_Devices_Display_DisplayMonitor, length * sizeof(WCHAR) )) return CLASS_E_CLASSNOTAVAILABLE;
+    return IActivationFactory_QueryInterface( &factory.IActivationFactory_iface, &IID_IActivationFactory, (void **)value );
+}
+HRESULT WINAPI DllGetClassObject( REFCLSID clsid, REFIID iid, void **value )
+{
+    if (!value) return E_POINTER;
+    *value = NULL;
+    return CLASS_E_CLASSNOTAVAILABLE;
+}
+HRESULT WINAPI DllCanUnloadNow(void)
+{
+    return S_FALSE;
+}
