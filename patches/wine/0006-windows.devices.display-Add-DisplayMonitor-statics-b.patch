+ */
+
+
+#include <stdarg.h>
+#define COBJMACROS
+#include "windows.h"
+#include "winstring.h"
+#include "winreg.h"
+#include "setupapi.h"
+#include "initguid.h"
+#include "devguid.h"
+#include "roapi.h"
+#define WIDL_using_Windows_Foundation
+#include "windows.foundation.h"
+#define WIDL_using_Windows_Graphics
+#include "windows.graphics.h"
+#define WIDL_using_Windows_Devices_Display
+#include "windows.devices.display.h"
+#include "wine/monitor.h"
+#include "wine/test.h"
+
+static const GUID monitor_interface = {0xe6f07b5f,0xee97,0x4a90,{0xb0,0x76,0x33,0xf5,0x7b,0xf4,0xea,0xa7}};
+static IDisplayMonitorStatics *statics;
+
+static HRESULT get_monitor( const WCHAR *id, BOOL interface_id, IDisplayMonitor **monitor )
+{
+    IAsyncOperation_DisplayMonitor *operation;
+    IAsyncInfo *info;
+    AsyncStatus status = Started;
+    HSTRING string;
+    HRESULT hr;
+    DWORD start;
+
+    *monitor = NULL;
+    WindowsCreateString( id, wcslen(id), &string );
+    hr = interface_id ? IDisplayMonitorStatics_FromInterfaceIdAsync( statics, string, &operation ) :
+                        IDisplayMonitorStatics_FromIdAsync( statics, string, &operation );
+    WindowsDeleteString( string ); /* The operation must own its input. */
+    if (FAILED(hr)) return hr;
+    hr = IAsyncOperation_DisplayMonitor_QueryInterface( operation, &IID_IAsyncInfo, (void **)&info );
+    ok( hr == S_OK, "AsyncInfo hr %#lx.\n", hr );
+    if (FAILED(hr)) goto done;
+    for (start = GetTickCount(); status == Started && GetTickCount() - start < 5000; Sleep(1))
+        IAsyncInfo_get_Status( info, &status );
+    ok( status != Started, "Operation did not finish.\n" );
+    hr = IAsyncOperation_DisplayMonitor_GetResults( operation, monitor );
+    IAsyncInfo_Close( info );
+    IAsyncInfo_Release( info );
+done:
+    IAsyncOperation_DisplayMonitor_Release( operation );
+    return hr;
+}
