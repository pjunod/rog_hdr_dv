+static void test_real_interfaces(void)
+{
+    SP_DEVICE_INTERFACE_DATA iface = {.cbSize = sizeof(iface)};
+    SP_DEVICE_INTERFACE_DETAIL_DATA_W *detail;
+    SP_DEVINFO_DATA device = {.cbSize = sizeof(device)};
+    HDEVINFO set;
+    DWORD size, index;
+    IDisplayMonitor *monitor, *again;
+    HSTRING id;
+    HRESULT hr;
+
+    set = SetupDiGetClassDevsW( &monitor_interface, NULL, NULL, DIGCF_DEVICEINTERFACE | DIGCF_PRESENT );
+    if (set == INVALID_HANDLE_VALUE) return;
+    for (index = 0; SetupDiEnumDeviceInterfaces( set, NULL, &monitor_interface, index, &iface ); index++)
+    {
+        SetupDiGetDeviceInterfaceDetailW( set, &iface, NULL, 0, &size, NULL );
+        detail = malloc( size );
+        detail->cbSize = sizeof(*detail);
+        if (!SetupDiGetDeviceInterfaceDetailW( set, &iface, detail, size, NULL, &device ))
+        {
+            free( detail );
+            continue;
+        }
+        hr = get_monitor( detail->DevicePath, TRUE, &monitor );
+        ok( hr == S_OK, "Real monitor interface resolution hr %#lx.\n", hr );
+        if (SUCCEEDED(hr))
+        {
+            hr = IDisplayMonitor_get_DeviceId( monitor, &id );
+            ok( hr == S_OK && WindowsGetStringLen(id), "DeviceId hr %#lx.\n", hr );
+            if (SUCCEEDED(hr))
+            {
+                hr = get_monitor( WindowsGetStringRawBuffer(id, NULL), FALSE, &again );
+                ok( hr == S_OK, "DeviceId roundtrip hr %#lx.\n", hr );
+                if (SUCCEEDED(hr)) IDisplayMonitor_Release( again );
+                WindowsDeleteString( id );
+            }
+            IDisplayMonitor_Release( monitor );
+        }
+        free( detail );
+    }
+    /* Zero interfaces is a genuine headless result. Never synthesize one. */
+    SetupDiDestroyDeviceInfoList( set );
+}
