+
+#define MONITOR_NATIVE_RESOLUTION 0x0001
+#define MONITOR_PHYSICAL_SIZE     0x0002
+#define MONITOR_NATIVE_PRIMARIES  0x0004
+#define MONITOR_MAX_LUMINANCE     0x0008
+#define MONITOR_MIN_LUMINANCE     0x0010
