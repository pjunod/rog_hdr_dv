+
+static void test_descriptor_cases( HKEY key, const WCHAR *id )
+{
+    static const struct
+    {
+        UINT32 offset;
+        UINT16 bits;
+        BOOL has_max, has_full, has_min, has_native;
+        FLOAT max;
+    } cases[] =
+    {
+        {26, 0x0000, TRUE, TRUE, TRUE, TRUE, 0},
+        {26, 0x0001, TRUE, TRUE, TRUE, TRUE, 1.0f / 16777216},
+        {26, 0x8000, FALSE, TRUE, TRUE, TRUE, 0},
+        {26, 0xbc00, FALSE, TRUE, TRUE, TRUE, 0},
+        {26, 0x7c00, FALSE, TRUE, TRUE, TRUE, 0},
+        {26, 0x7e00, FALSE, TRUE, TRUE, TRUE, 0},
+        {24, 0x7e00, TRUE, FALSE, TRUE, TRUE, 616},
+        {28, 0x8000, TRUE, TRUE, FALSE, TRUE, 616},
+        {1,  0x1d02, FALSE, FALSE, FALSE, FALSE, 0}, /* unknown revision, exact length */
+        {11, 0x3308, FALSE, FALSE, FALSE, TRUE, 0}, /* source guidance is not physical */
+        {2,  0xb81c, FALSE, FALSE, FALSE, FALSE, 0}, /* short block leaves malformed tail */
+    };
+    IDisplayMonitor *monitor;
+    SizeInt32 resolution;
+    BYTE edid[256], *copy;
+    UINT32 i, length;
+    FLOAT value;
+    HRESULT hr;
+
+    for (i = 0; i < ARRAY_SIZE(cases); i++)
+    {
+        make_edid( edid );
+        edid[133 + cases[i].offset] = cases[i].bits;
+        edid[134 + cases[i].offset] = cases[i].bits >> 8;
+        checksum( edid + 129, 37 );
+        checksum( edid + 128, 128 );
+        RegSetValueExW( key, L"EDID", 0, REG_BINARY, edid, sizeof(edid) );
+        hr = get_monitor( id, FALSE, &monitor );
+        ok( hr == S_OK, "Descriptor case %u creation hr %#lx.\n", i, hr );
+        if (FAILED(hr)) continue;
+        value = -1;
+        hr = IDisplayMonitor_get_MaxLuminanceInNits( monitor, &value );
+        ok( hr == (cases[i].has_max ? S_OK : HRESULT_FROM_WIN32(ERROR_NOT_SUPPORTED)),
+            "Case %u maximum hr %#lx.\n", i, hr );
+        if (cases[i].has_max) ok( value == cases[i].max, "Case %u maximum %f.\n", i, value );
+        hr = IDisplayMonitor_get_MaxAverageFullFrameLuminanceInNits( monitor, &value );
+        ok( hr == (cases[i].has_full ? S_OK : HRESULT_FROM_WIN32(ERROR_NOT_SUPPORTED)),
+            "Case %u full-frame hr %#lx.\n", i, hr );
+        if (cases[i].has_full) ok( value == 400, "Case %u full-frame %f.\n", i, value );
+        hr = IDisplayMonitor_get_MinLuminanceInNits( monitor, &value );
+        ok( hr == (cases[i].has_min ? S_OK : HRESULT_FROM_WIN32(ERROR_NOT_SUPPORTED)),
+            "Case %u minimum hr %#lx.\n", i, hr );
+        if (cases[i].has_min) ok( value == 0.25f, "Case %u minimum %f.\n", i, value );
+        hr = IDisplayMonitor_get_NativeResolutionInRawPixels( monitor, &resolution );
+        ok( hr == (cases[i].has_native ? S_OK : HRESULT_FROM_WIN32(ERROR_NOT_SUPPORTED)),
+            "Case %u native resolution hr %#lx.\n", i, hr );
+        IDisplayMonitor_Release( monitor );
+    }
+    /* A truncated extension list cannot claim native fields. Descriptor
+     * copies remain the actual bytes, not a replacement valid fixture. */
+    make_edid( edid );
+    RegSetValueExW( key, L"EDID", 0, REG_BINARY, edid, 128 );
+    hr = get_monitor( id, FALSE, &monitor );
+    ok( hr == S_OK, "Truncated descriptor object hr %#lx.\n", hr );
+    if (SUCCEEDED(hr))
+    {
+        hr = IDisplayMonitor_get_MaxLuminanceInNits( monitor, &value );
+        ok( hr == HRESULT_FROM_WIN32(ERROR_NOT_SUPPORTED), "Truncated native field hr %#lx.\n", hr );
+        hr = IDisplayMonitor_GetDescriptor( monitor, DisplayMonitorDescriptorKind_Edid, &length, &copy );
+        ok( hr == S_OK && length == 128 && !memcmp(copy, edid, 128), "Truncated descriptor was replaced.\n" );
+        IDisplayMonitor_Release( monitor );
+        if (SUCCEEDED(hr))
+        {
+            ok( !memcmp(copy, edid, 128), "Copy lifetime depends on object.\n" );
+            CoTaskMemFree( copy );
+        }
+    }
+}
