diff --git a/dlls/windows.devices.display/descriptor.c b/dlls/windows.devices.display/descriptor.c
index 8cf5559..f6f6260 100644
--- a/dlls/windows.devices.display/descriptor.c
+++ b/dlls/windows.devices.display/descriptor.c
@@ -36,6 +36,27 @@ static BOOL physical_luminance( const BYTE *data, FLOAT *value )
     return TRUE;
 }
 
+/* Decode one 12-bit chromaticity pair. CIE 1976 u'v' is converted with
+ * xy = (9u', 4v') / (6u' - 16v' + 12); domain checks stay integral so the
+ * exact x + y = 1 boundary is not subject to rounding. */
+static BOOL native_chromaticity( const BYTE *data, BOOL cie1976, Point *point )
+{
+    INT32 a = data[0] | ((data[1] & 15) << 8), b = (data[1] >> 4) | (data[2] << 4), denominator;
+
+    if (!cie1976)
+    {
+        if (!b || a + b > 4096) return FALSE;
+        point->X = a / 4096.0f;
+        point->Y = b / 4096.0f;
+        return TRUE;
+    }
+    denominator = 6 * a - 16 * b + 12 * 4096;
+    if (denominator <= 0 || !b || 9 * a + 4 * b > denominator) return FALSE;
+    point->X = 9.0f * a / denominator;
+    point->Y = 4.0f * b / denominator;
+    return TRUE;
+}
+
 static void parse_native_parameters( const BYTE *block, struct monitor_descriptor *descriptor )
 {
     UINT32 width, height, i;
@@ -65,17 +86,22 @@ static void parse_native_parameters( const BYTE *block, struct monitor_descripto
         descriptor->physical_size.Height = height * units / 25.4f;
         descriptor->flags |= MONITOR_PHYSICAL_SIZE;
     }
-    /* These are explicitly native coordinates. CIE 1976 conversion is not
-     * yet implemented; never expose its u/v as CIE 1931 x/y. */
-    if (!(block[11] & 0x40))
+    /* Native RGBW, as raw 12-bit counts over 4096. Feature bit 6 selects
+     * CIE 1976 u'v' instead of CIE 1931 xy; bit 5 is not understood, so the
+     * declaration is left unavailable rather than guessed. Every point must
+     * lie in the chromaticity domain or none is exposed. */
+    if (!(block[11] & 0x20))
     {
+        BOOL cie1976 = !!(block[11] & 0x40);
+        Point points[4];
+
         for (i = 0; i < 4; i++)
+            if (!native_chromaticity( block + 12 + 3 * i, cie1976, &points[i] )) break;
+        if (i == 4)
         {
-            const BYTE *point = block + 12 + 3 * i;
-            descriptor->primaries[i].X = (point[0] | ((point[1] & 15) << 8)) / 4096.0f;
-            descriptor->primaries[i].Y = ((point[1] >> 4) | (point[2] << 4)) / 4096.0f;
+            memcpy( descriptor->primaries, points, sizeof(points) );
+            descriptor->flags |= MONITOR_NATIVE_PRIMARIES;
         }
-        descriptor->flags |= MONITOR_NATIVE_PRIMARIES;
     }
     if (!(block[11] & 0x18))
     {
@@ -124,8 +150,14 @@ void monitor_descriptor_parse( const BYTE *edid, UINT32 size, struct monitor_des
         displayid_count++;
         for (offset = 4; offset < section_size - 1; offset += length)
         {
-            if (section_size - 1 - offset < 3) return;
             block = section + offset;
+            /* A short tail or an all-zero block header starts the filler,
+             * which must be zero up to the checksum. */
+            if (section_size - 1 - offset < 3 || !(block[0] | block[1] | block[2]))
+            {
+                for (; offset < section_size - 1; offset++) if (section[offset]) return;
+                break;
+            }
             length = block[2] + 3;
             if (length > section_size - 1 - offset) return;
             if (block[0] != 0x21) continue;
