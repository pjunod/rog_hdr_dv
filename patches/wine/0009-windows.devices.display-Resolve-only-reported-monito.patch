+/* The monitor's own product name from a validated EDID takes precedence over
+ * the generic description Wine writes for every monitor node. */
+static BOOL read_edid_name( struct monitor *impl )
+{
+    WCHAR buffer[13];
+    UINT32 i, j, length;
+
+    if (!(impl->descriptor.flags & MONITOR_EDID_VALID)) return FALSE;
+    for (i = 54; i <= 108; i += 18)
+    {
+        if (memcmp( impl->edid + i, "\0\0\0\xfc\0", 5 )) continue;
+        for (j = 0; j < 13 && impl->edid[i + 5 + j] >= 32 && impl->edid[i + 5 + j] <= 126; j++)
+            buffer[j] = impl->edid[i + 5 + j];
+        length = j;
+        while (length && buffer[length - 1] == ' ') length--;
+        if (!length) return FALSE;
+        return SUCCEEDED(WindowsCreateString( buffer, length, &impl->display_name ));
+    }
+    return FALSE;
+}
+
 static void read_name( HDEVINFO set, SP_DEVINFO_DATA *device, struct monitor *impl )
 {
     WCHAR buffer[512];
     DWORD type, size;
-    UINT32 i, j, length;
     BOOL found;
+
+    if (read_edid_name( impl )) return;
     found = SetupDiGetDeviceRegistryPropertyW( set, device, SPDRP_FRIENDLYNAME, &type,
                                               (BYTE *)buffer, sizeof(buffer), &size );
     if (!found) found = SetupDiGetDeviceRegistryPropertyW( set, device, SPDRP_DEVICEDESC, &type,
                                                          (BYTE *)buffer, sizeof(buffer), &size );
     if (found && type == REG_SZ && size >= sizeof(WCHAR) && size <= sizeof(buffer) &&
         !(size % sizeof(WCHAR)) && !buffer[size / sizeof(WCHAR) - 1])
-    {
         WindowsCreateString( buffer, wcslen(buffer), &impl->display_name );
-        return;
-    }
-    if (impl->edid_size < 128) return;
-    for (i = 54; i <= 108; i += 18)
+}
+
+/* A monitor is resolvable only while it has an enabled (linked) monitor
+ * interface; win32u links the interfaces of monitors it currently reports.
+ * Interfaces are not part of a device-only information set, so look them up
+ * in the monitor interface class and match the owning device instance. */
+static BOOL monitor_interface_active( const WCHAR *instance )
+{
+    SP_DEVICE_INTERFACE_DATA iface = {.cbSize = sizeof(iface)};
+    SP_DEVINFO_DATA device = {.cbSize = sizeof(device)};
+    WCHAR owner[MAX_DEVICE_ID_LEN];
+    BOOL active = FALSE;
+    HDEVINFO set;
+    DWORD index;
+
+    set = SetupDiGetClassDevsW( &monitor_interface, NULL, NULL, DIGCF_DEVICEINTERFACE );
+    if (set == INVALID_HANDLE_VALUE) return FALSE;
+    for (index = 0; !active && SetupDiEnumDeviceInterfaces( set, NULL, &monitor_interface, index, &iface ); index++)
     {
-        if (memcmp( impl->edid + i, "\0\0\0\xfc\0", 5 )) continue;
-        for (j = 0; j < 13 && impl->edid[i + 5 + j] >= 32 && impl->edid[i + 5 + j] <= 126; j++)
-            buffer[j] = impl->edid[i + 5 + j];
-        length = j;
-        while (length && buffer[length - 1] == ' ') length--;
-        WindowsCreateString( buffer, length, &impl->display_name );
-        return;
+        if (!(iface.Flags & SPINT_ACTIVE)) continue;
+        SetupDiGetDeviceInterfaceDetailW( set, &iface, NULL, 0, NULL, &device );
+        if (SetupDiGetDeviceInstanceIdW( set, &device, owner, ARRAY_SIZE(owner), NULL ) &&
+            !wcsicmp( owner, instance ))
+            active = TRUE;
     }
+    SetupDiDestroyDeviceInfoList( set );
+    return active;
+}
+
+/* win32u rebuilds the monitor device nodes under this session mutex when the
+ * display configuration changes. Holding it while resolving and reading a
+ * monitor yields a snapshot of one consistent configuration. */
+static HANDLE lock_display_devices(void)
+{
+    HANDLE mutex = CreateMutexW( NULL, FALSE, L"display_device_init" );
+
+    if (mutex) WaitForSingleObject( mutex, INFINITE );
+    return mutex;
+}
+
+static void unlock_display_devices( HANDLE mutex )
+{
+    if (!mutex) return;
+    ReleaseMutex( mutex );
+    CloseHandle( mutex );
 }
 
