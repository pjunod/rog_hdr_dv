index f6f6260..09b4ef1 100644
--- a/dlls/windows.devices.display/descriptor.c
+++ b/dlls/windows.devices.display/descriptor.c
@@ -114,6 +114,44 @@ static void parse_native_parameters( const BYTE *block, struct monitor_descripto
     }
 }
 
+/* EDID 1.4 colour characteristics (bytes 0x19-0x22) are the display's own
+ * chromaticities as 10-bit fractions of 1024. Like the native declaration,
+ * all four points must lie in the chromaticity domain or none is used. */
+static BOOL edid_chromaticities( const BYTE *edid, Point points[4] )
+{
+    static const struct { BYTE high, low, shift; } fields[8] =
+    {
+        {0x1b, 0x19, 6}, {0x1c, 0x19, 4}, {0x1d, 0x19, 2}, {0x1e, 0x19, 0},
+        {0x1f, 0x1a, 6}, {0x20, 0x1a, 4}, {0x21, 0x1a, 2}, {0x22, 0x1a, 0},
+    };
+    UINT32 value[8], i;
+
+    for (i = 0; i < 8; i++) value[i] = (edid[fields[i].high] << 2) | ((edid[fields[i].low] >> fields[i].shift) & 3);
+    for (i = 0; i < 4; i++)
+    {
+        if (!value[2 * i + 1] || value[2 * i] + value[2 * i + 1] > 1024) return FALSE;
+        points[i].X = value[2 * i] / 1024.0f;
+        points[i].Y = value[2 * i + 1] / 1024.0f;
+    }
+    return TRUE;
+}
+
+/* In EDID 1.4, feature bit 1 states that the first detailed timing is the
+ * native pixel format. Earlier revisions only mark it preferred. */
+static BOOL edid_native_resolution( const BYTE *edid, SizeInt32 *size )
+{
+    const BYTE *timing = edid + 54;
+    UINT32 width, height;
+
+    if (edid[19] < 4 || !(edid[24] & 2) || !(timing[0] | timing[1]) || (timing[17] & 0x80)) return FALSE;
+    width = timing[2] | ((timing[4] & 0xf0) << 4);
+    height = timing[5] | ((timing[7] & 0xf0) << 4);
+    if (!width || !height) return FALSE;
+    size->Width = width;
+    size->Height = height;
+    return TRUE;
+}
+
 void monitor_descriptor_parse( const BYTE *edid, UINT32 size, struct monitor_descriptor *descriptor )
 {
     static const BYTE header[] = {0, 255, 255, 255, 255, 255, 255, 0};
@@ -128,6 +166,9 @@ void monitor_descriptor_parse( const BYTE *edid, UINT32 size, struct monitor_des
     count = edid[126] + 1;
     if (count * 128 > size) return;
     for (i = 0; i < count; i++) if (!checksum_valid( edid + 128 * i, 128 )) return;
+    descriptor->flags |= MONITOR_EDID_VALID;
+    if (edid_chromaticities( edid, descriptor->primaries )) descriptor->flags |= MONITOR_NATIVE_PRIMARIES;
+    if (edid_native_resolution( edid, &descriptor->native_resolution )) descriptor->flags |= MONITOR_NATIVE_RESOLUTION;
 
     /* Non-zero base dimensions are physical centimetres. A zero dimension
      * can instead encode aspect ratio, so it is not a physical measurement. */
@@ -146,6 +187,9 @@ void monitor_descriptor_parse( const BYTE *edid, UINT32 size, struct monitor_des
         if (section[0] != 0x20 && section[0] != 0x21) return;
         section_size = section[1] + 5;
         if (section_size > 126 || !checksum_valid( section, section_size )) return;
+        /* Product primary use cases above 8 are reserved; such a section is
+         * not a DisplayID 2.x structure we can interpret. */
+        if (section[2] > 8) return;
         if (!first) first = section;
         displayid_count++;
         for (offset = 4; offset < section_size - 1; offset += length)
@@ -189,9 +233,11 @@ void monitor_descriptor_parse( const BYTE *edid, UINT32 size, struct monitor_des
      * value by arbitrary ordering. Other known physical facts remain usable. */
     if (!parameters || duplicate_parameters) return;
     parse_native_parameters( parameters, &native );
+    /* The DisplayID declaration takes precedence for each fact it provides;
+     * base EDID facts remain for the ones it leaves unavailable. */
     if (native.flags & MONITOR_PHYSICAL_SIZE) descriptor->physical_size = native.physical_size;
-    descriptor->native_resolution = native.native_resolution;
-    memcpy( descriptor->primaries, native.primaries, sizeof(native.primaries) );
+    if (native.flags & MONITOR_NATIVE_RESOLUTION) descriptor->native_resolution = native.native_resolution;
+    if (native.flags & MONITOR_NATIVE_PRIMARIES) memcpy( descriptor->primaries, native.primaries, sizeof(native.primaries) );
     descriptor->max_luminance = native.max_luminance;
     descriptor->min_luminance = native.min_luminance;
     descriptor->full_luminance = native.full_luminance;
