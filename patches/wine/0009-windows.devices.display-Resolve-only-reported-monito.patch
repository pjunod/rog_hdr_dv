+static void test_connector_properties( HDEVINFO set, SP_DEVINFO_DATA *device, HKEY key, const WCHAR *id )
+{
+    static const struct
+    {
+        struct wine_monitor_properties properties;
+        HRESULT connection_hr;
+        DisplayMonitorConnectionKind connection;
+        DisplayMonitorPhysicalConnectorKind connector;
+    } cases[] =
+    {
+        /* HD15 is numerically zero, so validity, not the value, makes it known. */
+        {{WINE_MONITOR_OUTPUT_TECHNOLOGY_VALID, WINE_MONITOR_ORIGIN_DISPLAY_SERVER, DISPLAYCONFIG_OUTPUT_TECHNOLOGY_HD15},
+         S_OK, DisplayMonitorConnectionKind_Wired, DisplayMonitorPhysicalConnectorKind_HD15},
+        {{0, WINE_MONITOR_ORIGIN_DISPLAY_SERVER, DISPLAYCONFIG_OUTPUT_TECHNOLOGY_HD15},
+         __HRESULT_FROM_WIN32(ERROR_NOT_SUPPORTED), 0, DisplayMonitorPhysicalConnectorKind_Unknown},
+        {{WINE_MONITOR_OUTPUT_TECHNOLOGY_VALID, WINE_MONITOR_ORIGIN_DISPLAY_SERVER, DISPLAYCONFIG_OUTPUT_TECHNOLOGY_DISPLAYPORT_EMBEDDED},
+         S_OK, DisplayMonitorConnectionKind_Internal, DisplayMonitorPhysicalConnectorKind_DisplayPort},
+        {{0, WINE_MONITOR_ORIGIN_VIRTUAL, 0},
+         S_OK, DisplayMonitorConnectionKind_Virtual, DisplayMonitorPhysicalConnectorKind_Unknown},
+    };
+    DisplayMonitorPhysicalConnectorKind connector;
+    DisplayMonitorConnectionKind connection;
+    DisplayMonitorUsageKind usage;
+    IDisplayMonitor *monitor;
+    BYTE edid[256];
+    UINT32 i;
+    HRESULT hr;
+
+    /* Product primary use 0 declares no usage kind. */
+    make_edid( edid );
+    edid[131] = 0;
+    checksum( edid + 129, 37 );
+    checksum( edid + 128, 128 );
+    RegSetValueExW( key, L"EDID", 0, REG_BINARY, edid, sizeof(edid) );
+    for (i = 0; i < ARRAY_SIZE(cases); i++)
+    {
+        SetupDiSetDevicePropertyW( set, device, &WINE_DEVPROPKEY_MONITOR_PROPERTIES, DEVPROP_TYPE_BINARY,
+                                   (BYTE *)&cases[i].properties, sizeof(cases[i].properties), 0 );
+        hr = get_monitor( id, FALSE, &monitor );
+        ok( hr == S_OK, "Connector case %u creation hr %#lx.\n", i, hr );
+        if (FAILED(hr)) continue;
+        connection = -1;
+        hr = IDisplayMonitor_get_ConnectionKind( monitor, &connection );
+        ok( hr == cases[i].connection_hr, "Connector case %u connection hr %#lx.\n", i, hr );
+        if (SUCCEEDED(hr)) ok( connection == cases[i].connection, "Connector case %u connection %d.\n", i, connection );
+        hr = IDisplayMonitor_get_PhysicalConnector( monitor, &connector );
+        ok( hr == S_OK && connector == cases[i].connector, "Connector case %u connector %d.\n", i, connector );
+        /* A virtual origin is not evidence of a usage kind. */
+        hr = IDisplayMonitor_get_UsageKind( monitor, &usage );
+        ok( hr == HRESULT_FROM_WIN32(ERROR_NOT_SUPPORTED), "Connector case %u usage hr %#lx.\n", i, hr );
+        IDisplayMonitor_Release( monitor );
+    }
+}
