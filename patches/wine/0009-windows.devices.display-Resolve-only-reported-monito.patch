 dlls/windows.devices.display/main.c           | 110 +++++++++---
 dlls/windows.devices.display/private.h        |   1 +
 .../tests/displaymonitor.c                    | 164 +++++++++++++++++-
 4 files changed, 300 insertions(+), 25 deletions(-)

