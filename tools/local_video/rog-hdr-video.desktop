[Desktop Entry]
Type=Application
Name=ROG HDR Video
Comment=Play local video with the packaged HDR and Dolby Vision renderer
Exec=/usr/lib/plurx-player/bin/mpv --no-config --vo=gpu-next --gpu-api=vulkan --hwdec=auto-safe --target-colorspace-hint=yes --ytdl=no -- %f
TryExec=/usr/lib/plurx-player/bin/mpv
Icon=video-x-generic
Terminal=false
Categories=AudioVideo;Player;Video;
StartupNotify=false
