 src/bitvec_impl/reads.rs                     | 150 +++++++++++++-----
 src/exp_golomb.rs                            |  27 ++++
 src/lib.rs                                   |   3 +
 4 files changed, 277 insertions(+), 56 deletions(-)
 create mode 100644 src/exp_golomb.rs

