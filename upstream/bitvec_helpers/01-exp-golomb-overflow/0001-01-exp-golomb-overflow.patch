diff --git a/src/exp_golomb.rs b/src/exp_golomb.rs
new file mode 100644
index 0000000..7ed5579
--- /dev/null
+++ b/src/exp_golomb.rs
@@ -0,0 +1,27 @@
+pub(crate) struct ExpGolomb {
+    pub leading_zeroes: u32,
+    pub suffix: u64,
+}
+
+impl ExpGolomb {
+    pub fn unsigned(self) -> Option<u64> {
+        match self.leading_zeroes {
+            64 if self.suffix == 0 => Some(u64::MAX),
+            0..=63 => ((1u64 << self.leading_zeroes) - 1).checked_add(self.suffix),
+            _ => None,
+        }
+    }
+
+    pub fn signed(self) -> Option<i64> {
+        if self.leading_zeroes == 64 {
+            return (self.suffix == 1).then_some(i64::MIN);
+        }
+        let code_num = self.unsigned()?;
+        let magnitude = i64::try_from(code_num / 2 + code_num % 2).ok()?;
+        Some(if code_num % 2 == 0 {
+            -magnitude
+        } else {
+            magnitude
+        })
+    }
+}
