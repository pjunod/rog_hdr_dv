+
+#[test]
+fn exp_golomb_codes_wider_than_64_bits_are_errors() {
+    let mut data = [0; 17];
+    data[8] = 0x40;
+    let mut reader = BsIoSliceReader::from_slice(&data);
+    assert_eq!(
+        reader.read_ue().unwrap_err().kind(),
+        io::ErrorKind::InvalidData
+    );
+}
+
+#[test]
+fn signed_exp_golomb_preserves_large_integer_magnitudes() {
+    // 63 leading zeros, marker, then 63 one bits: code_num = u64::MAX - 1.
+    let mut data = [0xff; 16];
+    data[..7].fill(0);
+    data[7] = 1;
+    let mut reader = BsIoSliceReader::from_slice(&data);
+    assert_eq!(reader.read_se().unwrap(), -i64::MAX);
+}
+
+#[test]
+fn largest_unsigned_exp_golomb_value_is_supported() {
+    let mut data = [0; 17];
+    data[8] = 0x80;
+    assert_eq!(
+        BsIoSliceReader::from_slice(&data).read_ue().unwrap(),
+        u64::MAX
+    );
+    data[16] = 0x80;
+    assert_eq!(
+        BsIoSliceReader::from_slice(&data)
+            .read_ue()
+            .unwrap_err()
+            .kind(),
+        io::ErrorKind::InvalidData
+    );
+}
+
+#[test]
+fn signed_exp_golomb_positive_overflow_is_an_error() {
+    let mut data = [0; 17];
+    data[8] = 0x80;
+    assert_eq!(
+        BsIoSliceReader::from_slice(&data)
+            .read_se()
+            .unwrap_err()
+            .kind(),
+        io::ErrorKind::InvalidData
+    );
+}
+
+#[test]
+fn signed_exp_golomb_endpoints_are_supported() {
+    let mut positive = [0xff; 16];
+    positive[..7].fill(0);
+    positive[7] = 1;
+    positive[15] &= !2;
+    assert_eq!(
+        BsIoSliceReader::from_slice(&positive).read_se().unwrap(),
+        i64::MAX
+    );
+
+    let mut negative = [0; 17];
+    negative[8] = 0x80;
+    negative[16] = 0x80;
+    assert_eq!(
+        BsIoSliceReader::from_slice(&negative).read_se().unwrap(),
+        i64::MIN
+    );
+    assert_eq!(
+        BsIoSliceReader::from_slice(&negative)
+            .read_ue()
+            .unwrap_err()
+            .kind(),
+        io::ErrorKind::InvalidData
+    );
+
+    negative[15] = 1;
+    negative[16] = 0;
+    assert_eq!(
+        BsIoSliceReader::from_slice(&negative)
+            .read_se()
+            .unwrap_err()
+            .kind(),
+        io::ErrorKind::InvalidData
+    );
+}
+
+#[test]
+fn exp_golomb_prefix_without_a_marker_is_bounded() {
+    let data = [0; 9];
+    let mut unsigned = BsIoSliceReader::from_slice(&data);
+    assert_eq!(
+        unsigned.read_ue().unwrap_err().kind(),
+        io::ErrorKind::InvalidData
+    );
+    assert_eq!(unsigned.position_in_bits().unwrap(), 65);
+    let mut signed = BsIoSliceReader::from_slice(&data);
+    assert_eq!(
+        signed.read_se().unwrap_err().kind(),
+        io::ErrorKind::InvalidData
+    );
+    assert_eq!(signed.position_in_bits().unwrap(), 65);
+}
