diff --git a/src/autogain_analyser.hpp b/src/autogain_analyser.hpp
new file mode 100644
index 000000000..9d0762600
--- /dev/null
+++ b/src/autogain_analyser.hpp
@@ -0,0 +1,163 @@
+/**
