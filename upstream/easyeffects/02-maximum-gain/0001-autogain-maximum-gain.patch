diff --git a/util/tests/autogain_gain.cpp b/util/tests/autogain_gain.cpp
new file mode 100644
index 000000000..b043341e2
--- /dev/null
+++ b/util/tests/autogain_gain.cpp
@@ -0,0 +1,123 @@
+#include "autogain_gain.hpp"
+#include <algorithm>
+#include <cmath>
+#include <iostream>
+#include <limits>
+
+namespace {
+
+auto near(double a, double b) -> bool {
+  return std::fabs(a - b) <= 1e-9 * std::max(1.0, std::fabs(b));
+}
+
+auto db_to_linear(double db) -> double {
+  return std::pow(10.0, db / 20.0);
+}
+
+// The smoothing as it was before the maximum gain existed
+auto reference_gain(double previous, double wanted, double peak, double attack, double release) -> double {
+  const double target_gain = std::min(wanted, 1.0 / peak);
+  const double alpha = (target_gain < previous) ? attack : release;
+
+  return (alpha * previous) + ((1.0 - alpha) * target_gain);
+}
+
+}  // namespace
+
+auto main() -> int {
+  constexpr double attack = 0.8;
+  constexpr double release = 0.95;
+
+  // Without a limit that matters the result is the one of the plugin before the setting was added
+
+  for (const double previous : {0.01, 0.5, 1.0, 3.0, 40.0}) {
+    for (const double wanted : {0.001, 0.4, 1.0, 2.0, 50.0}) {
+      for (const double peak : {0.001, 0.05, 0.5, 1.0}) {
+        const double got =
+            autogain::smooth_gain(previous, wanted, peak, autogain::maximum_gain_db_limit, attack, release);
+
+        if (!near(got, reference_gain(std::min(previous, db_to_linear(100.0)), wanted, peak, attack, release))) {
+          std::cerr << "The default limit must not change the gain\n";
+          return 1;
+        }
+      }
+    }
+  }
+
+  // The gain converges to the limit and does not go above it
+
+  double gain = 1.0;
+
+  for (int i = 0; i < 2000; ++i) {
+    gain = autogain::smooth_gain(gain, db_to_linear(20.0), 0.01, 6.0, attack, release);
+
+    if (gain > db_to_linear(6.0) * (1.0 + 1e-12)) {
+      std::cerr << "The gain must not go above the maximum gain\n";
+      return 1;
+    }
+  }
+
+  if (!near(gain, db_to_linear(6.0))) {
+    std::cerr << "The gain must reach the maximum gain when more is wanted\n";
+    return 1;
+  }
+
+  // The peak still decides when it is lower than the limit
+
+  gain = 1.0;
+
+  for (int i = 0; i < 2000; ++i) {
+    gain = autogain::smooth_gain(gain, db_to_linear(20.0), 0.5, 12.0, attack, release);
+  }
+
+  if (!near(gain, 2.0)) {
+    std::cerr << "The peak must still limit the gain\n";
+    return 1;
+  }
+
+  // Lowering the limit takes effect at once, without waiting for the smoothing
+
+  if (autogain::smooth_gain(db_to_linear(30.0), db_to_linear(30.0), 0.001, 6.0, attack, release) >
+      db_to_linear(6.0) * (1.0 + 1e-12)) {
+    std::cerr << "A gain above a new limit must be capped immediately\n";
+    return 1;
+  }
+
+  // Reducing the level is never limited, not even by a limit of zero
+
+  gain = 1.0;
+
+  for (int i = 0; i < 2000; ++i) {
+    gain = autogain::smooth_gain(gain, 0.1, 1.0, 0.0, attack, release);
+  }
+
+  if (!near(gain, 0.1)) {
+    std::cerr << "The gain must be able to reduce the level with a limit of zero\n";
+    return 1;
+  }
+
+  // The coefficient follows the direction of the change
+
+  if (!near(autogain::smooth_gain(1.0, 0.5, 1.0, 100.0, attack, release), (attack * 1.0) + ((1.0 - attack) * 0.5)) ||
+      !near(autogain::smooth_gain(1.0, 2.0, 0.1, 100.0, attack, release), (release * 1.0) + ((1.0 - release) * 2.0))) {
+    std::cerr << "The attack and the release coefficients must follow the direction of the gain\n";
+    return 1;
+  }
+
+  // A setting out of range or not a number never gives more gain than the largest one allowed
+
+  for (const double invalid : {-5.0, 1000.0, std::numeric_limits<double>::quiet_NaN(),
+                               std::numeric_limits<double>::infinity(), -std::numeric_limits<double>::infinity()}) {
+    const double limit = autogain::makeup_limit(invalid);
+
+    if (!(limit >= 1.0) || limit > db_to_linear(100.0) * (1.0 + 1e-12)) {
+      std::cerr << "An invalid limit must be clamped\n";
+      return 1;
+    }
+  }
+
+  if (autogain::makeup_limit(std::numeric_limits<double>::quiet_NaN()) != 1.0) {
+    std::cerr << "A limit that is not a number must give no gain\n";
+    return 1;
+  }
+}
