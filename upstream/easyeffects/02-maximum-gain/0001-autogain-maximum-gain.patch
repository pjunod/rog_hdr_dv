+
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <numbers>
+
+namespace autogain {
+
+// Largest value of the maximum gain setting. It is the largest difference between the target and the silence
+// threshold, so with this value the gain is limited only by the signal peak.
+inline constexpr double maximum_gain_db_limit = 100.0;
+
+// Linear gain that corresponds to the maximum gain setting. A value that is not a number gives no gain at all.
+inline auto makeup_limit(double maximum_gain_db) -> double {
+  if (!std::isfinite(maximum_gain_db)) {
+    return 1.0;
+  }
+
+  // 10^(db/20). The way below should be faster than using pow
+  return std::exp((std::clamp(maximum_gain_db, 0.0, maximum_gain_db_limit) / 20.0) * std::numbers::ln10);
+}
+
+/**
+ * Next value of the correction gain.
+ *
+ * previous: gain applied to the last block
+ * wanted: gain that brings the loudness to the target
+ * peak: largest sample peak of the last block (linear, greater than zero)
+ * maximum_gain_db: upper limit of the gain. Reducing the level is never limited.
+ * attack, release: coefficients of the leaky integrator
+ *
+ * The gain is smoothed with g[n]=α⋅g[n−1]+(1−α)⋅gtarget[n], using the attack coefficient when it is falling and the
+ * release coefficient when it is rising. It never goes above the limit, nor above what the peak allows without
+ * clipping. A gain that was above a limit that was just lowered does not decay from the old value, it is capped
+ * before the smoothing.
+ */
+inline auto smooth_gain(double previous,
+                        double wanted,
+                        double peak,
+                        double maximum_gain_db,
+                        double attack,
+                        double release) -> double {
+  const double limit = makeup_limit(maximum_gain_db);
+
+  previous = std::min(previous, limit);
+
+  const double target_gain = std::min({wanted, 1.0 / peak, limit});
+
+  const double alpha = (target_gain < previous) ? attack : release;
+
+  return (alpha * previous) + ((1.0 - alpha) * target_gain);
+}
+
+}  // namespace autogain
