From 1d75f6f99223cbc496861ede817ab2dc8eb53a76 Mon Sep 17 00:00:00 2001
From: Paul Junod <donujp@gmail.com>
Date: Tue, 27 Oct 2026 14:41:29 -0400
Subject: [PATCH] fix(config): reject duplicate node ids

`NodeConfig::is_valid()` checks that `node_id` is part of `nodes`, but
not that the ids in `nodes` are unique. Several places look a node up by
id and take the first match (`init.rs`, `start.rs`), while others use
`nodes.len()` as the cluster size (the quorum in
`should_node_1_skip_init()`), so a duplicated id silently gives an
inconsistent view of the cluster.

Node ids are durable Raft identities and don't have to be contiguous
(`1, 3` is valid after a node with id 2 was removed), so compare ids
instead of the length. Fail with a config error that names the id.
---
 hiqlite/src/config.rs | 32 ++++++++++++++++++++++++++++++++
 1 file changed, 32 insertions(+)

diff --git a/hiqlite/src/config.rs b/hiqlite/src/config.rs
index b3751b4..9fbb7ed 100644
--- a/hiqlite/src/config.rs
+++ b/hiqlite/src/config.rs
@@ -473,6 +473,20 @@ impl NodeConfig {
             ));
         }
 
+        // Node ids are durable Raft identities and are looked up by value, so each one may only
+        // appear once. They do not need to be contiguous.
+        for (index, node) in self.nodes.iter().enumerate() {
+            if self.nodes[..index].iter().any(|other| other.id == node.id) {
+                return Err(Error::Config(
+                    format!(
+                        "'nodes' contains duplicate node id {} (entry {index})",
+                        node.id
+                    )
+                    .into(),
+                ));
+            }
+        }
+
         if self.secret_raft.len() < 16 || self.secret_api.len() < 16 {
             return Err(Error::Config(
                 "'secret_raft' and 'secret_api' should be at least 16 characters long".into(),
@@ -598,4 +612,22 @@ mod tests {
         assert_eq!(c.secret_api, "SuperSecureSecret1337");
         assert!(!c.learner_only);
     }
+
+    #[test]
+    fn duplicate_node_ids_are_rejected() {
+        let node = |id: u64, port: u16| Node {
+            id,
+            addr_raft: format!("localhost:{port}"),
+            addr_api: format!("localhost:{}", port + 1),
+        };
+        let mut c = NodeConfig::from_env_file("hiqlite.env");
+
+        // ids need not be contiguous: 1 and 3 is a valid roster
+        c.nodes = vec![node(1, 8100), node(3, 8300)];
+        assert!(c.is_valid().is_ok());
+
+        c.nodes = vec![node(1, 8100), node(3, 8300), node(3, 8500)];
+        let err = c.is_valid().unwrap_err().to_string();
+        assert!(err.contains("duplicate node id 3"), "{err}");
+    }
 }
