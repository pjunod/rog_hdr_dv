From 3917ff7bbfe7018879dba2e70b596c15b9e3ae72 Mon Sep 17 00:00:00 2001
From: Paul Junod <donujp@gmail.com>
Date: Wed, 28 Oct 2026 10:06:44 -0400
Subject: [PATCH] Fix menu property IDs after a menu refresh

GetGroupProperties with an empty ID list returned array indices, while
layouts, individual properties and event dispatch use the current item-
ID offset. Translate those indices through index2id so clients can use
the returned IDs after a menu refresh. The root ID remains zero.

The new offset regression fails before this change. All 38 library tests
pass with the normal GTK development dependency and a session bus.
---
 CHANGELOG.md   |  5 +++++
 src/service.rs | 17 +++++++++++++++--
 2 files changed, 20 insertions(+), 2 deletions(-)

diff --git a/CHANGELOG.md b/CHANGELOG.md
index b114dde..9d47444 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -1,3 +1,8 @@
+# Unreleased
+
+## Fixed
+- Return current menu IDs from `GetGroupProperties` after a menu refresh.
+
 # 0.3.7 (2026-10-20)
 
 ## Added
diff --git a/src/service.rs b/src/service.rs
index e15bfc5..8947096 100644
--- a/src/service.rs
+++ b/src/service.rs
@@ -226,7 +226,7 @@ impl<T: Tray> Service<T> {
         }
     }
 
-    /// If `may_open_window`, will consume a XDG Activation Token. 
+    /// If `may_open_window`, will consume a XDG Activation Token.
     /// This function should only be called once in one event
     pub async fn lock_state<F, R>(&self, may_open_window: bool, f: F) -> R
     where
@@ -496,7 +496,7 @@ impl<T: Tray> State<T> {
             .enumerate()
             .map(|(i, (item, children))| {
                 (
-                    i as i32,
+                    self.index2id(i),
                     item.to_dbus_map(property_filter, !children.is_empty()),
                 )
             })
@@ -808,6 +808,19 @@ mod tests {
         assert_eq!(service_guard.index2id(3), 3 + service_guard.item_id_offset);
     }
 
+    #[test]
+    fn test_get_all_item_ids_follow_item_id_offset() {
+        let service = Service::new(TestTray).state;
+        let mut state = blocking_lock_service(&service);
+        state.item_id_offset = state.flattened_menu.len() as i32;
+        let items = state.get_all_item(&[]);
+        assert_eq!(items[0].0, 0);
+        for (index, (id, _)) in items.iter().enumerate() {
+            assert_eq!(state.id2index(*id), Some(index));
+            assert!(state.get_menu_item(*id, &[]).is_some());
+        }
+    }
+
     #[test]
     fn test_id2index_mapping() {
         let service = Service::new(TestTray).state;
