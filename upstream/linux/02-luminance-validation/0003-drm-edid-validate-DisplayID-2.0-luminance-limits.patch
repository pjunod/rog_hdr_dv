From 10a53f72cc0b3d820b95bc690cc9a63056a751ea Mon Sep 17 00:00:00 2001
From: Paul Junod <donujp@gmail.com>
Date: Tue, 27 Oct 2026 13:45:16 -0400
Subject: [PATCH 1/2] drm/edid: validate DisplayID 2.0 luminance limits

The previous patch fills display_info.luminance_range from the DisplayID
2.0 Display Parameters data block, but it only checks that the decoded
maximum is non-zero and above the decoded minimum. That accepts values
that are not usable physical limits, and it cannot tell a valid minimum
that rounds down to 0 nits from a missing one. Tighten it:

 - Only use a block that is exactly 29 bytes long, has revision 0 or 1
   (bit 7 of the revision byte is the image size unit flag and is
   ignored), and whose Luminance Information field says the values are
   minimum guaranteed values, not guidance for the source device or a
   reserved encoding. The device technology is still parsed for every
   block that is long enough.

 - Decode the IEEE 754 binary16 values with integers and report
   validity separately from the rounded result, so that a small but
   valid minimum which rounds to 0 nits is accepted. Reject negative
   encodings (which includes -0), infinities and NaNs.

 - Require the minimum to be below the full coverage maximum both as
   encoded and after rounding to whole nits. The 10 percent coverage
   peak is not a full-frame maximum and is not used.

Luminance derived from CTA HDR static metadata still takes precedence,
and no HDR static metadata is fabricated from the DisplayID values.

This builds on a series that has not been merged, so there is no Fixes:
tag. The next patch adds KUnit tests that run EDIDs through
drm_edid_connector_update().

The validation code and this changelog were drafted with AI coding
assistants (OpenAI Codex, then reviewed and reworked with Anthropic
Claude through Claude Code). The field layout was compared against the DisplayID 2.0 block as decoded
by edid-decode during preparation. Human review remains with the submitter.

---
 drivers/gpu/drm/drm_edid.c | 53 ++++++++++++++++++++++++--------------
 1 file changed, 33 insertions(+), 20 deletions(-)

diff --git a/drivers/gpu/drm/drm_edid.c b/drivers/gpu/drm/drm_edid.c
index 6b2d1b574..821dcd8f3 100644
--- a/drivers/gpu/drm/drm_edid.c
+++ b/drivers/gpu/drm/drm_edid.c
@@ -6865,29 +6865,32 @@ static void drm_displayid_process_base_section_header(struct drm_connector *conn
 		info->non_desktop = true;
 }
 
-/*
- * Convert an IEEE 754 binary16 value, the encoding DisplayID 2.0 uses for
- * luminance, to nits rounded to nearest. Negative, zero, subnormal, infinite
- * and NaN all report 0, meaning "no usable value".
- */
-static u32 displayid_binary16_to_nits(u16 val)
+/* Finite nonnegative binary16, rounded to whole nits (ties upward). */
+static bool displayid_binary16_to_nits(u16 val, u32 *nits)
 {
-	int exp = (val >> 10) & 0x1f;
-	u32 mant = (val & 0x3ff) | 0x400;
+	unsigned int exp = (val >> 10) & 0x1f;
+	u32 mant = val & 0x3ff;
 	int shift;
 
-	if (val & 0x8000 || exp == 0 || exp == 0x1f)
-		return 0;
+	/* The sign bit also rejects the DisplayID "do not use" sentinel. */
+	if (val & BIT(15) || exp == 0x1f)
+		return false;
 
-	shift = exp - 25;
-	if (shift >= 0)
-		return shift > 15 ? 0 : mant << shift;
+	if (!exp) {
+		*nits = 0;
+		return true;
+	}
 
-	shift = -shift;
-	if (shift > 11)
-		return 0;
+	mant |= BIT(10);
+	shift = (int)exp - 25;
+	if (shift >= 0)
+		*nits = mant << shift;
+	else if (shift < -11)
+		*nits = 0;
+	else
+		*nits = (mant + BIT(-shift - 1)) >> -shift;
 
-	return (mant + (1 << (shift - 1))) >> shift;
+	return true;
 }
 
 static void
@@ -6898,6 +6901,7 @@ drm_displayid_parse_display_params(struct drm_connector *connector,
 	const struct displayid_display_params_block *params =
 		(const struct displayid_display_params_block *)block;
 	u32 max_luminance, min_luminance;
+	u16 max, min;
 	u8 tech;
 
 	if (block->num_bytes < sizeof(*params) - sizeof(params->base)) {
@@ -6936,10 +6940,19 @@ drm_displayid_parse_display_params(struct drm_connector *connector,
 	if (info->luminance_range.max_luminance)
 		return;
 
-	max_luminance = displayid_binary16_to_nits(le16_to_cpu(params->max_luminance_full));
-	min_luminance = displayid_binary16_to_nits(le16_to_cpu(params->min_luminance));
+	/* Only known minimum-guaranteed physical limits are usable. */
+	if (block->num_bytes != sizeof(*params) - sizeof(params->base) ||
+	    (block->rev & ~BIT(7)) > 1 ||
+	    (params->features & GENMASK(4, 3)))
+		return;
+
+	max = le16_to_cpu(params->max_luminance_full);
+	min = le16_to_cpu(params->min_luminance);
 
-	if (!max_luminance || min_luminance >= max_luminance)
+	/* Nonnegative finite binary16 encodings have numerical sort order. */
+	if (!displayid_binary16_to_nits(max, &max_luminance) ||
+	    !displayid_binary16_to_nits(min, &min_luminance) ||
+	    min >= max || !max_luminance || min_luminance >= max_luminance)
 		return;
 
 	info->luminance_range.max_luminance = max_luminance;
-- 
