 src/backends/edid-parse.c                   |  88 +++++++++++++
 src/backends/edid.h                         |  13 ++
 src/backends/meta-color-device.c            | 129 +++++++++++++++++++-
 src/backends/meta-color-device.h            |  17 +++
 src/wayland/meta-wayland-color-management.c |  83 +++++++++----
 6 files changed, 310 insertions(+), 31 deletions(-)

