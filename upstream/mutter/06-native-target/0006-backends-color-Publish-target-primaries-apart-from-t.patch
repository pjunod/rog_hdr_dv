+typedef struct
+{
+  int64_t x, y, z;
+} TargetPoint;
+
+static int64_t
+target_orientation (const TargetPoint *a,
+                    const TargetPoint *b,
+                    const TargetPoint *c)
+{
+  return a->x * (b->y * c->z - b->z * c->y) -
+         a->y * (b->x * c->z - b->z * c->x) +
+         a->z * (b->x * c->y - b->y * c->x);
+}
+
+static gboolean
+target_geometry_valid (const TargetPoint points[4])
+{
+  int64_t orientation = target_orientation (&points[0], &points[1], &points[2]);
+  unsigned int i;
+
+  if (!orientation)
+    return FALSE;
+  for (i = 0; i < 3; i++)
+    {
+      int64_t side = target_orientation (&points[i], &points[(i + 1) % 3], &points[3]);
+
+      if (!side || (side > 0) != (orientation > 0))
+        return FALSE;
+    }
+  return TRUE;
+}
+
+void
+meta_color_target_primaries_init (MetaColorTargetPrimaries *target,
+                                  const MetaEdidInfo       *edid_info,
+                                  gboolean                  native_hdr,
+                                  const ClutterPrimaries   *encoding)
+{
+  const float fallback[8] = {
+    encoding->r_x, encoding->r_y, encoding->g_x, encoding->g_y,
+    encoding->b_x, encoding->b_y, encoding->w_x, encoding->w_y,
+  };
+  const struct di_displayid2_native_chromaticities *native;
+  TargetPoint points[4], published[4];
+  MetaColorTargetPrimaries physical = { .source = META_COLOR_TARGET_FIRMWARE_DECLARED };
+  unsigned int i;
+
+  *target = (MetaColorTargetPrimaries) { .source = META_COLOR_TARGET_ENCODING_FALLBACK };
+  for (i = 0; i < 8; i++)
+    target->coordinates[i] = (int32_t) (fallback[i] * 1000000);
+
+  if (!native_hdr || !edid_info ||
+      edid_info->native_chromaticities_status != META_NATIVE_CHROMATICITIES_FIRMWARE_DECLARED)
+    return;
+  native = &edid_info->native_chromaticities;
+  for (i = 0; i < 4; i++)
+    {
+      const struct di_displayid2_chromaticity_point *point =
+        i < 3 ? &native->primaries[i] : &native->white_point;
+
+      if (!point->valid || point->a >= 4096 || point->b >= 4096)
+        return;
+      switch (native->coordinates)
+        {
+        case DI_DISPLAYID2_CHROMATICITY_CIE1931:
+          points[i] = (TargetPoint) { point->a, point->b, 4096 };
+          break;
+        case DI_DISPLAYID2_CHROMATICITY_CIE1976:
+          /* Homogeneous inverse u'v' -> xy, retaining exact raw geometry. */
+          points[i] = (TargetPoint) { 9 * point->a, 4 * point->b,
+                                      6 * point->a - 16 * point->b + 12 * 4096 };
+          break;
+        default:
+          return;
+        }
+      if (points[i].z <= 0 || points[i].y <= 0 ||
+          points[i].x + points[i].y > points[i].z)
+        return;
+      physical.coordinates[2 * i] = (int32_t) ((points[i].x * 1000000) / points[i].z);
+      physical.coordinates[2 * i + 1] = (int32_t) ((points[i].y * 1000000) / points[i].z);
+      published[i] = (TargetPoint) { physical.coordinates[2 * i],
+                                     physical.coordinates[2 * i + 1], 1 };
+    }
+
+  /* 12-bit homogeneous and 1e6-scaled determinants fit int64. A complete
+   * RGBW target must remain usable after the protocol's quantization. */
+  if (target_geometry_valid (points) && target_geometry_valid (published))
+    *target = physical;
+}
+
+static gboolean
+target_primaries_equal (const MetaColorTargetPrimaries *a,
+                        const MetaColorTargetPrimaries *b)
+{
+  unsigned int i;
+
+  if (a->source != b->source)
+    return FALSE;
+  for (i = 0; i < 8; i++)
+    if (a->coordinates[i] != b->coordinates[i])
+      return FALSE;
+  return TRUE;
+}
