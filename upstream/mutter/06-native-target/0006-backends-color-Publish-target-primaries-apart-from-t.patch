diff --git a/src/backends/edid-parse.c b/src/backends/edid-parse.c
index 07e071309..f4ee9d80a 100644
--- a/src/backends/edid-parse.c
+++ b/src/backends/edid-parse.c
@@ -203,6 +203,93 @@ read_native_luminance (MetaEdidInfo         *info,
     info->native_luminance_status = META_NATIVE_LUMINANCE_FIRMWARE_DECLARED;
 }
 
+static gboolean
+chromaticities_equal (const struct di_displayid2_native_chromaticities *a,
+                      const struct di_displayid2_native_chromaticities *b)
+{
+  unsigned int i;
+
+  if (a->revision != b->revision || a->coordinates != b->coordinates ||
+      a->white_point.a != b->white_point.a ||
+      a->white_point.b != b->white_point.b ||
+      a->white_point.valid != b->white_point.valid)
+    return FALSE;
+
+  for (i = 0; i < 3; i++)
+    if (a->primaries[i].a != b->primaries[i].a ||
+        a->primaries[i].b != b->primaries[i].b ||
+        a->primaries[i].valid != b->primaries[i].valid)
+      return FALSE;
+  return TRUE;
+}
+
+static void
+read_native_chromaticities (MetaEdidInfo         *info,
+                            const struct di_info *di_info)
+{
+  const struct di_edid_ext *const *extensions;
+  gboolean found = FALSE, unsupported = FALSE, conflict = FALSE;
+  unsigned int i;
+
+  if (di_edid_has_extension_failures (di_info_get_edid (di_info)))
+    {
+      info->native_chromaticities_status = META_NATIVE_CHROMATICITIES_INVALID;
+      return;
+    }
+
+  /* Classify every Display Parameters block before deciding, so the result
+   * does not depend on block order. A block that cannot be interpreted means
+   * no declaration can be trusted; two recognized but different
+   * declarations (including different revisions) are a conflict. */
+  extensions = di_edid_get_extensions (di_info_get_edid (di_info));
+  for (; *extensions; extensions++)
+    {
+      const struct di_displayid2 *displayid = di_edid_ext_get_displayid2 (*extensions);
+      const struct di_displayid2_data_block *const *blocks;
+
+      if (!displayid)
+        continue;
+      blocks = di_displayid2_get_data_blocks (displayid);
+      for (; *blocks; blocks++)
+        {
+          const struct di_displayid2_native_chromaticities *native;
+
+          if (di_displayid2_data_block_get_tag (*blocks) !=
+              DI_DISPLAYID2_DATA_BLOCK_DISPLAY_PARAMS)
+            continue;
+
+          native = di_displayid2_data_block_get_native_chromaticities (*blocks);
+          if (!native)
+            unsupported = TRUE;
+          else if (!found)
+            {
+              info->native_chromaticities = *native;
+              found = TRUE;
+            }
+          else if (!chromaticities_equal (&info->native_chromaticities, native))
+            conflict = TRUE;
+        }
+    }
+
+  if (unsupported || conflict)
+    {
+      if (unsupported)
+        info->native_chromaticities_status = META_NATIVE_CHROMATICITIES_UNSUPPORTED;
+      else
+        info->native_chromaticities_status = META_NATIVE_CHROMATICITIES_CONFLICT;
+      memset (&info->native_chromaticities, 0, sizeof (info->native_chromaticities));
+      return;
+    }
+  if (!found)
+    return;
+  info->native_chromaticities_status = META_NATIVE_CHROMATICITIES_INVALID;
+  for (i = 0; i < 3; i++)
+    if (!info->native_chromaticities.primaries[i].valid)
+      return;
+  if (info->native_chromaticities.white_point.valid)
+    info->native_chromaticities_status = META_NATIVE_CHROMATICITIES_FIRMWARE_DECLARED;
+}
+
 MetaEdidInfo *
 meta_edid_info_new_parse (const uint8_t *edid,
                           size_t         size)
@@ -286,6 +373,7 @@ meta_edid_info_new_parse (const uint8_t *edid,
 
   info->native_rgb_bt2020_pq = has_native_rgb_bt2020_pq (di_info);
   read_native_luminance (info, di_info);
+  read_native_chromaticities (info, di_info);
 
   di_info_destroy (di_info);
   return g_steal_pointer (&info);
