+/*
+ * Every producer of a parametric color state from external input validates its
+ * colorimetry with clutter_colorimetry_get_linear_bt2020_matrices(), the same
+ * function used here, so reaching this is a bug in the producer. There is no
+ * matrix that would represent the requested space, so the transform is left
+ * incomplete and the producer is named loudly instead of substituting one.
+ */
+static void
+warn_unusable_colorimetry (ClutterColorStateParams *params,
+                           const GError            *error)
+{
+  static GQuark warned_quark = 0;
+  g_autofree char *description = NULL;
+
+  /* Transforms are rebuilt for every pairing; name the state only once. */
+  if (G_UNLIKELY (!warned_quark))
+    warned_quark = g_quark_from_static_string ("-clutter-unusable-colorimetry-warned");
+  if (g_object_get_qdata (G_OBJECT (params), warned_quark))
+    return;
+  g_object_set_qdata (G_OBJECT (params), warned_quark, GINT_TO_POINTER (TRUE));
+
+  description = clutter_color_state_to_string (CLUTTER_COLOR_STATE (params));
+  g_warning ("Color state %s has no usable linear BT.2020 conversion: %s",
+             description, error->message);
+}
+
 static void
 add_params_to_linear_bt2020_ops (ClutterColorPipeline    *pipeline,
                                  ClutterColorStateParams *params)
 {
+  const ClutterColorimetry *colorimetry;
+  g_autoptr (GError) error = NULL;
   const ClutterEOTF *eotf;
   graphene_matrix_t to_linear_bt2020_stack;
   graphene_matrix_t *to_linear_bt2020;
@@ -314,7 +227,15 @@ add_params_to_linear_bt2020_ops (ClutterColorPipeline    *pipeline,
   }
 
   /* 2. Transform to linear BT.2020 D65 (via XYZ) */
-  get_params_to_linear_bt2020 (params, &to_linear_bt2020_stack);
+  colorimetry = clutter_color_state_params_get_colorimetry (params);
+  if (!clutter_colorimetry_get_linear_bt2020_matrices (colorimetry,
+                                                       &to_linear_bt2020_stack,
+                                                       NULL,
+                                                       &error))
+    {
+      warn_unusable_colorimetry (params, error);
+      return;
+    }
 
   to_linear_bt2020 = graphene_matrix_alloc ();
   graphene_matrix_init_from_matrix (to_linear_bt2020,
@@ -327,6 +248,8 @@ static void
 add_params_from_linear_bt2020_ops (ClutterColorPipeline    *pipeline,
                                    ClutterColorStateParams *params)
 {
+  const ClutterColorimetry *colorimetry;
+  g_autoptr (GError) error = NULL;
   const ClutterEOTF *eotf;
   graphene_matrix_t from_linear_bt2020_stack;
   graphene_matrix_t *from_linear_bt2020;
@@ -334,7 +257,16 @@ add_params_from_linear_bt2020_ops (ClutterColorPipeline    *pipeline,
   eotf = clutter_color_state_params_get_eotf (params);
 
   /* 1. Transform from linear BT.2020 D65 to target colorspace (via XYZ) */
-  get_params_from_linear_bt2020 (params, &from_linear_bt2020_stack);
+  colorimetry = clutter_color_state_params_get_colorimetry (params);
+  if (!clutter_colorimetry_get_linear_bt2020_matrices (colorimetry,
+                                                       NULL,
+                                                       &from_linear_bt2020_stack,
+                                                       &error))
+    {
+      warn_unusable_colorimetry (params, error);
+      return;
+    }
+
   from_linear_bt2020 = graphene_matrix_alloc ();
   graphene_matrix_init_from_matrix (from_linear_bt2020,
                                     &from_linear_bt2020_stack);
