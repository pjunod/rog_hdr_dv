+static void
+assert_hlg_color_state (MetaWindow        *window,
+                        ClutterColorspace  colorspace,
+                        float              min_lum,
+                        float              max_lum,
+                        float              ref_lum)
+{
+  ClutterColorStateParams *params;
+  const ClutterColorimetry *colorimetry;
+  const ClutterEOTF *eotf;
+  const ClutterLuminance *lum;
+
+  params = CLUTTER_COLOR_STATE_PARAMS (get_window_color_state (window));
+  colorimetry = clutter_color_state_params_get_colorimetry (params);
+  g_assert_cmpuint (colorimetry->type, ==, CLUTTER_COLORIMETRY_TYPE_COLORSPACE);
+  g_assert_cmpuint (colorimetry->colorspace, ==, colorspace);
+  eotf = clutter_color_state_params_get_eotf (params);
+  g_assert_cmpuint (eotf->type, ==, CLUTTER_EOTF_TYPE_NAMED);
+  g_assert_cmpuint (eotf->tf_name, ==, CLUTTER_TRANSFER_FUNCTION_HLG);
+  lum = clutter_color_state_params_get_luminance (params);
+  g_assert_cmpfloat_with_epsilon (lum->min, min_lum, TEST_COLOR_EPSILON);
+  g_assert_cmpfloat_with_epsilon (lum->max, max_lum, TEST_COLOR_EPSILON);
+  g_assert_cmpfloat_with_epsilon (lum->ref, ref_lum, TEST_COLOR_EPSILON);
+  g_assert_cmpfloat_with_epsilon (lum->mastering_max, max_lum, TEST_COLOR_EPSILON);
+}
+
+static void
+hlg_creation (void)
+{
+  MetaWaylandTestClient *client;
+  MetaWindow *window;
+
+  /* The client also checks that HLG is advertised. */
+  client = meta_wayland_test_client_new_with_args (test_context,
+                                                   "color-management",
+                                                   "hlg",
+                                                   NULL);
+  window = meta_wait_for_client_window (test_context, "color-management-hlg");
+
+  /* Without set_luminances, the HLG defaults of the protocol. */
+  wait_for_sync_point (0);
+  assert_hlg_color_state (window, CLUTTER_COLORSPACE_BT2020,
+                          0.005f, 1000.0f, 203.0f);
+  emit_sync_event (0);
+
+  /* A declared maximum is the nominal peak; HLG does not replace it. */
+  wait_for_sync_point (1);
+  assert_hlg_color_state (window, CLUTTER_COLORSPACE_SRGB,
+                          0.01f, 400.0f, 100.0f);
+  emit_sync_event (1);
+
+  meta_wayland_test_client_finish (client);
+}
