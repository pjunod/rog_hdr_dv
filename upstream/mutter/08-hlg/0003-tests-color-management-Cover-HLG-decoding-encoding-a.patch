+typedef struct
+{
+  uint32_t features;
+  uint64_t transfer_functions;
+  gboolean done;
+} ManagerSupport;
+
+static void
+support_intent (void                       *data,
+                struct wp_color_manager_v1 *manager,
+                uint32_t                    intent)
+{
+}
+
+static void
+support_feature (void                       *data,
+                 struct wp_color_manager_v1 *manager,
+                 uint32_t                    feature)
+{
+  ManagerSupport *support = data;
+
+  g_assert_cmpuint (feature, <, 32);
+  support->features |= 1u << feature;
+}
+
+static void
+support_tf_named (void                       *data,
+                  struct wp_color_manager_v1 *manager,
+                  uint32_t                    tf)
+{
+  ManagerSupport *support = data;
+
+  g_assert_cmpuint (tf, <, 64);
+  support->transfer_functions |= G_GUINT64_CONSTANT (1) << tf;
+}
+
+static void
+support_primaries_named (void                       *data,
+                         struct wp_color_manager_v1 *manager,
+                         uint32_t                    primaries)
+{
+}
+
+static void
+support_done (void                       *data,
+              struct wp_color_manager_v1 *manager)
+{
+  ManagerSupport *support = data;
+
+  support->done = TRUE;
+}
+
+static const struct wp_color_manager_v1_listener support_listener = {
+  .supported_intent = support_intent,
+  .supported_feature = support_feature,
+  .supported_tf_named = support_tf_named,
+  .supported_primaries_named = support_primaries_named,
+  .done = support_done,
+};
+
+static void
+support_registry_global (void               *data,
+                         struct wl_registry *registry,
+                         uint32_t            name,
+                         const char         *interface,
+                         uint32_t            version)
+{
+  struct wp_color_manager_v1 **manager = data;
+
+  if (strcmp (interface, wp_color_manager_v1_interface.name) == 0)
+    *manager = wl_registry_bind (registry, name, &wp_color_manager_v1_interface, 1);
+}
+
+static void
+support_registry_remove (void               *data,
+                         struct wl_registry *registry,
+                         uint32_t            name)
+{
+}
+
+static const struct wl_registry_listener support_registry_listener = {
+  .global = support_registry_global,
+  .global_remove = support_registry_remove,
+};
+
+/* Binds a second color manager to observe what the compositor advertises. */
+static void
+read_manager_support (WaylandDisplay *display,
+                      ManagerSupport *support)
+{
+  struct wl_registry *registry = wl_display_get_registry (display->display);
+  struct wp_color_manager_v1 *manager = NULL;
+
+  wl_registry_add_listener (registry, &support_registry_listener, &manager);
+  wl_display_roundtrip (display->display);
+  g_assert_nonnull (manager);
+
+  *support = (ManagerSupport) { 0 };
+  wp_color_manager_v1_add_listener (manager, &support_listener, support);
+  while (!support->done)
+    wayland_display_dispatch (display);
+
+  wp_color_manager_v1_destroy (manager);
+  wl_registry_destroy (registry);
+}
+
+static void
+hlg_client (WaylandDisplay *display)
+{
+  struct wl_surface *surface;
+  struct wp_color_management_surface_v1 *color_surface;
+  struct wp_image_description_v1 *image_description;
+  ManagerSupport support;
+
+  read_manager_support (display, &support);
+  g_assert_true (support.transfer_functions &
+                 (G_GUINT64_CONSTANT (1) << WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_HLG));
+
+  create_test_toplevel (display, "color-management-hlg",
+                        &surface, &color_surface);
+
+  /* BT.2100 HLG with the protocol's default luminances. */
+  create_image_description_from_params (display,
+                                        &image_description,
+                                        WP_COLOR_MANAGER_V1_PRIMARIES_BT2020,
+                                        NULL,
+                                        WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_HLG,
+                                        -1.0f,
+                                        -1.0f,
+                                        -1.0f,
+                                        -1.0f);
+  wp_color_management_surface_v1_set_image_description (
+    color_surface,
+    image_description,
+    WP_COLOR_MANAGER_V1_RENDER_INTENT_PERCEPTUAL);
+  wl_surface_commit (surface);
+  wp_image_description_v1_destroy (image_description);
+
+  test_driver_sync_point (display->test_driver, 0, NULL);
+  wait_for_sync_event (display, 0);
+
+  /* HLG in BT.709 primaries for a 400 cd/m² nominal peak. */
+  create_image_description_from_params (display,
+                                        &image_description,
+                                        WP_COLOR_MANAGER_V1_PRIMARIES_SRGB,
+                                        NULL,
+                                        WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_HLG,
+                                        -1.0f,
+                                        0.01f,
+                                        400.0f,
+                                        100.0f);
+  wp_color_management_surface_v1_set_image_description (
+    color_surface,
+    image_description,
+    WP_COLOR_MANAGER_V1_RENDER_INTENT_PERCEPTUAL);
+  wl_surface_commit (surface);
+  wp_image_description_v1_destroy (image_description);
+
+  test_driver_sync_point (display->test_driver, 1, NULL);
+  wait_for_sync_event (display, 1);
+
+  wp_color_management_surface_v1_destroy (color_surface);
+}
+
+static gboolean
+create_hlg_with_luminances (WaylandDisplay *display,
+                            uint32_t        min_lum,
+                            uint32_t        max_lum,
+                            uint32_t        reference_lum)
+{
+  struct wp_image_description_creator_params_v1 *creator_params;
+  struct wp_image_description_v1 *image_description;
+  ImageDescriptionContext context = { 0 };
+
+  creator_params =
+    wp_color_manager_v1_create_parametric_creator (display->color_management_mgr);
+  wp_image_description_creator_params_v1_set_primaries_named (creator_params,
+                                                              WP_COLOR_MANAGER_V1_PRIMARIES_BT2020);
+  wp_image_description_creator_params_v1_set_tf_named (creator_params,
+                                                       WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_HLG);
+  wp_image_description_creator_params_v1_set_luminances (creator_params,
+                                                         min_lum,
+                                                         max_lum,
+                                                         reference_lum);
+  image_description =
+    wp_image_description_creator_params_v1_create (creator_params);
+  wp_image_description_v1_add_listener (image_description,
+                                        &image_description_listener,
+                                        &context);
+  wait_for_image_description_ready (&context, display);
+  wp_image_description_v1_destroy (image_description);
+
+  if (context.creation_failed)
+    {
+      g_assert_cmpuint (context.failure_cause, ==,
+                        WP_IMAGE_DESCRIPTION_V1_CAUSE_UNSUPPORTED);
+      g_assert_cmpuint (context.image_description_id, ==, 0);
+    }
+  else
+    {
+      g_assert_cmpuint (context.image_description_id, >, 0);
+    }
+
+  /* A failed image description is not a protocol error. */
+  g_assert_cmpint (wl_display_roundtrip (display->display), !=, -1);
+
+  return !context.creation_failed;
+}
+
+static void
+hlg_invalid_black_level_client (WaylandDisplay *display)
+{
+  /* BT.2100 HLG decodes black levels only up to a black level lift of 0.5,
+   * reached at about 50.7 cd/m² for a 1000 cd/m² peak (system gamma 1.2).
+   * Luminances are in units of 0.0001 cd/m² for the minimum. */
+  g_assert_false (create_hlg_with_luminances (display, 300 * 10000, 1000, 500));
+  g_assert_false (create_hlg_with_luminances (display, 60 * 10000, 1000, 203));
+  g_assert_true (create_hlg_with_luminances (display, 40 * 10000, 1000, 203));
+  g_assert_true (create_hlg_with_luminances (display, 1 * 10000, 1000, 203));
+  /* The limit follows the peak through the system gamma: about 101 cd/m²
+   * at 4000 cd/m² (gamma 1.48). */
+  g_assert_false (create_hlg_with_luminances (display, 80 * 10000, 1000, 203));
+  g_assert_true (create_hlg_with_luminances (display, 80 * 10000, 4000, 203));
+  g_assert_false (create_hlg_with_luminances (display, 110 * 10000, 4000, 203));
+}
