diff --git a/src/backends/meta-color-profile.c b/src/backends/meta-color-profile.c
index 0d9446358..c0cafd332 100644
--- a/src/backends/meta-color-profile.c
+++ b/src/backends/meta-color-profile.c
@@ -517,6 +517,36 @@ meta_color_get_temperature_rgb_scales (unsigned int  temperature,
   *out_blue = (float) blackbody_color.B;
 }
 
+/*
+ * The CIE 1931 xy chromaticity of a Planckian (blackbody) radiator at
+ * @temperature, in Kelvin: the white point of Night Light in a PQ encoding,
+ * which is adapted to in linear light rather than scaled in the gamma ramp.
+ *
+ * This uses the rational approximation of the Planckian locus in CIE 1960
+ * UCS by Krystek, "An algorithm to calculate correlated colour temperature",
+ * Color Research & Application 10 (1), 1985, which is within 1e-4 of the
+ * locus in u and v, about 3e-4 in x and y, from 1000 K to 15000 K, the whole
+ * range of Night Light.
+ */
+void
+meta_color_get_planckian_chromaticity (unsigned int  temperature,
+                                       float        *x,
+                                       float        *y)
+{
+  double t = temperature;
+  double u, v, d;
+
+  u = (0.860117757 + 1.54118254e-4 * t + 1.28641212e-7 * t * t) /
+      (1.0 + 8.42420235e-4 * t + 7.08145163e-7 * t * t);
+  v = (0.317398726 + 4.22806245e-5 * t + 4.20481691e-8 * t * t) /
+      (1.0 - 2.89741816e-5 * t + 1.61456053e-7 * t * t);
+
+  /* CIE 1960 uv to CIE 1931 xy. */
+  d = 2.0 * u - 8.0 * v + 4.0;
+  *x = (float) (3.0 * u / d);
+  *y = (float) (2.0 * v / d);
+}
