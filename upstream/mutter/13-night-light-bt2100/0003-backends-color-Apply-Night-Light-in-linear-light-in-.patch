+static void
+on_rendering_color_state_changed (MetaColorDevice *color_device,
+                                  gboolean        *run)
+{
+  *run = FALSE;
+}
+
+/* Like apply_night_light_temperature(), for a PQ encoding, where Night Light
+ * changes the rendering color state rather than the calibration. */
+static void
+apply_night_light_rendering_temperature (MetaColorDevice *color_device,
+                                         unsigned int     temperature,
+                                         gboolean         active)
+{
+  gboolean run = TRUE;
+  gboolean timed_out = FALSE;
+  gulong handler_id;
+  guint timeout_id;
+
+  handler_id = g_signal_connect (color_device, "rendering-color-state-changed",
+                                 G_CALLBACK (on_rendering_color_state_changed),
+                                 &run);
+  timeout_id = g_timeout_add_seconds (10, on_calibration_wait_timeout,
+                                      &timed_out);
+
+  set_night_light_temperature (temperature);
+  set_night_light_active (active);
+
+  while (run && !timed_out)
+    g_main_context_iteration (NULL, TRUE);
+
+  g_clear_handle_id (&timeout_id, g_source_remove);
+  g_signal_handler_disconnect (color_device, handler_id);
+
+  if (timed_out)
+    g_error ("Timed out waiting for %uK to be applied: the color device "
+             "emitted no rendering color state change", temperature);
+}
+
+static void
+set_output_color_mode (MetaOutput    *output,
+                       MetaColorMode  color_mode)
+{
+  g_autoptr (MetaCrtc) crtc = g_object_ref (meta_output_get_assigned_crtc (output));
+  MetaOutputAssignment assignment = {
+    .output = output,
+    .is_primary = meta_output_is_primary (output),
+    .color_mode = color_mode,
+  };
+
+  meta_output_assign_crtc (output, crtc, &assignment);
+}
+
+/*
+ * In BT.2100 the output carries PQ code values: Night Light programs
+ * neither the gamma LUT nor the CTM, and adapts the white in the rendering
+ * color state instead, to the Planckian white of the temperature. At the
+ * default temperature the rendering color state is exactly the one without
+ * Night Light.
+ */
+static void
+meta_test_color_management_night_light_bt2100 (void)
+{
+  MetaBackend *backend = meta_context_get_backend (test_context);
+  MetaMonitorManager *monitor_manager =
+    meta_backend_get_monitor_manager (backend);
+  MetaMonitorManagerTest *monitor_manager_test =
+    META_MONITOR_MANAGER_TEST (monitor_manager);
+  MetaColorManager *color_manager =
+    meta_backend_get_color_manager (backend);
+  MonitorTestCaseSetup test_case_setup = base_monitor_setup;
+  MetaMonitorTestSetup *test_setup;
+  MetaMonitor *monitor;
+  MetaOutput *output;
+  MetaCrtcTest *crtc_test;
+  MetaColorDevice *color_device;
+  g_autoptr (ClutterColorState) initial = NULL;
+  ClutterColorState *rendering_color_state, *encoding;
+  unsigned int temperature = 3700;
+  float expected_x, expected_y, white_x, white_y;
+  size_t gamma_size;
+  uint16_t gamma_last;
+
+  test_case_setup.crtcs[0].enable_ctm = TRUE;
+  test_case_setup.outputs[0].edid_info = CALTECH_MONITOR_EDID;
+  test_case_setup.outputs[0].has_edid_info = TRUE;
+  test_case_setup.n_outputs = 1;
+  test_case_setup.n_crtcs = 1;
+
+  test_setup = meta_create_monitor_test_setup (backend, &test_case_setup,
+                                               MONITOR_TEST_FLAG_NO_STORED);
+  meta_monitor_manager_test_emulate_hotplug (monitor_manager_test, test_setup);
+
+  monitor = meta_monitor_manager_get_monitors (monitor_manager)->data;
+  color_device = meta_color_manager_get_color_device (color_manager, monitor);
+  g_assert_nonnull (color_device);
+
+  while (!meta_color_device_is_ready (color_device))
+    g_main_context_iteration (NULL, TRUE);
+
+  /* Start from daylight, whatever an earlier test left behind, through a
+   * temperature no other test uses, in the default mode. */
+  apply_night_light_temperature (color_device, 5100, TRUE);
+  apply_night_light_temperature (color_device, 6500, FALSE);
+
+  output = meta_monitor_get_main_output (monitor);
+  crtc_test = META_CRTC_TEST (meta_output_get_assigned_crtc (output));
+  set_output_color_mode (output, META_COLOR_MODE_BT2100);
+  meta_color_device_update (color_device);
+  encoding = meta_color_device_get_color_state (color_device);
+  initial = g_object_ref (meta_color_device_get_rendering_color_state (color_device));
+  g_assert_false (clutter_color_state_params_get_adapted_white (CLUTTER_COLOR_STATE_PARAMS (initial),
+                                                                NULL, NULL));
+  gamma_size = crtc_test->gamma.size;
+  gamma_last = gamma_size ? crtc_test->gamma.red[gamma_size - 1] : 0;
+
+  apply_night_light_rendering_temperature (color_device, temperature, TRUE);
+
+  /* Neither the gamma LUT nor the CTM is touched. */
+  g_assert_cmpuint (crtc_test->gamma.size, ==, gamma_size);
+  if (gamma_size)
+    {
+      g_assert_cmpuint (crtc_test->gamma.red[gamma_size - 1], ==, gamma_last);
+      g_assert_cmpuint (crtc_test->gamma.green[gamma_size - 1], ==, gamma_last);
+      g_assert_cmpuint (crtc_test->gamma.blue[gamma_size - 1], ==, gamma_last);
+    }
+  g_assert_null (meta_crtc_test_peek_ctm (crtc_test));
+
+  /* The rendering color state adapts to the Planckian white instead. */
+  rendering_color_state = meta_color_device_get_rendering_color_state (color_device);
+  meta_color_get_planckian_chromaticity (temperature, &expected_x, &expected_y);
+  g_assert_true (clutter_color_state_params_get_adapted_white (CLUTTER_COLOR_STATE_PARAMS (rendering_color_state),
+                                                               &white_x, &white_y));
+  g_assert_cmpfloat (white_x, ==, expected_x);
+  g_assert_cmpfloat (white_y, ==, expected_y);
+  /* The output's encoding is not changed. */
+  g_assert_true (meta_color_device_get_color_state (color_device) == encoding);
+
+  /* Back to daylight: exactly the state without Night Light. */
+  apply_night_light_rendering_temperature (color_device, 6500, FALSE);
+
+  rendering_color_state = meta_color_device_get_rendering_color_state (color_device);
+  g_assert_true (clutter_color_state_identical (rendering_color_state, initial));
+  g_assert_null (meta_crtc_test_peek_ctm (crtc_test));
+
+  set_output_color_mode (output, META_COLOR_MODE_DEFAULT);
+  meta_color_device_update (color_device);
+}
+
+/*
+ * The Planckian chromaticities Night Light adapts to: at 2856 K, CIE
+ * illuminant A, a Planckian radiator by definition, xy (0.44757, 0.40745),
+ * within the 1e-4 in CIE 1960 uv the approximation claims; and warmer, in x,
+ * at every lower temperature.
+ */
+static void
+meta_test_color_management_planckian_chromaticity (void)
+{
+  float x, y, previous_x = 1.0f;
+  double u, v, reference_u, reference_v;
+  unsigned int temperature;
+
+  meta_color_get_planckian_chromaticity (2856, &x, &y);
+  u = 4.0 * x / (-2.0 * x + 12.0 * y + 3.0);
+  v = 6.0 * y / (-2.0 * x + 12.0 * y + 3.0);
+  reference_u = 4.0 * 0.44757 / (-2.0 * 0.44757 + 12.0 * 0.40745 + 3.0);
+  reference_v = 6.0 * 0.40745 / (-2.0 * 0.44757 + 12.0 * 0.40745 + 3.0);
+  g_assert_cmpfloat_with_epsilon (u, reference_u, 1e-4);
+  g_assert_cmpfloat_with_epsilon (v, reference_v, 1e-4);
+
+  for (temperature = 1000; temperature <= 10000; temperature += 100)
+    {
+      meta_color_get_planckian_chromaticity (temperature, &x, &y);
+      g_assert_cmpfloat (x, <, previous_x);
+      previous_x = x;
+    }
+}
