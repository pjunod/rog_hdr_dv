+  call_gsd_color_mock ("SetTemperature", g_variant_new ("(u)", temperature));
+  call_gsd_color_mock ("SetNightLightActive",
+                       g_variant_new ("(b)", temperature != 6500));
+  while (!changed)
+    g_main_context_iteration (NULL, TRUE);
+  g_signal_handler_disconnect (device, handler);
+}
+
+/*
+ * Night Light on a BT.2100 output adapts the output's white in the
+ * rendering color state: a surface in the output's own encoding, which
+ * would otherwise be scanned out, and the cursor plane, must be composited
+ * while it is active, and may be scanned out again once it is off, when the
+ * output's states are exactly those without Night Light.
+ */
+static void
+night_light_bt2100_scanout (void)
+{
+  MetaBackend *backend = meta_context_get_backend (test_context);
+  ClutterContext *context = meta_backend_get_clutter_context (backend);
+  MetaColorManager *manager = meta_backend_get_color_manager (backend);
+  MetaRenderer *renderer = meta_backend_get_renderer (backend);
+  MetaOutput *output = meta_virtual_monitor_get_output (virtual_monitor);
+  MetaColorDevice *device =
+    meta_color_manager_get_color_device (manager, meta_output_get_monitor (output));
+  ClutterStageView *view;
+  ClutterColorState *blending, *output_color_state;
+  g_autoptr (ClutterColorState) initial_blending = NULL;
+  g_autoptr (ClutterColorState) surface = NULL;
+  const ClutterLuminance *output_lum;
+
+  set_test_color_mode (output, META_COLOR_MODE_BT2100);
+  meta_color_device_update (device);
+  view = CLUTTER_STAGE_VIEW (meta_renderer_get_view_for_crtc (renderer,
+                                                              meta_output_get_assigned_crtc (output)));
+  g_assert_nonnull (view);
+
+  output_color_state = clutter_stage_view_get_output_color_state (view);
+  output_lum =
+    clutter_color_state_params_get_luminance (CLUTTER_COLOR_STATE_PARAMS (output_color_state));
+  /* A client surface in the output's own encoding. */
+  surface = clutter_color_state_params_new_full (context,
+                                                 CLUTTER_COLORSPACE_BT2020,
+                                                 CLUTTER_TRANSFER_FUNCTION_PQ,
+                                                 NULL, -1.0f,
+                                                 output_lum->min,
+                                                 output_lum->max,
+                                                 output_lum->ref,
+                                                 0.0f);
+  initial_blending = g_object_ref (clutter_stage_view_get_color_state (view));
+  g_assert_false (meta_compositor_view_native_color_state_prevents_scanout (surface,
+                                                                            initial_blending,
+                                                                            output_color_state));
+
+  set_night_light_temperature (device, 3900);
+  g_assert_true (clutter_stage_view_get_output_color_state (view) == output_color_state);
+  blending = clutter_stage_view_get_color_state (view);
+  g_assert_true (clutter_color_state_params_get_adapted_white (CLUTTER_COLOR_STATE_PARAMS (blending),
+                                                               NULL, NULL));
+  g_assert_true (meta_compositor_view_native_color_state_prevents_scanout (surface,
+                                                                           blending,
+                                                                           output_color_state));
+  g_assert_true (clutter_color_transform_requires_composition (surface, blending));
+  /* The blending state's conversion to the output adapts the white. */
+  g_assert_true (clutter_color_transform_requires_mapping (blending,
+                                                           output_color_state));
+
+  /* A step during the transition is a new value of the same adaptation. */
+  set_night_light_temperature (device, 3880);
+  g_assert_true (meta_compositor_view_native_color_state_prevents_scanout (surface,
+                                                                           clutter_stage_view_get_color_state (view),
+                                                                           output_color_state));
+
+  set_night_light_temperature (device, 6500);
+  blending = clutter_stage_view_get_color_state (view);
+  g_assert_true (clutter_color_state_identical (blending, initial_blending));
+  g_assert_false (meta_compositor_view_native_color_state_prevents_scanout (surface,
+                                                                            blending,
+                                                                            output_color_state));
+
+  set_test_color_mode (output, META_COLOR_MODE_DEFAULT);
+  meta_color_device_update (device);
+}
