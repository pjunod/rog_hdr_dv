+/*
+ * Whether the output's encoding is PQ: in BT.2100, and with HDR forced. Its
+ * pixels are then PQ code values, which the gamma LUT and the CTM would scale
+ * without regard to the transfer function.
+ */
+static gboolean
+encodes_pq (MetaColorDevice *color_device)
+{
+  MetaBackend *backend =
+    meta_color_manager_get_backend (color_device->color_manager);
+  MetaDebugControl *debug_control =
+    meta_context_get_debug_control (meta_backend_get_context (backend));
+
+  return meta_monitor_get_color_mode (color_device->monitor) == META_COLOR_MODE_BT2100 ||
+         meta_debug_control_is_hdr_forced (debug_control);
+}
+
+static unsigned int
+get_temperature (MetaColorDevice *color_device)
+{
+  MetaColorManager *color_manager = color_device->color_manager;
+
+  if (color_device->is_calibrating)
+    return meta_color_manager_get_default_temperature (color_manager);
+  else
+    return meta_color_manager_get_temperature (color_manager);
+}
+
+/*
+ * The white point Night Light adapts the output to, if it does so in the
+ * rendering color state: in a PQ encoding, whose gamma LUT and CTM stay at
+ * identity (see update_white_point()), at any temperature but the default.
+ * At the default temperature there is no adaptation at all, so the
+ * rendering color state is exactly what it is without Night Light.
+ */
+static gboolean
+get_adapted_white (MetaColorDevice *color_device,
+                   float           *white_x,
+                   float           *white_y)
+{
+  unsigned int temperature = get_temperature (color_device);
+
+  if (!encodes_pq (color_device) ||
+      temperature == meta_color_manager_get_default_temperature (color_device->color_manager))
+    return FALSE;
+
+  meta_color_get_planckian_chromaticity (temperature, white_x, white_y);
+  return TRUE;
+}
