+#pragma once
+
+#include <glib.h>
+
+typedef enum
+{
+  META_HDR_GAMUT_SOURCE_AUTO,
+  META_HDR_GAMUT_SOURCE_BASE_EDID,
+  META_HDR_GAMUT_SOURCE_NONE,
+} MetaHdrGamutSource;
+
+/* A monitor configuration's declaration, not a measurement or an encoding.
+ * Zero initialization means no luminance override and automatic gamut.
+ * Presence is explicit because zero is a valid declared black level. */
+typedef struct
+{
+  gboolean has_peak;
+  float peak;
+  gboolean has_min;
+  float min;
+  MetaHdrGamutSource gamut_source;
+} MetaColorTargetOverride;
+
+static inline gboolean
+meta_color_target_override_equal (const MetaColorTargetOverride *a,
+                                  const MetaColorTargetOverride *b)
+{
+  return a->has_peak == b->has_peak &&
+         (!a->has_peak || a->peak == b->peak) &&
+         a->has_min == b->has_min &&
+         (!a->has_min || a->min == b->min) &&
+         a->gamut_source == b->gamut_source;
+}
