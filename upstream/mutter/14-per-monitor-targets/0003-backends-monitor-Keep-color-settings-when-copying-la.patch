 }
 
+static MetaColorTargetOverride
+get_last_target_override_for_monitor (MetaMonitorConfigManager *config_manager,
+                                      MetaMonitor              *monitor)
+{
+  g_autoptr (GList) configs = get_relevant_configs (config_manager);
+  GList *l;
+
+  for (l = configs; l; l = l->next)
+    {
+      MetaMonitorConfig *monitor_config = find_monitor_config (l->data, monitor);
+
+      if (monitor_config)
+        return monitor_config->target_override;
+    }
+
+  return (MetaColorTargetOverride) { 0 };
+}
