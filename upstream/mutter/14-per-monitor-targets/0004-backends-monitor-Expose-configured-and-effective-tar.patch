+static const char *
+hdr_gamut_source_to_string (MetaHdrGamutSource source)
+{
+  switch (source)
+    {
+    case META_HDR_GAMUT_SOURCE_AUTO:
+      return "auto";
+    case META_HDR_GAMUT_SOURCE_BASE_EDID:
+      return "base-edid";
+    case META_HDR_GAMUT_SOURCE_NONE:
+      return "none";
+    }
+
+  g_assert_not_reached ();
+}
