+typedef struct
+{
+  gboolean done;
+  GVariant *reply;
+  GError *error;
+} TargetCall;
+
+static void
+target_call_done (GObject      *source,
+                  GAsyncResult *result,
+                  gpointer      user_data)
+{
+  TargetCall *call = user_data;
+
+  call->reply = g_dbus_proxy_call_finish (G_DBUS_PROXY (source), result, &call->error);
+  call->done = TRUE;
+}
+
+static GVariant *
+target_call (GDBusProxy  *proxy,
+             const char  *method,
+             GVariant    *parameters,
+             GError     **error)
+{
+  TargetCall call = { 0 };
+
+  g_dbus_proxy_call (proxy, method, parameters, G_DBUS_CALL_FLAGS_NONE,
+                     5000, NULL, target_call_done, &call);
+  while (!call.done)
+    g_main_context_iteration (NULL, TRUE);
+  if (call.error)
+    g_propagate_error (error, call.error);
+  return call.reply;
+}
+
+static GDBusProxy *
+create_target_proxy (void)
+{
+  GDBusProxy *proxy = NULL;
+
+  g_dbus_proxy_new_for_bus (G_BUS_TYPE_SESSION,
+                            G_DBUS_PROXY_FLAGS_DO_NOT_AUTO_START,
+                            NULL, "org.gnome.Mutter.DisplayConfig",
+                            "/org/gnome/Mutter/DisplayConfig",
+                            "org.gnome.Mutter.DisplayConfig", NULL,
+                            proxy_ready_cb, &proxy);
+  while (!proxy)
+    g_main_context_iteration (NULL, TRUE);
+  return proxy;
+}
+
+static GVariant *
+apply_target_properties (GDBusProxy                *proxy,
+                         MetaMonitorManager        *manager,
+                         MetaMonitor               *monitor,
+                         MetaMonitorsConfigMethod   method,
+                         GVariant                  *properties,
+                         GError                   **error)
+{
+  GVariantBuilder monitors;
+  GVariantBuilder logical;
+
+  g_variant_builder_init (&monitors, G_VARIANT_TYPE ("a(ssa{sv})"));
+  g_variant_builder_add (&monitors, "(ss@a{sv})",
+                         meta_monitor_get_connector (monitor),
+                         meta_monitor_mode_get_id (meta_monitor_get_preferred_mode (monitor)),
+                         g_variant_ref (properties));
+  g_variant_builder_init (&logical, G_VARIANT_TYPE ("a(iiduba(ssa{sv}))"));
+  g_variant_builder_add (&logical, "(iiduba(ssa{sv}))",
+                         0, 0, 1.0, 0, TRUE, &monitors);
+  return target_call (proxy, "ApplyMonitorsConfig",
+                      g_variant_new ("(uua(iiduba(ssa{sv}))a{sv})",
+                                     manager->serial, method, &logical, NULL), error);
+}
+
+static GVariant *
+read_target_properties (GDBusProxy *proxy)
+{
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) state = target_call (proxy, "GetCurrentState", NULL, &error);
+  g_autoptr (GVariant) monitors = NULL;
+  g_autoptr (GVariant) monitor = NULL;
+
+  g_assert_no_error (error);
+  g_assert_nonnull (state);
+  monitors = g_variant_get_child_value (state, 1);
+  monitor = g_variant_get_child_value (monitors, 0);
+  return g_variant_get_child_value (monitor, 2);
+}
+
+static void
+assert_effective_target (GVariant        *properties,
+                         MetaColorDevice *device)
+{
+  const MetaColorTargetLuminance *luminance = meta_color_device_get_target_luminance (device);
+  const MetaColorTargetPrimaries *primaries = meta_color_device_get_target_primaries (device);
+  g_autoptr (GVariant) xy = NULL;
+  const char *source;
+  double minimum, maximum;
+  unsigned int i;
+
+  g_assert_true (g_variant_lookup (properties, "target-luminance", "(dd)",
+                                   &minimum, &maximum));
+  g_assert_cmpfloat (minimum, ==, luminance->minimum);
+  g_assert_cmpfloat (maximum, ==, luminance->maximum);
+  g_assert_true (g_variant_lookup (properties, "target-min-luminance-source", "&s", &source));
+  g_assert_cmpstr (source, ==, meta_color_target_provenance_to_string (luminance->minimum_source));
+  g_assert_true (g_variant_lookup (properties, "target-max-luminance-source", "&s", &source));
+  g_assert_cmpstr (source, ==, meta_color_target_provenance_to_string (luminance->maximum_source));
+  g_assert_true (g_variant_lookup (properties, "target-primaries-source", "&s", &source));
+  g_assert_cmpstr (source, ==, meta_color_target_provenance_to_string (primaries->source));
+  xy = g_variant_lookup_value (properties, "target-primaries", G_VARIANT_TYPE ("(dddddddd)"));
+  g_assert_nonnull (xy);
+  for (i = 0; i < 8; i++)
+    {
+      g_autoptr (GVariant) coordinate = g_variant_get_child_value (xy, i);
+
+      g_assert_cmpfloat (g_variant_get_double (coordinate), ==,
+                         meta_color_chromaticity_from_fixed (primaries->coordinates[i]));
+    }
+}
+
+static void
+on_target_wait_timeout (gpointer user_data)
+{
+  gboolean *timed_out = user_data;
+
+  *timed_out = TRUE;
+}
+
+/*
+ * Waits, at most 10 s, until the monitor's configured target peak is @peak:
+ * an observable result of the restore that rejecting a persistent
+ * configuration schedules, rather than the manager's private idle handle.
+ */
+static void
+wait_for_target_override_peak (MetaMonitor *monitor,
+                               float        peak)
+{
+  gboolean timed_out = FALSE;
+  unsigned int timeout_id;
+
+  timeout_id = g_timeout_add_seconds_once (10, on_target_wait_timeout,
+                                           &timed_out);
+  while (meta_monitor_get_target_override (monitor)->peak != peak &&
+         !timed_out)
+    g_main_context_iteration (NULL, TRUE);
+
+  if (!timed_out)
+    g_source_remove (timeout_id);
+  g_assert_false (timed_out);
+  g_assert_cmpfloat (meta_monitor_get_target_override (monitor)->peak, ==, peak);
+}
+
