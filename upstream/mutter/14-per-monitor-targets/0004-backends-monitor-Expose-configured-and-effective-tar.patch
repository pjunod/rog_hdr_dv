+  };
+  MetaBackend *backend = meta_context_get_backend (test_context);
+  MetaMonitorManager *manager = meta_backend_get_monitor_manager (backend);
+  MetaColorManager *color_manager = meta_backend_get_color_manager (backend);
+  MetaMonitor *monitor;
+  MetaColorDevice *device;
+  MetaMonitorsConfig *before;
+  g_autoptr (GDBusProxy) proxy = create_target_proxy ();
+  g_autoptr (GVariant) valid = NULL;
+  g_autoptr (GVariant) reply = NULL;
+  g_autoptr (GVariant) properties = NULL;
+  g_autoptr (GError) error = NULL;
+  double peak, minimum;
+  const char *source;
+  unsigned int confirm_signal_id;
+  size_t i;
+
+  meta_emulate_hotplug (meta_create_monitor_test_setup (backend, &setup,
+                                                       MONITOR_TEST_FLAG_NO_STORED));
+  monitor = meta_monitor_manager_get_monitors (manager)->data;
+  device = meta_color_manager_get_color_device (color_manager, monitor);
+  g_assert_nonnull (device);
+  valid = g_variant_parse (G_VARIANT_TYPE_VARDICT,
+    "{'color-mode': <uint32 1>, 'target-peak-luminance': <double 400>, "
+    "'target-min-luminance': <double 0>, 'hdr-gamut-source': <'none'>}",
+    NULL, NULL, &error);
+  g_assert_no_error (error);
+  before = meta_monitor_config_manager_get_current (manager->config_manager);
+  reply = apply_target_properties (proxy, manager, monitor,
+                                   META_MONITORS_CONFIG_METHOD_VERIFY, valid, &error);
+  g_assert_no_error (error);
+  g_assert_nonnull (reply);
+  g_clear_pointer (&reply, g_variant_unref);
+  g_assert_true (before == meta_monitor_config_manager_get_current (manager->config_manager));
+  g_assert_false (meta_monitor_get_target_override (monitor)->has_peak);
+
+  reply = apply_target_properties (proxy, manager, monitor,
+                                   META_MONITORS_CONFIG_METHOD_TEMPORARY, valid, &error);
+  g_assert_no_error (error);
+  g_assert_nonnull (reply);
+  g_clear_pointer (&reply, g_variant_unref);
+  meta_color_device_set_reference_luminance_factor (device, 2.1f);
+  properties = read_target_properties (proxy);
+  g_assert_true (g_variant_lookup (properties, "target-peak-luminance", "d", &peak));
+  g_assert_true (g_variant_lookup (properties, "target-min-luminance", "d", &minimum));
+  g_assert_cmpfloat (peak, ==, 400);
+  g_assert_cmpfloat (minimum, ==, 0);
+  g_assert_true (g_variant_lookup (properties, "hdr-gamut-source", "&s", &source));
+  g_assert_cmpstr (source, ==, "none");
+  assert_effective_target (properties, device);
+  /* The integrated selector must honor 400 even at ~426 cd/m² scaled white. */
+  g_assert_cmpfloat (meta_color_device_get_target_luminance (device)->maximum, ==, 400);
+  g_assert_true (g_variant_lookup (properties, "target-max-luminance-source", "&s", &source));
+  g_assert_cmpstr (source, ==, "user-declared");
+
+  before = meta_monitor_config_manager_get_current (manager->config_manager);
+  for (i = 0; i < G_N_ELEMENTS (invalid); i++)
+    {
+      g_autoptr (GVariant) malformed = g_variant_parse (G_VARIANT_TYPE_VARDICT,
+                                                      invalid[i], NULL, NULL, &error);
+
+      g_assert_no_error (error);
+      reply = apply_target_properties (proxy, manager, monitor,
+                                       META_MONITORS_CONFIG_METHOD_TEMPORARY,
+                                       malformed, &error);
+      g_assert_null (reply);
+      g_assert_nonnull (error);
+      g_clear_error (&error);
+      g_assert_true (before == meta_monitor_config_manager_get_current (manager->config_manager));
+      g_assert_cmpfloat (meta_monitor_get_target_override (monitor)->peak, ==, 400);
+    }
+
+  /* Persistent proposals use the ordinary rejection/restore lifecycle. The
+   * test shell, like any plugin without a confirmation dialog, accepts a
+   * persistent configuration while it is being applied, which would leave
+   * nothing to reject: hold its confirmation, as a user would. */
+  confirm_signal_id = g_signal_lookup ("confirm-display-change",
+                                       G_OBJECT_TYPE (manager));
+  g_assert_cmpuint (g_signal_handlers_block_matched (manager,
+                                                     G_SIGNAL_MATCH_ID,
+                                                     confirm_signal_id, 0,
+                                                     NULL, NULL, NULL),
+                    ==, 1);
+  g_clear_pointer (&valid, g_variant_unref);
+  valid = g_variant_parse (G_VARIANT_TYPE_VARDICT,
+    "{'color-mode': <uint32 1>, 'target-peak-luminance': <double 600>}",
+    NULL, NULL, &error);
+  g_assert_no_error (error);
+  reply = apply_target_properties (proxy, manager, monitor,
+                                   META_MONITORS_CONFIG_METHOD_PERSISTENT, valid, &error);
+  g_assert_no_error (error);
+  g_clear_pointer (&reply, g_variant_unref);
+  g_assert_cmpfloat (meta_monitor_get_target_override (monitor)->peak, ==, 600);
+  g_assert_cmpuint (manager->persistent_timeout_id, !=, 0);
+  meta_monitor_manager_confirm_configuration (manager, FALSE);
+  g_assert_cmpuint (manager->persistent_timeout_id, ==, 0);
+  wait_for_target_override_peak (monitor, 400);
+  /* The restore has run: no stale handle is left for the next
+   * configuration to remove. */
+  g_assert_cmpuint (manager->restore_config_id, ==, 0);
+  g_assert_cmpuint (g_signal_handlers_unblock_matched (manager,
+                                                       G_SIGNAL_MATCH_ID,
+                                                       confirm_signal_id, 0,
+                                                       NULL, NULL, NULL),
+                    ==, 1);
+
+  /* Omission replaces the declaration, rather than silently retaining it. */
+  g_clear_pointer (&valid, g_variant_unref);
+  valid = g_variant_parse (G_VARIANT_TYPE_VARDICT, "{}", NULL, NULL, &error);
+  g_assert_no_error (error);
+  reply = apply_target_properties (proxy, manager, monitor,
+                                   META_MONITORS_CONFIG_METHOD_TEMPORARY, valid, &error);
+  g_assert_no_error (error);
+  g_assert_false (meta_monitor_get_target_override (monitor)->has_peak);
+  g_assert_false (meta_monitor_get_target_override (monitor)->has_min);
+  g_assert_cmpint (meta_monitor_get_target_override (monitor)->gamut_source, ==,
+                   META_HDR_GAMUT_SOURCE_AUTO);
+  g_clear_pointer (&properties, g_variant_unref);
+  properties = read_target_properties (proxy);
+  assert_effective_target (properties, device);
+  g_assert_null (g_variant_lookup_value (properties, "target-peak-luminance", NULL));
+}
+
 static void
 init_dbus_tests (void)
 {
+  meta_add_monitor_test ("/backends/monitor/target-overrides-dbus",
+                         meta_test_monitor_target_dbus);
   meta_add_monitor_test ("/backends/monitor/has-external-monitor",
                          meta_test_monitor_has_external_monitor);
 }
