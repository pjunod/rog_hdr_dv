+/*
+ * The user's per-monitor override in target luminance selection: it comes
+ * before every declaration of the display, as a whole, validated like
+ * them; an unusable override falls through. It needs no EDID, and is only
+ * a target where a luminance target is: in BT.2100.
+ */
+static void
+test_target_luminance_override (void)
+{
+  MetaEdidInfo edid = {
+    .native_luminance_status = META_NATIVE_LUMINANCE_FIRMWARE_DECLARED,
+    .native_luminance = {
+      .has_min_luminance = TRUE,
+      .has_max_luminance_10pct = TRUE,
+      .min_luminance = 1049.0f / 2097152.0f,
+      .max_luminance_10pct = 616,
+    },
+    .hdr_static_metadata = {
+      .desired_content_max_luminance = 600,
+      .desired_content_min_luminance = 0.05f,
+      .type1 = TRUE,
+      .pq = TRUE,
+    },
+  };
+  ClutterLuminance encoding = { .min = 0.005f, .max = 10000, .ref = 203 };
+  MetaColorTargetOverride override = { .has_peak = TRUE, .peak = 400 };
+  MetaColorTargetLuminance target;
+
+  g_assert_cmpstr (meta_color_target_provenance_to_string (META_COLOR_TARGET_USER_DECLARED),
+                   ==, "user-declared");
+
+  /* A peak alone beats DisplayID and CTA; black stays at the encoding's,
+   * never a display declaration's, and no physical declaration is
+   * carried. */
+  meta_color_target_luminance_init (&target, &edid, &override, TRUE, &encoding);
+  g_assert_cmpfloat (target.maximum, ==, 400);
+  g_assert_cmpfloat (target.minimum, ==, encoding.min);
+  g_assert_cmpint (target.maximum_source, ==, META_COLOR_TARGET_USER_DECLARED);
+  g_assert_cmpint (target.minimum_source, ==, META_COLOR_TARGET_ENCODING_FALLBACK);
+  g_assert_false (target.physical.has_min_luminance);
+  g_assert_false (target.physical.has_max_luminance_10pct);
+
+  /* Zero is a declared black level, not an absent one. */
+  override.has_min = TRUE;
+  override.min = 0;
+  meta_color_target_luminance_init (&target, &edid, &override, TRUE, &encoding);
+  g_assert_cmpfloat (target.minimum, ==, 0);
+  g_assert_cmpint (target.minimum_source, ==, META_COLOR_TARGET_USER_DECLARED);
+  g_assert_cmpint (target.maximum_source, ==, META_COLOR_TARGET_USER_DECLARED);
+
+  /* Without an EDID, the override is still the target. */
+  meta_color_target_luminance_init (&target, NULL, &override, TRUE, &encoding);
+  g_assert_cmpfloat (target.maximum, ==, 400);
+  g_assert_cmpint (target.maximum_source, ==, META_COLOR_TARGET_USER_DECLARED);
+  g_assert_cmpint (target.minimum_source, ==, META_COLOR_TARGET_USER_DECLARED);
+
+  /* Outside an eligible mode there is no luminance target at all. */
+  meta_color_target_luminance_init (&target, &edid, &override, FALSE, &encoding);
+  g_assert_cmpfloat (target.maximum, ==, encoding.max);
+  g_assert_cmpint (target.maximum_source, ==, META_COLOR_TARGET_ENCODING_FALLBACK);
+  g_assert_cmpint (target.minimum_source, ==, META_COLOR_TARGET_ENCODING_FALLBACK);
+
+  /* An override failing validation falls through to DisplayID as a whole:
+   * a peak at the nominal reference white, black at the whole peak, a
+   * nonfinite peak, or a minimum without a peak. */
+  override.peak = encoding.ref;
+  meta_color_target_luminance_init (&target, &edid, &override, TRUE, &encoding);
+  g_assert_cmpint (target.maximum_source, ==, META_COLOR_TARGET_FIRMWARE_DECLARED);
+  g_assert_cmpint (target.minimum_source, ==, META_COLOR_TARGET_FIRMWARE_DECLARED);
+  g_assert_cmpfloat (target.maximum, ==, 616);
+  override.peak = encoding.ref + 1;
+  meta_color_target_luminance_init (&target, &edid, &override, TRUE, &encoding);
+  g_assert_cmpint (target.maximum_source, ==, META_COLOR_TARGET_USER_DECLARED);
+  g_assert_cmpfloat (target.maximum, ==, 204);
+  override.peak = 400.5f;
+  override.min = 400;
+  meta_color_target_luminance_init (&target, &edid, &override, TRUE, &encoding);
+  g_assert_cmpint (target.maximum_source, ==, META_COLOR_TARGET_FIRMWARE_DECLARED);
+  override.min = 0;
+  override.peak = NAN;
+  meta_color_target_luminance_init (&target, &edid, &override, TRUE, &encoding);
+  g_assert_cmpint (target.maximum_source, ==, META_COLOR_TARGET_FIRMWARE_DECLARED);
+  override.has_peak = FALSE;
+  override.peak = 400;
+  meta_color_target_luminance_init (&target, &edid, &override, TRUE, &encoding);
+  g_assert_cmpint (target.maximum_source, ==, META_COLOR_TARGET_FIRMWARE_DECLARED);
+  g_assert_cmpint (target.minimum_source, ==, META_COLOR_TARGET_FIRMWARE_DECLARED);
+
+  /* ... and further to CTA, and the fallback, like any other source. */
+  override.has_peak = TRUE;
+  override.peak = 100;
+  edid.native_luminance_status = META_NATIVE_LUMINANCE_UNAVAILABLE;
+  meta_color_target_luminance_init (&target, &edid, &override, TRUE, &encoding);
+  g_assert_cmpint (target.maximum_source, ==, META_COLOR_TARGET_CTA_DECLARED);
+  g_assert_cmpfloat (target.maximum, ==, 600);
+  meta_color_target_luminance_init (&target, NULL, &override, TRUE, &encoding);
+  g_assert_cmpint (target.maximum_source, ==, META_COLOR_TARGET_ENCODING_FALLBACK);
+  g_assert_cmpfloat (target.maximum, ==, encoding.max);
+}
+
+/*
+ * The override's gamut source in target primaries selection. In BT.2100:
+ * auto takes the DisplayID native chromaticities; base-edid takes the base
+ * EDID color characteristics as a user declaration when they are usable,
+ * and otherwise falls through to DisplayID; none is a valid request for no
+ * gamut target, and suppresses both. The native SDR mode, which encodes in
+ * the base EDID gamut, ignores the override.
+ */
+static void
+test_target_primaries_override (void)
+{
+  const uint16_t xy[4][2] = {
+    { 2816, 1280 }, { 1024, 2816 }, { 512, 256 }, { 1280, 1344 },
+  };
+  /* A wide gamut panel, in exact 10-bit EDID steps. */
+  const uint16_t codes[8] = { 697, 327, 271, 706, 154, 61, 321, 337 };
+  const ClutterPrimaries *bt2020 = clutter_colorspace_to_primaries (CLUTTER_COLORSPACE_BT2020);
+  MetaEdidInfo edid = {
+    .native_chromaticities_status = META_NATIVE_CHROMATICITIES_FIRMWARE_DECLARED,
+    .default_color_primaries = {
+      .has_primaries = TRUE,
+      .has_default_white_point = TRUE,
+    },
+  };
+  MetaColorTargetOverride override = { 0 };
+  MetaColorTargetPrimaries target;
+  int32_t expected[8], encoding[8];
+  unsigned int i;
+
+  set_raw_points (&edid, xy);
+  for (i = 0; i < 3; i++)
+    edid.default_color_primaries.primary[i] = (struct di_chromaticity_cie1931) {
+      codes[2 * i] / 1024.0f, codes[2 * i + 1] / 1024.0f,
+    };
+  edid.default_color_primaries.default_white = (struct di_chromaticity_cie1931) {
+    codes[6] / 1024.0f, codes[7] / 1024.0f,
+  };
+  for (i = 0; i < 8; i++)
+    expected[i] = (int32_t) round (codes[i] * 1000000.0 / 1024.0);
+
+  /* Zero initialization is automatic: DisplayID, as without an override. */
+  meta_color_target_primaries_init (&target, &edid, &override,
+                                    META_COLOR_TARGET_PRIMARIES_SOURCES_DISPLAYID, bt2020);
+  g_assert_cmpint (override.gamut_source, ==, META_HDR_GAMUT_SOURCE_AUTO);
+  g_assert_cmpint (target.source, ==, META_COLOR_TARGET_FIRMWARE_DECLARED);
+  g_assert_cmpint (target.coordinates[0], ==, 687500);
+
+  /* base-edid: the base EDID gamut, user-declared, with the EDID's one
+   * 10-bit step as the tolerance, ahead of DisplayID. */
+  override.gamut_source = META_HDR_GAMUT_SOURCE_BASE_EDID;
+  meta_color_target_primaries_init (&target, &edid, &override,
+                                    META_COLOR_TARGET_PRIMARIES_SOURCES_DISPLAYID, bt2020);
+  g_assert_cmpint (target.source, ==, META_COLOR_TARGET_USER_DECLARED);
+  for (i = 0; i < 8; i++)
