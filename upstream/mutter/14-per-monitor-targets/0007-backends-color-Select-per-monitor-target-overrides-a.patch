+  g_assert_cmpint (target.source, ==, META_COLOR_TARGET_EDID_DECLARED);
+  for (i = 0; i < 8; i++)
+    g_assert_cmpint (target.coordinates[i], ==, expected[i]);
+  override.gamut_source = META_HDR_GAMUT_SOURCE_NONE;
+  meta_color_target_primaries_init (&target, &edid, &override,
