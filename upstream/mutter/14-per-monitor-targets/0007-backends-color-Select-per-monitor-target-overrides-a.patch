+   * the base EDID gamut it encodes in, whatever the override. */
   declared = meta_monitor_is_active (monitor) &&
              !meta_debug_control_is_hdr_forced (debug_control);
   if (declared && color_mode == META_COLOR_MODE_BT2100)
     primaries_sources = META_COLOR_TARGET_PRIMARIES_SOURCES_DISPLAYID;
   else if (declared && color_mode == META_COLOR_MODE_SDR_NATIVE)
     primaries_sources = META_COLOR_TARGET_PRIMARIES_SOURCES_BASE_EDID;
-  meta_color_target_luminance_init (&target, info->edid_info,
+  meta_color_target_luminance_init (&target, info->edid_info, override,
