                    display_targets_cta);
   g_test_add_func ("/wayland/display-targets/sdr-native",
                    display_targets_sdr_native);
+  g_test_add_func ("/wayland/display-targets/user-override",
+                   display_targets_user_override);
   g_test_add_func ("/wayland/mapping/target-gamut",
                    mapping_target_gamut);
 }
