@@ -1370,23 +1440,25 @@ update_target_volume (MetaColorDevice *color_device)
   MetaColorTargetPrimariesSources primaries_sources =
     META_COLOR_TARGET_PRIMARIES_SOURCES_NONE;
   MetaColorMode color_mode = meta_monitor_get_color_mode (monitor);
+  const MetaColorTargetOverride *override = meta_monitor_get_target_override (monitor);
   gboolean declared;
 
   /* The default SDR mode renders into an assumed sRGB encoding, and forced
    * HDR into an encoding the output did not choose: neither has a target.
-   * Target luminance is only selected in BT.2100. Target primaries are the
-   * DisplayID physical gamut in BT.2100, and the base EDID gamut the native
