diff --git a/src/backends/meta-color-device.c b/src/backends/meta-color-device.c
index e0680f8b2..3ae9dfeb5 100644
--- a/src/backends/meta-color-device.c
+++ b/src/backends/meta-color-device.c
@@ -950,27 +950,69 @@ select_cta_luminance (MetaColorTargetLuminance *target,
   return TRUE;
 }
 
+/*
+ * The user's luminance override for the monitor: the peak, and black when
+ * one is declared. Like a display's own declaration, it is usable when it
+ * declares the peak and the effective range is valid against the
+ * encoding's nominal reference white; without a declared minimum, black
+ * stays at the encoding's. The configuration rejects invalid overrides up
+ * front; this check keeps the selector correct for any caller.
+ */
+static gboolean
+select_user_luminance (MetaColorTargetLuminance      *target,
+                       const MetaColorTargetOverride *override,
+                       const ClutterLuminance        *encoding)
+{
+  MetaColorTargetLuminance declared = {
+    .minimum = encoding->min,
+  };
+
+  if (!override || !override->has_peak)
+    return FALSE;
+
+  declared.maximum = override->peak;
+  declared.maximum_source = META_COLOR_TARGET_USER_DECLARED;
+  if (override->has_min)
+    {
+      declared.minimum = override->min;
+      declared.minimum_source = META_COLOR_TARGET_USER_DECLARED;
+    }
+
+  if (!target_luminance_valid (declared.minimum, declared.maximum, encoding))
+    return FALSE;
+
+  *target = declared;
+  return TRUE;
+}
+
 /*
  * Selects the target luminance of an output in an eligible mode (@eligible:
  * active, BT.2100, HDR not forced). Each source is taken as a whole, the
- * first usable one: the DisplayID 2 physical luminance, then the CTA-861 HDR
- * static metadata. A source that is unusable falls through to the next.
- * Otherwise the target is the encoding's range, the explicit fallback.
- * @encoding gives that range, and the reference white a declared peak must
- * exceed.
+ * first usable one: the user's @override, then the DisplayID 2 physical
+ * luminance, then the CTA-861 HDR static metadata. A source that is unusable
+ * falls through to the next. The override needs no EDID. Otherwise the
+ * target is the encoding's range, the explicit fallback. @encoding gives
+ * that range, and the reference white a declared peak must exceed.
  */
