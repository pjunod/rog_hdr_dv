From 29ea7e6aa75e1034f6c41fdbbf7cc926fe0430b4 Mon Sep 17 00:00:00 2001
From: Paul Junod <donujp@gmail.com>
Date: Mon, 12 Oct 2026 08:46:45 +0000
Subject: [PATCH 03/11] tests/color-management: Check colord devices across
 unplug and reconnect

Unplug a monitor while its color device is still referenced, check that
colord no longer has its device, reconnect it, and check that the new
device sets up in colord and keeps its colord device once the old color
device is gone.

Move a monitor to another connector and check that its new device, with
the same colord device ID, sets up in colord.

Link: TBD-MR
---
 src/tests/color-management-tests.c | 167 +++++++++++++++++++++++++++++
 1 file changed, 167 insertions(+)

diff --git a/src/tests/color-management-tests.c b/src/tests/color-management-tests.c
index 796830212..37bab695c 100644
--- a/src/tests/color-management-tests.c
+++ b/src/tests/color-management-tests.c
@@ -174,6 +174,52 @@ get_colord_mock_proxy (void)
   return proxy;
 }
 
+/* Whether colord has a device with @cd_device_id. */
+static gboolean
+colord_has_device (const char *cd_device_id)
+{
+  g_autoptr (GDBusProxy) proxy = NULL;
+  g_autoptr (GVariant) result = NULL;
+  g_autoptr (GError) error = NULL;
+  g_autofree char *error_name = NULL;
+
+  proxy =
+    g_dbus_proxy_new_for_bus_sync (G_BUS_TYPE_SYSTEM,
+                                   G_DBUS_PROXY_FLAGS_DO_NOT_AUTO_START |
+                                   G_DBUS_PROXY_FLAGS_DO_NOT_LOAD_PROPERTIES |
+                                   G_DBUS_PROXY_FLAGS_DO_NOT_CONNECT_SIGNALS,
+                                   NULL,
+                                   "org.freedesktop.ColorManager",
+                                   "/org/freedesktop/ColorManager",
+                                   "org.freedesktop.ColorManager",
+                                   NULL, &error);
+  g_assert_no_error (error);
+
+  result = g_dbus_proxy_call_sync (proxy,
+                                   "FindDeviceById",
+                                   g_variant_new ("(s)", cd_device_id),
+                                   G_DBUS_CALL_FLAGS_NO_AUTO_START, -1, NULL,
+                                   &error);
+  if (result)
+    return TRUE;
+
+  error_name = g_dbus_error_get_remote_error (error);
+  g_assert_cmpstr (error_name, ==, "org.freedesktop.ColorManager.NotFound");
+  return FALSE;
+}
+
+/* Waits until @color_device is set up, and checks that it is set up in
+ * colord, with its device profile. */
+static void
+wait_for_device_registered (MetaColorDevice *color_device)
+{
+  while (!meta_color_device_is_ready (color_device))
+    g_main_context_iteration (NULL, TRUE);
+
+  g_assert_nonnull (meta_color_device_get_device_profile (color_device));
+  g_assert_true (colord_has_device (meta_color_device_get_id (color_device)));
+}
+
 static void
 wait_for_profile_assigned (MetaColorDevice *color_device,
                            const char      *profile_id)
@@ -633,6 +679,123 @@ meta_test_color_management_device_no_edid (void)
                    device_id);
 }
 
+/*
+ * A monitor that is unplugged leaves colord with its color device, even while
+ * something still holds a reference to the device, so that the monitor's
+ * next device sets up in colord, and keeps its colord device once the old
+ * device is gone.
+ */
+static void
+meta_test_color_management_device_unplug_referenced (void)
+{
+  MetaBackend *backend = meta_context_get_backend (test_context);
+  MetaMonitorManager *monitor_manager =
+    meta_backend_get_monitor_manager (backend);
+  MetaMonitorManagerTest *monitor_manager_test =
+    META_MONITOR_MANAGER_TEST (monitor_manager);
+  MetaColorManager *color_manager =
+    meta_backend_get_color_manager (backend);
+  MonitorTestCaseSetup test_case_setup = base_monitor_setup;
+  MetaMonitorTestSetup *test_setup;
+  MetaMonitor *monitor;
+  MetaColorDevice *color_device;
+  g_autoptr (MetaColorDevice) old_color_device = NULL;
+  g_autofree char *cd_device_id = NULL;
+
+  test_case_setup.outputs[0].serial = "device_unplug_referenced/serial";
+  test_case_setup.n_outputs = 1;
+  test_case_setup.n_crtcs = 1;
+  test_setup = meta_create_monitor_test_setup (backend, &test_case_setup,
+                                               MONITOR_TEST_FLAG_NO_STORED);
+  meta_monitor_manager_test_emulate_hotplug (monitor_manager_test, test_setup);
+
+  monitor =
+    META_MONITOR (meta_monitor_manager_get_monitors (monitor_manager)->data);
+  color_device = meta_color_manager_get_color_device (color_manager, monitor);
+  g_assert_nonnull (color_device);
+  wait_for_device_registered (color_device);
+  cd_device_id = g_strdup (meta_color_device_get_id (color_device));
+  old_color_device = g_object_ref (color_device);
+
+  test_case_setup.n_outputs = 0;
+  test_setup = meta_create_monitor_test_setup (backend, &test_case_setup,
+                                               MONITOR_TEST_FLAG_NO_STORED);
+  meta_monitor_manager_test_emulate_hotplug (monitor_manager_test, test_setup);
+  g_assert_cmpint (meta_color_manager_get_num_color_devices (color_manager),
+                   ==,
+                   0);
+  g_assert_false (colord_has_device (cd_device_id));
+
+  test_case_setup.n_outputs = 1;
+  test_setup = meta_create_monitor_test_setup (backend, &test_case_setup,
+                                               MONITOR_TEST_FLAG_NO_STORED);
+  meta_monitor_manager_test_emulate_hotplug (monitor_manager_test, test_setup);
+
+  monitor =
+    META_MONITOR (meta_monitor_manager_get_monitors (monitor_manager)->data);
+  color_device = meta_color_manager_get_color_device (color_manager, monitor);
+  g_assert_nonnull (color_device);
+  g_assert_true (color_device != old_color_device);
+  g_assert_cmpstr (meta_color_device_get_id (color_device), ==, cd_device_id);
+  wait_for_device_registered (color_device);
+
+  g_clear_object (&old_color_device);
+  g_assert_true (colord_has_device (cd_device_id));
+}
+
+/*
+ * A monitor that moves to another connector gets a new color device with
+ * the colord device ID of the old one, which must be gone from colord first.
+ */
+static void
+meta_test_color_management_device_moved_connector (void)
+{
+  MetaBackend *backend = meta_context_get_backend (test_context);
+  MetaMonitorManager *monitor_manager =
+    meta_backend_get_monitor_manager (backend);
+  MetaMonitorManagerTest *monitor_manager_test =
+    META_MONITOR_MANAGER_TEST (monitor_manager);
+  MetaColorManager *color_manager =
+    meta_backend_get_color_manager (backend);
+  MonitorTestCaseSetup test_case_setup = base_monitor_setup;
+  MetaMonitorTestSetup *test_setup;
+  MetaMonitor *monitor;
+  MetaColorDevice *color_device;
+  g_autofree char *cd_device_id = NULL;
+  g_autofree char *connector = NULL;
+
+  test_case_setup.outputs[0].serial = "device_moved_connector/serial";
+  test_case_setup.n_outputs = 1;
+  test_case_setup.n_crtcs = 1;
+  test_setup = meta_create_monitor_test_setup (backend, &test_case_setup,
+                                               MONITOR_TEST_FLAG_NO_STORED);
+  meta_monitor_manager_test_emulate_hotplug (monitor_manager_test, test_setup);
+
+  monitor =
+    META_MONITOR (meta_monitor_manager_get_monitors (monitor_manager)->data);
+  color_device = meta_color_manager_get_color_device (color_manager, monitor);
+  g_assert_nonnull (color_device);
+  wait_for_device_registered (color_device);
+  cd_device_id = g_strdup (meta_color_device_get_id (color_device));
+  connector = g_strdup (meta_monitor_get_connector (monitor));
+
+  test_case_setup.outputs[0].connector_type = META_CONNECTOR_TYPE_HDMIA;
+  test_setup = meta_create_monitor_test_setup (backend, &test_case_setup,
+                                               MONITOR_TEST_FLAG_NO_STORED);
+  meta_monitor_manager_test_emulate_hotplug (monitor_manager_test, test_setup);
+
+  monitor =
+    META_MONITOR (meta_monitor_manager_get_monitors (monitor_manager)->data);
+  g_assert_cmpstr (meta_monitor_get_connector (monitor), !=, connector);
+  g_assert_cmpint (meta_color_manager_get_num_color_devices (color_manager),
+                   ==,
+                   1);
+  color_device = meta_color_manager_get_color_device (color_manager, monitor);
+  g_assert_nonnull (color_device);
+  g_assert_cmpstr (meta_color_device_get_id (color_device), ==, cd_device_id);
+  wait_for_device_registered (color_device);
+}
+
 static void
 meta_test_color_management_device_no_edid_no_gamma (void)
 {
@@ -1888,6 +2051,10 @@ init_tests (void)
                   meta_test_color_management_device_no_edid);
   add_color_test ("/color-management/device/no-edid-no-gamma",
                   meta_test_color_management_device_no_edid_no_gamma);
+  add_color_test ("/color-management/device/unplug-referenced",
+                  meta_test_color_management_device_unplug_referenced);
+  add_color_test ("/color-management/device/moved-connector",
+                  meta_test_color_management_device_moved_connector);
   add_color_test ("/color-management/profile/device",
                   meta_test_color_management_profile_device);
   add_color_test ("/color-management/profile/device-bogus",
