@@ -54,15 +54,44 @@ typedef struct
 G_DEFINE_TYPE (MetaColorStore, meta_color_store,
                G_TYPE_OBJECT)
 
+void
+meta_color_store_shutdown (MetaColorStore *color_store)
+{
+  g_cancellable_cancel (color_store->cancellable);
+
+  if (color_store->icc_directory_monitor)
+    {
+      g_signal_handlers_disconnect_by_data (color_store->icc_directory_monitor,
+                                            color_store);
+      g_file_monitor_cancel (color_store->icc_directory_monitor);
+      g_clear_object (&color_store->icc_directory_monitor);
+    }
+
+  /* Pending tasks own this store until their callbacks drain the waiters. */
+}
+
+static gboolean
+return_error_if_cancelled (MetaColorStore *color_store,
+                           GTask          *task)
+{
+  if (g_cancellable_is_cancelled (color_store->cancellable))
+    {
+      g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_CANCELLED,
+                               "Color store shut down");
+      return TRUE;
+    }
+
+  return g_task_return_error_if_cancelled (task);
+}
+
