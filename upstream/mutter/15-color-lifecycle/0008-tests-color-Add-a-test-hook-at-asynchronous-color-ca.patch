 G_DEFINE_TYPE (MetaColorStore, meta_color_store,
                G_TYPE_OBJECT)
 
+#ifdef HAVE_COLOR_LIFECYCLE_TESTS
+static MetaColorLifecycleTestHook lifecycle_test_hook;
+static gpointer lifecycle_test_hook_data;
+
+void
+meta_color_lifecycle_test_set_hook (MetaColorLifecycleTestHook hook,
+                                   gpointer                   hook_data)
+{
+  lifecycle_test_hook = hook;
+  lifecycle_test_hook_data = hook_data;
+}
+
+gboolean
+meta_color_lifecycle_test_intercept (const char          *point,
+                                    GObject             *source_object,
+                                    GAsyncResult        *result,
+                                    gpointer             callback_data,
+                                    GAsyncReadyCallback  callback)
+{
+  return lifecycle_test_hook &&
+    lifecycle_test_hook (point, source_object, result, callback_data, callback,
+                         lifecycle_test_hook_data);
+}
+#endif
