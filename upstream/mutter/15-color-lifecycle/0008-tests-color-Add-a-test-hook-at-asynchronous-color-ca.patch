diff --git a/src/backends/meta-color-lifecycle-test-private.h b/src/backends/meta-color-lifecycle-test-private.h
new file mode 100644
index 000000000..655162c83
--- /dev/null
+++ b/src/backends/meta-color-lifecycle-test-private.h
@@ -0,0 +1,42 @@
+/*
+ * Copyright (C) 2026 Paul Junod
+ *
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License as published by the
+ * Free Software Foundation; either version 2 of the License, or (at your
+ * option) any later version.
+ */
+
+#pragma once
+
+#include "config.h"
+
+#include <gio/gio.h>
+
+#include "core/util-private.h"
+
+#ifdef HAVE_COLOR_LIFECYCLE_TESTS
+/* Owning main context only. TRUE parks this delivery before ownership adoption.
+ * The test must replay the exact callback once with hooks detached. Only the
+ * source/result may be referenced by the queue; callback_data keeps its original
+ * borrowed/transferred ownership. No production queue or lifetime is added. */
+typedef gboolean (* MetaColorLifecycleTestHook) (const char          *point,
+                                                GObject             *source_object,
+                                                GAsyncResult        *result,
+                                                gpointer             callback_data,
+                                                GAsyncReadyCallback  callback,
+                                                gpointer             hook_data);
+
+META_EXPORT_TEST
+void meta_color_lifecycle_test_set_hook (MetaColorLifecycleTestHook hook,
+                                         gpointer                   hook_data);
+
+META_EXPORT_TEST
+gboolean meta_color_lifecycle_test_intercept (const char          *point,
+                                               GObject             *source_object,
+                                               GAsyncResult        *result,
+                                               gpointer             callback_data,
+                                               GAsyncReadyCallback  callback);
+#else
+#define meta_color_lifecycle_test_intercept(...) FALSE
+#endif
