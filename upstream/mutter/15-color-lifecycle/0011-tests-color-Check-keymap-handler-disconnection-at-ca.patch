From 7e3ff60417882f4f9dd3ece8437106b726ebe800 Mon Sep 17 00:00:00 2001
From: Paul Junod <donujp@gmail.com>
Date: Mon, 12 Oct 2026 22:04:37 +0000
Subject: [PATCH 11/11] tests/color: Check keymap handler disconnection at
 cancelled startup

When the color lifecycle test cancels startup, keep a separate
reference to the seat's keymap only, and check that the seat is
finalized and that none of its handlers remain connected to the keymap
afterwards.

Link: TBD-MR
---
 src/tests/color-lifecycle-tests.c | 23 ++++++++++++++++++++++-
 1 file changed, 22 insertions(+), 1 deletion(-)

diff --git a/src/tests/color-lifecycle-tests.c b/src/tests/color-lifecycle-tests.c
index f909da5ef..426582d9d 100644
--- a/src/tests/color-lifecycle-tests.c
+++ b/src/tests/color-lifecycle-tests.c
@@ -11,6 +11,7 @@
 
 #include <glib/gstdio.h>
 
+#include "backends/meta-backend-private.h"
 #include "backends/meta-color-device.h"
 #include "backends/meta-color-lifecycle-test-private.h"
 #include "backends/meta-color-manager-private.h"
@@ -375,13 +376,33 @@ test_startup (gconstpointer user_data)
 {
   gboolean queued_success = GPOINTER_TO_INT (user_data);
   Fixture fixture = { .hold_startup = TRUE };
+  g_autoptr (ClutterKeymap) keymap = NULL;
+  gpointer seat_identity = NULL;
+  gboolean seat_gone = FALSE;
 
   if (!run_in_fresh_process ())
     return;
 
   setup_fixture (&fixture, FALSE);
   if (!queued_success)
-    destroy_manager (&fixture);
+    {
+      ClutterSeat *seat = meta_backend_get_default_seat (
+        meta_context_get_backend (test_context));
+
+      /* Keep only a separate keymap ref, never a seat or manager ref. After
+       * weak finalization the saved address is opaque handler-data identity. */
+      keymap = g_object_ref (clutter_seat_get_keymap (seat));
+      seat_identity = seat;
+      watch (seat, &seat_gone);
+      g_assert_cmpuint (g_signal_handler_find (keymap, G_SIGNAL_MATCH_DATA,
+                                              0, 0, NULL, NULL,
+                                              seat_identity), !=, 0);
+      destroy_manager (&fixture);
+      g_assert_true (seat_gone);
+      g_assert_cmpuint (g_signal_handler_find (keymap, G_SIGNAL_MATCH_DATA,
+                                              0, 0, NULL, NULL,
+                                              seat_identity), ==, 0);
+    }
 
   while (g_queue_get_length (&fixture.deliveries) < 3)
     g_main_context_iteration (NULL, TRUE);
