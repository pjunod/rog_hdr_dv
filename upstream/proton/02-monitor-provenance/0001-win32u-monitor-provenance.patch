+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#ifndef __WINE_MONITOR_H
+#define __WINE_MONITOR_H
+
+#include "windef.h"
+#include "devpropdef.h"
+
+enum wine_monitor_origin
+{
+    WINE_MONITOR_ORIGIN_UNKNOWN,
+    WINE_MONITOR_ORIGIN_DISPLAY_SERVER,
+    WINE_MONITOR_ORIGIN_VIRTUAL,
+};
+
+#define WINE_MONITOR_OUTPUT_TECHNOLOGY_VALID 0x00000001
+/* The driver built the EDID itself (for example from the preferred mode) because
+ * the display provided none. It describes nothing about the display, so it must not
+ * be reported as the display's own descriptor. */
+#define WINE_MONITOR_EDID_SYNTHESIZED        0x00000002
+
+/* A zero-initialized provider has no known connector, even though HD15 is zero.
+ * DISPLAY_SERVER identifies the source of the facts, not physical hardware.
+ * VIRTUAL is reserved for a monitor explicitly synthesized by Wine. */
+struct wine_monitor_properties
+{
+    UINT32 flags;
+    UINT32 origin;
+    UINT32 output_technology;
+};
+
+DEFINE_DEVPROPKEY( WINE_DEVPROPKEY_MONITOR_PROPERTIES, 0x233a9ef3, 0xafc4, 0x4abd,
+                  0xb5, 0x64, 0xc3, 0x2f, 0x21, 0xf1, 0x53, 0x5b, 7 );
+
+/* Session mutex held by win32u while it rebuilds the display device nodes.
+ * win32u opens it by its full session path; Win32 code opens the same object
+ * through the local namespace, e.g. CreateMutexW( NULL, FALSE,
+ * L"" WINE_DISPLAY_DEVICE_INIT_MUTEX ). */
+#define WINE_DISPLAY_DEVICE_INIT_MUTEX "display_device_init"
+
+#endif /* __WINE_MONITOR_H */
