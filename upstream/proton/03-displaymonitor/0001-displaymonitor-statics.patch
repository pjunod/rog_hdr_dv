+static void test_connector_properties( HDEVINFO set, SP_DEVINFO_DATA *device, HKEY key, const WCHAR *id )
+{
+    static const struct
+    {
+        struct wine_monitor_properties properties;
+        HRESULT connection_hr;
+        DisplayMonitorConnectionKind connection;
+        DisplayMonitorPhysicalConnectorKind connector;
+    } cases[] =
+    {
+        /* HD15 is numerically zero, so validity, not the value, makes it known. */
+        {{WINE_MONITOR_OUTPUT_TECHNOLOGY_VALID, WINE_MONITOR_ORIGIN_DISPLAY_SERVER, DISPLAYCONFIG_OUTPUT_TECHNOLOGY_HD15},
+         S_OK, DisplayMonitorConnectionKind_Wired, DisplayMonitorPhysicalConnectorKind_HD15},
+        {{0, WINE_MONITOR_ORIGIN_DISPLAY_SERVER, DISPLAYCONFIG_OUTPUT_TECHNOLOGY_HD15},
+         __HRESULT_FROM_WIN32(ERROR_NOT_SUPPORTED), 0, DisplayMonitorPhysicalConnectorKind_Unknown},
+        {{WINE_MONITOR_OUTPUT_TECHNOLOGY_VALID, WINE_MONITOR_ORIGIN_DISPLAY_SERVER, DISPLAYCONFIG_OUTPUT_TECHNOLOGY_DISPLAYPORT_EMBEDDED},
+         S_OK, DisplayMonitorConnectionKind_Internal, DisplayMonitorPhysicalConnectorKind_DisplayPort},
+        {{0, WINE_MONITOR_ORIGIN_VIRTUAL, 0},
+         S_OK, DisplayMonitorConnectionKind_Virtual, DisplayMonitorPhysicalConnectorKind_Unknown},
+        /* Indirect displays name no physical connector; a USB tunnel carries DisplayPort. */
+        {{WINE_MONITOR_OUTPUT_TECHNOLOGY_VALID, WINE_MONITOR_ORIGIN_DISPLAY_SERVER, DISPLAYCONFIG_OUTPUT_TECHNOLOGY_INDIRECT_WIRED},
+         S_OK, DisplayMonitorConnectionKind_Wired, DisplayMonitorPhysicalConnectorKind_Unknown},
+        {{WINE_MONITOR_OUTPUT_TECHNOLOGY_VALID, WINE_MONITOR_ORIGIN_DISPLAY_SERVER, DISPLAYCONFIG_OUTPUT_TECHNOLOGY_INDIRECT_VIRTUAL},
+         S_OK, DisplayMonitorConnectionKind_Virtual, DisplayMonitorPhysicalConnectorKind_Unknown},
+        {{WINE_MONITOR_OUTPUT_TECHNOLOGY_VALID, WINE_MONITOR_ORIGIN_DISPLAY_SERVER, DISPLAYCONFIG_OUTPUT_TECHNOLOGY_DISPLAYPORT_USB_TUNNEL},
+         S_OK, DisplayMonitorConnectionKind_Wired, DisplayMonitorPhysicalConnectorKind_DisplayPort},
+    };
+    DisplayMonitorPhysicalConnectorKind connector;
+    DisplayMonitorConnectionKind connection;
+    struct wine_monitor_properties properties = {0};
+    DisplayMonitorUsageKind usage;
+    IReference_Size *reference;
+    IDisplayMonitor *monitor;
+    SizeInt32 resolution;
+    BYTE edid[256], *copy;
+    UINT32 i, length;
+    FLOAT value;
+    HRESULT hr;
+
+    /* Product primary use 0 declares no usage kind. */
+    make_edid( edid );
+    edid[131] = 0;
+    checksum( edid + 129, 37 );
+    checksum( edid + 128, 128 );
+    RegSetValueExW( key, L"EDID", 0, REG_BINARY, edid, sizeof(edid) );
+    for (i = 0; i < ARRAY_SIZE(cases); i++)
+    {
+        SetupDiSetDevicePropertyW( set, device, &WINE_DEVPROPKEY_MONITOR_PROPERTIES, DEVPROP_TYPE_BINARY,
+                                   (BYTE *)&cases[i].properties, sizeof(cases[i].properties), 0 );
+        hr = get_monitor( id, FALSE, &monitor );
+        ok( hr == S_OK, "Connector case %u creation hr %#lx.\n", i, hr );
+        if (FAILED(hr)) continue;
+        connection = -1;
+        hr = IDisplayMonitor_get_ConnectionKind( monitor, &connection );
+        ok( hr == cases[i].connection_hr, "Connector case %u connection hr %#lx.\n", i, hr );
+        if (SUCCEEDED(hr)) ok( connection == cases[i].connection, "Connector case %u connection %d.\n", i, connection );
+        hr = IDisplayMonitor_get_PhysicalConnector( monitor, &connector );
+        ok( hr == S_OK && connector == cases[i].connector, "Connector case %u connector %d.\n", i, connector );
+        /* A virtual origin is not evidence of a usage kind. */
+        hr = IDisplayMonitor_get_UsageKind( monitor, &usage );
+        ok( hr == HRESULT_FROM_WIN32(ERROR_NOT_SUPPORTED), "Connector case %u usage hr %#lx.\n", i, hr );
+        IDisplayMonitor_Release( monitor );
+    }
+
+    /* The same valid bytes describe the display unless the driver made them up. */
+    for (i = 0; i < 2; i++)
+    {
+        properties.flags = i ? WINE_MONITOR_EDID_SYNTHESIZED : 0;
+        properties.origin = WINE_MONITOR_ORIGIN_DISPLAY_SERVER;
+        SetupDiSetDevicePropertyW( set, device, &WINE_DEVPROPKEY_MONITOR_PROPERTIES, DEVPROP_TYPE_BINARY,
+                                   (BYTE *)&properties, sizeof(properties), 0 );
+        hr = get_monitor( id, FALSE, &monitor );
+        ok( hr == S_OK, "Synthesized case %u creation hr %#lx.\n", i, hr );
+        if (FAILED(hr)) continue;
+        hr = IDisplayMonitor_get_NativeResolutionInRawPixels( monitor, &resolution );
+        ok( i ? hr == HRESULT_FROM_WIN32(ERROR_NOT_SUPPORTED) : hr == S_OK,
+            "Synthesized case %u resolution hr %#lx.\n", i, hr );
+        hr = IDisplayMonitor_get_MaxLuminanceInNits( monitor, &value );
+        ok( i ? hr == HRESULT_FROM_WIN32(ERROR_NOT_SUPPORTED) : hr == S_OK,
+            "Synthesized case %u luminance hr %#lx.\n", i, hr );
+        reference = (void *)1;
+        hr = IDisplayMonitor_get_PhysicalSizeInInches( monitor, &reference );
+        ok( hr == S_OK && (i ? !reference : !!reference), "Synthesized case %u physical size hr %#lx.\n", i, hr );
+        if (reference) IReference_Size_Release( reference );
+        hr = IDisplayMonitor_GetDescriptor( monitor, DisplayMonitorDescriptorKind_Edid, &length, &copy );
+        ok( i ? hr == HRESULT_FROM_WIN32(ERROR_NOT_SUPPORTED) : hr == S_OK,
+            "Synthesized case %u descriptor hr %#lx.\n", i, hr );
+        if (SUCCEEDED(hr)) CoTaskMemFree( copy );
+        IDisplayMonitor_Release( monitor );
+    }
+}
+
+static void test_base_edid_facts( HKEY key, const WCHAR *id )
+{
+    static const BYTE chromaticities[10] = {0xee, 0x91, 0xa3, 0x54, 0x4c, 0x99, 0x26, 0x0f, 0x50, 0x54};
+    IDisplayMonitor *monitor;
+    SizeInt32 resolution;
+    BYTE edid[256];
+    HSTRING name;
+    Point point;
+    HRESULT hr;
+    UINT32 i;
+
+    /* Base EDID 1.4 only: colour characteristics and a native preferred timing. */
+    for (i = 0; i < 2; i++)
+    {
+        make_edid( edid );
+        edid[126] = 0;
+        memcpy( edid + 25, chromaticities, sizeof(chromaticities) );
+        edid[24] = 0x0a; /* preferred timing is the native format */
+        edid[54] = 0x01; edid[55] = 0x1d; /* non-zero pixel clock */
+        edid[56] = 0x00; edid[58] = 0xf0; /* 3840 active */
+        edid[59] = 0x70; edid[61] = 0x80; /* 2160 active */
+        if (i) edid[19] = 3; /* EDID 1.3 marks the timing preferred, not native */
+        checksum( edid, 128 );
+        RegSetValueExW( key, L"EDID", 0, REG_BINARY, edid, 128 );
+        hr = get_monitor( id, FALSE, &monitor );
+        ok( hr == S_OK, "Base EDID case %u creation hr %#lx.\n", i, hr );
+        if (FAILED(hr)) continue;
+        hr = IDisplayMonitor_get_RedPrimary( monitor, &point );
+        ok( hr == S_OK && fabsf( point.X - 655 / 1024.0f ) < 1e-6f && fabsf( point.Y - 338 / 1024.0f ) < 1e-6f,
+            "Base EDID case %u red hr %#lx, %f,%f.\n", i, hr, point.X, point.Y );
+        hr = IDisplayMonitor_get_NativeResolutionInRawPixels( monitor, &resolution );
+        if (i) ok( hr == HRESULT_FROM_WIN32(ERROR_NOT_SUPPORTED), "EDID 1.3 preferred timing used as native.\n" );
+        else ok( hr == S_OK && resolution.Width == 3840 && resolution.Height == 2160,
+                 "Base EDID native resolution hr %#lx, %dx%d.\n", hr, resolution.Width, resolution.Height );
+        hr = IDisplayMonitor_get_DisplayName( monitor, &name );
+        ok( hr == S_OK && !wcscmp( WindowsGetStringRawBuffer( name, NULL ), L"WINETEST OLED" ),
+            "Base EDID case %u name %s.\n", i, wine_dbgstr_w( WindowsGetStringRawBuffer( name, NULL ) ) );
+        WindowsDeleteString( name );
+        IDisplayMonitor_Release( monitor );
+    }
+
+    /* A reserved product primary use makes the DisplayID section opaque. */
+    make_edid( edid );
+    edid[131] = 0x55;
+    checksum( edid + 129, 37 );
+    checksum( edid + 128, 128 );
+    RegSetValueExW( key, L"EDID", 0, REG_BINARY, edid, sizeof(edid) );
+    hr = get_monitor( id, FALSE, &monitor );
+    ok( hr == S_OK, "Reserved use creation hr %#lx.\n", hr );
+    if (SUCCEEDED(hr))
+    {
+        UINT32 length;
+        BYTE *copy;
+
+        hr = IDisplayMonitor_get_NativeResolutionInRawPixels( monitor, &resolution );
+        ok( hr == HRESULT_FROM_WIN32(ERROR_NOT_SUPPORTED), "Reserved use native resolution hr %#lx.\n", hr );
+        hr = IDisplayMonitor_GetDescriptor( monitor, DisplayMonitorDescriptorKind_DisplayId, &length, &copy );
+        ok( hr == HRESULT_FROM_WIN32(ERROR_NOT_SUPPORTED), "Reserved use DisplayID copy hr %#lx.\n", hr );
+        if (SUCCEEDED(hr)) CoTaskMemFree( copy );
+        IDisplayMonitor_Release( monitor );
+    }
+}
