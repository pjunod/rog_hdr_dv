+/* Wine links the interfaces of the monitors it reports (Control\Linked = 1);
+ * a test-owned node needs the same state to be resolvable. Removing the test
+ * device deletes this key with the rest of the interface. */
+static BOOL set_interface_linked( const WCHAR *path, DWORD linked )
+{
+    WCHAR key_path[MAX_PATH];
+    HKEY key;
+    LONG ret;
+
+    swprintf( key_path, ARRAY_SIZE(key_path),
+              L"System\\CurrentControlSet\\Control\\DeviceClasses\\{E6F07B5F-EE97-4A90-B076-33F57BF4EAA7}\\##?#%s\\#\\Control",
+              path + 4 );
+    ret = RegCreateKeyExW( HKEY_LOCAL_MACHINE, key_path, 0, NULL, 0, KEY_SET_VALUE, NULL, &key, NULL );
+    if (ret) return FALSE;
+    ret = RegSetValueExW( key, L"Linked", 0, REG_DWORD, (BYTE *)&linked, sizeof(linked) );
+    RegCloseKey( key );
+    return !ret;
+}
