+static void test_factory(void)
+{
+    IActivationFactory *factory;
+    IInspectable *instance;
+    IUnknown *identity, *other;
+    HSTRING selector, name;
+    ULONG count;
+    IID *iids;
+    HRESULT hr;
+
+    hr = IDisplayMonitorStatics_QueryInterface( statics, &IID_IActivationFactory, (void **)&factory );
+    ok( hr == S_OK, "Factory QI hr %#lx.\n", hr );
+    if (FAILED(hr)) return;
+    IActivationFactory_QueryInterface( factory, &IID_IUnknown, (void **)&identity );
+    IDisplayMonitorStatics_QueryInterface( statics, &IID_IUnknown, (void **)&other );
+    ok( identity == other, "Factory COM identity differs.\n" );
+    IUnknown_Release( identity );
+    IUnknown_Release( other );
+    hr = IActivationFactory_ActivateInstance( factory, &instance );
+    ok( FAILED(hr), "Class unexpectedly supports default construction.\n" );
+    if (SUCCEEDED(hr)) IInspectable_Release( instance );
+    hr = IDisplayMonitorStatics_GetIids( statics, &count, &iids );
+    ok( hr == S_OK && count, "Factory metadata hr %#lx, count %lu.\n", hr, count );
+    if (SUCCEEDED(hr)) CoTaskMemFree( iids );
+    hr = IDisplayMonitorStatics_GetRuntimeClassName( statics, &name );
+    ok( hr == S_OK, "Class name hr %#lx.\n", hr );
+    if (SUCCEEDED(hr))
+    {
+        ok( !wcscmp( WindowsGetStringRawBuffer(name, NULL), RuntimeClass_Windows_Devices_Display_DisplayMonitor ),
+            "Incorrect class name.\n" );
+        WindowsDeleteString( name );
+    }
+    hr = IDisplayMonitorStatics_GetDeviceSelector( statics, &selector );
+    ok( hr == S_OK && WindowsGetStringLen(selector), "Selector hr %#lx.\n", hr );
+    if (SUCCEEDED(hr)) WindowsDeleteString( selector );
+    IActivationFactory_Release( factory );
+}
+
+static void test_real_interfaces(void)
+{
+    SP_DEVICE_INTERFACE_DATA iface = {.cbSize = sizeof(iface)};
+    SP_DEVICE_INTERFACE_DETAIL_DATA_W *detail;
+    SP_DEVINFO_DATA device = {.cbSize = sizeof(device)};
+    HDEVINFO set;
+    DWORD size, index;
+    IDisplayMonitor *monitor, *again;
+    HSTRING id;
+    HRESULT hr;
+
+    set = SetupDiGetClassDevsW( &monitor_interface, NULL, NULL, DIGCF_DEVICEINTERFACE | DIGCF_PRESENT );
+    if (set == INVALID_HANDLE_VALUE) return;
+    for (index = 0; SetupDiEnumDeviceInterfaces( set, NULL, &monitor_interface, index, &iface ); index++)
+    {
+        SetupDiGetDeviceInterfaceDetailW( set, &iface, NULL, 0, &size, NULL );
+        detail = malloc( size );
+        detail->cbSize = sizeof(*detail);
+        if (!SetupDiGetDeviceInterfaceDetailW( set, &iface, detail, size, NULL, &device ))
+        {
+            free( detail );
+            continue;
+        }
+        hr = get_monitor( detail->DevicePath, TRUE, &monitor );
+        ok( hr == S_OK, "Real monitor interface resolution hr %#lx.\n", hr );
+        if (SUCCEEDED(hr))
+        {
+            DisplayAdapterId adapter;
+            HSTRING adapter_id;
+
+            /* A monitor that reports its adapter LUID must also resolve the adapter. */
+            if (IDisplayMonitor_get_DisplayAdapterId( monitor, &adapter ) == S_OK)
+            {
+                hr = IDisplayMonitor_get_DisplayAdapterDeviceId( monitor, &adapter_id );
+                ok( hr == S_OK && WindowsGetStringLen(adapter_id), "Adapter device id hr %#lx.\n", hr );
+                WindowsDeleteString( adapter_id );
+            }
+            hr = IDisplayMonitor_get_DeviceId( monitor, &id );
+            ok( hr == S_OK && WindowsGetStringLen(id), "DeviceId hr %#lx.\n", hr );
+            if (SUCCEEDED(hr))
+            {
+                hr = get_monitor( WindowsGetStringRawBuffer(id, NULL), FALSE, &again );
+                ok( hr == S_OK, "DeviceId roundtrip hr %#lx.\n", hr );
+                if (SUCCEEDED(hr)) IDisplayMonitor_Release( again );
+                WindowsDeleteString( id );
+            }
+            IDisplayMonitor_Release( monitor );
+        }
+        free( detail );
+    }
+    /* Zero interfaces is a genuine headless result. Never synthesize one. */
+    SetupDiDestroyDeviceInfoList( set );
+}
+
+static void checksum( BYTE *data, UINT32 size )
+{
+    UINT32 i;
+    BYTE sum = 0;
+    data[size - 1] = 0;
+    for (i = 0; i < size - 1; i++) sum += data[i];
+    data[size - 1] = -sum;
+}
+
+static void make_edid( BYTE *edid )
+{
+    static const BYTE header[] = {0,255,255,255,255,255,255,0};
+    BYTE *section = edid + 129, *block = section + 4;
+    memset( edid, 0, 256 );
+    memcpy( edid, header, sizeof(header) );
+    edid[18] = 1;
+    edid[19] = 4;
+    edid[21] = 60; /* Deliberately differs from native 30 cm width. */
+    edid[22] = 40;
+    memcpy( edid + 72, "\0\0\0\xfc\0WINETEST OLED", 18 ); /* monitor name descriptor */
+    edid[126] = 1;
+    edid[128] = 0x70;
+    section[0] = 0x20;
+    section[1] = 32;
+    section[2] = 4;
+    block[0] = 0x21;
+    block[2] = 29;
+    block[3] = 0xb8; block[4] = 0x0b; /* 300 mm in 0.1 mm units. */
+    block[5] = 0xd0; block[6] = 7; /* 200 mm */
+    block[7] = 0x80; block[8] = 7; /* 1920 */
+    block[9] = 0x38; block[10] = 4; /* 1080 */
+    block[12] = 0x33; block[13] = 0x36; block[14] = 0x53;
+    block[24] = 0x40; block[25] = 0x5e; /* 400 */
+    block[26] = 0xd0; block[27] = 0x60; /* 616 */
+    block[28] = 0; block[29] = 0x34; /* 0.25 */
+    checksum( section, 37 );
+    checksum( edid, 128 );
+    checksum( edid + 128, 128 );
+}
+
+
+static void test_descriptor_cases( HKEY key, const WCHAR *id )
+{
+    static const struct
+    {
+        UINT32 offset;
+        UINT16 bits;
+        BOOL has_max, has_full, has_min, has_native;
+        FLOAT max;
+    } cases[] =
+    {
+        {26, 0x0000, TRUE, TRUE, TRUE, TRUE, 0},
+        {26, 0x0001, TRUE, TRUE, TRUE, TRUE, 1.0f / 16777216},
+        {26, 0x8000, FALSE, TRUE, TRUE, TRUE, 0},
+        {26, 0xbc00, FALSE, TRUE, TRUE, TRUE, 0},
+        {26, 0x7c00, FALSE, TRUE, TRUE, TRUE, 0},
+        {26, 0x7e00, FALSE, TRUE, TRUE, TRUE, 0},
+        {24, 0x7e00, TRUE, FALSE, TRUE, TRUE, 616},
+        {28, 0x8000, TRUE, TRUE, FALSE, TRUE, 616},
+        {1,  0x1d02, FALSE, FALSE, FALSE, FALSE, 0}, /* unknown revision, exact length */
+        {11, 0x3308, FALSE, FALSE, FALSE, TRUE, 0}, /* source guidance is not physical */
+        {2,  0xb81c, FALSE, FALSE, FALSE, FALSE, 0}, /* 28-byte payload is not the known layout */
+        {2,  0xb81b, FALSE, FALSE, FALSE, FALSE, 0}, /* 27-byte payload leaves a non-zero short tail */
+    };
+    IDisplayMonitor *monitor;
+    SizeInt32 resolution;
+    BYTE edid[256], *copy;
+    UINT32 i, length;
+    FLOAT value;
+    HRESULT hr;
+
+    for (i = 0; i < ARRAY_SIZE(cases); i++)
+    {
+        make_edid( edid );
+        edid[133 + cases[i].offset] = cases[i].bits;
+        edid[134 + cases[i].offset] = cases[i].bits >> 8;
+        checksum( edid + 129, 37 );
+        checksum( edid + 128, 128 );
+        RegSetValueExW( key, L"EDID", 0, REG_BINARY, edid, sizeof(edid) );
+        hr = get_monitor( id, FALSE, &monitor );
+        ok( hr == S_OK, "Descriptor case %u creation hr %#lx.\n", i, hr );
+        if (FAILED(hr)) continue;
+        value = -1;
+        hr = IDisplayMonitor_get_MaxLuminanceInNits( monitor, &value );
+        ok( hr == (cases[i].has_max ? S_OK : HRESULT_FROM_WIN32(ERROR_NOT_SUPPORTED)),
+            "Case %u maximum hr %#lx.\n", i, hr );
+        if (cases[i].has_max) ok( value == cases[i].max, "Case %u maximum %f.\n", i, value );
+        hr = IDisplayMonitor_get_MaxAverageFullFrameLuminanceInNits( monitor, &value );
+        ok( hr == (cases[i].has_full ? S_OK : HRESULT_FROM_WIN32(ERROR_NOT_SUPPORTED)),
+            "Case %u full-frame hr %#lx.\n", i, hr );
+        if (cases[i].has_full) ok( value == 400, "Case %u full-frame %f.\n", i, value );
+        hr = IDisplayMonitor_get_MinLuminanceInNits( monitor, &value );
+        ok( hr == (cases[i].has_min ? S_OK : HRESULT_FROM_WIN32(ERROR_NOT_SUPPORTED)),
+            "Case %u minimum hr %#lx.\n", i, hr );
+        if (cases[i].has_min) ok( value == 0.25f, "Case %u minimum %f.\n", i, value );
+        hr = IDisplayMonitor_get_NativeResolutionInRawPixels( monitor, &resolution );
+        ok( hr == (cases[i].has_native ? S_OK : HRESULT_FROM_WIN32(ERROR_NOT_SUPPORTED)),
+            "Case %u native resolution hr %#lx.\n", i, hr );
+        IDisplayMonitor_Release( monitor );
+    }
+    /* A validated EDID is returned as an owned copy of its actual bytes. */
+    make_edid( edid );
+    RegSetValueExW( key, L"EDID", 0, REG_BINARY, edid, sizeof(edid) );
+    hr = get_monitor( id, FALSE, &monitor );
+    ok( hr == S_OK, "Valid descriptor object hr %#lx.\n", hr );
+    if (SUCCEEDED(hr))
+    {
+        hr = IDisplayMonitor_GetDescriptor( monitor, DisplayMonitorDescriptorKind_Edid, &length, &copy );
+        ok( hr == S_OK && length == sizeof(edid) && !memcmp(copy, edid, sizeof(edid)),
+            "Valid descriptor hr %#lx, length %u.\n", hr, length );
+        IDisplayMonitor_Release( monitor );
+        if (SUCCEEDED(hr))
+        {
+            ok( !memcmp(copy, edid, sizeof(edid)), "Copy lifetime depends on object.\n" );
+            CoTaskMemFree( copy );
+        }
+    }
+
+    /* A trailing block beyond the declared extension count is not part of
+     * the descriptor. */
+    make_edid( edid );
+    edid[126] = 0;
+    checksum( edid, 128 );
+    RegSetValueExW( key, L"EDID", 0, REG_BINARY, edid, sizeof(edid) );
+    hr = get_monitor( id, FALSE, &monitor );
+    ok( hr == S_OK, "Trailing block descriptor object hr %#lx.\n", hr );
+    if (SUCCEEDED(hr))
+    {
+        hr = IDisplayMonitor_GetDescriptor( monitor, DisplayMonitorDescriptorKind_Edid, &length, &copy );
+        ok( hr == S_OK && length == 128 && !memcmp(copy, edid, 128),
+            "Trailing block descriptor hr %#lx, length %u.\n", hr, length );
+        if (SUCCEEDED(hr)) CoTaskMemFree( copy );
+        hr = IDisplayMonitor_GetDescriptor( monitor, DisplayMonitorDescriptorKind_DisplayId, &length, &copy );
+        ok( hr == HRESULT_FROM_WIN32(ERROR_NOT_SUPPORTED), "Trailing block DisplayID hr %#lx.\n", hr );
+        if (SUCCEEDED(hr)) CoTaskMemFree( copy );
+        IDisplayMonitor_Release( monitor );
+    }
+
+    /* A truncated extension list cannot claim native fields, and the
+     * rejected bytes are not returned as the monitor's EDID. */
+    make_edid( edid );
+    RegSetValueExW( key, L"EDID", 0, REG_BINARY, edid, 128 );
+    hr = get_monitor( id, FALSE, &monitor );
+    ok( hr == S_OK, "Truncated descriptor object hr %#lx.\n", hr );
+    if (SUCCEEDED(hr))
+    {
+        hr = IDisplayMonitor_get_MaxLuminanceInNits( monitor, &value );
+        ok( hr == HRESULT_FROM_WIN32(ERROR_NOT_SUPPORTED), "Truncated native field hr %#lx.\n", hr );
+        copy = (BYTE *)0xdeadbeef;
+        length = 0xdeadbeef;
+        hr = IDisplayMonitor_GetDescriptor( monitor, DisplayMonitorDescriptorKind_Edid, &length, &copy );
+        ok( hr == HRESULT_FROM_WIN32(ERROR_NOT_SUPPORTED), "Truncated descriptor hr %#lx.\n", hr );
+        ok( !length && !copy, "Truncated descriptor length %u, copy %p.\n", length, copy );
+        if (SUCCEEDED(hr)) CoTaskMemFree( copy );
+        IDisplayMonitor_Release( monitor );
+    }
+
+    /* A block with a bad checksum invalidates the whole EDID. */
+    make_edid( edid );
+    edid[200] ^= 0x01;
+    RegSetValueExW( key, L"EDID", 0, REG_BINARY, edid, sizeof(edid) );
+    hr = get_monitor( id, FALSE, &monitor );
+    ok( hr == S_OK, "Bad checksum descriptor object hr %#lx.\n", hr );
+    if (SUCCEEDED(hr))
+    {
+        hr = IDisplayMonitor_GetDescriptor( monitor, DisplayMonitorDescriptorKind_Edid, &length, &copy );
+        ok( hr == HRESULT_FROM_WIN32(ERROR_NOT_SUPPORTED), "Bad checksum descriptor hr %#lx.\n", hr );
+        if (SUCCEEDED(hr)) CoTaskMemFree( copy );
+        hr = IDisplayMonitor_GetDescriptor( monitor, DisplayMonitorDescriptorKind_DisplayId, &length, &copy );
+        ok( hr == HRESULT_FROM_WIN32(ERROR_NOT_SUPPORTED), "Bad checksum DisplayID hr %#lx.\n", hr );
+        if (SUCCEEDED(hr)) CoTaskMemFree( copy );
+        IDisplayMonitor_Release( monitor );
+    }
+}
+
+static void set_point( BYTE *data, UINT16 a, UINT16 b )
+{
+    data[0] = a & 0xff;
+    data[1] = (a >> 8) | ((b & 15) << 4);
+    data[2] = b >> 4;
+}
+
+static void set_points( BYTE *edid, const UINT16 points[4][2], BYTE features )
+{
+    BYTE *block = edid + 133;
+    UINT32 i;
+
+    for (i = 0; i < 4; i++) set_point( block + 12 + 3 * i, points[i][0], points[i][1] );
+    block[11] = features;
+    checksum( edid + 129, 37 );
+    checksum( edid + 128, 128 );
+}
+
+static void test_descriptor_chromaticities( HKEY key, const WCHAR *id )
+{
+    static const UINT16 xy[4][2] = {{2816, 1280}, {1024, 2816}, {512, 256}, {1280, 1344}};
+    static const UINT16 uv[4][2] = {{1024, 2304}, {512, 2304}, {719, 647}, {810, 1918}};
+    static const UINT16 off_domain[4][2] = {{2816, 1281}, {1024, 2816}, {512, 256}, {1280, 1344}};
+    static const UINT16 zero_y[4][2] = {{2816, 1280}, {1024, 2816}, {512, 0}, {1280, 1344}};
+    static const struct
+    {
+        const UINT16 (*points)[2];
+        BYTE features;
+        BOOL available;
+        FLOAT red_x, red_y;
+    } cases[] =
+    {
+        {xy, 0x00, TRUE, 2816 / 4096.0f, 1280 / 4096.0f},
+        {xy, 0x18, TRUE, 2816 / 4096.0f, 1280 / 4096.0f}, /* luminance class is independent */
+        {xy, 0x20, FALSE}, /* feature bit 5 is not understood */
+        {off_domain, 0x00, FALSE}, /* x + y > 1 */
+        {zero_y, 0x00, FALSE},
+        {uv, 0x40, TRUE, 0.5f, 0.5f}, /* CIE 1976 u'v' converted to xy */
+    };
+    IDisplayMonitor *monitor;
+    BYTE edid[256], *section = edid + 129;
+    SizeInt32 resolution;
+    Point point;
+    UINT32 i;
+    HRESULT hr;
+
+    for (i = 0; i < ARRAY_SIZE(cases); i++)
+    {
+        make_edid( edid );
+        set_points( edid, cases[i].points, cases[i].features );
+        RegSetValueExW( key, L"EDID", 0, REG_BINARY, edid, sizeof(edid) );
+        hr = get_monitor( id, FALSE, &monitor );
+        ok( hr == S_OK, "Chromaticity case %u creation hr %#lx.\n", i, hr );
+        if (FAILED(hr)) continue;
+        memset( &point, 0, sizeof(point) );
+        hr = IDisplayMonitor_get_RedPrimary( monitor, &point );
+        ok( hr == (cases[i].available ? S_OK : HRESULT_FROM_WIN32(ERROR_NOT_SUPPORTED)),
+            "Chromaticity case %u red hr %#lx.\n", i, hr );
+        if (cases[i].available)
+            ok( fabsf( point.X - cases[i].red_x ) < 1e-6f && fabsf( point.Y - cases[i].red_y ) < 1e-6f,
+                "Chromaticity case %u red %f,%f.\n", i, point.X, point.Y );
+        hr = IDisplayMonitor_get_WhitePoint( monitor, &point );
+        ok( hr == (cases[i].available ? S_OK : HRESULT_FROM_WIN32(ERROR_NOT_SUPPORTED)),
+            "Chromaticity case %u white hr %#lx.\n", i, hr );
+        hr = IDisplayMonitor_get_NativeResolutionInRawPixels( monitor, &resolution );
+        ok( hr == S_OK, "Chromaticity case %u native resolution hr %#lx.\n", i, hr );
+        IDisplayMonitor_Release( monitor );
+    }
+
+    /* Zero filler after the last data block is valid; non-zero filler makes
+     * the whole DisplayID section untrustworthy. */
+    for (i = 0; i < 2; i++)
+    {
+        make_edid( edid );
+        set_points( edid, xy, 0 );
+        section[1] = 40;
+        memset( section + 36, 0, 8 );
+        if (i) section[40] = 1;
+        checksum( section, 45 );
+        checksum( edid + 128, 128 );
+        RegSetValueExW( key, L"EDID", 0, REG_BINARY, edid, sizeof(edid) );
+        hr = get_monitor( id, FALSE, &monitor );
+        ok( hr == S_OK, "Filler case %u creation hr %#lx.\n", i, hr );
+        if (FAILED(hr)) continue;
+        hr = IDisplayMonitor_get_NativeResolutionInRawPixels( monitor, &resolution );
+        ok( hr == (i ? HRESULT_FROM_WIN32(ERROR_NOT_SUPPORTED) : S_OK), "Filler case %u hr %#lx.\n", i, hr );
+        IDisplayMonitor_Release( monitor );
+    }
+}
