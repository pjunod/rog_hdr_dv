diff --git a/dlls/windows.devices.display/descriptor.c b/dlls/windows.devices.display/descriptor.c
new file mode 100644
index 00000000000..616eca428fd
--- /dev/null
+++ b/dlls/windows.devices.display/descriptor.c
@@ -0,0 +1,246 @@
+/* Descriptor-backed monitor facts. No signal-space defaults or CTA desired
+ * content luminance are substituted for native physical properties.
+ *
+ * Copyright 2026 Paul Junod
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#include <math.h>
+#include "private.h"
+
+static BOOL checksum_valid( const BYTE *data, UINT32 size )
+{
+    BYTE sum = 0;
+    UINT32 i;
+    for (i = 0; i < size; i++) sum += data[i];
+    return !sum;
+}
+
+static UINT32 read_u16( const BYTE *data )
+{
+    return data[0] | (data[1] << 8);
+}
+
+static BOOL physical_luminance( const BYTE *data, FLOAT *value )
+{
+    UINT32 bits = read_u16( data ), exponent = (bits >> 10) & 31, fraction = bits & 1023;
+
+    /* Signed values include the do-not-use negative-zero sentinel. */
+    if ((bits & 0x8000) || exponent == 31) return FALSE;
+    if (!exponent) *value = ldexpf( fraction, -24 );
+    else *value = ldexpf( fraction | 1024, (int)exponent - 25 );
+    return TRUE;
+}
+
+/* Decode one 12-bit chromaticity pair. CIE 1976 u'v' is converted with
+ * xy = (9u', 4v') / (6u' - 16v' + 12); domain checks stay integral so the
+ * exact x + y = 1 boundary is not subject to rounding. */
+static BOOL native_chromaticity( const BYTE *data, BOOL cie1976, Point *point )
+{
+    INT32 a = data[0] | ((data[1] & 15) << 8), b = (data[1] >> 4) | (data[2] << 4), denominator;
+
+    if (!cie1976)
+    {
+        if (!b || a + b > 4096) return FALSE;
+        point->X = a / 4096.0f;
+        point->Y = b / 4096.0f;
+        return TRUE;
+    }
+    denominator = 6 * a - 16 * b + 12 * 4096;
+    if (denominator <= 0 || !b || 9 * a + 4 * b > denominator) return FALSE;
+    point->X = 9.0f * a / denominator;
+    point->Y = 4.0f * b / denominator;
+    return TRUE;
+}
+
+static void parse_native_parameters( const BYTE *block, struct monitor_descriptor *descriptor )
+{
+    UINT32 width, height, i;
+    FLOAT units;
+
+    /* DisplayID 2.0/2.1 tag 0x21: 29-byte payload, revision 0 or 1.
+     * Header bit 7 changes image-size units; other unknown header bits are
+     * not guessed. Native geometry/color and luminance availability are
+     * independent. Feature bits 4:3 distinguish physical guarantees from
+     * source guidance; only the former is a physical luminance source.
+     */
+    if (block[2] != 29 || (block[1] & 0x7f) > 1) return;
+    width = read_u16( block + 7 );
+    height = read_u16( block + 9 );
+    if (width && height)
+    {
+        descriptor->native_resolution.Width = width;
+        descriptor->native_resolution.Height = height;
+        descriptor->flags |= MONITOR_NATIVE_RESOLUTION;
+    }
+    units = (block[1] & 0x80) ? 1.0f : 0.1f;
+    width = read_u16( block + 3 );
+    height = read_u16( block + 5 );
+    if (width && height)
+    {
+        descriptor->physical_size.Width = width * units / 25.4f;
+        descriptor->physical_size.Height = height * units / 25.4f;
+        descriptor->flags |= MONITOR_PHYSICAL_SIZE;
+    }
+    /* Native RGBW, as raw 12-bit counts over 4096. Feature bit 6 selects
+     * CIE 1976 u'v' instead of CIE 1931 xy; bit 5 is not understood, so the
+     * declaration is left unavailable rather than guessed. Every point must
+     * lie in the chromaticity domain or none is exposed. */
+    if (!(block[11] & 0x20))
+    {
+        BOOL cie1976 = !!(block[11] & 0x40);
+        Point points[4];
+
+        for (i = 0; i < 4; i++)
+            if (!native_chromaticity( block + 12 + 3 * i, cie1976, &points[i] )) break;
+        if (i == 4)
+        {
+            memcpy( descriptor->primaries, points, sizeof(points) );
+            descriptor->flags |= MONITOR_NATIVE_PRIMARIES;
+        }
+    }
+    if (!(block[11] & 0x18))
+    {
+        if (physical_luminance( block + 24, &descriptor->full_luminance ))
+            descriptor->flags |= MONITOR_FULL_LUMINANCE;
+        if (physical_luminance( block + 26, &descriptor->max_luminance ))
+            descriptor->flags |= MONITOR_MAX_LUMINANCE;
+        if (physical_luminance( block + 28, &descriptor->min_luminance ))
+            descriptor->flags |= MONITOR_MIN_LUMINANCE;
+    }
+}
+
+/* EDID 1.4 colour characteristics (bytes 0x19-0x22) are the display's own
+ * chromaticities as 10-bit fractions of 1024. Like the native declaration,
+ * all four points must lie in the chromaticity domain or none is used. */
+static BOOL edid_chromaticities( const BYTE *edid, Point points[4] )
+{
+    static const struct { BYTE high, low, shift; } fields[8] =
+    {
+        {0x1b, 0x19, 6}, {0x1c, 0x19, 4}, {0x1d, 0x19, 2}, {0x1e, 0x19, 0},
+        {0x1f, 0x1a, 6}, {0x20, 0x1a, 4}, {0x21, 0x1a, 2}, {0x22, 0x1a, 0},
+    };
+    UINT32 value[8], i;
+
+    for (i = 0; i < 8; i++) value[i] = (edid[fields[i].high] << 2) | ((edid[fields[i].low] >> fields[i].shift) & 3);
+    for (i = 0; i < 4; i++)
+    {
+        if (!value[2 * i + 1] || value[2 * i] + value[2 * i + 1] > 1024) return FALSE;
+        points[i].X = value[2 * i] / 1024.0f;
+        points[i].Y = value[2 * i + 1] / 1024.0f;
+    }
+    return TRUE;
+}
+
+/* In EDID 1.4, feature bit 1 states that the first detailed timing is the
+ * native pixel format. Earlier revisions only mark it preferred. */
+static BOOL edid_native_resolution( const BYTE *edid, SizeInt32 *size )
+{
+    const BYTE *timing = edid + 54;
+    UINT32 width, height;
+
+    if (edid[19] < 4 || !(edid[24] & 2) || !(timing[0] | timing[1]) || (timing[17] & 0x80)) return FALSE;
+    width = timing[2] | ((timing[4] & 0xf0) << 4);
+    height = timing[5] | ((timing[7] & 0xf0) << 4);
+    if (!width || !height) return FALSE;
+    size->Width = width;
+    size->Height = height;
+    return TRUE;
+}
+
+void monitor_descriptor_parse( const BYTE *edid, UINT32 size, struct monitor_descriptor *descriptor )
+{
+    static const BYTE header[] = {0, 255, 255, 255, 255, 255, 255, 0};
+    struct monitor_descriptor native = {0};
+    const BYTE *parameters = NULL, *first = NULL, *section, *block;
+    UINT32 count, i, offset, length, section_size, displayid_count = 0;
+    BOOL duplicate_parameters = FALSE;
+
+    memset( descriptor, 0, sizeof(*descriptor) );
+    if (!edid || size < 128 || size > DISPLAYMONITOR_MAX_EDID_SIZE || size % 128 ||
+        memcmp( edid, header, sizeof(header) ) || edid[18] != 1) return;
+    count = edid[126] + 1;
+    if (count * 128 > size) return;
+    for (i = 0; i < count; i++) if (!checksum_valid( edid + 128 * i, 128 )) return;
+    descriptor->flags |= MONITOR_EDID_VALID;
+    descriptor->edid_size = count * 128;
+    if (edid_chromaticities( edid, descriptor->primaries )) descriptor->flags |= MONITOR_NATIVE_PRIMARIES;
+    if (edid_native_resolution( edid, &descriptor->native_resolution )) descriptor->flags |= MONITOR_NATIVE_RESOLUTION;
+
+    /* Non-zero base dimensions are physical centimetres. A zero dimension
+     * can instead encode aspect ratio, so it is not a physical measurement. */
+    if (edid[21] && edid[22])
+    {
+        descriptor->physical_size.Width = edid[21] / 2.54f;
+        descriptor->physical_size.Height = edid[22] / 2.54f;
+        descriptor->flags |= MONITOR_PHYSICAL_SIZE;
+    }
+
+    for (i = 1; i < count; i++)
+    {
+        if (edid[128 * i] != 0x70) continue;
+        section = edid + 128 * i + 1;
+        /* Leave older and unknown DisplayID layouts opaque. */
+        if (section[0] != 0x20 && section[0] != 0x21) return;
+        section_size = section[1] + 5;
+        if (section_size > 126 || !checksum_valid( section, section_size )) return;
+        /* Product primary use cases above 8 are reserved; such a section is
+         * not a DisplayID 2.x structure we can interpret. */
+        if (section[2] > 8) return;
+        if (!first) first = section;
+        displayid_count++;
+        for (offset = 4; offset < section_size - 1; offset += length)
+        {
+            block = section + offset;
+            /* A short tail or an all-zero block header starts the filler,
+             * which must be zero up to the checksum. */
+            if (section_size - 1 - offset < 3 || !(block[0] | block[1] | block[2]))
+            {
+                for (; offset < section_size - 1; offset++) if (section[offset]) return;
+                break;
+            }
+            length = block[2] + 3;
+            if (length > section_size - 1 - offset) return;
+            if (block[0] != 0x21) continue;
+            if (parameters) duplicate_parameters = TRUE;
+            else parameters = block;
+        }
+    }
+    if (!first || first[3] + 1 != displayid_count) return;
+    /* A single native DisplayID section is copied directly without the EDID
+     * extension tag or padding. Multi-section byte-array representation
+     * remains a native-Windows qualification gap; do not reserialize it. */
+    if (displayid_count == 1)
+    {
+        descriptor->displayid_offset = first - edid;
+        descriptor->displayid_size = first[1] + 5;
+    }
+    switch (first[2])
+    {
+    case 2: case 3: case 4: case 5: case 6:
+        descriptor->usage = DisplayMonitorUsageKind_Standard;
+        descriptor->flags |= MONITOR_USAGE;
+        break;
+    case 7: case 8:
+        descriptor->usage = DisplayMonitorUsageKind_HeadMounted;
+        descriptor->flags |= MONITOR_USAGE;
+        break;
+    }
+    /* Conflicting or repeated native parameters cannot select a physical
+     * value by arbitrary ordering. Other known physical facts remain usable. */
+    if (!parameters || duplicate_parameters) return;
+    parse_native_parameters( parameters, &native );
+    /* The DisplayID declaration takes precedence for each fact it provides;
+     * base EDID facts remain for the ones it leaves unavailable. */
+    if (native.flags & MONITOR_PHYSICAL_SIZE) descriptor->physical_size = native.physical_size;
+    if (native.flags & MONITOR_NATIVE_RESOLUTION) descriptor->native_resolution = native.native_resolution;
+    if (native.flags & MONITOR_NATIVE_PRIMARIES) memcpy( descriptor->primaries, native.primaries, sizeof(native.primaries) );
+    descriptor->max_luminance = native.max_luminance;
+    descriptor->min_luminance = native.min_luminance;
+    descriptor->full_luminance = native.full_luminance;
+    descriptor->flags |= native.flags;
+}
