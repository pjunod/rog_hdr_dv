+static void test_async_lifetime(void)
+{
+    static const WCHAR missing[] = L"ROOT\\WINETEST_MISSING_DISPLAYMONITOR\\0";
+    IAsyncOperation_DisplayMonitor *operation;
+    IAsyncInfo *info;
+    IDisplayMonitor *monitor;
+    IUnknown *identity, *other;
+    AsyncStatus before, after;
+    HSTRING id;
+    HRESULT hr;
+    DWORD start;
+
+    WindowsCreateString( missing, ARRAY_SIZE(missing) - 1, &id );
+    hr = IDisplayMonitorStatics_FromIdAsync( statics, id, &operation );
+    WindowsDeleteString( id );
+    ok( hr == S_OK, "Missing ID operation creation hr %#lx.\n", hr );
+    if (FAILED(hr)) return;
+    hr = IAsyncOperation_DisplayMonitor_QueryInterface( operation, &IID_IAsyncInfo, (void **)&info );
+    ok( hr == S_OK, "IAsyncInfo hr %#lx.\n", hr );
+    if (FAILED(hr)) goto done;
+    IAsyncOperation_DisplayMonitor_QueryInterface( operation, &IID_IUnknown, (void **)&identity );
+    IAsyncInfo_QueryInterface( info, &IID_IUnknown, (void **)&other );
+    ok( identity == other, "Async operation COM identity differs.\n" );
+    IUnknown_Release( identity );
+    IUnknown_Release( other );
+    IAsyncInfo_Cancel( info );
+    IAsyncInfo_get_Status( info, &before );
+    for (start = GetTickCount(); GetTickCount() - start < 50; Sleep(1))
+    {
+        IAsyncInfo_get_Status( info, &after );
+        ok( before == after, "Terminal state changed %u -> %u.\n", before, after );
+    }
+    monitor = (void *)0xdeadbeef;
+    hr = IAsyncOperation_DisplayMonitor_GetResults( operation, &monitor );
+    ok( FAILED(hr) && !monitor, "Missing/canceled operation returned a monitor, hr %#lx.\n", hr );
+    hr = IAsyncInfo_Close( info );
+    ok( hr == S_OK, "Close hr %#lx.\n", hr );
+    hr = IAsyncOperation_DisplayMonitor_GetResults( operation, &monitor );
+    ok( hr == E_ILLEGAL_METHOD_CALL, "Closed GetResults hr %#lx.\n", hr );
+    IAsyncInfo_Release( info );
+done:
+    IAsyncOperation_DisplayMonitor_Release( operation );
+}
