 1 file changed, 1 insertion(+)

diff --git a/meson.build b/meson.build
index 85d16a0..c364c9c 100644
--- a/meson.build
+++ b/meson.build
@@ -13,6 +13,7 @@ project('libplacebo', ['c', 'cpp'],
     # API version
     {
       '364': 'private OPEN absolute-PQ SOP domain, separate from observer ABI363',
+      '363': 'reserved for separate private observer candidate; no observer code here',
       '362': 'private OPEN analytic PQ-Hermite and typed target-PQ SOP candidate',
       '361': 'experimental frame-owned open Dolby DM and explicit average presence',
       '360': 'add pl_d3d11_swapchain_params.{alpha,color}_bits',
