diff --git a/src/tests/dovi_dm.c b/src/tests/dovi_dm.c
new file mode 100644
index 0000000..566a058
--- /dev/null
+++ b/src/tests/dovi_dm.c
@@ -0,0 +1,48 @@
+/* Numerical boundary regressions, NOT authored RPU/trim/reference fixtures.
+ * Execute only in the one post-review batch. LGPL-2.1-or-later.
+ */
+#include <assert.h>
+#include <math.h>
+#include <string.h>
+#include <libplacebo/dovi_dm.h>
+
+int main(void)
+{
+    struct pl_tone_map_params tone = {
+        .function = &pl_tone_map_st2094_10,
+        .constants = { PL_TONE_MAP_CONSTANTS },
+        .input_scaling = PL_HDR_PQ, .output_scaling = PL_HDR_PQ,
+        .lut_size = 256, .input_min = 0.0f, .input_avg = 0.0f,
+        .input_avg_present = true, .input_max = 1.0f,
+        .output_min = 0.0f, .output_max = 0.75f,
+    };
+    float lut[256];
+    assert(pl_dovi_dm_generate(lut, &tone));
+    for (int i = 0; i < 256; i++) {
+        assert(isfinite(lut[i]));
+        assert(lut[i] >= tone.output_min && lut[i] <= tone.output_max);
+        assert(i == 0 || lut[i] + 1e-6f >= lut[i-1]);
+    }
+    // The DM generator, unlike generic inference, must never impose 100 nits.
+    tone.input_max = pl_hdr_rescale(PL_HDR_NITS, PL_HDR_PQ, 1.0f);
+    tone.input_avg = tone.input_max / 2.0f;
+    tone.output_max = tone.input_max;
+    assert(pl_dovi_dm_generate(lut, &tone));
+    assert(lut[255] <= tone.input_max);
+    tone.input_min = tone.input_avg = tone.input_max = 0.0f;
+    tone.output_min = pl_hdr_rescale(PL_HDR_NITS, PL_HDR_PQ, 0.0004f);
+    tone.output_max = tone.output_min;
+    assert(pl_dovi_dm_generate(lut, &tone));
+    for (int i = 0; i < 256; i++)
+        assert(lut[i] == tone.output_min);
+    // Absence leaves ordinary mapper parameters completely untouched.
+    struct pl_tone_map_params saved = tone;
+    const struct pl_dovi_dm_metadata absent = {0};
+    assert(pl_dovi_dm_prepare(&absent, NULL, &tone) == PL_DOVI_DM_ABSENT);
+    assert(memcmp(&saved, &tone, sizeof(tone)) == 0);
+    assert(pl_dovi_dm_prepare(NULL, NULL, &tone) == PL_DOVI_DM_ABSENT);
+    assert(!pl_dovi_dm_generate(NULL, &tone));
+    tone.input_avg = NAN;
+    assert(!pl_dovi_dm_generate(lut, &tone));
+    return 0;
+}
