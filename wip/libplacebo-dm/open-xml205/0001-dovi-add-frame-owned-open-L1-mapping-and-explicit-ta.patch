diff --git a/src/dovi_dm.c b/src/dovi_dm.c
new file mode 100644
index 0000000..8c5b0d7
--- /dev/null
+++ b/src/dovi_dm.c
@@ -0,0 +1,114 @@
+/*
+ * This file is part of libplacebo.
+ * Copyright (c) 2026 HDR contributors
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+#include <math.h>
+#include "common.h"
+#include <libplacebo/dovi_dm.h>
+
+static bool pq_valid(float v)
+{
+    return isfinite(v) && v >= 0.0f && v <= 1.0f;
+}
+
+enum pl_dovi_dm_status pl_dovi_dm_prepare(
+    const struct pl_dovi_dm_metadata *dm, const struct pl_hdr_metadata *target,
+    struct pl_tone_map_params *tone)
+{
+    if (!dm || !dm->version)
+        return PL_DOVI_DM_ABSENT;
+    if (dm->version != 1 ||
+        (dm->origin != PL_DOVI_DM_RPU && dm->origin != PL_DOVI_DM_OFFICIAL_XML) ||
+        dm->num_blocks < 0 || dm->num_blocks > PL_DOVI_DM_MAX_BLOCKS)
+        return PL_DOVI_DM_INVALID;
+    if (!dm->has_l1)
+        return PL_DOVI_DM_MISSING_L1;
+    if (!target || !tone || !pq_valid(dm->min_pq) || !pq_valid(dm->avg_pq) ||
+        !pq_valid(dm->max_pq) || dm->min_pq > dm->avg_pq ||
+        dm->avg_pq > dm->max_pq || !isfinite(target->min_luma) ||
+        !isfinite(target->max_luma) || target->min_luma < 0.0f ||
+        target->min_luma >= target->max_luma || target->max_luma > 10000.0f ||
+        !pl_primaries_valid(&target->prim))
+        return PL_DOVI_DM_INVALID;
+    if (dm->curve != PL_DOVI_DM_ST2094_10 && dm->curve != PL_DOVI_DM_SPLINE)
+        return PL_DOVI_DM_INVALID;
+
+    // Work on a copy so rejected optional data cannot poison the generic mapper.
+    struct pl_tone_map_params t = *tone;
+    t.function = dm->curve == PL_DOVI_DM_SPLINE ? &pl_tone_map_spline :
+                                                &pl_tone_map_st2094_10;
+    t.param = 0.0f; // use existing constants, not backwards-compat tuning knobs
+    pl_tone_map_params_infer(&t); // sanitize constants, then override inference
+    t.input_scaling = t.output_scaling = PL_HDR_PQ;
+    t.input_min = dm->min_pq;
+    t.input_avg = dm->avg_pq;
+    t.input_avg_present = true;
+    t.input_max = dm->max_pq;
+    t.output_min = pl_hdr_rescale(PL_HDR_NITS, PL_HDR_PQ, target->min_luma);
+    t.output_max = fminf(dm->max_pq,
+        pl_hdr_rescale(PL_HDR_NITS, PL_HDR_PQ, target->max_luma));
+    // A source below the target black still maps to target black, not an
+    // inverted output interval. No inverse peak expansion is allowed.
+    t.output_max = fmaxf(t.output_min, t.output_max);
+    *tone = t;
+    return dm->min_pq == dm->max_pq ? PL_DOVI_DM_FLAT : PL_DOVI_DM_L1;
+}
+
+bool pl_dovi_dm_generate(float *out, const struct pl_tone_map_params *tone)
+{
+    if (!out || !tone || tone->lut_size < 2 ||
+        tone->input_scaling != PL_HDR_PQ || tone->output_scaling != PL_HDR_PQ ||
+        !pq_valid(tone->input_min) || !pq_valid(tone->input_avg) ||
+        !pq_valid(tone->input_max) || !pq_valid(tone->output_min) ||
+        !pq_valid(tone->output_max) || tone->input_min > tone->input_avg ||
+        tone->input_avg > tone->input_max || tone->output_min > tone->output_max ||
+        (tone->function != &pl_tone_map_spline &&
+         tone->function != &pl_tone_map_st2094_10))
+        return false;
+
+    if (tone->input_min == tone->input_max || tone->output_min == tone->output_max) {
+        float value = fminf(fmaxf(tone->input_max, tone->output_min), tone->output_max);
+        for (size_t i = 0; i < tone->lut_size; i++)
+            out[i] = value;
+        return true;
+    }
+
+    struct pl_tone_map_params fixed = *tone;
+    enum pl_hdr_scaling scaling = tone->function->scaling;
+    fixed.input_scaling = fixed.output_scaling = scaling;
+    fixed.input_min = pl_hdr_rescale(PL_HDR_PQ, scaling, tone->input_min);
+    fixed.input_avg = pl_hdr_rescale(PL_HDR_PQ, scaling, tone->input_avg);
+    fixed.input_max = pl_hdr_rescale(PL_HDR_PQ, scaling, tone->input_max);
+    fixed.output_min = pl_hdr_rescale(PL_HDR_PQ, scaling, tone->output_min);
+    fixed.output_max = pl_hdr_rescale(PL_HDR_PQ, scaling, tone->output_max);
+    for (size_t i = 0; i < tone->lut_size; i++) {
+        float w = (float) i / (tone->lut_size - 1);
+        float x = tone->input_min + w * (tone->input_max - tone->input_min);
+        out[i] = pl_hdr_rescale(PL_HDR_PQ, scaling, x);
+    }
+    // Do not call the generic generator: it re-infers a 100-nit source floor.
+    // Here both original curve and knee execute in their real declared units.
+    fixed.function->map(out, &fixed);
+    for (size_t i = 0; i < tone->lut_size; i++) {
+        if (!isfinite(out[i]))
+            return false;
+        float v = fminf(fmaxf(out[i], fixed.output_min), fixed.output_max);
+        out[i] = pl_hdr_rescale(scaling, PL_HDR_PQ, v);
+        if (!isfinite(out[i]) || (i && out[i] + 1e-6f < out[i-1]))
+            return false;
+    }
+    return true;
+}
+
+const char *pl_dovi_dm_status_name(enum pl_dovi_dm_status status)
+{
+    switch (status) {
+    case PL_DOVI_DM_ABSENT: return "absent";
+    case PL_DOVI_DM_MISSING_L1: return "missing-l1:ordinary-mapper";
+    case PL_DOVI_DM_INVALID: return "invalid:ordinary-mapper";
+    case PL_DOVI_DM_L1: return "open-l1:trims-not-applied";
+    case PL_DOVI_DM_FLAT: return "open-l1-flat:trims-not-applied";
+    }
+    return "unknown";
+}
diff --git a/src/include/libplacebo/dovi_dm.h b/src/include/libplacebo/dovi_dm.h
new file mode 100644
index 0000000..80acf7a
--- /dev/null
+++ b/src/include/libplacebo/dovi_dm.h
@@ -0,0 +1,88 @@
+/*
+ * This file is part of libplacebo.
+ * Copyright (c) 2026 HDR contributors
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+#ifndef LIBPLACEBO_DOVI_DM_H_
+#define LIBPLACEBO_DOVI_DM_H_
+
+#include <libplacebo/colorspace.h>
+#include <libplacebo/tone_mapping.h>
+
+PL_API_BEGIN
+
+// Experimental open display management, NOT Dolby's proprietary CM algorithm.
+// All values originate from matching real RPU or official post-reshape metadata.
+// The payload is copied by value with the frame; no borrowed AVFrame pointers.
+// Version zero means no DM and preserves the ordinary mapper byte for byte.
+enum pl_dovi_dm_origin {
+    PL_DOVI_DM_NONE,
+    PL_DOVI_DM_RPU,
+    PL_DOVI_DM_OFFICIAL_XML,
+};
+
+enum pl_dovi_dm_curve {
+    PL_DOVI_DM_ST2094_10, // existing rational curve/knee, with real NITS scaling
+    PL_DOVI_DM_SPLINE,   // diagnostic B: existing spline with explicit DM bounds
+};
+
+#define PL_DOVI_DM_MAX_BLOCKS 32
+struct pl_dovi_dm_block {
+    uint8_t level;
+    // Original decoded bitfields (not SOP coefficients). Format-specific
+    // adapters retain all repeated L2/L8/L10 records; never average raw codes.
+    uint16_t data[24];
+    // Exact FFmpeg-decoded chromaticity rationals for L9/L10 (x/y RGBW).
+    int32_t primaries[8][2];
+    // FFmpeg does not expose original optional L8 payload lengths. Unknown
+    // presence is not identity; retain the original RPU bytes in private audit.
+    bool optional_presence_known;
+};
+
+struct pl_dovi_dm_metadata {
+    uint32_t version; // 1, or 0 for absent
+    enum pl_dovi_dm_origin origin;
+    uint64_t stream_id, frame_id; // caller's stable content/sequence identity
+    bool has_l1; // min/average zero are present, not missing-value sentinels
+    float min_pq, avg_pq, max_pq; // normalized genuine L1, separate from CIE Y
+    struct pl_hdr_metadata source; // declarations, NOT signal encoding
+    uint8_t cm_version[2];
+    enum pl_dovi_dm_curve curve;
+    int num_blocks;
+    struct pl_dovi_dm_block blocks[PL_DOVI_DM_MAX_BLOCKS];
+};
+
+enum pl_dovi_dm_status {
+    PL_DOVI_DM_ABSENT,
+    PL_DOVI_DM_MISSING_L1,
+    PL_DOVI_DM_INVALID,
+    PL_DOVI_DM_L1,
+    PL_DOVI_DM_FLAT,
+};
+
+// Immutable preferred-volume snapshot captured for one output buffer. The
+// protocol object/tag is consumer-owned; this identity is NOT proof that the
+// compositor accepted the tag. An old-generation buffer must retain this
+// snapshot when newer feedback arrives. Zero black remains an explicit value.
+struct pl_dovi_dm_target {
+    uint32_t version; // 1, never infer absent fields from output encoding
+    uint64_t generation, description_id;
+    struct pl_hdr_metadata volume;
+};
+
+// Prepares explicit PQ bounds AFTER ordinary nominal-luma inference. Never
+// infer a 100-nit floor or source-average fallback for DM. Target is a complete
+// current physical-volume snapshot; output encoding remains separately owned
+// by the consumer. Unsupported trim blocks remain retained, NOT applied.
+PL_API enum pl_dovi_dm_status pl_dovi_dm_prepare(
+    const struct pl_dovi_dm_metadata *dm, const struct pl_hdr_metadata *target,
+    struct pl_tone_map_params *tone);
+
+// Uses original function->map and existing constants in its declared scaling,
+// returning false for a nonfinite/nonmonotone curve. No fitted coefficients,
+// substitute curve or invented metadata. Flat intervals are constant/clamped.
+PL_API bool pl_dovi_dm_generate(float *out, const struct pl_tone_map_params *tone);
+PL_API const char *pl_dovi_dm_status_name(enum pl_dovi_dm_status status);
+
+PL_API_END
+#endif
