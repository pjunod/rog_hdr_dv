diff --git a/src/include/libplacebo/utils/dovi_dm.h b/src/include/libplacebo/utils/dovi_dm.h
new file mode 100644
index 0000000..ed146e3
--- /dev/null
+++ b/src/include/libplacebo/utils/dovi_dm.h
@@ -0,0 +1,162 @@
+/*
+ * This file is part of libplacebo.
+ * Copyright (c) 2026 HDR contributors
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+#ifndef LIBPLACEBO_UTILS_DOVI_DM_H_
+#define LIBPLACEBO_UTILS_DOVI_DM_H_
+
+#include <string.h>
+#include <stdalign.h>
+#include <libplacebo/dovi_dm.h>
+#include <libavutil/dovi_meta.h>
+
+// Match FFmpeg headers to the rebuilt client. This copies a single complete
+// frame's decoded metadata; no pointer into AVFrame survives. Original RPU and
+// official XML bytes remain caller-owned private audit artifacts. This is NOT
+// raw-RPU-to-ST2094 SOP normalization and does not enable any trim operator.
+static inline bool pl_dovi_dm_from_av(struct pl_dovi_dm_metadata *out,
+    const AVDOVIMetadata *metadata, size_t size, uint64_t stream_id, uint64_t frame_id)
+{
+    if (!out)
+        return false;
+    memset(out, 0, sizeof(*out)); // also clear old data on absent/invalid input
+    if (!metadata)
+        return true;
+    if (size < sizeof(*metadata) || metadata->num_ext_blocks < 0 ||
+        metadata->num_ext_blocks > PL_DOVI_DM_MAX_BLOCKS ||
+        metadata->header_offset < sizeof(*metadata) ||
+        metadata->header_offset > size ||
+        metadata->header_offset % alignof(AVDOVIRpuDataHeader) ||
+        sizeof(AVDOVIRpuDataHeader) > size - metadata->header_offset ||
+        metadata->color_offset < sizeof(*metadata) || metadata->color_offset > size ||
+        metadata->color_offset % alignof(AVDOVIColorMetadata) ||
+        sizeof(AVDOVIColorMetadata) > size - metadata->color_offset ||
+        (metadata->num_ext_blocks &&
+         (metadata->ext_block_offset < sizeof(*metadata) ||
+          metadata->ext_block_offset > size ||
+          metadata->ext_block_size < sizeof(AVDOVIDmData) ||
+          metadata->ext_block_offset % alignof(AVDOVIDmData) ||
+          metadata->ext_block_size % alignof(AVDOVIDmData) ||
+          (size - metadata->ext_block_offset) / metadata->ext_block_size <
+          (size_t) metadata->num_ext_blocks)))
+        return false;
+
+    const AVDOVIRpuDataHeader *header = av_dovi_get_header(metadata);
+    const AVDOVIColorMetadata *color = av_dovi_get_color(metadata);
+    // Profile7 FEL is an explicit non-goal. Preserve ordinary handling rather
+    // than pretending this independent display-management stage rebuilds FEL.
+    if (!header->disable_residual_flag || color->source_min_pq > 4095 ||
+        color->source_max_pq > 4095 || color->source_min_pq > color->source_max_pq)
+        return false;
+    struct pl_dovi_dm_metadata dm = {
+        .version = 1, .origin = PL_DOVI_DM_RPU,
+        .stream_id = stream_id, .frame_id = frame_id,
+        .source = {
+            .min_luma = pl_hdr_rescale(PL_HDR_PQ, PL_HDR_NITS, color->source_min_pq / 4095.0f),
+            .max_luma = pl_hdr_rescale(PL_HDR_PQ, PL_HDR_NITS, color->source_max_pq / 4095.0f),
+        },
+        .num_blocks = metadata->num_ext_blocks,
+    };
+    for (int i = 0; i < metadata->num_ext_blocks; i++) {
+        const AVDOVIDmData *ext = av_dovi_get_ext(metadata, i);
+        struct pl_dovi_dm_block *b = &dm.blocks[i];
+        b->level = ext->level;
+        b->optional_presence_known = ext->level != 8;
+        switch (ext->level) {
+        case 1:
+            if (dm.has_l1 || ext->l1.min_pq > 4095 || ext->l1.max_pq > 4095 ||
+                ext->l1.avg_pq > 4095 || ext->l1.min_pq > ext->l1.avg_pq ||
+                ext->l1.avg_pq > ext->l1.max_pq)
+                return false;
+            b->data[0] = ext->l1.min_pq;
+            b->data[1] = ext->l1.avg_pq;
+            b->data[2] = ext->l1.max_pq;
+            dm.has_l1 = true;
+            dm.min_pq = ext->l1.min_pq / 4095.0f;
+            dm.avg_pq = ext->l1.avg_pq / 4095.0f;
+            dm.max_pq = ext->l1.max_pq / 4095.0f;
+            break;
+        case 2:
+            b->data[0] = ext->l2.target_max_pq;
+            b->data[1] = ext->l2.trim_slope;
+            b->data[2] = ext->l2.trim_offset;
+            b->data[3] = ext->l2.trim_power;
+            b->data[4] = ext->l2.trim_chroma_weight;
+            b->data[5] = ext->l2.trim_saturation_gain;
+            b->data[6] = (uint16_t) ext->l2.ms_weight; // signed code preserved
+            break;
+        case 3:
+            b->data[0] = ext->l3.min_pq_offset;
+            b->data[1] = ext->l3.avg_pq_offset;
+            b->data[2] = ext->l3.max_pq_offset;
+            break;
+        case 4:
+            b->data[0] = ext->l4.anchor_pq;
+            b->data[1] = ext->l4.anchor_power;
+            break;
+        case 5:
+            b->data[0] = ext->l5.left_offset;
+            b->data[1] = ext->l5.right_offset;
+            b->data[2] = ext->l5.top_offset;
+            b->data[3] = ext->l5.bottom_offset;
+            break;
+        case 6:
+            b->data[0] = ext->l6.max_luminance;
+            b->data[1] = ext->l6.min_luminance;
+            b->data[2] = ext->l6.max_cll;
+            b->data[3] = ext->l6.max_fall;
+            break;
+        case 8:
+            b->data[0] = ext->l8.target_display_index;
+            b->data[1] = ext->l8.trim_slope;
+            b->data[2] = ext->l8.trim_offset;
+            b->data[3] = ext->l8.trim_power;
+            b->data[4] = ext->l8.trim_chroma_weight;
+            b->data[5] = ext->l8.trim_saturation_gain;
+            b->data[6] = ext->l8.ms_weight;
+            b->data[7] = ext->l8.target_mid_contrast;
+            b->data[8] = ext->l8.clip_trim;
+            for (int k = 0; k < 6; k++) {
+                b->data[9+k] = ext->l8.saturation_vector_field[k];
+                b->data[15+k] = ext->l8.hue_vector_field[k];
+            }
+            break;
+        case 9:
+        case 10: {
+            const AVColorPrimariesDesc *p;
+            if (ext->level == 9) {
+                b->data[0] = ext->l9.source_primary_index;
+                p = &ext->l9.source_display_primaries;
+            } else {
+                b->data[0] = ext->l10.target_display_index;
+                b->data[1] = ext->l10.target_max_pq;
+                b->data[2] = ext->l10.target_min_pq;
+                b->data[3] = ext->l10.target_primary_index;
+                p = &ext->l10.target_display_primaries;
+            }
+            const AVRational v[8] = {p->prim.r.x, p->prim.r.y, p->prim.g.x,
+                p->prim.g.y, p->prim.b.x, p->prim.b.y, p->wp.x, p->wp.y};
+            for (int k = 0; k < 8; k++) {
+                b->primaries[k][0] = v[k].num;
+                b->primaries[k][1] = v[k].den;
+            }
+            break;
+        }
+        case 254:
+            b->data[0] = ext->l254.dm_mode;
+            b->data[1] = ext->l254.dm_version_index;
+            // These are not the XML CMVersion pair; do not relabel them.
+            break;
+        default:
+            // Unrecognized data is not supported/applied. The actual complete
+            // FFmpeg side-data/RPU must remain in private audit, not this copy.
+            b->optional_presence_known = false;
+            break;
+        }
+    }
+    *out = dm;
+    return true;
+}
+
+#endif
