+// Analytic evaluation shares prepared float coefficients with the CPU core.
+// No uniform LUT approximation of B/slopes and no input-anchor clipping. All
+// uniforms are value-bound on each shader dispatch, not pointer-keyed state.
+static ident_t open_hermite_shader(pl_shader sh, const struct pl_dovi_dm_hermite *c)
+{
+    ident_t fn = sh_fresh(sh, "open_hermite_pq");
+    GLSLH("float "$"(float x) { float y; \n", fn);
+    if (c->identity) {
+        GLSLH("y = x; \n");
+    } else if (c->branch == PL_DOVI_DM_HERMITE_FLAT) {
+        GLSLH("y = "$"; \n", SH_FLOAT(c->mapped.mid));
+    } else {
+        GLSLH("if (x == "$") y = "$"; \n"
+              "else if (x <= "$") y = "$" + (x - "$") * "$"; \n"
+              "else if (x >= "$") y = "$" + (x - "$") * "$"; \n",
+              SH_FLOAT(c->source.mid), SH_FLOAT(c->mapped.mid),
+              SH_FLOAT(c->source.min), SH_FLOAT(c->mapped.min),
+              SH_FLOAT(c->source.min), SH_FLOAT(c->slopes[0]),
+              SH_FLOAT(c->source.max), SH_FLOAT(c->mapped.max),
+              SH_FLOAT(c->source.max), SH_FLOAT(c->slopes[2]));
+        // Do not emit any division for an omitted segment, even on a branch
+        // which would not execute. This also keeps generated SPIR-V finite.
+        for (int i = 0; i < 2; i++) {
+            float lo = i ? c->source.mid : c->source.min;
+            float hi = i ? c->source.max : c->source.mid;
+            if (lo == hi)
+                continue;
+            GLSLH("else if (x < "$") { float t = (x - "$") / "$"; \n"
+                  "y = "$" + t * ("$" + t * ("$" + t * "$")); } \n",
+                  SH_FLOAT(hi), SH_FLOAT(lo), SH_FLOAT(hi - lo),
+                  SH_FLOAT(i ? c->mapped.mid : c->mapped.min),
+                  SH_FLOAT(c->coeffs[i][0]), SH_FLOAT(c->coeffs[i][1]),
+                  SH_FLOAT(c->coeffs[i][2]));
+        }
+        GLSLH("else y = "$"; \n", SH_FLOAT(c->mapped.max));
+    }
+    GLSLH("return clamp(y, "$", "$"); } \n",
+          SH_FLOAT(c->target.min), SH_FLOAT(c->target.max));
+    return fn;
+}
+
 void pl_shader_color_map_ex(pl_shader sh, const struct pl_color_map_params *params,
                             const struct pl_color_map_args *args)
 {
@@ -1667,6 +1708,17 @@ void pl_shader_color_map_ex(pl_shader sh, const struct pl_color_map_params *para
         args->dovi_target->version == 1 ? &args->dovi_target->volume : NULL;
     enum pl_dovi_dm_status dm_status = pl_dovi_dm_prepare(args->dovi_dm, dm_volume, &tone);
     bool dm_active = dm_status == PL_DOVI_DM_L1 || dm_status == PL_DOVI_DM_FLAT;
+    // Version2 is an explicit diagnostic request, never silently substitute
