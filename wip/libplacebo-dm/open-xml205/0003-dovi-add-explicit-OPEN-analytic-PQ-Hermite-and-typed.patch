+// Mathematical coordinates/policies only; these are NOT authored metadata or
+// vendor reference fixtures. Original-content integration lives in the Python
+// tests and must use the retained real input, never these scalar controls.
+static void hermite_tests(void)
+{
+    struct pl_dovi_dm_hermite c;
+    struct pl_dovi_dm_pq_anchors s = {0, 0.4f, 1};
+    struct pl_dovi_dm_pq_bounds b = {0, 0.1f};
+    assert(pl_dovi_dm_hermite_prepare(s, b, &c));
+    assert(fabsf(c.mapped.mid - 0.05f) < 1e-7f); // cosine counterexample
+    assert(c.mapped.min == 0 && c.mapped.max == b.max);
+    // Exact derivative minima of each quadratic, not monotonic sample repair.
+    for (int j = 0; j < 2; j++) {
+        const float *k = c.coeffs[j];
+        double qa = 3.0 * k[2], qb = 2.0 * k[1], qc = k[0];
+        double minimum = fmin(qc, qa + qb + qc);
+        if (qa > 0) {
+            double t = -qb / (2 * qa);
+            if (t > 0 && t < 1)
+                minimum = fmin(minimum, (qa * t + qb) * t + qc);
+        }
+        assert(minimum >= -1e-8); // float coefficient rounding tolerance only
+    }
+    assert(pl_dovi_dm_hermite_eval(&c, s.min) == c.mapped.min);
+    assert(pl_dovi_dm_hermite_eval(&c, s.mid) == c.mapped.mid);
+    assert(pl_dovi_dm_hermite_eval(&c, s.max) == c.mapped.max);
+    s = (struct pl_dovi_dm_pq_anchors) {0.1f, 0.3f, 0.5f};
+    b = (struct pl_dovi_dm_pq_bounds) {0, 0.8f};
+    assert(pl_dovi_dm_hermite_prepare(s, b, &c) && c.identity);
+    assert(pl_dovi_dm_hermite_eval(&c, 0.75f) == 0.75f); // linear tail
+    b = (struct pl_dovi_dm_pq_bounds) {0.6f, 0.9f};
+    assert(pl_dovi_dm_hermite_prepare(s, b, &c));
+    assert(c.mapped.max > s.max); // retain actual target, not min(C,b)
+    for (int branch = 0; branch < 3; branch++) {
+        s = branch == 0 ? (struct pl_dovi_dm_pq_anchors) {0, 0, 0} :
+            branch == 1 ? (struct pl_dovi_dm_pq_anchors) {0, 0, 1} :
+                          (struct pl_dovi_dm_pq_anchors) {0, 1, 1};
+        assert(pl_dovi_dm_hermite_prepare(s, b, &c));
+        float prev = b.min;
+        for (int i = 0; i <= 1000; i++) {
+            float y = pl_dovi_dm_hermite_eval(&c, i / 1000.0f);
+            assert(isfinite(y) && y >= b.min && y <= b.max);
+            assert(y + 1e-6f >= prev);
+            prev = y;
+        }
+    }
+    s = (struct pl_dovi_dm_pq_anchors) {0.2f, 0.1f, 0.9f};
+    assert(!pl_dovi_dm_hermite_prepare(s, b, &c));
+    s.min = NAN;
+    assert(!pl_dovi_dm_hermite_prepare(s, b, &c));
+    s = (struct pl_dovi_dm_pq_anchors) {0, 0.3f, 1};
+    b.max = b.min;
+    assert(!pl_dovi_dm_hermite_prepare(s, b, &c));
+}
+
+static void sop_tests(void)
+{
+    struct pl_dovi_dm_sop s = { .version = 1,
+        .domain = PL_DOVI_DM_SOP_TARGET_NORMALIZED_PQ,
+        .slope = 1, .offset = 0, .power = 1 };
+    struct pl_dovi_dm_pq_bounds b = {0.2f, 0.7f};
+    assert(pl_dovi_dm_sop_eval(&s, b, 0.456f) == 0.456f);
+    s.slope = 1.014f; s.offset = -0.014f; s.power = 2000.0f / 2001;
+    assert(pl_dovi_dm_sop_eval(&s, b, b.min) == b.min);
+    assert(pl_dovi_dm_sop_eval(&s, b, b.max) == b.max);
+    float y = 0.45f, z = (y - b.min) / (b.max - b.min);
+    float expected = b.min + (b.max - b.min) * powf(s.slope * z + s.offset, s.power);
+    assert(fabsf(pl_dovi_dm_sop_eval(&s, b, y) - expected) < 1e-7f);
+    s.domain = PL_DOVI_DM_SOP_UNSPECIFIED;
+    assert(!pl_dovi_dm_sop_valid(&s) && isnan(pl_dovi_dm_sop_eval(&s, b, y)));
+    s.domain = PL_DOVI_DM_SOP_TARGET_NORMALIZED_PQ;
+    s.power = NAN;
+    assert(!pl_dovi_dm_sop_valid(&s));
+}
