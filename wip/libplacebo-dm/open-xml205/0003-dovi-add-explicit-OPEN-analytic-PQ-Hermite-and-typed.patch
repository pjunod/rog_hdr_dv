+// GPU/operator/cache regressions use explicitly synthetic mathematical control
+// vectors, not claimed authored Dolby metadata/reference agreement. No official
+// tool sees them. Execute only in recovery's single post-review affected batch.
+static void shader_cache_tests(void)
+{
+    pl_vulkan vk = pl_vulkan_create(NULL, pl_vulkan_params(.allow_software = true));
+    assert(vk);
+    pl_gpu gpu = vk->gpu;
+    pl_fmt fmt = pl_find_fmt(gpu, PL_FMT_FLOAT, 4, 32, 32,
+                            PL_FMT_CAP_SAMPLEABLE | PL_FMT_CAP_RENDERABLE);
+    assert(fmt);
+    float input[16] = {0.2f,0.2f,0.2f,1, 0.4f,0.4f,0.4f,1,
+                       0.6f,0.6f,0.6f,1, 0.7f,0.7f,0.7f,1};
+    pl_tex src_tex = pl_tex_create(gpu, pl_tex_params(.w=4,.h=1,.format=fmt,
+        .sampleable=true,.initial_data=input));
+    pl_tex dst_tex = pl_tex_create(gpu, pl_tex_params(.w=4,.h=1,.format=fmt,
+        .renderable=true,.host_readable=true));
+    assert(src_tex && dst_tex);
+    struct pl_frame src = {.num_planes=1}, dst = {.num_planes=1};
+    src.planes[0] = (struct pl_plane) {.texture=src_tex,.components=3,.component_mapping={0,1,2,-1}};
+    dst.planes[0] = (struct pl_plane) {.texture=dst_tex,.components=3,.component_mapping={0,1,2,-1}};
+    src.repr = dst.repr = (struct pl_color_repr) {.sys=PL_COLOR_SYSTEM_RGB,
+        .levels=PL_COLOR_LEVELS_FULL,.alpha=PL_ALPHA_NONE};
+    src.color = dst.color = pl_color_space_hdr10;
+    struct pl_hdr_metadata volume = {.min_luma=0,.max_luma=10000,
+        .prim=*pl_raw_primaries_get(PL_COLOR_PRIM_BT_2020)};
+    src.color.hdr = dst.color.hdr = volume;
+    dst.dovi_target = (struct pl_dovi_dm_target) {.version=1,.generation=1,
+        .description_id=1,.volume=volume};
+    src.dovi_dm = (struct pl_dovi_dm_metadata) {.version=2,
+        .origin=PL_DOVI_DM_OFFICIAL_XML,.has_l1=true,.min_pq=0,.avg_pq=0.4f,.max_pq=1,
+        .curve=PL_DOVI_DM_OPEN_HERMITE_PQ};
+    struct pl_render_params params = pl_render_default_params;
+    params.peak_detect_params = NULL; params.dither_params = NULL;
+    params.preserve_mixing_cache = true;
+    params.skip_caching_single_frame = false;
+    pl_renderer rr = pl_renderer_create(NULL, gpu);
+    assert(rr);
+    float plain[16], identity[16], altered[16], fresh[16];
+    assert(pl_render_image(rr,&src,&dst,&params));
+    readback(gpu,dst_tex,plain);
+    src.dovi_dm.open_sop = (struct pl_dovi_dm_sop) {.version=1,
+        .domain=PL_DOVI_DM_SOP_TARGET_NORMALIZED_PQ,.slope=1,.power=1};
+    assert(pl_render_image(rr,&src,&dst,&params));
+    readback(gpu,dst_tex,identity);
+    assert(memcmp(plain,identity,sizeof(plain)) == 0); // exact SOP bypass
+    const struct pl_frame *frames[] = {&src};
+    uint64_t signatures[] = {123};
+    float timestamps[] = {0};
+    struct pl_frame_mix mix = {.num_frames=1,.frames=frames,.signatures=signatures,
+        .timestamps=timestamps,.vsync_duration=1.0f/24};
+    assert(pl_render_image_mix(rr,&mix,&dst,&params)); // populate one cache key
+    for (int change = 0; change < 5; change++) {
+        if (change == 0) src.dovi_dm.open_sop.offset = -0.05f; // L1 identity still SOP
+        if (change == 1) src.dovi_dm.avg_pq = 0.25f;
+        if (change == 2) { dst.dovi_target.volume.max_luma=600; dst.dovi_target.generation++; }
+        if (change == 3) { dst.dovi_target.volume.min_luma=0.1f; dst.dovi_target.description_id++; }
+        if (change == 4) src.dovi_dm.version = 0; // missing next frame resets
+        assert(pl_render_image_mix(rr,&mix,&dst,&params));
+        readback(gpu,dst_tex,altered);
+        pl_renderer other = pl_renderer_create(NULL,gpu);
+        assert(other && pl_render_image_mix(other,&mix,&dst,&params));
+        readback(gpu,dst_tex,fresh);
+        for (int i=0; i<16; i++) assert(fabsf(altered[i]-fresh[i]) < 1e-5f);
+        if (change == 0) assert(memcmp(plain,altered,sizeof(plain)) != 0);
+        pl_renderer_destroy(&other);
+    }
+    assert(pl_renderer_get_errors(rr).errors == PL_RENDER_ERR_NONE);
+    pl_renderer_destroy(&rr);
+    pl_tex_destroy(gpu,&src_tex); pl_tex_destroy(gpu,&dst_tex);
+    pl_vulkan_destroy(&vk);
+}
