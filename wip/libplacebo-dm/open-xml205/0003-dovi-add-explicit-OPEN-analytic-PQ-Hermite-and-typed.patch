+static void hermite_map(float *lut, const struct pl_tone_map_params *p)
+{
+    struct pl_dovi_dm_hermite c;
+    bool valid = pl_dovi_dm_hermite_prepare((struct pl_dovi_dm_pq_anchors) {
+        p->input_min, p->input_avg, p->input_max },
+        (struct pl_dovi_dm_pq_bounds) { p->output_min, p->output_max }, &c);
+    for (size_t i = 0; i < p->lut_size; i++)
+        lut[i] = valid ? pl_dovi_dm_hermite_eval(&c, lut[i]) : NAN;
+}
+
+// Distinct private function identity: prepare/generate must never silently
+// evaluate the rational curve when a caller explicitly requested Hermite.
+static const struct pl_tone_map_function open_hermite = {
+    .name = "open-hermite-pq", .description = "OPEN US10600166B2 improved Eq7",
+    .scaling = PL_HDR_PQ, .map = hermite_map,
+};
+
 enum pl_dovi_dm_status pl_dovi_dm_prepare(
     const struct pl_dovi_dm_metadata *dm, const struct pl_hdr_metadata *target,
     struct pl_tone_map_params *tone)
 {
     if (!dm || !dm->version)
         return PL_DOVI_DM_ABSENT;
-    if (dm->version != 1 ||
+    if ((dm->version != 1 && dm->version != 2) ||
         (dm->origin != PL_DOVI_DM_RPU && dm->origin != PL_DOVI_DM_OFFICIAL_XML) ||
         dm->num_blocks < 0 || dm->num_blocks > PL_DOVI_DM_MAX_BLOCKS)
         return PL_DOVI_DM_INVALID;
@@ -31,12 +48,16 @@ enum pl_dovi_dm_status pl_dovi_dm_prepare(
         target->min_luma >= target->max_luma || target->max_luma > 10000.0f ||
