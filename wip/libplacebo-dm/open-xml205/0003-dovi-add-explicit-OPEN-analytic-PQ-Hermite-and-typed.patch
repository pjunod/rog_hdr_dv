+static uint64_t dovi_signature(const struct pl_dovi_dm_metadata *dm,
+                               const struct pl_dovi_dm_target *target)
+{
+    if (!dm->version)
+        return 0; // preserves ordinary cache keys and resets after a DM frame
+    uint64_t h = 0;
+#define DM_HASH(x) pl_hash_merge(&h, pl_var_hash(x))
+    DM_HASH(dm->version);
+    DM_HASH(dm->origin);
+    DM_HASH(dm->stream_id);
+    DM_HASH(dm->frame_id);
+    DM_HASH(dm->has_l1);
+    DM_HASH(dm->min_pq);
+    DM_HASH(dm->avg_pq);
+    DM_HASH(dm->max_pq);
+    DM_HASH(dm->curve);
+    if (dm->version == 2) {
+        DM_HASH(dm->open_sop.version);
+        DM_HASH(dm->open_sop.domain);
+        DM_HASH(dm->open_sop.slope);
+        DM_HASH(dm->open_sop.offset);
+        DM_HASH(dm->open_sop.power);
+    }
+    DM_HASH(target->version);
+    DM_HASH(target->generation);
+    DM_HASH(target->description_id);
+    DM_HASH(target->volume.min_luma);
+    DM_HASH(target->volume.max_luma);
+    const struct pl_raw_primaries *p = &target->volume.prim;
+    DM_HASH(p->red.x); DM_HASH(p->red.y);
+    DM_HASH(p->green.x); DM_HASH(p->green.y);
+    DM_HASH(p->blue.x); DM_HASH(p->blue.y);
+    DM_HASH(p->white.x); DM_HASH(p->white.y);
+#undef DM_HASH
+    return h;
+}
