-         tone->function != &pl_tone_map_st2094_10))
+         tone->function != &pl_tone_map_st2094_10 && tone->function != &open_hermite))
         return false;
 
     if (tone->input_min == tone->input_max || tone->output_min == tone->output_max) {
@@ -112,3 +137,125 @@ const char *pl_dovi_dm_status_name(enum pl_dovi_dm_status status)
     }
     return "unknown";
 }
+
+static float physical_clamp(float x, struct pl_dovi_dm_pq_bounds b)
+{
+    return fminf(fmaxf(x, b.min), b.max);
+}
+
+static void hermite_coeffs(float dx, float dy, float m0, float m1, float c[3])
+{
+    c[0] = dx * m0;
+    c[1] = 3 * dy - dx * (2 * m0 + m1);
+    c[2] = -2 * dy + dx * (m0 + m1);
+}
+
+bool pl_dovi_dm_hermite_prepare(struct pl_dovi_dm_pq_anchors s,
+    struct pl_dovi_dm_pq_bounds b, struct pl_dovi_dm_hermite *out)
+{
+    if (!out || !pq_valid(s.min) || !pq_valid(s.mid) || !pq_valid(s.max) ||
+        !pq_valid(b.min) || !pq_valid(b.max) || s.min > s.mid || s.mid > s.max ||
+        b.min >= b.max)
+        return false;
+    struct pl_dovi_dm_hermite c = { .source = s, .target = b };
+    if (s.min == s.max) {
+        c.branch = PL_DOVI_DM_HERMITE_FLAT;
+        c.mapped.min = c.mapped.mid = c.mapped.max = physical_clamp(s.mid, b);
+        *out = c;
+        return true;
+    }
+    // Algebraically equivalent to improved0080-0082 offsets. This form avoids
+    // division by the target span and subtraction of large, similar offsets.
+    const double L = (double) s.mid - s.min, H = (double) s.max - s.mid;
+    const double cutoff = b.min + 0.5 * ((double) b.max - b.min);
+    const double y = s.mid <= cutoff ?
+        fmin(cutoff, fmax(s.mid, b.min + 0.5 * L)) :
+        fmax(cutoff, fmin(s.mid, b.max - 0.5 * H));
+    c.mapped.mid = y;
+    c.mapped.min = fmax(y - L, b.min);
+    c.mapped.max = fmin(y + H, b.max);
+    // Classify BEFORE division, not by an epsilon-shifted source midpoint.
+    const double u = L ? fmin(1.0, (y - b.min) / L) : 0;
+    const double v = H ? fmin(1.0, (b.max - y) / H) : 0;
+    c.slopes[0] = fmin(3 * u, u * u);
+    c.slopes[2] = fmin(fmin(3 * v, 1.0), v * v * v * v);
+    c.slopes[1] = fmin(fmin(3 * u, 3 * v), 1.0 - s.mid + y);
+    if (!L) {
+        c.branch = PL_DOVI_DM_HERMITE_COLLAPSED_TAIL;
+        c.slopes[0] = c.slopes[1] = 0;
+    } else if (!H) {
+        c.branch = PL_DOVI_DM_HERMITE_COLLAPSED_HEAD;
+        c.slopes[1] = c.slopes[2] = 0;
+    }
+    // Rounding can collapse a mapped segment; a constant interval must have
+    // both adjacent slopes zero (explicit engineering policy).
+    if (c.mapped.min == c.mapped.mid)
+        c.slopes[0] = c.slopes[1] = 0;
+    if (c.mapped.mid == c.mapped.max)
+        c.slopes[1] = c.slopes[2] = 0;
+    c.identity = L && H && b.min <= s.min && s.max <= b.max;
+    if (c.identity) {
+        c.mapped = s;
+        c.slopes[0] = c.slopes[1] = c.slopes[2] = 1;
+    }
+    hermite_coeffs(s.mid - s.min, c.mapped.mid - c.mapped.min,
+                   c.slopes[0], c.slopes[1], c.coeffs[0]);
+    hermite_coeffs(s.max - s.mid, c.mapped.max - c.mapped.mid,
+                   c.slopes[1], c.slopes[2], c.coeffs[1]);
+    for (int i = 0; i < 3; i++) {
+        if (!isfinite(c.slopes[i]) || c.slopes[i] < 0 ||
+            !isfinite(c.coeffs[0][i]) || !isfinite(c.coeffs[1][i]))
+            return false;
+    }
+    *out = c;
+    return true;
+}
+
+float pl_dovi_dm_hermite_eval(const struct pl_dovi_dm_hermite *c, float x)
+{
+    if (!c || !isfinite(x))
+        return NAN;
+    const struct pl_dovi_dm_pq_anchors s = c->source, y = c->mapped;
+    float value;
+    if (c->identity) {
+        value = x;
+    } else if (c->branch == PL_DOVI_DM_HERMITE_FLAT) {
+        value = y.mid;
+    } else if (x == s.mid) {
+        value = y.mid;
+    } else if (x <= s.min) {
+        value = y.min + (x - s.min) * c->slopes[0];
+    } else if (x >= s.max) {
+        value = y.max + (x - s.max) * c->slopes[2];
+    } else {
+        int i = x < s.mid ? 0 : 1;
+        float t = i ? (x - s.mid) / (s.max - s.mid) :
+                      (x - s.min) / (s.mid - s.min);
+        const float *k = c->coeffs[i];
+        value = (i ? y.mid : y.min) + t * (k[0] + t * (k[1] + t * k[2]));
+    }
+    // Physical output policy, not part of the unbounded patent continuations.
+    return physical_clamp(value, c->target);
+}
+
+bool pl_dovi_dm_sop_valid(const struct pl_dovi_dm_sop *s)
+{
+    return s && (!s->version || (s->version == 1 &&
+        s->domain == PL_DOVI_DM_SOP_TARGET_NORMALIZED_PQ &&
+        isfinite(s->slope) && s->slope >= 0.5f && s->slope <= 1.5f &&
+        isfinite(s->offset) && s->offset >= -0.5f && s->offset <= 0.5f &&
+        isfinite(s->power) && s->power >= 0.5f && s->power <= 1.5f));
+}
+
+float pl_dovi_dm_sop_eval(const struct pl_dovi_dm_sop *s,
+    struct pl_dovi_dm_pq_bounds b, float y)
+{
+    if (!pl_dovi_dm_sop_valid(s) || !isfinite(y) || !pq_valid(b.min) ||
+        !pq_valid(b.max) || b.min >= b.max)
+        return NAN;
+    if (!s->version || (s->slope == 1 && s->offset == 0 && s->power == 1))
+        return y; // exact identity preserves L1 bytes, even outside bounds
+    float z = (y - b.min) / (b.max - b.min);
+    z = fminf(fmaxf(s->slope * z + s->offset, 0), 1);
+    return b.min + (b.max - b.min) * powf(z, s->power);
+}
