+    uint32_t version; // 1
+    enum pl_dovi_dm_sop_domain domain;
+    float slope, offset, power;
+};
+
 struct pl_dovi_dm_metadata {
-    uint32_t version; // 1, or 0 for absent
+    uint32_t version; // 1 (legacy L1), 2 (OPEN candidate), or 0 for absent
     enum pl_dovi_dm_origin origin;
     uint64_t stream_id, frame_id; // caller's stable content/sequence identity
     bool has_l1; // min/average zero are present, not missing-value sentinels
@@ -50,6 +63,7 @@ struct pl_dovi_dm_metadata {
     enum pl_dovi_dm_curve curve;
     int num_blocks;
     struct pl_dovi_dm_block blocks[PL_DOVI_DM_MAX_BLOCKS];
+    struct pl_dovi_dm_sop open_sop; // used only by version2, copied with frame
 };
 
 enum pl_dovi_dm_status {
@@ -84,5 +98,34 @@ PL_API enum pl_dovi_dm_status pl_dovi_dm_prepare(
 PL_API bool pl_dovi_dm_generate(float *out, const struct pl_tone_map_params *tone);
 PL_API const char *pl_dovi_dm_status_name(enum pl_dovi_dm_status status);
 
+// Typed normalized PQ inputs. Defaults are frozen: preservation .5/.5,
+// cutoff .5, contrast1, powers2/4. No consumer-CM identity is asserted.
+struct pl_dovi_dm_pq_anchors { float min, mid, max; };
+struct pl_dovi_dm_pq_bounds { float min, max; };
+enum pl_dovi_dm_hermite_branch {
+    PL_DOVI_DM_HERMITE_REGULAR,
+    PL_DOVI_DM_HERMITE_FLAT,
+    PL_DOVI_DM_HERMITE_COLLAPSED_TAIL,
+    PL_DOVI_DM_HERMITE_COLLAPSED_HEAD,
+};
+struct pl_dovi_dm_hermite {
+    struct pl_dovi_dm_pq_anchors source, mapped;
+    struct pl_dovi_dm_pq_bounds target;
+    float slopes[3]; // dy_PQ/dx_PQ; central derivative explicitly available
+    // Horner coefficients for y0+t*(c0+t*(c1+t*c2)), t in [0,1].
+    float coeffs[2][3];
+    enum pl_dovi_dm_hermite_branch branch;
+    bool identity;
+};
+// Reject invalid/unordered/nonfinite inputs before division. Engineering
+// policy: flat source constant clamp(mid); omit a collapsed segment and zero
+// its endpoint/shared slopes. Final target clamp is separate from Eq7 tails.
+PL_API bool pl_dovi_dm_hermite_prepare(struct pl_dovi_dm_pq_anchors source,
+    struct pl_dovi_dm_pq_bounds target, struct pl_dovi_dm_hermite *out);
+PL_API float pl_dovi_dm_hermite_eval(const struct pl_dovi_dm_hermite *curve, float x);
+PL_API bool pl_dovi_dm_sop_valid(const struct pl_dovi_dm_sop *sop);
+PL_API float pl_dovi_dm_sop_eval(const struct pl_dovi_dm_sop *sop,
+    struct pl_dovi_dm_pq_bounds target, float y);
+
 PL_API_END
 #endif
