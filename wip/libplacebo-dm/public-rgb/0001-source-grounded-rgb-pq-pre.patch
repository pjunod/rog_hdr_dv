+        return false;
+    const float weights[3] = {.2627f, .6780f, .0593f};
+    for (int i = 0; i < 3; i++) {
+        q[i] = pl_hdr_rescale(PL_HDR_NITS, PL_HDR_PQ, rgb[i]);
