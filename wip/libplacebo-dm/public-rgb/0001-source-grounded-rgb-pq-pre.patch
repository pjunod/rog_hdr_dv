     }
     DM_HASH(target->version);
     DM_HASH(target->generation);
diff --git a/src/shaders/colorspace.c b/src/shaders/colorspace.c
index 4dc39de..2b83212 100644
--- a/src/shaders/colorspace.c
+++ b/src/shaders/colorspace.c
@@ -1714,10 +1714,11 @@ void pl_shader_color_map_ex(pl_shader sh, const struct pl_color_map_params *para
         SH_FAIL(sh, "Invalid explicit OPEN DM payload/target");
         return;
     }
+    bool rgb_active = dm_active && args->dovi_dm->curve == PL_DOVI_DM_OPEN_RGB_PQ_PRE;
     bool hermite_active = dm_active && args->dovi_dm->curve == PL_DOVI_DM_OPEN_HERMITE_PQ;
     const struct pl_dovi_dm_sop *sop = dm_active && args->dovi_dm->version == 2 ?
         &args->dovi_dm->open_sop : NULL;
-    bool sop_active = sop && sop->version &&
+    bool sop_active = !rgb_active && sop && sop->version &&
         !(sop->slope == 1 && sop->offset == 0 && sop->power == 1);
     if (dm_present && !dm_active)
         PL_WARN(sh, "Open DM fallback: %s", pl_dovi_dm_status_name(dm_status));
@@ -1825,7 +1826,7 @@ void pl_shader_color_map_ex(pl_shader sh, const struct pl_color_map_params *para
         can_fast = true;
     }
 
-    bool need_tone_map = dm_active || !pl_tone_map_params_noop(&tone);
+    bool need_tone_map = !rgb_active && (dm_active || !pl_tone_map_params_noop(&tone));
     bool need_gamut_map = !pl_gamut_map_params_noop(&gamut);
 
     if (!args->prelinearized)
@@ -1836,6 +1837,46 @@ void pl_shader_color_map_ex(pl_shader sh, const struct pl_color_map_params *para
     ident_t lms2ipt = SH_MAT3(pl_ipt_lms2ipt);
     ident_t ipt2lms = SH_MAT3(pl_ipt_ipt2lms);
 
+    if (rgb_active) {
+        struct pl_dovi_dm_rgb_curve c;
+        if (!pl_dovi_dm_rgb_prepare(args->dovi_dm, dm_volume, &c)) {
+            SH_FAIL(sh, "Invalid explicit RGB PQ-pre curve");
+            return;
+        }
+        sh_describe(sh, "OPEN RGB PQ-pre SOP/rational Y (not selected Dolby CM)");
+        // Source encoding and working RGB basis are distinct. Convert in
+        // linear light before RGB trims; do not run stock I tone/compensation.
+        const struct pl_raw_primaries *bt = pl_raw_primaries_get(PL_COLOR_PRIM_BT_2020);
+        pl_matrix3x3 basis = pl_ipt_lms2rgb(bt);
+        pl_matrix3x3_mul(&basis, &rgb2lms);
+        GLSL("color.rgb = max("$" * color.rgb, vec3(0.0)); \n", SH_MAT3(basis));
+        struct pl_color_space working = pl_color_space_hdr10;
+        pl_shader_delinearize(sh, &working);
+        if (sop->version) {
+            GLSL("color.rgb = pow(max("$" * color.rgb + vec3("$"), vec3(0.0)), vec3("$")); \n",
+                 SH_FLOAT(sop->slope), SH_FLOAT(sop->offset), SH_FLOAT(sop->power));
+        }
+        GLSL("color.rgb = max(color.rgb, vec3(1e-5)); \n");
+        if (sop->version && sop->saturation_gain != 0) {
+            GLSL("float rgb_qY = dot(color.rgb, vec3(.2627,.6780,.0593)); \n"
+                 "color.rgb *= pow((1.0 + "$") * color.rgb / rgb_qY, vec3("$")); \n",
+                 SH_FLOAT(sop->chroma_weight), SH_FLOAT(sop->saturation_gain));
+        }
+        // Explicit physical PQ-domain safety extension, paired with scalar.
+        GLSL("color.rgb = min(color.rgb, vec3(1.0)); \n");
+        pl_shader_linearize(sh, &working);
+        if (!c.identity) {
+            GLSL("float rgb_Y = %f * dot(color.rgb, vec3(.2627,.6780,.0593)); \n"
+                 "float rgb_mapped = max(("$" + "$" * rgb_Y) / (1.0 + "$" * rgb_Y), 0.0); \n"
+                 "if (rgb_Y > 0.0) color.rgb *= rgb_mapped / rgb_Y; \n",
+                 PL_COLOR_SDR_WHITE, SH_FLOAT(c.coeffs[0]), SH_FLOAT(c.coeffs[1]), SH_FLOAT(c.coeffs[2]));
+        }
+        src.primaries = PL_COLOR_PRIM_BT_2020;
+        rgb2lms = pl_ipt_rgb2lms(bt);
+        // The existing physical-gamut stage below executes once. No second
+        // stock tone map, I SOP, or compensation is appended to this RGB chain.
+    }
+
     if (need_gamut_map && gamut.function == &pl_gamut_map_saturation && can_fast) {
         const pl_matrix3x3 lms2src = pl_ipt_lms2rgb(&gamut.input_gamut);
         const pl_matrix3x3 dst2lms = pl_ipt_rgb2lms(&gamut.output_gamut);
diff --git a/src/tests/dovi_dm.c b/src/tests/dovi_dm.c
index ca51388..c0c9852 100644
--- a/src/tests/dovi_dm.c
+++ b/src/tests/dovi_dm.c
@@ -118,6 +118,36 @@ static void absolute_sop_tests(void)
     s.power = 1; s.offset = 0.6f; assert(!pl_dovi_dm_sop_valid(&s));
 }
 
+static void rgb_tests(void)
+{
+    struct pl_dovi_dm_metadata dm = {.version=2, .has_l1=true,
+        .origin=PL_DOVI_DM_OFFICIAL_XML, .min_pq=0, .avg_pq=.290273f,
+        .max_pq=.879591f, .curve=PL_DOVI_DM_OPEN_RGB_PQ_PRE,
+        .open_sop={.version=1,.domain=PL_DOVI_DM_SOP_ABSOLUTE_PQ,
+            .slope=1.014f,.offset=-.014f,.power=2000.0f/2001,
+            .chroma_weight=-.001f,.saturation_gain=0}};
+    struct pl_hdr_metadata target = {.min_luma=0,.max_luma=600,
+        .prim=*pl_raw_primaries_get(PL_COLOR_PRIM_BT_2020)};
+    struct pl_dovi_dm_rgb_curve c;
+    assert(pl_dovi_dm_rgb_prepare(&dm,&target,&c));
+    assert(fabsf(c.coeffs[0]) < 1e-7f);
+    assert(fabsf(c.coeffs[1]-.6831692335f) < 1e-4f);
+    assert(fabsf(c.coeffs[2]-.0008293202f) < 1e-7f);
+    float input[3]={0,.01f,100}, output[3], bypass[3];
+    assert(pl_dovi_dm_rgb_eval(&c,&dm.open_sop,input,output));
+    dm.open_sop.chroma_weight=.5f; // SG0 makes CW ineffective, not absent
+    assert(pl_dovi_dm_rgb_eval(&c,&dm.open_sop,input,bypass));
+    assert(memcmp(output,bypass,sizeof(output)) == 0);
+    input[0]=NAN;
+    assert(!pl_dovi_dm_rgb_eval(&c,&dm.open_sop,input,output));
+    target.min_luma=.001f;
+    assert(!pl_dovi_dm_rgb_prepare(&dm,&target,&c));
+    target.min_luma=0; dm.min_pq=dm.max_pq;
+    assert(!pl_dovi_dm_rgb_prepare(&dm,&target,&c));
+    dm.min_pq=0; dm.open_sop.domain=PL_DOVI_DM_SOP_TARGET_NORMALIZED_PQ;
+    assert(!pl_dovi_dm_rgb_prepare(&dm,&target,&c));
+}
+
 #ifdef PL_HAVE_VULKAN
 static void readback(pl_gpu gpu, pl_tex tex, float out[16])
 {
@@ -220,6 +250,34 @@ static void shader_cache_tests(void)
             pl_dovi_dm_hermite_eval(&curve,input[4*i]));
         for (int c=0; c<3; c++) assert(fabsf(altered[4*i+c]-expected) < 5e-5f);
     }
+    // Actual new GPU branch vs independent scalar API, then mixing-cache CW/SG
+    // changes at fixed frame signatures. No vendor metadata or reference use.
+    src.dovi_dm.curve = PL_DOVI_DM_OPEN_RGB_PQ_PRE;
+    src.dovi_dm.open_sop = (struct pl_dovi_dm_sop) {.version=1,
+        .domain=PL_DOVI_DM_SOP_ABSOLUTE_PQ,.slope=1.014f,.offset=-.014f,
+        .power=2000.0f/2001,.chroma_weight=-.001f};
+    dst.dovi_target.volume.min_luma=0;
+    struct pl_dovi_dm_rgb_curve rgb;
+    assert(pl_dovi_dm_rgb_prepare(&src.dovi_dm,&dst.dovi_target.volume,&rgb));
+    assert(pl_render_image(rr,&src,&dst,&params));
+    readback(gpu,dst_tex,altered);
