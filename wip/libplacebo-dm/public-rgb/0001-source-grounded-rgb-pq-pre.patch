+// Marker only: RGB mapping is not representable by an IPT-I scalar LUT.
+// generate() rejects this marker; the separate RGB APIs own evaluation.
+static const struct pl_tone_map_function open_rgb = {
+    .name = "open-rgb-pq-pre", .description = "OPEN RGB PQ-pre rational Y",
+    .scaling = PL_HDR_NITS,
+};
+
