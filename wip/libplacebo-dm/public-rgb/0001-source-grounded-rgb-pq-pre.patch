--- /dev/null
+++ b/src/tests/dovi_dm_sqrtsum.c
@@ -0,0 +1,148 @@
+/* Deferred ABI368 mathematical/domain/cache regressions; not vendor fixtures.
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+#include <assert.h>
+#include <math.h>
+#include <string.h>
+#include <libplacebo/renderer.h>
+#ifdef PL_HAVE_VULKAN
+#include <libplacebo/vulkan.h>
+#endif
+
+static struct pl_dovi_dm_metadata metadata(void)
+{
+    return (struct pl_dovi_dm_metadata) {.version=2,.has_l1=true,
+        .origin=PL_DOVI_DM_OFFICIAL_XML,.min_pq=.0196536f,.avg_pq=.272f,.max_pq=.853468f,
+        .source={.min_luma=.005f,.max_luma=4000},.curve=PL_DOVI_DM_OPEN_Y_PQ_POST_SQRTSUM,
+        .open_sop={.version=1,.domain=PL_DOVI_DM_SOP_ABSOLUTE_PQ,
+            .slope=1.005006f,.offset=-.002006f,.power=2000.0f/2007,
+            .chroma_weight=-.0105f,.saturation_gain=-.002f}};
+}
+
+static void scalar_tests(void)
+{
+    struct pl_dovi_dm_metadata dm=metadata();
+    struct pl_hdr_metadata target={.min_luma=0,.max_luma=600,
+        .prim=*pl_raw_primaries_get(PL_COLOR_PRIM_DISPLAY_P3)};
+    struct pl_dovi_dm_rgb_curve c, saved;
+    assert(pl_dovi_dm_rgb_prepare(&dm,&target,&c) && c.sqrtsum);
+    assert(fabsf(c.weight-1.88583593f)<1e-4f);
+    for(int i=0;i<3;i++) {
+        float q=c.source_pq[i], value=pl_dovi_dm_sqrtsum_curve_eval(&c,q);
+        assert(isfinite(value) && fabsf(value-c.mapped_pq[i])<1e-6f);
+        for(int dir=-1;dir<=1;dir+=2) {
+            float near=pl_dovi_dm_sqrtsum_curve_eval(&c,nextafterf(q,dir<0 ? 0 : 1));
+            assert(isfinite(near) && near>=0 && near<=1);
+        }
+    }
+    assert(pl_dovi_dm_sqrtsum_curve_eval(&c,0)==c.mapped_pq[0]);
+    assert(pl_dovi_dm_sqrtsum_curve_eval(&c,1)==c.mapped_pq[2]);
+    assert(isnan(pl_dovi_dm_sqrtsum_curve_eval(&c,NAN)));
+    assert(isnan(pl_dovi_dm_sqrtsum_curve_eval(&c,-.1f)));
+    float in[3]={1,2,3}, out[3], neutral[3], unchanged[3];
+    assert(pl_dovi_dm_sqrtsum_eval(&c,&dm.open_sop,in,out));
+    memcpy(unchanged,out,sizeof(out));
+    dm.open_sop.saturation_gain=0;
+    assert(pl_dovi_dm_sqrtsum_eval(&c,&dm.open_sop,in,neutral));
+    assert(memcmp(out,neutral,sizeof(out))!=0); // actual nonzero SG is applied
+    dm.open_sop.chroma_weight=.5f;
+    assert(pl_dovi_dm_sqrtsum_eval(&c,&dm.open_sop,in,out));
+    assert(memcmp(out,neutral,sizeof(out))==0); // SG0 exact color bypass
+    in[0]=in[1]=in[2]=0;
+    assert(pl_dovi_dm_sqrtsum_eval(&c,&dm.open_sop,in,out));
+    assert(out[0]==0 && out[1]==0 && out[2]==0);
+    memcpy(out,unchanged,sizeof(out));in[0]=-1;
+    assert(!pl_dovi_dm_sqrtsum_eval(&c,&dm.open_sop,in,out));
+    assert(memcmp(out,unchanged,sizeof(out))==0);
+    in[0]=NAN;
+    assert(!pl_dovi_dm_sqrtsum_eval(&c,&dm.open_sop,in,out));
+    in[0]=in[1]=in[2]=10000;
+    dm.open_sop.slope=1.5f;dm.open_sop.offset=.5f;
+    assert(!pl_dovi_dm_sqrtsum_eval(&c,&dm.open_sop,in,out));
+    assert(memcmp(out,unchanged,sizeof(out))==0); // no PQ cap/fallback
+    dm=metadata();saved=c;
+    dm.source.max_luma=2000;
+    assert(pl_dovi_dm_rgb_prepare(&dm,&target,&c));
+    assert(memcmp(&saved,&c,sizeof(c))!=0); // ORIGINAL source max participates
+    for(int bad=0;bad<6;bad++) {
+        dm=metadata();
+        if(bad==0) dm.avg_pq=dm.min_pq;
+        if(bad==1) dm.avg_pq=dm.max_pq;
+        if(bad==2) dm.source.min_luma=NAN;
+        if(bad==3) dm.source.max_luma=dm.source.min_luma;
+        if(bad==4) dm.origin=PL_DOVI_DM_RPU;
+        if(bad==5) dm.open_sop.version=0;
+        assert(!pl_dovi_dm_rgb_prepare(&dm,&target,&c));
+    }
+    dm=metadata();struct pl_tone_map_params tone={.lut_size=4};float lut[4]={1,2,3,4};
+    assert(pl_dovi_dm_prepare(&dm,&target,&tone)==PL_DOVI_DM_L1);
+    assert(!pl_dovi_dm_generate(lut,&tone) && lut[0]==1);
+    pl_tone_map_generate(lut,&tone);
+    for(int i=0;i<4;i++) assert(isnan(lut[i]));
+}
+
+#ifdef PL_HAVE_VULKAN
+static void gpu_tests(void)
+{
+    pl_vulkan vk=pl_vulkan_create(NULL,pl_vulkan_params(.allow_software=true));assert(vk);
+    pl_gpu gpu=vk->gpu;
+    pl_fmt fmt=pl_find_fmt(gpu,PL_FMT_FLOAT,4,32,32,PL_FMT_CAP_SAMPLEABLE|PL_FMT_CAP_RENDERABLE);assert(fmt);
+    float input[8]={.3f,.31f,.32f,1,.5f,.5f,.5f,1};
+    pl_tex src_tex=pl_tex_create(gpu,pl_tex_params(.w=2,.h=1,.format=fmt,.sampleable=true,.initial_data=input));
+    pl_tex dst_tex=pl_tex_create(gpu,pl_tex_params(.w=2,.h=1,.format=fmt,.renderable=true,.host_readable=true));
+    assert(src_tex && dst_tex);
+    struct pl_frame src={.num_planes=1},dst={.num_planes=1};
+    src.planes[0]=(struct pl_plane){.texture=src_tex,.components=4,.component_mapping={0,1,2,3}};
+    dst.planes[0]=(struct pl_plane){.texture=dst_tex,.components=4,.component_mapping={0,1,2,3}};
+    src.repr=dst.repr=(struct pl_color_repr){.sys=PL_COLOR_SYSTEM_RGB,.levels=PL_COLOR_LEVELS_FULL,.alpha=PL_ALPHA_INDEPENDENT};
+    src.color=dst.color=pl_color_space_hdr10;src.dovi_dm=metadata();
+    src.color.hdr=src.dovi_dm.source;
+    src.color.hdr.prim=*pl_raw_primaries_get(PL_COLOR_PRIM_BT_2020);
+    dst.color.hdr=(struct pl_hdr_metadata){.max_luma=600,.prim=*pl_raw_primaries_get(PL_COLOR_PRIM_BT_2020)};
+    dst.dovi_target=(struct pl_dovi_dm_target){.version=1,.generation=1,.description_id=27,.volume=dst.color.hdr};
+    struct pl_render_params p=pl_render_default_params;
+    p.peak_detect_params=NULL;p.dither_params=NULL;p.deband_params=NULL;p.sigmoid_params=NULL;
+    p.upscaler=p.downscaler=NULL;p.background=PL_CLEAR_SKIP;p.background_transparency=1;
+    p.blend_params=NULL;p.blend_against_tiles=false;p.skip_target_clearing=true;
+    p.hooks=NULL;p.num_hooks=0;p.lut=NULL;p.distort_params=NULL;
+    p.preserve_mixing_cache=true;p.skip_caching_single_frame=false;
+    pl_renderer rr=pl_renderer_create(NULL,gpu);assert(rr);
+    float out[8],fresh[8];
+    assert(pl_render_image(rr,&src,&dst,&p));
+    assert(pl_tex_download(gpu,pl_tex_transfer_params(.tex=dst_tex,.ptr=out)));
+    assert(out[3]==1 && out[7]==1);
+    const struct pl_frame *frames[]={&src};uint64_t signatures[]={123};float timestamps[]={0};
+    struct pl_frame_mix mix={.num_frames=1,.frames=frames,.signatures=signatures,.timestamps=timestamps,.vsync_duration=1.0f/24};
+    assert(pl_render_image_mix(rr,&mix,&dst,&p));
+    for(int change=0;change<4;change++) {
+        if(change==0) src.dovi_dm.source.max_luma=2000;
+        if(change==1) src.dovi_dm.source.min_luma=.01f;
+        if(change==2) src.dovi_dm.open_sop.saturation_gain=.1f;
+        if(change==3) dst.dovi_target.description_id++;
+        assert(pl_render_image_mix(rr,&mix,&dst,&p));
+        assert(pl_tex_download(gpu,pl_tex_transfer_params(.tex=dst_tex,.ptr=out)));
+        pl_renderer other=pl_renderer_create(NULL,gpu);assert(other);
+        assert(pl_render_image_mix(other,&mix,&dst,&p));
+        assert(pl_tex_download(gpu,pl_tex_transfer_params(.tex=dst_tex,.ptr=fresh)));
+        for(int i=0;i<8;i++) assert(isfinite(out[i]) && fabsf(out[i]-fresh[i])<1e-5f);
+        pl_renderer_destroy(&other);
+    }
+    // Intentional scalar-SOP PQ>1: output alpha must reach rejection channel,
+    // not be hidden by physical clip, delinearize, background or output alpha.
+    src.dovi_dm.open_sop.slope=1.5f;src.dovi_dm.open_sop.offset=.5f;
+    assert(pl_render_image(rr,&src,&dst,&p));
+    assert(pl_tex_download(gpu,pl_tex_transfer_params(.tex=dst_tex,.ptr=out)));
+    assert(out[7]==0);
+    assert(pl_renderer_get_errors(rr).errors==PL_RENDER_ERR_NONE);
+    pl_renderer_destroy(&rr);pl_tex_destroy(gpu,&src_tex);pl_tex_destroy(gpu,&dst_tex);pl_vulkan_destroy(&vk);
+}
+#endif
+
+int main(void)
+{
+    scalar_tests();
+#ifdef PL_HAVE_VULKAN
+    gpu_tests();
+#endif
+    return 0;
+}
