+bool pl_dovi_dm_y_eval(const struct pl_dovi_dm_rgb_curve *c,
+    const struct pl_dovi_dm_sop *s, const float in[3], float out[3])
+{
+    if (!c || !rgb_sop_valid(s) || s->saturation_gain != 0 || !in || !out)
+        return false;
+    for (int i = 0; i < 3; i++)
+        if (!isfinite(in[i]) || in[i] < 0 || in[i] > 10000)
+            return false;
+    float y = .2627f*in[0] + .6780f*in[1] + .0593f*in[2];
+    float mapped = 0;
+    if (y > 0) {
+        float q = pl_hdr_rescale(PL_HDR_NITS, PL_HDR_PQ, y);
+        if (s->version)
+            q = powf(fmaxf(s->slope*q+s->offset, 0), s->power);
+        q = fmaxf(q, 1e-5f);
+        if (!isfinite(q) || q > 1)
+            return false;
+        mapped = pl_hdr_rescale(PL_HDR_PQ, PL_HDR_NITS, q);
+        if (!c->identity) {
+            float den = 1+c->coeffs[2]*mapped;
+            if (!isfinite(den) || den <= 0)
+                return false;
+            mapped = fmaxf((c->coeffs[0]+c->coeffs[1]*mapped)/den, 0);
+        }
+    }
+    float result[3];
+    for (int i = 0; i < 3; i++) {
+        result[i] = y > 0 ? in[i]*(mapped/y) : 0;
+        if (!isfinite(result[i]) || result[i] < 0 || result[i] > 10000)
+            return false;
+    }
+    for (int i = 0; i < 3; i++)
+        out[i] = result[i];
+    return true;
+}
