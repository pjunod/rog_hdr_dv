         !pl_primaries_valid(&target->prim))
         return PL_DOVI_DM_INVALID;
     if (dm->curve != PL_DOVI_DM_ST2094_10 && dm->curve != PL_DOVI_DM_SPLINE &&
-        !(dm->version == 2 && dm->curve == PL_DOVI_DM_OPEN_HERMITE_PQ))
+        !(dm->version == 2 && (dm->curve == PL_DOVI_DM_OPEN_HERMITE_PQ ||
