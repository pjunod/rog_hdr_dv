+    // the powered rational, not fitted coefficients or a fractional-base clamp.
+    bool sqrtsum;
+    float source_pq[3], mapped_pq[3];
+    float power, rolloff, z0, weight, w0, w2;
 };
 PL_API bool pl_dovi_dm_rgb_prepare(const struct pl_dovi_dm_metadata *dm,
     const struct pl_hdr_metadata *target, struct pl_dovi_dm_rgb_curve *out);
@@ -159,5 +165,15 @@ PL_API bool pl_dovi_dm_y_eval(const struct pl_dovi_dm_rgb_curve *curve,
 PL_API bool pl_dovi_dm_y_mb_eval(const struct pl_dovi_dm_rgb_curve *curve,
     const struct pl_dovi_dm_sop *sop, const float in_nits[3], float out_nits[3]);
 
+// Original declared display endpoints and strictly ordered original L1.
+// NONLITERAL constant endpoint extension, interior positive anchor form.
+// No pre-SOP/stock compensation/epsilon ratio. Exact zero Y maps to black.
+// Invalid domains fail without modifying out; generic scalar LUT unsupported.
+PL_API bool pl_dovi_dm_sqrtsum_prepare(const struct pl_dovi_dm_metadata *dm,
+    const struct pl_hdr_metadata *target, struct pl_dovi_dm_rgb_curve *out);
+PL_API float pl_dovi_dm_sqrtsum_curve_eval(const struct pl_dovi_dm_rgb_curve *curve, float q);
+PL_API bool pl_dovi_dm_sqrtsum_eval(const struct pl_dovi_dm_rgb_curve *curve,
+    const struct pl_dovi_dm_sop *sop, const float in_nits[3], float out_nits[3]);
+
 PL_API_END
 #endif
