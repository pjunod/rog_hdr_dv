diff --git a/src/dovi_dm_sqrtsum.c b/src/dovi_dm_sqrtsum.c
new file mode 100644
index 0000000..ee92ee5
--- /dev/null
+++ b/src/dovi_dm_sqrtsum.c
@@ -0,0 +1,137 @@
+/* US9613407B2 Table2 powered rational in an explicitly named open hybrid.
+ * Copyright (c) 2026 HDR contributors
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ * Not Dolby CM identity. Positive anchor form avoids cancellation, not fitting.
+ */
+#include <math.h>
+#include <libplacebo/dovi_dm.h>
+
+static bool pq_valid(float q) { return isfinite(q) && q >= 0 && q <= 1; }
+
+static bool sop_valid(const struct pl_dovi_dm_sop *s)
+{
+    return s && s->version == 1 && pl_dovi_dm_sop_valid(s) &&
+        s->domain == PL_DOVI_DM_SOP_ABSOLUTE_PQ &&
+        isfinite(s->chroma_weight) && fabsf(s->chroma_weight) <= .5f &&
+        isfinite(s->saturation_gain) && fabsf(s->saturation_gain) <= .5f;
+}
+
+bool pl_dovi_dm_sqrtsum_prepare(const struct pl_dovi_dm_metadata *dm,
+    const struct pl_hdr_metadata *target, struct pl_dovi_dm_rgb_curve *out)
+{
+    if (!dm || !target || !out || dm->curve != PL_DOVI_DM_OPEN_Y_PQ_POST_SQRTSUM ||
+        dm->version != 2 || dm->origin != PL_DOVI_DM_OFFICIAL_XML || !dm->has_l1 ||
+        !sop_valid(&dm->open_sop) ||
+        !pq_valid(dm->min_pq) || !pq_valid(dm->avg_pq) || !pq_valid(dm->max_pq) ||
+        !(dm->min_pq < dm->avg_pq && dm->avg_pq < dm->max_pq) ||
+        !isfinite(dm->source.min_luma) || !isfinite(dm->source.max_luma) ||
+        !(0 <= dm->source.min_luma && dm->source.min_luma < dm->source.max_luma &&
+          dm->source.max_luma <= 10000) ||
+        !isfinite(target->min_luma) || !isfinite(target->max_luma) ||
+        !(0 <= target->min_luma && target->min_luma < target->max_luma && target->max_luma <= 10000))
+        return false;
+    double sm = pl_hdr_rescale(PL_HDR_NITS, PL_HDR_PQ, dm->source.min_luma);
+    double sx = pl_hdr_rescale(PL_HDR_NITS, PL_HDR_PQ, dm->source.max_luma);
+    double tm = pl_hdr_rescale(PL_HDR_NITS, PL_HDR_PQ, target->min_luma);
+    double tx = pl_hdr_rescale(PL_HDR_NITS, PL_HDR_PQ, target->max_luma);
+    double ratio = fmin(1, sqrt((tx+tm)/(sx+sm)));
+    double n = 3*sqrt(1/ratio); // ScreenRatio1, Rolloff1/3
+    double key = 2*((double)dm->avg_pq-dm->min_pq)/((double)dm->max_pq-dm->min_pq);
+    double shift = dm->avg_pq*(1-ratio)*key;
+    double ys[3] = {fmax(dm->min_pq-shift,tm),dm->avg_pq-shift,fmin(dm->max_pq-shift,tx)};
+    if (!(0 <= ys[0] && ys[0] < ys[1] && ys[1] < ys[2] && ys[2] <= 1))
+        return false;
+    double z0 = pow((double)dm->min_pq/dm->max_pq,n);
+    double zm = pow((double)dm->avg_pq/dm->max_pq,n);
+    double w0 = pow(ys[0],3), wm = pow(ys[1],3), w2 = pow(ys[2],3);
+    if (!(0 <= z0 && z0 < zm && zm < 1 && w0 < wm && wm < w2))
+        return false;
+    double t = (zm-z0)/(1-z0);
+    double k = (wm-w0)*(1-t)/((w2-wm)*t);
+    struct pl_dovi_dm_rgb_curve c = {
+        .sqrtsum=true, .source_pq={dm->min_pq,dm->avg_pq,dm->max_pq},
+        .mapped_pq={ys[0],ys[1],ys[2]}, .power=n, .rolloff=1.0f/3,
+        .z0=z0, .weight=k, .w0=w0, .w2=w2,
+    };
+    // Re-close the anchor representation in its actual storage precision.
+    // In particular z0 must use the same float power/normalization as eval;
+    // casting a double z0 could make the first interior nextafter negative.
+    c.z0 = powf(c.source_pq[0]/c.source_pq[2],c.power);
+    float zmid = powf(c.source_pq[1]/c.source_pq[2],c.power);
+    c.w0 = powf(c.mapped_pq[0],3);
+    c.w2 = powf(c.mapped_pq[2],3);
+    float wmid = powf(c.mapped_pq[1],3);
+    if (!(c.z0 < zmid && zmid < 1 && c.w0 < wmid && wmid < c.w2))
+        return false;
+    t = ((double)zmid-c.z0)/(1-c.z0);
+    c.weight = ((double)wmid-c.w0)*(1-t)/(((double)c.w2-wmid)*t);
+    // Validate actual binary32 closure, not only the double preparation.
+    if (!isfinite(c.power) || c.power <= 0 || !isfinite(c.weight) || c.weight <= 0 ||
+        !(0 <= c.z0 && c.z0 < 1 && 0 <= c.w0 && c.w0 < c.w2) ||
+        !(c.mapped_pq[0] < c.mapped_pq[1] && c.mapped_pq[1] < c.mapped_pq[2]))
+        return false;
+    *out = c;
+    return true;
+}
+
+float pl_dovi_dm_sqrtsum_curve_eval(const struct pl_dovi_dm_rgb_curve *c, float q)
+{
+    if (!c || !c->sqrtsum || !pq_valid(q))
+        return NAN;
+    if (q <= c->source_pq[0])
+        return c->mapped_pq[0];
+    if (q >= c->source_pq[2])
+        return c->mapped_pq[2];
+    float t = (powf(q/c->source_pq[2],c->power)-c->z0)/(1-c->z0);
+    float den = (1-t)+c->weight*t;
+    float base = (c->w0*(1-t)+c->weight*c->w2*t)/den;
+    if (!isfinite(t) || t < 0 || t > 1 || !isfinite(base) || base < 0 || den <= 0)
+        return NAN;
+    float mapped = powf(base,c->rolloff);
+    return pq_valid(mapped) ? mapped : NAN;
+}
+
+bool pl_dovi_dm_sqrtsum_eval(const struct pl_dovi_dm_rgb_curve *c,
+    const struct pl_dovi_dm_sop *s, const float in[3], float out[3])
+{
+    if (!c || !c->sqrtsum || !sop_valid(s) || !in || !out)
+        return false;
+    for (int i=0; i<3; i++)
+        if (!isfinite(in[i]) || in[i]<0 || in[i]>10000)
+            return false;
+    float y = .2627f*in[0]+.6780f*in[1]+.0593f*in[2];
+    float result[3] = {0};
+    if (y > 0) {
+        float q = pl_dovi_dm_sqrtsum_curve_eval(c,pl_hdr_rescale(PL_HDR_NITS,PL_HDR_PQ,y));
+        if (!pq_valid(q))
+            return false;
+        float power = powf(fmaxf(0,s->slope*q+s->offset),s->power);
+        if (!isfinite(power))
+            return false;
+        q = fmaxf(1e-5f,power);
+        if (!pq_valid(q))
+            return false;
+        float mapped = pl_hdr_rescale(PL_HDR_PQ,PL_HDR_NITS,q);
+        float qs[3], qy=0;
+        for (int i=0; i<3; i++) {
+            float v = in[i]*mapped/y;
+            if (!isfinite(v) || v<0 || v>10000)
+                return false;
+            qs[i] = pl_hdr_rescale(PL_HDR_NITS,PL_HDR_PQ,v);
+            qy += (i==0 ? .2627f : i==1 ? .6780f : .0593f)*qs[i];
+        }
+        for (int i=0; i<3; i++) {
+            float v = qs[i];
+            if (s->saturation_gain != 0)
+                v = v == 0 || qy == 0 ? 0 : v*powf((1+s->chroma_weight)*v/qy,s->saturation_gain);
+            if (!pq_valid(v))
+                return false;
+            result[i] = pl_hdr_rescale(PL_HDR_PQ,PL_HDR_NITS,v);
+            if (!isfinite(result[i]) || result[i]<0 || result[i]>10000)
+                return false;
+        }
+    }
+    for (int i=0; i<3; i++)
+        out[i] = result[i];
+    return true;
+}
diff --git a/src/include/libplacebo/dovi_dm.h b/src/include/libplacebo/dovi_dm.h
index 49ec483..eb40b26 100644
--- a/src/include/libplacebo/dovi_dm.h
+++ b/src/include/libplacebo/dovi_dm.h
@@ -28,6 +28,7 @@ enum pl_dovi_dm_curve {
     PL_DOVI_DM_OPEN_RGB_PQ_PRE, // continuous-XML public RGB SOP before rational Y
     PL_DOVI_DM_OPEN_Y_PQ_PRE, // scalar PQ(Y) SOP before rational Y; SG0 only
     PL_DOVI_DM_OPEN_Y_PQ_PRE_MB, // zero-low knee, mastering black, post RGB color
+    PL_DOVI_DM_OPEN_Y_PQ_POST_SQRTSUM, // US961 powered PQ curve -> scalar SOP -> color
