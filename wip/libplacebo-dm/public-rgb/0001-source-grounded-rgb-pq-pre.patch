diff --git a/src/dovi_dm_rgb.c b/src/dovi_dm_rgb.c
new file mode 100644
index 0000000..646a3ae
--- /dev/null
+++ b/src/dovi_dm_rgb.c
@@ -0,0 +1,143 @@
+/* Independently expressed public RGB mapping mathematics.
+ * Copyright (c) 2026 HDR contributors
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ * Not Dolby CM identity, certification or a transplant of GPL implementation.
+ */
+#include <math.h>
+#include <libplacebo/dovi_dm.h>
+
+static bool pq_valid(float x)
+{
+    return isfinite(x) && x >= 0 && x <= 1;
+}
+
+static double smooth(double a, double b, double x)
+{
+    double t = fmin(1.0, fmax(0.0, (x-a)/(b-a)));
+    return t*t*(3-2*t);
+}
+
+static bool rgb_sop_valid(const struct pl_dovi_dm_sop *s)
+{
+    return s && pl_dovi_dm_sop_valid(s) && (!s->version ||
+        (s->domain == PL_DOVI_DM_SOP_ABSOLUTE_PQ &&
+         isfinite(s->chroma_weight) && fabsf(s->chroma_weight) <= .5f &&
+         isfinite(s->saturation_gain) && fabsf(s->saturation_gain) <= .5f));
+}
+
+bool pl_dovi_dm_rgb_prepare(const struct pl_dovi_dm_metadata *dm,
+    const struct pl_hdr_metadata *target, struct pl_dovi_dm_rgb_curve *out)
+{
+    if (!dm || !target || !out || dm->version != 2 || !dm->has_l1 ||
+        dm->curve != PL_DOVI_DM_OPEN_RGB_PQ_PRE || !rgb_sop_valid(&dm->open_sop) ||
+        !pq_valid(dm->min_pq) || !pq_valid(dm->avg_pq) || !pq_valid(dm->max_pq) ||
+        dm->min_pq > dm->avg_pq || dm->avg_pq > dm->max_pq ||
+        dm->min_pq >= dm->max_pq || target->min_luma != 0 ||
+        !isfinite(target->max_luma) || target->max_luma <= 0 || target->max_luma > 10000)
+        return false;
+    struct pl_dovi_dm_rgb_curve c = {
+        .input_peak = pl_hdr_rescale(PL_HDR_PQ, PL_HDR_NITS, dm->max_pq),
+    };
+    if (target->max_luma >= c.input_peak) {
+        c.identity = true; // curve identity only; SOP still executes first
+        *out = c;
+        return true;
+    }
+    double lo = dm->min_pq, hi = dm->max_pq;
+    double dsthi = pl_hdr_rescale(PL_HDR_NITS, PL_HDR_PQ, target->max_luma);
+    double dstlo = pl_hdr_rescale(PL_HDR_NITS, PL_HDR_PQ, 0);
+    double src = fmin(lo+.8*(hi-lo), fmax(lo+.1*(hi-lo), dm->avg_pq));
+    double t = (src-lo)/(hi-lo);
+    double adapt = .4+.6*(1-smooth(.8,.4,t)*smooth(.1,.4,t));
+    double dst = src+adapt*(dstlo+t*(dsthi-dstlo)-src);
+    dst = fmin(dstlo+.8*(dsthi-dstlo), fmax(dstlo+.1*(dsthi-dstlo), dst));
+    double xs[3] = {pl_hdr_rescale(PL_HDR_PQ, PL_HDR_NITS, lo),
+                    pl_hdr_rescale(PL_HDR_PQ, PL_HDR_NITS, src), c.input_peak};
+    double ys[3] = {0, pl_hdr_rescale(PL_HDR_PQ, PL_HDR_NITS, dst), target->max_luma};
+    // Solve a+b*x-c*x*y=y with pivoting and normalized x, not fitted anchors.
+    double a[3][4];
+    for (int i = 0; i < 3; i++) {
+        a[i][0] = 1;
+        a[i][1] = xs[i]/xs[2];
+        a[i][2] = -a[i][1]*ys[i];
+        a[i][3] = ys[i];
+    }
+    for (int j = 0; j < 3; j++) {
+        int pivot = j;
+        for (int i = j+1; i < 3; i++)
+            if (fabs(a[i][j]) > fabs(a[pivot][j]))
+                pivot = i;
+        if (!isfinite(a[pivot][j]) || fabs(a[pivot][j]) < 1e-15)
+            return false;
+        for (int k = 0; k < 4; k++) {
+            double v = a[j][k]; a[j][k] = a[pivot][k]; a[pivot][k] = v;
+        }
+        double scale = a[j][j];
+        for (int k = 0; k < 4; k++)
+            a[j][k] /= scale;
+        for (int i = 0; i < 3; i++) {
+            if (i == j)
+                continue;
+            scale = a[i][j];
+            for (int k = 0; k < 4; k++)
+                a[i][k] -= scale*a[j][k];
+        }
+    }
+    c.coeffs[0] = a[0][3];
+    c.coeffs[1] = a[1][3]/xs[2];
+    c.coeffs[2] = a[2][3]/xs[2];
+    for (int i = 0; i < 3; i++)
+        if (!isfinite(c.coeffs[i]))
+            return false;
+    // Check all physical RGB nits, not merely the sampled source anchors.
+    if (fmin(1, 1+c.coeffs[2]*10000) <= 0 ||
+        c.coeffs[1]-c.coeffs[0]*c.coeffs[2] < 0)
+        return false;
+    *out = c;
+    return true;
+}
+
+bool pl_dovi_dm_rgb_eval(const struct pl_dovi_dm_rgb_curve *c,
+    const struct pl_dovi_dm_sop *s, const float in[3], float out[3])
+{
+    if (!c || !rgb_sop_valid(s) || !in || !out)
+        return false;
+    const float weights[3] = {.2627f, .6780f, .0593f};
+    float q[3], rgb[3], y = 0;
+    for (int i = 0; i < 3; i++) {
+        if (!isfinite(in[i]) || in[i] < 0 || in[i] > 10000)
+            return false;
+        q[i] = pl_hdr_rescale(PL_HDR_NITS, PL_HDR_PQ, in[i]);
+        if (s->version)
+            q[i] = powf(fmaxf(s->slope*q[i]+s->offset, 0), s->power);
+        q[i] = fmaxf(q[i], 1e-5f); // published post-SOP PQ floor
+        y += weights[i]*q[i];
+    }
+    for (int i = 0; i < 3; i++) {
+        if (s->version && s->saturation_gain != 0)
+            q[i] *= powf((1+s->chroma_weight)*q[i]/y, s->saturation_gain);
+        if (!isfinite(q[i]))
+            return false;
+        // Explicit physical PQ-domain extension after color, not a fitted
+        // curve coefficient. The published expression has no upper guard.
+        q[i] = fminf(q[i], 1);
+        rgb[i] = pl_hdr_rescale(PL_HDR_PQ, PL_HDR_NITS, q[i]);
+    }
+    y = weights[0]*rgb[0]+weights[1]*rgb[1]+weights[2]*rgb[2];
+    float scale = 1;
+    if (!c->identity && y > 0) {
+        float den = 1+c->coeffs[2]*y;
+        if (!isfinite(den) || den <= 0)
+            return false;
+        scale = fmaxf((c->coeffs[0]+c->coeffs[1]*y)/den, 0)/y;
+    }
+    float result[3];
+    for (int i = 0; i < 3; i++) {
+        result[i] = rgb[i]*scale;
+        if (!isfinite(result[i]) || result[i] < 0 || result[i] > 10000)
+            return false;
+    }
+    for (int i = 0; i < 3; i++)
+        out[i] = result[i];
+    return true;
+}
diff --git a/src/include/libplacebo/dovi_dm.h b/src/include/libplacebo/dovi_dm.h
index c9e380b..68a77dc 100644
--- a/src/include/libplacebo/dovi_dm.h
+++ b/src/include/libplacebo/dovi_dm.h
@@ -25,6 +25,7 @@ enum pl_dovi_dm_curve {
     PL_DOVI_DM_ST2094_10, // existing rational curve/knee, with real NITS scaling
     PL_DOVI_DM_SPLINE,   // diagnostic B: existing spline with explicit DM bounds
     PL_DOVI_DM_OPEN_HERMITE_PQ, // US10600166B2 improved midpoint, analytic Eq7
+    PL_DOVI_DM_OPEN_RGB_PQ_PRE, // continuous-XML public RGB SOP before rational Y
 };
 
 #define PL_DOVI_DM_MAX_BLOCKS 32
@@ -51,6 +52,9 @@ struct pl_dovi_dm_sop {
     uint32_t version; // 1
     enum pl_dovi_dm_sop_domain domain;
     float slope, offset, power;
+    // Only OPEN_RGB_PQ_PRE uses these actual continuous factors. Zero SG
+    // bypasses the color expression exactly; it does not mean CW is absent.
+    float chroma_weight, saturation_gain;
 };
 
 struct pl_dovi_dm_metadata {
@@ -131,5 +135,19 @@ PL_API bool pl_dovi_dm_sop_valid(const struct pl_dovi_dm_sop *sop);
 PL_API float pl_dovi_dm_sop_eval(const struct pl_dovi_dm_sop *sop,
     struct pl_dovi_dm_pq_bounds target, float y);
 
+// Public RGB-pre-PQ/rational hypothesis, NOT a selected/certified Dolby CM.
+// Linear BT.2020 nits in/out. Target black must be zero; target primaries are
+// handled by the subsequent single gamut stage. Unsupported/singular intervals
+// reject rather than substituting a curve. All fields are copied by value.
+struct pl_dovi_dm_rgb_curve {
+    float coeffs[3]; // (a+b*Y)/(1+c*Y)
+    float input_peak;
+    bool identity;
+};
+PL_API bool pl_dovi_dm_rgb_prepare(const struct pl_dovi_dm_metadata *dm,
+    const struct pl_hdr_metadata *target, struct pl_dovi_dm_rgb_curve *out);
+PL_API bool pl_dovi_dm_rgb_eval(const struct pl_dovi_dm_rgb_curve *curve,
+    const struct pl_dovi_dm_sop *sop, const float in_nits[3], float out_nits[3]);
+
 PL_API_END
 #endif
