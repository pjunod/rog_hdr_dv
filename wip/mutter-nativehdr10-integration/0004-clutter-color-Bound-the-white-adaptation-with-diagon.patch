 static const float night_light_4000k[2] = { 0.3804111f, 0.3765993f };
 static const float night_light_3990k[2] = { 0.3808537f, 0.3768775f };
+static const float night_light_1000k[2] = { 0.6530877f, 0.3446811f };
+static const float night_light_1700k[2] = { 0.5609095f, 0.4040163f };
+static const float night_light_4700k[2] = { 0.3540330f, 0.3583077f };
+static const float night_light_10000k[2] = { 0.2806694f, 0.2885335f };
 
 static ClutterColorState *
 create_adapted_output_target (ClutterColorState *output,
@@ -3372,6 +3379,275 @@ white_adaptation_shader_matches_cpu (void)
                              G_N_ELEMENTS (signals), 1e-4f);
 }
 
+/*
+ * The reference diagonal factors: the white point's XYZ, Y = 1, in linear
+ * RGB of @gamut through absolute colorimetry, negative components set to
+ * zero, divided by the largest; computed in double precision.
+ */
+static void
+reference_white_factors (const ClutterPrimaries *gamut,
+                         const float             white[2],
+                         double                  factors[3])
+{
+  double to_xyz[3][3], from_xyz[3][3], xyz[3], largest = 0.0;
+  int c;
+
+  reference_rgb_to_xyz (gamut, to_xyz);
+  reference_invert (to_xyz, from_xyz);
+  reference_white_xyz (white[0], white[1], xyz);
+  reference_apply (from_xyz, xyz, factors);
+  for (c = 0; c < 3; c++)
+    {
+      factors[c] = MAX (factors[c], 0.0);
+      largest = MAX (largest, factors[c]);
+    }
+  for (c = 0; c < 3; c++)
+    factors[c] /= largest;
+}
+
+static ClutterColorState *
+create_pq_output_with_gamut (const ClutterPrimaries *gamut)
+{
+  ClutterPrimaries primaries = *gamut;
+
+  return clutter_color_state_params_new_full (clutter_test_get_context (),
+                                              CLUTTER_COLORSPACE_BT2020,
+                                              CLUTTER_TRANSFER_FUNCTION_PQ,
+                                              &primaries, -1.0f,
+                                              0.005f, 10000.0f, 203.0f,
+                                              -1.0f);
+}
+
+/*
+ * The adaptation is diagonal in the output's linear RGB: finite factors in
+ * [0, 1], the largest exactly 1, from the Settings range (1700 K to 4700 K)
+ * to the endpoints of the gsd-color schema (1000 K and 10000 K), and equal to
+ * an independent double precision computation. At 1000 K the Planckian white
+ * lies outside BT.2020, with a negative blue: it is projected, its blue
+ * factor zero, rather than claimed exactly.
+ */
+static void
+white_adaptation_factors (void)
+{
+  const ClutterColorimetry bt2020 = {
+    .type = CLUTTER_COLORIMETRY_TYPE_COLORSPACE,
+    .colorspace = CLUTTER_COLORSPACE_BT2020,
+  };
+  ClutterPrimaries dci_p3 = dci_p3_gamut;
+  const ClutterColorimetry dci_p3_colorimetry = {
+    .type = CLUTTER_COLORIMETRY_TYPE_PRIMARIES,
+    .primaries = &dci_p3,
+  };
+  const float *whites[] = {
+    night_light_1000k, night_light_1700k, night_light_3990k,
+    night_light_4000k, night_light_4700k, night_light_10000k,
+  };
+  const ClutterColorimetry *colorimetries[] = { &bt2020, &dci_p3_colorimetry };
+  const ClutterPrimaries *gamuts[] = { &bt2020_gamut, &dci_p3_gamut };
+  g_autoptr (GError) error = NULL;
+  float factors[3];
+  int i, j, c;
+
+  for (j = 0; j < G_N_ELEMENTS (colorimetries); j++)
+    {
+      for (i = 0; i < G_N_ELEMENTS (whites); i++)
+        {
+          double reference[3];
+          float largest = 0.0f;
+
+          g_assert_true (clutter_colorimetry_get_white_adaptation_factors (colorimetries[j],
+                                                                           whites[i][0],
+                                                                           whites[i][1],
+                                                                           factors,
+                                                                           &error));
+          g_assert_no_error (error);
+          reference_white_factors (gamuts[j], whites[i], reference);
+          for (c = 0; c < 3; c++)
+            {
+              g_assert_true (isfinite (factors[c]));
+              g_assert_cmpfloat (factors[c], >=, 0.0f);
+              g_assert_cmpfloat (factors[c], <=, 1.0f);
+              g_assert_cmpfloat_with_epsilon (factors[c], reference[c], 1e-4);
+              largest = MAX (largest, factors[c]);
+            }
+          g_assert_cmpfloat (largest, ==, 1.0f);
+        }
+    }
+
+  /* 1000 K is projected into BT.2020: red is the largest, blue clamped. */
+  g_assert_true (clutter_colorimetry_get_white_adaptation_factors (&bt2020,
+                                                                   night_light_1000k[0],
+                                                                   night_light_1000k[1],
+                                                                   factors, NULL));
+  g_assert_cmpfloat (factors[0], ==, 1.0f);
+  g_assert_cmpfloat_with_epsilon (factors[1], 0.122051, 1e-4);
+  g_assert_cmpfloat (factors[2], ==, 0.0f);
+
+  /* 4000 K, the acceptance point, is representable: every factor is
+   * positive. 10000 K is bluer than D65: blue is the largest. */
+  g_assert_true (clutter_colorimetry_get_white_adaptation_factors (&bt2020,
+                                                                   night_light_4000k[0],
+                                                                   night_light_4000k[1],
+                                                                   factors, NULL));
+  g_assert_cmpfloat (factors[0], ==, 1.0f);
+  g_assert_cmpfloat_with_epsilon (factors[1], 0.784624, 1e-4);
+  g_assert_cmpfloat_with_epsilon (factors[2], 0.479811, 1e-4);
+  g_assert_true (clutter_colorimetry_get_white_adaptation_factors (&bt2020,
+                                                                   night_light_10000k[0],
+                                                                   night_light_10000k[1],
+                                                                   factors, NULL));
+  g_assert_cmpfloat (factors[2], ==, 1.0f);
+  g_assert_cmpfloat (factors[0], <, factors[1]);
+
+  /* A white point without a positive y has no XYZ. */
+  g_assert_false (clutter_colorimetry_get_white_adaptation_factors (&bt2020,
+                                                                    0.3f, 0.0f,
+                                                                    factors,
+                                                                    &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA);
+}
+
+/* The output's encoded signal of @input in @source converted to @output, as
+ * absolute luminance per channel. */
+static void
+transform_to_luminance (ClutterColorState *source,
+                        ClutterColorState *output,
+                        const float        input[3],
+                        double             luminance[3])
+{
+  g_autoptr (ClutterColorTransform) transform = NULL;
+  float color[4] = { input[0], input[1], input[2], 1.0f };
+  int c;
+
+  transform = clutter_color_transform_new (source, output,
+                                           CLUTTER_COLOR_STATE_TRANSFORM_OPAQUE);
+  clutter_color_pipeline_do_transform (clutter_color_transform_get_pipeline (transform),
+                                       color, 1);
+  for (c = 0; c < 3; c++)
+    luminance[c] = reference_pq_luminance (color[c]);
+}
+
+/*
+ * No output channel of any nonnegative color exceeds its unadapted value:
+ * the primaries and secondaries of linear blending, which a white-only
+ * normalization of a Bradford adaptation brightens, and white, at every
+ * temperature from 1000 K to 10000 K, on a BT.2020 and a DCI-P3 output. Each
+ * channel is exactly the unadapted channel scaled by its factor.
+ */
+static void
+white_adaptation_channel_bound (void)
+{
+  const ClutterPrimaries *gamuts[] = { &bt2020_gamut, &dci_p3_gamut };
+  const float *whites[] = {
+    night_light_1000k, night_light_1700k, night_light_4000k,
+    night_light_4700k, night_light_10000k,
+  };
+  const float inputs[][3] = {
+    { 0.5f, 0.0f, 0.0f }, { 0.0f, 0.5f, 0.0f }, { 0.0f, 0.0f, 0.5f },
+    { 0.5f, 0.5f, 0.0f }, { 0.5f, 0.0f, 0.5f }, { 0.0f, 0.5f, 0.5f },
+    { 0.5f, 0.5f, 0.5f }, { 1.0f, 1.0f, 1.0f },
+  };
+  int g, i, k, c;
+
+  for (g = 0; g < G_N_ELEMENTS (gamuts); g++)
+    {
+      g_autoptr (ClutterColorState) output = create_pq_output_with_gamut (gamuts[g]);
+      g_autoptr (ClutterColorState) plain = NULL;
+      ClutterPrimaries gamut = *gamuts[g];
+      const ClutterColorimetry colorimetry = {
+        .type = CLUTTER_COLORIMETRY_TYPE_PRIMARIES,
+        .primaries = &gamut,
+      };
+
+      plain = clutter_color_state_get_blending (output, TRUE);
+
+      for (i = 0; i < G_N_ELEMENTS (whites); i++)
+        {
+          g_autoptr (ClutterColorState) adapted = NULL;
+          g_autoptr (ClutterColorState) blending = NULL;
+          float factors[3];
+
+          adapted = create_adapted_output_target (output, whites[i]);
+          g_assert_nonnull (adapted);
+          blending = clutter_color_state_get_blending (adapted, TRUE);
+          g_assert_true (clutter_colorimetry_get_white_adaptation_factors (&colorimetry,
+                                                                           whites[i][0],
+                                                                           whites[i][1],
+                                                                           factors,
+                                                                           NULL));
+
+          for (k = 0; k < G_N_ELEMENTS (inputs); k++)
+            {
+              double lum[3], plain_lum[3];
+
+              transform_to_luminance (blending, output, inputs[k], lum);
+              transform_to_luminance (plain, output, inputs[k], plain_lum);
+              for (c = 0; c < 3; c++)
+                {
+                  g_assert_cmpfloat (lum[c], <=, plain_lum[c] * (1.0 + 1e-4) + 1e-4);
+                  g_assert_cmpfloat_with_epsilon (lum[c],
+                                                  plain_lum[c] * factors[c],
+                                                  plain_lum[c] * 2e-3 + 1e-3);
+                }
+            }
+        }
+    }
+}
+
+/*
+ * Representable whites land on the Planckian chromaticity, also on an
+ * output whose own white is not D65: with an encoding white of DCI, the
+ * output's white still shows the requested white, in absolute XYZ. The
+ * projected 1000 K white does not, and shows no blue at all.
+ */
+static void
+white_adaptation_representable (void)
+{
+  const ClutterPrimaries *gamuts[] = { &bt2020_gamut, &dci_p3_gamut };
+  const float *whites[] = {
+    night_light_1700k, night_light_4000k, night_light_4700k,
+    night_light_10000k,
+  };
+  const float white_signal[3] = { 0.5f, 0.5f, 0.5f };
+  int g, i;
+
+  for (g = 0; g < G_N_ELEMENTS (gamuts); g++)
+    {
+      g_autoptr (ClutterColorState) output = create_pq_output_with_gamut (gamuts[g]);
+      double to_xyz[3][3];
+
+      reference_rgb_to_xyz (gamuts[g], to_xyz);
+
+      for (i = 0; i < G_N_ELEMENTS (whites); i++)
+        {
+          g_autoptr (ClutterColorState) adapted = NULL;
+          g_autoptr (ClutterColorState) blending = NULL;
+          double lum[3], xyz[3], sum;
+
+          adapted = create_adapted_output_target (output, whites[i]);
