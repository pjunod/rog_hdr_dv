 /*
- * Computes the adaptation of a display's output to the white point
- * (@white_x, @white_y), such as a Night Light white: a matrix on linear
- * BT.2020, applied just before the conversion to the display's encoding,
- * @colorimetry.
+ * Computes the per-channel factors that adapt a display's output to the
+ * white point (@white_x, @white_y), such as a Night Light white: diagonal
+ * von Kries factors in the linear RGB of the display's encoding,
+ * @colorimetry, the frame of the colors the display shows.
  *
- * That conversion adapts linear BT.2020, whose white is CLUTTER_D65, to the
- * encoding's white point. The adaptation is therefore made in the frame of
- * the colors the display shows: linear BT.2020 is taken to CIE XYZ with the
- * encoding's white (the inverse of the encoding's own adaptation to D65),
- * adapted with Bradford from the encoding's white point to the new one, and
- * brought back. The encoding's white is then shown at the new white point,
- * whatever the encoding's white point is.
+ * The white point, with Y = 1, is converted to linear RGB of the encoding
+ * through CIE XYZ without chromatic adaptation, since that is the RGB the
+ * display shows it with. A white outside the encoding's gamut, such as the
+ * Planckian white at 1000 K in BT.2020, has a negative component there: it
+ * is clamped to zero, which projects the white into the gamut rather than
+ * claiming its exact chromaticity. The factors are then divided by the
+ * largest one. They are therefore finite, within [0, 1], and the largest is
+ * 1: no channel of any nonnegative color is brighter than unadapted, and a
+ * white within the gamut is shown at exactly the requested chromaticity.
  *
- * The result is scaled so that the brightest channel of the encoding's
- * adapted white, in linear RGB of the encoding, is that of the unadapted
- * white: the adapted output never becomes brighter.
+ * Returns %FALSE, setting @error, if the white point has no XYZ, the
+ * colorimetry has no usable matrices, or no factor is positive.
+ */
+gboolean
+clutter_colorimetry_get_white_adaptation_factors (const ClutterColorimetry  *colorimetry,
+                                                  float                      white_x,
+                                                  float                      white_y,
+                                                  float                      factors[3],
+                                                  GError                   **error)
+{
+  graphene_matrix_t to_XYZ, from_XYZ;
+  graphene_vec3_t white_XYZ, white_rgb;
+  float rgb[3], largest;
+  int i;
+
+  if (!colorimetry_to_XYZ_checked (colorimetry, &to_XYZ, error) ||
+      !invert_to_XYZ (&to_XYZ, &from_XYZ, error))
+    return FALSE;
+
+  if (!white_point_to_XYZ_checked (white_x, white_y, &white_XYZ))
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+                           "The white point must have a positive, finite y "
+                           "chromaticity");
+      return FALSE;
+    }
+
+  graphene_matrix_transform_vec3 (&from_XYZ, &white_XYZ, &white_rgb);
+  rgb[0] = graphene_vec3_get_x (&white_rgb);
+  rgb[1] = graphene_vec3_get_y (&white_rgb);
+  rgb[2] = graphene_vec3_get_z (&white_rgb);
+
+  largest = 0.0f;
+  for (i = 0; i < 3; i++)
+    {
+      if (!isfinite (rgb[i]))
+        {
+          g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+                               "The white point is not finite in the encoding");
+          return FALSE;
+        }
+
+      /* Parameter construction, not per-pixel clipping. */
+      rgb[i] = MAX (rgb[i], 0.0f);
+      largest = MAX (largest, rgb[i]);
+    }
+
+  if (!(largest > 0.0f))
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+                           "The white point has no positive component in the "
+                           "encoding");
+      return FALSE;
+    }
+
+  /* Correctly rounded division is monotonic: the largest factor is exactly
+   * 1, and none exceeds it. */
+  for (i = 0; i < 3; i++)
+    factors[i] = rgb[i] / largest;
+
+  return TRUE;
+}
+
+/*
+ * Computes the adaptation of a display's output to the white point
+ * (@white_x, @white_y) as a matrix on linear BT.2020, applied just before
+ * the conversion to the display's encoding, @colorimetry: the conversion of
+ * linear BT.2020 to linear RGB of the encoding, the diagonal factors of
+ * clutter_colorimetry_get_white_adaptation_factors() there, and the
+ * conversion back. Followed by the conversion to the encoding, it scales
+ * each encoding channel by its factor, so the output never becomes
+ * brighter in any channel.
  *
- * Returns %FALSE, setting @error, if the white point has no XYZ or a matrix
- * cannot be computed.
+ * Returns %FALSE, setting @error, if the factors or a matrix cannot be
+ * computed.
  */
 gboolean
 clutter_colorimetry_get_white_adaptation_matrix (const ClutterColorimetry  *colorimetry,
@@ -919,68 +990,31 @@ clutter_colorimetry_get_white_adaptation_matrix (const ClutterColorimetry  *colo
                                                  graphene_matrix_t         *adaptation,
                                                  GError                   **error)
 {
-  const ClutterPrimaries *primaries;
-  graphene_matrix_t to_linear_bt2020, from_linear_bt2020, XYZ_to_D65;
-  graphene_matrix_t XYZ_to_linear_bt2020, linear_bt2020_to_XYZ;
-  graphene_matrix_t D65_to_XYZ, to_white, scale, temp, matrix;
-  graphene_vec3_t encoding_white_XYZ, white_XYZ, white;
-  float brightest;
+  graphene_matrix_t to_linear_bt2020, from_linear_bt2020, scale, temp;
+  float factors[3];
 
   if (!clutter_colorimetry_get_linear_bt2020_matrices (colorimetry,
                                                        &to_linear_bt2020,
                                                        &from_linear_bt2020,
                                                        error) ||
-      !clutter_colorimetry_get_source_matrices (colorimetry,
-                                                &to_linear_bt2020,
-                                                &XYZ_to_D65,
-                                                &XYZ_to_linear_bt2020,
-                                                &linear_bt2020_to_XYZ,
-                                                error))
+      !clutter_colorimetry_get_white_adaptation_factors (colorimetry,
+                                                         white_x, white_y,
+                                                         factors, error))
     return FALSE;
 
-  primaries = clutter_colorimetry_get_primaries (colorimetry);
-  /* Checked by clutter_colorimetry_get_source_matrices() above. */
-  if (!white_point_to_XYZ_checked (primaries->w_x, primaries->w_y,
-                                   &encoding_white_XYZ))
-    g_assert_not_reached ();
-
-  if (!white_point_to_XYZ_checked (white_x, white_y, &white_XYZ) ||
-      !clutter_chromatic_adaptation_matrix (&encoding_white_XYZ, &white_XYZ,
-                                            &to_white) ||
-      !graphene_matrix_inverse (&XYZ_to_D65, &D65_to_XYZ))
-    {
-      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
-                           "The white point cannot be adapted to");
-      return FALSE;
-    }
+  /* Row vectors, applied left to right: linear BT.2020 → linear RGB of the
+   * encoding → scaled per channel → linear BT.2020. */
+  graphene_matrix_init_scale (&scale, factors[0], factors[1], factors[2]);
+  graphene_matrix_multiply (&from_linear_bt2020, &scale, &temp);
+  graphene_matrix_multiply (&temp, &to_linear_bt2020, adaptation);
 
-  /* linear BT.2020 → XYZ D65 → XYZ in the encoding's white → XYZ in the new
-   * white, taken by the encoding's adaptation to D65 → linear BT.2020 */
-  graphene_matrix_multiply (&linear_bt2020_to_XYZ, &D65_to_XYZ, &temp);
-  graphene_matrix_multiply (&temp, &to_white, &matrix);
-  graphene_matrix_multiply (&matrix, &XYZ_to_D65, &temp);
-  graphene_matrix_multiply (&temp, &XYZ_to_linear_bt2020, &matrix);
-
-  /* The encoding's white, RGB (1, 1, 1), adapted, in the encoding. */
-  graphene_matrix_multiply (&to_linear_bt2020, &matrix, &temp);
-  graphene_matrix_multiply (&temp, &from_linear_bt2020, &scale);
-  graphene_vec3_init (&white, 1.0f, 1.0f, 1.0f);
-  graphene_matrix_transform_vec3 (&scale, &white, &white);
-  brightest = MAX (graphene_vec3_get_x (&white),
-                   MAX (graphene_vec3_get_y (&white),
-                        graphene_vec3_get_z (&white)));
-  if (!matrix_is_finite (&matrix) || !isfinite (brightest) ||
-      !(brightest > 0.0f))
+  if (!matrix_is_finite (adaptation))
     {
       g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
                            "The white point adaptation is not finite");
       return FALSE;
     }
 
-  graphene_matrix_init_scale (&scale, 1.0f / brightest, 1.0f / brightest,
-                              1.0f / brightest);
-  graphene_matrix_multiply (&matrix, &scale, adaptation);
-
   return TRUE;
 }
 
diff --git a/src/tests/clutter/conform/color-hdr.c b/src/tests/clutter/conform/color-hdr.c
