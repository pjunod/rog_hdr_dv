+static void
+assert_gdctl_target_override (const char                    *connector,
+                              const MetaColorTargetOverride *expected)
+{
+  MetaBackend *backend = meta_context_get_backend (test_context);
+  MetaMonitorManager *manager = meta_backend_get_monitor_manager (backend);
+  GList *l;
+
+  for (l = meta_monitor_manager_get_monitors (manager); l; l = l->next)
+    {
+      MetaMonitor *monitor = l->data;
+
+      if (g_str_equal (meta_monitor_get_connector (monitor), connector))
+        {
+          g_assert_true (meta_color_target_override_equal (
+                           meta_monitor_get_target_override (monitor), expected));
+          return;
+        }
+    }
+  g_assert_not_reached ();
+}
+
+static void
+meta_test_monitor_gdctl_target_overrides (void)
+{
+  const MetaColorTargetOverride first = {
+    .has_peak = TRUE, .peak = 400, .has_min = TRUE, .min = 0,
+    .gamut_source = META_HDR_GAMUT_SOURCE_BASE_EDID,
+  };
+  const MetaColorTargetOverride second = {
+    .has_peak = TRUE, .peak = 600,
+    .gamut_source = META_HDR_GAMUT_SOURCE_NONE,
+  };
+  MetaColorTargetOverride changed = first;
+  const MetaColorTargetOverride cleared = { 0 };
+
+  setup_apply_configuration_test ();
+  check_gdctl_result ("set", "--logical-monitor", "--primary",
+                      "--monitor", "DP-1", "--target-peak-luminance", "400",
+                      "--target-min-luminance", "0", "--hdr-gamut-source", "base-edid",
+                      "--logical-monitor", "--monitor", "DP-2", "--right-of", "DP-1",
+                      "--target-peak-luminance", "600", "--hdr-gamut-source", "none", NULL);
+  assert_gdctl_target_override ("DP-1", &first);
+  assert_gdctl_target_override ("DP-2", &second);
+
+  /* VERIFY must not mutate either output, including an explicit clear. */
+  check_gdctl_result ("set", "--verify", "--logical-monitor", "--primary",
+                      "--monitor", "DP-1", "--target-peak-luminance", "auto",
+                      "--hdr-gamut-source", "auto", "--logical-monitor",
+                      "--monitor", "DP-2", "--right-of", "DP-1", NULL);
+  assert_gdctl_target_override ("DP-1", &first);
+  assert_gdctl_target_override ("DP-2", &second);
+
+  /* An unrelated layout change preserves each monitor's configured fields. */
+  check_gdctl_result ("set", "--logical-monitor", "--primary",
+                      "--monitor", "DP-1", "--logical-monitor", "--monitor", "DP-2",
+                      "--left-of", "DP-1", NULL);
+  assert_gdctl_target_override ("DP-1", &first);
+  assert_gdctl_target_override ("DP-2", &second);
+
+  check_gdctl_result ("set", "--logical-monitor", "--primary",
+                      "--monitor", "DP-1", "--target-min-luminance", "auto",
+                      "--logical-monitor", "--monitor", "DP-2", "--right-of", "DP-1", NULL);
+  changed.has_min = FALSE;
+  assert_gdctl_target_override ("DP-1", &changed);
+  assert_gdctl_target_override ("DP-2", &second);
+
+  check_gdctl_result ("set", "--logical-monitor", "--primary",
+                      "--monitor", "DP-1", "--target-min-luminance", "0",
+                      "--logical-monitor", "--monitor", "DP-2", "--right-of", "DP-1", NULL);
+  assert_gdctl_target_override ("DP-1", &first);
+  check_gdctl_result ("set", "--logical-monitor", "--primary",
+                      "--monitor", "DP-1", "--target-peak-luminance", "auto",
+                      "--hdr-gamut-source", "auto", "--logical-monitor",
+                      "--monitor", "DP-2", "--right-of", "DP-1", NULL);
+  assert_gdctl_target_override ("DP-1", &cleared);
+  assert_gdctl_target_override ("DP-2", &second);
+
+  check_gdctl_failure ("set", "--logical-monitor", "--primary",
+                       "--monitor", "DP-1", "--target-min-luminance", "0", NULL);
+  check_gdctl_failure ("set", "--logical-monitor", "--primary",
+                       "--monitor", "DP-1", "--target-peak-luminance", "203", NULL);
+  check_gdctl_failure ("set", "--logical-monitor", "--primary",
+                       "--monitor", "DP-1", "--target-peak-luminance", "400",
+                       "--target-min-luminance", "400", NULL);
+  assert_gdctl_target_override ("DP-1", &cleared);
+  assert_gdctl_target_override ("DP-2", &second);
+}
