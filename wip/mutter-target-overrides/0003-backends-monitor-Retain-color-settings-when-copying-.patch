From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@invalid>
Date: Sun, 11 Oct 2026 22:55:06 +0000
Subject: [PATCH 3/6] backends/monitor: Retain color settings when copying and
 synthesizing layouts

Preserve color mode, RGB range and target overrides in amendment and orientation copies. Recover target declarations by monitor identity from the existing configuration history when synthesizing layouts; explicit D-Bus replacement remains separate. Use each mirror member for its own color-mode history. Add deferred copy, history, VERIFY nonmutation and override-only reapply regressions.
---
 src/backends/meta-monitor-config-manager.c |  38 +++++-
 src/backends/meta-monitor-config-utils.c   |   5 +-
 src/tests/monitor-storage-tests.c          | 133 +++++++++++++++++++++
 3 files changed, 169 insertions(+), 7 deletions(-)

diff --git a/src/backends/meta-monitor-config-manager.c b/src/backends/meta-monitor-config-manager.c
index 27ba4f7..82d16af 100644
--- a/src/backends/meta-monitor-config-manager.c
+++ b/src/backends/meta-monitor-config-manager.c
@@ -651,10 +651,15 @@ find_primary_monitor (MetaMonitorManager *monitor_manager,
   return NULL;
 }
 
+static MetaColorTargetOverride
+get_last_target_override_for_monitor (MetaMonitorConfigManager *config_manager,
+                                      MetaMonitor              *monitor);
+
 static MetaMonitorConfig *
-create_monitor_config (MetaMonitor     *monitor,
-                       MetaMonitorMode *mode,
-                       MetaColorMode    color_mode)
+create_monitor_config (MetaMonitorConfigManager *config_manager,
+                       MetaMonitor              *monitor,
+                       MetaMonitorMode          *mode,
+                       MetaColorMode             color_mode)
 {
   MetaMonitorSpec *monitor_spec;
   MetaMonitorModeSpec *mode_spec;
@@ -670,6 +675,7 @@ create_monitor_config (MetaMonitor     *monitor,
     .enable_underscanning = meta_monitor_is_underscanning (monitor),
     .rgb_range = meta_monitor_get_rgb_range (monitor),
     .color_mode = color_mode,
+    .target_override = get_last_target_override_for_monitor (config_manager, monitor),
   };
 
   monitor_config->has_max_bpc =
@@ -740,7 +746,8 @@ create_preferred_logical_monitor_config (MetaMonitorManager           *monitor_m
   scale_logical_monitor_width (layout_mode, scale,
                                width, height, &width, &height);
 
-  monitor_config = create_monitor_config (monitor, mode, color_mode);
+  monitor_config = create_monitor_config (monitor_manager->config_manager,
+                                           monitor, mode, color_mode);
 
   transform = get_monitor_transform (monitor_manager, monitor);
   if (mtk_monitor_transform_is_rotated (transform))
@@ -861,6 +868,24 @@ get_last_color_mode_for_monitor (MetaMonitorConfigManager *config_manager,
   return FALSE;
 }
 
+static MetaColorTargetOverride
+get_last_target_override_for_monitor (MetaMonitorConfigManager *config_manager,
+                                      MetaMonitor              *monitor)
+{
+  g_autoptr (GList) configs = get_relevant_configs (config_manager);
+  GList *l;
+
+  for (l = configs; l; l = l->next)
+    {
+      MetaMonitorConfig *monitor_config = find_monitor_config (l->data, monitor);
+
+      if (monitor_config)
+        return monitor_config->target_override;
+    }
+
+  return (MetaColorTargetOverride) { 0 };
+}
+
 typedef enum _MonitorPositioningMode
 {
   MONITOR_POSITIONING_LINEAR,
@@ -1282,13 +1307,14 @@ create_for_switch_config_all_mirror (MetaMonitorConfigManager *config_manager)
                                          primary_monitor);
       best_scale = MAX (best_scale, scale);
 
-      if (!get_last_color_mode_for_monitor (config_manager, monitor,
+      if (!get_last_color_mode_for_monitor (config_manager, other_monitor,
                                             &color_mode))
         color_mode = META_COLOR_MODE_DEFAULT;
 
       monitor_configs =
         g_list_prepend (monitor_configs,
-                        create_monitor_config (other_monitor,
+                        create_monitor_config (config_manager,
+                                               other_monitor,
                                                mode,
                                                color_mode));
     }
