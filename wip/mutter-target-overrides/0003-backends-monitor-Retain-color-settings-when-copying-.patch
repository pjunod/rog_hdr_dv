+static void
+meta_test_monitor_config_copy_target_override (void)
+{
+  MetaBackend *backend = meta_context_get_backend (test_context);
+  MetaMonitorManager *manager = meta_backend_get_monitor_manager (backend);
+  g_autoptr (MetaMonitorsConfig) original = NULL;
+  g_autoptr (MetaMonitorsConfig) copy = NULL;
+  MetaLogicalMonitorConfig *logical;
+  MetaMonitorConfig *monitor_config;
+  MetaMonitorConfig *copied_monitor_config;
+
+  original = meta_monitor_config_manager_create_linear (manager->config_manager);
+  logical = original->logical_monitor_configs->data;
+  monitor_config = logical->monitor_configs->data;
+  monitor_config->color_mode = META_COLOR_MODE_BT2100;
+  monitor_config->rgb_range = META_OUTPUT_RGB_RANGE_FULL;
+  monitor_config->target_override = (MetaColorTargetOverride) {
+    .has_peak = TRUE, .peak = 400,
+    .has_min = TRUE, .min = 0,
+    .gamut_source = META_HDR_GAMUT_SOURCE_BASE_EDID,
+  };
+
+  /* The amendment/orientation copy must retain HDR context and declaration. */
+  copy = meta_monitors_config_copy (original);
+  logical = copy->logical_monitor_configs->data;
+  copied_monitor_config = logical->monitor_configs->data;
+  g_assert_true (copied_monitor_config != monitor_config);
+  g_assert_cmpint (copied_monitor_config->color_mode, ==, META_COLOR_MODE_BT2100);
+  g_assert_cmpint (copied_monitor_config->rgb_range, ==, META_OUTPUT_RGB_RANGE_FULL);
+  g_assert_true (meta_color_target_override_equal (
+                   &copied_monitor_config->target_override,
+                   &monitor_config->target_override));
+}
+
+static void
+meta_test_monitor_config_history_target_override (void)
+{
+  MetaBackend *backend = meta_context_get_backend (test_context);
+  MetaMonitorManager *manager = meta_backend_get_monitor_manager (backend);
+  g_autoptr (MetaMonitorsConfig) original = NULL;
+  g_autoptr (MetaMonitorsConfig) regenerated = NULL;
+  MetaLogicalMonitorConfig *logical;
+  MetaMonitorConfig *monitor_config;
+  MetaMonitorConfig *regenerated_monitor_config;
+
+  original = meta_monitor_config_manager_create_linear (manager->config_manager);
+  logical = original->logical_monitor_configs->data;
+  monitor_config = logical->monitor_configs->data;
+  monitor_config->target_override = (MetaColorTargetOverride) {
+    .has_peak = TRUE, .peak = 400,
+    .gamut_source = META_HDR_GAMUT_SOURCE_NONE,
+  };
+  meta_monitor_config_manager_set_current (manager->config_manager, original);
+
+  /* Synthesizing a layout uses configuration history, not new output defaults. */
+  regenerated = meta_monitor_config_manager_create_linear (manager->config_manager);
+  logical = regenerated->logical_monitor_configs->data;
+  regenerated_monitor_config = logical->monitor_configs->data;
+  g_assert_true (meta_color_target_override_equal (
+                   &regenerated_monitor_config->target_override,
+                   &monitor_config->target_override));
+}
+
+static void
+meta_test_monitor_target_override_reapply (void)
+{
+  MetaBackend *backend = meta_context_get_backend (test_context);
+  MetaMonitorManager *manager = meta_backend_get_monitor_manager (backend);
+  g_autoptr (MetaMonitorsConfig) config = NULL;
+  g_autoptr (MetaMonitorsConfig) changed = NULL;
+  g_autoptr (MetaMonitorsConfig) cleared = NULL;
+  g_autoptr (GError) error = NULL;
+  MetaLogicalMonitorConfig *logical;
+  MetaMonitorConfig *monitor_config;
+  MetaMonitor *monitor = meta_monitor_manager_get_monitors (manager)->data;
+  const MetaColorTargetOverride *applied;
+
+  config = meta_monitor_config_manager_create_linear (manager->config_manager);
+  logical = config->logical_monitor_configs->data;
+  monitor_config = logical->monitor_configs->data;
+  monitor_config->target_override = (MetaColorTargetOverride) {
+    .has_peak = TRUE, .peak = 400,
+    .gamut_source = META_HDR_GAMUT_SOURCE_NONE,
+  };
+
+  g_assert_true (meta_monitor_manager_apply_monitors_config (
+                   manager, config, META_MONITORS_CONFIG_METHOD_VERIFY, &error));
+  g_assert_no_error (error);
+  g_assert_false (meta_monitor_get_target_override (monitor)->has_peak);
+
+  g_assert_true (meta_monitor_manager_apply_monitors_config (
+                   manager, config, META_MONITORS_CONFIG_METHOD_TEMPORARY, &error));
+  g_assert_no_error (error);
+  applied = meta_monitor_get_target_override (monitor);
+  g_assert_true (meta_color_target_override_equal (applied,
+                                                   &monitor_config->target_override));
+
+  changed = meta_monitors_config_copy (config);
+  logical = changed->logical_monitor_configs->data;
+  monitor_config = logical->monitor_configs->data;
+  monitor_config->target_override.peak = 600;
+  monitor_config->target_override.has_min = TRUE;
+  monitor_config->target_override.min = 0;
+
+  /* An override-only update follows the same applied-state lifecycle. */
+  g_assert_true (meta_monitor_manager_apply_monitors_config (
+                   manager, changed, META_MONITORS_CONFIG_METHOD_TEMPORARY, &error));
+  g_assert_no_error (error);
+  applied = meta_monitor_get_target_override (monitor);
+  g_assert_cmpfloat (applied->peak, ==, 600);
+  g_assert_true (applied->has_min);
+  g_assert_cmpfloat (applied->min, ==, 0);
+
+  cleared = meta_monitors_config_copy (changed);
+  logical = cleared->logical_monitor_configs->data;
+  monitor_config = logical->monitor_configs->data;
+  monitor_config->target_override = (MetaColorTargetOverride) { 0 };
+  g_assert_true (meta_monitor_manager_apply_monitors_config (
+                   manager, cleared, META_MONITORS_CONFIG_METHOD_TEMPORARY, &error));
+  g_assert_no_error (error);
+  applied = meta_monitor_get_target_override (monitor);
+  g_assert_false (applied->has_peak);
+  g_assert_false (applied->has_min);
+  g_assert_cmpint (applied->gamut_source, ==, META_HDR_GAMUT_SOURCE_AUTO);
+}
+
 static void
 init_storage_tests (void)
 {
+  meta_add_monitor_test ("/backends/monitor/config-store/target-override-reapply",
+                         meta_test_monitor_target_override_reapply);
+  meta_add_monitor_test ("/backends/monitor/config-store/copy-target-override",
+                         meta_test_monitor_config_copy_target_override);
+  meta_add_monitor_test ("/backends/monitor/config-store/history-target-override",
+                         meta_test_monitor_config_history_target_override);
   meta_add_monitor_test ("/backends/monitor/config-store/set-current-on-empty",
                          meta_test_monitor_config_store_set_current_on_empty);
   meta_add_monitor_test ("/backends/monitor/config-store/set-current-with-parent-on-empty",
